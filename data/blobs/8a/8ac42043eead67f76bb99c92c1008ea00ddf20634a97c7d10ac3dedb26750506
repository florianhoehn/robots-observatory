<!-- Limit and randomize nested tags -->
<script>
setTimeout(() => {
    document.querySelectorAll('[fs-cmsnest-limit]').forEach(container => {
        const limit = parseInt(container.getAttribute('fs-cmsnest-limit'), 10);
        const collection = container.querySelector('[fs-cmsnest-collection="tags"]');
        const items = Array.from(collection.children);

        // Randomize items
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
        }

        // Append randomized items back into the collection
        items.forEach(item => collection.appendChild(item));

        // Show items within the specified limit and hide the rest
        items.forEach((item, index) => {
            if (index < limit) {
                item.style.display = 'block';
            } else {
                item.style.display = 'none';
            }
        });
    });
}, 2000);
</script>

