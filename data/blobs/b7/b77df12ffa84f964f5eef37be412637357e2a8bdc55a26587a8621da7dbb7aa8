<script>
function acInitDropdown(selectId, options) {
  var lang = 'en';
  var path = window.location.pathname.toLowerCase();
  var supportedLangs = ['sv','fr','de','es','es-mx','no','pt','nl'];
  for (var li = 0; li < supportedLangs.length; li++) {
    if (path.indexOf('/' + supportedLangs[li] + '/') === 0 || path === '/' + supportedLangs[li]) {
      lang = supportedLangs[li];
      break;
    }
  }

  var localOptions = options.map(function(o) {
    return { value: o.value, text: o[lang] || o['en'] };
  });

  var placeholders = {
    en: 'Pick one', sv: 'Välj ett alternativ', fr: 'Sélectionnez une option',
    de: 'Bitte auswählen', es: 'Selecciona una opción', 'es-mx': 'Selecciona una opción',
    no: 'Velg ett alternativ', pt: 'Selecione uma opção', nl: 'Kies een optie'
  };
  var placeholder = placeholders[lang] || placeholders['en'];

  var select = document.getElementById(selectId);
  var emptyOpt = document.createElement('option');
  emptyOpt.value = '';
  emptyOpt.disabled = true;
  emptyOpt.selected = true;
  select.appendChild(emptyOpt);
  localOptions.forEach(function(opt) {
    var o = document.createElement('option');
    o.value = opt.value;
    o.text = opt.text;
    select.appendChild(o);
  });

  var wrap     = document.getElementById(selectId + '-wrap');
  var control  = document.getElementById(selectId + '-control');
  var search   = document.getElementById(selectId + '-search');
  var dropdown = document.getElementById(selectId + '-dropdown');

  search.setAttribute('placeholder', placeholder);

  var selectedValue = '';
  var isOpen = false;
  var filteredOptions = localOptions.slice();

  function renderDropdown(list) {
    dropdown.innerHTML = '';
    if (list.length === 0) {
      dropdown.innerHTML = '<div class="ac-no-results">No results</div>';
      return;
    }
    list.forEach(function(opt) {
      var div = document.createElement('div');
      div.className = 'ac-option';
      div.textContent = opt.text;
      div.dataset.value = opt.value;
      div.addEventListener('mousedown', function(e) {
        e.preventDefault();
        selectOption(opt);
      });
      dropdown.appendChild(div);
    });
  }

  function selectOption(opt) {
    selectedValue = opt.value;
    search.value = opt.text;
    search.placeholder = '';
    search.style.color = '#ffffff';
    select.value = opt.value;
    var event = new Event('change', { bubbles: true });
    select.dispatchEvent(event);
    close();
  }

  function open() {
    isOpen = true;
    control.classList.add('open');
    dropdown.classList.add('open');
    filteredOptions = localOptions.slice();
    renderDropdown(filteredOptions);
    if (selectedValue) search.value = '';
    search.style.color = '#ffffff';
  }

  function close() {
    isOpen = false;
    control.classList.remove('open');
    dropdown.classList.remove('open');
    if (selectedValue) {
      var found = localOptions.find(function(o) { return o.value === selectedValue; });
      if (found) { search.value = found.text; search.style.color = '#ffffff'; }
    } else {
      search.value = '';
      search.placeholder = placeholder;
    }
  }

  control.addEventListener('click', function(e) {
    if (isOpen && e.target === search) return;
    if (isOpen) { close(); } else { open(); search.focus(); }
  });

  search.addEventListener('input', function() {
    search.style.color = '#ffffff';
    var q = search.value.toLowerCase();
    filteredOptions = localOptions.filter(function(o) {
      return o.text.toLowerCase().indexOf(q) !== -1;
    });
    renderDropdown(filteredOptions);
    if (!isOpen) {
      isOpen = true;
      control.classList.add('open');
      dropdown.classList.add('open');
    }
  });

  document.addEventListener('click', function(e) {
    if (!wrap.contains(e.target)) close();
  });

  if (selectId === 'signUpSource') {
    select.addEventListener('change', function() {
      var otherWrapper = document.getElementById('signUpSourceDescriptionWrapper');
      if (!otherWrapper) return;
      if (this.value === 'Other' || this.value === 'WordOfMouthOrReferral') {
        otherWrapper.style.display = 'block';
      } else {
        otherWrapper.style.display = 'none';
      }
    });
  }
}
</script>

