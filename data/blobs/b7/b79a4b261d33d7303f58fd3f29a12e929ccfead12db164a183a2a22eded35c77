<script type="text/javascript">
  window.googletag = window.googletag || { cmd: [] };

  // ============================================================
  //      NST_STO FAST-TRACK IIFE
  //      Loads NST_STO as soon as its DOM element is available,
  //      independently of the main GPT setup.
  // ============================================================
  (function () {
    var ID   = 'div-gpt-ad-1397716172626-0';
    var PATH = '/1009103/NST_STO_780x585';
    var SIZE = [1, 1];
    var _queued = false;

    function queueNstStoCmd() {
      if (_queued) return;
      _queued = true;

      googletag.cmd.push(function () {
        if (window._nstStoLoaded) return;

        var el = document.getElementById(ID);
        if (!el) return;

        // Set up global services if the main cmd hasn't done it yet
        if (!window._nstGlobalConfigured) {
          googletag.pubads().collapseEmptyDivs(true);
          googletag.pubads().enableSingleRequest();
          googletag.pubads().disableInitialLoad();
          googletag.pubads().set('page_url', 'www.nst.com.my');
          googletag.enableServices();
          window._nstGlobalConfigured = true;
        }

        var slot = googletag.defineSlot(PATH, SIZE, ID);
        if (!slot) return;

        slot.addService(googletag.pubads())
          .setTargeting('site', 'nst')
                    .setTargeting('section', '.well-known-tdmrep.json')
                              .setTargeting('segment', '')
                              .setTargeting('emotion', '')
                              .setTargeting('sentiment', '')
                    .setTargeting('pos', '')
          .setTargeting('key', '');

        window._nstStoLoaded = true;
        window._nstStoSlot  = slot;
        googletag.display(ID);
        googletag.pubads().refresh([slot]);
        console.log('NST_STO: fast-track loaded');
      });
    }

    // Element already in DOM
    if (document.getElementById(ID)) {
      queueNstStoCmd();
      return;
    }

    var obs = new MutationObserver(function () {
      if (document.getElementById(ID)) {
        obs.disconnect();
        obs = null;
        queueNstStoCmd();
      }
    });
    obs.observe(document.documentElement, { childList: true, subtree: true });

    // Final safety net
    document.addEventListener('DOMContentLoaded', function () {
      if (obs) { obs.disconnect(); obs = null; }
      queueNstStoCmd();
    }, { once: true });
  })();

  // ==========================================
  // MAIN GPT SETUP — all other ad slots
  // ==========================================
  googletag.cmd.push(function () {
    let definedSlotIds = new Set();

    function getPlatform() {
      return window.matchMedia('(max-width: 768px)').matches ? 'mobile' : 'desktop';
    }

    let currentPlatform = getPlatform();

    // NST_STO reference — reuse slot if already defined by fast-track
    let nstStoSlot = window._nstStoSlot || null;

    const NST_STO = {
      id: 'div-gpt-ad-1397716172626-0',
      path: '/1009103/NST_STO_780x585',
      size: [1, 1]
    };

    const adSlots = [
      {
        id: 'div-gpt-ad-1565318969398-0',
        path: '/1009103/NST_Outofpage',
        type: 'outOfPage',
      },
      {
        id: 'div-gpt-ad-1397706555683-0',
        path: '/1009103/NST_300x250',
        size: [300, 250],
        platform: 'desktop',
      },
      {
        id: 'div-gpt-ad-1397706611337-0',
        path: '/1009103/NST_300x250_b',
        size: [300, 250],
        platform: 'desktop',
      },
      {
        id: 'div-gpt-ad-1463538534546-0',
        path: '/1009103/NST_1x1',
        size: [1, 1],
      },
      {
        id: 'div-gpt-ad-1463538766750-0',
        path: '/1009103/NST_Island_Ad_400x200',
        size: [[1, 1], [400, 200], [300, 250]],
        platform: 'desktop',
      },
      {
        id: 'div-gpt-ad-1397706669649-0',
        path: '/1009103/970x250_NST',
        size: [[970, 250], [970, 90], [728, 90]],
        platform: 'desktop',
      },
      {
        id: 'div-gpt-ad-1497838820026-0',
        path: '/1009103/NST_Multisize_HouseAds',
        size: [[300, 250], [300, 600]],
        platform: 'desktop',
      },
      {
        id: 'div-gpt-ad-1752643376343-0',
        path: '/1009103/NST_Multisize_HouseAds_Mobile',
        size: [[300, 250], [300, 600]],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1572338498636-0',
        path: '/1009103/NST_pixel',
        size: [1, 1],
      },
      {
        id: 'div-gpt-ad-1397033892304-0',
        path: '/1009103/Mobile_300x250',
        size: [300, 250],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1643101035317-0',
        path: '/1009103/NST_320x50',
        size: [[320, 50], [320, 100]],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1557469993516-0',
        path: '/1009103/NST_Mobile_Banner',
        size: [[320, 50], [300, 250], [320, 100]],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1582165888223-0',
        path: '/1009103/NST_HP_Sticky_Leaderboard',
        size: [320, 50],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1636353417147-0',
        path: '/1009103/NST_Mobile_Banner_b',
        size: [[1, 1], [300, 250], [320, 50], [320, 100]],
        platform: 'mobile',
      },
      {
        id: 'div-gpt-ad-1535527649803-0',
        path: '/1009103/NST_1x1_Programmatic',
        size: [1, 1],
      },
    ];

    function toggleSlotVisibility(newPlatform) {
      adSlots.forEach(({ id, platform }) => {
        const el = document.getElementById(id);
        if (!el) return;
        el.style.display = (platform && platform !== newPlatform) ? 'none' : '';
      });
    }

    // Shared targeting helper — applied to every slot
    function applyTargeting(slot) {
      slot.addService(googletag.pubads())
        .setTargeting('site', 'nst')
                .setTargeting('section', '.well-known-tdmrep.json')
                        .setTargeting('segment', '')
                        .setTargeting('emotion', '')
                        .setTargeting('sentiment', '')
                .setTargeting('pos', '')
        .setTargeting('key', '');
    }

    // ==========================================
    // GPT GLOBAL SERVICES — configured once
    // Respects flag set by the NST_STO fast-track
    // ==========================================
    function ensureGlobalConfig() {
      if (window._nstGlobalConfigured) return;
      googletag.pubads().collapseEmptyDivs(true);
      googletag.pubads().enableSingleRequest();
      googletag.pubads().disableInitialLoad();
      googletag.pubads().set('page_url', 'www.nst.com.my');
      googletag.enableServices();
      window._nstGlobalConfigured = true;
    }

    // ==========================================
    // NST_STO FALLBACK
    // Fast-track handles this in the normal flow
    // ==========================================
    function tryInitNstSto() {
      if (window._nstStoLoaded || nstStoSlot) return true;

      const el = document.getElementById(NST_STO.id);
      if (!el) return false;

      ensureGlobalConfig();

      nstStoSlot = googletag.defineSlot(NST_STO.path, NST_STO.size, NST_STO.id);
      if (nstStoSlot) {
        applyTargeting(nstStoSlot);
        definedSlotIds.add(NST_STO.id);
        window._nstStoLoaded = true;
        window._nstStoSlot  = nstStoSlot;
        googletag.display(NST_STO.id);
        googletag.pubads().refresh([nstStoSlot]);
        console.log('NST_STO: loaded (fallback)');
      }
      return true;
    }

    // Mark NST_STO as already defined if fast-track ran first
    if (window._nstStoLoaded) {
      definedSlotIds.add(NST_STO.id);
    } else if (!tryInitNstSto()) {
      const nstStoObserver = new MutationObserver(() => {
        if (tryInitNstSto()) nstStoObserver.disconnect();
      });
      nstStoObserver.observe(document.documentElement, { childList: true, subtree: true });
      document.addEventListener('DOMContentLoaded', () => {
        nstStoObserver.disconnect();
        tryInitNstSto();
      }, { once: true });
    }

    // ==========================================
    // SHARED INTERSTITIAL COOLDOWN
    // Covers: NST_1x1 + NST_Interstitial
    // ==========================================
        const INTERSTITIAL_FREQUENCY_CAP_ENABLED = true;
        
    const COOLDOWN_MINUTES          = 3;
    const INTERSTITIAL_COOLDOWN_KEY = 'nst:interstitial:last_rendered_at';
    const INTERSTITIAL_COOLDOWN_MS  = COOLDOWN_MINUTES * 60 * 1000;
    const INTERSTITIAL_SLOT_IDS     = new Set(['div-gpt-ad-1463538534546-0']); // NST_1x1
    const INTERSTITIAL_AD_PATH      = '/1009103/NST_Interstitial';

    function isInterstitialBlocked() {
      if (!INTERSTITIAL_FREQUENCY_CAP_ENABLED) return false;
      try {
        const lastSeen = localStorage.getItem(INTERSTITIAL_COOLDOWN_KEY);
        return !!lastSeen && (Date.now() - Number(lastSeen) < INTERSTITIAL_COOLDOWN_MS);
      } catch (e) {
        return false; // fail open — storage unavailable
      }
    }

    function startInterstitialCooldown() {
      if (!INTERSTITIAL_FREQUENCY_CAP_ENABLED) return;
      try {
        localStorage.setItem(INTERSTITIAL_COOLDOWN_KEY, String(Date.now()));
      } catch (e) {
        // storage unavailable — cooldown won't persist
      }
    }

    // ==========================================
    // MAIN INIT
    // ==========================================
    function initAds() {
      if (window._nstAdsInitialised) return;
      window._nstAdsInitialised = true;

      toggleSlotVisibility(currentPlatform);
      ensureGlobalConfig();

      // ---- Shared interstitial cooldown check ----
      const interstitialBlocked = isInterstitialBlocked();
      if (interstitialBlocked) {
        console.log('[Cooldown] Interstitial units blocked — cooldown active');
      }

      // ---- Fill listener — start cooldown only on a real fill, not no-fill ----
      if (!window._nstInterstitialListenerRegistered) {
        window._nstInterstitialListenerRegistered = true;
        googletag.pubads().addEventListener('slotRenderEnded', function (event) {
          if (event.isEmpty) return; // no-fill — do NOT start cooldown
          const slotId   = event.slot.getSlotElementId ? event.slot.getSlotElementId() : '';
          const slotPath = event.slot.getAdUnitPath     ? event.slot.getAdUnitPath()     : '';
          if (INTERSTITIAL_SLOT_IDS.has(slotId) || slotPath === INTERSTITIAL_AD_PATH) {
            startInterstitialCooldown();
            console.log('[Cooldown] Interstitial fill detected — ' + COOLDOWN_MINUTES + ' min cooldown started');
          }
        });
      }

      const slotsToRefresh = [];

      // ---- Define & display all standard slots ----
      adSlots.forEach(({ id, path, size, type, platform }) => {
        if (id === NST_STO.id) return; // handled by the fast-track IIFE
        if (definedSlotIds.has(id)) return;

        const matchesPlatform = !platform || platform === currentPlatform;
        if (!matchesPlatform) return;

        // cooldown applies to NST_1x1 only
        if (interstitialBlocked && INTERSTITIAL_SLOT_IDS.has(id)) return;

        const el = document.getElementById(id);
        if (!el) return;

        const slot = type === 'outOfPage'
          ? googletag.defineOutOfPageSlot(path, id)
          : googletag.defineSlot(path, size, id);

        if (!slot) return;

        applyTargeting(slot);
        definedSlotIds.add(id);
        googletag.display(id);
        slotsToRefresh.push(slot);
      });

      // ---- NST_Interstitial ----
            if (!interstitialBlocked) {
        try {
          const fmt = googletag.enums
            && googletag.enums.OutOfPageFormat
            && googletag.enums.OutOfPageFormat.INTERSTITIAL;

          if (fmt) {
            const interstitialSlot = googletag.defineOutOfPageSlot(
              INTERSTITIAL_AD_PATH,
              fmt
            );

            if (interstitialSlot) {
              applyTargeting(interstitialSlot);
              googletag.display(interstitialSlot);
              slotsToRefresh.push(interstitialSlot);

              if (
                window.adsTypes &&
                window.adsTypes.now &&
                Array.isArray(window.adsTypes.now)
              ) {
                window.adsTypes.now.push('interstitialSlot');
              }

              console.log(
                '[Ads] NST_Interstitial defined with section:',
                interstitialSlot.getTargeting('section')
              );
            }
          } else {
            console.warn(
              '[Ads] Web interstitial format unavailable in this GPT build'
            );
          }
        } catch (e) {
          console.error(
            '[Ads] Interstitial setup failed (other slots unaffected):',
            e
          );
        }
      } else {
        console.log('[Cooldown] NST_Interstitial skipped — cooldown active');
      }
      
      if (slotsToRefresh.length > 0) {
        pwtRequestBids(slotsToRefresh);
      }

      scheduleLateSlotPass();
    }

    function scheduleLateSlotPass() {
      let done = false;

      const run = () => {
        if (done) return;
        done = true;

        const late = [];
        adSlots.forEach(({ id, path, size, type, platform }) => {
          if (id === NST_STO.id || definedSlotIds.has(id)) return;
          if (platform && platform !== currentPlatform) return;
          if (isInterstitialBlocked() && INTERSTITIAL_SLOT_IDS.has(id)) return;

          const el = document.getElementById(id);
          if (!el) return;

          const slot = type === 'outOfPage'
            ? googletag.defineOutOfPageSlot(path, id)
            : googletag.defineSlot(path, size, id);
          if (!slot) return;

          applyTargeting(slot);
          definedSlotIds.add(id);
          googletag.display(id);
          late.push(slot);
        });

        if (late.length) {
          console.log('[Ads] Late pass picked up ' + late.length + ' slot(s)');
          pwtRequestBids(late);
        }
      };

      if (document.readyState === 'complete') {
        setTimeout(run, 1500);
      } else {
        window.addEventListener('load', () => setTimeout(run, 1500), { once: true });
      }
    }

    function pwtRequestBids(definedSlots) {
      if (!definedSlots || definedSlots.length === 0) return;

      var refreshCalled = false;

      function bidsBackHandler(adUnits) {
        if (refreshCalled) return;
        refreshCalled = true;

        if (window.PWT && typeof PWT.setTargeting === 'function') {
          PWT.setTargeting(adUnits || []);
        }

        googletag.pubads().refresh(definedSlots);
        console.log('[PWT] bidsBackHandler fired — GPT refresh sent',
          adUnits ? adUnits.length : 0, 'ad unit(s)');
      }

      var pwtTimeout = setTimeout(function() {
        if (!refreshCalled) {
          console.warn('[PWT] Timeout (1000ms) — firing GPT refresh without PWT bids');
          bidsBackHandler([]);
        }
      }, 1000);

      if (window.PWT && typeof PWT.requestBids === 'function') {
        var adUnits = definedSlots
          .filter(function(slot) { return typeof slot.getSlotElementId === 'function'; })
          .map(function(slot) {
            var id    = slot.getSlotElementId();
            var sizes = slot.getSizes
              ? slot.getSizes().map(function(s) {
                  return typeof s.getWidth === 'function'
                    ? [s.getWidth(), s.getHeight()]
                    : s;
                })
              : [];
            return { code: id, mediaTypes: { banner: { sizes: sizes } }, bids: [] };
          });

        PWT.requestBids(adUnits, function(filledAdUnits) {
          clearTimeout(pwtTimeout);
          bidsBackHandler(filledAdUnits);
        }, 1000);
      } else {
        clearTimeout(pwtTimeout);
        console.warn('[PWT] PWT not available — firing GPT refresh directly');
        bidsBackHandler([]);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAds, { once: true });
    } else {
