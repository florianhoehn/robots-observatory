    <style>
        *, *::after, *::before{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        section{
            background: linear-gradient(116.96deg, #4534BA 19.64%, #4C5EF3 64.81%);
            height: 100vh;
            width: 100vw;
            overflow: hidden;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 0 15px;
        }
        section::after,
        section::before{
            content: '';
            position: absolute;
            z-index: 0;
            transform: skewY(-12deg);
        }
        section::after{
            height: 25%;
            width: 30%;
            right: 0;
            top: 40%;
            background: linear-gradient(256.28deg, #6573F8 -13%, rgba(78, 107, 243, 0) 74.69%);
        }
        section::before{
            height: 20%;
            width: 70%;
            left: 0;
            top: 80%;
            background: linear-gradient(83.67deg, #3F31B3 19.1%, #4C5EF3 71.5%);
        }
        section figure{
            height: 90%;
            width: 55%;
            position: absolute;
            top: 5%;
            right: 5%;
            z-index: 1;
        }
        section div{
            max-width: 1024px;
            flex-basis: 100%;
            position: relative;
            z-index: 2;
        }
        section div >*{
            max-width: 550px;
        }
        section div h1{
            color: #fff;
            font-size: 275px;
            font-weight: normal;
            line-height: 1;
        }
        section div h2{
            color: #C8CCF8;
            font-size: 37px;
            font-weight: normal;
        }
        section div p{
            margin: 35px 0;
            width: 100%;
            max-width: 540px;
            color: #C8CCF8;
            font-size: 18px;
            line-height: 1.6;
        }
        section div span{
            color: #C8CCF8;
            font-size: 18px;
            font-weight: normal;
            line-height: 1;
        }
        section div span a{
            color: #3ED1FF;
            font-size: 18px;
            font-weight: normal;
            line-height: 1;
        }
        @media(max-width: 1024px){
            section div h1{
            color: #fff;
            font-size: 150px;
            }
            section div h2{
                color: #fff;
                font-size: 28px;
            }
            section div p{
                margin: 20px 0;
                margin-top: 15px;
                font-size: 24px;
            }
        }
        section figure svg{
            width: 100%;
        }
    </style>
