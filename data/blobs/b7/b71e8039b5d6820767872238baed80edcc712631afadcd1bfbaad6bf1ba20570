// img crossfade in modules
var faderflag = false;
function toggleFaders () {
  if (faderflag) {
    $(".fader-image.org-1").fadeOut();
    $(".fader-image.pro-1").fadeOut();
    $(".fader-image.org-2").fadeIn();
    $(".fader-image.pro-2").fadeIn();
  } else {
    $(".fader-image.org-1").fadeIn();
    $(".fader-image.pro-1").fadeIn();
    $(".fader-image.org-2").fadeOut();
    $(".fader-image.pro-2").fadeOut();
  }
  faderflag = !faderflag;
}

var currentExecQuoteIdx = 0;
var execQuotes = [/*"chuck", */"anita"/*, "stacy"*/];
function setExecQuotes() {
  var execQuote = execQuotes[currentExecQuoteIdx];

  $("#quotes-section > .quotes-content > .quote").not("."+execQuote).fadeOut();
  $("#quotes-section > .quotes-content > .quote."+execQuote).fadeIn();
}


$(function() {
  setExecQuotes();

  $("#quotes-section .next-arrow").on("click", function() {
    currentExecQuoteIdx = (currentExecQuoteIdx + 1) % execQuotes.length;
    setExecQuotes();
  });
  $("#quotes-section .prev-arrow").on("click", function() {
    // js has some weird modulo problems with negative values so just use
    // length+1 instead of -1
    currentExecQuoteIdx = (currentExecQuoteIdx + execQuotes.length + 1) % execQuotes.length;
    setExecQuotes();
  });

  toggleFaders();
  window.setInterval(toggleFaders, 2500);
});
