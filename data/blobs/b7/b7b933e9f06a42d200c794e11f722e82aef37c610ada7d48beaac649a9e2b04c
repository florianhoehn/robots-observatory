		// La barra de la página anterior, si es reciente, se dibuja al tiro; el
		// fetch igual corre para dejarla al día en la página siguiente.
		var cached = readStored("extstories_returnbar_cache");
		if (
			cached &&
			cached.url === RETURNBAR_URL &&
			Date.now() - Number(cached.savedAt) < 1800000 &&
			isCustom(cached.data)
		) {
			decide(cached.data);
		}

		var timer = setTimeout(function () { decide(null); }, 2000);
		window
			.fetch(RETURNBAR_URL, { credentials: "omit" })
			.then(function (response) { return response.ok ? response.json() : null; })
			.then(function (data) {
				clearTimeout(timer);
				var ok = isCustom(data);
				if (ok) writeStored("extstories_returnbar_cache", { url: RETURNBAR_URL, savedAt: Date.now(), data: data });
				decide(ok ? data : null);
			})
			.catch(function () {
				clearTimeout(timer);
				decide(null);
			});
	} else {
		decide(null);
	}

	function cameFromStories() {
		var ref = document.referrer;
		if (!ref) return false;
		for (var i = 0; i < ORIGINS.length; i++) {
			// Comparación de origen completo: "https://stories.latercera.com.evil.test"
			// no debe pasar por empezar igual.
			if (ref.indexOf(ORIGINS[i] + "/") === 0 || ref === ORIGINS[i]) return true;
		}
		return false;
	}

	function track(action) {
		var payload = { event: "story_shell_action", action: action };
		if (window.dataLayer && window.dataLayer.push) window.dataLayer.push(payload);
		if (typeof window.gtag === "function") {
			window.gtag("event", "story_shell_action", { action: action });
		}
	}

	function onBack(event) {
		track("return_to_stories");
		// history.back() devuelve a la story exacta con su scroll intacto; el
		// href es el respaldo para cuando no hay historial que rebobinar
		// (pestaña nueva, enlace compartido, entrada directa).
		if (cameFromStories() && window.history.length > 1) {
			event.preventDefault();
			window.history.back();
		}
	}

	// El <nav> se pone apenas hay body, vacío si el JSON todavía no llega: así
	// el fondo de la barra ocupa el alto reservado en vez de un hueco en blanco.
	function mount() {
		bar = document.createElement("nav");
		bar.className = "extstories-returnbar";
		bar.setAttribute("aria-label", "Volver a Stories");
		document.body.insertBefore(bar, document.body.firstChild);
		fill();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", mount);
	} else {
		mount();
	}
})();
