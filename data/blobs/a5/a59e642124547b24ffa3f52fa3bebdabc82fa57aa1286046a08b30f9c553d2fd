	<script>
	(function () {
		var languageOpen = false;
		var userOpen = false;

		function getElement(id) {
			return document.getElementById(id);
		}

		function updateSearchForm(form, mode) {
			if (!form) return;
			var input = form.querySelector('input[name="q"]');
			var query = input && input.value ? input.value : '%QUERY%';
			var template = mode === 'photos' ? form.getAttribute('data-photo-url') : form.getAttribute('data-video-url');
			if (template) form.setAttribute('data-url', template.replace('%QUERY%', query));
			form.setAttribute('data-search-mode', mode);
		}

		window.avjbSetSearchMode = function (button, mode) {
			var form = button && button.closest('form');
			if (!form) return;
			form.querySelectorAll('[data-search-mode]').forEach(function (modeButton) {
				var active = modeButton === button;
				modeButton.classList.toggle('is-active', active);
				modeButton.setAttribute('aria-pressed', active ? 'true' : 'false');
			});
			updateSearchForm(form, mode);
		};

		function initializeSearchTypeSelector() {
			var customSelect = getElement('custom_select');
			var searchForm = getElement('search_form');
			if (!customSelect || !searchForm) return;

			var selected = customSelect.querySelector('.select-selected');
			var optionsContainer = customSelect.querySelector('.select-items');
			if (!selected || !optionsContainer) return;

			var options = Array.prototype.slice.call(optionsContainer.querySelectorAll('[data-value]'));
			function closeOptions() {
				optionsContainer.classList.remove('show');
				selected.classList.remove('select-arrow-active');
				selected.setAttribute('aria-expanded', 'false');
			}
			function focusOption(index) {
				if (!options.length) return;
				options[(index + options.length) % options.length].focus();
			}

			selected.addEventListener('click', function (event) {
				event.stopPropagation();
				var isOpen = optionsContainer.classList.toggle('show');
				selected.classList.toggle('select-arrow-active', isOpen);
				selected.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
			});

			selected.addEventListener('keydown', function (event) {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					selected.click();
				} else if (event.key === 'ArrowDown') {
					event.preventDefault();
					optionsContainer.classList.add('show');
					selected.classList.add('select-arrow-active');
					selected.setAttribute('aria-expanded', 'true');
					focusOption(0);
				} else if (event.key === 'Escape') {
					closeOptions();
				}
			});

			options.forEach(function (option, index) {
				option.addEventListener('click', function () {
					var mode = option.getAttribute('data-value') === 'photos' ? 'photos' : 'videos';
					var optionIcon = option.querySelector('.icon');
					var selectedIcon = selected.querySelector('.icon');
					var selectedLabel = selected.querySelector('.search-type-label');
					var label = option.textContent.trim();
					options.forEach(function (item) {
						item.setAttribute('aria-selected', item === option ? 'true' : 'false');
					});
					if (optionIcon && selectedIcon) selectedIcon.className = optionIcon.className;
					if (selectedLabel) selectedLabel.textContent = label;
					selected.setAttribute('aria-label', label);
					closeOptions();
					updateSearchForm(searchForm, mode);
				});
				option.addEventListener('keydown', function (event) {
					if (event.key === 'Enter' || event.key === ' ') {
						event.preventDefault();
						option.click();
						selected.focus();
					} else if (event.key === 'ArrowDown') {
						event.preventDefault();
						focusOption(index + 1);
					} else if (event.key === 'ArrowUp') {
						event.preventDefault();
						focusOption(index - 1);
					} else if (event.key === 'Escape') {
						closeOptions();
						selected.focus();
					}
				});
			});

			document.addEventListener('click', function (event) {
				if (!customSelect.contains(event.target)) closeOptions();
			});

			new MutationObserver(function () {
				selected.setAttribute('aria-expanded', optionsContainer.classList.contains('show') ? 'true' : 'false');
			}).observe(optionsContainer, { attributes: true, attributeFilter: ['class'] });

			searchForm.addEventListener('submit', function () {
				updateSearchForm(searchForm, searchForm.getAttribute('data-search-mode') || 'videos');
			});
		}

		initializeSearchTypeSelector();
		var mobileSearchForm = getElement('avjbMobileSearchForm');
		if (mobileSearchForm) {
			mobileSearchForm.addEventListener('submit', function () {
				updateSearchForm(mobileSearchForm, mobileSearchForm.getAttribute('data-search-mode') || 'videos');
			});
		}
		window.avjbToggleMobileMenu = function () {
			var menu = getElement('avjbMobileMenu');
			var button = getElement('avjbMobileMenuButton');
			if (!menu) return;
			menu.classList.toggle('open');
			if (button) button.setAttribute('aria-expanded', menu.classList.contains('open') ? 'true' : 'false');
		};

		window.avjbToggleLanguageMenu = function () {
			var menu = getElement('avjbLanguageMenu');
			var button = getElement('avjbLanguageButton');
			if (!menu) return;
			languageOpen = !languageOpen;
			menu.classList.toggle('hidden', !languageOpen);
			if (button) button.setAttribute('aria-expanded', languageOpen ? 'true' : 'false');
		};

		window.avjbToggleUserMenu = function () {
			var menu = getElement('avjbUserMenu');
			var button = getElement('avjbUserButton');
			if (!menu) return;
			userOpen = !userOpen;
			menu.classList.toggle('hidden', !userOpen);
			if (button) button.setAttribute('aria-expanded', userOpen ? 'true' : 'false');
		};

		window.avjbToggleMobileUserMenu = function () {
			var overlay = getElement('avjbMobileUserMenuOverlay');
			var button = getElement('avjbMobileUserButton');
			if (!overlay) return;
			overlay.classList.toggle('hidden');
			if (button) button.setAttribute('aria-expanded', overlay.classList.contains('hidden') ? 'false' : 'true');
		};

		window.avjbToggleMobileSearch = function () {
			var overlay = getElement('avjbMobileSearchOverlay');
			var button = getElement('avjbMobileSearchButton');
			if (!overlay) return;
			overlay.classList.toggle('hidden');
			if (button) button.setAttribute('aria-expanded', overlay.classList.contains('hidden') ? 'false' : 'true');
			if (!overlay.classList.contains('hidden')) {
				window.setTimeout(function () {
					var input = getElement('avjbMobileSearchInput');
					if (input) input.focus();
				}, 0);
			}
		};

		document.addEventListener('click', function (event) {
			if (languageOpen && !event.target.closest('.lang-dropdown-container')) avjbToggleLanguageMenu();
			if (userOpen && !event.target.closest('.user-menu-container')) avjbToggleUserMenu();
		});

		document.addEventListener('keydown', function (event) {
			if (event.key !== 'Escape') return;
			var mobileMenu = getElement('avjbMobileMenu');
			var search = getElement('avjbMobileSearchOverlay');
			var mobileUser = getElement('avjbMobileUserMenuOverlay');
			var searchTypeOptions = getElement('avjbSearchTypeOptions');
			if (mobileMenu) mobileMenu.classList.remove('open');
			if (search) search.classList.add('hidden');
			if (mobileUser) mobileUser.classList.add('hidden');
			if (searchTypeOptions) searchTypeOptions.classList.remove('show');
			var mobileMenuButton = getElement('avjbMobileMenuButton');
			var mobileSearchButton = getElement('avjbMobileSearchButton');
			var mobileUserButton = getElement('avjbMobileUserButton');
			if (mobileMenuButton) mobileMenuButton.setAttribute('aria-expanded', 'false');
			if (mobileSearchButton) mobileSearchButton.setAttribute('aria-expanded', 'false');
			if (mobileUserButton) mobileUserButton.setAttribute('aria-expanded', 'false');
			if (languageOpen) avjbToggleLanguageMenu();
			if (userOpen) avjbToggleUserMenu();
		});

		window.addEventListener('resize', function () {
			if (window.innerWidth < 1024) return;
			var mobileMenu = getElement('avjbMobileMenu');
			var search = getElement('avjbMobileSearchOverlay');
			var mobileUser = getElement('avjbMobileUserMenuOverlay');
			if (mobileMenu) mobileMenu.classList.remove('open');
			if (search) search.classList.add('hidden');
			if (mobileUser) mobileUser.classList.add('hidden');
			var mobileMenuButton = getElement('avjbMobileMenuButton');
			var mobileSearchButton = getElement('avjbMobileSearchButton');
			var mobileUserButton = getElement('avjbMobileUserButton');
			if (mobileMenuButton) mobileMenuButton.setAttribute('aria-expanded', 'false');
			if (mobileSearchButton) mobileSearchButton.setAttribute('aria-expanded', 'false');
			if (mobileUserButton) mobileUserButton.setAttribute('aria-expanded', 'false');
		});
	})();
	</script>
