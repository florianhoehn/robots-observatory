  (() => {
  var searchForm = document.querySelector("header form.search__form");

  if (!searchForm) {
    return false;
  }

  function createElement(type, className) {
    var element = document.createElement(type || "div");
    if (className) {
      element.className = className;
    }
    return element;
  }

  function saveSearchTerm(term, savedTerms) {
    if (!term || !savedTerms) {
      return false;
    }

    term = encodeURIComponent(term);

    if (savedTerms.includes(term)) {
      return "Already saved this term";
    }

    savedTerms.unshift(term);

    if (savedTerms.length > 5) {
      savedTerms.pop();
    }

    setSavedTerms(savedTerms);
  }

  function setSavedTerms(savedTerms) {
    localStorage.setItem("siteSearchHistory", JSON.stringify(savedTerms));
  }

  function getSavedTerms() {
    // Should be our array of previous terms, or null if empty
    var savedStorage = JSON.parse(localStorage.getItem("siteSearchHistory"));
    return Array.isArray(savedStorage) ? savedStorage : [];
  }

  function issueSaveRequest() {
    var term = searchForm.querySelector("input[name=text]");
    if (term) {
      saveSearchTerm(term.value, savedTerms);
    }
  }

  function removeTerm(index) {
    if (!index) {
      return false;
    }
    savedTerms.splice(index, 1);
    setSavedTerms(savedTerms);

    previousSearchHTML = generatePreviousSearches(savedTerms);
  }

  function generatePreviousSearches(savedTerms) {
    if (!savedTerms.length) {
      return false;
    }

    var previousSearchHTML = createElement("div");
    previousSearchHTML.className = "search__results-list search__results-list--history d-flex flex-column";
    previousSearchHTML.innerHTML = '<h3 class="h4">Your previous searches</h3>';

    for (var i = 0; i < savedTerms.length; i++) {
      var div = createElement("div", "d-flex");
      var icon = createElement("div");
      icon.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="12" height="12" viewBox="0 0 12 12" style="margin-right: 10px"><path d="M6,0A5.965,5.965,0,0,0,2.036,1.5V.262H1.192V2.576L1.614,3H3.928V2.154H2.564A5.157,5.157,0,1,1,.844,6V5.97L0,5.965V6A6,6,0,1,0,6,0" fill="#013a70"></path><path d="M171.78,79.392v3.424l.108.282,1.956,2.17.627-.565-1.847-2.05V79.392Z" transform="translate(-166.206 -76.816)" fill="#013a70"></path></svg>';
      var a = createElement("a");
      var safeTerm = decodeURIComponent(savedTerms[i]);
      a.innerText = safeTerm;
      a.href = "/search?q=" + safeTerm;
      var remove = createElement("button", "btn--plain saved-search-remove px-1 py-0");
      remove.dataset.index = i;
      remove.innerHTML =
        '<svg xmlns="http://www.w3.org/2000/svg" width="7.778" height="7.778" viewBox="0 0 7.778 7.778"><g transform="translate(-312.188 -595.03) rotate(45)"><rect width="10" height="1" transform="translate(642 199.5)" fill="#bdbcbc"></rect><rect width="10" height="1" transform="translate(647.5 195) rotate(90)" fill="#bdbcbc"></rect></g></svg>';
      div.appendChild(icon);
      div.appendChild(a);
      div.appendChild(remove);
      previousSearchHTML.appendChild(div);
    }

    var hr = createElement("hr", "hr hr--default mb-0");
    previousSearchHTML.appendChild(hr);

    return previousSearchHTML;
  }

  // Get any saved terms, if there are any
  var savedTerms = getSavedTerms();

  searchForm.addEventListener("submit", function () {
    issueSaveRequest();
  });

  searchForm.addEventListener("click", function (e) {
    var findProduct = e.target.closest("a.search__results-product");
    if (findProduct) {
      issueSaveRequest();
    }

    if (e.target.closest(".saved-search-remove")) {
      e.preventDefault();
      removeTerm(e.target.closest(".saved-search-remove").dataset.index);
      searchForm.querySelector("input[name=text]").focus();
    }
  });

  if (savedTerms.length) {
    previousSearchHTML = generatePreviousSearches(savedTerms);

    var style = createElement("style");
    style.innerHTML = ".search__container { max-height: 80vh; overflow: scroll; }";

    var body = document.querySelector("body");
    body.appendChild(style);

    // Options for the observer (which mutations to observe)
    var config = { childList: true, subtree: true };

    // Callback function to execute when mutations are observed
    var callback = (mutationList, observer) => {
      for (var mutation of mutationList) {
        if (mutation.type === "childList") {
          var searchContainer = searchForm.querySelector(".search__container");
          var searchHistory = searchForm.querySelector(".search__container .search__results-list--history");
          if (searchContainer && !searchHistory) {
            var searchResultBox = searchContainer.querySelector(".search__results");
            if (searchResultBox && previousSearchHTML) {
              searchResultBox.insertBefore(previousSearchHTML, searchResultBox.firstChild);
            }
          }
        }
      }
    };

    // Create an observer instance linked to the callback function
    var observer = new MutationObserver(callback);

    // Start observing the target node for configured mutations
    observer.observe(searchForm, config);
  }
})();

