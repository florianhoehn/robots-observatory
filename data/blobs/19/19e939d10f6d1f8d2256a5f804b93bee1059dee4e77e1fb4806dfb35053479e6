      const animationChronographSplitFlap = (mainContainer, container) => {
        document.documentElement.dataset.gxSplash = "chronograph-split-flap";
        container.classList.add("gx-csf-container");

        const text = "GX CORNER";
        const LETTERS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const STAGGER = 50; // per-flap lock offset (ms
        const LEAD_IN = 250; // delay before the first flap starts (ms)
        const LETTER_STEP = 250; // gap between consecutive letters appearing (ms)
        const ROLL_DURATION = 450; // how long a flap tumbles before locking (ms), must be multiplicative of gx-sf-roll duration - 150ms
        const ACCENT_COUNT = 2; // "GX" renders in the brand red

        const letter = () => LETTERS.charAt((Math.random() * LETTERS.length) | 0);

        // Only rendered glyphs take a slot, so the word gap doesn't stall the cadence.
        let slot = 0;

        const chars = text.split("").map((character, index) => {
          const isSpace = character === " ";
          const span = document.createElement("span");
          span.className = `gx-csf-character${index < ACCENT_COUNT ? " accent" : ""}${isSpace ? " space" : ""}`;
          span.textContent = isSpace ? " " : letter();
          const rollAt = LEAD_IN + slot * LETTER_STEP;
          if (!isSpace) {
            slot++;
          }
          const c = {
            el: span,
            real: character,
            space: isSpace,
            rollAt,
            lockAt: rollAt + ROLL_DURATION + STAGGER,
            state: isSpace ? "locked" : "idle", // idle → rolling → locked
          };

          span.addEventListener(
            "animationiteration",
            (function (ch) {
              return function (e) {
                if (
                  e.animationName === "gx-sf-roll" &&
                  ch.state === "rolling" &&
                  !ch.space
                ) {
                  ch.el.textContent = letter();
                }
              };
            })(c),
          );
          container.appendChild(span);

          return c;
        });

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          for (let r = 0; r < chars.length; r++) {
            chars[r].el.textContent = chars[r].real;
          }
          return;
        }

        const start = performance.now();
        let raf;

        function frame(now) {
          if (!container.isConnected) {
            cancelAnimationFrame(raf);
            return;
          }
          const elapsed = now - start;
          let pending = 0;
          for (let k = 0; k < chars.length; k++) {
            const ch = chars[k];
            const isLast = k === chars.length - 1;
            if (ch.state === "locked") {
              continue;
            }
            pending++;
            if (ch.state === "idle") {
              if (elapsed < ch.rollAt) {
                continue;
              }
              ch.state = "rolling";
              ch.el.classList.add("rolling");
            } else if (elapsed >= ch.lockAt) {
              // rolling → locked:
              // final flap onto the true glyph + impact jitter (except last letter)
              ch.state = "locked";
              ch.el.classList.remove("rolling");
              ch.el.textContent = ch.real;
              ch.el.classList.add(isLast ? "locked" : "locking");
            }
          }
          if (pending > 0) {
            raf = requestAnimationFrame(frame);
          } else {
            mainContainer.classList.add("text-ready");
          }
        }
        raf = requestAnimationFrame(frame);
      };

      const animationVerticalSlide = (mainContainer, container) => {
        document.documentElement.dataset.gxSplash = "vertical-slide";
        container.classList.add("gx-vs-container");

        const text = "GX CORNER";
        const STAGGER = 150; // delay between consecutive letters starting (ms)
        const LEAD_IN = 150; // delay before the first letter starts (ms)
        const SLIDE_DURATION = 450; // per-letter slide-in duration (ms)
        const ACCENT_COUNT = 2; // "GX" renders in the brand red

        // Only rendered glyphs take a slot, so the word gap doesn't stall the cadence.
        let slot = 0;
        let pending = 0;
        let fromTop = Math.random() > 0.5;

        const chars = text.split("").map((character, index) => {
          const isSpace = character === " ";
          const span = document.createElement("span");
          span.className = `gx-vs-character${index < ACCENT_COUNT ? " accent" : ""}${
            isSpace ? " space" : fromTop ? " from-top" : " from-bottom"
          }`;
          span.textContent = character;

          if (!isSpace) {
            span.style.animationDelay = `${LEAD_IN + slot * STAGGER}ms`;
            span.style.setProperty("--gx-vs-duration", `${SLIDE_DURATION}ms`);
            slot++;
            pending++;
          }

          container.appendChild(span);
          return { el: span, isSpace, fromTop };
        });

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          return;
        }

        if (pending === 0) {
          mainContainer.classList.add("text-ready");
