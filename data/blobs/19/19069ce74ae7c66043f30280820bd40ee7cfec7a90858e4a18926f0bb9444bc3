/* Container override to force side-by-side horizontal scrolling */
.story-carousel {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  overflow-x: auto !important;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  gap: 0 !important; /* Removes gap between slides so only 1 fits */
  padding-bottom: 1.5rem !important;
  -webkit-overflow-scrolling: touch;
}

/* Force each direct child card wrapper to take 100% full width */
.story-carousel > .wp-block-group {
  flex: 0 0 100% !important; /* Full width for 1 card view */
  max-width: 100% !important;
  min-width: 100% !important;
  scroll-snap-align: start;
  scroll-snap-stop: always; /* Prevents skipping cards when flinging/scrolling quickly */
  box-sizing: border-box;
}

/* Maintain full width across tablet and desktop */
@media (min-width: 768px) {
  .story-carousel > .wp-block-group {
    flex: 0 0 100% !important;
    max-width: 100% !important;
  }
}

//* Prevent inner content overflow */
.story-carousel .wp-block-columns {
  width: 100%;
}

/* Custom scrollbar styling */
.story-carousel::-webkit-scrollbar {
  height: 6px;
}
.story-carousel::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 10px;
}
.story-carousel::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 10px;
}
.story-carousel::-webkit-scrollbar-thumb:hover {
  background: #a8a8a8;
}
/* Hide default scrollbar for a cleaner slider look */
.story-carousel {
  -ms-overflow-style: none;  /* IE and Edge */
  scrollbar-width: none;  /* Firefox */
}
.story-carousel::-webkit-scrollbar {
  display: none; /* Chrome, Safari, Opera */
}

/* Dots Navigation Container */
.carousel-dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10px;
  margin-top: 1.5rem;
}

/* Individual Dot Style */
.carousel-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background-color: #ccc;
  border: none;
  padding: 0;
  cursor: pointer;
  transition: background-color 0.3s ease, transform 0.2s ease;
}

.carousel-dot:hover {
  transform: scale(1.15);
}

/* Active Dot State */
.carousel-dot.active {
  background-color: #000; /* Change to your primary theme color */
  transform: scale(1.25);
}
</style>
