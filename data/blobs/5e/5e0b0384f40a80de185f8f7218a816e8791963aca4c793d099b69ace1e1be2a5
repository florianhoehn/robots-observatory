            .app-initial-loader__root {
                display: flex;
                box-sizing: border-box;
            }
            .app-initial-loader__wrapper {
                display: flex;
                width: 2rem;
                height: 2rem;
                animation: app-initial-loader-rotate 1s linear infinite;
            }
