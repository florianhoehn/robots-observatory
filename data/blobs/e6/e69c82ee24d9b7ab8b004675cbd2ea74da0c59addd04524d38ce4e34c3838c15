                </p>
                
            </div>
            <div class="footer__copyrights">
                © ООО «Драйв», 2008–2026
            </div>
        </div>
    </div>
    <script>
        const dApp = /\bdriveclient\/\d{1,5}(?:\.\d{1,5}){0,2} \(.+?\)$/i.test(navigator.userAgent);
        const d2App = /\bdrive2client(?:-business)?\/\d{1,5}(?:\.\d{1,5}){0,2} \(.+?\)$/i.test(navigator.userAgent);
        if (dApp || d2App) {
            document.documentElement.classList.toggle('dark', dApp);
            document.querySelector('.l-footer').remove();
            document.querySelector('.l-top').style.visibility = 'hidden';
        }
        if (dApp) {
            const altTitle = document.documentElement.querySelector('.js-alt-title');
            if (altTitle) {
                altTitle.previousElementSibling.remove();
                altTitle.style.display = '';
            }
            const altText = document.documentElement.querySelector('.js-alt-text');
            if (altText) {
                altText.previousElementSibling.remove();
                altText.style.display = '';
            }
        }
    </script>
