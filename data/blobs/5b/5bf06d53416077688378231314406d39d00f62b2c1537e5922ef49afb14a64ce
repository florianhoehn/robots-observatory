            var match = /(\d{15,})/.exec(node.getAttribute('src') || '');
            return match ? match[1] : '';
        }

        // /embed/v2 responde 503 ("overload-protect triggered") de forma intermitente;
        // /player/v1 es el player actual de TikTok y no sienta.
        function playerUrl(id) {
            return 'https://www.tiktok.com/player/v1/' + id +
                '?autoplay=0&loop=0&controls=1&play_button=1&progress_bar=1&volume_control=1' +
                '&fullscreen_button=1&music_info=1&description=1&rel=0&native_context_menu=0';
        }

        function card(node) {
            var id = videoId(node),
                link = node.querySelector && node.querySelector('a[href*="/video/"]'),
                text = (node.textContent || '').replace(/\s+/g, ' ').trim(),
                wrap = document.createElement('div'),
                anchor = document.createElement('a');

            wrap.className = 'tt-ctp';
            anchor.className = 'tt-ctp-card';
            anchor.href = (link && link.href) || node.getAttribute('cite') ||
                (id ? playerUrl(id) : 'https://www.tiktok.com/');
            anchor.target = '_blank';
            anchor.rel = 'noopener';
            anchor.innerHTML = '<span class="tt-ctp-play">&#9654;</span>' +
                '<span class="tt-ctp-text">Ver video en TikTok<small></small></span>';
            anchor.querySelector('small').textContent = text
                ? (text.length > MAX_TEXT ? text.slice(0, MAX_TEXT - 1) + '…' : text)
                : 'Tocá para reproducir';

            function mount() {
                var frame = document.createElement('iframe');
                frame.src = playerUrl(id);
                frame.title = 'Video de TikTok';
                frame.loading = 'lazy';
                frame.setAttribute('allow', 'autoplay; clipboard-write; encrypted-media; picture-in-picture');
                frame.setAttribute('allowfullscreen', 'true');
                wrap.appendChild(frame);
            }

            // Embed directo: /player/v1 no sienta, así que no depende de un clic.
            // Sin id verificable queda la tarjeta con el enlace a TikTok.
            if (id) mount();
            else wrap.appendChild(anchor);
            return wrap;
        }

        function process(nodes) {
            for (var i = 0; i < nodes.length; i++) {
                var node = nodes[i];
                if (node.tagName === 'SCRIPT') { node.remove(); continue; } // que TikTok no monte solo
                if (node.parentNode && !node.closest('.tt-ctp')) {
                    node.parentNode.replaceChild(card(node), node);
                }
            }
        }

        function scan() { process(document.querySelectorAll(ALL_SEL)); }

        scan();

        // El cuerpo de la nota se reinyecta (Vue/raw-html) y TikTok re-escanea: hay que re-aplicar.
        new MutationObserver(function (records) {
            for (var i = 0; i < records.length; i++) {
                var added = records[i].addedNodes;
                for (var j = 0; j < added.length; j++) {
                    var node = added[j];
                    if (node.nodeType !== 1) continue;
                    if (node.matches(ALL_SEL)) process([node]);
                    else if (node.querySelector(ALL_SEL)) process(node.querySelectorAll(ALL_SEL));
                }
            }
        }).observe(document.documentElement, { childList: true, subtree: true });

        document.addEventListener('DOMContentLoaded', scan);
    })();
</script>
