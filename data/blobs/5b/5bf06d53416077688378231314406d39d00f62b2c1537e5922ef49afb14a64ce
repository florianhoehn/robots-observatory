<!-- Instagram y X: su script de embed viene dentro del HTML de la nota (uno por embed) y
      procesa los blockquotes una sola vez. Si el cuerpo se re-renderiza después (Vue/raw-html),
      los embeds ya montados se pierden y nadie los reprocesa: queda el fallback del proveedor
      (el bloque gris de X, el placeholder de Instagram). Acá se carga el script una vez y se
      reprocesa después de cada render. -->
<script>
    (function () {
        if (window.__embedsSocial) return; // guard por si conviven varias plantillas
        window.__embedsSocial = true;

        var SOCIAL = [
            {
                sel: 'blockquote.twitter-tweet',
                src: 'https://platform.twitter.com/widgets.js',
                match: 'widgets.js',
                ready: function () { return !!(window.twttr && window.twttr.widgets); },
                run: function () { window.twttr.widgets.load(document.body); }
            },
            {
                sel: 'blockquote.instagram-media',
                src: 'https://www.instagram.com/embed.js',
                match: 'instagram.com/embed.js',
                ready: function () { return !!(window.instgrm && window.instgrm.Embeds); },
                run: function () { window.instgrm.Embeds.process(); }
            }
        ];

        function loadScript(social) {
            if (document.querySelector('script[src*="' + social.match + '"]')) return;
            var el = document.createElement('script');
            el.async = true;
            el.charset = 'utf-8';
            el.src = social.src;
            el.onload = processSocial; // ya se pueden procesar los pendientes
            document.body.appendChild(el);
        }

        // Un proveedor puede tardar en poder procesar (o su script estar a medio cargar):
        // reintentamos hasta MAX_TRIES veces, espaciado en el tiempo; agotados los intentos
        // se deja el fallback del proveedor (legible) en vez de insistir para siempre.
        var MAX_TRIES = 4, RETRY_MS = 1500;

        function processSocial() {
            var retry = false;

            for (var i = 0; i < SOCIAL.length; i++) {
                var social = SOCIAL[i],
                    nodes = document.querySelectorAll(social.sel),
                    pending = [],
                    now = Date.now(),
                    j, node;

                for (j = 0; j < nodes.length; j++) {
                    node = nodes[j];
                    if (+(node.getAttribute('data-embed-try') || 0) >= MAX_TRIES) continue;
                    if (now - (+(node.getAttribute('data-embed-at') || 0)) < RETRY_MS) continue;
                    pending.push(node);
                }
                if (!pending.length) continue;

                if (!social.ready()) { loadScript(social); continue; }   // falta el script del proveedor

                for (j = 0; j < pending.length; j++) {
                    pending[j].setAttribute('data-embed-try', (+(pending[j].getAttribute('data-embed-try') || 0)) + 1);
                    pending[j].setAttribute('data-embed-at', now);
                }
                social.run();   // el proveedor monta el embed; si no pudo, se reintenta
                retry = true;
            }

            if (retry) setTimeout(processSocial, RETRY_MS);
        }

        var timer = null;
        function schedule() {
            if (timer) return;
            timer = setTimeout(function () { timer = null; processSocial(); }, 300);
        }

        processSocial();
        // El cuerpo de la nota se (re)renderiza en el cliente y ahí se pierden los embeds ya
        // montados: hay que volver a procesar los blockquotes que quedaron sin procesar.
        new MutationObserver(schedule).observe(document.documentElement, { childList: true, subtree: true });
        document.addEventListener('DOMContentLoaded', schedule);
        window.addEventListener('load', function () { schedule(); setTimeout(schedule, 2000); setTimeout(schedule, 5000); });
    })();
</script>
