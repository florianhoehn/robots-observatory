      @keyframes fpd-scroll-horizontal {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(-50%);
        }
      }
      
      .fpd-logo-track {
        animation: fpd-scroll-horizontal 40s linear infinite;
      }
      
      @media (min-width: 1024px) {
        .fpd-logo-track {
          animation: none;
        }
      }

      .fpd-mask_fade {
        mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
      }

      @media (min-width: 1024px) {
        .fpd-mask_fade {
          mask-image: none;
        }
      }

      .fp-logo-grid { 
        color: var(--logo-color);
      }

    /* Scroll mode: keep animation on desktop */
    .fpd-logo-scroll-always .fpd-logo-track {
      animation: fpd-scroll-horizontal 40s linear infinite;
    }

    /* Pause on hover */
    .fpd-logo-scroll-always:hover .fpd-logo-track {
      animation-play-state: paused;
    }

    /* Keep fade mask on desktop in scroll mode */
    .fpd-logo-scroll-always.fpd-mask_fade {
      mask-image: linear-gradient(to right, transparent 0%, black 10%, black 90%, transparent 100%);
    }

    /* Respect reduced motion preference */
    @media (prefers-reduced-motion: reduce) {
      .fpd-logo-track,
      .fpd-logo-scroll-always .fpd-logo-track {
        animation: none;
      }
    }

    .fp-logo-mono {
      display: block;
      background-color: currentColor;
      -webkit-mask-repeat: no-repeat;
              mask-repeat: no-repeat;
      -webkit-mask-position: center;
              mask-position: center;
      -webkit-mask-size: contain;
