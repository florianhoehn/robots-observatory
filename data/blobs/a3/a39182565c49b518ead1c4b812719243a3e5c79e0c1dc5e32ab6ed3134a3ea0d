<style>:root {
  /* Follow Buttons */
  --follow-btn-color-pelcro-fix: rgb(167, 173, 178);
  --follow-btn-hover-color-pelcro-fix: rgb(31, 31, 31);

  /* Save Buttons */
  --save-btn-color-pelcro-fix: rgb(31, 31, 31);

  /* Tooltip */
  --tooltip-bg-color-pelcro-fix: rgb(29, 46, 64);
  --tooltip-text-color-pelcro-fix: #fff;

  /* Small Flag */
  --promo-flag-inactive-color-pelcro-fix: rgb(117, 117, 117);
  --promo-flag-hover-color-pelcro-fix: rgb(31, 31, 31);

  /* Shared theme variables already in use */
  /* --themeBtnBgColor2 */
  /* --themeBtnBgColorHover2 */
}

/* Follow Buttons */
.a-button--follow {
  color: var(--follow-btn-color-pelcro-fix) !important;
  border-color: var(--follow-btn-color-pelcro-fix) !important;
}

.a-button--follow:hover {
  color: var(--follow-btn-hover-color-pelcro-fix) !important;
  border-color: var(--follow-btn-hover-color-pelcro-fix) !important;
}

.a-button--follow.is-active {
  color: var(--themeBtnBgColor2) !important;
  border-color: var(--themeBtnBgColor2) !important;
}

.a-button--follow.is-active:hover {
  color: var(--themeBtnBgColorHover2) !important;
  border-color: var(--themeBtnBgColorHover2) !important;
}

/* Save Buttons */
.pelcro-save-button {
  color: var(--save-btn-color-pelcro-fix);
}

.pelcro-save-button:hover {
  color: var(--save-btn-color-pelcro-fix) !important;
}

.pelcro-save-button.is-active {
  color: var(--themeBtnBgColor2) !important;
}

.pelcro-save-button.is-active:hover {
  color: var(--themeBtnBgColorHover2) !important;
}

/* Tooltip — dark blue */
.m-actionbar__tooltip {
  background-color: var(--tooltip-bg-color-pelcro-fix);
  color: var(--tooltip-text-color-pelcro-fix);
}

/* Small Flag */
/* Default: not visible */
.m-promo .a-promo-favorite {
  opacity: 0;
  visibility: hidden;
}

/* Hover on article card (inactive flag): grey outline appears */
.m-promo:hover .a-promo-favorite {
  opacity: 1;
  visibility: visible;
  color: var(--promo-flag-inactive-color-pelcro-fix) !important;
}

/* Hover directly on the flag (still inactive): solid black */
.m-promo .a-promo-favorite:hover {
  color: var(--promo-flag-hover-color-pelcro-fix) !important;
}

/* Active (saved): solid red — always visible */
.m-promo .a-promo-favorite.is-active {
  opacity: 1;
  visibility: visible;
  color: var(--themeBtnBgColor2) !important;
}

/* Hover on active flag: dark red */
.m-promo .a-promo-favorite.is-active:hover {
  color: var(--themeBtnBgColorHover2) !important;
}

/* Samsung S20 — "Following" button overlapping "Contributor" */
@media (max-width: 480px) {
  .m-promo--saved-profile .m-promo__tagline {
    display: block;
    margin-bottom: 8px;
  }

  .m-promo--saved-profile .m-promo__action {
    margin-top: 12px;
  }
}

/* iPhone SE / XR / 12 Pro Sponsored Events Overlap */
@media (max-width: 480px) {
  .m-promo--event .m-promo__sponsor {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: calc(100% - 60px); /* reserve room for the save button */
  }
}</style>

    
    
    
