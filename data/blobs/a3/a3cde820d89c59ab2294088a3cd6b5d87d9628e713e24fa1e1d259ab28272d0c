                        "zipCode1" : "BT29"
                    }]
                    dataLayer.push(customersGeolocationDataForGTM);
                },
                (error) => {
                    switch (error.code) {
                        case error.PERMISSION_DENIED:
                        case error.POSITION_UNAVAILABLE:
                        case error.TIMEOUT:
                            break;
                        default:
                    }
                }
            );
        }
