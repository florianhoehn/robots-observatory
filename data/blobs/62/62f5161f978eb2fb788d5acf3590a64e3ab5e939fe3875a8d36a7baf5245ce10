            color: var(--text-muted);
        }

        .footer-info span {
            display: inline-flex;
            align-items: center;
            white-space: nowrap;
        }

        .footer-info strong {
            color: #000;
            background: #e0e0e0;
            padding: 2px 6px;
            border-radius: 4px;
            margin-left: 6px;
            font-weight: 600;
        }

        @media (max-width: 600px) {
            h1 { font-size: 4rem; }
            h2 { font-size: 1.5rem; }
            .logo-container img { height: 80px; }
            .footer-info { flex-direction: column; align-items: flex-start; gap: 8px; }
        }
    </style>
