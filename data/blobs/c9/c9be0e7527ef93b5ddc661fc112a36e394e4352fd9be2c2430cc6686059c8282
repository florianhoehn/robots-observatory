<script type="text/javascript">
    function applyDidomiTransformation() {
        const host = document.getElementById('didomi-host')
        if (!host) return

        const popupContainer = host.querySelector('.didomi-popup-container')
        const btnAgree = host.querySelector('#didomi-notice-agree-button')
        const btnContainer = host.querySelector('.didomi-popup-notice-buttons, .didomi-components-button-container')

        // Elementos críticos no listos aún — esperar al siguiente ciclo de renderizado
        if (!popupContainer || !btnAgree || !btnContainer) return

        // Prevenir duplicado de inyección de componentes personalizados
        if (host.querySelector('.cp-custom-header')) return

        // Preparar cabecera personalizada
        const headerEl = document.createElement('div')
        headerEl.className = 'cp-custom-header'
        headerEl.innerHTML =
            '<h2 class="cp-title">¿Continuar con publicidad?</h2>' +
            '<p class="cp-subtitle">Navegar por eltiempo.es con publicidad personalizada, seguimiento y cookies de forma gratuita.</p>'

        // Inyectar la cabecera JUSTO DESPUÉS del logotipo en la estructura DOM
        const logoEl = popupContainer.querySelector('.didomi-popup-notice-logo')
        if (logoEl) {
            logoEl.insertAdjacentElement('afterend', headerEl)
        } else {
            popupContainer.insertBefore(headerEl, popupContainer.firstChild)
        }

        // Inyectar el botón dinámico de suscripción previo al botón nativo de aceptación (para forzar grid-column: 1)
        const btnSubscribe = document.createElement('button')
        btnSubscribe.className = 'didomi-components-button btn-custom-subscribe'
        btnSubscribe.setAttribute('role', 'button')
        btnSubscribe.innerHTML = "<span>Rechazar anuncios y suscribirse</span>"
        btnSubscribe.onclick = function (e) {
            e.preventDefault()
            e.stopImmediatePropagation()
            window.rcUpgrade()
            return false
        }
        btnAgree.insertAdjacentElement('beforebegin', btnSubscribe)

        // Bloque consolidado inferior invertido (Inicio de sesión primero, Ajustes después)
        const isLoggedIn = document.cookie.split(';').some(c => c.trim().startsWith('elt-user-tier='))

        const loginText = isLoggedIn
            ? '<div>Para acceder a la Web debe Aceptar las cookies.</div>'
            : '<div>¿Ya utilizas eltiempo? <a href="#" id="cp-login-trigger">Iniciar sesión</a></div>'

        const linksFooter = document.createElement('div')
        linksFooter.className = 'cp-custom-links-container'
        linksFooter.innerHTML =
            loginText +
            '<div><a href="#" id="cp-settings-trigger" onclick="if(window.Didomi){Didomi.preferences.show(); return false;}">Información y ajustes</a></div>'
        btnContainer.appendChild(linksFooter)

        // Vincular handlers específicos post-renderización
        setTimeout(function () {
            const loginTrigger = host.querySelector('#cp-login-trigger')
            if (loginTrigger) {
                loginTrigger.onclick = function (e) {
                    e.preventDefault()
                    e.stopImmediatePropagation()
                    window.rcLogin()
                    return false
                }
            }

            const settingsTrigger = host.querySelector('#cp-settings-trigger')
            if (settingsTrigger) {
                settingsTrigger.onclick = function (e) {
                    e.preventDefault()
                    e.stopImmediatePropagation()
                    if (window.Didomi && window.Didomi.preferences) {
                        window.Didomi.preferences.show()
                    }
                    return false
                }
            }
        }, 50)
    }

    // Interceptores de eventos del SDK
    window.didomiEventListeners = window.didomiEventListeners || []
    window.didomiEventListeners.push({
        event: 'notice.shown',
        listener: function () {
            applyDidomiTransformation()

            // Bucle de control por asincronía del DOM de Didomi
            const controlLoop = setInterval(function () {
                applyDidomiTransformation()
                const host = document.getElementById('didomi-host')
                if (host && host.querySelector('.cp-custom-header')) clearInterval(controlLoop)
            }, 50)

            setTimeout(function () {
                clearInterval(controlLoop)
            }, 3000)
        }
    })
</script>

