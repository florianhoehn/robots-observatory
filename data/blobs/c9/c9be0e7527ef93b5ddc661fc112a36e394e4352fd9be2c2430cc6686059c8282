            <!-- Aviso de consentimiento para cookies de Didomi -->
        <script type="text/javascript">
    (function () {
        function parseJwt(token) {
            try {
                const base64Url = token.split('.')[1]
                if (!base64Url) return null
                const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/')
                const jsonPayload = decodeURIComponent(
                    Array.prototype.map.call(atob(base64), function (c) {
                        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2)
                    }).join('')
                )
                return JSON.parse(jsonPayload)
            } catch (e) {
                return null
            }
        }

        function readUserInfoFromCookie() {
            const row = document.cookie.split('; ').find(function (entry) {
                return entry.startsWith('elt-user-tier=')
            })
            if (!row) return {userId: '', isPremium: false}

            const rawToken = row.split('=').slice(1).join('=')
            const token = decodeURIComponent(rawToken || '')
            const payload = parseJwt(token)
            if (!payload) return {userId: '', isPremium: false}

            return {
                userId: payload.uid || '',
                isPremium: Boolean(payload.is_premium)
            }
        }

        const userInfo = readUserInfoFromCookie()
        window.consentPayUserInfo = userInfo
        window.consentPayIsPremiumUser = userInfo.isPremium === true
    })()
</script>


