/* &#9472;&#9472; grid & cards &#9472;&#9472; */
.newsletter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px,1fr));
  gap: 1rem;
  margin-bottom: 2rem;
}

.newsletter-card {
  position: relative;
  border: 2px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
  background: #fff;
  cursor: pointer;
  transition: border-color .2s, background .2s;
}

.newsletter-card input {
  opacity: 0;
  position: absolute;
}

.card-img img {
  width: 100%;
  display: block;
}

.card-inner {
  padding: 1rem;
  text-align: center;
}

.card-icon {
  font-size: 2rem;
  margin-bottom: .5rem;
}

.card-icon::before {
  content: "\002B";
}

.newsletter-card.checked .card-icon::before {
  content: "\2713";
  color: #003366;
  transform: rotate(360deg);
  display: inline-block;
  transition: transform .3s;
}

