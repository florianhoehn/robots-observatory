window.addEventListener('DOMContentLoaded', () => {
  const nav = document.querySelector('[nav-move]');
  if (!nav) return;
  const shiftDesktop = 96;  // 6rem
  const shiftMobile  = 64;  // 4rem
  const duration = 0.5;
  const ease = 'power2.out';
  let lastY = window.scrollY;
  let hidden = false;
  const show = () => {
    if (hidden) {
      gsap.to(nav, { top: 0, duration, ease });
      hidden = false;
    }
  };
  const hide = (shiftPx) => {
    if (!hidden) {
      gsap.to(nav, { top: -shiftPx, duration, ease });
      hidden = true;
    }
  };
  window.addEventListener('scroll', () => {
    const curY = Math.max(0, window.scrollY);
    const shift = window.innerWidth <= 767 ? shiftMobile : shiftDesktop;

    if (curY <= 2) {
      show();
    } else if (curY > lastY && !hidden) {
      hide(shift);
    } else if (curY < lastY && hidden) {
      show();
    }
    lastY = curY;
  }, { passive: true });
});
