<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Redirecting...</title>
</head>
<body>
  <script>
    (function () {
      try {
        const subdomainMap = {
          "www": "main",
          "www-qa": "main",
          "www-beta": "main",
          "www-beta2": "main",
          "us": "futures",
          "us-beta": "futures",
          "us-beta2": "futures",
          "jp": "main",
          "jp-beta": "main",
          "jp-beta2": "main",
          "cdn-main": "main",
          "cdn-main-qa": "main"
        };
        const hostname = window.location.hostname || "";
        const parts = hostname.split(".");
        const subdomain = parts[0] || "";
        // 1. DYNAMIC STATUS CODE DETECTION VIA PERFORMANCE API
        let errorCode = "500"; // Fallback default
        
        const navEntries = performance.getEntriesByType("navigation");
        if (navEntries.length > 0 && navEntries[0].responseStatus) {
          // Captures exact HTTP status (520, 502, 504, 403, 404, etc.)
          const httpStatus = navEntries[0].responseStatus;
          if (httpStatus >= 400) {
            errorCode = String(httpStatus);
          }
        }
        // 2. Cloudflare edge tokens
        const rawGeo = "GB";
        const geoCountry = (rawGeo && !rawGeo.includes("::")) ? rawGeo.toUpperCase() : "N/A";
        const rayId = "a4d327f49b921b7e";
        const clientIp = "82.39.15.43";
        const targetSubdomain = subdomainMap[subdomain] || "main";
        // 3. Save error payload in root-domain cookie
        const errorPayload = {
          errorCode: errorCode,
          rayId: rayId,
          clientIp: clientIp,
          geo: geoCountry,
          product: targetSubdomain
        };
        const cookieValue = encodeURIComponent(JSON.stringify(errorPayload));
        
        const domainParts = hostname.split('.');
        const rootDomain = domainParts.length >= 2 
          ? `.${domainParts.slice(-2).join('.')}` 
          : hostname;
        document.cookie = `cf_error_payload=${cookieValue}; path=/; domain=${rootDomain}; max-age=30; Secure; SameSite=Lax`;
        // 4. Clean redirect
        const target = `https://lp.plus500.com/${targetSubdomain}`;
        const finalRedirectUrl = target + window.location.search;
        window.location.replace(finalRedirectUrl);
      } catch (err) {
        console.error("Redirection error caught:", err);
        window.location.replace("https://lp.plus500.com/main");
      }
    })();
  </script>
</body>
</html>