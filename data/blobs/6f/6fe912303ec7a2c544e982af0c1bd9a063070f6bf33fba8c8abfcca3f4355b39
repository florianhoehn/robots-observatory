    <script>
    document.addEventListener("DOMContentLoaded", function () {
      const selector = '.node--full .field--name-body [class*="col-"]';
      const cols = Array.from(document.querySelectorAll(selector)).filter(function (col) {
        return !(col.parentElement && col.parentElement.classList.contains("row"));
      });

      cols.forEach(function (col) {
        if (col.parentElement && col.parentElement.classList.contains("row")) return;
        console.log('inline running!');
        const next = col.nextElementSibling;
        const row = document.createElement("div");
        row.classList.add("row");
        row.setAttribute('data-legacy-col-fixed', 'true')
        col.parentNode.insertBefore(row, col);
        row.appendChild(col);

        let current = next;
        while (
          current &&
          current.matches("[class*='col-']") &&
          !current.parentElement.classList.contains("row")
          ) {
          const toMove = current;
          current = current.nextElementSibling;
          row.appendChild(toMove);
        }
      });
    });
  </script>

