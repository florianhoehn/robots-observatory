<script>
(function() {
	var resultsEl = document.getElementById('results');
	var form      = document.getElementById('search-404');
	var input     = document.getElementById('q');

	var INDEX_URL = '/learn/search-learn.php';

	function escapeHtml(s) {
		return (s || '').replace(/[&<>"']/g, function(m) {
			return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m];
		});
	}

	function badge(cat) {
		if (!cat) return '';
		var map = {
			'understanding-filtering': 'Learn',
			'how-to': 'How-To',
			'advanced': 'Advanced',
			'product': 'Product',
			'comparison': 'Compare',
			'articles': 'Article',
			'solutions': 'Solutions'
		};
		var label = map[cat] || cat;
		if (cat.indexOf('support-') === 0) label = 'Support';
		return '<span class="badge bg-light text-dark">' + escapeHtml(label) + '</span>';
	}

	function render(results, q) {
		if (!q || !q.trim()) { resultsEl.innerHTML = ''; return; }
		if (!results.length) {
			resultsEl.innerHTML = '<div class="alert alert-warning">No results for <strong>' + escapeHtml(q) + '</strong>. Try different keywords.</div>';
			return;
		}
		var html = results.map(function(r) {
			return '<div class="mb-3">' +
				'<h5 class="mb-1"><a href="' + escapeHtml(r.url || '#') + '">' + escapeHtml(r.title || '(Untitled)') + '</a></h5>' +
				'<div class="small text-muted">' + escapeHtml(r.description || '') + '</div>' +
				'<div class="small mt-1">' + badge(r.category) + '</div>' +
				'</div>';
		}).join('');
		resultsEl.innerHTML = '<div class="card shadow-sm border-0 p-3">' + html + '</div>';
	}

	function doSearch(q) {
		if (!q || !q.trim()) { render([], ''); return; }
		fetch(INDEX_URL + '?q=' + encodeURIComponent(q))
			.then(function(res) { return res.json(); })
			.then(function(data) { render(data, q); })
			.catch(function() { render([], q); });
	}

	form.addEventListener('submit', function(e) {
		e.preventDefault();
		doSearch(input.value);
	});

	var t;
	input.addEventListener('input', function() {
		clearTimeout(t);
		t = setTimeout(function() { doSearch(input.value); }, 200);
	});
})();
</script>
