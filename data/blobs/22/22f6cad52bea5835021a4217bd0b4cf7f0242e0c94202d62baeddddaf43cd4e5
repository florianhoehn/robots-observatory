    const WEBMAIL_SITES = new Set(['mail.google.com', 'mail.yahoo.com', 'outlook.live.com', 'outlook.office.com', 'outlook.office365.com', 'mail.aol.com', 'mail.proton.me', 'protonmail.com', 'app.fastmail.com', 'mail.zoho.com', 'icloud.com', 'mail.icloud.com', 'mail.me.com', 'mail.mac.com', 'webmail.earthlink.net', 'mail.comcast.net', 'webmail.verizon.net', 'mail.gmx.com', 'mail.gmx.net', 'web.de', 'mail.163.com', 'mail.126.com', 'qiye.163.com', 'exmail.qq.com', 'mail.qq.com']);

    const AI_REFERRAL_SITES = new Set(['chatgpt.com', 'chat.openai.com', 'openai.com', 'claude.ai', 'anthropic.com', 'gemini.google.com', 'bard.google.com', 'aistudio.google.com', 'notebooklm.google.com', 'copilot.microsoft.com', 'copilot.bing.com', 'edgeservices.bing.com', 'perplexity.ai', 'you.com', 'phind.com', 'poe.com', 'character.ai', 'c.ai', 'pi.ai', 'heypi.com', 'inflection.ai', 'deepseek.com', 'chat.deepseek.com', 'mistral.ai', 'chat.mistral.ai', 'x.ai', 'grok.x.ai', 'groq.com', 'huggingface.co', 'cohere.com', 'coral.cohere.com', 'meta.ai', 'ai.meta.com', 'kagi.com', 'consensus.app', 'exa.ai', 'metaphor.systems', 'jasper.ai', 'copy.ai', 'writesonic.com', 'rytr.me']);

    const AI_SOURCE_NAMES = new Set(['chatgpt', 'chatgpt.com', 'openai', 'claude', 'claude.ai', 'anthropic', 'gemini', 'bard', 'google-gemini', 'copilot', 'bing-copilot', 'microsoft-copilot', 'perplexity', 'perplexity.ai', 'you.com', 'youchat', 'phind', 'poe', 'grok', 'xai', 'deepseek', 'mistral', 'meta-ai', 'metaai', 'pi', 'heypi']);

    const UTM_PARAMS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content', 'utm_platform', 'campaignid', 'adgroupid', 'adid', 'landing_page', 'referrer_url', 'cid'];

    const AD_CLICK_IDS = ['gclid', 'dclid', 'li_fat_id', 'msclkid', 'fbclid'];

    const INTERNAL_DOMAINS = new Set(['cyberhaven.com', 'events.cyberhaven.com', 'www.cyberhaven.com', 'cyberhaven-2-0.webflow.io', 'www.cyberhaven-2-0.webflow.io']);

    const CLEANUP_DOMAINS = ['www.cyberhaven.com', 'cyberhaven.com', 'cyberhaven-2-0.webflow.io', 'cyberhaven-3-0.webflow.io'];

    const COOKIE_DOMAIN = '.cyberhaven.com';
    const PRESERVE_PARAMS = new Set(['landing_page', 'referrer_url']);

    const CookieUtils = {
      set: function (name, value) {
        if (!name) return;
        if (!value || !String(value).trim()) {
          this.delete(name, COOKIE_DOMAIN);
          try {
            localStorage.removeItem(name);
          } catch (e) {}
          return;
        }
        const encoded = encodeURIComponent(String(value).trim());
        const expires = new Date(Date.now() + 90 * 864e5).toUTCString();
        document.cookie = name + '=' + encoded + ';domain=' + COOKIE_DOMAIN + ';path=/' + ';expires=' + expires + ';SameSite=Lax';
        try {
          localStorage.setItem(name, String(value).trim());
        } catch (e) {}
      },

      get: function (name) {
        try {
          const lsVal = localStorage.getItem(name);
          if (lsVal) {
            this.set(name, lsVal);
            return lsVal;
          }
        } catch (e) {}
        const match = document.cookie.match(new RegExp('(?:^|;\\s*)' + name + '=([^;]*)'));
        return match ? decodeURIComponent(match[1]) : null;
      },

      delete: function (name, domain) {
        document.cookie = name + '=;domain=' + domain + ';path=/;expires=Thu, 01 Jan 1970 00:00:00 GMT';
      },
    };

    function getUrlParam(name) {
      return new URLSearchParams(window.location.search).get(name);
    }

    function isInternal(hostname) {
      const clean = hostname.replace(/^www\./, '');
      return INTERNAL_DOMAINS.has(hostname) || INTERNAL_DOMAINS.has(clean);
    }

    function getCleanUrl() {
      return window.location.origin + window.location.pathname;
    }

    function getReferrerInfo() {
      if (!document.referrer) return { source: 'cyberhaven.com', medium: 'direct' };
      var url;
      try {
        url = new URL(document.referrer);
      } catch (e) {
        return { source: 'cyberhaven.com', medium: 'direct' };
      }
      const fullHost = url.hostname.toLowerCase();
      const host = fullHost.replace(/^www\./, '');

      if (SEARCH_ENGINES.has(host)) {
        const term = url.searchParams.get('q') || url.searchParams.get('query') || url.searchParams.get('p') || '(not provided)';
        return { source: host, medium: 'organic', term: term };
      }
      if (SOCIAL_SITES.has(host)) return { source: host, medium: 'social' };
      if (WEBMAIL_SITES.has(fullHost)) return { source: fullHost, medium: 'email' };
      if (AI_REFERRAL_SITES.has(host)) return { source: host, medium: 'ai_referral' };
      return { source: host, medium: 'referral' };
    }

    function ensureClickIds() {
      for (var i = 0; i < AD_CLICK_IDS.length; i++) {
        var id = AD_CLICK_IDS[i];
        if (!CookieUtils.get(id)) {
          CookieUtils.set(id, getUrlParam(id) || 'none');
        }
      }
    }

    function ensureSourceMedium() {
      if (CookieUtils.get('utm_source') && CookieUtils.get('utm_medium')) return;

      var existingSource = CookieUtils.get('utm_source');
      if (existingSource && AI_SOURCE_NAMES.has(existingSource.toLowerCase())) {
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'ai_referral');
        return;
      }

      var gclid = getUrlParam('gclid');
      var msclkid = getUrlParam('msclkid');
      var liId = getUrlParam('li_fat_id');
      var fbId = getUrlParam('fbclid');
      var dclid = getUrlParam('dclid');

      if (gclid) {
        if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', 'google');
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'cpc');
        return;
      }
      if (msclkid) {
        if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', 'bing');
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'cpc');
        return;
      }
      if (liId) {
        if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', 'linkedin');
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'paid-social');
        return;
      }
      if (fbId) {
        if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', 'facebook');
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'paid-social');
        return;
      }
      if (dclid) {
        if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', 'google');
        if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', 'display');
        return;
      }

      var info = getReferrerInfo();
      if (!CookieUtils.get('utm_source')) CookieUtils.set('utm_source', info.source);
      if (!CookieUtils.get('utm_medium')) CookieUtils.set('utm_medium', info.medium);
      if (info.term && !CookieUtils.get('utm_term')) CookieUtils.set('utm_term', info.term);
    }

    function clearAttributionParams() {
      for (var i = 0; i < UTM_PARAMS.length; i++) {
        if (!PRESERVE_PARAMS.has(UTM_PARAMS[i])) {
          CookieUtils.set(UTM_PARAMS[i], '');
        }
      }
    }

    function processTrafficSource() {
      var refHost = null;
      try {
        if (document.referrer) refHost = new URL(document.referrer).hostname.toLowerCase();
      } catch (e) {}
      var isInternalNav = refHost && isInternal(refHost);

      if (!isInternalNav) {
        CookieUtils.set('landing_page', getCleanUrl());
        CookieUtils.set('referrer_url', document.referrer || 'direct');
      }

      var hasUtmParams = UTM_PARAMS.some(function (p) {
        return !PRESERVE_PARAMS.has(p) && getUrlParam(p);
      });
      var hasClickIds = AD_CLICK_IDS.some(function (id) {
        return getUrlParam(id);
      });

      if (hasUtmParams || hasClickIds) {
        for (var i = 0; i < UTM_PARAMS.length; i++) {
          var p = UTM_PARAMS[i];
          if (PRESERVE_PARAMS.has(p)) continue;
          var val = getUrlParam(p);
          if (val) CookieUtils.set(p, val);
        }
        for (var j = 0; j < AD_CLICK_IDS.length; j++) {
          var id = AD_CLICK_IDS[j];
          CookieUtils.set(id, getUrlParam(id) || 'none');
        }
        ensureSourceMedium();
        return;
      }

      if (isInternalNav) {
        ensureSourceMedium();
        ensureClickIds();
        return;
      }

      var refInfo = refHost ? getReferrerInfo() : null;

      if (refInfo && (refInfo.medium === 'organic' || refInfo.medium === 'social' || refInfo.medium === 'email' || refInfo.medium === 'ai_referral')) {
        clearAttributionParams();
        CookieUtils.set('utm_source', refInfo.source);
        CookieUtils.set('utm_medium', refInfo.medium);
        if (refInfo.term) CookieUtils.set('utm_term', refInfo.term);
        for (var k = 0; k < AD_CLICK_IDS.length; k++) {
          CookieUtils.set(AD_CLICK_IDS[k], 'none');
        }
        return;
      }

      if (refInfo && refInfo.medium === 'referral') {
        clearAttributionParams();
        CookieUtils.set('utm_source', refInfo.source);
        CookieUtils.set('utm_medium', refInfo.medium);
        ensureClickIds();
        return;
      }

      ensureSourceMedium();
      ensureClickIds();
    }

    function syncGACookies() {
      var GA_MAPPING = [
        ['utm_source', 'ga_source'],
        ['utm_medium', 'ga_medium'],
        ['utm_campaign', 'ga_campaign'],
        ['utm_content', 'ga_content'],
        ['utm_term', 'ga_term'],
      ];
      for (var i = 0; i < GA_MAPPING.length; i++) {
        var val = CookieUtils.get(GA_MAPPING[i][0]);
        CookieUtils.set(GA_MAPPING[i][1], val || '');
      }
      CookieUtils.set('ga_landing_page', CookieUtils.get('landing_page') || getCleanUrl());
    }

    //multi hubspot types begin
    /* Values that are not in cookie/localStorage and need their own source. */
    function resolveSpecial(key) {
      if (key === 'conversion_page') {
        return CookieUtils.get('conversion_page') || getCleanUrl();
      }
      if (key === 'landing_page') {
        return CookieUtils.get('landing_page') || CookieUtils.get('ga_landing_page') || getCleanUrl();
      }
      if (key === 'posthog_session_id') {
        try {
          return window.posthog && window.posthog.get_session_id ? window.posthog.get_session_id() : '';
        } catch (e) {
          return '';
        }
      }
      return null;
    }

    function populateFormFields() {
      var forms = document.querySelectorAll('form');
      for (var i = 0; i < forms.length; i++) {
        var inputs = forms[i].querySelectorAll('input[type="hidden"]');
        for (var j = 0; j < inputs.length; j++) {
          var input = inputs[j];
          var name = input.getAttribute('name');
          if (!name) continue;
          if (input.value) continue; // never overwrite

          /* HubSpot's newer embed namespaces fields by object type, so the
           input is "0-1/gclid" while storage holds "gclid". Older embeds
           have no slash and pass through unchanged. */
          var storageKey = name.indexOf('/') > -1 ? name.split('/').pop() : name;

          if (storageKey === 'cid' && name.indexOf('/') > -1) continue; // not on v2 forms

          var val = resolveSpecial(storageKey);
          if (val === null) val = CookieUtils.get(storageKey);
          if (val) input.value = val;
        }
      }
    }
    /* ---- submit-time top-up -------------------------------------------------
     The v4 React embed resets every hidden input to "" when it re-renders on
     step navigation, so anything written at page load is gone by the time the
     user reaches the final step. This runs inside the native form submit,
     immediately before the browser serialises the POST, which is the only
     moment React cannot undo it.

     It also patches hs_context.fieldValues, React's own state snapshot, which
     otherwise reports every hidden field as empty. Only entries still holding
     an empty array are touched, so real user input is never overwritten. */
    var PATCH_HS_CONTEXT = true;

    function fillAtSubmit(form) {
      var ctxInput = form.querySelector('input[name="hs_context"]');
      var ctx = null;
      if (PATCH_HS_CONTEXT && ctxInput) {
        try {
          ctx = JSON.parse(ctxInput.value);
        } catch (e) {
          ctx = null;
        }
      }

      var inputs = form.querySelectorAll('input[type="hidden"][name]');
      for (var i = 0; i < inputs.length; i++) {
        var input = inputs[i];
        var name = input.getAttribute('name');
        if (name === 'hs_context') continue;

        var prefixed = name.indexOf('/') > -1;
        var key = prefixed ? name.split('/').pop() : name;
        if (key === 'cid' && prefixed) continue;

        var val = resolveSpecial(key);
        if (val === null) val = CookieUtils.get(key);
        if (!val) continue;

        if (!input.value) input.value = val;

        if (ctx && ctx.fieldValues && Array.isArray(ctx.fieldValues[name]) && ctx.fieldValues[name].length === 0) {
          ctx.fieldValues[name] = val;
        }
      }

      if (ctx && ctxInput) {
        try {
          ctxInput.value = JSON.stringify(ctx);
        } catch (e) {}
      }
    }

    function installSubmitHook() {
      if (!window.HTMLFormElement || HTMLFormElement.prototype.__nrdSubmitHooked) return;
      var origSubmit = HTMLFormElement.prototype.submit;
      HTMLFormElement.prototype.submit = function () {
        try {
          fillAtSubmit(this);
        } catch (e) {}
        return origSubmit.apply(this, arguments);
      };
      HTMLFormElement.prototype.__nrdSubmitHooked = true;
    }
    //multi hubspot types end

    function decorateEventLinks() {
      var params = {};
      var allParams = UTM_PARAMS.concat(AD_CLICK_IDS);
      for (var i = 0; i < allParams.length; i++) {
        var p = allParams[i];
        if (PRESERVE_PARAMS.has(p)) continue;
        var val = CookieUtils.get(p);
        if (val && val !== 'none') params[p] = val;
      }
      if (!Object.keys(params).length) return;

      var links = document.querySelectorAll('a[href]');
      for (var j = 0; j < links.length; j++) {
        try {
          var url = new URL(links[j].href, window.location.href);
          if (url.hostname === 'events.cyberhaven.com') {
            for (var key in params) {
              if (Object.prototype.hasOwnProperty.call(params, key)) {
                if (!url.searchParams.has(key)) url.searchParams.set(key, params[key]);
              }
            }
            links[j].href = url.toString();
          }
        } catch (e) {}
      }
    }

