        <script type="text/ng-template" id="ForgotPasswordModal.html">
            <div class="ngdialog__header">
                Reset Your Password?
            </div>
            <div class="ngdialog__body">
				
                <form name="ResetPasswordForm" submit-default ng-submit="ctrl.handleFormSubmit(ResetPasswordForm, 'false' );" id="ResetPasswordForm" novalidate="novalidate" ng-init="logonId = ngDialogData.email">
                    <input type="hidden" name="challengeAnswer" value="-" id="WC_PasswordResetForm_FormInput_challengeAnswer_In_ResetPasswordForm_1" />
                    <input type="hidden" name="storeId" value='10151' id="WC_PasswordResetForm_FormInput_storeId_In_ResetPasswordForm_1" />
                    <input type="hidden" name="catalogId" value='10001' id="WC_PasswordResetForm_FormInput_catalogId_In_ResetPasswordForm_1" />
                    <input type="hidden" name="langId" value='-1' id="WC_PasswordResetForm_FormInput_langId_In_ResetPasswordForm_1" />
                    <input class="PII" type="hidden" name="state" value="forgetpassword" id="WC_PasswordResetForm_FormInput_state_In_ResetPasswordForm_1" />
                    <input type="hidden" name="URL" value="ResetPasswordForm" id="WC_PasswordResetForm_FormInput_URL_In_ResetPasswordForm_1" />
                    <input type="hidden" ng-model="authToken" ng-init="authToken=''" name="authToken" value="" id="WC_PasswordResetForm_FormInput_authToken_In_ResetPasswordForm_1" />
                    <input type="text" style="margin-top:-1066px; position:absolute;" tabindex="-1">

                    <!-- show an error if one has been provided to this modal via ngDialogData -->
                    <div class="notification notification--error" ng-if="ngDialogData.error" role="alert" aria-live="assertive" sw-compile="ngDialogData.error" tabindex="0" ng-cloak></div>

                    <p>Enter the email address associated with your Sherwin-Williams.com profile. We'll send you an email with a link so you can create a new password.</p>

                    <div class="field required">
                        <label for="WC_PasswordResetForm_FormInput_logonId_In_ResetPasswordForm_1">
                            Email address:
                        </label>
                        <input sw-focus="true"
                            aria-describedby="logon-id-error"
                            size="25" maxlength="100"
                            type="email"
                            name="logonId"
                            ng-model="logonId"
                            ng-pattern="/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/"
                            class="modern"
                            required
                            id="WC_PasswordResetForm_FormInput_logonId_In_ResetPasswordForm_1"/>

                        <div ng-messages ng-cloak for="ResetPasswordForm.logonId.$touched && ResetPasswordForm.logonId.$error" role="alert" class="notification notification--error" >
                            <ng-message when="required">Email address is required.</ng-message>
                            <ng-message when="pattern">Please use a valid email format. Ex: yourname@address.com.</ng-message>
                        </div>
                    </div>

                    
                        <button type="submit" 
                            ng-disabled="ctrl.isSubmitting || !ResetPasswordForm.$valid || !ctrl.validateRecaptcha" 
                            class="Arrow-Button-Blue full-width no-icon" 
                            type="button" 
                            id="WC_PasswordResetForm_Link_2">
                            <span class="label">
                                Send Verification Email
                            </span>
                        </button>
                        
                        <sw-invisible-recaptcha 
                            execute-validate="ctrl.validateRecaptcha"
                            callback="ctrl.recaptchaCallback( response )"
                            expired-callback="ctrl.expiredRecaptchaCallback( response )"
                            site-key="6LehDSwUAAAAAFhu9IEmDV1lhHiSnGj9RYo7wvUs">
                        </sw-invisible-recaptcha>
                    

                   <p>If you need help, please <a href="javascript:void(0)" target="_top" sw-contact-us-link>Contact Us</a>.</p>
                </form>
                <div class="indicate-loading indicate-loading--mask" disable-animate ng-cloak ng-if="ctrl.isSubmitting">
                    <div class="visually-hidden" role="alert" aria-live="assertive">Submitting...</div>
                </div>
            </div>
        </script>

