<!DOCTYPE HTML>
<html lang="sr-yu" dir="ltr" class="uk-height-1-1 tm-error">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
        <link rel="icon" href="/assets/img/favicons/favicon.png" type="image/ico"/> 
        <title>404 - Page Not Found</title>
        <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900" rel="stylesheet"/>
        <link href="/assets/css/widgets/font-awesome/css/fontawesome-all.min.css" rel="stylesheet" type="text/css"/>
    </head>
    <body class="ctw-error">
        <style type="text/css" scoped>
            a {
                color: #3079FD;
                font-weight: 500;
                text-decoration: none;
                -webkit-transition: color .3s ease;
                transition: color .3s ease;
            }
            a:focus,
            a:hover {
                text-decoration: none;
                color: #3079fd;
                -webkit-transition: color .3s ease;
                transition: color .3s ease;
            }
            html {
                height: 100%;
            }
            body {
                text-align: center;
                color: #0b0d1c;
                font-family: 'Inter', sans-serif;
                font-weight: normal;
                background: #fff;
                margin: 0;
                height: 100%;
                padding: 0;
                font-size: 16px;
                position: relative;
                -webkit-font-smoothing: antialiased;
                text-rendering: optimizeLegibility;
                overflow-x: hidden;
                display: flex;
            }
            .ctw-error .container {
                text-align: center;
                display: flex;
                flex-direction: column;
                align-items: center;
                max-width: 100%;
                font-size: 1rem;
                vertical-align: middle;
                margin: 0 auto;
                padding: 0 15px;
                justify-content: center;
            }
            .ctw-error h2 {
                font-size: 18px;
                color: #0b0d1c;
                margin: 0 0 10px 0;
                text-transform: uppercase;
                line-height: 100%;
                font-weight: bold;
            }
            .ctw-error p {
                font-size: 15px;
            }
            .err-img{
                width: 100%;
                position: relative;
            }
            .err-img img{
                width: 100%;
                height: auto;
            }
            .img-err-txt{
                font-size: 48px;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                color: #0B0D1C;
            }
            .error-text {
                z-index: 9999;
                margin-bottom: 70px;
            }

            @media (max-width: 480px) {
                .img-err-txt{
                    margin-bottom: 40px;
                    font-size: 36px;
                }
            }
        </style>
        <div class="container">

            <div class="error-bgd"></div>
            <div class="error-text">  
                <h2>PAGE NOT FOUND</h2>
                <span>Go <a href="javascript:history.go(-1)">back</a> to choose a new direction.</span>
            </div>
            <div class="err-img">
                <img src="/assets/cms/img/error.svg" alt="error"/>
                <span class="img-err-txt">Errrrror</span>
            </div>
        </div>




    </body>
</html>