  <!-- Rudderstack identify() and page(). For routing done with the VueRouter,
  another call to rudderanalytics.page() is done in the $route watcher. We are using a
  'load' event here to ensure the page title is set before tracking the pageview. -->
  <script>
//<![CDATA[

    window.addEventListener('load', function() {
      const userTrackingInfo = {}
      const rudderstackIdentifiedUserIdCookie = document.cookie.split('; ').find(cookie => cookie.startsWith('rudderstack_identified_user_id='))
      const rudderstackIdentifiedUserIdCookieValue = rudderstackIdentifiedUserIdCookie ? rudderstackIdentifiedUserIdCookie.split('=')[1] : null
      // Send events for all signed-in non-students and 1% of student users
      const isValidUserForRudderstack = gon.current_user && (!gon.current_user.is_student || !!gon.current_user.active_test_group_key || gon.current_user.id % 100 === 0) && !gon.current_user.disable_frontend_tracking
      if (isValidUserForRudderstack) {
        userTrackingInfo['role'] = gon.current_user.role
        userTrackingInfo['district_id'] = gon.current_user.district_id
        userTrackingInfo['grade_level'] = gon.current_user.grade_level
        userTrackingInfo['mission_status'] = gon.current_user.mission_status
        if (gon.header_info && gon.header_info.renewal_reminder_banner) {
          userTrackingInfo['renewal_banner_shown'] = true
        }

        if (gon.current_user.id.toString() !== rudderstackIdentifiedUserIdCookieValue) {
          // On Chrome, users are sometimes identified on both the first and second page loads after signing in,
          // instead of just the first. This appears to be due to the value of rudderstackIdentifiedUserIdCookieValue
          // being out of date, potentially due to an issue with Chrome caching cookies. However, there is no harm in
          // a user being identified more than once, so this is not something we need to worry about.
          rudderanalytics.identify(gon.current_user.id.toString(), () => {
            // Upon successful identification, set the rudderstack_identified_user_id cookie and track the pageview
            document.cookie = `rudderstack_identified_user_id=${gon.current_user.id};`
            rudderanalytics.page(userTrackingInfo)
          })
        } else {
          // If the user is already identified, track the pageview
          rudderanalytics.page(userTrackingInfo)
        }
      }
    }, true);

//]]>
</script>
