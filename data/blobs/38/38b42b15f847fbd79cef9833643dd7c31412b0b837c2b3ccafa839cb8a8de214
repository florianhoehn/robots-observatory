	fn_hasPartialKeyMatch : function(obj, partialKeyArr){
		let matchValue = "";
		for(let key in obj) {
			if(obj.hasOwnProperty(key) && partialKeyArr.includes(key) ) {
				matchValue = obj[key];
			}
		}
		return matchValue;
	},
