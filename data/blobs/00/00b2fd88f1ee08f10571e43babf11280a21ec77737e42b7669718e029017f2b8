        };
        var imageMimeType = imageMimeTypes[imageExtension] || 'image/jpeg';

        if (is_cdnimg(imgUrl)) {
            $.ajax(imgUrl, {
                xhrFields: {responseType: 'arraybuffer'}
            }).then((res) => {
