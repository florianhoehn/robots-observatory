        if (typeof (path) !== "string") {
            return false
        }
        if (path.indexOf("/new/") !== -1) {
            return true;
        }
        if (path.indexOf("/xiao/") !== -1) {
            return true;
        }
        if (path.indexOf("/upload/upload/") !== -1) {
            return true;
        }
        if (path.indexOf("/upload_01/") !== -1) {
            return true;
        }
        if (path.indexOf("/uploads/") !== -1) {
            return true;
