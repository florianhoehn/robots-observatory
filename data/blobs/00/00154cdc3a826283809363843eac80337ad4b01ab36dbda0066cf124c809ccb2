<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width,initial-scale=1,viewport-fit=cover"
    />
    <link
      href="/securityfailover/css/tkmaxx.css"
      rel="stylesheet"
      type="text/css"
    />

    <title>TKMaxx.com: Something went wrong</title>
  </head>

  <body>
    <main class="container">
      <div class="wrapper">
        <!-- Messaging -->
        <section class="messaging" aria-label="Status message">
          <h1 class="noFocusStyle" id="messagingHeading" tabindex="2">
            <span class="nowrap mobileBreak">Looking to shop?</span>
          </h1>
        </section>

        <!-- Brands -->
        <section class="brands" aria-labelledby="brandsHeading">
          <p class="brandsHeading noFocusStyle" id="brandsHeading" tabindex="3">
            Something went wrong.
            <span class="nowrap mobileBreak">Let's get back on track:</span>
          </p>
          <div class="brandTiles">
            <!-- TKMaxx -->
            <a
              class="brandTile brandTile--tkmaxx"
              href="https://www.tkmaxx.com/"
              aria-label="Shop TKMaxx.com online"
              rel="noopener noreferrer"
              target="_blank"
            >
              <div class="brandTile-logo" aria-hidden="true">
                <img
                  src="data:image/png;base64,"
                  alt="TKMaxx.com Logo"
                  aria-hidden="true"
                />
              </div>
              <span class="brandTile-caption"
                >Shop<span class="srOnly"> TKMaxx</span> Online</span
              >
            </a>
          </div>
        </section>
      </div>
    </main>

    <footer class="footer" role="contentinfo">
      <small>&copy; <span id="copyrightYear"></span> TKMaxx</small>
    </footer>

    <script>
      // Set the copyright year
      document.getElementById("copyrightYear").textContent =
        new Date().getFullYear();

      //Print Ref# to Console
      console.log("Ref#: #0.5cb11702.1792438986.112f93ae");
    </script>
  </body>
</html>
