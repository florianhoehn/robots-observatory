<title>Quick security check | CUMS</title>
<style>
/* Self-contained on purpose. A Cloudflare error page is served when the origin
   may be unreachable, so it cannot depend on the origin for CSS, fonts or
   images. Colours are copied from templates/cumsnew/css/src/10-tokens.css so
   they track the theme; the font is a system stack chosen to sit close to
   Plus Jakarta Sans without a webfont request that might never resolve. */
:root{
  --pink:#ff2e97; --magenta:#e0219a; --purple:#a855f7;
  --deep:#080a12; --surface:#12151f; --raised:#1a1e2b;
  --text:#e8eaf0; --muted:#98a2b8;
  --border:rgba(255,255,255,.08); --border-strong:rgba(255,255,255,.16);
  --grad:linear-gradient(120deg,#ff2e97 0%,#e0219a 48%,#a855f7 100%);
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  background:var(--deep); color:var(--text); min-height:100vh;
  font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  /* Top-aligned, NOT vertically centred. Centring looks fine on a desktop but
     on a short phone viewport it pushes the card down far enough that the
     verify box - the only thing the visitor needs to touch - lands below the
     fold and has to be scrolled to. */
  display:flex; align-items:flex-start; justify-content:center; padding:48px 24px 40px;
  -webkit-font-smoothing:antialiased; position:relative; overflow-x:hidden;
}
/* the same pink bloom the site header has, kept faint */
body::before{
  content:""; position:fixed; inset:-40% -20% auto -20%; height:80vh; z-index:0;
  background:radial-gradient(60% 60% at 50% 0%,rgba(255,46,151,.10) 0%,rgba(8,10,18,0) 70%);
  pointer-events:none;
}
.wrap{position:relative;z-index:1;width:100%;max-width:560px;text-align:center}
.logo{font-size:30px;font-weight:800;letter-spacing:-.02em;margin-bottom:28px;display:inline-block}
.logo span{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.logo small{font-size:11px;font-weight:700;color:var(--muted);vertical-align:super;letter-spacing:.08em}
.card{
  background:var(--surface); border:1px solid var(--border); border-radius:20px;
  padding:40px 32px; box-shadow:0 24px 60px -20px rgba(0,0,0,.7);
}
.icon{
  width:76px;height:76px;border-radius:50%;background:var(--raised);
  border:1px solid var(--border); display:inline-flex;align-items:center;justify-content:center;
  margin-bottom:22px;
}
.icon svg{width:32px;height:32px;fill:var(--pink)}
h1{font-size:25px;font-weight:800;letter-spacing:-.01em;margin-bottom:12px;line-height:1.25}
h1 .g{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
p{color:var(--muted);font-size:15px;line-height:1.65;margin:0 auto 24px;max-width:44ch}
.box{margin:26px 0 6px}
.btn{
  display:inline-flex;align-items:center;gap:8px;height:46px;padding:0 26px;
  border-radius:999px;text-decoration:none;font-weight:700;font-size:15px;
  background:var(--grad);color:#fff;border:none;
  box-shadow:0 8px 24px -8px rgba(255,46,151,.6);
}
.btn.ghost{background:var(--raised);color:var(--text);border:1px solid var(--border-strong);box-shadow:none}
.actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:6px}
.ref{
  margin-top:26px;padding-top:18px;border-top:1px solid var(--border);
  color:#5c657c;font-size:11.5px;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;letter-spacing:.04em;
}
@media(max-width:520px){
  body{padding:22px 14px 32px}
  .logo{font-size:25px;margin-bottom:18px}
  .card{padding:26px 18px;border-radius:18px}
  .icon{width:62px;height:62px;margin-bottom:16px}
  .icon svg{width:26px;height:26px}
  h1{font-size:20px;margin-bottom:10px}
  p{font-size:14px;margin-bottom:20px}
  .box{margin:20px 0 4px}
  .ref{margin-top:20px;padding-top:14px}
}
/* Landscape phones and anything genuinely short: strip the padding further so
   the card still starts at the top rather than being pushed off-screen. */
@media(max-height:560px){
  body{padding:16px 14px 24px}
  .logo{margin-bottom:12px}
  .card{padding:22px 18px}
  .icon{width:54px;height:54px;margin-bottom:12px}
}
</style>
