header{position:absolute;margin:0 0 20px;padding:8px 0}
.logo{padding:0;height:44px;width:220px}
h1,h2{font-size:24px;letter-spacing:.06em;white-space:normal;overflow:visible;text-overflow:clip;padding-right:2px}
.headline h2{font-size:22px}
h1:before,h2:before{background-size:auto}
}
@media (min-width:1536px){
h1,h2{font-size:26px}
.headline h2{font-size:24px}
.headline{margin-bottom:var(--space-8)}
h1{padding-left:8px}
}
.empty-content{text-align:center;color:var(--accent-alt);font-size:22px}
.static_page iframe{display:inline-block;margin:0 auto;width:100%;height:980px;text-align:center}
}

