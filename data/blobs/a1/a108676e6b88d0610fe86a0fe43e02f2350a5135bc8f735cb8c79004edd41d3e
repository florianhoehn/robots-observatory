/* DEV-1139 preview - language selector placement */
/* tags row (test pages): tags wrap on the left; on MOBILE the selector
   pins to the first tag row, right-aligned, inside the .lang-select-title
   slot the mover script fills. On desktop the slot stays empty (hidden)
   and the selector keeps its stock place in the top bar on every page
   (Ryan 2026-09-22). */
.lang-tags--with-selector,
.test-contain .lang-tags.lang-tags--with-selector { display: flex;
  align-items: flex-start; justify-content: space-between; gap: 8px; }
.lang-tags--with-selector .test-tags { flex: 1 1 auto; min-width: 0; }
.lang-tags--with-selector .lang-select-title { margin-left: auto; flex: 0 0 auto; }
.lang-tags--with-selector .lang-select-title:empty { display: none; }
.lang-tags--with-selector .lang-select { margin-left: auto; flex: 0 0 auto; margin-top: 0 !important; }
.lang-tags--with-selector .lang-select #langSelectButton { margin-left: 0; }
/* mobile header: collapse as tight as possible, three states -
   1: [logo]........[lang][theme][burger]  (one row)
   2: [logo]..............[theme][burger]  (lang drops below, right)
   3: [logo] / [theme][burger] / [lang]    (each row right-aligned;
   nothing ever flips to the left) */
@media only screen and (max-width: 727px) {
  #main-header { flex-wrap: wrap; }
  #main-header .logo-nav { display: contents; }
  #main-header .site-logo { margin-right: auto; }
  #main-header .header-tools { order: 1; margin: 0; }
  #main-header .mobile-toggle { order: 2; margin-left: 12px; }
  #main-header .mobile-nav { order: 9; }
}
@media only screen and (max-width: 459px) {
  #main-header .header-tools { order: 3; flex: 1 0 100%; display: flex;
    justify-content: flex-end; }
  #main-header .mobile-toggle { margin-left: auto; }
}
@media only screen and (max-width: 344px) {
  #main-header .site-logo { flex: 1 0 100%; }
}
/* MOBILE test pages only: no break/barrier between the header and the
   tags row - the two white surfaces merge into one, like the root
   header; the tags row hugs the header (root's ~19px spacing) with the
   selector aligned to the top. Desktop keeps the stock header edge. */
@media only screen and (max-width: 727px) {
  #main-header.dev1139-test { box-shadow: none; border-bottom: none; }
  .dev1139-test ~ .content .lang-tags--with-selector { margin-top: -25px; }
  /* a yellow authority byline sits between header and tags row - the
     pull-up must not drag the selector row into it; instead the byline
     itself rises to half the stock gap (Ryan: reduce white space 50%),
     and the selector row keeps a little air below the yellow strip */
  .dev1139-test ~ .content #academic-reviewer + .lang-tags--with-selector { margin-top: 6px; }
  .dev1139-test ~ .content #academic-reviewer { margin-top: -20px; }
  /* endorsement-quote tests: the quote block is first - it rises to the
     halved gap instead, and the byline under it only compresses gently
     so it never rides into the slider dots */
  .dev1139-test ~ .content .blaze-slider-endorsements { margin-top: -20px; }
  .dev1139-test ~ .content .blaze-slider-endorsements + #academic-reviewer { margin-top: -4px; }
  /* quote tests WITHOUT a byline: the tags row follows the slider directly
     - it must not take the full pull-up into the quote attribution/dots */
  .dev1139-test ~ .content .blaze-slider-endorsements ~ .lang-tags--with-selector { margin-top: -4px; }
}
/* MOBILE results pages: the title hugs the header. The theme's base gap
   under the bar is #main-content 6.5px margin + 13px padding + the h1's
   17.42px margin = 37px on every page; results pages pull the h1 up so
   12px remain (6.5 + 13 - 7.5). Ryan 2026-09-05 via Lewis (12px);
   test pages, content pages and desktop are unchanged. */
@media only screen and (max-width: 727px) {
  .dev1139-test ~ .content #test.result > h1 { margin-top: -7.5px; }
}
/* MOBILE pages with a selector that are not tests and not root (tests.php
   and its localized slugs, reviewers.php): the selector moves out of the
   top bar onto the page title row - heading left, selector right (Lewis
   2026-09-03). Desktop keeps it in the bar next to theme + search; root
   keeps the in-bar placement at all widths (Ryan 2026-09-01). The node is
   moved by the small script views/page.php emits (one node - the dropdown
   script binds by id). */
.post-page .lang-select-title:empty { display: none; }
.post-page .lang-select-title { float: right; margin: 18px 0 0 12px; }
.post-page .entry-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex: 1 1 100%; width: 100%; }
.post-page .entry-title-row .entry-title { min-width: 0; }
.post-page .entry-title-row .lang-select-title { float: none; margin: 0; }
.post-page .lang-select-title .lang-select { margin-top: 0 !important; }
.post-page .lang-select-title #langSelectButton { margin-left: 0; }
/* narrowest state on test pages: the control strip and the tags share one
   pill - the tags row rises beside the theme/hamburger and the selector
   sits right-aligned just BELOW them, tags wrapping on the left */
@media only screen and (max-width: 344px) {
  .dev1139-test ~ .content .lang-tags--with-selector { margin-top: -50px; }
  .dev1139-test ~ .content .lang-tags--with-selector .lang-select { margin-top: 26px !important; }
  .dev1139-test ~ .content #academic-reviewer + .lang-tags--with-selector .lang-select { margin-top: 0 !important; }
}
