<style type="text/css">
/* 10/01/2026 */


.font-newsreader h1,
.font-newsreader h2,
.font-newsreader h3,
.font-newsreader h4,
.font-newsreader h5,
.font-newsreader h6{
/* 	font-family: "Newsreader", serif!important; */
	font-weight: 400;
}

/* .heading-style h1 span{
	font-weight: 600;
} */

.fw-400 .et_pb_text_inner,
.fw-400 .et_pb_blurb_description,
.fw-400 a{
	font-weight: 400!important;
}

.logo-carosel .et_pb_image {
	text-align: center;
	padding-left: 10px;
	padding-right: 10px;
	
}

.logo-carosel .et_pb_image img{
	max-width: 200px;
	margin: auto;
}

.cmn-btn{
	text-transform: inherit!important;
}

.clr-text{
	font-size: 80%!important;
	color: #ED006A!important;
	text-transform: uppercase;
	font-weight: 600!important;
	letter-spacing: 3px;
}

.m-center{
	margin-left: auto;
	margin-right: auto;
}

/* Blurb */

.blurb-card .et_pb_module_header{
	margin-bottom: 20px!important;
}


/* - NUMBER COUNTERS - */
.custom-number-counter .percent-sign {
	font-size: clamp(1.25rem, 1.0886rem + 0.7595vw, 2rem)!important; /* (32-20)*/
}

.custom-number-counter .percent {
	min-width: 124px!important;
	max-width: 124px!important;
/* 	font-family: "Newsreader", serif ! Important; */
}

.custom-number-counter .et_pb_circle_counter_inner {
	align-items: center!important;
}

.custom-number-counter.et_pb_circle_counter .percent p {
	font-weight: 400!important;
}

/* x symbol */
.custom-number-counter.x-symbol .percent-sign {
	font-size: 0!important;
}

.custom-number-counter.x-symbol .percent-sign::after {
	content: 'x';
	display: inline-block;
	font-size: clamp(1.25rem, 0.9541rem + 1.3924vw, 2.625rem); /* (42-20)*/
}


/* Logo Carosel  */

.logo-carosel {
	overflow: hidden;
 
	-webkit-mask-image: linear-gradient(
		to right,
		transparent 0%,
		#000 23%,
		#000 80%,
		transparent 100%
	);
 
	mask-image: linear-gradient(
		to right,
		transparent 0%,
		#000 23%,
		#000 80%,
		transparent 100%
	);
}



@media  (min-width: 980px) and  (max-width: 1366px) {
	
	.heading-style h1{
		font-size: 60px!important;
	}
	.heading-style h2{
		font-size: 45px!important;
	}
	
	div#page-container .blurb-card {
		padding: 25px!important;
	}
	
	.blurb-card .et_pb_module_header{
		font-size: 35px!important;
	}
	.blurb-card .et_pb_blurb_description{
		font-size: 16px!important;
	}
}


/* =========================================
   EQUAL HEIGHT SLIDES
========================================= */

.card-carosel .slick-track {
    display: flex !important;
    align-items: stretch;
}

.card-carosel .slick-slide {
    height: auto !important;
    float: none !important;
}


/* =========================================
   SLICK CARD SPACING
========================================= */

.card-carosel .slick-slide {
    margin-left: 10px !important;
    margin-right: 10px !important;

    transition: transform 0.3s ease,
                box-shadow 0.3s ease;

    position: relative;
    z-index: 1;
}

/* Hover */
.card-carosel .slick-slide:hover {
    transform: translateY(-20px);
    z-index: 10;
}


/* =========================================
   ALLOW SPACE FOR HOVER + SHADOW
========================================= */

.card-carosel .slick-list {
    overflow: hidden;

    /* Space for card moving upward */
    padding-top: 35px !important;
    padding-bottom: 25px !important;

    /* Prevent added padding from creating
       too much extra space above slider */
    margin-top: -35px;
}


/* ========================================
   SLICK NAVIGATION ARROWS
======================================== */

.card-carosel {
	position: relative;
}

.card-carosel .slick-arrow {
	position: absolute;
	z-index: 10;

	top: 50%;
	bottom: auto;
	transform: translateY(-50%);

	width: 52px;
	height: 52px;

	border: 0;
	border-radius: 50%;

	background: #ED006A;
	color: transparent;

	font-size: 0;
	line-height: 0;

	padding: 0;
	margin: 0;

	cursor: pointer;

	display: flex;
	align-items: center;
	justify-content: center;

	box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}

/* ==========================