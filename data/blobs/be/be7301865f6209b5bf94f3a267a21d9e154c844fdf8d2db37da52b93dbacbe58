<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Captcha</title>

    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 16px;
            padding-top: 60px;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            font-size: 16px;
            line-height: 1.5;
            background: #ecf0f5;
            color: #354861;
        }
        .main-header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            min-width: 100%;
            height: 44px;
            max-height: 100px;
            z-index: 1030;
            background-color: #354861;
            background-image: url(https://nickfinder.com/assets2/img/top_line_1.png);
            background-position: 50% 50%;
            background-repeat: repeat;
            box-sizing: border-box;
            overflow: hidden;
        }
        .main-header .logo {
            display: block;
            float: left;
            height: 44px;
            padding: 0 15px 0 10px;
            line-height: 44px;
            font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: 26px;
            font-weight: 300;
            color: #fff;
            width: 100%;
            max-width: 230px;
            text-align: center;
            box-sizing: border-box;
        }
        @media (min-width: 400px) {
            .main-header .logo {
                text-align: left;
            }
        }
        .page-wrap {
            width: 100%;
            max-width: 420px;
        }
        .container {
            text-align: center;
            padding: clamp(20px, 5vw, 32px);
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 24px rgba(53, 72, 97, 0.08), 0 1px 3px rgba(53, 72, 97, 0.06);
            border: 1px solid #ebe9f5;
        }
        .container h2 {
            margin: 0 0 1.25em;
            font-size: clamp(1.125rem, 2.5vw, 1.375rem);
            font-weight: 600;
            color: #354861;
        }
        .cf-turnstile-wrap {
            display: flex;
            justify-content: center;
            margin-bottom: 1em;
            min-height: 65px;
        }
        .cf-turnstile {
            margin: 0 auto;
        }
        .error {
            margin: 0;
            padding: 10px 12px;
            font-size: 0.9375rem;
            color: #b91c1c;
            background: #fef2f2;
            border-radius: 8px;
            border: 1px solid #fecaca;
            display: none;
        }
        @media (max-width: 380px) {
            body {
                padding: 12px;
            }
            .container {
                padding: 16px;
            }
        }
    </style>

</head>
<body>

<header class="main-header">
    <span class="logo">
        <span class="logo-lg">Nickfinder.com</span>
    </span>
</header>

<div class="page-wrap">
    <div class="container">
        <h2>Please verify you are not a bot</h2>
        <div class="cf-turnstile-wrap">
            <div class="cf-turnstile" data-sitekey="0x4AAAAAABdRngFQXjavGSrf" data-callback="onCaptchaSuccess" data-error-callback="onCaptchaError"></div>
        </div>
        <p id="error" class="error">Verification failed. Please try again.</p>
    </div>
</div>

<script>
    function onCaptchaError(code) {
        try {
            (new Image()).src = '/lowlevelerrorlogger.php?e=cft_' + encodeURIComponent(code || 'unknown');
        } catch (e) {}
        return true; // handled: no "Uncaught TurnstileError" in console, widget shows its own failure UI
    }
    function onCaptchaSuccess(token) {
        fetch('/', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            },
            body: new URLSearchParams({
                cf_captcha_token: token
            }),
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    window.location.reload();
                } else {
                    document.getElementById('error').style.display = 'block';
                    turnstile.reset();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('error').style.display = 'block';
                turnstile.reset();
            });
    }
</script>


</body>
</html>