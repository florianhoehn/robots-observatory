	header.navbar {padding:0.5rem 0 !important}

}

a[href^="mailto:"]
{ 
	font-family: "Lexend",sans-serif;
    font-weight: 400;
    color: inherit;
    text-decoration: none;
    font-size: inherit;
    line-height: inherit;
    display: inline;
    box-shadow: 0px 2px #0d92ff;
    cursor: pointer;
