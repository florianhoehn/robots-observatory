function initNels() {

    if(window.location.pathname == '/'){
        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];
        var url = '/ajax.pl?op=nel';
        if(nelId){
            url += '&nel_id='+nelId;
        }
        $.ajax({
            url: url,
            type: 'POST',
            success: function(html){
                $('#firehoselist article').eq(1).after(html);
            }
        });
    }

    function showVerticalNEL() {
        let res = false;
        if(window.location.pathname.indexOf('/story/') >= 0){ // story
            res = true;
        }
        if(window.location.pathname.indexOf('/recent') >= 0 ||
            window.location.pathname.indexOf('/popular') >= 0 ||
            window.location.pathname.indexOf('/submission/') >= 0){ // submissions
            res = true;
        }
        if(window.location.pathname === '/'){ // home
            res = true;
        }
        return res;
    }
    if (showVerticalNEL()) {
        var nelId = (location.search.split('nel_id=')[1] || '').split('&')[0];
        var url = '/ajax.pl?op=nel';
        if(nelId){
            url += '&nel_id='+nelId;
        }
        $.ajax({
            url: url,
            type: 'POST',
            success: function(html){
                $('#slashboxes').eq(0).prepend(html);
                $('#slashboxes .ntv-sponsored-disclaimer a span:first-child').html('Featured Content');
            }
        });
    }
    //announcement NEL
    if(document.getElementById('announcementText')){
      $('#announcementText').hide();
      var hlUrl = '/ajax.pl?op=hl_nel';
      if(nelId){
        hlUrl += '&nel_id='+nelId;
      }
      $.ajax({
        url: hlUrl,
        type: 'POST',
        success: function(html){
          if(html.length < 10){
            $('#announcementText').show();
            return;
          }
          $('#announcementText').html(html).show();
        },
        error: function () {
          $('#announcementText').show();
        }
      });
    }
    document.addEventListener('click', (e) => {
      const el = e.target.closest('[data-dest]');
      if (!el) return;
      e.preventDefault();
      e.stopPropagation();
      const url = el.dataset.dest;
      const target = el.dataset.target || '_self';
      if (target === '_blank') {
        window.open(url, '_blank', 'noopener,noreferrer');
      }
    });
}
