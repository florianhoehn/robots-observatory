function trackNelImpressions() {
  const nelimps = document.querySelectorAll('img[data-name="nel-impression"]:not([data-nel-processed])');
  nelimps.forEach((imp) => {
    imp.setAttribute('data-nel-processed', '1'); // prevent re-processing
    const imp_url = imp.getAttribute('data-source');
    if (!imp_url) {
        return;
    }
    imp.src = imp_url;
  });
}
function startTracking(){
    if (tracking) return;
    tracking = true;
    trackNelImpressions();
}
const observer = new MutationObserver(function(mutations) {
  if (!tracking) return;
  for (const m of mutations) {
    for (const node of m.addedNodes) {
      if (node.nodeType !== 1) continue; // element only
      trackNelImpressions(node);
    }
  }
});
observer.observe(document.body, { childList: true, subtree: true });

