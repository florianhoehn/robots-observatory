<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 - Page Nahin Mila</title>

<!-- Optional: Poppins font for nicer text -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

<!-- Lottie Animation -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.10.1/lottie.min.js"></script>

<style>
body {
    font-family: "Poppins", Arial, sans-serif;
    background: linear-gradient(135deg,#eef2ff,#f8f8ff,#e0ecff);
    background-size: 300% 300%;
    animation: bgMove 12s ease-in-out infinite;
    text-align:center;
    padding:40px;
    color:#333;
    min-height: 100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
}

/* animated gradient background */
@keyframes bgMove {
    0%   { background-position: 0% 50%; }
    50%  { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
}

.container {
    max-width:650px;
    margin:0 auto;
    position:relative;
    z-index:2;
}

/* glowing circle */
.glow-circle {
    position:absolute;
    top:30px;
    left:50%;
    transform:translateX(-50%);
    width:280px;
    height:280px;
    background: radial-gradient(circle, rgba(108,99,255,0.25), rgba(108,99,255,0));
    filter: blur(2px);
    pointer-events:none;
    animation: glowPulse 6s ease-in-out infinite;
    z-index:1;
}

@keyframes glowPulse {
    0%,100% { opacity:0.7; transform:translateX(-50%) scale(1); }
    50%     { opacity:1;   transform:translateX(-50%) scale(1.08); }
}

/* main animation */
#animation {
    width:260px;
    height:260px;
    margin:0 auto 2px auto;
    position:relative;
    z-index:2;
    animation: floatAnim 4s ease-in-out infinite;
}
@keyframes floatAnim {
    0%,100% { transform:translateY(0); }
    50%     { transform:translateY(-10px); }
}

/* headings */
h1 {
    font-size:40px;
    font-weight:700;
    color:#6c63ff;
    margin:10px 0 0;
    letter-spacing:1px;
    animation: wobble 3.2s ease-in-out infinite;
}
@keyframes wobble {
    0%,100% { transform:translateY(0) rotate(0deg); }
    25%     { transform:translateY(-4px) rotate(-0.8deg); }
    50%     { transform:translateY(2px) rotate(0.8deg); }
    75%     { transform:translateY(-2px) rotate(-0.4deg); }
}

p {
    font-size:18px;
    margin-top:6px;
}

/* GAME STRIP */
.game-strip {
    margin:20px auto 10px;
    padding:14px 18px;
    border-radius:18px;
    background: rgba(255,255,255,0.96);
    box-shadow:0 10px 26px rgba(15,23,42,0.12);
    border:1px solid rgba(148,163,184,0.35);
}

.game-boxes {
    display:flex;
    justify-content:center;
    gap:10px;
}

.game-box {
    width:60px;
    height:60px;
    border-radius:16px;
    background: radial-gradient(circle at top, #f97316, #b91c1c);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:24px;
    font-weight:700;
    box-shadow:0 8px 18px rgba(248,113,113,0.55);
    animation: boxBounce 1.6s ease-in-out infinite;
}
.game-box:nth-child(2) {
    background: radial-gradient(circle at top, #22c55e, #15803d);
    animation-delay:0.18s;
}
.game-box:nth-child(3) {
    background: radial-gradient(circle at top, #3b82f6, #1d4ed8);
    animation-delay:0.32s;
}

@keyframes boxBounce {
    0%,100% { transform:translateY(0) scale(1); }
    50%     { transform:translateY(-6px) scale(1.05); }
}

/* BUTTON */
a.btn {
    display:inline-block;
    text-decoration:none;
    padding:14px 32px;
    background:#6c63ff;
    color:white;
    border-radius:50px;
    font-size:18px;
    margin-top:18px;
    transition:0.3s;
    box-shadow:0 8px 18px rgba(108,99,255,0.35);
}
a.btn:hover {
    background:#5849e7;
    transform:translateY(-3px) scale(1.05);
}

/* MOBILE FIX */
@media (max-width: 480px) {
    body {
        padding:10px;
        display:block;
        min-height:auto;
    }
    .container { margin-top:10px; }
    #animation { width:200px; height:200px; }
    h1 { font-size:30px; margin-top:4px; }
    p { font-size:15px; }
    .game-box { width:50px; height:50px; font-size:20px; }
    a.btn { font-size:16px; padding:12px 26px; margin-bottom:22px; }
}
</style>
</head>

<body>

<div class="container fade">
    <div class="glow-circle"></div>
    <div id="animation"></div>

    <h1>Page Nahin Mila</h1>
    <p>Jis page ya result ko aap dhoondh rahe hain,<br> woh abhi yahan available nahi hai ya link galat ho sakta hai.</p>
    <p>Latest live results dekhne ke liye niche button par click karein 👇</p>

    <!-- GAME STRIP -->
    <div class="game-strip">
        <div class="game-boxes">
            <div class="game-box">00</div>
            <div class="game-box">00</div>
            <div class="game-box">00</div>
        </div>
    </div>

    <a href="/" class="btn">Go to Live Result Home</a>
</div>

<script>
// Animation loader
lottie.loadAnimation({
    container: document.getElementById("animation"),
    renderer: "svg",
    loop: true,
    autoplay: true,
    path: "https://assets3.lottiefiles.com/packages/lf20_j1adxtyb.json"
});

// Game style random numbers animation
(function() {
    const boxes = document.querySelectorAll('.game-box');
    function updateNumbers() {
        boxes.forEach((box) => {
            const n = Math.floor(Math.random() * 100);
            box.textContent = n.toString().padStart(2, '0');
        });
    }
    updateNumbers();
    setInterval(updateNumbers, 700);
})();
</script>

</body>
</html>
