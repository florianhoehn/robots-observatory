    <!-- 앱 셸 상단(헤더 + 앱 넛지 배너) 높이를 첫 페인트 전에 예약한다. HeaderSlot의 상단 슬롯이 이 값을
         min-height로 쓰고, 실측(ResizeObserver)이 도착하면 실측값으로 갱신되므로 예측이 틀려도 시프트 1회로 수렴한다.
         경로 목록·기본값 규칙은 라우트 선언과 같아야 한다 — src/pages/-app-shell/top-reserve.spec.ts가 계약으로 검증한다. -->
    <script id="app-shell-top-reserve">
      (function () {
        try {
          var params = new URLSearchParams(location.search);
          var path = location.pathname;
          var isSmall = innerWidth < 640;

          // 웹뷰는 앱이 넘겨주는 logContext 파라미터로 판별한다 (device_type: a=Android, i=iOS)
          var webview = false;
          var logContext = params.get('logContext');
          if (logContext) {
            try {
              webview = /"device_type"\s*:\s*"[ai]"/.test(atob(logContext));
            } catch (error) {
              // base64/JSON이 아니면 웹으로 판단
            }
          }

          var matchesPath = function (prefixes) {
            return prefixes.some(function (prefix) {
              return path === prefix || path.indexOf(prefix + '/') === 0;
            });
          };

          var header = params.get('header');
          // 라우트 search 미들웨어의 header 규칙: 항상 false 강제 / 기본값 false / 기본값 simple
          var headerForcedHidden = matchesPath(['/media-viewer']);
          var headerHiddenByDefault = matchesPath(['/referral']) && header !== 'true' && header !== 'simple';
          var headerHidden = header === 'false' || headerForcedHidden || headerHiddenByDefault;
          var headerSimpleByDefaultPaths = [
            '/login',
            '/signup',
            '/settings',
            '/identification',
            '/confirm-identification',
            '/withdraw',
            '/sell-to-love/status',
          ];
          var headerSimpleByDefault = matchesPath(headerSimpleByDefaultPaths) && header === null;
          var headerSmall = webview || header === 'simple' || headerSimpleByDefault || isSmall;

          // 라우트가 staticData.appNudge: false를 선언한 경로
          var nudgeHiddenPaths = [
            '/withdraw',
            '/identification',
            '/confirm-identification',
            '/settings',
            '/points',
            '/referral',
            '/media-viewer',
            '/business-information',
            '/sell-to-love',
          ];
          var nudgeHidden =
            webview ||
            matchesPath(nudgeHiddenPaths) ||
            params.get('appNudge') === 'false' ||
            params.get('disable_landing_modal') === 'true';

          var parts = [];
          if (!headerHidden) {
            parts.push(headerSmall ? 'var(--header-height-small)' : 'var(--header-height-large)');
          }
          if (!nudgeHidden) {
            parts.push(isSmall ? 'var(--app-nudge-banner-height-small)' : 'var(--app-nudge-banner-height-large)');
          }

          if (parts.length > 0) {
            document.documentElement.style.setProperty(
              '--app-shell-top-reserve',
              parts.length === 1 ? parts[0] : 'calc(' + parts.join(' + ') + ')'
            );
          }
        } catch (error) {
          // 예약에 실패하면 기존처럼 실측만으로 동작한다 (첫 페인트 후 시프트 1회)
        }
      })();
    </script>

