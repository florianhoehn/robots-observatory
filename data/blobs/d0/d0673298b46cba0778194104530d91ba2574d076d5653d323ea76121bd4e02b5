<!DOCTYPE HTML>
<html lang="sk">
<head>
<meta charset="utf-8">
<style>
.body_hl {background-image:url(//www.bombuj.si/images/error.jpg); width:800px; height:500px; margin-left:auto; margin-right:auto; font-family: 'Oswald', sans-serif;}
.error {color:#000; padding-top:110px; padding-left:180px; font-size:1.800em;}
.text {color:#000; padding-top:20px; padding-left:180px; font-size:1.300em;}
.error_main {color:#fff; padding-top:80px; padding-left:180px;}
.error_button {display:block; width:170px; height:50px; background-color:#C0392B; color:#fff; text-decoration:underline; line-height:50px; font-size:1.300em; border:1px solid #555; }
.error_button:hover {background-color:#ac3326; border:1px solid #444; text-decoration:underline; 
-webkit-box-shadow: 0 0 5px rgba(0,0,0,0.5);
-moz-box-shadow: 0 0 5px rgba(0,0,0,0.5);
box-shadow: 0 0 5px rgba(0,0,0,0.5); }
</style>
</head>
<body bgcolor="black">
<div class="body_hl">

<div class="error" align="center">Error 404</div>

<div class="text" align="center">Stránka ktorú hľadáte, neexistuje.</div>

<div class="error_main" align="center">
<a href="//www.bombuj.si/"><span class="error_button">Hlavná stránka</span></a>
</div>

</div>
