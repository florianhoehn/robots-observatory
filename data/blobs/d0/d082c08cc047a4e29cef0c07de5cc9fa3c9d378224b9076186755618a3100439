

<!DOCTYPE html>
<html>
<head>
    <title>Jobrapido - Error 404 Page Not Found</title>
    <meta http-equiv="cache-control" content="max-age=0" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta http-equiv="expires" content="0" />
    <meta http-equiv="expires" content="Mon, 11 May 1981 12:00:00 GMT" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta name="robots" content="nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta charset="utf-8">
    <link rel="icon" href="https://static.jobrapido.com/static/img/favicon/favicon.ico?v=1">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Open+Sans:300,700" media="screen" title="screen" charset="utf-8">
    <style>
        * {
            margin: 0;
            padding: 0;
            font-family: 'Open Sans', Arial, Verdana, sans-serif;
        }
        div.header {
            position: relative;
            height: 60px;
            border-bottom: 1px solid grey;
            background-color: #2b2b2b;
        }
        body {
            background-color: #DAFBF6;
            color: #0F0F0F;
            background-image: url(/img/404-background.svg);
            background-position: center bottom;
            background-size: cover;
            background-repeat: no-repeat;
            display: flex;
            flex-direction: column;
		}
        h1 {
            position: absolute;
            left: 0;
            top: 0;
            width: 110px;
            height: 26px;
            margin: 17px 0 17px 15px;
            text-indent: -5000px;
            background-image: url(https://static.jobrapido.com/static/img/logo_jr_venus.svg);
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
        }
        h2 {
            font-size: 100px;
            font-size: calc(100px + (58 - 100)*(100vw - 400px)/(1024 - 400));
            line-height: 1em;
            margin:20px 0;
        }
        p {
          font-size: 24px;
          padding-bottom: 10px;
        }
        a {
	        display: inline-block;
		    padding: 14px 40px;
		    background-color: #ff206e;
		    border-radius: 5px;
		    text-decoration: none;
		    color: #fff;
		    font-size: 24px;
		    text-transform: uppercase;
        }
        #main {
            width: 100%;
            margin: 0 auto;
            text-align: center;
            box-sizing: border-box;
            display: flex;
            flex: 100%;
            flex-direction: column;
            justify-content: space-between;
        }
        .man {
            width: 100%;
            align-self: center;
            max-width:320px;
        }
        .content{
            padding:0 16px 16px;
        }
        @media(min-width: 480px) {
            html {
                height: auto;
            }
        }
        @media(min-width: 768px) {
             body, html {
                min-height:100%;
                min-height:100vh;
            }
            .man {
                max-width: initial;
      	        width: auto;
    	        }
        	}
        @media(min-width: 1024px) {
          div.header {
            height: 93px;
          }
          h1 {
            width: 242px;
            height: 93px;
            background-size: 202px 49px;
            margin: 0;
          }
          h2 {
            font-size: 100px;
          }
        }
    </style>
	<script>
	  window.jtagQueue = window.jtagQueue || [];
	  function jtag() {
	    jtagQueue.push(arguments);
	  }
	  jtag('event', 'pageview');
	</script>
    <script async src="https://cdn-databox.jobrapido.com/jtag.umd.js"></script>
</head>
<body>
    <div class="header">
      <h1>Jobrapido</h1>
    </div>
    <div id="main">
      <div class="content">
        <h2>404</h2>
        <p>We’re sorry :( the page you requested was not found</p>
        <a href="http://us.jobrapido.com/">Don't give up, keep searching!</a>
      </div>
      <img class="man" src="/img/404-man.svg" />
    </div>
</body>
</html>