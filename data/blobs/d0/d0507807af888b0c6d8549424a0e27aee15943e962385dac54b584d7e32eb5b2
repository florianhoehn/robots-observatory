  (function () {
    /* -------------------------------------------------------------------------
       Layout preference switch
       ------------------------------------------------------------------------- */

    var COOKIE = 'rs_design';
    var PARAM = 'v';
    var OLD = 'old';
    var NEW = 'new';
    var DAYS = 90;

    /* -------------------------------------------------------------------------
       1. Cookie
       ------------------------------------------------------------------------- */
    function cookieDomain() {
      var host = window.location.hostname;
      return /(^|\.)rawstory\.com$/.test(host) ? '; domain=.rawstory.com' : '';
    }

    function writeCookie(value, maxAgeSeconds) {
      document.cookie =
        COOKIE + '=' + value +
        '; path=/' +
        cookieDomain() +
        '; max-age=' + maxAgeSeconds +
        '; SameSite=Lax' +
        (window.location.protocol === 'https:' ? '; Secure' : '');
    }

    function hasCookie() {
      return document.cookie.split('; ').some(function (pair) {
        return pair.indexOf(COOKIE + '=') === 0;
      });
    }

    /* -------------------------------------------------------------------------
       2. Query string

       Manual parsing keeps the encoding of other params unchanged.
       ------------------------------------------------------------------------- */
    function splitPair(pair) {
      var eq = pair.indexOf('=');
      return {
        key: eq === -1 ? pair : pair.slice(0, eq),
        val: eq === -1 ? '' : pair.slice(eq + 1)
      };
    }

    // values: the values to strip, or null to strip the key entirely.
    function withoutParam(search, values) {
      if (!search || search.length < 2) return '';

      var kept = search.slice(1).split('&').filter(function (pair) {
        var p = splitPair(pair);
        return !(p.key === PARAM && (values === null || values.indexOf(p.val) !== -1));
      });

      return kept.length ? '?' + kept.join('&') : '';
    }

    function urlWithParam(value) {
      var search = withoutParam(window.location.search, null);
      search = (search ? search + '&' : '?') + PARAM + '=' + value;
      return window.location.pathname + search + window.location.hash;
    }

    // Returns old or new if present in the URL, else null.
    function switchValue() {
      var search = window.location.search;
      if (!search || search.length < 2) return null;

      var found = null;
      search.slice(1).split('&').forEach(function (pair) {
        var p = splitPair(pair);
        if (p.key === PARAM && (p.val === OLD || p.val === NEW)) found = p.val;
      });
      return found;
    }

    /* -------------------------------------------------------------------------
       3. Public API
       ------------------------------------------------------------------------- */
    window.RSDesign = {
      isOld: function () {
        return switchValue() === OLD || hasCookie();
      },

      useOld: function () {
        writeCookie('old', DAYS * 24 * 60 * 60);
        console.log('@@ design - opting in to old layout');
        window.location.assign(urlWithParam(OLD));
      },

      useNew: function () {
        writeCookie('', 0);
        console.log('@@ design - opting out of old layout');
        window.location.assign(urlWithParam(NEW));
      }
    };

    /* -------------------------------------------------------------------------
       4. Init: sync the preference and tidy the URL
       ------------------------------------------------------------------------- */
    var current = switchValue();

    if (current === NEW) {
      writeCookie('', 0);
    } else if (current === OLD && hasCookie()) {
      writeCookie('old', DAYS * 24 * 60 * 60);
    }

    if (current && window.history && window.history.replaceState) {
      window.history.replaceState(
        window.history.state,
        '',
        window.location.pathname +
          withoutParam(window.location.search, [OLD, NEW]) +
          window.location.hash
      );
    }
  })();
