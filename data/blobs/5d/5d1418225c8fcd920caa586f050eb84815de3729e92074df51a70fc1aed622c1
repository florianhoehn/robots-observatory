    const header = document.getElementById("header-widget-area");
    const logo = document.getElementById("header-logo-aw");

    if (window.innerWidth > 1024) {
        if (document.body.scrollTop > 2 || document.documentElement.scrollTop > 2) {
            header.style.transform = "translate(0, -87px)";
            header.classList.add("aw-blur-active");
