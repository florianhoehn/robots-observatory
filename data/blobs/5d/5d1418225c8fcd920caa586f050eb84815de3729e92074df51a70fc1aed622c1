/* BUttons */
/* ===== Dark Blue Button ===== */

.aurora-btn--dark-blue a.elementor-button {
    position: relative;
    z-index: 1;
    border-radius: 4px;
    font-weight: 600;

    background: transparent !important;
    color: #121C42 !important;
    border: 2px solid #121C42 !important;

    transition:
        transform 0.35s linear,
        box-shadow 0.35s linear,
        background-position 0.35s linear;
}

/* Hover gradient layer - same as White Button */
.aurora-btn--dark-blue a.elementor-button:before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 4px;
    background: linear-gradient(99deg, #47fffa, #0066ff);
    opacity: 0;
    transition: opacity 0.35s linear;
    z-index: -1;
}

/* Glow - same as White Button */
.aurora-btn--dark-blue .elementor-button-wrapper:after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 4px;
    pointer-events: none;
    z-index: 0;

    background: linear-gradient(-99deg, #47FFFA, #0066ff);
    background-size: 300% 300%;
    filter: blur(20px);

    opacity: 0;
    mix-blend-mode: screen;
    animation: none;

    transition:
        opacity 0.35s linear,
        filter 0.35s linear;
}

/* Hover */
.aurora-btn--dark-blue a.elementor-button:hover {
    text-decoration: none;
    transform: translateY(-2px);

    /* Same hover effect as white button */
    background-position: 100% 0;

    color: #090f24 !important;

    /* Border disappears into gradient */
    border-color: transparent !important;

    box-shadow:
