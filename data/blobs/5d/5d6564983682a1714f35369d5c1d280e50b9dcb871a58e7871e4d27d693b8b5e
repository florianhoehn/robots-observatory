        // Search runs entirely on the genre list already embedded in the page
        // (every genre, not just the featured ones), so it answers on each
        // keystroke with no request. Prefix matches rank first; the hit is highlighted.
        fold(s) { return String(s).toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, ''); },
        get results() {
            const q = this.fold(this.query.trim());
            if (!q) return [];
            const out = [];
            for (const genre of this.pool()) {
                const at = this.fold(genre.title).indexOf(q);
                if (at === -1) continue;
                out.push({ ...genre, at, pre: genre.title.slice(0, at), hit: genre.title.slice(at, at + q.length), post: genre.title.slice(at + q.length) });
