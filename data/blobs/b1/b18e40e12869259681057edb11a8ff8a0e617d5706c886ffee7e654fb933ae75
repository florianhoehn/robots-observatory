</head>
<body>
	<div class="page-error">
		<div class="error-wrapper">
			<div class="error-wrapper--skyline">
				<div class="error-monster"></div>
			</div>
		</div>
		<div class="error-message">
			<h1>
				¡Lo sentimos!
				<br />
				La página que buscas no existe
			</h1>

			<p>
				<br />
				<strong>Si deseas, envíanos un mensaje reportándolo.</strong>
			</p>
						   
			<div class="error-message--button">
				<a class="button button--large" href="https://ayuda.fotocasa.es/">Reportar</a>
				<a class="button button--large" href="https://www.fotocasa.es/es/">Ir a la página de inicio</a>
			</div>
		</div>
	</div>
