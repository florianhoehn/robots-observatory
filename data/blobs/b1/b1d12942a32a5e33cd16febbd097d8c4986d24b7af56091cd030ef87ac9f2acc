<script type="text/javascript">
	$(function(){
		var refer = document.referrer;
		if(refer != null && refer != ""){
			$(".ly-back").click(function(){
				window.location.href = refer;	
			});	
		}else{
				$(".ly-back").click(function(){
				window.location.href="/";	
			});
		}
		
		$(".ly-index").click(function(){
			window.location.href="/";	
		});
	})	
</script>
