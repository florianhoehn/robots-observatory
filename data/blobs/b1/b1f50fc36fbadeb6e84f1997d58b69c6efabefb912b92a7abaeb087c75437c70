<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Forbidden Request</title>
<style>
body {
    font-family: Arial, sans-serif;
    background: #f8f8f8;
    text-align: center;
    padding: 0;
    margin: 0;
}

/* Div en haut qui prend toute la largeur et 200px de hauteur */
.logodiv {
    height: 200px;
    width: 100%;
    background: #041739;
    display: flex;              /* active flexbox */
    justify-content: center;    /* centre horizontalement */
    align-items: center;        /* centre verticalement */
}

/* Logo */
img.logo {
    max-height: 80%;            /* reste à l'intérieur du div */
    max-width: 90%;
}

/* Contenu principal sous le logo */
.main-content {
    padding: 50px 20px;
}

h1 {
    color: #041739;
}
</style>
</head>
<body>

<div class="logodiv">
    <img class="logo" src="https://www.holcim.com/themes/custom/corporate/components/header/images/holcim_logo_color.svg" alt="Mon Logo">
</div>

<div class="main-content">
    <h1>403 - Forbidden Request</h1>
    <p>Your request is forbidden by administrative rules.</p>
</div>

</body>
</html>
