<!DOCTYPE html>
<html>
<head>
  <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Купер</title>
</head>
<body>
 <script>
    function copy() {
        document.oncopy = function (e) {
            const t = {
                report: {
                    datetime: document.getElementById("REQUEST-DATE").innerHTML,
                    ip: document.getElementById("REQUEST-IP").innerHTML,
                    id: document.getElementById("REQUEST-ID").innerHTML
                }
            };
            e.clipboardData.setData("text", JSON.stringify(t));
            e.preventDefault();
        };
        document.execCommand("copy");
    }

    document.addEventListener("DOMContentLoaded", function() {
        const origin = window.location.protocol + "//" + window.location.host;
        document.getElementById('ORIGIN-ID').innerHTML = "Origin: " + origin;
    });
  </script>
    <style>
      body {
          background-color: #fff;
          margin: 0;
          padding: 0;
          min-height: 100vh;
          display: flex;
          flex-direction: column;
      }

      p {
        margin: 0;
      }

      .warning {
          flex: 1;
          display: flex;
          flex-flow: column;
          align-items: center;
          justify-content: center;
      }

      .warning__icon {
          min-width: 240px;
          max-width: 240px;
          width: 240px;
          height: 240px;
          margin-bottom: 20px;
      }

      .warning__text {
          text-align: center;
          font-size: 14px;
          font-family: 'Roboto', sans-serif;
          color: #1D1D1D;
          font-family: font/family/Heading;
          line-height: 18px;
          margin-bottom: 20px;
      }

      .warning__text--header {
          font-size: 1.5em;
          font-weight: bold;
          margin-bottom: 8px;
      }

      .warning__text--description {
      }

      .extra-description {
        max-width: 320px;
        text-align: center;
        color: #ADADAD;
      }

      .button {
        background-color: #00FB68;
        padding: 16px;
        border-radius: 32px;
        border: 1px solid #64f77c;
        font-size: 14px;
        font-weight: 700;
        font-family: 'Roboto', sans-serif;
        max-width: 320px;
        width: 100%;
        cursor: pointer;
        margin-bottom: 32px;
      }

      .grey {
        background: #f2f2f2;
        border: 1px solid #f2f2f2;
        width: 150px;
        margin-bottom: 12px;
      }

      .request-info {
        color: #808080;
        padding: 32px;
        text-align: center;
        font-family: 'Roboto', sans-serif;
        font-size: 12px;
        line-height: 1.5;
        position: fixed;
        bottom: 0;
        width: 100%;
        box-sizing: border-box;
      }

      .request-info p {
        display: inline;
      }

      .request-info p + p::before {
        content: " · ";
      }

      .button:active {
        background: #00D157;
        color: black;
      }

      .button.grey:active {
        background: #E0E0E0;
        color: black;
      }
  </style>

  <div class="warning">
    <div class="warning__text">
        <p class="warning__text--header">Отключите&nbsp;VPN</p>
        <p class="warning__text--description">А после&nbsp;—&nbsp;обновите страницу.</p>
        <p class="warning__text--description">И всё заработает</p>
    </div>
  <button class="button" onclick="window.location.reload()">Обновить</button>

    <div class="warning__text">
      <p class="warning__text--description extra-description">Если вы видите это сообщение, хотя VPN отключён, скопируйте системную информацию и отправьте её в службу поддержки.</p>
    </div>
    <button class="button grey" onclick="copy()">Скопировать</button>
  </div>

  <div class="request-info">
    <p id="REQUEST-DATE">2026-10-19 21:46:28 +0000</p>
    <p id="REQUEST-IP">IP: 82.39.15.43</p>
    <p id="REQUEST-ID">ID: SknN1f71p8c1</p>
    <p id="ORIGIN-ID"></p>
  </div>
</body>
</html>
