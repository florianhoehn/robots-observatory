<script type="dba64f7f3cbe6fd1b2c96b37-text/javascript">
    (function() {
        'use strict';
        
        const COUNTDOWN_START = 5;
        const HOME_URL = "https:\/\/niezalezna.pl";
        
        let countdown = COUNTDOWN_START;
        let intervalId = null;
        let hasRedirected = false;
        
        const countdownElement = document.getElementById('countdown');
        if (!countdownElement) {
            console.error('Countdown element not found');
            return;
        }
        
        function redirect() {
            if (hasRedirected) return;
            hasRedirected = true;
            
            if (intervalId) {
                clearInterval(intervalId);
            }
            
            try {
                window.location.href = HOME_URL;
            } catch (error) {
                console.error('Redirect failed:', error);

                window.location.href = '/';
            }
        }
        
        function updateCountdown() {
            if (hasRedirected) return;
            
            countdownElement.textContent = countdown.toString();
            
            if (countdown <= 0) {
                redirect();
                return;
            }
            
            countdown--;
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            updateCountdown();

            intervalId = setInterval(updateCountdown, 1000);
        });
        
        document.addEventListener('click', function(e) {
            if (e.target.tagName.toLowerCase() === 'a' || 
                e.target.closest('footer') || 
                e.target.closest('a') ||
                hasRedirected) {
                return;
            }

            const mainContent = e.target.closest('div');
            if (mainContent && !mainContent.closest('footer')) {
                redirect();
            }
        });
        
        window.addEventListener('beforeunload', function() {
            if (intervalId) {
                clearInterval(intervalId);
            }
        });
        
        if (window.errorPageInitialized) {
            return;
        }
        window.errorPageInitialized = true;
        
    })();
</script>
