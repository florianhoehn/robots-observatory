<script>
  /* =========================
     HEADER SCROLL
     Becomes white after 10px
  ========================= */

  window.Webflow = window.Webflow || [];

  window.Webflow.push(function () {
    const header = document.querySelector(".header-wrapper");

    if (!header) return;

    const scrollThreshold = 10;
    let ticking = false;

    function updateHeaderBackground() {
      const scrollTop =
        window.scrollY ||
        document.documentElement.scrollTop;

      if (scrollTop >= scrollThreshold) {
        header.classList.add("is-scrolled");
      } else {
        header.classList.remove("is-scrolled");
      }

      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(updateHeaderBackground);
        ticking = true;
      }
    }

    window.addEventListener(
      "scroll",
      onScroll,
      { passive: true }
    );

    updateHeaderBackground();
  });
</script>


<script>
  /* =========================
     DESKTOP DROPDOWNS
  ========================= */

  document.addEventListener("DOMContentLoaded", function () {

    const desktop = window.matchMedia("(min-width: 992px)");
    const dropdowns =
      document.querySelectorAll(".dropdown-wrapper");

    dropdowns.forEach(function (dropdown) {

      const toggle =
        dropdown.querySelector(".dropdown-toogle");

      const list =
        dropdown.querySelector(".dropdown-list");

      if (!toggle || !list) return;

      let closeTimer;


      function updateHeight() {

        if (!desktop.matches) return;

        list.style.setProperty(
          "--dropdown-height",
          list.scrollHeight + "px"
        );
      }


      function closeAllOtherDropdowns() {

        dropdowns.forEach(function (otherDropdown) {

          if (otherDropdown === dropdown) return;

          otherDropdown.classList.remove(
            "is-dropdown-open"
          );

          const otherToggle =
            otherDropdown.querySelector(
              ".dropdown-toogle"
            );

          if (otherToggle) {
            otherToggle.setAttribute(
              "aria-expanded",
              "false"
            );
          }
        });
      }


      function openDropdown() {

        if (!desktop.matches) return;

        clearTimeout(closeTimer);

        closeAllOtherDropdowns();

        updateHeight();

        dropdown.classList.add(
          "is-dropdown-open"
        );

        toggle.setAttribute(
          "aria-expanded",
          "true"
        );
      }


      function closeDropdown() {

        if (!desktop.matches) return;

        clearTimeout(closeTimer);

        closeTimer = setTimeout(function () {

          dropdown.classList.remove(
            "is-dropdown-open"
          );

          toggle.setAttribute(
            "aria-expanded",
            "false"
          );

        }, 50);
      }


      /* HOVER */

      dropdown.addEventListener(
        "mouseenter",
        function () {
          openDropdown();
        }
      );

      dropdown.addEventListener(
        "mouseleave",
        function () {
          closeDropdown();
        }
      );


      /* KEYBOARD FOCUS */

      dropdown.addEventListener(
        "focusin",
        function () {
          openDropdown();
        }
      );

      dropdown.addEventListener(
        "focusout",
        function (event) {

          if (!dropdown.contains(event.relatedTarget)) {
            closeDropdown();
          }
        }
      );


      /* CLICK */

      toggle.addEventListener(
        "click",
        function () {

          if (!desktop.matches) return;

          clearTimeout(closeTimer);

          if (
            dropdown.classList.contains(
              "is-dropdown-open"
            )
          ) {

            dropdown.classList.remove(
              "is-dropdown-open"
            );

            toggle.setAttribute(
              "aria-expanded",
              "false"
            );

          } else {

            openDropdown();

          }
        }
      );


      updateHeight();
    });


    /* =========================
       RESIZE
    ========================= */

    window.addEventListener(
      "resize",
      function () {

        dropdowns.forEach(
          function (dropdown) {

            const list =
              dropdown.querySelector(
                ".dropdown-list"
              );

            if (!list) return;

            if (desktop.matches) {

              list.style.setProperty(
                "--dropdown-height",
                list.scrollHeight + "px"
              );

            } else {

              dropdown.classList.remove(
                "is-dropdown-open"
              );

              list.style.removeProperty(
                "--dropdown-height"
              );

              const toggle =
                dropdown.querySelector(
                  ".dropdown-toogle"
                );

              if (toggle) {
                toggle.setAttribute(
                  "aria-expanded",
                  "false"
                );
              }
            }
          }
        );
      }
    );


    /* =========================
       ESCAPE
    ========================= */

    document.addEventListener(
      "keydown",
      function (event) {

        if (event.key !== "Escape") return;

        dropdowns.forEach(
          function (dropdown) {

            dropdown.classList.remove(
              "is-dropdown-open"
            );

            const toggle =
              dropdown.querySelector(
                ".dropdown-toogle"
              );

            if (toggle) {
              toggle.setAttribute(
                "aria-expanded",
                "false"
              );
            }
          }
        );
      }
    );

  });
</script>


<script>
  /* =========================
     MOBILE MENU
     LOCK BODY SCROLL
  ========================= */

  window.Webflow = window.Webflow || [];

  window.Webflow.push(function () {

    const mobile =
      window.matchMedia("(max-width: 991px)");

    const header =
      document.querySelector(".header-wrapper");

    const menuButton =
      header?.querySelector(".w-nav-button");

    if (!menuButton || !header) return;

    let locked = false;
    let scrollY = 0;
    let previousStyles;


    function updateMobileMenu() {

      const menuOpen =
        mobile.matches &&
        (
          menuButton.classList.contains("w--open") ||
          menuButton.getAttribute(
            "aria-expanded"
          ) === "true"
        );


      header.classList.toggle(
        "is-mobile-menu-open",
        menuOpen
      );


      /* OPEN */

      if (menuOpen && !locked) {

        scrollY = window.scrollY;

        previousStyles = {
          position: document.body.style.position,
          top: document.body.style.top,
          left: document.body.style.left,
          right: document.body.style.right,
          width: document.body.style.width
        };


        Object.assign(
          document.body.style,
          {
            position: "fixed",
            top: `-${scrollY}px`,
            left: "0",
            right: "0",
            width: "100%"
          }
        );


        locked = true;
      }


      /* CLOSE */

      else if (!menuOpen && locked) {

        Object.assign(
          document.body.style,
          previousStyles
        );

        locked = false;

        window.scrollTo(
          0,
          scrollY
        );
      }
    }


    /* WATCH WEBFLOW NAV BUTTON */

    new MutationObserver(
      updateMobileMenu
    ).observe(
      menuButton,
      {
        attributes: true,
        attributeFilter: [
          "class",
          "aria-expanded"
        ]
      }
    );


    /* BREAKPOINT CHANGE */

    mobile.addEventListener(
      "change",
      updateMobileMenu
    );


    updateMobileMenu();
  });
</script>
