    <script>
        (function () {
            var webMeasurementId = "G-1Z7L98G6BK";
            var appMeasurementId = "G-4MCRJMX7YL";
            var STORAGE_KEY = 'ga4VerifiedSessionId';
            var LOCK_NAME = 'ga4VerifiedSessionLoginStatus';
            var POLL_INTERVAL_MS = 100;
            var POLL_TIMEOUT_MS = 1000;

            // 同名Cookieが複数存在する場合、ドメイン指定を誤った削除処理により別ドメインスコープで
            // 値がdeletedのダミーCookieが残っていることがある。それを除いて1件に絞れる場合のみ値を返す。
            function readSingleCookieValue(name) {
                var pattern = new RegExp('(?:^|; )' + name + '=([^;]*)', 'g');
                var values = [];
                var match;
                while ((match = pattern.exec(document.cookie)) !== null) {
                    var value = decodeURIComponent(match[1]);
                    if (value !== 'deleted') {
                        values.push(value);
                    }
                }
                return values.length === 1 ? values[0] : null;
            }

            function extractSessionId(cookieValue) {
                if (!cookieValue) return null;
                var match = cookieValue.match(/\.s(\d+)(?:\$|$)/);
                return match ? match[1] : null;
            }

            function readPreviousSessionId() {
                try {
                    return window.localStorage.getItem(STORAGE_KEY);
                } catch (e) {
                    return null;
                }
            }

            function storeSessionId(sessionId) {
                try {
                    window.localStorage.setItem(STORAGE_KEY, sessionId);
                } catch (e) {
                    // localStorageが使えない場合(プライベートブラウジング等)は次回以降も検知できないだけで、既存挙動には影響しない
                }
            }

            // asoview-ui(Java)側のAsoviewAppUtil.isApp()と同じ判定基準。
            function isAsoviewApp() {
                var userAgent = window.navigator.userAgent;
                return typeof userAgent === 'string'
                    && (userAgent.indexOf('AppRequest/ios') !== -1 || userAgent.indexOf('AppRequest/android') !== -1);
            }

            function pushVerifiedSessionLoginStatus(isLoggedIn, memberNumber) {
                var event = { event: 'verified_session_login_status' };
                if (isLoggedIn === true || isLoggedIn === false) {
                    event.is_logged_in = isLoggedIn;
                }
                if (isAsoviewApp()) {
                    event.platform = 'APP';
                }
                if (typeof memberNumber === 'number') {
                    event.member_number = memberNumber;
                }
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(event);
            }

            function checkNewSession() {
                // アプリのWebViewではWeb用の土台タグが載らずWeb用Cookieが作られないため、アプリ用の測定IDを見る。
                var measurementId = isAsoviewApp() ? appMeasurementId : webMeasurementId;
                if (!measurementId) return;

                var currentSessionId = extractSessionId(readSingleCookieValue('_ga_' + measurementId.replace('G-', '')));
                if (!currentSessionId) return;

                var previousSessionId = readPreviousSessionId();
                if (previousSessionId !== null && previousSessionId !== currentSessionId) {
                    fetch('/api/google-analytics/login-status', { credentials: 'same-origin' })
                        .then(function (response) { return response.json(); })
                        .then(function (data) { pushVerifiedSessionLoginStatus(data.isLoggedIn, data.memberNumber); })
                        .catch(function () { pushVerifiedSessionLoginStatus(undefined, undefined); });
                }
                storeSessionId(currentSessionId);
            }

            function runCheckNewSessionWithLock() {
                try {
                    if (window.navigator && window.navigator.locks && typeof window.navigator.locks.request === 'function') {
                        window.navigator.locks.request(LOCK_NAME, function () {
                            try {
                                checkNewSession();
                            } catch (e) {
                                // 予期せぬエラーは握りつぶし、既存のページ表示・計測に影響を与えない
                            }
                        });
                    } else {
                        checkNewSession();
                    }
                } catch (e) {
                    // 予期せぬエラーは握りつぶし、既存のページ表示・計測に影響を与えない
                }
            }

            var pollElapsedMs = 0;
            var pollId = setInterval(function () {
                pollElapsedMs += POLL_INTERVAL_MS;
                runCheckNewSessionWithLock();
                if (pollElapsedMs >= POLL_TIMEOUT_MS) {
                    clearInterval(pollId);
                }
            }, POLL_INTERVAL_MS);

            if (document.readyState === 'complete') {
                runCheckNewSessionWithLock();
            } else {
                window.addEventListener('load', runCheckNewSessionWithLock);
            }
        })();
    </script>


    
