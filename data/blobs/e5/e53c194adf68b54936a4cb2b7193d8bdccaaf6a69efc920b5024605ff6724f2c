          const articleUrl = window.location.href;
          const endpoint = `https://ai-sentiment.foundryco.app/?url=${encodeURIComponent(articleUrl)}`;
          
          (async () => {
          		const startTime = performance.now();
          
            try {
              const response = await fetch(endpoint, {
                method: "GET",
                cache: "no-store",
              });
         	
              if (!response.ok) {
                console.warn(
                  `Sentiment request failed with HTTP ${response.status} after ${(performance.now() - startTime).toFixed(2)}ms`
                );
                return;
              }
         	
              const data = await response.json();
         	
              window.sentimentData = data;
         	
              const elapsed = performance.now() - startTime;
         	
              console.log(
                "Success, sentiment data for header bidding is",
                window.sentimentData
              );
              console.log(`Sentiment request completed in ${elapsed.toFixed(2)}ms`);
            } catch (err) {
              const elapsed = performance.now() - startTime;
         	
              console.warn(
                `Sentiment request failed after ${elapsed.toFixed(2)}ms`,
                err
              );
            }
          })();
		}

