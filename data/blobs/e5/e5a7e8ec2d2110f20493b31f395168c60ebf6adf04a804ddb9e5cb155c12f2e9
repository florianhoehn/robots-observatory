        <style type=text/css>
            .header-simply {
                position: relative;
                min-width: 1024px;
                box-shadow: 0 4px 4px rgba(0,0,0,0.05);
                background-color: #ffffff;
                display: flex;
                width: 100%;
                height: 80px;
                justify-content: center;
                align-items: center;
            }

            .error-container{
                width: 945px;
                height: 560px;
                margin: 70px auto;
                position: relative;
            }

            .error-container.error_404{
                background: url('https://cdn.yamibuy.net/statics/prd-k8s/ec-website-nb/website/nb/images/error-bg-404.png') center top no-repeat;
            }
            .error-container.error_500{
                background: url('https://cdn.yamibuy.net/statics/prd-k8s/ec-website-nb/website/nb/images/error-bg-500.png') center top no-repeat;
            }
            .error-container.error_400{
                background: url('https://cdn.yamibuy.net/statics/prd-k8s/ec-website-nb/website/nb/images/error-bg.png') center top no-repeat;
            }
            .error-container.error_416{
                background: url('https://cdn.yamibuy.net/statics/prd-k8s/ec-website-nb/website/nb/images/error-bg.png') center top no-repeat;
            }
            .error-container.error_checkout{
                background: url('https://cdn.yamibuy.net/statics/prd-k8s/ec-website-nb/website/nb/images/error-bg.png') center top no-repeat;
            }

            .error-container .error-description{
                position: absolute;
                left: 500px;
                top: 90px;
            }

            .error-container .error-description_title{
                font-size: 30px;
                color: #222222;
                line-height: 38px;
                font-weight: bold;
            }
            .error-container .error-description_content{
                font-size: 14px;
                margin-top: 10px;
                color: rgba(0, 0, 0, 0.55);
                line-height: 22px;
            }
            .error-container .button-solid-yamired-active{
                margin-top: 20px;
                padding: 8px 30px;
                font-size: 16px;
            }

            .button-solid-yamired-active{
                background-color: #f25759;
                box-shadow: 0 4px 10px 0 rgba(242,87,89,.3);
                display: inline-block;
                line-height: 18px;
                border-radius: 100px;
                color: #fff;
                cursor: pointer;
                user-select: none;
                border: 1px solid #f25759;
                outline: none;
                text-decoration-line: none;
            }
