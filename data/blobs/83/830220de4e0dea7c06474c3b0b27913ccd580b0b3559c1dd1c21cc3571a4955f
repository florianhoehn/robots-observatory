              return function (obj, callback) {
              if (!obj || obj.nodeType !== 1) return;

              if (MutationObserver) {
                var mutationObserver = new MutationObserver(callback);
                mutationObserver.observe(obj, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ["style", "class"]
