    document.addEventListener(
      "click",
      function (e) {
        if (window.__signupModalReady) return;
        var anchor = e.target.closest && e.target.closest(getSelector());
        if (!anchor) return;
        e.preventDefault();
        e.stopPropagation();
        window.__pendingSignupAnchor = anchor;
        document.documentElement.style.cursor = "progress";
        clearTimeout(window.__pendingSignupTimer);
        window.__pendingSignupTimer = setTimeout(function () {
          if (window.__pendingSignupAnchor !== anchor) return;
          window.__pendingSignupAnchor = null;
