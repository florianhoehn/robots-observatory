<script>
var var_contenido_noticias_scroll_control = 1;
var var_registros = 3;
function SDIScroll() {
	return fetch('/tools/v2/libreria.ashx', { method:"POST", headers:{contentType:"application/json; charset=utf-8"}, body:JSON.stringify({T:"S",A:"S",P:{Tipo:'R',Registros:var_registros,ZonaID:0,TagID:0,Version:2,Desde:var_contenido_noticias_scroll_control}}) })
		.then(function (response) {
			return response.json().then(function(obj) {
				if (obj.Respuesta == 0) {
					document.getElementById('pan_contenido_noticias_scroll_control').innerHTML += obj.Html;
					if (obj.VerMas == false)
						document.getElementById('btn_contenido_noticias_scroll_control').className += ' d-none';
					else
						document.getElementById('btn_contenido_noticias_scroll_control').className = document.getElementById('btn_contenido_noticias_scroll_control').className.replace('d-none', '');
					var_contenido_noticias_scroll_control += var_registros;
					document.getElementById('pan_contenido_noticias_scroll_control').className = document.getElementById('pan_contenido_noticias_scroll_control').className.replace('d-none', '');
					var_registros = 6;
				}
				else {
					document.getElementById('btn_contenido_noticias_scroll_control').className += ' d-none';
					console.log('Error: ' + obj.MensajeError);
				}
			});
		})
		.catch(function (error) {
			document.getElementById('btn_contenido_noticias_scroll_control').className += ' d-none';
			console.log('Error: ' + error.message);
		});
}
window.addEventListener("load", function() {
	SDIScroll();
});
