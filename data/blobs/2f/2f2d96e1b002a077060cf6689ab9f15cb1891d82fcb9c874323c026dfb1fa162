					if (grpsMatch) {
						const groupsValue = grpsMatch[1];
						otPreferences = otPreferences.replace(groupsValue, updatedOtGrpsString);
						$.cookie('OptanonConsent', otPreferences, {expires: expirationDate, path: '/', domain: '.' + rootDomain});
					}
				} else {
					$.cookie('OptanonConsent', '&groups='.concat(updatedOtGrpsString), {expires: expirationDate, path: '/', domain: '.' + rootDomain});
				}
