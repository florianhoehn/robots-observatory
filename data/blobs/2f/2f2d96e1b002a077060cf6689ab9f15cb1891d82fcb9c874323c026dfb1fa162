<script type="text/javascript">
self.airgap.ready((airgap) => {
	function getTranscendEmailTokenAndSync() {
		$.ajax({
			url: '/getemailtoken',
			type: 'GET',
			dataType: 'json',
			success: function(data) {
				if((data != null || data != undefined) && data.id_token != null && data.id_token != undefined){
					sessionStorage.setItem("transcendEmailAccessToken", data.id_token);
					localStorage.setItem("transcendLastSync", Date.now());
					airgap.sync({ auth: data.id_token });
				}
			},
			error: (data) => {
				console.error('Failed to get Token');
			}
		});
	}

	if($.isEmptyObject(sessionStorage.getItem('transcendEmailAccessToken'))){
		getTranscendEmailTokenAndSync();
	}else{
		const lastSync = localStorage.getItem("transcendLastSync");
		const parsedExpiryHours = parseFloat('0');
		const expiryHours = Number.isNaN(parsedExpiryHours) ? 24 : parsedExpiryHours;
		if (expiryHours === 0 || !lastSync || (Date.now() - parseInt(lastSync, 10)) > expiryHours * 60 * 60 * 1000) {
			if(!$.isEmptyObject(sessionStorage.getItem('transcendEmailAccessToken'))){
				localStorage.setItem("transcendLastSync", Date.now());
				airgap.sync({ auth: sessionStorage.getItem('transcendEmailAccessToken') });
			} else {
				getTranscendEmailTokenAndSync();
			}
		}
	}
});
</script>
