                    //update the consent on OT Cookies when consent is changed
                    costcoConsentManager.syncOTConsent(consent);
                    if (costcoConsentManager._isCookieConsentFormView) {
                       return;
                    } else {
                        const applicablePurposes = airgap.getRegimePurposes();
                        const purposeTypes = airgap.getPurposeTypes();
                        const confirmedConsent = consent.confirmed;
