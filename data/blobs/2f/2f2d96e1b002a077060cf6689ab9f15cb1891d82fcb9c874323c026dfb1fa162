			syncOTConsent: function(consent) {
				//sync the OT consent based on Transcend consent
				let otPreferences = $.cookie('OptanonConsent');
				let rootDomain = window.location.hostname.split('.').slice(-2).join('.');
				//initialize OT group C0001/essential as opted in.
				let otGroups = ["C0001:1"];
				let updatedOtGrpsString = '';
				// Check if C0004 (SaleOfInfo) should be set to 0 based on specific conditions
				let shouldDisableC0004 = (typeof consent.purposes !== 'undefined' && consent.purposes !== null) && (
					normalizeBoolean(consent.purposes.DoNotProcess) ||
					normalizeBoolean(consent.purposes.DoNotSell) ||
