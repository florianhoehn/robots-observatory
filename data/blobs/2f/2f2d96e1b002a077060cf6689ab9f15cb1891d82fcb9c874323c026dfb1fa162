                            const isBackgroundSync = fromSync;
                            if (!isBackgroundSync) {
                              // sync consent changes to backend
                              if (!syncWithAuthTokenCalled) {
                                syncWithAuthTokenCalled = true;
                                if(!$.isEmptyObject(sessionStorage.getItem('transcendEmailAccessToken'))){
