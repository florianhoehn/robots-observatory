					costcoConsentManager.syncOTConsent(consent);
					if (costcoConsentManager._isCookieConsentFormView) {
						return;
					} else if (typeof changes !== 'undefined' && changes != null) {
						const changedPurposes = Object.keys(changes);
						const applicablePurposes = airgap.getRegimePurposes();
						const purposeTypes = airgap.getPurposeTypes();
						const confirmedConsent = consent.confirmed;
						const consentTimestamp = consent.timestamp;
						if(typeof consentTimestamp !== 'undefined' && consentTimestamp != null
							&& typeof confirmedConsent !== 'undefined' && confirmedConsent != null && confirmedConsent) {
              				const consentTime = new Date(consentTimestamp).getTime();
			                const now = Date.now();
			                // If the timestamp is older than ~5 seconds, it's almost certainly a background sync
			                // note: while debug on breakpoints, the time might pass.
			                const isBackgroundSync = fromSync;
			                if (!isBackgroundSync && changedPurposes.some((purpose) => applicablePurposes.has(purpose) && purposeTypes[purpose].configurable)) {
			                  // sync consent changes to backend
			                  if (!syncWithAuthTokenCalled) {
			                    syncWithAuthTokenCalled = true;
				                if('true' === 'true' && !$.isEmptyObject(sessionStorage.getItem('transcendEmailAccessToken'))){
				                    await airgap.sync({ auth: sessionStorage.getItem('transcendEmailAccessToken')})
			                    }
			                  }
			                  //reload for changes when all changedPurposes are configurable only and do not reload for background sync
			                  location.reload();
			                }
						}
					}
				});
				
				//Add Transcend consent-change event listener
                airgap.addEventListener('consent-resolution', async ({
                    detail: {
                        consent,
