function getUserName(_callBack) {
    var token = '';
    if (token) {
      $.ajax({
          url: "https://mp-eu-openapi.auto.mydlink.com/me/user/info?access_token="+token,
          type: 'get',
          dataType: 'json',
          contentType: 'application/json',
          success: function(result) {
              if(_callBack) {
                  _callBack(result.data);
                  return;
              }
          },
          error: function(error) {
              if(_callBack) {
                  _callBack({});
                  return;
              }
          }
      });
    }
}
