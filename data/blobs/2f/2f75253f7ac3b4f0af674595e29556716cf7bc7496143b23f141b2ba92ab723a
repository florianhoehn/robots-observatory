    <script type="text/javascript">
        function goToForgot() {
            var eml = $('uname').value;
            var params = '?layout=nonav&c=t';
            if(eml) {
                params += '&email=' + encodeURIComponent(eml);
            }
            location.href = '/secure/login/forgotPassword' + params;
        }

        function regwindow() {
            window.open("/");
            window.close();
        }

        document.observe('dom:loaded', function () {
            if (window.parent !== window) {
              window.parent.location.reload();
            }
            $('uname').focus();
        });
        
    </script>

