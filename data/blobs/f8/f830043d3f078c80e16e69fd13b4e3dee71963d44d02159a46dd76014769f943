<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>میهن وب هاست | صفحه مورد نظر یافت نشد</title>
    <link rel="stylesheet" href="css/mihanwebhost.css">
    <meta property="og:image" content="https://mihanwebhost.com/images/logo.jpg"/>
	<link rel="apple-touch-icon" sizes="180x180" href="templates/mwh/images/pagesIcon/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="512x512" href="templates/mwh/images/pagesIcon/android-chrome-512x512.png">
	<link rel="icon" type="image/png" sizes="192x192" href="templates/mwh/images/pagesIcon/android-chrome-192x192.png">
	<link rel="icon" type="image/png" sizes="32x32" href="templates/mwh/images/pagesIcon/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="templates/mwh/images/pagesIcon/favicon-16x16.png">
    <style type="text/css">
        #oopss {
            text-align: center;
            margin: 70px auto;
            font-weight: 400;
            font-size: 20px;
            position: relative;
            width: 100%;
            height: 100%;
            line-height: 2.5;
            left: 0px;
        }
        #error-text{
            margin: 20px auto!important;
        }
        #error-text img {
            max-width: 100%;
            width: 70%;
        }
        .main_content .main_title {
            display: none;
        }
        .master-slider, .main_title {
            display: none;
        }
        .row-error{
            width:100%;
            padding: 60px 0;
        }
        .img-error{
            text-align:center;
        }
        .text-error{
            text-align:center;
        }
        .text-error h1{
            font-size: 40px;
            font-weight: bold;
            font-family: Iransans;
            border-bottom: 0;
            color: #2895de;
        }
        .text-error p{
            font-size: 20px;
            color: gray;
            font-family: Iransans!important;
            font-weight: 300;
            line-height:2;
            padding:5px 0 25px 0;
        }

        .btn-error404{
            background: #2895de;
            border: none;
            padding: 15px;
            border-radius: 37px;
            color: #fff!important;
            font-size: 16px;
            font-family: Iransans;
            box-shadow: 3px 3px 14px #95c9ec;
        }
        .btn-error404:hover{
            box-shadow: 3px 3px 16px #74baea;
        }
        .bg_error{
            background-image: url(https://my.mihanwebhost.com/templates/mwh/images/bg_error.svg);
            background-position: center;
            background-repeat: no-repeat;
            background-size: cover;
        }
        @media(max-width:768px){
            .text-error h1{
                margin-bottom:0!important;
                font-size: 30px!important;
            }
            .text-error p{
                font-size:16px!important;
            }
            .btn-error404{
                padding: 10px!important;
                font-size: 12px!important;
            }
            .row-error{
                padding:50px 0!important;
            }
            .bg_error .img-logo_error{
                margin-right: 10px!important;
                width: 140px!important;
            }
        }
        .bg_error .img-logo_error{
            max-width: 100%;
            margin-right: 15px;
            width: 220px;
        }

    </style>
</head>
<body>
<section class="bg_error main">
    <img src="https://my.mihanwebhost.com/templates/mwh/images/logo-mwh-01.svg" class="img-logo_error">
    <div class="container">
        <div class="row-error">
            <div class="text-error">
                <h1 class="text-center">
                    خطای 404
                </h1>
                <p>
                    صفحه مورد نظر یافت نشد!
                </p>
                <a href="https://mihanwebhost.com" class="btn btn-error404">
                    بازگشت به صفحه اصلی <i class= "fa fa-arrow-left"></i>
                </a>
            </div>
            <div class="img-error">
                <div id="error-text">
                    <img src="https://my.mihanwebhost.com/templates/mwh/images/error_404.svg">
                </div>
            </div>
        </div>
    </div>
</section>
</body>
</html>