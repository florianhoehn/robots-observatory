            function rstoreSearch()
            {
                var term = encodeURIComponent( document.getElementById('404SearchBox').value );
                if( term.length === 0 )
                    return;
                document.getElementById('404SearchTerm').value = term;
                var searchForm = document.getElementById('404NavSearch');
                searchForm.action = searchForm.action + '?q=' + term;
                searchForm.submit();
            }
        </script>
