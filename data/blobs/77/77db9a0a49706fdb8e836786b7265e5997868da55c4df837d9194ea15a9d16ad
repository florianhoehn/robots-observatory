              /**
              * ------------------------------------------------
              * DIDOMI GEOLOCATION OVERRIDE (QA / LOCAL TESTING)
              * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
              * Allows developers and QA testers to simulate visits from a specific
              * country by supplying a `country` query string parameter in the URL.
              *
              * When provided, the country code is passed to Didomi before initialization so
              * regional consent rules (such as GDPR banners) can be tested without a VPN.
              * If omitted, normal geolocation detection is used by Didomi.
              *
              */
              const params = new URLSearchParams(window.location.search);
              const country = params.get('country');

              window.didomiConfig = window.didomiConfig || {};

              if (country) {
                  window.didomiConfig.user = {
                      ...(window.didomiConfig.user || {}),
                      country: country.toUpperCase()
