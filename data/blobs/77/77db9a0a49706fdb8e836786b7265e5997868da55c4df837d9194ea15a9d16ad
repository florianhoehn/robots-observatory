                }

              }

              /**
              * Waits for Didomi to resolve the visitor's consent status before loading GTM.
              *
              * Consent Mode is updated first so the GTM container starts with the correct
              * Google consent state.
              */
              window.didomiOnReady.push(async function (Didomi) {

                // REFINEMENT: All logic is now inside a single try/catch block for
                // comprehensive error handling of the entire OnReady lifecycle.
                try {

                  // Awaited purely for sequencing: it guarantees Didomi has resolved the
                  // visitor's status before the sync below reads isConsentRequired() and
                  // getUserStatus(). The returned value itself is no longer needed.
                  await Didomi.getCurrentUserStatus();

                  // update the U20K20G cookie with vendor specific changes
                  ukgUpdateU20K20GCookie();

                } catch (error) {

