               * REGISTER LISTENER (consent.changed)
               * ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
               * This listener fires whenever a user's consent status changes, which most
               * commonly happens when a user clicks "Agree" or "Disagree" on the banner.
               *
               */
              window.didomiEventListeners.push({

                  event: 'consent.changed',

                  // use 'async' to allow the use of 'await' functionality.
                  listener: async function () {

                      try {

                          // validate if Didomi and the async function are available.
                          if (window.Didomi && typeof window.Didomi.getCurrentUserStatus === 'function') {

                            // The customer triggered a 'consent.changed' event; update their U20K20G cookie accordingly
                            // as we rely upon its vendor values to determine which functionality is enabled/disabled.
                            // Routed through ukgUpdateU20K20GCookie() so the Drupal-availability guard applies here
                            // too — consent can change before the Drupal JS bundle has finished loading, and the
                            // direct call would throw into the catch below and silently skip the update.
                            ukgUpdateU20K20GCookie();

                          }

                      } catch (error) {

                        // add error handling in case the Promise rejects.
                        console.error("Didomi 'consent.changed' Error: Could not get user status.", error);

                      }
                  }
              });

