<script type="text/javascript">
function __pn_sendEvent(eventType) {
  cX.callQueue.push(['setEventAttributes', { origin: 'nks-members', persistedQueryId: 'b40968cd5ad81ebaaa800ef427172c260ccac6a5' }]);
