<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Arial', sans-serif;
            background: #f4f6f8;
            min-height: 100vh; /* Use min-height instead of height */
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .error-container {
            text-align: center;
            padding: 40px;
            max-width: 600px; /* Optional: Limit width on large screens */
            width: 90%;      /* Optional: Make container responsive */
        }
        .error-code {
            font-size: 120px;
            color: #2cc946;
            margin: 0;
            font-weight: bold;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        }
        .error-message {
            font-size: 24px;
            color: #2c3e50;
            margin: 20px 0;
        }

        /* --- Search Box Styles Start --- */
        .search-form-container {
             margin-top: 30px;
             margin-bottom: 30px; /* Added more space before home button */
        }
        .search-form-container p {
            margin-bottom: 15px; /* Increased space below paragraph */
            color: #555;
            font-size: 16px; /* Slightly larger text */
        }
         .search-form {
            display: flex; /* Align input and button */
            justify-content: center; /* Center the form elements */
            align-items: center; /* Vertically align items */
            gap: 8px; /* Space between input and button */
            flex-wrap: wrap; /* Allow wrapping on small screens */
        }

        .search-input {
            padding: 12px 18px; /* Adjusted padding */
            border-radius: 25px;
            border: 1px solid #ccc;
            /* width: 70%; Replaced with flex-grow */
            flex-grow: 1; /* Allow input to take available space */
            max-width: 350px;
            font-size: 16px; /* Match paragraph font size */
            min-width: 200px; /* Ensure minimum width */
        }

        .search-button {
            padding: 12px 25px; /* Adjusted padding */
            background: #2cc946;
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            transition: background 0.3s;
            font-size: 16px; /* Match input font size */
        }
         .search-button:hover {
             background: #209c34;
        }
        /* --- Search Box Styles End --- */

        .back-home {
            display: inline-block;
            padding: 12px 30px;
            background: #2cc946;
            color: white;
            text-decoration: none;
            border-radius: 25px;
            transition: background 0.3s;
            font-size: 16px; /* Consistent font size */
        }
        .back-home:hover {
            background: #209c34;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <h1 class="error-code">404</h1>
        <p class="error-message">Oops! The page you're looking for doesn't exist.</p>

        
        <div class="search-form-container">
            <p>Can't find the page? Try searching the site:</p>
            <form action="https://getmodsapk.com/search" method="GET" class="search-form">
                

                <input type="search"
                       name="query"  
                       placeholder="Search here..."
                       class="search-input"
                       required>

                <button type="submit" class="search-button">
                    Search
                </button>
            </form>
        </div>
        

        
        <a href="https://getmodsapk.com" class="back-home">Back to Home</a>
    </div>
</body>
</html>