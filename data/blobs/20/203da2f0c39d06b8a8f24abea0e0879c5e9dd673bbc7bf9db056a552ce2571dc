<script>
  var __gbRevealed = false;
  var __gbRevealTimer = null;

  function reveal() {
    if (__gbRevealed) return;

    __gbRevealed = true;

    if (__gbRevealTimer) {
      clearTimeout(__gbRevealTimer);
    }

    document.documentElement.classList.remove('gb-hide');
  }

  function scheduleReveal(delay) {
    if (__gbRevealed) return;

    if (__gbRevealTimer) {
      clearTimeout(__gbRevealTimer);
    }

    __gbRevealTimer = setTimeout(function() {
      reveal();
    }, delay);
  }

  function getLS(key) {
    try {
      var raw = localStorage.getItem(key);

      if (raw === null) return null;

      /*
       * Segment (and our own setLS calls) store values as
       * JSON, e.g. a bare id is stored as '"4b054cfc-..."'.
       * Parse it back out so callers get a clean value
       * instead of a quoted string that hashes differently
       * than the same id read from a cookie.
       */
      try {
        return JSON.parse(raw);
      } catch (e) {
        return raw;
      }
    } catch (e) {
      return null;
    }
  }

  function setLS(key, value) {
    try {
      localStorage.setItem(key, value);
    } catch (e) {}
  }

  function removeLS(key) {
    try {
      localStorage.removeItem(key);
    } catch (e) {}
  }

  function gbRecordEvent(eventParams) {
    waitForAnalytics(function() {
      if (
        window.analytics &&
        typeof window.analytics.track === 'function'
      ) {
        window.analytics.track(
          'Experiment Viewed',
          eventParams
        );
      }
    });
  }

  (function() {
    /*
     * getLS now JSON.parses automatically, so this is
     * already an object (or null) -- do NOT JSON.parse it
     * again here.
     */
    var gbtls = getLS('gbtls');

    if (!gbtls) return;

    if (
      gbtls.event &&
      gbtls.date &&
      new Date().getTime() - gbtls.date < 60000
    ) {
      gbRecordEvent(
        gbtls.event
      );
    }

    removeLS('gbtls');
  })();

  window.growthbook_queue =
    window.growthbook_queue || [];

  /*
   * GrowthBook has finished loading experiment data.
   *
   * Do NOT reveal immediately.
   * Give URL redirect experiments a short window
   * to navigate away first.
   */
  document.addEventListener(
    'growthbookdata',
    function() {
      scheduleReveal(150);
    }
  );

  /*
   * Safety fallback.
   *
   * If GrowthBook fails or is blocked,
   * never leave the visitor staring at
   * a permanently hidden page.
   */
  scheduleReveal(1500);

  function getCookie(name) {
    const match = document.cookie.match(
      new RegExp(
        '(^| )' + name + '=([^;]+)'
      )
    );

    return match
      ? decodeURIComponent(match[2])
      : null;
  }

  function loadGrowthBookScript() {
    var script =
      document.createElement('script');

    script.async = true;

    script.src =
      'https://cdn.jsdelivr.net/npm/@growthbook/growthbook/dist/bundles/auto.min.js';

    script.setAttribute(
      'data-api-host',
      'https://cdn.growthbook.io'
    );

    script.setAttribute(
      'data-client-key',
      'sdk-xEb0AZIn228345Oj'
    );

    document.head.appendChild(script);
  }

  function generateUUID() {
    var d = new Date().getTime();

    var d2 =
      (
        typeof performance !== 'undefined' &&
        performance.now &&
        performance.now() * 1000
      ) || 0;

    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'
      .replace(
        /[xy]/g,
        function(c) {
          var r =
            Math.random() * 16;

          if (d > 0) {
            r =
              (d + r) % 16 | 0;

            d =
              Math.floor(d / 16);
          } else {
            r =
              (d2 + r) % 16 | 0;

            d2 =
              Math.floor(d2 / 16);
          }

          return (
            c === 'x'
              ? r
              : (r & 0x3) | 0x8
          ).toString(16);
        }
      );
  }

  function configGrowthbookWithIdInWindow(
    anonymousId
  ) {
    window.growthbook_config =
      window.growthbook_config || {};

    window.growthbook_config.attributes = {
      anonymousId: anonymousId
    };

    window.growthbook_config.trackingCallback =
      function(
        experiment,
        result
      ) {
        var eventParams = {
          experiment_id: experiment.key,
          variation_id: result.key,
          variation_name:
            result.name || result.key
        };

        gbRecordEvent(
          eventParams
        );

        /*
         * Preserve exposure data across
         * GrowthBook URL redirects.
         */
        if (
          result.inExperiment &&
          'urlPatterns' in experiment
        ) {
          setLS(
            'gbtls',
            JSON.stringify({
              ref: window.location.href,
              date: new Date().getTime(),
              event: eventParams
            })
          );
        }
      };
  }

  function waitForAnalytics(
    callback,
    timeout = 5000,
    interval = 100
  ) {
    const startTime =
      new Date().getTime();

    const check = () => {
      if (
        window.analytics &&
        typeof window.analytics.user ===
          'function'
      ) {
        callback();
      } else if (
        new Date().getTime() -
          startTime <
          timeout
      ) {
        setTimeout(
          check,
          interval
        );
      } else {
        callback();
      }
    };

    check();
  }

  function proceedWithInitialization(
    anonymousId
  ) {
    configGrowthbookWithIdInWindow(
      anonymousId
    );

    loadGrowthBookScript();
  }

  var anonymousId =
    getCookie('ajs_anonymous_id') ||
    getLS('ajs_anonymous_id');

  if (anonymousId) {
    proceedWithInitialization(
      anonymousId
    );
  } else {
    if (
      window.analytics &&
      typeof window.analytics.user ===
        'function'
    ) {
      anonymousId =
        window.analytics
          .user()
          .anonymousId();

      proceedWithInitialization(
        anonymousId
      );
    } else {
      waitForAnalytics(function() {
        anonymousId =
          window.analytics &&
          typeof window.analytics.user ===
            'function'
            ? window.analytics
                .user()
                .anonymousId()
            : null;

        if (!anonymousId) {
          anonymousId =
            generateUUID();

          if (
            window.analytics &&
            typeof window.analytics.user ===
              'function'
          ) {
            window.analytics
              .user()
              .anonymousId(
                anonymousId
              );
          }
        }

        proceedWithInitialization(
          anonymousId
        );
      });
    }
  }
