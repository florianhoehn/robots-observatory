		<script>
			function agregarAccionDelegables(...acciones)
			{
				acciones.forEach(function (accion)
				{
					// Ejecuta la acción cuando se haya cargado todo, para esperar recursos externos
					document.addEventListener('DOMContentLoaded', function() 
					{
						window[accion]();
					});

					// Ejecuta la acción de inmediato si se está manipulando (inyectando) el DOM
					if (document.readyState === 'complete' || document.readyState === 'loaded')
						window[accion]();
				});
			}
		</script>
			
<script defer>
document.addEventListener('DOMContentLoaded', function () 
{ 
	var svginjectopts = {
		beforeInject: function(img, svg)
		{
			$(img).fadeOut('fast');
		},
		afterInject: function(img, svg) 
		{
			svg.classList.remove('accesible');
			if(svg.closest('.adjunto') !== null)
				svg.setAttribute('preserveAspectRatio', 'xMidYMid slice');

			// Eliminar sufijos en enlaces a anclas con hash:
			const links = svg.querySelectorAll('[href], [xlink\\:href]');
			links.forEach(link => {
				const href = link.getAttribute('href') || link.getAttribute('xlink\\:href');						
				if (href && href.startsWith('#') && href.includes('--inject-')) 
				{
					const cleanHref = href.replace(/--inject-\d+/, '');
					if (link.hasAttribute('href')) {
						link.setAttribute('href', cleanHref);
					} else if (link.hasAttribute('xlink\\:href')) {
						link.setAttribute('xlink\\:href', cleanHref);
					}
				}
			});
		},
		onFail: function(img) 
		{
			img.classList.remove('accesible');
		}
	};
	SVGInject.setOptions(svginjectopts);	
    SVGInject(document.querySelectorAll(':not(.ignore-ids) > img.inject'));
	svginjectopts.makeIdsUnique = false;
	SVGInject(document.querySelectorAll('.ignore-ids > img.inject'), svginjectopts);
});
</script>
