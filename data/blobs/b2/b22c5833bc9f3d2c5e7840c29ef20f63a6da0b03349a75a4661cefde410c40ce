    <meta itemprop="name" content="Printerval - Shop For Handmade, Vintage, Clothes And Unique Gifts For Everyone">
    <meta itemprop="description" content="Find the perfect handmade gift, vintage &amp; on-trend clothes, unique decor home &amp; living and more on Printerval.com">
    <meta itemprop="image" content="https://assets.printerval.com/2025/11/27/printerval-logo-cb27ae8fff7bb5806b168cb7be47160b.svg">
    <meta property="og:url" content="https://printerval.com" />
    <title>Printerval.com - T-Shirts Starting at $14 Featuring Your Favorite TV Shows, Movies, Comics, and More</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: white;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            padding: 20px;
        }

        .header {
            text-align: center;
            padding: 20px 0 40px;
        }

        .header img {
            max-width: 200px;
            height: auto;
        }

        .error-container {
            background: white;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
            border: 1px solid #e2e8f0;
            max-width: 600px;
            width: 100%;
            padding: 30px 40px;
            text-align: center;
            margin: 0 auto;
        }

        .status-code {
            font-size: 30px;
            font-weight: 800;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1;
            margin-bottom: 16px;
        }

        .error-message {
            font-size: 24px;
            font-weight: 600;
            color: #1a202c;
            margin-bottom: 12px;
        }

        .error-description {
            font-size: 16px;
            color: #718096;
            margin-bottom: 32px;
            line-height: 1.6;
        }

        .divider {
            height: 1px;
            background: #e2e8f0;
            margin: 32px 0;
        }

        .form-section h3 {
            font-size: 18px;
            color: #2d3748;
            margin-bottom: 8px;
            text-align: left;
        }

        .form-section p {
            font-size: 14px;
            color: #718096;
            margin-bottom: 16px;
            text-align: left;
        }

        .form-group {
            margin-bottom: 20px;
        }

        textarea {
            width: 100%;
            min-height: 120px;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-family: inherit;
            font-size: 14px;
            color: #2d3748;
            resize: vertical;
            transition: border-color 0.3s ease;
        }

        textarea:focus {
            outline: none;
            border-color: #667eea;
        }

        textarea::placeholder {
            color: #a0aec0;
        }

        .btn-send {
            width: 100%;
            padding: 14px 24px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-send:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        .btn-send:active {
            transform: translateY(0);
        }

        .more-info {
          margin: 5px 0;
          color: #718096;
        }

        .footer {
            text-align: center;
            padding: 40px 20px 20px;
            margin-top: auto;
            font-size: 14px;
        }

        @media (max-width: 640px) {
            .error-container {
                padding: 32px 24px;
            }

            .status-code {
                font-size: 20px;
            }

            .error-message {
                font-size: 20px;
            }

            .error-description {
                font-size: 14px;
            }

            .header img {
                max-width: 150px;
            }
        }
    </style>
</head>
<body>
    <header class="header">
        <a href="https://printerval.com">
          <img src="data:image/svg+xml;base64," alt="Printerval">
        </a>
    </header>

    <div class="error-container">
        <div class="status-code">403</div>
        <p class="error-description">
          Sorry, you have been blocked from this page
        </p>

        <div class="divider"></div>

        <div class="form-section">
          <h3>Report an Issue</h3>
          <p>Let us know if something isn&#039;t working as expected.</p>
          
          <form id="report-form" action="https://docs.google.com/forms/d/e/1FAIpQLSf7WJNlOtfbnAtHrftY0AgXJntBlurRQ3q8vh9bb5zV-8EVuA/formResponse" method="POST">
            <div class="form-group">
              <textarea name="entry.1364683183" id="form-description" placeholder="Describe the problem you encountered..." required></textarea>
            </div>
            <input type="hidden" name="entry.800499534" id="form-url" />
            <input type="hidden" name="entry.167366317" id="form-ip" />
            <input type="hidden" name="entry.448853376" id="form-ray-id" />
            <input type="hidden" name="entry.199193931" id="form-country" />
            
            <button type="submit" class="btn-send">Send Report</button>
            <p id="message" style="margin: 10px 0; visibility: hidden"></p>
          </form>
        </div>
    </div>

    <footer class="footer">
        <p class="more-info">Ray ID: <span id="ray-id">a4d240b71b1db331</span> | Client IP: <span id="client-ip">82.39.15.43</span><p>
        <p class="more-info">Country: <span id="country">GB</span><p>
        <p style="margin-top: 15px">&copy; <span id="copyright-year"></span> Printerval. All rights reserved.</p>
    </footer>

    <script>
      document.getElementById("copyright-year").innerHTML = new Date().getFullYear();
      var messageElement = document.getElementById('message');
      var btnSend = document.querySelector('.btn-send');

      document.getElementById('report-form').addEventListener('submit', function(e) {
        e.preventDefault();

        btnSend.disabled = true;
        const textarea = e.target.querySelector('textarea');

        document.getElementById('form-url').value = window.location.href;
        document.getElementById('form-ip').value = document.getElementById('client-ip').innerText;
        document.getElementById('form-ray-id').value = document.getElementById('ray-id').innerText;
        document.getElementById('form-country').value = document.getElementById('country').innerText;

        fetch(this.action, { method: 'POST', body: new FormData(this) }).then(() => {
          
        }).catch(() => {
            
        }).finally(() => {
          messageElement.innerText = "Thank you for your feedback! We will look into this issue.";
          messageElement.style.visibility = 'visible';
          messageElement.style.color = 'green'; 
          document.getElementById('form-description').value = '';
        });
      });
    </script>
</html>
