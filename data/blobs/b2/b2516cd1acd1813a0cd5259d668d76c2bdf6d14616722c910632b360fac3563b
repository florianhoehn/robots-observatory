<head>
    <title>Error</title>
    <meta name="viewport" content="width=device-width">
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: "Helvetica Neue";
            margin: 0;
        }

        .page-container {
            width: 100%;
            margin: 0 auto;
            padding: 0 15px;
        }

        @media (min-width: 768px) {
            .page-container {
                max-width: 720px;
            }
        }

        @media (min-width: 992px) {
            .page-container {
                max-width: 960px;
            }
        }

        @media (min-width: 1200px) {
            .page-container {
                max-width: 1140px;
            }
        }

        .page-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }

        .side-column {
            display: none;
        }

        .main-column {
            width: 100%;
        }

        @media (min-width: 768px) {
            .side-column {
                display: block;
                width: 33.3333%;
            }

            .main-column {
                width: 66.6667%;
            }
        }

        @media (min-width: 1200px) {
            .main-column {
                width: 50%;
            }
        }

        * {
            line-height: calc(1em + 4px);
        }

        .black {
            color: #000000;
        }

        .muted {
            color: #797c82;
        }

        .logo {
            height: 28px;
            width: 148px;
            margin-top: 32px;
            margin-bottom: 64px;
        }

        @media (min-width: 992px) {
            .logo {
                height: 37px;
                width: 195.57px;
                margin-top: 0;
            }
        }

        .title-1-center {
            font-size: 32px;
            margin-bottom: 8px;
            font-weight: bold;
            letter-spacing: -1px;
        }

        @media (min-width: 992px) {
            .title-1-center {
                font-size: 64px;
                margin-bottom: 16px;
            }
        }

        .title-2-center {
            font-size: 20px;
            margin-bottom: 16px;
            font-weight: bold;
            letter-spacing: -0.5px;
        }

        @media (min-width: 992px) {
            .title-2-center {
                font-size: 40px;
            }
        }

        .regular-1-center {
            font-size: 18px;
            margin-bottom: 32px;
        }

        .regular-2-center {
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 24px;
        }

        .download-logos {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        @media (min-width: 992px) {
            .download-logos {
                margin-bottom: 40px;
            }
        }

        .appstore-logo img {
            max-width: 100%;
            margin-top: 16px;
        }

        .hide-on-xs {
            display: none;
        }

        @media (min-width: 576px) {
            .hide-on-xs {
                display: inline-block;
            }
        }

        @media (min-width: 768px) {
            .appstore-logo img {
                width: 145px;
            }
        }

        @media (min-width: 992px) {
            .appstore-logo img {
                width: auto;
            }
        }

        .mobile-phone {
            background-image: url("/portal/public/images/notfound/Phone_Mobile.jpg");
            background-position-y: 0;
            background-position-x: calc(100% - 10px);
            background-repeat: no-repeat;
            background-size: contain;
        }

        .content-column {
            width: 66.6667%;
        }

        @media (min-width: 768px) {
            .content-column {
                width: 100%;
            }
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        a:hover {
            color: inherit;
            text-decoration: underline;
        }

        @media (min-width: 768px) {
            .mobile-phone {
                background-image: none;
            }
        }

        .desktop-phone {
            background-image: url("/portal/public/images/notfound/Phone_Desktop_Tall.jpg");
            background-position-x: 100%;
            background-repeat: no-repeat;
            background-size: cover;
            background-position-y: 100%;
            height: 590px;
        }

        @media (min-width: 992px) {
            .desktop-phone {
                background-image: url("/portal/public/images/notfound/Phone_Desktop_Med.jpg");
                height: 659px;
                max-height: 100%;
                background-position-y: 0;
                background-size: contain;
            }
        }

        @media (min-width: 1200px) {
            .desktop-phone {
                background-image: url("/portal/public/images/notfound/Phone_Desktop.jpg");
            }
        }

        .reload {
            color: #8149f8;
            display: inline-block;
            margin-bottom: 24px;
        }

        .reload:hover {
            text-decoration: none;
        }

        .debug-details {
            margin-top: 16px;
            border-radius: 8px;
            padding: 16px;
            background: #f8f9fb;
            font-family: Menlo, Consolas, monospace;
            font-size: 12px;
            text-align: left;
            max-height: 300px;
            overflow: auto;
            white-space: pre-wrap;
            word-break: break-word;
        }
    </style>
</head>

<body>
    
    <div class="page-container">
        <div class="page-row">
            <div class="side-column desktop-phone"></div>
            <div class="main-column">
                <div class="mobile-phone">
                    <div class="content-column">
                        <a href="/"><img class="logo" src="/portal/public/images/logo-purple.svg"></a>
                        <h1 class="title-1-center black">Oops!</h1>
                        <h2 class="title-2-center black">Your call could not be completed as dialed.</h2>
                        <p class="regular-1-center muted">This page no longer exists or the wrong URL was entered.</p>
                        <p class="regular-2-center black">Get Free Texting & Calling to USA & Canada</p>
                        <a href="/" class="reload">Go to Home</a>
                        
                        <div class="download-logos">
                            <a href="https://app.adjust.com/11esyz?campaign=404_error" class="appstore-logo">
                                <img src="/portal/public/images/app-store-apple.png" srcset="/portal/public/images/app-store-apple@2x.png 2x" />
                            </a>&nbsp;
                            <a href="https://app.adjust.com/2xmk36?campaign=404_error" class="appstore-logo">
                                <img src="/portal/public/images/app-store-google.png" srcset="/portal/public/images/app-store-google@2x.png 2x" />
                            </a>&nbsp;
                            <a href="https://www.microsoft.com/en-us/store/p/textnow-unlimited-texts-calls/9n43spjlcxcv" class="hide-on-xs appstore-logo">
                                <img src="/portal/public/images/app-store-windows.png" srcset="/portal/public/images/app-store-windows@2x.png 2x" />
                            </a>
                        </div>
                        <p class="muted">
                            <a href="/wireless">Shop Wireless</a> |
                            <a href="/download">Free Downloads</a> |
                            <a href="/about-us">Company Info</a> |
                            <a href="/accounts/support">Need Help?</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
