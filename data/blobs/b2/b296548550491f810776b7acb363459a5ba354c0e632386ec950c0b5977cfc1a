<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RTBWise - Turn Every Impression into Measurable Revenue</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="shortcut icon" href="./favicon.ico" type="image/x-icon">
    <style>
        :root {
            --primary-color: #fff;
            --primary-hover-color: #fff;
            --primary-dark: #1d4ed8;
            --secondary-color: #64748b;
            --light-color: transparent;
            --dark-color: #1e293b;
            --accent-color: #3b82f6;
            --primary-btn-color: #06ff7bfd;
            --primary-btn-font-color: #080808;
            --border-radius: 8px;
            --border-btn-radius: 100px;
            --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            --transition: all 0.3s ease;
            --primary-font-size: 18px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .home-container {
            line-height: 1.6;
            color: var(--primary-color);
            font-family: "Poppins", sans-serif;
            background-color: var(--primary-color);
            background-image: url("./images/pc-fill.jpg");
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center center;
        }

        .container {
            width: 100%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 0 20px;
            border-bottom: 1px solid transparent;
        }

        /* Header */
        header {
            background-color: transparent;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 10px;
        }

        .logo {
            display: flex;
            align-items: center;
            font-weight: 700;
            font-size: 1.5rem;
            color: var(--primary-color);
            text-decoration: none;
        }

        .logo img {
            width: 230px;
            height: 80px;
            object-fit: contain;
        }

        .navbr-right {
            display: flex;
            align-items: center;
            justify-content: space-between;
            min-width: 600px;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 58px;
        }

        .nav-links a {
            font-size: var(--primary-font-size);
            text-decoration: none;
            color: var(--primary-color);
            font-weight: 500;
            transition: var(--transition);
            position: relative;
        }

        .nav-links a:hover {
            color: var(--primary-hover-color);
        }

        .nav-links a.active {
            color: var(--primary-color);
            font-weight: bold;
        }

        .learn-more-btn {
            background-color: var(--primary-btn-color);
            color: var(--primary-btn-font-color);
            padding: 10px 20px;
            border-radius: var(--border-btn-radius);
            text-decoration: none;
            font-size: var(--primary-font-size);
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        .hero {
            border: 1px solid transparent;
            margin-top: 128px;
        }

        .hero-content {
            max-width: 800px;
        }

        .hero-content .hero-content-title {
            font-size: 3rem;
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .hero-content-title-tag {
            color: var(--primary-btn-color);
        }

        .hero-content p {
            font-size: 1.5rem;
            margin-bottom: 4.8rem;
            font-weight: 400;
        }

        .btn {
            display: inline-block;
            width: 300px;
            height: 60px;
            background-color: var(--primary-btn-color);
            color: var(--primary-btn-font-color);
            border-radius: var(--border-btn-radius);
            text-align: center;
            text-decoration: none;
            font-size: 24px;
            line-height: 60px;
            font-weight: 500;
            transition: var(--transition);
            border: none;
            cursor: pointer;
        }

        /* Advertisers Section */
        .advertisers-section {
            padding: 150px 0;
        }

        .advertisers-section .container {
            max-width: 1150px;
        }

        .section-title {
            margin-bottom: 4rem;
        }

        .advertisers-section-title {
            text-align: center;
        }

        h2 {
            font-size: 3rem;
            color: var(--primary-color);
            margin-bottom: 2rem;
        }

        .section-subtitle {
            color: var(--primary-color);
            font-size: var(--primary-font-size);
            font-weight: 400;
            max-width: 600px;
            margin-bottom: 50px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
        }

        .feature-card {
            background-color: #ffffffba;
            color: #1f1f1ffd;
            padding: 20px 25px;
            text-align: left;
            box-shadow: var(--box-shadow);
            transition: var(--transition);
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.1);
        }

        .feature-icon {
            color: var(--dark-color);
            margin-bottom: .5rem;
        }

        .feature-icon img {
            width: 45px;
            height: 42px;
            object-fit: contain;
        }

        .feature-card h3 {
            font-size: 1.5rem;
            line-height: 1.4;
            margin-bottom: .5rem;
            color: var(--dark-color);
        }

        /* Why RTBWise Section */
        .why-section {
            background-color: var(--light-color);
            color: white;
            text-align: center;
            margin-bottom: 120px;
        }

        .why-section h2 {
            color: white;
        }

        .why-section .section-subtitle {
            color: rgba(255, 255, 255, 0.99);
        }

        .why-section-title {
            text-align: left;
        }

        .industries {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
            margin: 2rem 0;
        }

        .industry-tag {
            background-color: rgba(255, 255, 255, 0.2);
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 500;
        }

        .contact-us-btn {
            background-image: linear-gradient(-180deg, #1afda7 0%, #167140 100%);
        }

        /* 弹窗样式 */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1000;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            background: white;
            border-radius: 15px;
            width: 90%;
            max-width: 400px;
            padding: 10px 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            transform: translateY(20px);
            transition: transform 0.4s ease;
        }

        .modal-overlay.active .modal {
            transform: translateY(0);
        }

        .modal-header {
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
        }

        .modal-title {
            font-size: 1rem;
            font-weight: 400;
            color: var(--dark-color);
            margin: 0;
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 2rem;
            cursor: pointer;
            color: #999;
            transition: color 0.3s;
            position: absolute;
            right: 10px;
            top: -10px;
        }

        .close-btn:hover {
            color: #333;
        }

        .contact-info {
            border-radius: 10px;
            margin: 20px 0;
        }

        .contact-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-direction: column;
            gap: 15px;
            margin-bottom: 15px;
            padding-bottom: 15px;
            border-bottom: 1px solid #e9ecef;
        }

        .contact-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .contact-value {
            color: var(--dark-color);
            font-size: 18px;
            font-weight: bold;
        }

        .copy-btn {
            width: 100%;
            background: #3abc7b;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1rem;
            transition: background 0.3s;
        }

        .copy-btn.copied {
            background: #126f4b;
        }

        .modal-footer {
            text-align: center;
            margin-top: 20px;
            color: #6c757d;
            font-size: 0.9rem;
        }

        footer {
            text-align: left;
            padding: 20px;
            margin-top: auto;
        }

        .footer-section .container {
            border-top: 1px solid #797979;
            max-width: 1200px;
        }

        .footer-section .footer-section-container {
            text-align: center;
            font-size: 12px;
            margin-top: 1rem;
            color: #b2b2b2;
        }

        .footer-section a {
            display: inline-block;
            color: #b2b2b2;
            font-weight: 500;
            text-decoration: none;
            line-height: 32px;
        }

        /* 图片预加载提示 */
        .loading-screen {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: var(--dark-color);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            transition: opacity 0.5s ease;
        }

        .loading-screen.fade-out {
            opacity: 0;
            pointer-events: none;
        }

        /* 针对超宽屏幕的优化 */
        @media (min-width: 2000px) {
            .home-container {
                background-size: 100% auto;
            }
        }

        /* 针对超高屏幕的优化 */
        @media (min-height: 1200px) {
            .home-container {
                background-size: auto 100%;
            }
        }

        /* 平板设备优化 */
        @media (min-width: 769px) and (max-width: 1024px) {
            .home-container {
                background-image: url("./images/pc-fill.jpg");
                /* 或使用专门为平板优化的图片 */
                background-size: cover;
            }

            .navbar {
                justify-content: left;
            }

            .navbr-right {
                display: none;
            }
        }

        /* Responsive */
        @media (max-width: 768px) {
            .home-container {
                background-image: url("./images/mb-fill.jpg");
            }

            .navbar {
                justify-content: left;
                padding-top: 10px;
            }

            .navbar .logo img {
                height: 70px;
            }

            .navbr-right {
                display: none;
            }

            .nav-links {
                position: fixed;
                top: 70px;
                left: 0;
                width: 100%;
                background-color: white;
                flex-direction: column;
                align-items: center;
                padding: 20px 0;
                box-shadow: 0 5px 10px rgba(0, 0, 0, 0.1);
                transform: translateY(-150%);
                transition: transform 0.4s ease;
            }

            .nav-links.active {
                transform: translateY(0);
            }

            .nav-links li {
                margin: 15px 0;
            }

            h1 {
                font-size: 2.2rem;
            }

            h2 {
                font-size: 1.8rem;
            }

            .section {
                padding: 24px 0;
            }

            header .container {
                margin-top: 0;
            }

            .container {
                margin: 50px auto;
                text-align: center;
            }

            .hero {
                margin-top: 24px;
            }

            .hero-content .hero-content-title {
                font-size: 1.7rem;
                margin-bottom: 1rem;
            }

            .hero-content p {
                font-size: 1rem;
                margin-bottom: 1.5rem;
            }

            .hero-content .btn {
                width: 240px;
                height: 48px;
                line-height: 48px;
            }

            .advertisers-section-title {
                margin-bottom: 1.5rem;
            }

            .feature-card {
                text-align: center;
                padding: 20px 15px;
            }

            .why-section {
                margin-bottom: 300px;
            }

            .why-section-title {
                text-align: center;
            }

            .why-section-title h2 {
                margin-bottom: 1.3rem;
            }

            .section-subtitle {
                margin-bottom: 40px;
            }

            .contact-us-btn {
                width: 208px;
                height: 48px;
                line-height: 48px;
                font-size: 20px;
            }

            .modal {
                width: 95%;
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <div class="home-container">
        <div class="loading-screen"></div>
        <!-- Header Navigation -->
        <header>
            <div class="container">
                <nav class="navbar">
                    <a href="#" class="logo">
                        <img src="./images/logo.png" alt="">
                    </a>
    
                    <div class="navbr-right">
                        <ul class="nav-links">
                            <li><a href="#section1" class="nav-link active">About</a></li>
                            <li><a href="#section2" class="nav-link">Advertisers</a></li>
                            <li><a href="#section3" class="nav-link">Contact Us</a></li>
                        </ul>
    
                        <a href="#section2" class="learn-more-btn">Learn more</a>
                    </div>
                </nav>
            </div>
        </header>
    
        <!-- Hero Section -->
        <section id="section1" class="hero">
            <div class="container">
                <div class="hero-content">
                    <div class="hero-content-title">
                        Turn Every Impression into <br> <span class="hero-content-title-tag">Measurable Revenue</span>
                    </div>
                    <p>Powered by advanced machine learning, our intelligent DSP optimizes every impression in real
                        time — helping your brand reach the right audience, increase conversions, and maximize ROI.</p>
                    <a href="#section2" class="btn">Learn More</a>
                </div>
            </div>
        </section>
    
        <!-- Advertisers Section -->
        <section class="section advertisers-section">
            <div class="container">
                <div class="section-title advertisers-section-title" id="section2">
                    <h2>Advertisers</h2>
                </div>
                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-1.svg" alt="">
                        </div>
                        <h3>Smart Bidding Engine</h3>
                        <p>
                            Powered by adaptive machine learning,
                            RTBWise optimizes bids in real time to drive
                            maximum ROI from every impression.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-2.svg" alt="">
                        </div>
                        <h3>
                            AI Audience Intelligence</h3>
                        <p>
                            Uses deep learning to analyze consumer
                            behavior and automatically identify your
                            highest-value audiences — delivering
                            precision targeting at scale.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-3.svg" alt="">
                        </div>
                        <h3>
                            Brand Safety</h3>
                        <p>
                            Your reputation matters. Our safety layer
                            ensures ads appear only in trusted,
                            contextually relevant environments.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-4.svg" alt="">
                        </div>
                        <h3>
                            Expert in Native Advertising</h3>
                        <p>
                            Seamlessly integrate your brand stories
                            into user experiences. Enhancing
                            engagement and conversion rates through
                            authentic, non-intrusive placements.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-5.svg" alt="">
                        </div>
                        <h3>
                            Click Fraud Filters</h3>
                        <p>
                            Ensure every click counts. Our advanced
                            fraud detection system automatically
                            filters invalid traffic and malicious activity,
                            safeguarding your budget and data
                            integrity.</p>
                    </div>
                    <div class="feature-card">
                        <div class="feature-icon">
                            <img src="./images/feature-icon-6.svg" alt="">
                        </div>
                        <h3>
                            Global Reach</h3>
                        <p>
                            Activate campaigns across international
                            markets with localized optimization,
                            ensuring your message resonates
                            wherever your audience is.</p>
                    </div>
                </div>
            </div>
        </section>
    
        <!-- Why RTBWise Section -->
        <section id="section3" class="section why-section">
            <div class="container">
                <div class="section-title why-section-title">
                    <h2>Why RTBWise?</h2>
                    <p class="section-subtitle">
                        RTBWise is designed for <strong>vertical e-commerce</strong>. Whether you sell
                        fashion, beauty, electronics, or lifestyle products, RTBWise's
                        domain-trained AI understands your market dynamics — and your
                        customers.</p>
                    <a href="#" class="btn contact-us-btn" id="openModalBtn">Contact Us</a>
                </div>
            </div>
        </section>

        <footer class="footer-section">
            <div class="container">
                <div class="footer-section-container">
                    Copyright @2026 RTBWise. All rights reserved. 
                    <a href="./privacy-policy.html">Privacy Policy</a>
                </div>
            </div>
        </footer>
    </div>


    <!-- 弹窗 -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal">
            <div class="modal-header">
                <h3 class="modal-title">Contact Us</h3>
                <button class="close-btn" id="closeModalBtn">&times;</button>
            </div>

            <div class="contact-info">
                <div class="contact-item">
                    <span class="contact-value" id="emailValue">contact@rtbwise.com</span>
                    <button class="copy-btn" data-copy="contact@rtbwise.com">Copy Email Address</button>
                </div>
            </div>

            <div class="modal-footer">
                <p>We look forward to cooperating with you!</p>
            </div>
        </div>
    </div>

    <script>
        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                if (targetId === '#') return;

                if (e.target.classList.contains('nav-link')) {
                    document.querySelectorAll('.nav-link').forEach(ele => {
                        ele.classList.remove('active');
                    })
                    e.target.classList.add('active');
                }

                const targetElement = document.querySelector(targetId);
                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 80,
                        behavior: 'smooth'
                    });
                }
            });
        });

        // 获取DOM元素
        const openModalBtn = document.getElementById('openModalBtn');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalOverlay = document.getElementById('modalOverlay');
        const copyBtns = document.querySelectorAll('.copy-btn');

        // 打开弹窗
        openModalBtn.addEventListener('click', () => {
            modalOverlay.classList.add('active');
        });

        // 关闭弹窗
        closeModalBtn.addEventListener('click', () => {
            modalOverlay.classList.remove('active');
        });

        // 点击弹窗外部关闭
        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) {
                modalOverlay.classList.remove('active');
            }
        });

        // 复制功能
        copyBtns.forEach(btn => {
            btn.addEventListener('click', async () => {
                const textToCopy = btn.getAttribute('data-copy');

                try {
                    await navigator.clipboard.writeText(textToCopy);

                    // 显示复制成功状态
                    const originalText = btn.textContent;
                    btn.textContent = 'Copied Email Address!';
                    btn.classList.add('copied');

                    // 2秒后恢复原始状态
                    setTimeout(() => {
                        btn.textContent = originalText;
                        btn.classList.remove('copied');
                    }, 2000);
                } catch (err) {
                    console.error('Copying Email Address failed:', err);
                    alert('Copying Email Address failed, please copy manually.');
                }
            });
        });

        // 在现有脚本中添加
        window.addEventListener('load', function () {
            // 确保背景图片已加载
            const bgImage = new Image();
            bgImage.src = window.innerWidth <= 768 ? "./images/mb-fill.jpg" : "./images/pc-fill.jpg";

            bgImage.onload = function () {
                // 图片加载完成后，淡出加载屏幕（如果有）
                const loadingScreen = document.querySelector('.loading-screen');
                if (loadingScreen) {
                    loadingScreen.classList.add('fade-out');
                    setTimeout(() => {
                        loadingScreen.remove();
                    }, 500);
                }
            };

            // 如果图片加载失败，使用备用背景
            bgImage.onerror = function () {
                document.querySelector('.home-container').style.backgroundImage = 'none';
            };
        });

        // 窗口大小改变时切换背景图片
        window.addEventListener('resize', function () {
            const isMobile = window.innerWidth <= 768;
            document.querySelector('.home-container').style.backgroundImage = `url("${isMobile ? './images/mb-fill.jpg' : './images/pc-fill.jpg'}")`;
        });
    </script>
</body>

</html>