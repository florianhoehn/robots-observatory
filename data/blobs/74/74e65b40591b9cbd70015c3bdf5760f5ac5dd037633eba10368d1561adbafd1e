<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Not Found | BUNKR</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="icon" href="/images/fav.ico" type="image/x-icon">
    <style>
        .divider:before,
        .divider:after {
            content: "";
            display: block;
            width: 100%;
            height: 1px;
            background-color: #8F2AA3;
        }
        .btn-bunkr-blue {
            background-color: transparent;
            border: 1px solid #7c3aed;
            color: #7c3aed;
            font-weight: bold;
        }
        .btn-bunkr-blue:hover {
            border-color: #7c3aed;
            color: #7c3aed;
        }
    </style>
</head>
<body class="bg-[#10151d] text-white">
<section class="flex flex-col justify-center items-center h-screen text-center">
    <div class="mb-6">
        <h1 class="text-3xl font-bold">Resource not found</h1>
        <p class="text-base text-gray-400 mt-4">
            The requested page has been removed by the original uploader <br/>
            or has been removed by an Admin.
        </p>
    </div>
    <div class="relative my-10 w-full max-w-3xl">
        <div class="divider"></div>
        <h2 class="absolute inset-0 text-center text-lg font-light text-gray-400 bg-[#10151d] px-4">
            Check for archived or cached versions online
        </h2>
    </div>
    <div class="container">
        <div class="flex justify-center space-x-4 mt-6"> 
            <button class="btn-bunkr-blue px-4 py-2 text-sm rounded w-32 hover:bg-transparent"
                    onclick="window.open(`https://web.archive.org/web/${window.location.href}`, '_blank', 'noreferrer, noopener')"
                    title="The Wayback Machine is a digital archive of the World Wide Web, founded by the Internet Archive">
                Archive.org
            </button>
            <button class="btn-bunkr-blue px-4 py-2 text-sm rounded w-32 hover:bg-transparent"
                    onclick="window.open(`https://archive.is/newest/${window.location.href}`, '_blank', 'noreferrer, noopener')"
                    title="Archive.is is an archive site which stores snapshots of web pages">
                Archive.is
            </button>
            <button class="btn-bunkr-blue px-4 py-2 text-sm rounded w-32 hover:bg-transparent"
                    onclick="window.open(`https://webcache.googleusercontent.com/search?q=cache:${window.location.href}`, '_blank', 'noreferrer, noopener')"
                    title="Google takes a snapshot of each web page as a backup in case the current page isn't available">
                Google
            </button>
        </div>
    </div>
</section>
</body>
</html>
