	<script>
		(function() {
			var banner = document.getElementById('vw-donations-variant-2');
			fetch('/wp-content/ajax.php?action=vlw_banner_donations_settings')
				.then(function(res) {
					return res.json();
				})
				.then(function(data) {
					if (data.banner_donations_visible) {
						banner.style.display = '';
					}
				})
				.catch(function(err) {
					console.error('vw-donations fetch error', err);
				});

			var texts = [{
					text: 'Més col·laboradors'
				},
				{
					text: 'Més entrevistes'
				},
				{
					text: 'Més continguts'
				},
				{
					text: 'Més investigació'
				},
				{
					text: 'Més\nanàlisi',
					html: 'Més<br>anàlisi'
				}
			];
			var idx = 0;
			var el = document.getElementById('vw-donations-title');

			function setTitle(item) {
				if (item.html && window.matchMedia('(max-width: 1024px)').matches) {
					el.innerHTML = item.html;
				} else {
					el.textContent = item.text;
				}
			}

			setInterval(function() {
				el.classList.add('vw-slide-out');
				setTimeout(function() {
					idx = (idx + 1) % texts.length;
					setTitle(texts[idx]);
					el.classList.remove('vw-slide-out');
					el.classList.add('vw-slide-in');
					setTimeout(function() {
						el.classList.remove('vw-slide-in');
					}, 350);
				}, 350);
			}, 2000);
		})();
	</script>
