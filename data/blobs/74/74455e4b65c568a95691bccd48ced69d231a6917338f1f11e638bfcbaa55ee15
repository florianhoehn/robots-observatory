<script>
function loadLivebar() {
  fetch('system/ajax.php', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'a=livebar_feed'
  })
  .then(res => res.json())
  .then(data => {
const container = document.getElementById('livebar-scroll');
if (!container) return; // <-- TOTO PRIDA�
container.innerHTML = '';

    data.forEach(item => {
      const capitalize = str => str.charAt(0).toUpperCase() + str.slice(1);
      const label = item.type === 'withdrawal' ? 'Cashout' : capitalize(item.method || 'Offerwall');
      const amount = `$${parseFloat(item.amount).toFixed(2)}`;
      const readableLabel = item.type === 'withdrawal'
        ? `${item.username} withdrew ${amount} from Earnbitmoon`
        : `${item.username} earned ${amount} from ${label}`;

      const typeClass = item.type === 'withdrawal' ? 'highlight-withdrawal' : 'highlight-offer';

      const element = document.createElement('div');
      element.className = `livebar-item ${typeClass}`;
      element.setAttribute('title', readableLabel);
      element.setAttribute('aria-label', readableLabel);
      element.setAttribute('role', 'button');
      element.style.cursor = 'pointer'; // <- cursor added for all types

      // Offer clickable
      if (item.type === 'offer') {
        element.addEventListener('click', () => {
          if (typeof isLoggedIn !== 'undefined' && isLoggedIn) {
            window.location.href = '/offers/' + (item.method || 'offerwall').toLowerCase() + '.html';
          } else {
            const modal = document.getElementById('registrationModal');
            if (modal) {
              $(modal).modal('show');
            }
          }
        });
      }

      element.innerHTML = `
        <img src="https://flagcdn.com/w40/${(item.country || 'us').toLowerCase()}.png" alt="">
        <div class="livebar-text">
          <div class="livebar-username">${item.username}</div>
          <div class="livebar-label">${label}</div>
        </div>
        <div class="livebar-amount">${amount}</div>
      `;

      container.appendChild(element);
      if (container.children.length > 20) {
        container.removeChild(container.firstChild);
      }
    });
  });
}

loadLivebar();
setInterval(loadLivebar, 60000);
</script>



    
<script>
$(document).ready(function () {
  function isMobile() {
    return window.innerWidth < 992;
  }

  // Only target header dropdowns, not footer
  $('.navbar:not(footer .navbar) .dropdown-toggle:not([data-toggle="modal"])').each(function () {
    var $toggle = $(this);
    var $parent = $toggle.closest('.dropdown');
    var $menu = $parent.children('.dropdown-menu');

    if (isMobile()) {
      $toggle.off('click').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        if ($parent.hasClass('show')) {
          $parent.removeClass('show');
          $menu.removeClass('show').hide();
          $toggle.attr('aria-expanded', 'false').blur();
        } else {
          $('.navbar:not(footer .navbar) .dropdown').removeClass('show');
          $('.navbar:not(footer .navbar) .dropdown-menu').removeClass('show').hide();

          $parent.addClass('show');
          $menu.addClass('show').show();
          $toggle.attr('aria-expanded', 'true').focus();
        }
      });
    } else {
      $parent.off('mouseenter mouseleave')
        .on('mouseenter', function () {
          $parent.addClass('show');
          $menu.addClass('show').show();
          $toggle.attr('aria-expanded', 'true');
        })
        .on('mouseleave', function () {
          $parent.removeClass('show');
          $menu.removeClass('show').hide();
          $toggle.attr('aria-expanded', 'false').blur();
        });
    }
  });

  // Click outside closes only header dropdowns
  $(document).on('click touchstart', function (e) {
    if (!$(e.target).closest('.navbar:not(footer .navbar) .dropdown').length) {
      $('.navbar:not(footer .navbar) .dropdown').removeClass('show');
      $('.navbar:not(footer .navbar) .dropdown-menu').removeClass('show').hide();
      $('.navbar:not(footer .navbar) .dropdown-toggle').attr('aria-expanded', 'false').blur();
    }
  });
});
</script>







