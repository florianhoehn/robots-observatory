        btn.style.cssText = 'position:absolute;top:12px;right:12px;z-index:999999;background:rgba(0,0,0,0.08);border:none;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#333;transition:background 0.2s;pointer-events:auto;';
        btn.onmouseover = function() { btn.style.background = 'rgba(0,0,0,0.15)'; };
        btn.onmouseout = function() { btn.style.background = 'rgba(0,0,0,0.08)'; };
        btn.onclick = function(e) { e.stopPropagation(); window.closeWeniChat(); };
        aside.appendChild(btn);
      };

      // Watch for Weni adding weni-widget--open class and inject close button
      window.__weniStartObserver = function() {
        var aside = document.querySelector('aside[class*="weni-widget"]');
        if (!aside) return;
        var observer = new MutationObserver(function(mutations) {
          mutations.forEach(function(m) {
            if (m.attributeName === 'class') {
              var isOpen = aside.classList.contains('weni-widget--open');
              if (isOpen) {
                // Re-inject close button every time the widget opens
                setTimeout(window.__weniInjectCloseButton, 200);
                // Also hook Weni's native close/X buttons to our close function
                setTimeout(function() {
                  var aside = document.querySelector('aside[class*="weni-widget"]');
                  if (!aside) return;
                  var nativeBtns = aside.querySelectorAll('button');
                  nativeBtns.forEach(function(b) {
                    if (b.id !== 'weni-custom-close-btn') {
                      b.addEventListener('click', function() {
                        setTimeout(function() {
                          if (!aside.classList.contains('weni-widget--open')) {
                            window.closeWeniChat();
                          }
                        }, 100);
                      });
                    }
                  });
                }, 500);
              }
            }
          });
        });
        observer.observe(aside, { attributes: true, attributeFilter: ['class'] });
      };

      // Open the Weni chat — loads the script on first click (lazy)
      window.openWeniChat = function() {
        function doOpen() {
          window.__weniUserOpened = true;
          // Ensure the widget is visible (undo force-hide from closeWeniChat)
          var aside = document.querySelector('aside[class*="weni-widget"]');
          if (aside) {
            aside.style.display = '';
            aside.classList.add('weni-widget--open');
          }
          if (window.WebChat && typeof window.WebChat.open === 'function') {
            window.WebChat.open();
          }
          // Start observer to inject close button when widget opens
          window.__weniStartObserver();
          // Also inject immediately in case widget is already open
          setTimeout(window.__weniInjectCloseButton, 300);
        }
        if (window.__weniChatReady) {
          doOpen();
        } else {
          // Lazy-load Weni scripts only on first click
          if (!window.isWeniWebChatAlreadyInserted) {
            window.isWeniWebChatAlreadyInserted = true;
            var h = document.getElementsByTagName('script')[0];
            var k = document.createElement('script');
            k.onload = function () {
              var l = document.createElement('script');
              l.src = 'https://weni-sp-integrations-production.s3.amazonaws.com/apptypes/wwc/f6c7bece-d22c-4c35-8760-f6543fda3197/script.js';
              l.async = true;
              l.onload = function() {
                window.__weniChatReady = true;
              };
              h.parentNode.insertBefore(l, k.nextSibling);
            };
            k.async = true;
            k.src = 'https://cdn.cloud.weni.ai/v3/webchat-latest.umd.js';
            h.parentNode.insertBefore(k, h);
          }
          // Wait for chat to be ready then open
          var interval = setInterval(function() {
            if (window.__weniChatReady) {
              clearInterval(interval);
              doOpen();
            }
          }, 100);
          setTimeout(function() { clearInterval(interval); }, 10000);
        }
      };

    </script>
    <!-- End Weni AI Chat Widget -->
