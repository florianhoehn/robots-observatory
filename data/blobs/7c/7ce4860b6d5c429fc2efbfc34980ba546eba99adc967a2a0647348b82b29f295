<script>
$(document).ready(function () {

	 const targetDate = new Date("April 20, 2026 09:20:00").getTime();

	 // Update the count down every 1 second
  	 const timer = setInterval(function() {

	    // Get today's date and time
	    const now = new Date().getTime();

	    // Find the distance between now and the target date
	    const distance = targetDate - now;

	    if (distance < 0) {
	        clearInterval(timer);

	         // Define the exact text and URLs for all 4 blocks
	         const blockConfig = {
	             1: {
	                 text: 'Racecards',
	                 url: '/royal-ascot/racecards'
	             },
	             2: {
	                 text: 'Tips',
	                 url: '/royal-ascot/tips'
	             },
	             3: {
	                 text: 'Odds',
	                 url: '/royal-ascot/odds-comparison'
	             },
	             4: {
	                 text: 'Betting Offers',
	                 url: '/royal-ascot/betting'
	             }
	         };


	        // Target all 4 timer units and update them sequentially
	        $('.timer-unitXXXX').each(function(index) {
	            const dayNum = index < 4 ? index + 1 : index - 3 ; // Gives us 1, 2, 3, 4

	            const config = blockConfig[dayNum];

	            // Change the large text to "Day X" and shrink font so it fits the box
	            $(this).find('.number')
	                   .text(config.text)
	                   .css('font-size', '1.2rem'); // Reduced from 2.0rem to fit
	            
	            // Change the small label to "Tips"
	            $(this).find('.label')
	            	.text('')
	            	.css( {'font-size':'1.2rem', 'font-weight':'900' });
	            
	            // Widen the container slightly to accommodate the new text
	            $(this).css({
	                'min-width': '55px', 
	                'white-space': 'nowrap'
	            });
	            $(this).wrap('<a href="'+config.url+'" style="text-decoration: none;"></a>');
	        });

	        return; // Stop execution here so the math below doesn't run
	    }
	    
	    // Time calculations for days, hours, minutes and seconds
	    const days = Math.floor(distance / (1000 * 60 * 60 * 24));
	    const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
	    const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
	    const seconds = Math.floor((distance % (1000 * 60)) / 1000);

	    // Output the results into the elements using jQuery
	    $('span.days').text(days);
	    $('span.hours').text(hours);
	    $('span.minutes').text(minutes);
	    $('span.seconds').text(seconds);

	    // If the count down is finished, display some text
//	    if (distance < 0) {
//	      clearInterval(timer);
//	      $("div.timer-unit").remove();
//	      $("div.fest-unit span.label").css( {'font-size':'2.3rem'});
//	    }
	  }, 1000);
	
	
  	 $('#searchmodal').on('click','.panel-heading', function () {
  		 
    	var hddiv = "#"+$(this).attr("id").replace(/collapse/g, 'heading');
  		var hddivactive = "#"+$('#searchmodal').find("span.activeup").closest(".panel-heading").attr("id");

  		if ( hddiv != hddivactive ) {
  			$('#searchmodal').find("span.activeup")
     			.removeClass("glyphicon-menu-up activeup")
     			.addClass("glyphicon-menu-down");
  		}
  		
