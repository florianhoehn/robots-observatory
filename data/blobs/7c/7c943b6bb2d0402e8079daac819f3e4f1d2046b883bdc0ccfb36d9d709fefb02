        const container = dd.querySelector("[data-dropdown-container]");
        const innerFocusables = dd.querySelectorAll("a, button");
        const backBtn = dd.querySelector("[data-dropdown-back]");
        const dropdownId = `dropdown-${i}`;

        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-haspopup", "true");
        toggle.setAttribute("aria-controls", dropdownId);

        if (container) {
          container.setAttribute("id", dropdownId);
          container.setAttribute("role", "menu");
          dd.setAttribute("aria-hidden", "true");
          innerFocusables.forEach((item) => {
            item.setAttribute("role", "menuitem");
            item.setAttribute("tabindex", "-1");
          });
        }

