      this.elements = {
        header: document.querySelector(".nav1_header"),
        btn: document.querySelector("[data-menu-button]"),
        navStatus: document.querySelector("[data-menu-status]"),
        desktopNav: document.querySelector("[data-nav-desktop]"),
        mobileNav: document.querySelector("[data-nav-mobile]"),
        dropdownToggles: Array.from(
          document.querySelectorAll("[data-dropdown-toggle]")
        ),
      };

      if (!this.elements.btn || !this.elements.navStatus) return;

      this.initDropdowns();
      this.initEvents();
      this.handleBreakpoint();

      window.addEventListener(
        "resize",
        debounce(() => this.handleBreakpoint(), 200)
      );
    },

    isMobile() {
      return window.innerWidth < 992;
    },

    handleBreakpoint() {
      const isMobile = this.isMobile();
      const currentMode = isMobile ? "mobile" : "desktop";

      if (this._lastMode === currentMode) return;

      const { desktopNav, mobileNav } = this.elements;
      const active = isMobile ? mobileNav : desktopNav;
      const inactive = isMobile ? desktopNav : mobileNav;

      active?.setAttribute("role", "navigation");
      active?.setAttribute("aria-label", "Primary navigation");
      if (isMobile) active?.setAttribute("id", "primary-navigation");

      inactive?.removeAttribute("role");
      inactive?.removeAttribute("aria-label");
      inactive?.removeAttribute("id");

      if (!isMobile) {
        this.closeMenu(false);
        desktopNav.removeAttribute("inert");
      } else {
        desktopNav.setAttribute("inert", "");
      }

      this._lastMode = currentMode;
    },

