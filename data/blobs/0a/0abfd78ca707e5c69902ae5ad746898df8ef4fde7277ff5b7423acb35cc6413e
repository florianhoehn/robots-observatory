    <script>

        (() => {
            const formSelector = '#se-webform-21';
            const inputFormSelector = '.se-body input';
            const btnFormSelector = '.se-submit button';
            const presentEmailErrorText = 'E-mailová adresa je povinné pole.';
            const validEmailErrorText = 'E-mailová adresa musí mít správný tvar.';

            const observer = new MutationObserver(() => {
                const form = document.querySelector(formSelector);

                if (form) {
                    const input = form.querySelector(inputFormSelector);
                    const btn = form.querySelector(btnFormSelector);
                    const errorElement = document.createElement('div');
                    errorElement.classList.add('validate-email-error');
                    input.placeholder = '@';
                    input.after(errorElement);
                    btn.classList.add('c-button');

                    // override SE validating process
                    form.addEventListener('submit', function (e) {
                        e.preventDefault();
                        e.stopImmediatePropagation();

                        const email = input.value;
                        if (!email) {
                            input.classList.add('-error');
                            errorElement.innerHTML = presentEmailErrorText;
                        } else if (!Utils.Validate.Email(email)) {
                            input.classList.add('-error');
                            errorElement.innerHTML = validEmailErrorText;
                        } else {
                            input.classList.remove('-error');
                            errorElement.innerHTML = '';
                            form.submit();
                        }
                    });
                    observer.disconnect();
                }
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true,
            });

        })();

    </script>
