<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Page Not Found - 404</title>
    <style>
        /* Reset and Base Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 100%);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            overflow-x: hidden;
        }

        /* Container Setup */
        .error-container {
            text-align: center;
            max-width: 600px;
            width: 100%;
            padding: 40px 20px;
        }

        /* 404 Text Styling & Animation */
        .error-code {
            font-size: clamp(8rem, 20vw, 12rem);
            font-weight: 900;
            line-height: 1;
            background: linear-gradient(45deg, #38bdf8, #818cf8, #c084fc);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: float 4s ease-in-out infinite;
            filter: drop-shadow(0 10px 20px rgba(129, 140, 248, 0.2));
        }

        /* Floating Shadow Effect */
        .shadow {
            width: 150px;
            height: 12px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 50%;
            margin: -10px auto 30px;
            animation: shrink 4s ease-in-out infinite;
            filter: blur(4px);
        }

        /* Typography */
        .error-title {
            font-size: clamp(1.5rem, 4vw, 2.2rem);
            font-weight: 700;
            margin-bottom: 15px;
            color: #f1f5f9;
        }

        .error-message {
            font-size: clamp(0.95rem, 2.5vw, 1.1rem);
            color: #94a3b8;
            line-height: 1.6;
            margin-bottom: 35px;
        }

        /* Interactive CTA Button */
        .btn-home {
            display: inline-block;
            padding: 14px 32px;
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            text-decoration: none;
            background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
            border-radius: 50px;
            box-shadow: 0 4px 15px rgba(79, 70, 229, 0.4);
            transition: all 0.3s ease;
        }

        .btn-home:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(6, 182, 212, 0.5);
            background: linear-gradient(135deg, #06b6d4 0%, #4f46e5 100%);
        }

        .btn-home:active {
            transform: translateY(-1px);
        }

        /* Animations */
        @keyframes float {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-15px);
            }
        }

        @keyframes shrink {
            0%, 100% {
                transform: scale(1);
                opacity: 0.8;
            }
            50% {
                transform: scale(0.7);
                opacity: 0.4;
            }
        }

        /* Ensure perfect fitting on tiny mobile screens */
        @media (max-width: 360px) {
            .error-container {
                padding: 20px 10px;
            }
            .btn-home {
                width: 100%;
                padding: 12px 20px;
            }
        }
    </style>
</head>
<body>

    <div class="error-container">
        <div class="error-code">404</div>
        <div class="shadow"></div>

        <h1 class="error-title">Lost in Space?</h1>
        <p class="error-message">
            The page you are looking for might have been removed, had its name changed, or is temporarily unavailable. Let's get you back on track!
        </p>

        <a href="https://sattamatkano1.me/" class="btn-home">Back To Home</a>
    </div>

</body>
</html>
      
  </body>
</html>