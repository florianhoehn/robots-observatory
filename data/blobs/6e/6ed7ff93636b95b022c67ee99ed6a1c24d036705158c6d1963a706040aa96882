    <title>403 | WAF Block</title>
    <style>:root {
  color-scheme: light;
  --bg-top: #fff1ef;
  --bg-bottom: #f8e4e1;
  --ink: #1f211f;
  --muted: #616766;
  --surface: rgba(255, 252, 247, 0.78);
  --surface-strong: rgba(255, 255, 255, 0.84);
  --surface-dark: #1f1916;
  --line: rgba(31, 33, 31, 0.08);
  --accent: #e05b5d;
  --accent-soft: rgba(240, 109, 63, 0.14);
  --accent-strong: #ffc0c5;
  --shadow: 0 24px 80px rgba(126, 82, 49, 0.14);
  --accent-readable: #a24349;
  --divider: rgba(35, 30, 25, 0.08);
  --page-gutter: clamp(1rem, 2.5vw, 2rem);
  --card-padding: clamp(1.5rem, 2.6vw, 2.25rem);
  --page-width: 1120px;
  --radius-xl: 32px;
  --radius-lg: 24px;
  --radius-md: 18px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  position: relative;
  background:
    radial-gradient(circle at 10% 10%, rgba(255, 177, 177, 0.34), transparent 24rem),
    radial-gradient(circle at 88% 16%, rgba(233, 104, 110, 0.24), transparent 20rem),
    linear-gradient(180deg, var(--bg-top) 0%, var(--bg-bottom) 100%);
  color: var(--ink);
  font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
}

.page-glow {
  position: fixed;
  inset: auto;
  border-radius: 999px;
  filter: blur(40px);
  pointer-events: none;
  opacity: 0.72;
}

.page-glow-one {
  top: 6rem;
  right: -5rem;
  width: 18rem;
  height: 18rem;
  background: rgba(235, 120, 132, 0.26);
}

.page-glow-two {
  bottom: 3rem;
  left: -4rem;
  width: 16rem;
  height: 16rem;
  background: rgba(255, 188, 198, 0.22);
}

.hero-card {
  position: relative;
  overflow: hidden;
  padding: 1.5rem;
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-xl);
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.85), rgba(255, 247, 240, 0.75));
  box-shadow: var(--shadow);
  backdrop-filter: blur(14px);
}

.hero-card::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 14rem;
  height: 14rem;
  background: radial-gradient(circle, rgba(255, 183, 151, 0.26), transparent 68%);
  pointer-events: none;
}

.hero-text span {
  color: var(--ink);
  font-weight: 700;
}

.action-button {
  appearance: none;
  border: 0;
  border-radius: 999px;
  padding: 0.92rem 1.25rem;
  font: inherit;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 140ms ease,
    box-shadow 140ms ease,
    background-color 140ms ease;
}

.action-button:hover {
  transform: translateY(-1px);
}

.action-button:focus-visible,
.ip-toggle:focus-visible {
  outline: 2px solid #1f211f;
  outline-offset: 2px;
}

.action-button-primary {
  background: var(--ink);
  color: #fff9f2;
  box-shadow: 0 12px 30px rgba(31, 25, 22, 0.18);
}

.action-button-primary:hover {
  box-shadow: 0 18px 36px rgba(31, 25, 22, 0.22);
}

.action-button-secondary {
  background: rgba(255, 255, 255, 0.72);
  color: var(--ink);
  border: 1px solid rgba(31, 33, 31, 0.08);
}

.signal-card {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  min-height: 21rem;
  padding: 1.5rem;
  overflow: hidden;
  border-radius: var(--radius-lg);
  background:
    radial-gradient(circle at 50% 32%, rgba(255, 194, 164, 0.12), transparent 8rem),
    linear-gradient(160deg, #221b18 0%, #322621 100%);
  color: #fff6ee;
}

.signal-card::before,
.signal-card::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(255, 221, 204, 0.1);
}

.signal-card::before {
  inset: 2.5rem auto auto 50%;
  width: 11rem;
  height: 11rem;
  transform: translateX(-50%);
}

.signal-card::after {
  inset: 4rem auto auto 50%;
  width: 7rem;
  height: 7rem;
  transform: translateX(-50%);
}

.signal-badge {
  position: absolute;
  top: 2.85rem;
  left: 50%;
  display: grid;
  place-items: center;
  width: 5.5rem;
  height: 5.5rem;
  border-radius: 1.6rem;
  background: linear-gradient(180deg, rgba(255, 131, 87, 0.95), rgba(236, 89, 53, 0.95));
  transform: translateX(-50%) rotate(6deg);
  box-shadow: 0 24px 48px rgba(240, 109, 63, 0.28);
}

.signal-icon {
  position: relative;
  width: 2rem;
  height: 2rem;
}

.signal-icon::before,
.signal-icon::after {
  content: "";
  position: absolute;
  inset: 50% auto auto 50%;
  width: 2rem;
  height: 0.32rem;
  border-radius: 999px;
  background: #fffaf5;
}

.signal-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.signal-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.signal-label,
.signal-copy {
  position: relative;
  z-index: 1;
  margin: 0;
}

.request-meta {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.35rem 0 0;
  padding: 1rem;
  border: 1px solid rgba(31, 33, 31, 0.06);
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.58);
}

.ip-toggle {
  appearance: none;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--accent);
  font: inherit;
  font-weight: 700;
  cursor: pointer;
}

.hero-text {
  color: var(--muted);
}

.signal-label { color: var(--accent-strong); }
.signal-copy { color: rgba(255, 255, 255, 0.82); }

/* Layout: keep the original colour theme; allow content to size the page. */
html {
  font-size: 100%;
  -webkit-text-size-adjust: 100%;
  text-size-adjust: 100%;
}

body {
  min-height: 100vh;
  min-height: 100svh;
  line-height: 1.5;
}

.page-glow {
  max-width: 45vw;
}

.page-glow-one {
  left: 0;
  right: auto;
}

.page-glow-two {
