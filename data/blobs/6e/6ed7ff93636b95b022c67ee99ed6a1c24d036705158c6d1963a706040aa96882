}

/* Challenge pages place the actual check before the retry buttons on mobile. */
.page-challenge .hero-grid {
  grid-template-areas: "copy panel" "actions panel";
  grid-template-rows: auto 1fr;
  row-gap: 1.25rem;
}

.page-challenge .hero-copy {
  grid-area: copy;
  align-self: end;
}

.page-challenge .challenge-card {
