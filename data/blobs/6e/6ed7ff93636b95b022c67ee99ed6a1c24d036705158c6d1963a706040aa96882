  grid-template-columns: minmax(0, 1.25fr) minmax(320px, 0.95fr);
  gap: 1.75rem;
  align-items: stretch;
}

.hero-copy,
.hero-grid > *,
.meta-item {
  min-width: 0;
}

.hero-copy {
  align-self: center;
  padding: 0.25rem 0;
}

.hero-copy h1 {
  max-width: none;
  margin: 0;
  font-size: clamp(2.25rem, 1.15rem + 2.1vw, 3rem);
  line-height: 1.08;
  letter-spacing: -0.045em;
  overflow-wrap: break-word;
