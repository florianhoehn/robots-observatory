  align-self: start;
  margin-top: 0;
}

.signal-card {
  min-height: 18rem;
  padding: 1.5rem;
}

.signal-badge {
  top: 2.25rem;
}

.signal-label {
  min-width: 0;
  overflow-wrap: anywhere;
  font-weight: 700;
  text-transform: uppercase;
  font-size: 0.75rem;
  line-height: 1.55;
  letter-spacing: 0.1em;
}

.signal-copy {
  min-width: 0;
  overflow-wrap: anywhere;
  max-width: 19rem;
  margin-top: 0.5rem;
  font-size: 0.9375rem;
  line-height: 1.6;
}

.challenge-card,
.error-card {
  min-width: 0;
  min-height: 18rem;
  padding: 1.25rem;
  gap: 0.75rem;
}

.challenge-label,
.error-label {
  margin: 0;
  font-weight: 700;
  text-transform: uppercase;
  color: var(--accent-readable);
  font-size: 0.75rem;
  line-height: 1.6;
  letter-spacing: 0.08em;
  overflow-wrap: anywhere;
}

/* These containers retain the original Cloudflare replacement tokens. */
.challenge-box,
.error-box {
  min-width: 0;
  min-height: 9rem;
  max-width: 100%;
  border-radius: 16px;
  font-size: 0.9375rem;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.challenge-box {
  padding: 0.75rem 0;
}

.error-box {
  display: block;
  align-content: center;
  padding: 1rem;
}

.challenge-box > *,
.error-box > * {
  min-width: 0;
  max-width: 100%;
}

.challenge-box iframe {
  display: block;
  max-width: 100%;
  border: 0;
}

.error-box :is(h1, h2, h3) {
  max-width: none;
  margin: 0 0 0.625rem;
  font-size: 1.125rem;
  line-height: 1.35;
  letter-spacing: normal;
}

.error-box p {
  margin: 0.625rem 0;
}

.error-box > :first-child {
  margin-top: 0;
}

.error-box > :last-child {
  margin-bottom: 0;
}

.error-box :is(pre, code) {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.error-box :is(img, svg) {
  max-width: 100%;
  height: auto;
}

/* Long Ray IDs, country names and IPv6 addresses wrap rather than widen the page. */
.request-meta {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  align-items: start;
  gap: 1rem;
  margin: 1.5rem 0 0;
  padding: 1rem 1.125rem;
}

.meta-item {
  display: block;
}

.meta-item dt {
  overflow-wrap: anywhere;
  font-weight: 700;
  text-transform: uppercase;
  margin-bottom: 0.3125rem;
  color: var(--muted);
  font-size: 0.6875rem;
  line-height: 1.5;
  letter-spacing: 0.09em;
}

.meta-item dd {
  margin: 0;
  color: var(--ink);
  min-width: 0;
  font-size: 0.875rem;
  font-weight: 600;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.ip-toggle {
  max-width: 100%;
  overflow-wrap: anywhere;
  min-height: 2rem;
  min-width: 2.75rem;
  padding: 0.25rem 0;
  margin-top: -0.25rem;
  color: var(--accent-readable);
  line-height: 1.5;
  text-align: left;
  touch-action: manipulation;
  text-decoration: underline;
  text-underline-offset: 0.2em;
}

.ip-value {
  color: var(--muted);
  font-weight: 600;
  display: block;
  margin: 0.25rem 0 0;
  font-size: 0.8125rem;
  font-variant-numeric: tabular-nums;
  overflow-wrap: anywhere;
}

.ip-value[hidden] {
  display: none;
}

/* Tablet: stop using a narrow two-column hero before it becomes cramped. */
@media (max-width: 960px) {
  .page-shell {
    --page-width: 760px;
  }

  .hero-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }

  .hero-copy {
    padding: 0;
  }

  .hero-copy h1 {
    max-width: 32ch;
    font-size: clamp(2rem, 1.1rem + 3vw, 2.75rem);
    line-height: 1.12;
  }

  .hero-text {
    max-width: 40rem;
  }

  .page-challenge .hero-grid {
    grid-template-areas: "copy" "panel" "actions";
    grid-template-rows: auto;
  }

  /* Replace the tall decorative panel with a compact, readable status strip. */
  .signal-card {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    grid-template-areas: "badge label" "badge message";
    align-content: center;
    justify-content: normal;
    column-gap: 1rem;
    row-gap: 0.25rem;
    min-height: 0;
    padding: 1.125rem;
    border-radius: 18px;
  }

  .signal-badge {
    grid-area: badge;
    position: relative;
    top: auto;
    left: auto;
    align-self: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9375rem;
    transform: rotate(-4deg);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.13);
  }

  .signal-icon {
    transform: scale(0.72);
  }

  .signal-label {
    grid-area: label;
    align-self: end;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .signal-copy {
    grid-area: message;
    max-width: none;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .signal-card::before {
    inset: -3.5rem 0 auto auto;
    max-width: 100%;
    width: 12rem;
    height: 12rem;
    transform: none;
  }

  .signal-card::after {
    inset: -1.5rem 0 auto auto;
    max-width: 100%;
    width: 8rem;
    height: 8rem;
    transform: none;
  }

  .challenge-card,
  .error-card {
    min-height: 0;
    padding: 1rem;
    border-radius: 18px;
  }

  .challenge-box,
  .error-box {
    min-height: 7rem;
    border-radius: 12px;
  }

  .request-meta {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.25rem;
    row-gap: 0.875rem;
  }

  .meta-item:nth-child(n + 3) {
    padding-top: 0.75rem;
    border-top: 1px solid var(--divider);
  }
}

/* Phone: readable type, natural text width and no fixed-height content panels. */
@media (max-width: 600px) {
  :root {
