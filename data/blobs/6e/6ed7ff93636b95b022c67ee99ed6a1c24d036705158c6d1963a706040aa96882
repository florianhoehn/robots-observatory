}

.hero-text {
  max-width: 36rem;
  margin: 1rem 0 0;
  font-size: 1.0625rem;
  line-height: 1.65;
  overflow-wrap: break-word;
}

.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  margin-top: 1.5rem;
}

.action-button {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  min-height: 3rem;
  max-width: 100%;
  padding: 0.75rem 1.375rem;
  font-size: 0.9375rem;
  line-height: 1.4;
  text-align: center;
