    $.ajax({
        url: '/ivt.php?ip=82.39.15.43',
        type: 'GET',
        dataType: 'text',
        timeout: 700,//ms
        success: function (data) {
            if(isBot() && data.toString()=='0'){//if IP is botnetwork - no need to check the user agent as well
