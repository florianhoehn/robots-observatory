    function getCookie(k) {
        return(document.cookie.match('(^|; )' + k + '=([^;]*)') || 0)[2]
    }
    function isBot() {
        const userAgent = navigator.userAgent.toLowerCase();
        const botUserAgents = [
            'googlebot',
            'bingbot',
            'yandexbot',
            'baiduspider',
            'mj12bot',
            'ahrefsbot',
            'duckduckbot',
            'facebot', 
            'twitterbot', 
            'linkedinbot', 
            'slurp', 
            'archive.org_bot', 
            'applebot', 
            'tumblr',
            'redditbot',
            'slackbot', 
            'discordbot', 
            'zoominfo', 
            'semrushbot',
            'uptimerobot', 
            'whatsapp', 
        ];

        return botUserAgents.some(bot => userAgent.includes(bot));
    }
