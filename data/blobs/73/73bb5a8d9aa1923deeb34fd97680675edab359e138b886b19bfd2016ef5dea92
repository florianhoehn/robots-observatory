  <div class="page-error-content">
    <div id="default404">
      <h1 class="page-heading">Page Not Found</h1>
      <h3>Sorry, but the file you were trying to access could not be found.</h3>

      <p>Reasons could be:</p>
      <ul>
        <li>The URL for the report has expired.</li>
        <li>The file doesn't exist.</li>
      </ul>
    </div>

    <div id="report404" style="display: none">
      <h1 class="page-heading">Report Not Found</h1>
      <h3>Sorry, but the report you were looking for could not be found.</h3>

      <p>Reasons could be:</p>
      <ul>
        <li>The report URL is <strong>invalid</strong> or <strong>malformed</strong>.</li>
        <li>The report has <strong>expired</strong>.</li>
      </ul>
      <p>
        Your report data is only retained for a specific duration based on your GTmetrix plan-level.
      </p>
      <p>
        Please re-test the URL to generate another report.
      </p>
      <p>
        Need to keep your reports for longer? Upgrade your <a href="/pricing/" data-cta-name="PRO Report retention" data-cta-location="Report 404" data-cta-type="pro">GTmetrix plan</a>.
      </p>
    </div>

    <div id="resource404" style="display: none">
      <h1 class="page-heading">Report Resource Not Found</h1>
      <h3>Sorry, but the report resource you were looking for could not be found.</h3>

      <p>GTmetrix keeps all report resources for <strong>24 hours</strong>; they are deleted thereafter.</p>
      <p>Please retest the URL to generate the resources again.</p>
    </div>

    <div id="invite404" style="display: none">
      <h1 class="page-heading">Invitation Not Found</h1>
      <h3>Sorry, but this invitation link was not found or is no longer valid.</h3>

      <p>Reasons could be:</p>
      <ul>
        <li>The link has already been used.</li>
        <li>The link has expired.</li>
        <li>The invitation link is malformed.</li>
      </ul>

      <p>If you think this is an error, please contact your Team Administrator.</p>
    </div>

    <p id="errorContact">If you think this is an error, please <a href="/contact/?type=bug-report">contact</a> and inform us!</p>
    <script>
      (function () {
        let match = window.location.pathname.match(/^\/reports\/[^\/]+\/\w+(\/.+)?/);
        if (match) {
          document.getElementById('default404').style.display = 'none';
          document.getElementById('default404').dataset.report_404 = 1;
          document.getElementById(match[1] && match[1] != '/latest' ? 'resource404' : 'report404').style.display = 'block';
          return;
        }
        if (window.location.pathname.match(/^\/organizations\/join\/\w+(\/.+)?/)) {
          document.getElementById('default404').style.display = 'none';
          document.getElementById('invite404').style.display = 'block';
          document.getElementById('errorContact').style.display = 'none';
        }
      })();
    </script>
