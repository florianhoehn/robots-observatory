<script type="text/javascript">
$jq(function() {
	var $el = $jq('#lookup_quote');
	$el.autocomplete({
		source: function(req, res) {
			var url = 'mobileapi.php?action=quoteSearch&search=' + req.term;
			$jq.ajax(url, { dataType: 'json' })
				.done(function(json) {
					var newjson = [];
					for ( var i = 0; i < json.length; i++ ) {
						newjson.push({
							label: json[i].name + ' (' + json[i].symbol + ')',
							sym: json[i].symbol
						});
					}
					res(newjson);
				})
				.fail(function() {
					res({});
				});
		},
		minLength: 1,
		select: function(event, ui) {
			event.preventDefault();
			$jq(this).val(ui.item.sym);
			$jq(this).closest('form').submit();
		}
	});
});
</script>

