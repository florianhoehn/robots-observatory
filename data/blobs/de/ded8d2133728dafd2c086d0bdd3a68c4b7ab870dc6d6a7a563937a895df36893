<script>
    var oneLoginCamMode = false;

    if (!oneLoginCamMode) {
        // Define a JavaScript object (hash) to store the URLs for each region
        var regionUrls = {
              us: "https://ruckus.cloud/auth",
              eu: "https://eu.ruckus.cloud/auth",
              as: "https://asia.ruckus.cloud/auth",
              us2: "https://na2.ruckus.cloud/auth",
        };

        // Function to update the SSO link's href based on the selected region
        function updateSSOLink() {
            var selectedRegion = document.getElementById("user_region").value;
            var ssoLink = document.getElementById("sso_link");

            if (ssoLink) {
                var newUrl = regionUrls[selectedRegion];
                if (newUrl) ssoLink.setAttribute("href", newUrl);
            }
        }

        const userRegionElement = document.getElementById("user_region");

        // If there is a user_region dropdown, add an event listener to it to trigger the update on change
        if (userRegionElement) {
            userRegionElement.addEventListener("change", updateSSOLink);
        }
    }

    const emailInput = document.querySelector("[name='user[username]']");
    const passwordInput = document.querySelector("[name='user[password]']");
    const submitButton = document.getElementById('ruckus-one-submit-button');

    function updateSubmitButtonState() {
        const emailValue = emailInput.value.trim();
        const passwordValue = passwordInput.value.trim();

        if (emailValue && passwordValue.length >= 6) {
            submitButton.removeAttribute('disabled');
        } else {
            submitButton.setAttribute('disabled', 'disabled');
        }
    }

    const intervalId = setInterval(updateSubmitButtonState, 500);

    // Remember to clear the interval when the user submits the form or the page unloads:
    submitButton.addEventListener('click', () => {
        clearInterval(intervalId);
    });

    window.addEventListener('unload', () => {
        clearInterval(intervalId);
    });
</script>



