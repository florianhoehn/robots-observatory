<!-- Pre-paint: apply the saved display mode before anything renders -->
<script>
    (function() {
        try {
            if (localStorage.getItem('siteDark') === '1') {
                var c = document.documentElement.classList;
                c.remove('theme-light');
                c.add('theme-dark');
            }
        } catch (e) {}
    })();

    // Display Mode rows in the header dropdowns call this. State lives on
    // <html> only; the switch pills are pure CSS keyed off that class, so
    // every toggle instance stays in sync with no per-pill JS. Instant,
    // client-side, idempotent — no busy state needed.
    function toggleSiteTheme() {
        var c = document.documentElement.classList;
        var dark = !c.contains('theme-dark');
        c.toggle('theme-dark', dark);
        c.toggle('theme-light', !dark);
        try {
            localStorage.setItem('siteDark', dark ? '1' : '0');
        } catch (e) {}
        document.querySelectorAll('[data-theme-toggle]').forEach(function(b) {
            b.setAttribute('aria-checked', dark ? 'true' : 'false');
        });
    }

    // The rows render with aria-checked="false"; correct them once the DOM
    // is up (the visual pill never lies — it's CSS off the html class).
    document.addEventListener('DOMContentLoaded', function() {
        var dark = document.documentElement.classList.contains('theme-dark');
        document.querySelectorAll('[data-theme-toggle]').forEach(function(b) {
            b.setAttribute('aria-checked', dark ? 'true' : 'false');
        });
    });
</script>

