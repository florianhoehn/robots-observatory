<!-- USG SearchStax Search JS -->
<!-- This function adds the SearchStax search box init function to the global footer. It is called by the USG SearchStax Search content type that creates the search boxes. --> 
<script type="text/javascript">
    function initSearchBox(inputId, buttonId, resultsUrl) {
    	const input = document.getElementById(inputId);
        const button = document.getElementById(buttonId);

        if (!input || !button) return;

        const executeSearch = function () {
            const query = input.value.trim();
            if (!query) return;

            // Build the SearchStax URL
            const url = `${resultsUrl}?searchstax[query]=${encodeURIComponent(query)}&searchstax[page]=1`;
            window.location.href = url;
        };

        button.addEventListener('click', executeSearch);

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                executeSearch();
            }
        });
    }
</script>
