    <script type="application/javascript">
      function addBodyThemeClass() {
        const darkTheme = 'dark-theme';
        const lightTheme = 'light-theme';

        if (document?.body) {
          document.body.classList.remove(lightTheme, darkTheme);

          if (isInfluencerPage()) {
            document.body.classList.add(darkTheme);
            return;
          }

          const lightThemeABTestCookieValue = document.cookie
            .split('; ')
            .find(row => row.startsWith('cr-light-theme='))
            ?.split('=')[1];

          if (lightThemeABTestCookieValue === '1') {
            document.body.classList.add(lightTheme);
          } else {
            const themeName = localStorage.getItem('eld-current-theme');

            if (themeName) {
              document.body.classList.add(themeName.slice(1, -1));
            } else if (
              window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
            ) {
              document.body.classList.add(lightTheme);
            } else {
              document.body.classList.add(darkTheme);
            }
          }
        } else {
          setTimeout(addBodyThemeClass, 10);
        }
      }
      function isInfluencerPage() {
        return window.location.pathname.includes('/influencer/');
      }
      addBodyThemeClass();
    </script>

