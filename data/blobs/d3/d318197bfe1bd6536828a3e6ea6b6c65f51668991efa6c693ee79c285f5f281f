			<script>
				let benachrichtigungen_container = document.getElementById("benachrichtigungen_container");
				let pur_notification_dismissed = false;
				(function() {
					if (localStorage.getItem("pur_notification_dismissed")
						|| window.location.pathname.indexOf("/BGBl") === 0
						|| window.mobil
					) {
						document.documentElement.className += " pur_notification_dismissed";
						pur_notification_dismissed = true;
					}
				})();
				if (pur_notification_dismissed === false) {
					benachrichtigungen_container = document.getElementById("benachrichtigungen_container");
						const pur_sentinel = document.createElement("div");
						pur_sentinel.style.cssText = "position: absolute; top: 150px; height: 1px; pointer-events: none;";
						document.body.prepend(pur_sentinel);
						const observer = new IntersectionObserver(([entry]) => {
							if (pur_notification_dismissed === true) return;
							if (benachrichtigungen_container) {
								benachrichtigungen_container.style.opacity = entry.isIntersecting ? 1 : 0;
							}
							document.getElementById("pur_notification").classList.toggle("is-visible", !entry.isIntersecting);
						});
						observer.observe(pur_sentinel);
				}
				function dismissPurNotification() {
					document.getElementById("pur_notification").remove();
					localStorage.setItem("pur_notification_dismissed", 1);
					pur_notification_dismissed = true;
					if (benachrichtigungen_container) {
						benachrichtigungen_container.style.opacity = 1;
					}
				}
			</script>

