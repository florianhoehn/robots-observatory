<!DOCTYPE html>
<html id="startme" lang="en">
<head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1" name="viewport">
<title>Not acceptable</title>
<link href="/images/favicons/favicon-32.png" id="favicon_32" rel="icon" sizes="32x32">
<link href="/images/favicons/favicon-180.png" id="favicon_180" rel="icon" sizes="180x180">
<link href="/images/favicons/favicon-192.png" id="favicon_192" rel="icon" sizes="192x192">

<style>
  @import url('https://fonts.googleapis.com/css?family=Lato:300,400,700,900');
  
  *, *::before, *::after { box-sizing: border-box; }
  
  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 16px;
    line-height: 1.5;
    color: #333;
    background: linear-gradient(135deg, #2395ed 0%, #016fc6 100%);
  }
  
  body {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  
  .logo {
    margin-bottom: 2rem;
  }
  
  .logo img {
    height: 32px;
  }
  
  main {
    width: 100%;
    max-width: 600px;
    padding: 3rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    text-align: center;
  }
  
  .error-wrapper__header { margin-bottom: 2rem; }
  .error-wrapper__logo { display: inline-block; }
  .error-wrapper__logo img { height: 40px; }
  .error-wrapper__code { font-size: 6rem; font-weight: 300; color: #2395ed; margin: 0; line-height: 1; }
  .error-wrapper__status { font-size: 1.5rem; font-weight: 700; color: #333; margin: 0.5rem 0; }
  .error-wrapper__explanation { font-size: 1.1rem; color: #666; margin: 1rem 0 4rem; }
  .error-wrapper__description { font-size: 0.9rem; color: #888; margin: 1rem 0; }
  .error-wrapper__buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-top: 2rem; }
  .error-wrapper__button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }
  .error-wrapper__button_default { background: #2395ed; color: white; }
  .error-wrapper__button_default:hover { background: #016fc6; }
  .error-wrapper__button_grey { background: #e2e8f0; color: #4a5568; }
  .error-wrapper__button_grey:hover { background: #cbd5e0; }
  .error-wrapper__help { margin-top: 2rem; }
  .error-wrapper__error-link { color: #2395ed; text-decoration: none; font-size: 0.9rem; }
  .error-wrapper__error-link:hover { text-decoration: underline; }
  .error-wrapper__image-wrapper { display: none; }
</style>
</head>
<body>
<a class="logo" href="/">
<img alt="Start.me" src="https://c.start.me/assets/marketing/logos/startme-logo-white-a372991e0444c1347a165300e0e1d8e150c7a47aa8fcb8b927f227506ddf787c.png">
</a>
<main>
<section class="dialog box error-wrapper">
<div class="error-wrapper__header"></div>
<div class="error-wrapper__container">
<h1 class="error-wrapper__code">
<div>406</div>
<div class="error-wrapper__image-wrapper">
<img class="error-wrapper__image" src="https://c.start.me/assets/stair-cf986d28fa39a9f6edbc2b3b700e3b1af39d01e7021e2afdbf6623241b9227ff.png">
</div>
<div class="error-wrapper__status">Not acceptable</div>
</h1>
<h2 class="error-wrapper__explanation">We're sorry, something went wrong while we tried to process your request.  Please try again later or contact us at <a href="mailto:support@start.me">support@start.me</a>.</h2>
<div class="error-wrapper__buttons">
<a class="error-wrapper__button error-wrapper__button_default" href="/">
Go to homepage
</a>
</div>
</div>
</section>


</main>
</body>

</html>
