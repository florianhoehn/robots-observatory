        console.log('Ads Data Layer Load');
        /* Navegg */
        var nvgData = window.localStorage.getItem('nvgpersona67531');
        if(nvgData && nvgData.length > 0){
          var person = JSON.parse(nvgData);
          var attribute;
          for(attribute in person){
            var name = "nvg_" + attribute;
            name = name.substring(0,10);
            window.googletag.pubads().setTargeting(name, person[attribute]);	
          }						
        }		
        console.log('Ads Navegg Load');
  
      /* Recomendations*/
      const recommendations_high = JSON.parse(localStorage.getItem("SIIM_REC")) || {value:{r:{pps_v1:[]}}};
      const recommendations = recommendations_high.value.r || {pps_v1:[]};
      console.log('recommendations_high', recommendations_high)
        console.log("RECOMMENDATIONS ---- ", recommendations);
        if (recommendations) {
            //setup de custom key values
            for (let key in recommendations) {
                googletag.pubads().setTargeting("SIIM_"+key, recommendations[key]);
            }
    
            //setup de pps
            window.googletag.setConfig({
                pps: {
                    taxonomies: {
                        IAB_AUDIENCE_1_1: { values: recommendations.pps_v1 },
                    },
                },
            });
        }
    
        //setup de ppid
