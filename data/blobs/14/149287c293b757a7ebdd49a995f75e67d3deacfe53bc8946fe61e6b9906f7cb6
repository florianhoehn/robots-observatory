    <script>
    function isConcernForCookie(category) {
        var match = document.cookie.match(/(?:^|;\s*)cookie_settings=([^;]*)/);
        if (!match) return false;
        return decodeURIComponent(match[1]).split(',').includes(category);
    }

    window.isConcernForCookie = isConcernForCookie;

    // Removal of the tracker cookies that were already set, once consent is withdrawn
    (function () {
        var analyticsCookies = [/^_ga/, /^_gid$/, /^_gat/, /^_dc_gtm_/];
        var marketingCookies = [/^_fbp$/, /^_fbc$/, /^_gcl_/];

        function cookieDomains() {
            var host = location.hostname.replace(/^www\./, '');
            var domains = [null, host, '.' + host];
            var parts = host.split('.');

            // parent domains: trackers write their cookie on the topmost one available
            for (var i = 1; i < parts.length - 1; i++) {
                var parent = parts.slice(i).join('.');
                domains.push(parent, '.' + parent);
            }

            return domains;
        }

        function dropCookies(patterns) {
            var domains = cookieDomains();

            document.cookie.split(';').forEach(function (raw) {
                var name = raw.split('=')[0].trim();

                if (!name || !patterns.some(function (pattern) { return pattern.test(name); }))
                    return;

                domains.forEach(function (domain) {
                    document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/'
                        + (domain ? '; domain=' + domain : '');
                });
            });
        }

        function dropRevokedCookies() {
            if (!isConcernForCookie('analytics'))
                dropCookies(analyticsCookies);

            if (!isConcernForCookie('marketing'))
                dropCookies(marketingCookies);
        }

        window.addEventListener('cookie-settings-changed', dropRevokedCookies);
        dropRevokedCookies();
    })();
</script>

            
