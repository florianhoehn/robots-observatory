	var mpcPrevio = localStorage.getItem('mpc_consentimiento');
	if (mpcPrevio) {
		var mpcEstado = null;
		if (mpcPrevio === 'aceptado') {
			/* Formato antiguo v1: todo aceptado. */
			mpcEstado = { analiticas: true, publicidad: true };
		} else if (mpcPrevio === 'rechazado') {
			/* Formato antiguo v1: todo rechazado. */
			mpcEstado = { analiticas: false, publicidad: false };
		} else {
			mpcEstado = JSON.parse(mpcPrevio);
		}
