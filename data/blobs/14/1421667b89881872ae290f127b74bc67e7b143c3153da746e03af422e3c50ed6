<script>
    function getUserAgentType() {
        var userAgent = navigator.userAgent.toLowerCase();
        var userAgentType = "";

        if (userAgent) {
            if (userAgent.match(/(ipod|iphone|ipad)/)) {
                userAgentType = "appleMobile"; // apple devices
            } else if (userAgent.match(/android/)) {

                if (BobeDetectHMSDevices.checkHMSDevices()) { // Huawei device
                    userAgentType = "huaweiMobile";
                } else {
                    userAgentType = "androidMobile";  // other Android devices
                }
            }
        }
        return userAgentType;
    }
</script>

<script>
    var heightWindow;
    var heightDocument;
    var heightScrollable;
    var dropAndShopNewsletterModalEventsBound = false;

    function bindAskOnceDailyDealsNewsletterSubscribeModalEvents(modal) {
        if (!modal || dropAndShopNewsletterModalEventsBound) {
            return;
        }

        modal.addEventListener('ui-modal-submit', function(event) {
            event.preventDefault();
            Bobe.submitNewsletterSubscribeModalForm('#dropAndShopNewsletterForm');
        });

        dropAndShopNewsletterModalEventsBound = true;
    }

    function showAskOnceDailyDealsNewsletterSubscribeModal() {
        var cookieName = 'dotw_popup';
        var cookieTimeout = new Date();
        cookieTimeout.setMonth(cookieTimeout.getMonth() + 1);

        customElements.whenDefined('ui-modal').then(function() {
            var modal = document.getElementById('dropAndShopNewsletterPopup');
            var container = modal ? modal.querySelector('.body') : null;

            if (!modal || !container) {
                return;
            }

            bindAskOnceDailyDealsNewsletterSubscribeModalEvents(modal);
            modal.setLoading(true, 'Loading...');
            Cookies.set(cookieName, 'true', {
                path: '/',
                domain: 'bobshop.co.za',
                expires: cookieTimeout
            });

            fetch('/mobilejquery/jsp/newsletters/NewsletterSubscribeAskOnceDailyDealsDisplayModalAJAXHandler.jsp', {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            }).then(function(response) {
                if (!response.ok) {
                    throw new Error('Failed to load newsletter popup');
                }

                return response.text();
            }).then(function(html) {
                modal.setLoading(false);
                container.innerHTML = html;

                if (!html) {
                    modal.removeAttribute('black-friday');
                    return;
                }

                modal.toggleAttribute(
                    'black-friday',
                    container.querySelector('#dropAndShopNewsletterForm')?.dataset.dotwTheme === 'black-friday'
                );
                modal.show();
            }).catch(function() {
                modal.setLoading(false);
                modal.removeAttribute('black-friday');
            });
        });
    }

    function showAfterScrollAskOnceDailyDealsNewsletterSubscribeModal() {
        if (getPercentageScrolled() > 25) {
            showAskOnceDailyDealsNewsletterSubscribeModal();
            $(window).off(".dotwpopup");
        }
    }

    function getScrollableHeight() {
        heightWindow = $(window).height();
        heightDocument = $(document).height();
        heightScrollable = heightDocument - heightWindow;
    }

    function getPercentageScrolled() {
        var scrollTop = $(window).scrollTop();
        return Math.floor(scrollTop / heightScrollable * 100);
    }
</script>
