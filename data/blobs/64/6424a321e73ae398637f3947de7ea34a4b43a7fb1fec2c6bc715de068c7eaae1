    <script>
        class CheckMyAge {
            defaults = {
                'email_input_id': 'check_my_age_email',
                'password_input_id': 'check_my_age_password',
                'login_submit_id': 'check_my_age_submit',
                'login_form_id': 'check_my_age_login_form',
                'error_email_id': 'check_my_age_error_email',
                'error_password_id': 'check_my_age_error_password',
                'invalid_error_msg_class': '.check_my_age_invalid_error_msg',
                'login_error_class': 'login_error',
                'emailReg': /^([\-\w+\.]+@([\w-]+\.)+[\w-]{2,4})$/,
            }

            constructor() {
                this.config = this._findTargets();
                this.wrapper = document.getElementById('checkMyAgeWrapper');
                this._isPC = typeof page_params !== 'undefined' && page_params.platform === 'pc';

                this.addEventListeners();

                // Only initialize accessibility features on PC (focus trap, initial focus)
                if (this._isPC) {
                    this._initAccessibility();
                }
            }

            _initAccessibility() {
                // Focus the email input on load
                if (this.config.emailInput) {
                    this.config.emailInput.focus();
                }

                // Setup focus trap
                if (this.wrapper) {
                    this._setupFocusTrap();
                }
            }

            _setupFocusTrap() {
                const that = this;
                this.wrapper.addEventListener('keydown', (e) => {
                    if (e.key !== 'Tab') return;

                    const focusableElements = that._getFocusableElements();
                    if (focusableElements.length === 0) return;

                    const firstElement = focusableElements[0];
                    const lastElement = focusableElements[focusableElements.length - 1];

                    if (e.shiftKey && document.activeElement === firstElement) {
                        e.preventDefault();
                        lastElement.focus();
                    } else if (!e.shiftKey && document.activeElement === lastElement) {
                        e.preventDefault();
                        firstElement.focus();
                    }
                });
            }

            _getFocusableElements() {
                const selector = 'a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
                return Array.from(this.wrapper.querySelectorAll(selector)).filter(el => el.offsetParent !== null);
            }

            _findTargets() {
                return {
                    'loginForm': document.getElementById(this.defaults.login_form_id),
                    'emailInput': document.getElementById(this.defaults.email_input_id),
                    'passwordInput': document.getElementById(this.defaults.password_input_id),
                    'loginSubmit': document.getElementById(this.defaults.login_submit_id),
                    'errorEmail': document.getElementById(this.defaults.error_email_id),
                    'errorPassword': document.getElementById(this.defaults.error_password_id),
                    'invalidErrorMsg': document.querySelector(this.defaults.invalid_error_msg_class)
                }
            }

            addEventListeners() {
                const that = this;

                this.config.loginSubmit && this.config.loginSubmit.addEventListener('click', (e) => {
                    that.submitLogin(e);
                });
            }

            submitLogin(e) {
                e.preventDefault();
                e.stopImmediatePropagation();

                const that = this,
                    username_value = this.config.emailInput ? this.config.emailInput.value : "",
                    password_value = this.config.passwordInput ? this.config.passwordInput.value : "",
                    token = page_params.token;

                this.resetErrorMessages();

                if (!this.doEmailValidation() || !this.doPasswordValidation()) {
                    return false;
                } else {
                    MG_Utils.ajaxCall({
                        url: page_params.checkAgeLoginForm.ajax_url,
                        method: 'post',
                        data: {
                            'username': username_value,
                            'password': password_value,
                            'token': token
                        },
                        success: function (response) {
                            that.callbackRequest(response);
                        },
                        error: function (data) {
                            document.location = '/';
                        }
                    });
                }
            }

            callbackRequest(data) {
                if (data.success) {
                    if (data.redirect) {
                        document.location = data.redirect;
                    } else {
                        document.location = '/';
                    }
                } else {
                    const error = data.message || page_params.checkAgeLoginForm.errorMessages.requestFailed;
                    this.config.invalidErrorMsg && (this.config.invalidErrorMsg.innerHTML = error);
                    this.setErrorBlock(this.config.invalidErrorMsg, 'block');
                }
            }

            resetErrorMessages() {
                this.setErrorBlock(this.config.errorEmail, 'none');
                this.setErrorBlock(this.config.errorPassword, 'none');
                this.setErrorBlock(this.config.invalidErrorMsg, 'none');

                this.config.emailInput && this.config.emailInput.classList.remove(this.defaults.login_error_class);
                this.config.passwordInput && this.config.passwordInput.classList.remove(this.defaults.login_error_class);
            }

            setErrorBlock(_element, _display) {
                _element && (_element.style.display = _display);
            }

            doEmailValidation() {
                let result = true;
                if (this.config.emailInput) {
                    if (!(this.defaults.emailReg).test((this.config.emailInput.value).trim())) {
                        this.config.errorEmail.innerHTML = page_params.checkAgeLoginForm.errorMessages.isValidEmail;
                        result = false;
                    }
                } else {
                    result = false;
                }

                if (!result) {
                    this.setErrorBlock(this.config.errorEmail, 'block');
                    this.config.emailInput.classList.add(this.defaults.login_error_class);
                }

                return result;
            }

            doPasswordValidation() {
                let result = true;

                if (this.config.passwordInput && this.config.passwordInput.value.length === 0) {
                    this.config.errorPassword.innerHTML = page_params.checkAgeLoginForm.errorMessages.noEmptyPassword;
                    this.setErrorBlock(this.config.errorPassword, 'block');
                    this.config.passwordInput.classList.add(this.defaults.login_error_class);
                    result = false;
                }

                return result;
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            try {
                const checkMyAge = new CheckMyAge();
            } catch (e) {
                console.log("error in check_my_age.phtml: " + e.toString());
            }
        });

        page_params.checkAgeLoginForm = {
            ajax_url: "/login/",
            errorMessages: {
                noEmptyPassword: "The password cannot be empty.",
                isValidEmail: "Please enter a valid email address.",
                requestFailed: "Request failed"
            }
        }
    </script>
                            
