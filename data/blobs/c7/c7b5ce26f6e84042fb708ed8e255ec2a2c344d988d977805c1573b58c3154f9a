    <style>
        :root {
            --brand-color: #a11236;
            --brand-dark-color: #730d26;
            --surface-base-color: #fff;
            --surface-card-color: #ebedef;
            --heading-color: #a11236;
            --base-paragraph-text-color: #0b0d0e;
            --secondary-paragraph-text-color: #2e3338;
            --tertiary-paragraph-text-color: #505962;
            --text-link-color: #004d99;
            --text-link-hover-color: #a11236;
            --font-size-extra-large-plus: 1.5rem;
            --line-height-extra-large-plus: 2rem;
            --font-size-large-plus: 1.25rem;
            --line-height-large-plus: 1.5rem;
            --font-size-medium: 0.875rem;
            --line-height-medium: 1.25rem;
        }

        html {
            height: 100%;
        }

        body {
            display: grid;
            grid-template-rows: min-content 1fr min-content;
            box-sizing: border-box;
            min-width: 20rem;
            height: 100%;
            margin: 0;
            padding: 0;
            color: var(--base-paragraph-text-color);
            font-size: var(--font-size-medium);
            font-family: arial, helvetica, "Liberation Sans", sans-serif;
            background: var(--surface-base-color);
        }

        #top {
            height: 3rem;
            background-color: var(--brand-color);
        }

        #menu {
            height: 100%;
        }

        #menu, #contentArea {
            max-width: 61.25rem;
            margin: 0 auto;
            padding: 0 1rem;
        }

        .site-logo {
            width: 9.75rem;
            height: 100%;
        }

        .site-logo:hover {
            background: var(--brand-dark-color);
        }

        .site-logo a {
            display: flex;
            align-items: center;
            height: 100%;
            padding: 0 0.5rem;
        }

        .site-logo a svg {
            color: #fff;
        }

        .site-logo + .site-name {
            position: absolute;
            overflow: hidden;
            text-indent: -1000px;
        }

        a {
            color: var(--text-link-color);
            text-decoration: none;
        }

        a:hover {
            color: var(--text-link-hover-color);
            text-decoration: underline;
        }

        h1 {
            color: var(--heading-color);
            font-size: var(--font-size-extra-large-plus);
            line-height: var(--line-height-extra-large-plus);
        }

        h2 {
            color: var(--base-paragraph-text-color);
            font-size: var(--font-size-large-plus);
            line-height: var(--line-height-large-plus);
        }

        p, ul {
            font-size: var(--font-size-medium);
            line-height: var(--line-height-medium);
        }

        h1, h2, p, ul {
            margin: 0 0 1rem;
        }

        #contentArea {
            padding: 1rem;
        }

        #contentArea a {
            text-decoration: underline;
        }

        .site-footer {
            background: var(--surface-card-color);
            padding: 1rem;
        }

        .site-footer > hr {
            display: none;
        }

        .site-footer p {
            color: var(--tertiary-paragraph-text-color);
            text-align: center;
            margin: 0;
        }

        .site-footer p a {
            color: inherit;
        }
    </style>
