  (function () {
    const STORAGE_KEY = 'promotion-banner-closed';
    const banner = document.getElementById('promotion-banner');
    const closeBtn = document.getElementById('close-promotion-banner');

    if (!banner) return;

    function showBanner() {
      banner.style.display = 'block';
      document.body.classList.add('has-promotion-banner');
    }

    function hideBanner() {
      banner.style.display = 'none';
      document.body.classList.remove('has-promotion-banner');
    }

    function isExcludedPage() {
      const excludedPages = ['/618', '/1024', '/51', '/1111', '/1212'];
      const path = window.location.pathname.replace(/\/+$/, '');
      return excludedPages.some((page) => path === page || path === `${page}.html`);
    }

    function checkAndToggleBanner() {
      if (isExcludedPage() || localStorage.getItem(STORAGE_KEY) === '1') {
        hideBanner();
      } else {
        showBanner();
      }
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        hideBanner();
        localStorage.setItem(STORAGE_KEY, '1');
      });
    }

    window.PromotionBanner = {
      show: function () {
        showBanner();
        localStorage.removeItem(STORAGE_KEY);
      },
      hide: function () {
        hideBanner();
        localStorage.setItem(STORAGE_KEY, '1');
      },
      toggle: function () {
        if (banner.style.display === 'none') {
          this.show();
        } else {
          this.hide();
        }
      },
    };

    checkAndToggleBanner();
  })();
