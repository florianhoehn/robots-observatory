<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dunkin'</title>
    <style>
      :root {
        --dd-orange: #ff671f;
        --dd-pink: #da1884;
        --dd-pink-ink: #b81169;
        --bg: #fffaf5;
        --panel: #ffffff;
        --border: #f0ccab;
        --text: #3a2a1e;
        --muted: #7a6152;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 20px;
        background: var(--bg);
        background-image: radial-gradient(
            circle at 12% 18%,
            rgba(218, 24, 132, 0.07),
            transparent 42%
          ),
          radial-gradient(circle at 88% 82%, rgba(255, 103, 31, 0.09), transparent 46%);
        color: var(--text);
        font-family: "Helvetica Neue", Helvetica, Arial, "Segoe UI", Roboto, system-ui, sans-serif;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: 100%;
        max-width: 560px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 48px 44px 44px;
        box-shadow: 0 1px 2px rgba(58, 42, 30, 0.05), 0 12px 32px rgba(58, 42, 30, 0.08);
        text-align: center;
      }

      /* Official Dunkin' wordmark, inlined. Cloudflare inlines every external
         resource on upload, so this must never become an <img src>. */
      .brand {
        display: block;
        width: 100%;
        max-width: 236px;
        height: auto;
        margin: 0 auto 34px;
      }

      h1 {
        margin: 0 0 16px;
        font-size: 28px;
        line-height: 1.25;
        font-weight: 800;
        letter-spacing: -0.01em;
      }

      p.lede {
        margin: 0 auto;
        max-width: 42ch;
        color: var(--muted);
        font-size: 16.5px;
      }

      /* Cloudflare REQUIRES this token to be present in the markup or it
         refuses to save the page. Rendered, it produces Cloudflare's stock
         "Error 1006 / access denied" box — precisely the error message this
         page exists to replace — so it is hidden from view while staying in
         the DOM. Do not delete it. */
      .cf-token {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
        border: 0;
      }

      @media (max-width: 480px) {
        main {
          padding: 36px 24px 32px;
        }
        h1 {
          font-size: 24px;
        }
        p.lede {
          font-size: 15.5px;
        }
      }
    </style>
  </head>
