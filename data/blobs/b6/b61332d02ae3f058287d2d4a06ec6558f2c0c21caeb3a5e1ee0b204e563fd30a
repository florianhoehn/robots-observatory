<script type="text/ng-template" id="login-modal.html">
    <div class="row collapse login">
        <div class="small-12 column">
            <h1 class="title">LOG IN</h1>
        </div>
    </div>

    <div class="row">
        <div class="small-12 medium-11 large-10 medium-centered text-center column">
            <p class="content">
                Welcome back!
            </p>
        </div>
    </div>

    <div class="row" data-ti-login
         data-is-logged-in="false">
        <div class="small-12 medium-11 large-10 medium-centered column">
            <form name="loginForm" data-ng-submit="login(loginForm).then(close); $event.stopPropagation();">
                <label class="text-left" for="emailInput">Email address</label>
                <input id="emailInput"
                       name="email"
                       type="email"
                       data-ng-model="credentials.username"
                       data-ti-autoselect
                       data-ti-autofocus
                       placeholder=""
                       pattern="^[a-zA-Z0-9.!#$%&'*+\/=?^_`{|}~-]+@[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:\.[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*$"
                       minlength="2"
                       maxlength="40"
                       required
                />
                <div class="errors" ng-show="loginForm.$submitted || loginForm.email.$touched">
                    <div class="error" ng-show="loginForm.email.$error.email">{{ 'form.validation.pattern.email' | tiTranslate:{'name': 'email address'} }}</div>
                    <div class="error" ng-show="loginForm.email.$error.required">{{ 'form.validation.required' | tiTranslate:{'name': 'email address'} }}</div>
                    <div class="error" ng-show="loginForm.email.$error.minlength">{{ 'form.validation.minlength' | tiTranslate:{'name': 'email address', 'value': 2} }}</div>
                    <div class="error" ng-show="loginForm.email.$error.maxlength">{{ 'form.validation.maxlength' | tiTranslate:{'name': 'email address', 'value': 40} }}</div>
                </div>

                <label for="passwordInput" class="text-left password-label">Password</label>
                <div class="row collapse">
                    <input id="passwordInput"
                           name="password"
                           type="password"
                           data-ti-autoselect
                           data-ng-model="credentials.password"
                           data-ti-valid-change="resetValidation(loginForm.password)"
                           required
                    />
                </div>
                <div class="errors" ng-show="loginForm.$submitted || loginForm.password.$touched">
                    <div class="error" ng-show="loginForm.password.$error.required">{{ 'form.validation.required' | tiTranslate:{'name': 'password'} }}</div>
                    <div class="error" ng-show="loginForm.password.$error.login_failed">{{ 'form.login.invalid_credentials' | tiTranslate:{'name': 'password'} }}</div>
                </div>

                <button class="button expand action primary" data-ti-submit-button data-tracker="loginTracker" force-state="active">
                    <span class="active">Log in</span>
                    <span class="busy">
                        <span class="spinner">...</span>
                    </span>
                </button>
            </form>
            <div class="text-center">
                <div>
                    <p>
                        <a href="https://www.theiconic.com.au/customer/account/resetpassword/">Reset Password</a>
                    </p>
                </div>
            </div>
        </div>

        <div class="small-12 medium-10 column note">
            <p>
                Don't have an account?
                <a href="https://www.theiconic.com.au/customer/account/create/">Create an account</a>
            </p>
        </div>
    </div>
</script>
