            var gAnalytics = (window.ga) ? 1 : null;

            if (isModal) {
                action += ' from Modal';
                $.facebox_freecall.close();
            }

            if (gAnalytics === null) {
                console.log('No analytics... no events for you sorry.');
                return;
            } else {
                console.log('[analytics] Tracking...');
                gtag('event', action, {
                    'event_category': category
                });
                return;
            }
        }
    
