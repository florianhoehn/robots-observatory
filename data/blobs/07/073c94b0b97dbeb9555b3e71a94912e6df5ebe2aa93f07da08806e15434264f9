<script>
  
$(window).on("load", function () {
  var $window = $(window);
  var $body = $("body");

  // main
  var $menuButton = $(".js-MainHeader-menuButton");
  var $menuItem = $(".js-Menu-item");
  var $mainHeader = $(".js-MainHeader");
  var $langButton = $(".js-LanguageSwitcher-button");

  // menu fixed behaviour
  var scrollTimeout;
  var throttle = 50;
  console.log("hello");

  $window.on("scroll", function () {
    if (!scrollTimeout) {
      scrollTimeout = setTimeout(function () {
        var scrollTop = $window.scrollTop();

        if (scrollTop > 250 && !$body.hasClass("menu-open")) {
          $body.addClass("menu-fixed");
          if (scrollTop > 450) {
            $body.addClass("menu-visible");
            if (scrollTop > 600) {
              $body.addClass("popup-visible");
            } else {
            }
          } else {
            $body.removeClass("menu-visible");
          }
        } else {
          $body.removeClass("menu-fixed");
        }
        scrollTimeout = null;
      }, throttle);
    }
  });

  $body.on("click", function (event) {
    if (
      $("body").find(".MainHeader--showBurgerOnDesktop").length > 0 &&
      $body.hasClass("menu-open")
    ) {
      var clickedOutside =
        $(event.target).closest(".js-MainHeader").length == 0;
      if (clickedOutside && $body.hasClass("menu-open")) {
        $body.removeClass("menu-open");
        $body.removeClass("js-desktop-burger-menu-open");
      }
    }
  });

  // menu open/close function
  $menuButton.on("click", function (e) {
    if ($body.hasClass("menu-open")) {
      document.querySelector("body").classList.remove("menu-open");
    } else {
      document.querySelector("body").classList.add("menu-open");
    }

    if ($("body").find(".MainHeader--showBurgerOnDesktop").length > 0) {
      if ($body.hasClass("js-desktop-burger-menu-open")) {
        $body.removeClass("js-desktop-burger-menu-open");
      } else {
        $body.addClass("js-desktop-burger-menu-open");
      }
    }
  });

  // menu item active function
  $menuItem.on("click", function () {
    var $this = $(this);

    if (
      $window.width() > 768 &&
      $("body").find(".MainHeader--showBurgerOnDesktop").length == 0
    ) {
      return;
    }

    if ($("body").find(".MainHeader--showBurgerOnDesktop").length == 0) {
      $("html, body").animate(
        { scrollTop: $(".MainHeader-menuContainer").offset().top },
        1000
      );
    }

    if ($this.hasClass("is-active")) {
      $this.removeClass("is-active");
    } else {
      $mainHeader.find(".js-Menu-item").removeClass("is-active");
      $this.addClass("is-active");
    }
  });

  // Language Switcher
  $langButton.add(".LanguageSwitcher-label").on("click", function () {
    $(this).parent(".LanguageSwitcher").toggleClass("is-active");
  });

  // old js
  $('a[href="#search"]').on("click", function (event) {
    event.preventDefault();
    $("#search").addClass("open");
    $("body").addClass("body-overflow");
    $('#search > form > input[type="search"]').focus();
  });

  $("#search, #search button.close").on("click keyup", function (event) {
    if (
      event.target == this ||
      event.target.className == "close" ||
      event.keyCode == 27
    ) {
      $(this).removeClass("open");
      $("body").removeClass("body-overflow");
    }
  });

  $("#search > form").submit(function (event) {
    event.preventDefault();
    return false;
  });
});

</script>
    

