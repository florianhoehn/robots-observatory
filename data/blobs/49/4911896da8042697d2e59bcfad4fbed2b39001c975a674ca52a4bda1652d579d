<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Something went wrong</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Font Awesome -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  />
  <link rel="icon" href="/nvp/error-pages/live/5XX/favicon.ico" type="image/x-icon">

  <style>

    @font-face {
    font-family: bp-sans;
      src: url("/nvp/error-pages/live/5XX/bpSans-Regular.woff2") format("truetype")
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: bp-sans, Arial, Helvetica, sans-serif;
    }

    body {
      background: #fafaf6;
      color: #222;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 1200px;
      padding: 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 80px;
    }

    .content {
      max-width: 480px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 40px;
    }

    .logo img {
      width: 78px;
      height: 78px;
    }

    .logo span {
      font-size: 16px;
      color: #2e7d32;
      font-weight: 600;
    }

    h1 {
      font-weight: 400;
      font-size: 40px;
      margin-bottom: 20px;
    }

    p {
      font-size: 16px;
      color: #555;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .social {
      display: flex;
      gap: 18px;
    }

    .social a {
      font-size: 20px;
      text-decoration: none;
      color: #9e9e9e; /* default gray */
	  transition: transform 0.2s ease, color 0.2s ease;
    }

    .social a:hover {
      transform: scale(1.15);
    }

    /* Brand colors on hover only */
	.social a.facebook:hover { color: #1877f2; }
	.social a.x:hover { color: #000000; }
	.social a.linkedin:hover { color: #0a66c2; }
	.social a.youtube:hover { color: #ff0000; }

	.social a.instagram:hover {
	  background: linear-gradient(45deg,#f58529,#dd2a7b,#8134af,#515bd4);
	  -webkit-background-clip: text;
	  -webkit-text-fill-color: transparent;
	}

    .globe-wrapper {
      width: 260px;
      height: 260px;
      flex-shrink: 0;
    }

    .globe-wrapper img {
      width: 100%;
      height: 100%;
      display: block;
    }

    @media (max-width: 900px) {
      .container {
        flex-direction: column;
        text-align: center;
      }

      .social {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="content">
      <div class="logo">
        <img
          src="/nvp/error-pages/live/5XX/bp-logo.svg"
          alt="bp logo"
        />
      </div>

      <h1>Something went wrong</h1>
      <p>
        An unexpected server error has occurred.<br />
        Please try again later.
      </p>

      <div class="social">
        <a href="https://www.facebook.com/bp/" class="facebook"><i class="fab fa-facebook-f"></i></a>
        <a href="https://twitter.com/bp_plc" class="x"><i class="fab fa-x-twitter"></i></a>
        <a href="https://www.linkedin.com/company/bp" class="linkedin"><i class="fab fa-linkedin-in"></i></a>
        <a href="https://www.youtube.com/bp" class="youtube"><i class="fab fa-youtube"></i></a>
        <a href="https://www.instagram.com/bp_plc" class="instagram"><i class="fab fa-instagram"></i></a>
      </div>
    </div>

    <!-- External SVG globe -->
    <div class="globe-wrapper">
      <img src="/nvp/error-pages/live/5XX/globe.svg" alt="Globe icon" />
    </div>
  </div>

</body>
</html>

