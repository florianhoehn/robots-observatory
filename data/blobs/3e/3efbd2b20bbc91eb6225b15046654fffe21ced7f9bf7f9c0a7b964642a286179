<!DOCTYPE html><html lang="ru"><head><meta charset="UTF-8"><title>Доступ запрещен</title><style>body{margin:0;font-family:sans-serif;background:#fff;color:#333;display:flex;flex-direction:column;justify-content:center;align-items:center;height:100vh;text-align:center}h1{font-size:3em;margin:0}p{margin:.5em 0}small{color:#999;font-size:.8em}footer{position:absolute;bottom:1em;font-size:.8em;color:#999}.request{margin-top:8px;font-family:"Noto Sans JP","Montserrat",Arial,sans-serif;color:var(--muted);font-size:14px;letter-spacing:0.4px;}.support-btn{margin-top:20px;padding:10px 20px;font-size:14px;font-weight:600;background:var(--accent);color:#ffffff;;border:none;border-radius:8px;cursor:pointer;background:#161C24;}.support-btn:hover{background:#142B4F;}</style></head><body><h1 id="error-status">403</h1><p>Доступ запрещен</p><p class="request" id="req-id"><small>Идентификатор запроса: ce75cb985c3e112f5dbcae89ffb4d3e4</small></p><button class="support-btn" onclick="sendSupportEmail()">Поддержка: waf.support@gardatech.ru &mdash; Garda WAF</button><script>function sendSupportEmail(){const requestId=document.getElementById('req-id').textContent.replace('Request ID: ','').trim();const hostName=window.location.hostname;const weblockHttpStatus=document.getElementById('error-status').textContent.trim();const path=window.location.pathname;const subject=encodeURIComponent(`Обращение по блокировке на ресурсе ${hostName}`);const body=encodeURIComponent(`Здравствуйте, возникла ошибка: "${weblockHttpStatus} - Доступ запрещен".\n\n${requestId}\nHost: ${hostName}\nPath: ${path}\n\nПрошу помочь в решении вопроса. Спасибо!`);window.location.href=`mailto:waf.support@gardatech.ru?subject=${subject}&body=${body}`;}</script></body></html>