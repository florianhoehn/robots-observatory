<!-- Zenchef Partner Flow — Shared Utilities -->
<script>
// ═══════════════════════════════════════════════════════════════
// ZENCHEF PARTNER FLOW — SHARED UTILITIES
// Load via Project Settings → Custom Code → Footer Code
// Must load before any page-specific script.
// ═══════════════════════════════════════════════════════════════

window.ZC = (function () {

  const _lm = window.location.pathname.match(/^\/(fr|de|nl|be-nl|be-fr)(\/|$)/);
  const BASE_PATH = (_lm ? '/' + _lm[1] : '') + '/become-a-partner';
  const SESSION_KEY = 'zc_partner_flow';

  // ─── Scoring weights ─────────────────────────────────────────────
  // country, tech (yes/no), and mktg are intentionally unscored.
  const SCORE = {
    partnership: { strategic: 3, technical: 2, marketing: 2, referral: 1 },
    usecase: {
      'proactive-integration': 2, 'mutual-clients': 1,
      'offer-reservations': 1,    'referrals-from-zenchef': 0,
      'early-stage': 0,            other: 0
    },
    // S1: 0-500=0 / 500-3k=1 / 3k-10k=3 / 10k+=5
    s1: { 0: 0, 1: 1, 2: 3, 3: 5 },
    // S2: 0=0 / 1-200=1 / 200-2k=3 / 2k+=5  (not-sure handled in scope.js → 0)
    s2: { 0: 0, 1: 1, 2: 3, 3: 5 }
  };

  // ─── Paths (for progress bar only) ───────────────────────────────────
  const PATHS = {
    strategic: ['country', 'partnership', 'tech', 'usecase', 'scope', 'contact'],
    technical: ['country', 'partnership', 'tech', 'usecase', 'scope', 'contact'],
    marketing: ['country', 'partnership', 'mktg', 'scope', 'contact'],
    referral:  ['country', 'partnership', 'scope', 'contact'],
    _default:  ['country', 'partnership', 'tech', 'usecase', 'scope', 'contact']
  };

  // ─── Session state ──────────────────────────────────────────────
  function loadState() {
    try { return JSON.parse(sessionStorage.getItem(SESSION_KEY) || '{}'); }
    catch { return {}; }
  }

  function saveState(patch) {
    const next = Object.assign({}, loadState(), patch);
    sessionStorage.setItem(SESSION_KEY, JSON.stringify(next));
    return next;
  }

  function clearState() {
    sessionStorage.removeItem(SESSION_KEY);
  }

  // ─── Progress bar ─────────────────────────────────────────────────────────
  // Reads pre-built .step__container divs, toggles is-done / is-current
  function renderProgress(currentStep) {
    const bar = document.querySelector('[data-partner="progress-bar"]');
    if (!bar) return;

    const state = loadState();
    const path  = PATHS[state.partnership] || PATHS._default;
    const cur   = path.indexOf(currentStep);
    const total = path.length;

    bar.querySelectorAll('.step__container').forEach((seg, i) => {
      seg.style.display = i < total ? '' : 'none';
      seg.classList.remove('is-done', 'is-current');
      if (i < cur)        seg.classList.add('is-done');
      else if (i === cur) seg.classList.add('is-current');
    });
  }

  // ─── Back / Next buttons ────────────────────────────────────────────────
  function renderNav(showBack, nextEnabled) {
    const btnBack = document.querySelector('[data-partner="btn-back"]');
    const btnNext = document.querySelector('[data-partner="btn-next"]');
    if (btnBack) btnBack.style.visibility = showBack ? 'visible' : 'hidden';
    if (btnNext) setNextEnabled(nextEnabled);
  }

  function setNextEnabled(enabled) {
    const btn = document.querySelector('[data-partner="btn-next"]');
    if (!btn) return;
    btn.disabled = !enabled;
    btn.classList.toggle('is-disabled', !enabled);
  }

  // ─── Option card selection ──────────────────────────────────────────────
  // Attaches click handlers to all [data-group][data-val] elements.
  // Calls cb(value, score) on selection.
  function onOptionSelect(group, cb) {
    document.querySelectorAll('[data-group="' + group + '"]').forEach(el => {
      el.addEventListener('click', () => {
        document.querySelectorAll('[data-group="' + group + '"]')
          .forEach(c => c.classList.remove('is-selected'));
        el.classList.add('is-selected');
        const val   = el.dataset.val;
        const score = (SCORE[group] && SCORE[group][val]) || 0;
        cb(val, score);
      });
    });
  }

  // ─── Restore saved selection on back-navigation ───────────────────────
  function restoreSelection(group) {
    const saved = loadState()[group];
    if (!saved) return;
    document.querySelectorAll('[data-group="' + group + '"]').forEach(el => {
      el.classList.toggle('is-selected', el.dataset.val === saved);
    });
  }

  // ─── Next / Back button wiring ────────────────────────────────────────────
  function onNext(cb) {
    document.querySelector('[data-partner="btn-next"]')
      ?.addEventListener('click', cb);
  }

  function onBack(href) {
    document.querySelector('[data-partner="btn-back"]')
      ?.addEventListener('click', (e) => {
        e.preventDefault();
        window.location.href = href;
      });
  }

  // ─── requireStep guard ─────────────────────────────────────────────────────────────
  function requireStep(key) {
    if (!loadState()[key]) window.location.replace(BASE_PATH + '/country');
  }

  // ─── Public API ───────────────────────────────────────────────────────────────
  return {
    BASE_PATH, SESSION_KEY, SCORE, PATHS,
    loadState, saveState, clearState,
    renderProgress, renderNav, setNextEnabled,
    onOptionSelect, restoreSelection, onNext, onBack, requireStep
  };

})();
</script>
