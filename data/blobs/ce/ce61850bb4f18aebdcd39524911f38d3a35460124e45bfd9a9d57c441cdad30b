<script type="text/javascript" nonce="">
  (function() {
    window.__bsPageErrors = [];

    // Substring matching on "browserstack.com" used to leak third-party scripts
    // (e.g. googleads viewthroughconversion URLs that embed our page URL as a query param).
    // Parse the hostname and match it exactly. bsstag.com is our staging / REG host —
    // without it, blank-page alerts on staging carry no underlying JS/asset error.
    var OUR_HOST_RE = /(^|\.)(browserstack\.com|bsstag\.com|cloudfront\.net)$/;
    function isOurHost(urlStr) {
      if (!urlStr) return false;
      try {
        return OUR_HOST_RE.test(new URL(urlStr, location.href).hostname);
      } catch (e) {
        return false;
      }
    }

    window.addEventListener('error', function(e) {
      try {
        var el = e.target;

        if (el && el !== window && el.tagName) {
          if (['SCRIPT', 'LINK'].indexOf(el.tagName) !== -1) {
            var src = (el.src || el.href || '');
            // blob: scripts come from dynamically-injected SDKs (Google GSI, reCAPTCHA);
            // their origin is our page, but the code is not ours.
            if (src && src.slice(0, 5) !== 'blob:' && isOurHost(src)) {
              window.__bsPageErrors.push({
                type: 'asset_load_failure',
                tagName: el.tagName,
                src: src,
                timestamp: Date.now()
              });
            }
          }
          return;
        }

        if (e.filename && isOurHost(e.filename)) {
          window.__bsPageErrors.push({
            type: 'js_error',
            message: e.message || 'Unknown error',
            filename: e.filename,
            lineno: e.lineno,
            colno: e.colno,
            timestamp: Date.now()
          });
        }
      } catch (collectorErr) { }
    }, true);

    window.addEventListener('unhandledrejection', function(e) {
      try {
        var reason = e.reason;
        var stack = (reason && reason.stack) ? reason.stack : '';
        if (
          stack.indexOf('browserstack.com') !== -1 ||
          stack.indexOf('bsstag.com') !== -1 ||
          stack.indexOf('cloudfront.net') !== -1
        ) {
          window.__bsPageErrors.push({
            type: 'unhandled_promise',
            message: String(reason && reason.message ? reason.message : reason),
            timestamp: Date.now()
          });
        }
      } catch (collectorErr) {}
    });
  })();
