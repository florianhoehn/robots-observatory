<script>
    const ribbon = document.querySelector('.notice-ribbon-area');

    if (ribbon) {
        if (ribbon.classList.contains('hide-notice-ribbon')) {
            document.body.classList.remove('has-notice-ribbon');
        } else {
            document.body.classList.add('has-notice-ribbon');
        }

        const placeRibbon = () => {
            const topBar = document.querySelector('.main-nav__top-bar-container');
            const mainHeader = document.querySelector('.main-header');
            const logoArea = mainHeader && mainHeader.querySelector('.logo-area');
            const desktopTopBarParent = topBar && topBar.parentNode;
            const desktopTopBarNext = topBar && topBar.nextElementSibling;
            const ribbonContainer = ribbon.closest('.noticeribbon') || ribbon;
            const desktopRibbonParent = ribbonContainer.parentNode;
            const headerWrapper = document.querySelector('.header-wrapper');
            const logoContainer = topBar && topBar.parentNode;

            if (!topBar || !mainHeader || !logoArea || !headerWrapper || !logoContainer) {
                return;
            }

            const updatePlacement = () => {
                if (window.innerWidth <= 1200) {
                    mainHeader.insertBefore(topBar, logoArea);
                    topBar.appendChild(ribbonContainer);
                    document.body.classList.add('responsive-notice-layout');
                } else {
                    if (desktopTopBarNext && desktopTopBarNext.parentNode === desktopTopBarParent) {
                        desktopTopBarParent.insertBefore(topBar, desktopTopBarNext);
                    }
                    if (ribbonContainer.parentNode !== desktopRibbonParent) {
                        desktopRibbonParent.insertBefore(ribbonContainer, headerWrapper);
                    }
                    document.body.classList.remove('responsive-notice-layout');
                }
            };

            window.addEventListener('resize', updatePlacement);
            updatePlacement();
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', placeRibbon, { once: true });
        } else {
            placeRibbon();
        }
    }
</script></div>

