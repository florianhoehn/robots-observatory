<!-- Tracking -->
<script type="application/javascript">
  const Breakpoints = {
    default: 0,
    b560: 560,
    b960: 960,
    b1280: 1280,
    b1600: 1600,
    b1920: 1920,
    b2560: 2560
  };

  const ORIENTATION = {
    HORIZONTAL: 'h',
    VERTICAL: 'v'
  };

  const isInBrowser = () => {
    return typeof window !== 'undefined' && typeof window.document !== 'undefined';
  }

  const getBrowserOrientation = () => {
    if (isInBrowser() && window.matchMedia) {

      return window.matchMedia('(orientation: portrait)').matches
              ? ORIENTATION.VERTICAL
              : ORIENTATION.HORIZONTAL;
    }

    return '';
  }

  const matchMediaQuery = (minWidth, maxWidth) => {
    if (!maxWidth) {
      return window.matchMedia('screen and (min-width: ' + minWidth + 'px)').matches;
    }

    return window.matchMedia('screen and (max-width: ' + maxWidth + 'px) and (min-width: ' + minWidth + 'px)').matches;
  }

  const getBreakpoint = () => {
    if (window.matchMedia) {
      if (matchMediaQuery(Breakpoints.b560, Breakpoints.b960)) {
        return String(Breakpoints.b560);
      } else if (matchMediaQuery(Breakpoints.b960, Breakpoints.b1280)) {
        return String(Breakpoints.b960);
      } else if (matchMediaQuery(Breakpoints.b1280, Breakpoints.b1600)) {
        return String(Breakpoints.b1280);
      } else if (matchMediaQuery(Breakpoints.b1600, Breakpoints.b1920)) {
        return String(Breakpoints.b1600);
      } else if (matchMediaQuery(Breakpoints.b1920, Breakpoints.b2560)) {
        return String(Breakpoints.b1920);
      } else if (matchMediaQuery(Breakpoints.b2560)) {
        return String(Breakpoints.b2560);
      }
      return '0';
    }

    return '';
  }

  // this is the way that vw bootstrapper library works, right now, there is not any proper function call
  const vwData = window.vwdata;
  const referrer = document.referrer;
  if (vwData && typeof vwData.push === 'function') {
    vwData.push({
      eventInfo: {
        eventAction: "VWBasic_Error_Pageload",
        templateType: "Non\u002DReact Simple Page",
        pageName: "Error 404",
        pageId: window.location.hostname + window.location.pathname
      },
      environment: {
        language: "de",
        country: "DE",
        applicationId: "VWCMSD6",
        applicationIdVersion: "3.205.283.128"
      },
      user: {
        browserResolutionHeight: window.screen.height.toString(),
        browserResolutionWidth: window.screen.width.toString(),
        browserResolutionOrientation: getBrowserOrientation(),
        browserResolutionBreakpoint: getBreakpoint()
        //loginStatus: false
      },
      error: {
        code: "404",
        message: "Not Found",
        referringUrl: referrer
      }
    });
  }
</script>






    
