    function resolveClickLocation(el) {
      var tagged = el.closest('[data-section]');
      if (tagged) return tagged.getAttribute('data-section');

      if (el.closest('.cc-nav')) return 'nav';
      if (el.closest('.cc-footer')) return 'footer';
      if (el.closest('.pre-footer')) return 'pre_footer';

      var section = el.closest('section');
      if (section) {
        if (section.hasAttribute('data-wf--hero--variant')) return 'hero';

        var heading = findClosestHeading(el);
        if (heading && heading.innerText) {
          var slug = slugify(heading.innerText);
          if (slug) return slug;
        }

        var eyebrow = section.querySelector('.eyebrow');
        if (eyebrow && eyebrow.innerText) {
          var eyebrowSlug = slugify(eyebrow.innerText);
          if (eyebrowSlug) return eyebrowSlug;
        }

        var component = resolveComponent(el);
        if (component) return component;

        var all = document.querySelectorAll('section');
        for (var i = 0; i < all.length; i++) {
          if (all[i] === section) return 'section_' + (i + 1);
        }
      }

      return 'body';
    }

    // ============================================================
    // mkt_page_viewed (Amplitude only — GA4 has page_view auto)
    // ============================================================
    function trackPageView() {
      var ref = document.referrer;
      var refDomain = '';
      try { if (ref) refDomain = new URL(ref).hostname.replace(/^www\./, ''); } catch (e) {}

      var payload = {
        outreach_device_id: outreach_device_id,
        url: window.location.href,
        page_path: window.location.pathname,
        referrer: ref,
        referring_domain: refDomain,
        traffic_type: classifyTraffic(null)
      };

      var utms = getUtmParams();
      Object.keys(utms).forEach(function (k) { payload[k] = utms[k]; });

      trackAmplitude('mkt_page_viewed', payload);
    }

    // ============================================================
    // mkt_cta_clicked (Amplitude + dataLayer)
    // ============================================================
    document.addEventListener('click', function (event) {
      var clicked = event.target.closest('button, a');
      if (!clicked) return;

      // Webflow link-cover pattern: clickable anchor sits inside a styled wrapper
      var wrapper = null;
      if (clicked.tagName === 'A' && /\bu-link-cover\b/.test(clicked.className)) {
        wrapper = clicked.parentElement;
      }
      var displayEl = wrapper || clicked;

      // Text: .btn-text → heading → innerText
      var text = '';
      if (wrapper) {
        var btnText = wrapper.querySelector('.btn-text');
        if (btnText) text = (btnText.innerText || '').trim();
        if (!text) {
          var h = wrapper.querySelector('h1, h2, h3, h4, h5, h6');
          if (h) text = (h.innerText || '').trim();
        }
      }
      if (!text) text = (displayEl.innerText || '').trim();

      var isBtnStyle =
        displayEl.tagName === 'BUTTON' ||
        displayEl.hasAttribute('data-wf--button--button-variant') ||
        /(^|\s)button(\s|_|-|$)/.test(displayEl.classList.value || '');

      var location = resolveClickLocation(clicked);
      var component = resolveComponent(clicked);

      var navType = '';
      var parentDropdown = '';
      if (location === 'nav') {
        if (clicked.closest('.nav-logo_link')) navType = 'logo';
        else if (clicked.closest('.nav-cta-wrapper')) navType = 'cta';
        else if (clicked.closest('.nav-dropdown_content')) navType = 'dropdown_item';
        else if (clicked.closest('.w-dropdown-toggle')) navType = 'top_nav_dropdown';
        else navType = 'top_nav_link';

        var pd = clicked.closest('.nav-dropdown');
        if (pd) {
          var toggle = pd.querySelector('.w-dropdown-toggle');
          if (toggle) parentDropdown = (toggle.innerText || '').trim();
        }
      }

      trackDual('mkt_cta_clicked', {
        outreach_device_id: outreach_device_id,
        url: window.location.href,
        page_path: window.location.pathname,
        cta_text: text.slice(0, 200),
        cta_href: clicked.getAttribute('href') || '',
        cta_type: isBtnStyle ? 'button' : 'link',
        click_location: location,
        component: component,
        nav_type: navType,
        parent_dropdown: parentDropdown,
        traffic_type: classifyTraffic(event),
        behavior_score: getBehaviorScore(event)
      });
    }, { passive: true });


    function bindMarketo() {
      if (typeof MktoForms2 === 'undefined') return false;
      MktoForms2.whenReady(function (form) {
        form.onSuccess(function (values) {
          var id = String(form.getId());
          var formName = FORM_NAMES[id];

          // Warn in console when a submitted form isn't in the lookup,
          // so it gets caught in dev/staging before reaching prod analytics
          if (!formName) {
            console.warn(
              '[mkt_form_submitted] Unmapped Marketo form ID:', id,
              '— add to FORM_NAMES lookup in head tracking script.',
              'Event still fired with form_name="unknown".'
            );
          }

          trackDual('mkt_form_submitted', {
            outreach_device_id: outreach_device_id,
            date_acquired: new Date().toISOString(),
            url: window.location.href,
            page_path: window.location.pathname,
            form_id: id,
            form_name: formName || 'unknown',
            first_name: values.FirstName || '',
            last_name: values.LastName || '',
            email: values.Email || '',
            traffic_type: classifyTraffic(null)
          });
          // Return value ignored — existing GTM listener returns false
          // to suppress default redirect and handles it via eventCallback
        });
      });
      return true;
    }

    if (!bindMarketo()) {
      var tries = 0;
      var iv = setInterval(function () {
        if (bindMarketo() || ++tries > 40) clearInterval(iv);
      }, 500);
    }


    trackPageView();
  })();
</script>

