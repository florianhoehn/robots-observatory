            renderAd: function(Ad, dlApi, window) {
                if (Ad.meta.slot === 'flat-natleft' || Ad.meta.slot === 'flat-natleft2' || Ad.meta.slot === 'flat-natleft3') {
                    let el = document.getElementById(Ad.div);
                    el.href = Ad.meta.adclick + Ad.fields.url;
                    el.querySelector('.item_title').innerText = Ad.fields.title;
                    let lead = el.querySelector('.item_lead');
                    if(lead) {
                        lead.innerHTML = Ad.fields.leadtext || '';
                    }
                    const premiumLabel = el.querySelector('.ico-closed-container');
                    if(premiumLabel) {
                        premiumLabel.remove();
                    }

                    let dateElement = el.querySelector('.item_date');
                    if (Ad.meta.slot === 'flat-natleft3') {
                        dateElement.innerHTML = '';
                    }

                    let category = el.querySelector('.item_category, .item_sponsored-sign');
                    if (Ad.fields.adInfo) {
                        category.innerText = Ad.fields.adInfo;

                        if (Ad.fields.partner_logo) {
                            let partnerLogo = document.createElement('img');
                            partnerLogo.className = 'partner-label-img';
                            partnerLogo.src = Ad.fields.partner_logo;
                            
                                partnerLogo.style.marginTop = '-15px';
                                partnerLogo.style.maxWidth = '150px';
                            
                            dateElement.innerHTML = '';
                            dateElement.appendChild(partnerLogo);
                        } else {
                            dateElement.innerHTML = '';
                        }
                    } else if (Ad.meta.slot === 'flat-natleft3' && !Ad.fields.adInfo) {
                        category.innerText = 'MATERIAŁ PROMOCYJNY';
                    } else {
                        category.innerText = '';
                    }

                    let picture = el.querySelector('picture');
                    let sources = picture.querySelectorAll('source');
                    sources.forEach((source) => {
                        picture.removeChild(source);
                    });
                    let img = picture.querySelector('img');
                    img.src = Ad.fields.image;
                    img.alt = Ad.fields.title;

                    if(el.hasAttribute('data-allow-layer')) {
                        el.removeAttribute('data-allow-layer');
                    }
                }
            }
        });
