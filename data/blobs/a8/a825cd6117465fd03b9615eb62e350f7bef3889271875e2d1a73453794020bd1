  }
  .menu.right .usermenu-list li a:hover { background: #525252; }
  .menu.right .usermenu.open .usermenu-caret { transform: rotate(180deg); }
}

/* Blue / light theme dropdown surfaces to match the rest of the site */
html.theme-blue .menu.right .usermenu-list { background: #2e3c4a; }
html.theme-blue .menu.right .usermenu-list li a:hover { background: #3c4f61; }
