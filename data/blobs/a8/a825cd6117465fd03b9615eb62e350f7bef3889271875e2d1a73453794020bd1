@media (max-width: 600px) {
  .menu.right .usermenu-list { display: block; }
  .menu.right .usermenu-caret { display: none; }
  .menu.right .usermenu-toggle { pointer-events: none; }
  .menu.right .usermenu-av { width: 28px; height: 28px; }
  .menu.right .usermenu-label {
