/* Card wrapper is the positioning context for the title. */
.gallery, .gallery-favorite { position: relative; }

/* Base .thumb: just a positioning context, NO fixed height. After the image loads
   this wraps the image at its NATURAL size, so the title sticks right under the
   actual image (each card can be a different height — that's intended). */
.thumb{ position:relative; display:block; width:100%; }

/* ---------------- GRID thumbnails (home / search / results / popular) ----------------
   WHILE loading only: reserve a 140% box + show the spinner, because the <img> is a
   1x1 transparent gif until the lazyload script swaps in the real src. */
.gallery .cover .thumb:has(> img.lazyload){
  height:0;
  padding-bottom:140%;
  overflow:hidden;
  background:#1a1a1a;
  border-radius:5px 5px 0 0;
}
.gallery .cover .thumb:has(> img.lazyload) > img{
  position:absolute !important;
  top:0 !important; left:0 !important;
  width:100% !important;
  height:100% !important;
  max-width:none !important;
  margin:0 !important;
  object-fit:contain !important;
  z-index:2 !important;
  background:transparent !important;
}
/* AFTER load: the pre-existing app.blade.php rule
   `.gallery .cover img{position:static;width:100%;height:auto}` renders the image at
   its real size; .thumb has no height so it wraps the image and .caption (top:100%)
   sits flush under the ACTUAL image — no gap, no zoom, natural per-image size. */

/* ---------------- READER page thumbnails (/g/ page) ----------------
   Keep uniform boxes (inline padding-bottom from the real page dims) + fill + spinner. */
.thumb-container .gallerythumb{ display:block; width:100%; }
.thumb-container .thumb{
  height:0;
  overflow:hidden;
  background:#1a1a1a;
  border-radius:4px;
}
.thumb-container .thumb > img{
  position:absolute !important;
  top:0 !important; left:0 !important;
  width:100% !important;
  height:100% !important;
  max-width:none !important;
  margin:0 !important;
  object-fit:contain !important;
  z-index:2 !important;
  background:transparent !important;
}

/* ---------------- Spinner (shown only while a .lazyload image is present) ---------------- */
.thumb::before{
  content:"";
  position:absolute; top:50%; left:50%;
  width:42px; height:42px; margin:-21px 0 0 -21px; z-index:1;
  border-radius:50%;
  background:conic-gradient(#ed2553, transparent 70%);
  -webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 0);
          mask:radial-gradient(farthest-side,transparent calc(100% - 4px),#000 0);
  animation:thumbspin .9s linear infinite;
}
@keyframes thumbspin{ to{ transform:rotate(360deg) } }
/* hide the spinner once the image has loaded (no .lazyload child left) */
.thumb:not(:has(> img.lazyload))::before{ display:none; }

/* ---------------- Title + pagination ---------------- */
/* Title (caption): flush under the image, no gap. Explicit px (root is 14px). */
.gallery .caption, .gallery-favorite .caption{
  top:100% !important;
  margin-top:0 !important;
  font-size:14px;
  line-height:15px;
}
/* Pagination in explicit px (was 1.3em = 18.2px on a 14px root). */
.pagination{ font-size:18px !important; }

/* Gallery page: fade-out shadow over the collapsed page-thumbnail grid, sitting just
   above the View More / View All buttons to hint there's more. It's a ::before on
   #show-more-container, which JS toggles display:none once everything is shown — so the
   fade auto-disappears when the grid is fully expanded. Container bg is #1f1f1f. */
#show-more-container{ position:relative; }
#show-more-container::before{
  content:"";
  position:absolute;
  left:0; right:0;
  bottom:100%;
  height:170px;
  z-index:5;             /* above the reader thumbnail images (z-index:2) */
  pointer-events:none;
  background:linear-gradient(to bottom,
    rgba(31,31,31,0)    0%,
    rgba(31,31,31,0.55) 55%,
    rgba(31,31,31,0.9)  85%,
    #1f1f1f            100%);
}

