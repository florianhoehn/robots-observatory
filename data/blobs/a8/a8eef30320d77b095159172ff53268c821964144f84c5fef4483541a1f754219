            --rc-green: #11D483;
            --rc-orange: #FF8552;
        }
        
        /* Light mode (default) */
        :root {
            --bg-primary: #FAFAFA;
            --bg-secondary: #FFFFFF;
            --bg-gradient-start: #f8f4ff;
