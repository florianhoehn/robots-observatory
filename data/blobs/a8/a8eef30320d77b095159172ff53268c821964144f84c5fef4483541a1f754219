            align-items: center;
            gap: 0.5rem;
            color: var(--rc-red);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }
        
        .blog-link:hover {
            color: var(--rc-orange);
        }
        
        .blog-link::before {
            content: '→';
        }
