        .top-nav a {
            display: flex;
            align-items: center;
            text-decoration: none;
            color: var(--text-primary);
            font-weight: 700;
            gap: 0.5rem;
        }
        
        .top-nav img {
            height: 28px;
            width: auto;
        }
        
        .container {
            padding-top: 5rem;
        }
        
        /* Blog links */
        .blog-links {
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            margin-top: 1rem;
