
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>404 - Page Not Found</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#0f172a,#020617);
    min-height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    overflow:hidden;
    color:white;
}

.background-glow{
    position:absolute;
    width:500px;
    height:500px;
    background:radial-gradient(circle,#0ea5e9,transparent 70%);
    filter:blur(80px);
    opacity:0.35;
    animation:floatGlow 8s infinite ease-in-out;
}

@keyframes floatGlow{
    0%{transform:translate(-100px,-50px);}
    50%{transform:translate(100px,50px);}
    100%{transform:translate(-100px,-50px);}
}

.container{
    position:relative;
    z-index:2;
    text-align:center;
    padding:50px 35px;
    background:rgba(255,255,255,0.05);
    border:1px solid rgba(255,255,255,0.1);
    backdrop-filter:blur(18px);
    border-radius:28px;
    box-shadow:0 20px 60px rgba(0,0,0,0.45);
    max-width:700px;
    width:90%;
}

.error-code{
    font-size:140px;
    font-weight:700;
    line-height:1;
    background:linear-gradient(90deg,#38bdf8,#0ea5e9,#7dd3fc);
    -webkit-background-clip:text;
    -webkit-text-fill-color:transparent;
    text-shadow:0 0 30px rgba(56,189,248,0.3);
    animation:pulse 2.5s infinite;
}

@keyframes pulse{
    0%{transform:scale(1);}
    50%{transform:scale(1.04);}
    100%{transform:scale(1);}
}

h1{
    font-size:34px;
    margin-top:15px;
    margin-bottom:15px;
}

p{
    color:#cbd5e1;
    font-size:18px;
    line-height:1.8;
    margin-bottom:35px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    text-decoration:none;
    padding:14px 28px;
    border-radius:12px;
    font-weight:600;
    transition:0.3s ease;
}

.btn-home{
    background:#0ea5e9;
    color:#fff;
}

.btn-home:hover{
    transform:translateY(-3px);
    box-shadow:0 10px 25px rgba(14,165,233,0.4);
}

.btn-back{
    background:transparent;
    border:1px solid rgba(255,255,255,0.2);
    color:white;
}

.btn-back:hover{
    background:rgba(255,255,255,0.08);
    transform:translateY(-3px);
}

@media(max-width:768px){
    .error-code{
        font-size:90px;
    }

    h1{
        font-size:26px;
    }

    p{
        font-size:16px;
    }
}
</style>
</head>
<body>

<div class="background-glow"></div>

<div class="container">
    <div class="error-code">404</div>
    <h1>Oops! Page Not Found</h1>
    <p>
        The page you're trying to access doesn't exist, has been removed,
        or the URL may be incorrect.
    </p>

    <div class="buttons">
        <a href="/" class="btn btn-home">🏠 Back To Home</a>
        <a href="javascript:history.back()" class="btn btn-back">⬅ Go Back</a>
    </div>
</div>

</body>
</html>
