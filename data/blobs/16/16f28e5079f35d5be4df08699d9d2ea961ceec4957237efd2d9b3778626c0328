    <script>
        (function() {
            var CN = '_vid';
            var serverIsNew = true;
            function valid(v) { return typeof v === 'string' && v.length === 32 && /^[a-z0-9]+$/i.test(v); }
            function gc(n) {
                var m = document.cookie.match(new RegExp('(?:^| )' + n + '=([^;]+)'));
                return m ? m[1] : null;
            }
            function sc(n, v) {
                var d = new Date();
                d.setTime(d.getTime() + 63072000000);
                document.cookie = n + '=' + v + ';expires=' + d.toUTCString() + ';path=/;SameSite=Lax';
            }
            var cv = gc(CN), lv = null;
            try { lv = localStorage.getItem(CN); } catch(e) {}
            // Odbaci nevaljane vrijednosti (npr. stari šifrirani blob) i počisti LS.
            if (!valid(cv)) cv = null;
            if (!valid(lv)) { lv = null; try { localStorage.removeItem(CN); } catch(e) {} }

            if (cv && !lv) {
                // Prvi put na ovom uređaju ili LS očišćen — backup cookieja u LS.
                try { localStorage.setItem(CN, cv); } catch(e) {}
            } else if (!cv && lv) {
                // Cookie obrisan, LS preživio — vrati identitet u cookie.
                sc(CN, lv);
            } else if (cv && lv && cv !== lv) {
                if (serverIsNew) {
                    // Server je upravo izmislio svjež id (cookie je falio), ali LS
                    // drži stariji identitet → vrati stari. Onemogućava da brisanje
                    // cookieja posluži kao reset identiteta.
                    sc(CN, lv);
                } else {
                    // Postojeći cookie je mjerodavan — poravnaj LS na njega.
                    try { localStorage.setItem(CN, cv); } catch(e) {}
                }
            }
        })();
    </script>

    
