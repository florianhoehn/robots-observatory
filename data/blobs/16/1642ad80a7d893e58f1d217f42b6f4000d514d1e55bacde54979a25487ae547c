(function () {
  // ✅ Only run on Spanish pages
  if (!location.pathname.startsWith('/es/')) return;

  // ✅ Decode uXXXX or \uXXXX sequences
  function decodeUcodes(str) {
    return str.replace(/\\?u([0-9a-f]{4})/gi, (_, hex) =>
      String.fromCharCode(parseInt(hex, 16))
    );
  }

  document.addEventListener('DOMContentLoaded', () => {
    // ✅ All selectors that need decoding
    const selectors = [
      '.post-main-content .info-box-content',
      '.myths-facts-text'
    ];

    selectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => {
        const html = el.innerHTML;

        // Skip if no unicode pattern
        if (!html || !/\\?u[0-9a-f]{4}/i.test(html)) return;

        // Decode and replace
        el.innerHTML = decodeUcodes(html);
      });
    });
  });
})();
</script><script>
(function () {
  // Only on Spanish pages
  if (!location.pathname.startsWith('/es/')) return;

  function isSameOrigin(url) {
    try { return new URL(url, location.origin).origin === location.origin; }
    catch { return false; }
  }

  function tagLink(a) {
    const u = new URL(a.href, location.origin);
    if (!isSameOrigin(u)) return;
    if (u.pathname.startsWith('/es/')) return;           // already Spanish
    if (u.searchParams.has('from_lang')) return;          // already tagged
    u.searchParams.set('from_lang', 'es');
    a.href = u.toString();
  }

  function tagAllLinks() {
    const container = document.querySelector('.post-main-content');
    if (!container) return;
    container.querySelectorAll('a[href]').forEach(tagLink);
  }

  // Run once now (or after DOM is ready)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', tagAllLinks);
  } else {
    tagAllLinks();
  }

  // Also tag links added later (e.g., lazy content)
  const mo = new MutationObserver(muts => {
    muts.forEach(m => {
      m.addedNodes.forEach(node => {
        if (node.nodeType === 1) {
          if (node.matches?.('.post-main-content a[href]')) tagLink(node);
          node.querySelectorAll?.('.post-main-content a[href]').forEach(tagLink);
        }
      });
    });
  });
  mo.observe(document.documentElement, { childList: true, subtree: true });

  // Optional: keep the click-time safety net
  document.addEventListener('click', function(e){
    const a = e.target.closest('.post-main-content a[href]');
    if (a) tagLink(a);
  }, { capture: true });
})();
