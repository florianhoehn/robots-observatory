            padding: 30px 70px 30px 0;
        }

        .button {
            background-color: white;
            border-radius: 3px;
            border: none;
            color: #028fdf;
            padding: 15px 50px;
            text-align: center;
            text-decoration: none;
            display: inline-block;
            font-size: 18px;
            margin: 4px 2px;
            cursor: pointer;
        }

        .sorry-status-bar {
            margin-top: 40px;
            border-radius: 20px;
        }

        @media only screen and (min-width: 1160px) {
            body {
                text-align: left;
            }

            .main-grid {
                max-width: 1160px;
                align-items: unset;
            }

            #main {
                display: flex;
                align-items: center;
                padding-top: 50px;
                justify-content: space-around;
            }
        }
    </style>
