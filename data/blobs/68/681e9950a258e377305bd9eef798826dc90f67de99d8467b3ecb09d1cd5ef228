<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="description" content="The page you requested could not be found on Untappd.">
    <meta name="author" content="The Untappd Team">
    <meta name="Copyright" content="Copyright Untappd 2026. All Rights Reserved.">
    <title>Page Not Found | Untappd</title>
    <link rel="icon" type="image/png" href="https://untappd.com/assets/favicon-32x32-v2.png" sizes="32x32">
    <link rel="icon" type="image/png" href="https://untappd.com/assets/favicon-16x16-v2.png" sizes="16x16">
    <link rel="apple-touch-icon" sizes="144x144" href="https://untappd.com/assets/apple-touch-icon.png">
    <style>
        :root {
            --accent: #fbbf00;
            --accent-hover: #dca700;
            --background: #1d1c1d;
            --border: #343234;
            --focus-border: #767676;
            --foreground: #fff;
            --input-background: #fff;
            --input-border: #fff;
            --input-foreground: #1d1c1d;
            --muted: #d7d5d7;
        }

        * {
            box-sizing: border-box;
        }

        body {
            -moz-osx-font-smoothing: grayscale;
            -webkit-font-smoothing: antialiased;
            background: var(--background);
            color: var(--foreground);
            font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            margin: 0;
        }

        .home-link,
        .search-button {
            border-radius: 4px;
            display: inline-block;
            font-size: 1rem;
            font-weight: 700;
            padding: 10px 24px;
            text-decoration: none;
        }

        .home-link {
            border: 2px solid var(--foreground);
            color: var(--foreground);
        }

        .home-link:hover {
            background: var(--foreground);
            color: var(--background);
        }

        .error-page {
            align-items: center;
            display: flex;
            min-height: 100vh;
            overflow: hidden;
            padding: 56px 24px 96px;
            position: relative;
            text-align: center;
        }

        .error-page::after {
            background: url("https://images.untp.beer/convert?type=webp&url=https://untappd.s3.amazonaws.com/home_v3/BaseBrick.png") repeat-x bottom center;
            background-size: auto 150px;
            bottom: 0;
            content: "";
            height: 150px;
            left: 0;
            opacity: 0.12;
            position: absolute;
            right: 0;
        }

        .error-content {
            margin: 0 auto;
            max-width: 720px;
            position: relative;
            width: 100%;
            z-index: 1;
        }

        .error-code {
            color: var(--accent);
            font-size: clamp(5rem, 18vw, 9rem);
            font-weight: 800;
            letter-spacing: -0.06em;
            line-height: 0.85;
            margin: 0 0 24px;
        }

        h1 {
            font-size: clamp(2rem, 6vw, 3rem);
            letter-spacing: -0.025em;
            line-height: 1.1;
            margin: 0;
        }

        .message {
            color: var(--muted);
            font-size: 1.2rem;
            line-height: 1.6;
            margin: 20px auto 32px;
            max-width: 560px;
        }

        .separator {
            background: var(--accent);
            height: 4px;
            margin: 0 auto 32px;
            width: 50px;
        }

        .search-form {
            display: flex;
            gap: 12px;
            margin: 0 auto 24px;
            max-width: 620px;
        }

        .search-input {
            background: var(--input-background);
            border: 2px solid var(--input-border);
            border-radius: 4px;
            color: var(--input-foreground);
            flex: 1;
            font-size: 1rem;
            min-width: 0;
            padding: 13px 16px;
        }

        .search-input::placeholder {
            color: #6b686b;
            opacity: 1;
        }

        .search-input:focus {
            border-color: var(--focus-border);
            outline: none;
        }

        .search-button {
            background: var(--accent);
            border: 2px solid var(--accent);
            color: #1d1c1d;
            cursor: pointer;
        }

        .search-button:hover {
            background: var(--accent-hover);
            border-color: var(--accent-hover);
        }

        .support {
            color: var(--muted);
            margin: 24px 0 0;
        }

        .support a {
            color: var(--foreground);
            font-weight: 700;
        }

        @media (prefers-color-scheme: light) {
            :root {
                --background: #f7f7f7;
                --border: #dedede;
                --focus-border: #1d1c1d;
                --foreground: #1d1c1d;
                --input-background: #fff;
                --input-border: #767676;
                --input-foreground: #1d1c1d;
                --muted: #5f5d5f;
            }

            .error-page::after {
                opacity: 0.06;
            }
        }

        @media (max-width: 560px) {
            .error-page {
                padding: 48px 16px 88px;
            }

            .search-form {
                flex-direction: column;
            }

            .search-button {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <main class="error-page">
        <div class="error-content">
            <p class="error-code" aria-hidden="true">404</p>
            <h1>We couldn't find that page.</h1>
            <p class="message">The link may be out of date, or the page may have moved. Search Untappd or head back home.</p>
            <div class="separator"></div>

            <form class="search-form" method="get" action="/search">
                <input id="error-search" class="search-input" type="search" name="q" aria-label="Search Untappd" placeholder="Search drinks, producers, or places">
                <button class="search-button" type="submit">Search</button>
            </form>

            <a class="home-link" href="/">Back to home</a>
            <p class="support">Still need help? <a href="https://help.untappd.com/hc/en-us">Visit Untappd Support</a></p>
        </div>
    </main>
</body>
</html>
