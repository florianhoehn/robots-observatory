<script>
(function () {
    var MODE_COOKIE_KEY = "15d61712450a686a7f365adf4fef581f";
    var DARK_CSS = "https://ivancity.com/theme/eb4_comm_003/css/dark_mode.css?ver=2608104";

    function readGnuboardModeCookie() {
        var m = document.cookie.match(new RegExp("(?:^|;\\s*)" + MODE_COOKIE_KEY + "=([^;]+)"));
        if (!m) return "";
        try {
            return atob(decodeURIComponent(m[1].replace(/\\+/g, " ")));
        } catch (e) {
            return "";
        }
    }

    window.ivancityResolveColorMode = function () {
        try {
            var ls = localStorage.getItem("mode");
            if (ls === "dark" || ls === "light") return ls;
        } catch (e) {}
        var ck = readGnuboardModeCookie();
        if (ck === "dark" || ck === "light") return ck;
        return "";
    };

    window.ivancityApplyDarkModeEarly = function () {
        var root = document.documentElement;
        root.classList.add("dark-mode");
        root.style.backgroundColor = "#0d1116";
        root.style.colorScheme = "dark";
        var fixChromeMeta = function () {
            var t = document.getElementById("theme-color-meta");
            var c = document.getElementById("color-scheme-meta");
            if (t) t.setAttribute("content", "#0d1116");
            if (c) c.setAttribute("content", "dark");
            return !!(t || c);
        };
        if (!fixChromeMeta()) {
            var metaObs = new MutationObserver(function () {
                if (fixChromeMeta()) metaObs.disconnect();
            });
            metaObs.observe(document.documentElement, { childList: true, subtree: true });
        }
        var fixModeCss = function () {
            var link = document.getElementById("mode_css");
            if (!link) return false;
            if (link.getAttribute("href") !== DARK_CSS) link.setAttribute("href", DARK_CSS);
            return true;
        };
        if (!fixModeCss()) {
            var obs = new MutationObserver(function () {
                if (fixModeCss()) obs.disconnect();
            });
            obs.observe(document.documentElement, { childList: true, subtree: true });
        }
        var syncBody = function () {
            if (document.body) document.body.classList.add("dark-mode");
        };
        if (document.body) syncBody();
        else document.addEventListener("DOMContentLoaded", syncBody);
    };

    if (window.ivancityResolveColorMode() === "dark") {
        window.ivancityApplyDarkModeEarly();
    }
})();
</script>
