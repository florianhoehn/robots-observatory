<script>
// 1. 원본 alert 함수가 덮어씌워지기 전에 백업해둡니다. (스크립트 최상단)
if (!window.nativeAlert) {
    window.nativeAlert = window.alert;
}

// alert.php 패턴: alert() 직후 history.back() 또는 location.replace() 또는 window.close() 호출 → Swal 닫힌 후 실행
var _pendingNavigation = null;
var _pendingClose = null;  // window.close()는 별도 변수로 관리 (history.back setTimeout에 덮어씌워지지 않도록)

var _nativeHistoryBack = history.back.bind(history);
history.back = function() {
    if (window._swalOpen) {
        _pendingNavigation = function() { _nativeHistoryBack(); };
    } else {
        _nativeHistoryBack();
    }
};

var _nativeWindowClose = window.close.bind(window);
window.close = function() {
    if (window._swalOpen) {
        _pendingClose = _nativeWindowClose;  // close는 별도 변수에 저장
    } else {
        _nativeWindowClose();
    }
};

window.alert = function(message) {
    // 2. 쪽지창 여부 확인 (URL에 'memo'가 있거나 창 이름이 'win_memo'인 경우)
    const memoPages = ['mybank', 'bo_table', 'password', 'creator', 'memo', 'post', 'write', 'pinkmap', 'social', 'dating', 'member_leave'];
    const isMemoPage = memoPages.some(path => location.href.includes(path)) || window.name === 'win_memo';

    if (isMemoPage) {
        // 쪽지창에서는 브라우저 기본 alert을 사용 (비동기 방지)
        window.nativeAlert(message);
        return;
    }

    // 3. SweetAlert2 아이콘 결정 로직
    let icon = 'info';
    if (message.includes('오류') || message.includes('실패') || message.includes('문제') || message.includes('권한')) {
        icon = 'error';
    } else if (message.includes('차단') || message.includes('주의') || message.includes('경고') || message.includes('삭제')) {
        icon = 'warning';
    } else if (message.includes('성공') || message.includes('완료') || message.includes('지급')) {
        icon = 'success';
    }

    // 4. SweetAlert2 실행 — 닫힌 후 대기 중인 네비게이션 실행
    window._swalOpen = true;
    Swal.fire({
        text: message,
        icon: icon,
        confirmButtonColor: '#E95A8B',
        confirmButtonText: '확인',
        allowOutsideClick: false
    }).then(function() {
        window._swalOpen = false;
        if (_pendingClose) {
            // window.close()가 대기 중이면 최우선 실행 (history.back setTimeout이 덮어쓰지 못하도록)
            var closeFn = _pendingClose;
            _pendingClose = null;
            _pendingNavigation = null;
            closeFn();
        } else if (_pendingNavigation) {
            var nav = _pendingNavigation;
            _pendingNavigation = null;
            nav();
        }
    });
};
</script>
