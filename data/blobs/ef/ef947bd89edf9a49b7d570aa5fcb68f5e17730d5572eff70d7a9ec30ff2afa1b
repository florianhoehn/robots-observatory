<script>
/* 앱 복귀 안내(외부 브라우저 가입 경로용, 옵션).
 * 과거에는 신규 SNS 가입을 외부 브라우저로 열었고(app_return=1),
 * 가입 완료 후 앱(ivancityapp://)으로 돌려보냈다.
 * 현재 기본 경로는 앱 WebView 내 가입이므로 이 스크립트는 앱 클라이언트에서는
 * 동작하지 않으며, 외부 브라우저로 열린 경우에만 의미가 있다. */
(function () {
  var RETURN_KEY = 'ivancity_app_return';
  var SCHEME = 'ivancityapp://login';

  function isAppClient() {
    if (typeof window.AppBridge !== 'undefined') return true;
    return /IVANCITY(?:-Dev|\/)/i.test(navigator.userAgent || '');
  }
  if (isAppClient()) return;

  var store = null;
  try { store = window.sessionStorage; } catch (e) { store = null; }

  // 앱이 넘긴 표시를 기억해 둔다(가입 과정에서 여러 페이지를 거치므로).
  if (/[?&]app_return=1/.test(location.search)) {
    try { store && store.setItem(RETURN_KEY, '1'); } catch (e) {}
  }

  var pending = false;
  try { pending = store && store.getItem(RETURN_KEY) === '1'; } catch (e) {}
  if (!pending) return;

  var isMember = false;
  if (!isMember) return;   // 가입/로그인이 끝나야 복귀시킨다.

  try { store && store.removeItem(RETURN_KEY); } catch (e) {}

  function goApp() { location.href = SCHEME; }

  document.addEventListener('DOMContentLoaded', function () {
    var bar = document.createElement('div');
    bar.setAttribute('style', [
      'position:fixed', 'left:0', 'right:0', 'bottom:0', 'z-index:2147483647',
      'background:#2DAAB8', 'color:#fff', 'padding:14px 16px',
      'font-size:15px', 'text-align:center', 'cursor:pointer',
      'box-shadow:0 -2px 12px rgba(0,0,0,.2)'
    ].join(';'));
    bar.textContent = '가입이 완료되었습니다. 앱으로 돌아가기 →';
    bar.addEventListener('click', goApp);
    document.body.appendChild(bar);

    // 자동 복귀 시도(브라우저가 막으면 위 버튼으로 돌아갈 수 있다).
    setTimeout(goApp, 600);
  });
})();
</script>
