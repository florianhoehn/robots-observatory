<style>
/* ============================================================
   IVANCITY LOGIN — Modern 2025 Design
   ============================================================ */

/* --- Reset & Base --- */
.eb-login * { box-sizing: border-box; }

/* --- Page Background --- */
.eb-login {
    min-height: 100vh;
    min-height: 100svh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: #eef4f4;
    position: relative;
    overflow: hidden;
}

/* Animated gradient orbs */
.eb-login::before,
.eb-login::after {
    content: '';
    position: fixed;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.28;
    pointer-events: none;
    animation: orbFloat 14s ease-in-out infinite alternate;
}
.eb-login::before {
    width: 600px; height: 600px;
    background: radial-gradient(circle, #2DAAB8, #00c4bb);
    top: -180px; left: -180px;
}
.eb-login::after {
    width: 500px; height: 500px;
    background: radial-gradient(circle, #007d77, #2DAAB8);
    bottom: -120px; right: -120px;
    animation-delay: -7s;
}
@keyframes orbFloat {
    0%   { transform: translate(0, 0) scale(1); }
    50%  { transform: translate(40px, 30px) scale(1.08); }
    100% { transform: translate(-20px, 50px) scale(0.95); }
}

/* Extra subtle dot grid */
.login-bg-dots {
    position: fixed; inset: 0;
    background-image:
        radial-gradient(circle, rgba(0,162,154,0.12) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
}

/* --- Login Wrapper --- */
.login-content {
    position: relative;
    z-index: 10;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
}

/* --- Card --- */
.login-card {
    width: 100%;
    max-width: 440px;
    background: #fff;
    border: 1px solid rgba(0, 162, 154, 0.12);
    border-radius: 24px;
    padding: 36px 40px 32px;
    box-shadow:
        0 0 0 1px rgba(0, 162, 154, 0.06),
        0 20px 60px rgba(0, 100, 96, 0.12),
        0 4px 12px rgba(0, 0, 0, 0.06);
    animation: cardIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes cardIn {
    from { opacity: 0; transform: translateY(30px) scale(0.97); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* --- Logo --- */
.login-logo {
    text-align: center;
    margin-bottom: 24px;
}

/* 워드마크 */
.logo-wordmark {
    margin: 0;
    line-height: 1;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    letter-spacing: 0.04em;
    opacity: 0;
    animation: wordmarkIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
}
@keyframes wordmarkIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
}

.lw-ivan {
    font-size: 2.1rem;
    font-weight: 300;
    color: #2a4240;
    letter-spacing: 0.1em;
}
.lw-city {
    font-size: 2.1rem;
    font-weight: 800;
    background: linear-gradient(135deg, #00bdb4, #007d77);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.06em;
}

/* 태그라인 */
.logo-tagline {
    margin: 8px 0 0;
    font-size: 0.7425rem;
    font-weight: 500;
    color: rgba(0,0,0,0.3);
    letter-spacing: 0.26em;
    text-transform: uppercase;
    font-family: 'Outfit', sans-serif;
    opacity: 0;
    animation: taglineIn 0.5s ease 0.55s forwards;
}
@keyframes taglineIn {
    from { opacity: 0; }
    to   { opacity: 1; }
}

/* --- Form Fields --- */
.login-field {
    margin-bottom: 12px;
    position: relative;
}
.login-field .input-wrap {
    position: relative;
    display: flex;
    align-items: center;
}
.login-field .input-wrap .field-icon {
    position: absolute;
    left: 16px;
    color: rgba(0,0,0,0.25);
    font-size: 0.9rem;
    pointer-events: none;
    transition: color 0.25s;
    z-index: 2;
}
.login-field .input-wrap input[type="text"],
.login-field .input-wrap input[type="password"] {
    width: 100%;
    background: #f7fafa;
    border: 1.5px solid #d6ecea;
    border-radius: 12px;
    padding: 14px 44px 14px 44px;
    font-size: 0.95rem;
    color: #1a2e2d;
    outline: none;
    transition: all 0.25s;
    -webkit-appearance: none;
}
.login-field .input-wrap input::placeholder { color: rgba(0,0,0,0.28); }
.login-field .input-wrap input:focus {
    background: #f0faf9;
    border-color: #2DAAB8;
    box-shadow: 0 0 0 3px rgba(0, 162, 154, 0.12);
}
.login-field .input-wrap:has(input:focus) .field-icon { color: #2DAAB8; }
.pv-toggle {
    position: absolute;
    right: 14px;
    background: none; border: none;
    color: rgba(0,0,0,0.25);
    cursor: pointer;
    padding: 4px;
    font-size: 0.9rem;
    transition: color 0.2s;
    z-index: 2;
}
.pv-toggle:hover, .pv-toggle.active { color: #2DAAB8; }

/* --- Lucide Icons --- */
.eb-login .lucide { display:inline-block; vertical-align:middle; stroke-width:2; stroke:currentColor; fill:none; }
.field-icon.lucide { width:18px; height:18px; stroke:rgba(0,0,0,0.25); }
.pv-toggle .lucide { width:18px; height:18px; }
.nm-notice .lucide { width:16px; height:16px; }
.order-info .lucide { width:15px; height:15px; }

/* --- Lucide Dark Mode --- */
body.dark-mode .field-icon.lucide { stroke:rgba(255,255,255,0.25); }
body.dark-mode .login-field .input-wrap:has(input:focus) .field-icon.lucide { stroke:#2DAAB8; }


/* --- Auto Login --- */
.login-options {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}
.login-check-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 0.85rem;
    color: rgba(0,0,0,0.6);
    user-select: none;
}
.login-check-label input[type="checkbox"] { display: none; }
.login-check-box {
    width: 18px; height: 18px;
    border: 1.5px solid #c8dedd;
    border-radius: 5px;
    background: #f7fafa;
    display: flex; align-items: center; justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
}
.login-check-label input:checked ~ .login-check-box {
