<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="https://www.starbucks.com/favicon.ico" />
    <title>404: Page not found: Starbucks Coffee Company</title>
    <meta
      content="404: Page not found: Starbucks Coffee Company"
      property="og:title"
    />
    <link rel="stylesheet" href="/weblx/assets/error-page.css" />
  </head>

  <body onload="draw()">
    <header class="navBar">
      <a aria-label="Home, Starbucks" href="/" class="sirenLogoAnchor">
        <img
          src="/weblx/assets/img/error/siren-logo.svg"
          alt=""
          class="sirenLogoImage"
        />
      </a>
    </header>
    <main class="main">
      <h1 class="text-lg text-bold">
        We can’t find the page you’re looking for.
      </h1>
      <p class="text-sm">
        Don’t worry, it’s just a little spilled <span id="drinkName"></span>.
        Let us help you clean that up and find your way! Mop up the spill to
        reveal something underneath.
      </p>

      <div class="container">
        <div class="spillAndCupContainer">
          <div class="spillWrapper">
            <!-- canvas dynamic aria-label inserted with js -->
            <canvas
              id="canvas"
              role="img"
              class="position-absolute z2"
            ></canvas>
            <button
              aria-label="Mop up the spill to reveal something underneath"
              aria-live="polite"
              tabindex="0"
              onclick="myChime()"
              class="text-bold text-md position-absolute hiddenContent"
              id="hiddenContent"
            ></button>
          </div>
          <img src="/weblx/assets/img/error/cup.svg" alt="" class="cup" />
        </div>

        <div class="guidance">
          <h2 class="guidanceHeading text-md">Would you like to:</h2>
          <ul class="guidanceList">
            <li>
              <a class="guidanceLink" href="/menu">Place an order</a>
            </li>
            <li>
              <a class="guidanceLink" href="/gift">Check a gift card</a>
            </li>
            <li>
              <a class="guidanceLink" href="/">Return to home page</a>
            </li>
          </ul>
        </div>
      </div>
    </main>

    <script src="/weblx/assets/error-page.js"></script>
  </body>
</html>
