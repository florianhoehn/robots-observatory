<style id="atu-mbn-style-inline-css">

@media (min-width: 992px){
  .mbn-wrap{ display:none!important; }
}

.mbn-wrap{
  position:fixed; left:0; right:0; bottom:0;
  z-index:2147483647;
  font-family:system-ui;
}

.mbn-bar{
  height:72px;
  background:rgba(15,15,15,.6);
  backdrop-filter:blur(18px);
  border-top:1px solid rgba(255,255,255,.12);
  display:grid;
  grid-template-columns:repeat(3,1fr); /* ✅ 3’lü */
}

.mbn-item{
  color:#fff;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  cursor:pointer;
}
.mbn-vis-icon{width:22px;height:22px;fill:#fff}
.mbn-label{font-size:11px;font-weight:600}

/* PANELLER */
.mbn-panel{
  position:fixed; inset:0;
  background:rgba(15,15,15,.7);
  backdrop-filter:blur(26px);
  display:none;
  flex-direction:column;
  color:#fff;
}
.mbn-panel.show{display:flex}

.mbn-head{
  height:60px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 16px;
  border-bottom:1px solid rgba(255,255,255,.1);
}
.mbn-close{font-size:30px;cursor:pointer}
.mbn-body{flex:1;overflow:auto;padding:14px}

/* ACCORDION */
.mbn-acc-ul{list-style:none;margin:0;padding:0}
.mbn-acc-li{background:rgba(255,255,255,.08);margin-bottom:8px;border-radius:10px}

.mbn-acc-header{
  display:flex;
  align-items:center;
  padding:14px;
  cursor:pointer;
}
.mbn-acc-title{flex:1}
.mbn-acc-link{color:#fff;text-decoration:none;flex:1}

.mbn-acc-toggle svg{
  width:16px;height:16px;fill:#fff;transition:.25s
}

.mbn-acc-body{display:none;padding:8px}
.mbn-acc-li.open>.mbn-acc-body{display:block}
.mbn-acc-li.open .mbn-acc-toggle svg{transform:rotate(180deg)}

/*# sourceURL=atu-mbn-style-inline-css */
</style>
