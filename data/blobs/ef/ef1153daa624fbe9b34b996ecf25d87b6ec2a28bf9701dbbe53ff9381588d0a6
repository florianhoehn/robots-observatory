                        if (!node.children[0]) {
                            node.style.display = "none";

                            return;
                        }

                        node.style.display = window.getComputedStyle(node.children[0]).display === 'none' ? 'none' : undefined;
                });
            } catch (e) {
                clearInterval(interval);
            }
        }, 50);
    });
</script>
    
