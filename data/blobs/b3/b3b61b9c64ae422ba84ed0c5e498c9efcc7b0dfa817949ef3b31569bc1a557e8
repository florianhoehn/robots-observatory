            var TriggerParam = true;
            var Header = document.getElementById('Header');
            var DropDown = document.getElementById('DropDown');
            var DropDownOverlay = document.getElementById('DropDownOverlay');
            var DropDownFly = document.getElementById('DropDownFly');
            var BurgerDesktop = document.getElementById('BurgerDesktop');
            var BurgerMobile = document.getElementById('BurgerMobile');
            var Close = document.getElementById('Close');
            var Lines = document.getElementsByClassName('js-lines');
            var Footer = document.getElementsByClassName('js-footer');

            var _headerToggleClass = function() {
               _scrollParam() ? Header.classList.add('tensor_ru-Header--scrolled') : Header.classList.remove('tensor_ru-Header--scrolled');
               _scrollParam() ? DropDown.classList.add('tensor_ru-DropDown--minimize') : DropDown.classList.remove('tensor_ru-DropDown--minimize');
            };

            var _toogleDropDown = function() {
               if (TriggerParam) {
                  TriggerParam = false;
                  BoolParam ? DropDownOverlay.classList.add('tensor_ru-DropDown__overlay--fadeOut') : DropDownOverlay.classList.remove('tensor_ru-DropDown__overlay--fadeOut');
                  BoolParam ? DropDownFly.classList.add('tensor_ru-DropDown__content--flyUp') : DropDownFly.classList.remove('tensor_ru-DropDown__content--flyUp');
                  setTimeout(function() {
                     !BoolParam ? document.body.style.paddingRight = _getScrollbarWidth() : document.body.removeAttribute('style');
                     !BoolParam ? Header.style.paddingRight = _getScrollbarWidth() : Header.removeAttribute('style');
                     !BoolParam ? Header.classList.add('tensor_ru-Header--menu-visible') : Header.classList.remove('tensor_ru-Header--menu-visible');
                     !BoolParam ? document.body.classList.add('tensor_ru--panel-opened') : document.body.classList.remove('tensor_ru--panel-opened');
                     !BoolParam ? BurgerMobile.classList.add('tensor_ru-Header__button--active') : BurgerMobile.classList.remove('tensor_ru-Header__button--active');
                     for (var i = 0; i < Lines.length; i++) {
                        !BoolParam ? Lines[i].classList.add('tw-hidden-important') : Lines[i].classList.remove('tw-hidden-important');
                     }
                     BoolParam ? DropDown.classList.add('tw-hidden-important') : DropDown.classList.remove('tw-hidden-important');
                     BoolParam ? Close.classList.add('tw-hidden-important') : Close.classList.remove('tw-hidden-important');

                     BoolParam = !BoolParam;
                     TriggerParam = true;
                  }, BoolParam ? TIMEOUT_TIME_HEADER : 0);
               }
            };

            var _toggleFooter = function() {
               var footerItem = this;
               footerItem.classList.toggle('tensor_ru-Footer--active');
               setTimeout(function() {
                  footerItem.parentNode.parentNode.classList.toggle('opened')
               }, footerItem.classList.contains('tensor_ru-Footer--active') ? TIMEOUT_TIME_FOOTER : 0)
            };

            var _scrollParam = function() {
               return (document.documentElement.scrollTop || 0) >= 10;
            };

            var _setEvents = function () {
               window.addEventListener('scroll', _headerToggleClass);
               BurgerDesktop.addEventListener('click', _toogleDropDown);
