<!DOCTYPE html>
<html lang="sk">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/error.css">
    <title>PROFESIA.SK</title>
<body>

<header id="header">
    <div id="header-container">
        <div class="logo">
            <a href="/">
                <img src="/images/design_resp/design/logo-header.svg"
                     id="logo-img"
                     width="128"
                     height="95"
                     alt="PROFESIA.SK"
                >
            </a>
        </div>
    </div>
</header>

<section id="content">
    <div id="content-text">
        <h1 id="title" data-translate-key="LS_errorPage.heading">Ajaj, túto stránku<br>u nás nenájdete</h1>

        <h2 id="subtitle" data-translate-key="LS_errorPage.errorInstructions">
            Poďte na <a href="/">domovskú stránku</a> a pohľadajte, čo potrebujete.
        </h2>

        <p id="message"><span id="error-code" data-translate-key="LS_errorPage.errorCode">Kód chyby</span>: 404</p>
    </div>

    <div id="content-image">
        <img src="/images/design_resp/error_page/telescope.svg" alt="404">
    </div>
</section>

<script src="/js/translate_error_strings.js"></script>

</body>
</html>