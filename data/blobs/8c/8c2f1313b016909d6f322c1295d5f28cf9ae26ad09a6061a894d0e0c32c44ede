  // Populate hidden UTM fields
  function populateUtmFields() {
    const urlParams = new URLSearchParams(window.location.search);

    const utmMap = {
      utm_campaign: "00NSr0000064lXR",
      utm_content: "00NSr0000064lXS",
      utm_medium: "00NSr0000064lXT",
      utm_source: "00NSr0000064lXU",
      utm_term: "00NSr0000064lXV",
    };

    for (const [utmParam, formField] of Object.entries(utmMap)) {
      const value = urlParams.get(utmParam);
      if (value) {
        const inputFields = document.querySelectorAll(
          `input[name="${formField}"]`
        );
        inputFields.forEach((inputField) => {
          if (inputField) {
            inputField.value = value;
          }
        });
      }
    }
  }

  function populatePreferredLanguage() {
    const path = window.location.pathname;
    const languageField = document.querySelector(
      'input[title="Preferred Language"]'
    );
    if (!languageField) return;

    const pathPrefix = path.split("/")[1];
    let language;
    switch (pathPrefix) {
      case "fr":
        language = "French";
        break;
      case "de":
        language = "German";
        break;
      case "it":
        language = "Italian";
        break;
      case "ja":
        language = "Japanese";
        break;
      case "es":
        language = "Spanish";
        break;
      default:
        language = "English";
    }

    languageField.value = language;
  }

