<script>
  // Cancel Webflow animations for users who prefer reduced motion
  function handleReducedMotion() {
    if (!window.matchMedia("(prefers-reduced-motion)").matches) {
      return;
    }

    let attempts = 0;
    const maxAttempts = 100; // 10 seconds max wait

    const cancelAnimationsInterval = setInterval(function () {
      attempts++;

      if (attempts > maxAttempts) {
        clearInterval(cancelAnimationsInterval);
        console.warn("Webflow not found after 10 seconds");
        return;
      }

      if (
        typeof Webflow == "undefined" ||
        typeof Webflow.require == "undefined" ||
        !Webflow.require("ix2")
      ) {
        return;
      }

      clearInterval(cancelAnimationsInterval);

      try {
        const interactionsData = Webflow.require("ix2").store.getState().ixData;
        interactionsData.events = Object.fromEntries(
          Object.entries(interactionsData.events).filter((eventEntry) => {
            return /^MOUSE_.*CLICK$/.test(eventEntry[1].eventTypeId);
          })
        );
        interactionsData.site = { mediaQueries: interactionsData.mediaQueries };

        Webflow.require("ix2").destroy();

        const animatedElementsSelector =
          "[style*='will-change'], [style*='opacity: 0']";
        for (const animatedEl of document.querySelectorAll(
          animatedElementsSelector
        )) {
          animatedEl.style = "";
        }

        Webflow.require("ix2").init(interactionsData);
      } catch (error) {
        console.error("Error disabling Webflow animations:", error);
      }
    }, 10);
  }

  // Run immediately and also after page load
  handleReducedMotion();
  window.addEventListener("load", handleReducedMotion);
</script>
