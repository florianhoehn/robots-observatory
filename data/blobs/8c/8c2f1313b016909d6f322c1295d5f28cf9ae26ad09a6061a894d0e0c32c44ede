        spaceBetween:
          parseInt(swiperElement.getAttribute("cw-swiper-space-between")) || 20,
        watchOverflow: true,
        autoplay:
          !prefersReducedMotion &&
          swiperElement.getAttribute("cw-swiper-autoplay") === "true"
            ? {
                delay:
                  parseInt(
                    swiperElement.getAttribute("cw-swiper-autoplay-delay")
                  ) || 3000,
                disableOnInteraction:
                  swiperElement.getAttribute(
                    "cw-swiper-autoplay-disable-on-interaction"
                  ) === "true",
