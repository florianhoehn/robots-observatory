<script>
  // C006 Logo Ticker component - Make all logos visible when reduce motion is enabled
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const sectionLogoTickers = document.querySelectorAll(
      ".section_logo-ticker"
    );

    if (sectionLogoTickers.length > 0) {
      sectionLogoTickers.forEach((ticker) => {
        // Get the existing g_section_space elements
        const sectionSpaces = ticker.querySelectorAll(".g_section_space");
        const topSpace = sectionSpaces[0];
        const bottomSpace = sectionSpaces[1];

        // Get the main content elements
        const paddingGlobal = ticker.querySelector(".padding-global");
        const containerLarge = paddingGlobal?.querySelector(".container-large");
        const marqueeWrap = ticker.querySelector(".marquee_wrap");

        if (marqueeWrap && containerLarge) {
          // Get the first set of logos
          const firstMarqueeLogos = marqueeWrap.querySelector(".marquee_logos");
          const logoList =
            firstMarqueeLogos?.querySelector(".marquee_logo-list");

          if (logoList) {
            // Remove duplicate marquee_logos
            const extraMarqueeLists = marqueeWrap.querySelectorAll(
              ".marquee_logos:not(:first-child)"
            );
            extraMarqueeLists.forEach((el) => el.remove());

            // Style the logo list
            Object.assign(logoList.style, {
              display: "grid",
              gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))",
              gap: "2rem",
              width: "100%",
              transform: "none",
            });
            // Move the first marquee_logos into the container structure
            containerLarge.appendChild(firstMarqueeLogos);
          }

          // Remove the original marquee wrap
          marqueeWrap.remove();
        }

        // Ensure correct order of elements
        if (topSpace && bottomSpace) {
          // Move spaces to their correct positions
          ticker.insertBefore(topSpace, ticker.firstChild);
          ticker.appendChild(bottomSpace);
        }
      });
    }
  }
</script>
<script>
  /** C007 FAQ component */
  (function () {
    if (window.faqInitialized) {
      return;
    }
    window.faqInitialized = true;

    const faqComponents = document.querySelectorAll(".faq_component");
    if (!faqComponents.length) return;

    faqComponents.forEach((faqComponent, componentIndex) => {
      const accordions = faqComponent.querySelectorAll(".faq_accordion");

      accordions.forEach((accordion) => {
        const button = accordion.querySelector(".faq_question");
        const answer = accordion.querySelector(".faq_answer");
        const content = answer.querySelector(".text-rich-text");
        const icon = button.querySelector(".faq_icon-wrapper");
        const slug = button.getAttribute("data-question-id");

        if (slug) {
          const uniqueId = `${slug}-c${componentIndex}`;
          button.id = `question-${uniqueId}`;
          answer.id = `answer-${uniqueId}`;
          button.setAttribute("aria-controls", `answer-${uniqueId}`);
          answer.setAttribute("aria-labelledby", `question-${uniqueId}`);
        }

        answer.style.display = "none";
        answer.style.height = "0px";
        answer.style.marginTop = "0px";
        answer.style.overflow = "hidden";
        content.style.opacity = "0";
        content.style.transform = "translateY(-8px)";

        answer
          .querySelectorAll("a, button, [tabindex]")
          .forEach((el) => el.setAttribute("tabindex", "-1"));

        button.addEventListener("click", () => toggle(accordion));

        button.addEventListener("keyup", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggle(accordion);
          }
        });
      });
    });

    function toggle(accordion) {
      const answer = accordion.querySelector(".faq_answer");
      const content = answer.querySelector(".text-rich-text");
      const icon = accordion.querySelector(".faq_icon-wrapper");
      const button = accordion.querySelector(".faq_question");
      const section = accordion.closest(
        "[data-wf--section-c007-faq-cms--style-variant]"
      );
      const isBlackVariant =
        section?.getAttribute(
          "data-wf--section-c007-faq-cms--style-variant"
        ) === "black";

      const isClosed = answer.style.display === "none";

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!prefersReducedMotion) {
        answer.style.transition =
          "height 0.4s cubic-bezier(0.4, 0, 0.2, 1), margin-top 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
        content.style.transition =
          "opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1), transform 0.3s cubic-bezier(0.4, 0, 0.2, 1)";
        accordion.style.transition =
          "background-color 0.4s cubic-bezier(0.4, 0, 0.2, 1), border-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
        icon.style.transition = "transform 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
        button.style.transition =
          "padding-bottom 0.4s cubic-bezier(0.4, 0, 0.2, 1)";
      }

      if (isClosed) {
        answer.style.display = "block";
        answer.style.height = "0px";
        answer.offsetHeight;
        answer.style.height = `calc(${answer.scrollHeight}px + 1.5rem)`;
        answer.style.marginTop = "1.25rem";
        setTimeout(() => (answer.style.overflow = "visible"), 400);
        content.style.opacity = "1";
        content.style.transform = "translateY(0)";
        accordion.style.backgroundColor = isBlackVariant
          ? "rgba(255, 255, 255, 0.1)"
          : "rgba(237, 237, 237, 0.5)";
        accordion.style.borderBottom = "3px solid #00D7BD";
        icon.style.transform = "rotate(180deg)";
        accordion.querySelector(".faq_question").style.paddingBottom = "0";
        answer
          .querySelectorAll("a, button, [tabindex]")
          .forEach((el) => el.removeAttribute("tabindex"));
      } else {
        content.style.opacity = "0";
        content.style.transform = "translateY(-8px)";
        answer.style.height = "0px";
        answer.style.marginTop = "0px";
        answer.style.overflow = "hidden";
        accordion.style.backgroundColor = "";
        accordion.style.borderBottom = "";
        icon.style.transform = "rotate(0deg)";
        accordion.querySelector(".faq_question").style.paddingBottom = "";
        answer
          .querySelectorAll("a, button, [tabindex]")
          .forEach((el) => el.setAttribute("tabindex", "-1"));
        setTimeout(() => (answer.style.display = "none"), 400);
      }
    }
  })();
</script>

