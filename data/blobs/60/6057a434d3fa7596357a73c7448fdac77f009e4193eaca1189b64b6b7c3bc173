    <script>
        const pageData = {
                "100" : "Die Anfrage konnte nicht beantwortet werden",
                "403" : "Dieser Zugriff ist nicht erlaubt",
                "404" : "Die gewünschte Seite wurde leider nicht gefunden.",
                "500" : "Der Dienst steht zur Zeit nicht zur Verfügung",
                "501" : "Der Server unterstützt diese Art der Anfragen nicht.",
                "502" : "Bad Gateway - Ungültige Server-Antwort.",
                "503" : "Der Dienst steht kurzzeitig nicht zur Verfügung.",
                "504" : "Gateway Timeout - Die Anfrage konnte nicht rechtzeitig beantwortet werden.",
                "505" : "Der Server unterstützt diese Art der Anfragen nicht."
        }
        function extractSegmentByRegex(url, regex) {
            try {
                // Validate the URL format
                const urlObject = new URL(url);

                // Check for path traversal attempts
                const pathname = urlObject.pathname;
                if (pathname.includes("../") || pathname.includes("./")) {
                    console.warn("Potential path traversal attempt detected.");
                    return null;
                }

                const segments = pathname.split('/').filter(segment => segment !==
                    '');

                for (const segment of segments) {
                    if (regex.test(segment)) {
                        // Sanitize the output to prevent XSS
                        const sanitizedSegment = segment.replace(/</g,
                            "&lt;").replace(/>/g, "&gt;");
                        console.debug("Extracted segment:", sanitizedSegment);
                        return sanitizedSegment;
                    }
                }

                return null;
            } catch (error) {
                console.error("Invalid URL or regex:", error);
                return null;
            }
        }
        const errorUrl = document.location.href;
        const errSegment = extractSegmentByRegex(errorUrl, /403|404|500|501(_)?|502(_)?|503(_)?|504|505/i);

        function changeContent (echead, text){
            document.querySelector("title").innerHTML = "Fehler " + echead;
            document.querySelector("#errorStatus").innerHTML = echead;
            document.querySelector("#errorText").innerHTML = text;
            return;
        }
        function stripUnderscore(cd) {
            return cd.substring(0,3);
        }
        function initPage() {
            if (errSegment !== ''){
                let text = stripUnderscore(errSegment)
                changeContent(text, pageData[text]);
            } else {
                changeContent("", pageData["100"]);
            }
        }
