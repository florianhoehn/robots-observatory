    <script>
      // 提前准备加载逻辑，减少执行延迟
      (function() {
        // 提前准备子应用配置（lang_prefix 已在前面定义）
        var notFoundSubappName = 'notFound_app';
        var notFoundSubappMountContainer = '#remote-notFound-container';
        var microAppNotFoundInstance = null;

        // DOM 就绪后再执行（head 内 onerror 时 body 尚未解析，需等 DOMContentLoaded）
        function whenDomReady(fn) {
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', fn);
          } else {
            fn();
          }
        }
        function showNotFoundFallback() {
          whenDomReady(function() {
            var notFoundRemote = document.getElementById('remote-notFound-container');
            var notFoundFallback = document.getElementById('notFound-fallback-wrap');
            if (notFoundRemote && notFoundFallback) {
              notFoundRemote.style.display = 'none';
              notFoundFallback.style.display = '';
            }
          });
        }
        window.applyQiankunFallback = showNotFoundFallback;

        function loadMicroApp(config) {
          try {
            var instance = qiankun.loadMicroApp(config);
            instance.mountPromise
              .catch(function(error) {
                showNotFoundFallback()
              });
            return instance;
          } catch(error) {
            showNotFoundFallback()
            return null;
          }
        }
        // 定义加载函数，等待 qiankun 就绪后立即执行
        function loadQiankun() {
          var searchParams = new URLSearchParams(window.location?.search);
          var isInApp = searchParams?.get('device_type') || document.cookie?.indexOf('device_type') > - 1;
          var domainBase = window.location.protocol + '//' + window.location.host + (typeof lang_prefix !== 'undefined' ? lang_prefix : '');

          if (!isInApp) {
            microAppNotFoundInstance = loadMicroApp({
              name: notFoundSubappName,
              entry: domainBase + '/404?type=remote-notFound',
              container: notFoundSubappMountContainer,
            });
          }
        }
        window.loadQiankun = loadQiankun;
      })();
    </script>
    <!-- 保持 defer 确保 DOM 就绪；onerror 时走兜底（qiankun 脚本加载失败） -->
    <script src="/cdn/fe/static/libs/qiankun.2.10.16.min.js" async onload="window.loadQiankun && window.loadQiankun()" onerror="window.applyQiankunFallback && window.applyQiankunFallback()"></script>
  
  
