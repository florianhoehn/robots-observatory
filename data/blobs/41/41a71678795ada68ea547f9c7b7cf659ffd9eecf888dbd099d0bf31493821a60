    <style>
      :root {
        --brand-yellow: #ffcc33;
        --border-muted: #d9dde3;
        --border-focus: #000000;
        --text-primary: #000000;
        --text-muted: rgba(0, 0, 0, 0.6);
        --text-button: rgba(0, 0, 0, 0.8);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        min-height: 100%;
        margin: 0;
      }

      body {
        background: #ffffff;
        color: var(--text-primary);
        font-family: Roboto, Arial, sans-serif;
        font-size: 14px;
        line-height: 1.4;
      }

      body.captcha-visible {
        background: var(--brand-yellow);
      }

      button,
      input {
        font: inherit;
      }

      button {
        cursor: pointer;
      }

      #wrapper-main {
        display: none;
      }

      .captcha-page {
        min-height: 100vh;
        padding: 24px;
        position: relative;
      }

      .captcha-card {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 400px;
        overflow: hidden;
        border-radius: 12px;
        background: #ffffff;
        box-shadow:
          0 24px 38px rgba(68, 92, 130, 0.14),
          0 9px 46px rgba(68, 92, 130, 0.12),
          0 11px 15px rgba(68, 92, 130, 0.2);
      }

      .captcha-card-inner {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 56px 24px 40px;
      }

      .captcha-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }

      .petrovich-logo {
        display: block;
        width: 110px;
        height: 24px;
      }

      .captcha-title {
        margin: 0;
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
        letter-spacing: 0.15px;
        text-align: center;
      }

      .captcha-ip {
        margin: -8px 0 0;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 400;
        line-height: 20px;
        text-align: center;
      }

      .captcha-image-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .captcha-area {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 148px;
        border: 1px solid var(--border-muted);
        background: #ffffff;
      }

      #captcha-img {
        display: block;
        width: 256px;
        height: 128px;
        object-fit: contain;
      }

      .reload-btn {
        display: inline-flex;
        align-items: center;
        align-self: flex-start;
        gap: 4px;
        min-height: 18px;
        padding: 0;
        border: 0;
        background: transparent;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 400;
        line-height: 14px;
      }

      .reload-btn:hover,
      .reload-btn:focus-visible {
        color: var(--text-primary);
      }

      .reload-text {
        display: inline-block;
        border-bottom: 1px dotted currentColor;
        line-height: 14px;
        padding-bottom: 1px;
      }

      .reload-btn:focus-visible,
      .check-btn:focus-visible,
      #captcha-input:focus-visible {
        outline: 2px solid rgba(0, 0, 0, 0.35);
        outline-offset: 3px;
      }

      .reload-icon {
        width: 16px;
        height: 16px;
        flex: 0 0 16px;
        color: currentColor;
      }

      .captcha-form {
        display: flex;
        flex-direction: column;
        gap: 48px;
      }

      .captcha-input-wrap {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        height: 56px;
        padding-top: 5px;
      }

      #captcha-input {
        width: 100%;
        height: 32px;
        padding: 5px 0;
        border: 0;
        border-bottom: 1px solid var(--border-focus);
        border-radius: 0;
        background: transparent;
        color: var(--text-primary);
        font-size: 16px;
        font-weight: 400;
        line-height: 22px;
        letter-spacing: 0.15px;
        appearance: none;
      }

      #captcha-input::placeholder {
        color: transparent;
      }

      .check-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 56px;
        padding: 8px 24px;
        border: 0;
        border-radius: 4px;
        background: var(--brand-yellow);
        color: var(--text-button);
        font-size: 16px;
        font-weight: 500;
        line-height: 40px;
        text-align: center;
      }

      .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        clip-path: inset(50%);
        white-space: nowrap;
      }

      @media (max-width: 600px) {
        body {
          background: #ffffff;
        }

        .captcha-page {
          min-height: 100vh;
          padding: 0;
          background: #ffffff;
        }

        .captcha-card {
          position: static;
          transform: none;
          width: 100%;
          max-width: 375px;
          margin: 0 auto;
          min-height: 100vh;
          border-radius: 0;
          box-shadow: none;
        }

        .captcha-card-inner {
          padding: 56px 16px 0;
        }
      }
    </style>

    <script>
      qauth_show_captcha = function (token, image) {
        document.getElementById("captcha-img").setAttribute("src", image);
        document.getElementById("captcha-token").value = token;
        document.getElementById("wrapper-main").style.display = "none";
        document.getElementById("wrapper-captcha").style.display = "block";
        document.body.classList.add("captcha-visible");
      };
      submit_captcha = function () {
        qauth_submit_captcha(
          document.getElementById("captcha-token").value,
          document.getElementById("captcha-input").value,
        );
      };
    </script>
