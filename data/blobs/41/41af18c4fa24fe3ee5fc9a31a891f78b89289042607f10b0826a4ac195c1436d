                <script type="text/javascript">
                    var langs = ["en", "fr", "es", "it", "de", "ja", "ko", "ru", "zh", "zh-hans"];
                    document.addEventListener("DOMContentLoaded", function(event) {
                        //var lang = $('html').attr('lang');
                        // Remove first & last "/" if exist at the end of URI
                        var sanitizedURI = window.location.pathname.slice(1).replace(/\/\s*$/, "");

                        // Remove first & last "/" if exist at the end of URI
                        var sanitizedURI = window.location.pathname.slice(1).replace(/\/\s*$/, "");
                        // Replace double slash "//" if exist by one slash "/"
                        sanitizedURI = sanitizedURI.replace(/\/\//g, "/");

                        var paramsArr = sanitizedURI.split("/");
                        var lang = 'en';
                        if (paramsArr.length>1) {
                            lang = paramsArr.shift();
                            if (langs.indexOf(lang) == -1)
                                lang = 'en'
                        }

                        if ( window.location.pathname == '/404-not-found/' ) {
                            var wockeyword = [ "Dassault Systemes" ] ;
                        }
                        else {
                            // Build "OR" Exalead Query
                            var wockeyword = sanitizedURI.replace(/\//g, " OR ").replace(/-/g, " ");
                        }

                        var options = {
                            filters: {
                                "id": "filters_404",
                                "persistent": true,
                                "shown": ["brand","industry"]
                            },
                            cards:{
                                id: "woc_404",
                                type : 'classic',
                                quantity : '8'
                            },
                            query: {
                                keyword: wockeyword,
                                contenttypes: []
                            },
                            loader: false,
                            urlparam: 'true',
                            language: lang,
                            infinite: false
                        };
                        var woc = new WoC(options);
                        woc.init();

                        woc.onNoResult(function(){
                            woc.reload({keyword:" "});
                        });
                    });

                    $( document ).ready(function() {
                        var myTagCo = document.querySelector('[property="tk:name"]');
                        myTagCo.setAttribute("content", '/404:_' + window.location.protocol + '//' + window.location.host + window.location.pathname);
                        var myOgUrl = document.querySelector('[property="og:url"]');
                        myOgUrl.setAttribute("content", window.location.protocol + '//' + window.location.host + window.location.pathname);
						// Update page Title
						var path = window.location.pathname;
						var sections = path.replace(/^\/+/, "").split("/");
						var sectionTitle = sections.join(" ");
						var domain = window.location.hostname;
						var finalTitle = sectionTitle + " - " + domain;
						document.title = finalTitle;
                    });

                </script>
