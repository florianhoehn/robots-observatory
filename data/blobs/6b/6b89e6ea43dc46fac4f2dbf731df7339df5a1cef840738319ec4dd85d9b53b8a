  align-items: center;
  justify-content: flex-end;
  max-width: var(--mm-max-width);
  margin: 0 auto;
  padding: 0 28px;
}

.mm-topbar-links {
  display: flex;
  align-items: center;
  list-style: none;
  margin: 0;
  padding: 6px 0;
  gap: 0;
}

.mm-topbar-link {
  font-family: var(--mm-font-topbar);
