  text-decoration: none;
  cursor: pointer;
}

.mm-nav button {
  font-family: inherit;
  color: inherit;
  cursor: pointer;
}

.mm-nav ul,
.mm-nav ol {
  list-style: none;
}

.mm-nav img {
  display: block;
  max-width: 100%;
}

.mm-nav h1,
.mm-nav h2,
.mm-nav h3,
.mm-nav h4,
.mm-nav h5,
.mm-nav h6,
.mm-nav p {
  font-size: inherit;
  font-weight: inherit;
}

/* ---------- Keyframes ---------- */
@keyframes mm-slide-down {
  from {
    opacity: 0;
    transform: translateY(-8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ---------- Base ---------- */
.mm-nav {
  --mm-max-width: 1440px;
  --mm-font: "Montserrat", sans-serif;
  --mm-font-topbar: "Figtree", "Montserrat", sans-serif;

  position: sticky;
  top: 0;
  z-index: 1000;
  font-family: var(--mm-font);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ---------- Accessibilité : focus visible (outline natif navigateur + léger arrondi) ---------- */
.mm-nav :focus-visible {
  outline: auto;
  outline-offset: 2px;
  border-radius: 4px;
}

/* Dark overlay — shown when a mega panel is open (toggled via .mm-overlay-active) */
.mm-nav::after {
  content: "";
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  opacity: 0;
  pointer-events: none;
  z-index: 49;
  transition: opacity 0.2s ease-in-out;
}

@media (min-width: 1024px) {
  /* Overlay only when a panel is actually OPEN (hover mode or aria-expanded). No :focus-within
     trigger: it lit the overlay for a mere focused universe link with its panel CLOSED (e.g.
     after a double click, focus stays on the link → ghost blocking overlay without dropdown).
     Keyboard open state is aria-expanded="true", already covered below. */
  .mm-nav:has(
      .mm-menu[data-hover-active] .mm-menu-item:hover > .mm-mega-panel
    )::after,
  .mm-nav:has(.mm-dropdown-toggle[aria-expanded="true"])::after,
  .mm-nav:has(.mm-subscriber:hover .mm-subscriber-dropdown)::after,
  .mm-nav:has(.mm-subscriber[aria-expanded="true"])::after {
    opacity: 1;
  }
}

/* Theme: light */
.mm-light {
  background: #ffffff;
  color: #262626;
}

/* Theme: dark */
.mm-dark {
  background: #161616;
  color: #ffffff;
}

/* ---------- Top Bar ---------- */
.mm-topbar {
  display: none;
  position: relative;
  z-index: 51;
  background: inherit;
}

@media (min-width: 1024px) {
  .mm-topbar {
    display: block;
  }
}

.mm-topbar-inner {
