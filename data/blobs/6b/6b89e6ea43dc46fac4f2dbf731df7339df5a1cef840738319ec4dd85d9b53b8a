/* ---------- Mobile Overlay (SSR-rendered, hidden by default) ---------- */
/* Positioned below the fixed mobile bar. No duplicate header — the bar
   stays visible with hamburger→× animation. */
.mm-mobile-overlay {
  display: none;
  position: fixed;
  top: 56px;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  flex-direction: column;
  background: #ffffff;
  overflow: hidden;
}

.mm-mobile-overlay[hidden] {
  display: none;
}

.mm-mobile-overlay.mm-mobile-open {
  display: flex;
  animation: mm-slide-down 0.2s ease-out;
}

.mm-dark .mm-mobile-overlay {
  background: #161616;
  color: #ffffff;
}

/* Mobile panel (shared by start + detail) */
.mm-mobile-panel {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  transition: transform 0.3s ease-in-out;
  overflow-y: auto;
}

.mm-dark .mm-mobile-panel {
  background: #161616;
}

.mm-mobile-panel-start {
  transform: translateX(0);
}

/* When a detail panel is active, start panel slides left */
.mm-mobile-overlay[data-active-panel] .mm-mobile-panel-start {
  transform: translateX(-30%);
  pointer-events: none;
}

/* Detail panels: off-screen right by default */
.mm-mobile-panel-detail {
  transform: translateX(100%);
}

/* Active detail panel slides in */
.mm-mobile-panel-detail.mm-mobile-panel-active {
  transform: translateX(0);
}

