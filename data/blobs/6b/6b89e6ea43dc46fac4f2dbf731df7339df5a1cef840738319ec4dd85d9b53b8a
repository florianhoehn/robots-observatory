/* ---------- Mail icon link ---------- */
.mm-mail-link {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 6px;
  border-radius: 8px;
  transition: background-color 0.15s;
  color: inherit;
  text-decoration: none;
}

/* abbr du picto mail : layout (le tooltip est porté par la classe générique .mm-tip). */
.mm-mail-abbr {
  display: inline-flex;
  text-decoration: none;
  border-bottom: 0;
  cursor: pointer;
}

/* Tooltip CSS générique — pattern <abbr class="mm-tip" aria-label="…" data-tooltip="…">.
   Apparition rapide, remplace le tooltip natif `title` (délai ~1s non réglable + curseur help). */
.mm-tip {
  position: relative;
}

.mm-tip::after {
  content: attr(data-tooltip);
  position: absolute;
  top: calc(100% + 14px);
  left: 50%;
  transform: translateX(-50%);
  padding: 4px 8px;
  background: #262626;
  color: #ffffff;
  font-size: 12px;
  line-height: 1.2;
  white-space: nowrap;
  border-radius: 4px;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.12s ease;
  z-index: 100;
}

.mm-tip:hover::after,
.mm-tip:focus-visible::after,
/* L'<abbr> .mm-tip n'est pas focusable : le focus clavier va sur le lien parent
   (.mm-mail-link) → on affiche aussi le tooltip quand CE lien a le focus. */
.mm-mail-link:focus-visible .mm-tip::after {
  opacity: 1;
  transition-delay: 0.1s; /* apparition quasi immédiate (vs ~1s du tooltip natif) */
}

