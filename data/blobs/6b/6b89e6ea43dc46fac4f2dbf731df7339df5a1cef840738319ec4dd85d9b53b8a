/* ---------- Menu (desktop only) ---------- */
.mm-menu {
  display: none;
  list-style: none;
  margin: 0;
  padding: 0;
  gap: 16px;
  align-items: center;
}

@media (min-width: 1024px) {
  .mm-menu {
    display: flex;
  }
}

/* ---------- Menu Item ---------- */
.mm-menu-item {
  position: static;
  display: flex;
  align-items: center;
}

/* Pont de survol : padding-bottom (+ margin-bottom compensatoire) UNIQUEMENT au :hover.
   Il prolonge la zone de survol sous le bouton pour rejoindre la card sans casser le hover.
   En permanent, ce padding entrait en conflit avec la mise en page d'un autre composant. */
.mm-menu-item:hover {
  padding-bottom: 20px;
  margin-bottom: -20px;
}

/* ---------- Menu Button / Link ---------- */
.mm-menu-btn {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 10px 6px;
  font-family: var(--mm-font);
  font-weight: 600;
  font-size: 16px;
  line-height: 24px;
  border-radius: 8px;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
  transition: background-color 0.15s;
}

.mm-menu-btn:hover,
.mm-menu-btn:focus-visible {
  background-color: #f4f4f4;
}

.mm-menu-btn[aria-expanded="true"] {
  background-color: #f4f4f4;
}

.mm-menu-btn:focus-visible {
