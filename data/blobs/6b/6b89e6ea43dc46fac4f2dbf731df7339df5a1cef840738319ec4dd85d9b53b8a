}

.mm-dark .mm-menu-btn:hover,
.mm-dark .mm-menu-btn:focus-visible,
.mm-dark .mm-menu-btn[aria-expanded="true"] {
  background-color: rgba(255, 255, 255, 0.1);
}

/* Red variant (Bons Plans) */
.mm-nav .mm-menu-btn.mm-menu-btn-red {
  color: #cc0000;
}

/* ---------- Dropdown Toggle (separate focusable chevron button) ---------- */
.mm-dropdown-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 24px;
  padding: 0;
  margin-left: -2px;
  border: none;
  background: none;
  color: inherit;
  cursor: pointer;
  border-radius: 4px;
  opacity: 0;
  transition: opacity 0.2s;
}

.mm-dropdown-toggle:focus-visible {
  /* browser default outline */
  opacity: 1;
}

.mm-dropdown-toggle[aria-expanded="true"] {
  opacity: 1;
}

/* ---------- Chevron ---------- */
.mm-chevron {
  width: 10px;
  height: 6px;
  opacity: 0.5;
  transition: transform 0.25s ease-in-out;
  flex-shrink: 0;
}

.mm-dropdown-toggle[aria-expanded="true"] .mm-chevron {
  transform: rotate(180deg);
  opacity: 1;
}

/* Body scroll lock when menu panel is open */
body.mm-scroll-lock {
  overflow: hidden;
}

/* ---------- Mega Panel ---------- */
.mm-mega-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  z-index: 50;
  /* padding x = 16px (2×16 = 32px) pour coller à la gouttière du conteneur
     (.mm-mega-container max-width: calc(100vw - 32px)) → pas de scroll horizontal */
  padding: 8px 16px 20px;
  display: none;
  max-width: var(--mm-max-width);
  max-height: calc(100vh - 88px);
  overflow-y: auto;
  margin: 0 auto;
  box-sizing: border-box;
}

/* Hover bridge: padding-bottom 20px + margin-bottom -20px on mm-menu-item
   extends the hover zone below each button without affecting layout.
   This keeps mm-menu-item:hover active when the cursor moves to the panel. */

/* CSS-driven dropdown: open on hover or JS-controlled expanded state */
@media (min-width: 1024px) {
  /* aria-expanded (clic/clavier) : visible quel que soit le mode. Le survol, lui, n'ouvre
     un panneau qu'en mode hover (data-hover-active, posé au 1er mousemove sur la barre — voir
     règle plus bas). Évite l'ouverture parasite au chargement : Firefox applique :hover dès
     le rendu selon la position du curseur (Chrome attend un mouvement). */
