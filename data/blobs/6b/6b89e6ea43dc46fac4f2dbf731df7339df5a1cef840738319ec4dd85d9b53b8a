}

.mm-dark .mm-topbar-link {
  color: #cccccc;
}

.mm-dark .mm-topbar-link:hover {
  color: #ffffff;
}

/* ---------- Bar ---------- */
.mm-bar {
  position: relative;
  z-index: 51;
  background: inherit;
}

.mm-bar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--mm-max-width);
