<script>
  //ensures callback runs even if load event already fired
   function runAfterLoad(callback) {
    const delayedCallback = () => {
      setTimeout(callback, 2000); 
    };

    if (document.readyState === "complete") {
      delayedCallback();
    } else {
      window.addEventListener("load", delayedCallback);
    }
  }

  function digDataPush(pageType) {
    digData.push({
      "event": "chat impression",
      "eventData": {
        "chatbot_type": pageType,
      },
    });
  }

  function isBusinessHoursET() {
    const now = new Date();
    const hourET = parseInt(new Intl.DateTimeFormat("en-US", {
      timeZone: "America/New_York",
      hour: "numeric",
      hour12: false
    }).format(now), 10);
    return hourET >= 9 && hourET < 18;
  }

  const chatIcon = document.getElementById('chatIcon');
  const chatFacet = document.getElementById('chatFacet');
  const chatFacetClose = document.getElementById('chatFacetClose');
  const chatFacetText = document.getElementById('chatFacetText');
  const chatFacetLink = document.getElementById('chatFacetLink');
  const chatFacetLinkTwo = document.getElementById('chatFacetLink-two');
  let pageType = "api";


  if (localStorage.getItem('chatFacetDismissed') !== 'true') {

    // Show facet automatically after delay
    setTimeout(() => {
      chatFacet.style.display = 'block';
      chatFacetText.innerHTML = 'Loading...';
      chatFacetLink.style.display = 'none';

      // Simulate loading delay
      setTimeout(() => {
        const path = window.location.pathname;

        let pageType = "api";
        if (pageType === 'homepage') {
          chatFacetText.innerHTML = `Have questions or ready to talk to a Vonage expert?<br />`;
          chatFacetLink.href = '/contact-us/?icid=chatbot_hp-pop-up_main-contact-us_link';
          chatFacetLink.textContent = 'Contact us now.';
          chatFacetLink.style.display = 'inline-block';

          runAfterLoad(() => {
            digDataPush('vbc');
            console.log('chat impression pushed for homepage in :', performance.now(),'ms');
          });
        } else if (pageType === 'api') {
          chatFacetText.innerHTML = `Have questions or ready to talk to an expert about Vonage APIs?<br />`;
          chatFacetLink.href = '/communications-apis/contact-api/?icid=chatbot_api-pop-up_contact-api_link';
          chatFacetLink.textContent = 'Contact us now.';
          chatFacetLink.style.display = 'inline-block';

          runAfterLoad(() => {
            digDataPush('api');
            console.log('chat impression pushed for api page in :', performance.now(),'ms');
          });
        } else if (pageType === 'cc') {
          chatFacetText.innerHTML = `Have questions or ready to talk to an expert about Vonage Contact Center?<br />`;
          chatFacetLink.href = '/contact-centers/contact-cc/?icid=chatbot_vcc-pop-up_contact-cc_link';
          chatFacetLink.textContent = 'Contact us now.';
          chatFacetLink.style.display = 'inline-block';

          runAfterLoad(() => {
            digDataPush('vcc');
            console.log('chat impression pushed for cc pagein :', performance.now(),'ms');
          });
        } else if (pageType === 'applications') {
          chatFacetText.innerHTML = `Have questions or ready to talk to an expert about Vonage Business Communications?<br />`;
          chatFacetLink.href = '/schedule/?icid=chatbot_vbc-pop-up_schedule_schedule-a-call-link';
          chatFacetLink.textContent = 'Schedule a call.';
          chatFacetLink.style.display = 'inline-block';

          // --- SECOND CTA CONDITION ONLY FOR APPLICATIONS ---
          if (isBusinessHoursET()) {
            chatFacet.classList.add('with-two-ctas');
            chatFacetLinkTwo.href = '/schedule.html?icid=chatbot_vbc-pop-up_schedule_call-me-now-link';
            chatFacetLinkTwo.textContent = 'Call me now.';
            chatFacetLinkTwo.style.display = 'inline-block';
          } else {
            chatFacetLinkTwo.style.display = 'none';
          }
          window.addEventListener('load', function() {
            digDataPush('vbc');
            console.log('chat impression pushed for applications page in :', performance.now(),'ms');
          });
        } else {
          //Hide Chatbot for rest of the pages.
          chatFacet.style.display = 'none';
          chatIcon.style.display = 'none';
        }
      }, 800); // After loading
    }, 1000); // Initial delay before auto-show

    // Manual toggle on icon click
    chatIcon.addEventListener('click', () => {
      chatFacet.style.display = chatFacet.style.display === 'block' ? 'none' : 'block';
    });

    // On close: hide + set cookie + hide chat icon too
    chatFacetClose.addEventListener('click', () => {
      chatFacet.style.display = 'none';
      chatIcon.style.display = 'none';
      localStorage.setItem('chatFacetDismissed', 'true');
    });

    chatFacet.addEventListener('click', function (event) {
      const isLinkClick = event.target.tagName === 'A';
      const isSecondCTA = event.target.id === 'chatFacetLink-two';
      let href = isLinkClick ? event.target.href : null;

      // update attribution 
      if (localStorage.getItem('attribution') != null) {
        var attrValue = JSON.parse(localStorage.getItem('attribution'));
        attrValue.utmData.utm_source = 'web';
        attrValue.utmData.utm_medium = 'popup';

        // Default campaign based on pageType
        if (pageType === 'homepage' || pageType === 'applications') {
          attrValue.utmData.utm_campaign = '25fy-app-uc-gbl-dig-pop-up';
        } else if (pageType === 'api') {
          attrValue.utmData.utm_campaign = '25fy-api-api-gbl-dig-pop-up';
        } else if (pageType === 'cc') {
          attrValue.utmData.utm_campaign = '25fy-app-cc-gbl-dig-pop-up';
        }

        // Override if second CTA clicked
        if (isSecondCTA) {
          attrValue.utmData.utm_campaign = '25fy-app-uc-gbl-dig-pop-up-call-now';
        }

        localStorage.setItem('attribution', JSON.stringify(attrValue));
      }

      if (isLinkClick) {
        const url = new URL(href);
        const dynamicIcid = url.searchParams.get("icid") || "";

        if (pageType === 'applications') {
          const chatDigData = {
          event: "chat impression",
          eventData: {
            chatbot_type: 'vbc',
            chatbot_icid: dynamicIcid
            }
          };
        localStorage.setItem('chatbotDigData', JSON.stringify(chatDigData)); // store before navigation
        }     

        localStorage.setItem('chatFacetDismissed', 'true');
        event.preventDefault();
        setTimeout(() => {
          window.location.href = href;
        }, 100);
      }
    });

  } else {
    // Hide both permanently if cookie is set
    chatFacet.style.display = 'none';
    chatIcon.style.display = 'none';
  }

  //# sourceURL=chatbot-popup.js
</script>

    
    
    
        
    

