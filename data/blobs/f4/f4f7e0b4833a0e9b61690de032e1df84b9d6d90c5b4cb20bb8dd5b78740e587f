<style>
  /* Chat icon */
  .chat-icon {
    position: fixed;
    bottom: 20px;
    right: 20px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 30px;
    z-index: 1000;
  }

  /* Facet container */
  .chat-facet {
    position: fixed;
    bottom: 10px;
    right: 110px;
    max-width: 320px;
    background: white;
    border-radius: 8px;
    border: 1px solid #D1D1D1;
    padding: 15px 20px 15px 20px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
    font-size: 14px;
    line-height: 1.4;
    color: #222;
    display: none;
    z-index: 999;
    font-family: Spezia,Spezia_SemiMono,Arial,Helvetica,sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 16px;
    line-height: 100%;
    letter-spacing: 0;
  }

  @media (max-width: 767px) {
    .chat-facet {
      max-width: 250px;
    }
  }

  .chat-facet::before,
  .chat-facet::after {
    content: "";
    position: absolute;
    top: 50px;
    right: -15px;
    width: 0;
    height: 0;
    border-top: 12px solid transparent;
    border-bottom: 12px solid transparent;
  }

  .chat-facet::before {
    border-left: 15px solid #D1D1D1;
    /* border layer */
    right: -16px;
    /* offset 1px to show border behind */
    z-index: 0;
  }

  .chat-facet::after {
    border-left: 15px solid white;
    /* actual arrow */
    z-index: 1;
  }

  /* Close button */
  .chat-facet-close {
    position: absolute;
    top: 8px;
    right: 12px;
    font-weight: bold;
    font-size: 18px;
    color: #333;
    cursor: pointer;
    user-select: none;
  }

  .chat-facet-close:hover {
    color: #000;
  }

  /* Text inside facet */
  .chat-facet-text {
    padding-right: 25px;
    /* space so text doesn't overlap close button */
  }

  /* Link styling */
  .chat-facet-link {
    display: inline-block;
    margin-top: 8px;
    text-decoration: underline !important;
    color: #000000;
    cursor: pointer;
    font-family: Spezia,Spezia_SemiMono,Arial,Helvetica,sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 16px;
    line-height: 26px;
    letter-spacing: 0;
    cursor: pointer;
  }

  .chat-facet-link:hover {
    color: #000000;

  }

  .chat-facet-link {
    position: relative;

    &.second-cta::before {
      pointer-events: none;
      content: '';
      position: absolute;
      right: -20px;
      top: 0;
      height: 100%;
      width: 2px;
      background-color: #782DDF;
    }
  }
  .chat-facet-link-container {
    margin-top: 1rem;
    display: flex;
    gap: 4rem;
  }
 @media (max-width: 768px) {
  .chat-facet-link-container {
    flex-direction: column;
    align-items: flex-start; 
    gap: 0px; 
  }

  .chat-facet-link + .second-cta::before {
    display: none;
  }

  .chat-facet-link {
    width: 100%;
  }

}
