<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>网易电子邮箱</title>
    <style>
        *{padding: 0;margin: 0;}
        .err-wrap{margin: 15% auto 0; text-align: center; font-size: 14px; line-height: 20px;}
        .err-tit{margin-top: 30px; color: #2A2A2A; font-size: 16px; line-height: 22px;}
        .err-des{margin-top: 14px; color: #999999;}
        .err-link a{ color: #6a8de5; text-decoration: underline;}
    </style>
</head>
<body>
    <div class="err-wrap">
        <div class="err-pic"><img id="errPic" width="250"></div>
        <div class="err-tit">糟糕，出现了错误</div>
        <div class="err-des">服务器开小差了，怎么办？当然是原谅它啦</div>
        <div class="err-link"><a id="errLink" target="_self">返回首页</a></div>
    </div>
    <script>
        (function(){
            var sPicUrl = '//mimg.127.net/ggimg/all/img21/190909_404_blue.jpg';
            var sColor = '#6a8de5';
            var sLink = 'https://mail.163.com/?from=404';
            var errPic = document.getElementById('errPic'), errLink = document.getElementById('errLink');
            var sHref = location.href;
            if (sHref.indexOf('vip.163.com') != -1) {
                sPicUrl = '//mimg.127.net/ggimg/all/img21/190909_404_vip.png';
                sColor = '#c09f62';
                sLink = 'https://vip.163.com/?from=404';
            }else if(sHref.indexOf('vip.126.com') != -1){
                sPicUrl = '//mimg.127.net/ggimg/all/img21/190909_404_vip.png';
                sColor = '#c09f62';
                sLink = 'https://vip.126.com/?from=404';
            }else if(sHref.indexOf('188.com') != -1){
                sPicUrl = '//mimg.127.net/ggimg/all/img21/190909_404_vip.png';
                sColor = '#c09f62';
                sLink = 'https://vip.188.com/?from=404';
            }else if(sHref.indexOf('yeah.net') != -1){
                sLink = 'https://mail.yeah.net/?from=404';
            }else if(sHref.indexOf('126.com') != -1){
                sPicUrl = '//mimg.127.net/ggimg/all/img21/190909_404_green.jpg';
                sColor = '#6fc980';
                sLink = 'https://mail.126.com/?from=404';
            }else{
                sLink = 'https://mail.163.com/?from=404';
            }
            errPic.setAttribute('src', sPicUrl);
            errLink.setAttribute('href', sLink);
            errLink.style.color = sColor;
        })();
    </script>
</body>
</html>