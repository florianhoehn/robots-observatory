/* ============================================================
   Save original referrer AND UTM params BEFORE any redirect.
   MUST be the first <script> in <head> so it runs before
   the language-redirect logic and the Convert Experiences
   script (either of which can navigate away and wipe
   document.referrer).
   ============================================================ */
(function () {
  var REF_KEY   = 'original_referrer';
  var TS_KEY    = 'original_referrer_ts';
  var UTM_KEY   = 'original_landing_params';
  var TTL_MS    = 30 * 60 * 1000; // 30 minutes

  /* ---------- debug helper (add ?ab_debug=1 to any URL) ---------- */
  var DEBUG = false;
  try {
    DEBUG = window.__AB_DEBUG === true ||
            (new URLSearchParams(window.location.search)).get('ab_debug') === '1';
  } catch (e) {}
  function dbg() {
    if (!DEBUG) return;
    var a = Array.prototype.slice.call(arguments);
    a.unshift('[AB-DEBUG][head-referrer]');
    console.log.apply(console, a);
  }

  try {
    var now = Date.now();

    /* ---- 0. Record the landing URL for this tab session ---- */
    // Only set once per tab session (sessionStorage is per-tab but
    // survives same-tab JS redirects). On the redirect destination,
    // the body script compares this to the current URL to detect
    // that a redirect happened.
    if (!sessionStorage.getItem('landing_pathname')) {
      sessionStorage.setItem('landing_pathname', window.location.pathname);
      dbg('Recorded landing pathname:', window.location.pathname);
    } else {
      dbg('Landing pathname already set:', sessionStorage.getItem('landing_pathname'));
    }

    /* ---- 1. Preserve the external referrer (full URL) ---- */
    var ref = document.referrer || '';
    if (ref) {
      var refHost = (new URL(ref)).hostname.replace(/^www\./, '');
      var ownHost = window.location.hostname.replace(/^www\./, '');

      if (refHost && refHost !== ownHost) {
        localStorage.setItem(REF_KEY, ref);
        localStorage.setItem(TS_KEY, String(now));
        // Mark THIS tab as the one that stored the referrer.
        // Prevents cross-tab bleed via shared localStorage.
        sessionStorage.setItem('referrer_stored_this_tab', '1');
        dbg('Stored external referrer:', ref, 'ts:', now);
      } else {
        dbg('Referrer is internal or same-site; not storing:', ref);
      }
    } else {
      dbg('document.referrer is empty (true direct visit)');
    }

    /* ---- 2. Preserve UTM / tracking params from the landing URL ---- */
    var search = window.location.search;
    if (search && /utm_|gclid|fbclid|msclid|ttclid|twcid|rdt_cid|li_fat_id/.test(search)) {
      localStorage.setItem(UTM_KEY, search);
      dbg('Stored landing params:', search);
    }
  } catch (e) {
    if (DEBUG) console.log('[AB-DEBUG][head-referrer] Error:', e);
  }
})();
