<script>
  // Appends a redirect_to parameter to all links that contain a matching campaign value.
  const campaignRedirectMap = {
    "show-notes-landing-page": "/dashboard/home?start-actions=show-notes",
    //"magic-clips-landing-page": "/dashboard/home?campaign=magic-clips-landing-page",
    "transcription-landing-page": "/dashboard/home?start-actions=transcribe",
    "captions-landing-page": "/dashboard/home?start-actions=captions",
    "editor-landing-page": "/editor?start-actions=edit",
    "live-studio-landing-page": "/dashboard/start-actions?campaign=live-studio-landing-page",
    "editor-landing-page-co-creator": '{"hasFile":false,"prompt":""}',
  };

  function appendRedirectToLinks() {
    const links = document.querySelectorAll("a[href]");

    links.forEach((link) => {
      const href = link.getAttribute("href");

      for (const [campaign, redirectTo] of Object.entries(campaignRedirectMap)) {
        const url = new URL(href, window.location.origin);
        if (url.searchParams.get("campaign") === campaign) {
          const separator = href.includes("?") ? "&" : "?";
          link.setAttribute(
            "href",
            `${href}${separator}redirect_to=${encodeURIComponent(redirectTo)}`
          );
          break;
        }
      }
    });  
  }

  document.addEventListener("DOMContentLoaded", appendRedirectToLinks);
