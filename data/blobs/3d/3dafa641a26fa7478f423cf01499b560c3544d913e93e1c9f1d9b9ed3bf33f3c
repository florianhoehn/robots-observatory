  <meta name="description" content="İşverenler için eleman, iş arayanlar için iş ilanı Kariyer.net`te! İş arıyorum diyorsanız, CV`nizle iş başvurularına hemen başlayın, aradığınız işi bulun!">
<style>
  @font-face {
    font-family: Roboto-Medium;
    src: url(https://aday-spage.mncdn.com/Knet_fonts_Roboto-Medium.1d3bced.woff2?);
  }
  @font-face {
    font-family: Roboto-Light;
    src: url(https://aday-spage.mncdn.com/Knet_fonts_Roboto-Light.c27d89a.woff2);
  }
  body {
    font-family: 'Roboto', sans-serif;
    font-size: .875rem;
    font-weight: 400;
    line-height: 1.5;
    color: #333333;
    background-color: #fff;
    margin: 0;
    padding: 0;
  }
  .error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .top-section {
    text-align: center;
    margin-top: 40px;
    margin-bottom: 24px;
    max-width: 600px;
    width: 100%;
    border-bottom: 1px solid #e5e5e5;
  }
  .top-section img {
    max-width: 100%;
    height: auto;
  }
  .text-block {
    margin-top: 24px;
  }
  .text-block h4 {
    font-weight: 500;
    font-size: 26px;
    line-height: 32px;
    margin-bottom: 8px;
    margin-top: 24px;
  }
  .text-block span {
    font-weight: 300;
    font-size: 20px;
    line-height: 1.27;
  }
  .action-block {
    margin-top: 24px;
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
  }
  #back-to-home-button {
    background-color: #8316b5;
    padding: 9px 16px;
    border-radius: 4px;
    color: #fff;
    text-decoration: none;
    font-weight: 500;
  }
  #back-to-home-button:hover {
    background-color: #7512a2;
  }
  .bottom-section {
    display: flex;
    flex-direction: column;
    max-width: 600px;
    width: 100%;
    text-align: left;
  }
  .bottom-section h4 {
    margin-bottom: 8px;
    font-weight: 500;
    font-size: 22px;
    margin-top: 0;
  }
  .items .item {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid #e5e5e5;
    padding-bottom: 24px;
    margin-top: 24px;
    text-decoration: none;
    color: #333;
  }
  .items .item .info-wrapper {
    display: flex;
  }
  .items .item .badge {
    padding: 8px;
    background-color: #f4e4fc;
    width: 30px;
    height: 30px;
    margin-right: 8px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #8316b5;
  }
  .items .item .info h5 {
    margin: 0;
    font-size: 16px;
    line-height: 22px;
    margin-bottom: 4px;
    font-weight: 500;
  }
  .items .item .info p {
    font-size: 14px;
    line-height: 20px;
    font-weight: 400;
    color: #878787;
    margin: 0;
  }
  .help-section {
    margin-top: 32px;
  }
  .help-section p {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    line-height: 22px;
    font-weight: 400;
    color: #333;
  }
  .help-section a {
    margin-left: 4px;
    text-decoration: none;
    font-weight: 700;
    color: #333;
  }
  @media (max-width: 600px) {
    .text-block h4 {
      font-size: 18px;
    }
    .text-block span {
      font-size: 14px;
    }
    .items .item .info h5 {
      font-size: 16px;
    }
    .items .item .info p {
      font-size: 14px;
    }
  }
</style>
</head>
<body>
  <div class="error">
