<script>

    var link = 'https://bookings.omnihotels.com/login';
    var linkLabel = 'Select Guest';
    var accountLabel = '';
    var welcome = '';

        
        accountLabel = 'Account';
        welcome = 'Welcome';
        

document.addEventListener("DOMContentLoaded", function (event) {

    var loggedIn = false;
    var SG_membershipLevel = '';
    var firstName = '';
    var SG_membershipNumber = '';
    var tier_nights = '';
    var omniCredits = '';
    var tierDollars = '';

    jQuery('#sg-nav-label').html(linkLabel);

    if (jQuery.cookie("login_fg_public")) {
            var cookie = jQuery.cookie("login_fg_public").split("|");

            jQuery.each(cookie, function (i, val) {
                if (val.indexOf("SG_membershipLevel") > -1) {
                    var value = val.split(":");
                    SG_membershipLevel = value[1];
                }
                if (val.indexOf("firstName") > -1) {
                    var value = val.split(":");
                    firstName = value[1];
                }
                if (val.indexOf("SG_membershipNumber") > -1) {
                    var value = val.split(":");
                    SG_membershipNumber = value[1];
                    loggedIn = true;
                }
                if (val.indexOf("tier_nights") > -1) {
                    var value = val.split(":");
                    tier_nights = value[1];
                }
                if (val.indexOf("tierNights") > -1) {
                    var value = val.split(":");
                    tier_nights = value[1];
                }           
                if (val.indexOf("omniCredits") > -1) {
                    var value = val.split(":");
                    omniCredits = value[1];
                }
                if (val.indexOf("tierDollars") > -1) {
                    var value = val.split(":");
                    tierDollars = value[1];
                }
            });

        }

    if (!loggedIn) {
        jQuery('#sg-nav-label').html(linkLabel);
        jQuery('#sg-link').attr('href', link);
        jQuery('#account-li').off('click');
    } else {
        jQuery('#account-li').