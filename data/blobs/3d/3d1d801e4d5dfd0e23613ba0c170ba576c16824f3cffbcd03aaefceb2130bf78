                    @mousedown="autoSuggestionClicked(suggestion)"
                    class="p-l_3 h:bg_primary-3" :class="{'bg_primary-3' : index === activeAutoIndex}"
                    v-html="highlightSearchTermInSuggestion(suggestion.value)">
