        .error-page-wrapper {
            min-height: calc(100vh - 200px);
            padding: 90px 16px;
            background: radial-gradient(circle at top, #eef3ff 0, #f5f7fb 40%, #f5f7fb 100%);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .error-page-wrapper .error-card {
            background: #ffffff;
            max-width: 720px;
            width: 100%;
            border-radius: 28px;
            box-shadow: 0 26px 60px rgba(15, 23, 42, 0.16);
            padding: 40px 48px 34px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        /* شوية ديكور خفيف في الخلفية داخل الكارت */
        .error-page-wrapper .error-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 999px;
            background: rgba(129, 140, 248, 0.08);
            top: -80px;
            right: -40px;
            pointer-events: none;
        }

        .error-page-wrapper .error-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 8px 18px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            background: #e0e7ff;
            color: #1d4ed8;
            margin-bottom: 18px;
            position: relative;
            z-index: 1;
        }

        .error-page-wrapper .error-icon {
            width: 64px;
            height: 64px;
            border-radius: 999px;
            margin: 0 auto 14px;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #c7d2fe;
            position: relative;
            z-index: 1;
        }

        .error-page-wrapper .error-icon span {
            font-size: 30px;
        }

        .error-page-wrapper .error-code-big {
            font-size: 60px;
            font-weight: 800;
            line-height: 1;
            color: #111827;
            margin-bottom: 6px;
            position: relative;
            z-index: 1;
        }

        .error-page-wrapper .error-title {
            font-size: 24px;
            font-weight: 600;
            color: #1f2933;
            margin-bottom: 12px;
            position: relative;
            z-index: 1;
        }

        .error-page-wrapper .error-description {
            font-size: 15px;
            color: #4b5563;
            line-height: 1.8;
            max-width: 520px;
            margin: 0 auto 24px;
            position: relative;
            z-index: 1;
        }

        .error-page-wrapper .error-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            justify-content: center;
            margin-bottom: 22px;
            position: relative;
            z-index: 1;
        }

        .error-actions .ui.button {
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;

			height: 40px;               /* توحيد الارتفاع */
			line-height: 40px !important;
			padding: 0 20px !important;

			font-size: 14px;
			font-weight: 600;
			border-radius: 8px;
		}

        .error-page-wrapper .error-actions .ui.button:not(.primary) {
            background: #e5e7eb;
            color: #111827;
        }

        .error-page-wrapper .error-actions .ui.primary.button {
            background: #111827;
            color: #ffffff;
        }

        .error-page-wrapper .error-footer-note {
            font-size: 12px;
            color: #9ca3af;
            position: relative;
            z-index: 1;
        }

        @media (max-width: 768px) {
            .error-page-wrapper {
                padding: 70px 12px;
            }

            .error-page-wrapper .error-card {
                padding: 32px 20px 26px;
                border-radius: 22px;
            }

            .error-page-wrapper .error-code-big {
                font-size: 46px;
            }

            .error-page-wrapper .error-title {
                font-size: 20px;
            }

            .error-page-wrapper .error-description {
                font-size: 14px;
            }
        }
