<script>
const gpuVariants = [
	{
		action: "Reserve",
		name: "AMD Helios™ and AMD Instinct™ MI455X",
		cta: "Reserve now",
		link: "https://www.vultr.com/products/cloud-gpu/amd-mi455x/"
	}
];

let currentIndex = 0;
const gpuText = document.getElementById('gpu');
const actionText = document.getElementById('banner-action');
const ctaBtn = document.getElementById('banner-cta');
const ctaText = document.getElementById('banner-cta-text');
const banner = document.getElementById('banner-text');

function updateBanner(index) {
	const gpuData = gpuVariants[index];
	actionText.innerText = gpuData.action;
	gpuText.innerText = `${gpuData.name} GPUs`;
	ctaText.innerText = gpuData.cta;
	ctaBtn.href = gpuData.link;
	banner.setAttribute('aria-label', `${gpuData.action} ${gpuData.name} GPUs on Vultr now.`);
}

function changeText() {
	setTimeout(() => {
		gpuText.classList.add('hide');
	}, 7700);

	setTimeout(() => {
		currentIndex = (currentIndex + 1) % gpuVariants.length;
		updateBanner(currentIndex);
		gpuText.classList.remove('hide');
	}, 8000);
}

updateBanner(currentIndex);
if (gpuVariants.length > 1) {
	changeText();
	setInterval(changeText, 8000);
}
</script>

