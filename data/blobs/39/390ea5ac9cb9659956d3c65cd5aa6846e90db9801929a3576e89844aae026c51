    <div id="imagePopWin" class="ADpopbox" style="display:none;"></div>
    <script>

        var _popWinCacheKey = "PopWinData"

        function initPopWin() {
            if (/\d+\.shtml/.test(location.href)) return;

            var needUpdate = false;
            var _v = Storage.getLocalWithExpire(_popWinCacheKey);
            if (_v) {
                try {
                    setPopWinData(_v);
                } catch (e) {
                    needUpdate = true;
                }
            }
            else {
                needUpdate = true;
            }

            if (needUpdate) {
                $.get("/templatedata/popwin.txt?t=" + new Date().getTime(), result => {
                    if (!result) return;
                    Storage.setLocalWithExpire(_popWinCacheKey, result, 60 * 1);
                    setPopWinData(result);
                })
            }
        }

        function setPopWinData(result) {
            let data = JSON.parse(result)
            if (!data) return;

            let { id, hour, img, button, text, text2, link, openh5, showType } = data;
            let box = $("#imagePopWin")

            if (showType == 0 && location.pathname != "/" && location.pathname != "/vi" && location.pathname != "/th") {
                return;
            }

            box.addClass(showType == 0 ? "v1" : "v2");
            box.append(`
                <i class="close" onclick="closeImgPopWin(${id}, ${hour})"></i>
                <p>${text}${text2 ? `<span>${text2}</span>` : ""}</p>
                <button onclick="goToPopWinLink('${link}',${showType})">${button}<i></i></button>
                <img class="adimg" src="${img}">
            `);

            let click = getCookie(`popWin_${id}`)
            if (!click && openh5) {
                setTimeout(() => {
                    box.show()
                    writeShareCookie(`popWin_${id}`, "1", new Date(new Date().getTime() + 1000 * 3600 * hour))
                }, 1000)
            }
        }

        initPopWin();

        function goToPopWinLink(link, showType) {
            $("#imagePopWin .close").click()
            if (showType == 1) {
                checkUser().then(userInfo => {
                    if (!userInfo) {
                        handleBackFromBf(`${_userWebDomain}/account/register`);
                    } else {
                        if (0 == 1) {
                            location.href = `https://tips.thscore99.com${getCulturePrefix()}/pk`;
                        }
                    }
                })
            }
            else {
                window.open(link)
            }
        }

        function closeImgPopWin(id, hour) {
            $("#imagePopWin").hide()
            writeShareCookie(`popWin_${id}`, "1", new Date(new Date().getTime() + 1000 * 3600 * hour))
        }

        function checkUser() {
            const url = `${_userWebDomain}/user/info`;
            return new Promise((resolve, reject) => {
                fetch(url, { credentials: 'include' })
                    .then(response => {
                        if (!response.ok) {
                            throw new Error(`http error! status: ${response.status}`);
                        }
                        return response.json();
                    })
                    .then(result => {
                        if (result.code == 200) resolve(result.data)
                        else resolve(null)
                    })
                    .catch(err => {
                        console.log("checkUser failed", err)
                        resolve(null)
                    })
            })
        }
    </script>

