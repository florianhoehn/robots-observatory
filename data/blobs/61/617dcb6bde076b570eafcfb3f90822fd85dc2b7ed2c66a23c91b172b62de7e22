    // Lazy loading per Outbrain widgets usando Intersection Observer
    document.addEventListener('DOMContentLoaded', function() {
        var outbrainLazyElements = document.querySelectorAll('.OUTBRAIN-lazy');

        if (outbrainLazyElements.length > 0) {
            var outbrainObserver = new IntersectionObserver(function(entries, observer) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        // Appena il primo elemento è visibile, aggiornali tutti
                        var allLazyElements = document.querySelectorAll('.OUTBRAIN-lazy');
                        allLazyElements.forEach(function(el) {
                            el.classList.remove('OUTBRAIN-lazy');
                            el.classList.add('OUTBRAIN');
                        });

                        if (!__outbrain_script_loaded) {
                            // Script non ancora caricato (pagina senza widget immediati): caricalo ora
                            loadOutbrainScript();
                        } else if (window.OBR && OBR.extern) {
                            // Script già caricato per i widget immediati: chiedi a Outbrain di ri-scansionare
                            OBR.extern.researchWidget();
                        }

                        // Disconnetti l'observer, il suo lavoro è finito
                        observer.disconnect();
                    }
                });
            }, {
                rootMargin: '200px' // Carica 200px prima che l'elemento entri nella viewport
            });

            // Osserva solo il primo elemento per attivare il processo
            outbrainObserver.observe(outbrainLazyElements[0]);
        }
    });

    // Funzione per caricare lo script Outbrain
    function loadOutbrainScript() {
        console.log("Caricamento script Outbrain...");
        if (!__outbrain_script_loaded && __outbrain_consent_granted) {
