                molVideoPlayers.forEach(player => {
                    const wrapper = document.createElement('div');
                    wrapper.classList.add('molvideoplayer-iframe-wrapper');
                    player.parentNode.insertBefore(wrapper, player);
                    wrapper.appendChild(player);
                });
            }
