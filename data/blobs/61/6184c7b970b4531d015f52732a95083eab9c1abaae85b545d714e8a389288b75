<!DOCTYPE html>
<html xml:lang="en-GB" lang="en-GB">
  <head>
      <!--comment from Will-->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta http-equiv="pragma" content="no-cache" />
    <meta http-equiv="cache-control" content="no-cache" />
    <meta name="viewport" content="width=device-width, user-scalable=no" />
    <meta http-equiv="refresh" content="60; url=http://www.diy.com/" />
    <meta name="description" content="Site under maintenance" />
    <title>B&amp;Q</title>

    <style>
      /* resets */
      body {
        margin: 0;
        padding: 0;
        font: 16px/1.2 "GoodHome", Arial, Helvetica, sans-serif;
        color: #323c41;
      }
      h1,
      h2,
      p {
        margin: 0;
      }
      /* sticky footer */
      html,
      body {
        height: 100%;
      }
      .main {
        min-height: calc(100vh - 128px);
        position: relative;
      }
      /* main */
      .header,
      .footer {
        background-color: #323c41;
      }
      .header {
        height: 80px;
      }
      .wrapper {
        max-width: 1288px;
        margin: auto;
        padding: 16px 32px;
      }
      .site-logo svg,
      .paint-bucket svg {
        display: block;
      }
      .paint-bucket svg {
        margin: 0 auto;
        padding: 60px 0 32px 0;
      }
      .content {
        max-height: 780px;
        text-align: center;
        margin-bottom: 16px;
      }
      .footer {
        height: 48px;
      }
      /* fonts */
      .content h1,
      .content h2 {
        padding-bottom: 32px;
      }
      .content h1 {
        font-size: 26px;
      }
      .content h2 {
        font-size: 20px;
      }
      .content p {
        color: #6f767a;
        line-height: 1.5;
      }
      .copyright {
        color: #fff;
        font-size: 12px;
        line-height: 16px;
      }
      /* links */
      .telephone {
        color: #323c41;
        font-weight: 700;
        text-decoration: none;
      }
      .telephone:hover {
        text-decoration: underline;
      }
      @media screen and (max-width: 767px) {
        .main {
          min-height: calc(100vh - 104px);
        }
        .header {
          height: 56px;
        }
        .site-logo svg {
          height: 40px;
          width: 40px;
        }
        .paint-bucket svg {
          padding: 32px 0;
        }
        .wrapper {
          padding: 8px 16px;
        }
        .paint-bucket svg {
          width: 200px;
          height: 120px;
        }
        .content h1 {
          font-size: 20px;
          padding-bottom: 24px;
        }
        .content h2 {
          font-size: 16px;
          padding-bottom: 16px;
        }
        .telephone {
          display: block;
        }
        .copyright {
          padding: 8px 0;
        }
      }
    </style>
  </head>

