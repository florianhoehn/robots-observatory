        <script id="su-mobile-submenus-js">
        (function () {
            var navigation = document.querySelector('.su-header-navigation');
            if (!navigation || navigation.classList.contains('su-mobile-menu-ready')) return;
            var menu = navigation.querySelector('#main_menu');
            if (!menu) return;
            var mobile = window.matchMedia('(max-width: 990px)');
            var entries = [];

            function closeSubmenus(except) {
                entries.forEach(function (entry) {
                    if (entry === except) return;
                    entry.item.classList.remove('su-submenu-open');
                    entry.button.setAttribute('aria-expanded', 'false');
                });
            }

            Array.prototype.forEach.call(menu.children, function (item, index) {
                var link = item.querySelector(':scope > a');
                var submenu = item.querySelector(':scope > ul.sub-menu');
                if (!link || !submenu) return;
                var label = link.textContent.trim();
                var button = document.createElement('button');
                button.type = 'button';
                button.className = 'su-mobile-submenu-toggle';
                button.textContent = label;
                if (!submenu.id) submenu.id = 'su-header-submenu-' + index;
                button.setAttribute('aria-controls', submenu.id);
                button.setAttribute('aria-expanded', 'false');
                link.classList.add('su-mobile-submenu-link');
                item.insertBefore(button, submenu);

                // Preserve a parent page destination when its mobile label becomes a toggle.
                var href = link.getAttribute('href');
                if (href && href.charAt(0) !== '#') {
                    var overview = document.createElement('li');
                    overview.className = 'su-mobile-menu-overview';
                    var overviewLink = link.cloneNode(true);
                    overviewLink.classList.remove('su-mobile-submenu-link');
                    overviewLink.removeAttribute('id');
                    overviewLink.textContent = 'All ' + label.toLowerCase();
                    overview.appendChild(overviewLink);
                    submenu.insertBefore(overview, submenu.firstChild);
                }

                var entry = { item: item, button: button };
                entries.push(entry);
                button.addEventListener('click', function () {
                    if (!mobile.matches) return;
                    var opening = button.getAttribute('aria-expanded') !== 'true';
                    closeSubmenus(entry);
                    item.classList.toggle('su-submenu-open', opening);
                    button.setAttribute('aria-expanded', String(opening));
                });
                item.addEventListener('keydown', function (event) {
                    if (mobile.matches && event.key === 'Escape' && item.classList.contains('su-submenu-open')) {
                        closeSubmenus();
                        button.focus();
                        event.preventDefault();
                    }
                });
            });

            navigation.classList.add('su-mobile-menu-ready');
            var menuToggle = navigation.querySelector('.btn-mobile-menu');
            if (menuToggle) menuToggle.addEventListener('click', function () { closeSubmenus(); });
            mobile.addEventListener('change', function () { closeSubmenus(); });
        }());
        </script>

