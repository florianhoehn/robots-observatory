    <script>
(function(){
  var admin="auto",user="auto",root=document.documentElement;
  function systemDark(){try{return window.matchMedia('(prefers-color-scheme: dark)').matches;}catch(e){return false;}}
  function effective(){
    var pref=(user==='dark'||user==='light')?user:admin;
    if(pref==='auto')return systemDark()?'dark':'light';
    return pref==='dark'?'dark':'light';
  }
  function apply(){
    var mode=effective();
    root.classList.remove('nv-dark','nv-light');
    root.classList.add(mode==='dark'?'nv-dark':'nv-light');
  }
  apply();
  try{
    var mq=window.matchMedia('(prefers-color-scheme: dark)');
    var onChange=function(){
      var pref=(user==='dark'||user==='light')?user:admin;
      if(pref==='auto')apply();
    };
    if(typeof mq.addEventListener==='function')mq.addEventListener('change',onChange);
    else if(typeof mq.addListener==='function')mq.addListener(onChange);
  }catch(e){}
})();
</script>

