<script type="text/javascript">

	

	//check Cookie Policy function
	var cpmt_checkFunction = function(pID){
		if((document.location.search).indexOf("livehub=true") > -1){
			var date = new Date();
			date.setTime(date.getTime() + (360 * 24 * 60 * 60 * 1000));
			var expires = "; expires=" + date.toGMTString();
			document.cookie = "cpmt_xa=" + "5295" + expires + "; path=/; domain=." + (location.hostname.split('.')).slice(-2).join('.');
			document.cookie = "__ric=" + "5295" + expires + "; path=/;";      
			return true;
		}
		else {

			if(!!(/video\.gazz.*\.it/.test(window.location.host))){cpmt_xa=true;}
			var u = "undefined";
			try{
				pID = (typeof pID === u) ? 5295 : pID;
			}catch(e){
				pID = (typeof pID === u) ? null : pID;
			}
			cpmt_xa = (typeof cpmt_xa !== "boolean") ? false : cpmt_xa;
			var REmatch = new RegExp("cpmt_xa=[^;]*,?("+pID+"),?");

			if((document.location.search).indexOf("playerType=partnership") == -1){
				if(document.cookie.match(REmatch) !== null && cpmt_xa) return true;
				return(document.cookie.indexOf("__ric=")!==-1);
			}
			else {
				var REmatch_ls = new RegExp("cpmt_xa=[^;]*,?("+pID+"),?");
				var cpmt_xa_ls = localStorage.getItem("cpmt_xa");
				if((document.cookie.match(REmatch) !== null || cpmt_xa_ls.match(REmatch_ls) != null)  && cpmt_xa) return true;
				return(document.cookie.indexOf("__ric=") !== -1 || localStorage.getItem("__ric") != null);
			}
		}
	}





