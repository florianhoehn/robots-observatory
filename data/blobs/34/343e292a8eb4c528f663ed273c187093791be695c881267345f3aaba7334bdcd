		switch(t){
			case 1: document.getElementById(id).innerHTML = scri;
			break;
			default: {
				document.getElementById(id).setAttribute("src", scri);
				if( a == '1')document.getElementById(id).setAttribute("async", "true")
			};
		}
		return;
	}


	


	
