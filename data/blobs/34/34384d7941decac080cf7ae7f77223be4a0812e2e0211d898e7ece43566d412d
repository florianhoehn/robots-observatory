<script>
(function () {
  const kopieraBildUrl  = 'https://bahnhof.se/wp-content/uploads/2024/10/8664889_copy_icon.png';
  const kopieratBildUrl = 'https://bahnhof.se/wp-content/uploads/2024/10/checkmark-copy.svg';

  const makeId = () => 'acc-' + Math.random().toString(36).slice(2, 9);

  const HEADER_SELECTORS = [
    '.elementor-tab-title',
    '.elementor-accordion-title',
    '.e-accordion-item-title',
    '.eael-accordion-header',
    '.jet-accordion__control',
    '.bdt-accordion-title',
    '.wpr-accordion-title',
    '.sa-el-accordion-header',
    '.htmega-accordion-header'
  ].join(',');

  const PANEL_SELECTORS = [
    '.elementor-tab-content',
    '.e-accordion-item-content',
    '.eael-accordion-content',
    '.jet-accordion__inner',
    '.bdt-accordion-content',
    '.wpr-accordion-content',
    '.sa-el-accordion-content',
    '.htmega-accordion-content'
  ].join(',');

  const BUTTON_IN_PANEL = true;

  function isExpanded(header) {
    if (!header) return false;
    if (header.getAttribute && header.getAttribute('aria-expanded') === 'true') return true;
    const cls = header.classList || { contains: () => false };
    return cls.contains('elementor-active')
        || cls.contains('eael-accordion-tab-active')
        || cls.contains('e-active')
        || cls.contains('is-active');
  }

  function buildCopyUrl(id) {
    const path = location.pathname.endsWith('/') ? location.pathname : location.pathname + '/';
    const base = location.origin + path;
    return `${base}#${id}`;
  }

  async function copyToClipboard(text) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const temp = document.createElement('input');
    temp.value = text;
    document.body.appendChild(temp);
    temp.select();
    temp.setSelectionRange(0, 99999);
    document.execCommand('copy');
    document.body.removeChild(temp);
  }

  function injectForHeader(headerEl, panelEl) {
    if (!headerEl) return;
    if (!headerEl.id) headerEl.id = makeId();
    if (headerEl.dataset.bhCopyInjected === '1') return;

    const btn = document.createElement('button');
    const img = new Image();
    img.src = kopieraBildUrl;
    img.alt = 'Kopiera länk';
    const urlToCopy = buildCopyUrl(headerEl.id);

    if (BUTTON_IN_PANEL && panelEl) {
      btn.className = 'bh-copy-fab';
      panelEl.classList.add('bh-copy-anchor');
      panelEl.appendChild(btn);
    } else {
      btn.className = 'bh-copy-inline';
      headerEl.appendChild(btn);
    }
    btn.appendChild(img);

    btn.addEventListener('click', async (e) => {
      e.stopPropagation(); // Rör inte själva accordion-toggling
      try {
        await copyToClipboard(urlToCopy);
        const prev = img.src;
        img.src = kopieratBildUrl;
        setTimeout(() => { img.src = prev; }, 2000);
      } catch (err) {
        console.error('Kunde inte kopiera:', err);
      }
    });

    headerEl.dataset.bhCopyInjected = '1';
  }

  function enhance(root = document) {
    const headers = root.querySelectorAll(HEADER_SELECTORS);
    headers.forEach(header => {
      let panel = null;
      const controls = header.getAttribute('aria-controls');
      if (controls) panel = document.getElementById(controls);

      if (!panel) {
        const next = header.nextElementSibling;
        if (next && 