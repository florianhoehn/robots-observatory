  const SPLASH_FADE_MS = 300;
  const SPLASH_MIN_VISIBLE_MS = 500;
  const FILL_SETTLE_MS = 300;
  const HANDOFF_MS = 800;
  const APP_SCRIPT = /\/_app\/immutable\/.+\.js$/;

  const html = document.documentElement;
  const loader = document.querySelector('.boot-loader');
  const splash = loader.querySelector('.boot-loader-splash');
