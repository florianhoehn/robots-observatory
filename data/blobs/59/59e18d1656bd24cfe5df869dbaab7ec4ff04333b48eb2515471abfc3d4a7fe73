    document.querySelectorAll('link[data-boot-css]').forEach((link) => {
      if (isStylesheetSettled(link)) settledStylesheets.add(link);
    });
    const stylesDone = settledStylesheets.size;
    const stylesProgress = Math.min(stylesDone / stylesTotal, 1);
    const scriptsProgress = Math.min(scripts.size / scriptsTotal, 1);
    const progress = STYLES_SHARE * stylesProgress +
      (1 - STYLES_SHARE) * 0.95 * scriptsProgress;
    const value = Math.floor(progress * 100);

