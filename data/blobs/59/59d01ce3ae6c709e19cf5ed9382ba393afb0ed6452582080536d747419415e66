    var regions = {};
    var cities = {};
    var pendingLocationRequests = 0;

    function hasLocationCache(cache, id){
        return Object.prototype.hasOwnProperty.call(cache, id);
    }
    function locationRequestStart(){
        pendingLocationRequests++;
        $('.loc').prop('disabled', true);
    }
    function locationRequestEnd(){
        pendingLocationRequests = Math.max(0, pendingLocationRequests - 1);
        if(!pendingLocationRequests)
            $('.loc').prop('disabled', false);
    }
    function resetCity(){
        $('#regcit').hide();
        $('#siti').empty().hide().removeClass('ok');
        $('#sitinejm').hide().removeClass('ok').val('');
    }
    function showCityName(){
        $('#siti').empty().hide().removeClass('ok');
        $('#sitinejm').show();
        $('#regcit').show();
    }
    function countryChange(sb){
        var v = sb.value;
        var inp = $('#kauntry');
        inp.removeClass('ok');
        $('#ridzyn').empty().removeClass('ok');
        $('#regreg').hide();
        resetCity();
        if(v)
        {
            inp.addClass('ok');
            if(!hasLocationCache(regions, v)) {
                locationRequestStart();
                legacyApi.read({ command: 'getRegions', country: v })
                    .done(function (resp) {
                        if (resp && resp.ok)
                        {
                            regions[v] = Array.isArray(resp.regions) ? resp.regions : [];
                            regions[v].sort(sorter);
                            if($('#kauntry').val() === v)
                                setRegions(v);
                        }
                    })
                    .fail(function () {
                        alert('Connection error. Check your internet connection and try again.');
                    })
                    .always(function () {
                        locationRequestEnd();
                    });
            }
            else
                setRegions(v);
        }
        else{
            $('#regreg, #regcit').hide();
        }
        czekoll();
    }
    function regionChange(sb){
        var v = sb.value;
        var inp = $('#ridzyn');
        inp.removeClass('ok');
        resetCity();
        if(v)
        {
            inp.addClass('ok');
            if(!hasLocationCache(cities, v)) {
                locationRequestStart();
                legacyApi.read({ command: 'getCities', region: v })
                    .done(function (resp) {
                        if (resp && resp.ok)
                        {
                            cities[v] = Array.isArray(resp.cities) ? resp.cities : [];
                            cities[v].sort(sorter);
                            if($('#ridzyn').val() === v)
                                setCities(v);
                        }
                    })
                    .fail(function () {
                        alert('Connection error. Check your internet connection and try again.');
                    })
                    .always(function () {
                        locationRequestEnd();
                    });
            }
            else
                setCities(v);
        }
        else
            $('#regcit').hide();
        czekoll();
    }
    function cityChange(sb){
        var v = sb.value;
        $('#siti').removeClass('ok');
        if(v){
            $('#siti').addClass('ok');
            $('#regtermz').show();
            $('#rodotermz').show();
