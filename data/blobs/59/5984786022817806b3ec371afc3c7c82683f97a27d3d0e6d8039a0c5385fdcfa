<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>404 - Page Not Found</title>
  <style>
    /* Figma 스펙상 모든 텍스트가 weight 400 (제목 17px/본문 13px/푸터 11px)
       — 400 하나만 로드한다. 워드마크류는 SVG 라 폰트 불필요. */
    @font-face {
      font-family: 'One UI Sans GUI';
      src: url('/assets/fonts/OneUi/OneUISansGUI-400Regular.woff2') format('woff2');
      font-weight: 400;
      font-display: swap;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    :root {
      /* 페이지 배경 = 실제 앱의 .bg-book-sys-hc-bg 래퍼가 칠하는 값
         (Figma Book_Sys/Background). body(#fcfcff)가 아니라 이 값이 화면 배경. */
      --background: #f1f1f3;           /* Book_Sys/Background (light) */
      --foreground: #010102;           /* Sys/On Surface Container Highest (light) */
      --title: #4d4d52;                /* Book_Sys/On Surface Container — 404 제목 (Figma) */
      --muted: #848487;                /* On Surface Container Lowest — 본문/푸터 (Figma) */
      --divider: rgba(23, 23, 26, 0.3);
    }
    html.dark {
      --background: #202020;           /* Book_Sys/High contrast/Color1_WindowBG */
      --foreground: #fcfcff;           /* Color2_WindowText 근사 (near-white) */
      --title: #fcfcff;                /* 고대비: 제목 최대 대비 */
      --muted: #a3a3a7;                /* On Surface Container Lowest (dark) */
      --divider: rgba(252, 252, 255, 0.3);
    }

    body {
      font-family: 'One UI Sans GUI', Arial, Helvetica, sans-serif;
      background: var(--background);
      color: var(--foreground);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }

    /* Header — BaseHeader guest: min-h-[100px], px-6, 브랜드 워드마크 중앙만
       (햄버거·프로필·백버튼 없음 = about 비로그인 상단바) */
    header {
      position: sticky;
      top: 0;
      z-index: 20;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100px;
      padding: 0 24px;
      flex-shrink: 0;
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
    }
    .brand {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 30px;
      padding-top: 4px;              /* BaseHeader pt-1 */
      color: var(--foreground);
      text-decoration: none;
      transition: opacity 0.2s ease;
    }
    html.dark .brand { color: #ffffff; }   /* dark:text-white */
    .brand:hover { opacity: 0.8; }
    /* 실제 헤더 렌더 치수: 브랜드링크 164×30(pt-1), 워드마크 SVG 164×26 fill */
    .brand svg { width: 164px; height: 26px; display: block; }

    /* Main — 콘텐츠 바디 영역. Breakpoint(Contents body area):
       0~959dp = width 100% + 좌우 10dp margin / 960+ = width 65.6% 중앙. */
    main {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 64px 10px;              /* 0~959: 좌우 10dp */
    }
    /* footer 와 공유하는 콘텐츠 바디 컬럼 폭 규칙 */
    .body-col {
      width: 100%;                     /* 0~959: 100% (+ main 의 10dp margin) */
      margin: 0 auto;
      display: flex;
      justify-content: center;
    }
    /* Figma sub text 는 한 줄(hug). 영어 기준 한 줄 유지하되 긴 로케일은 자연 줄바꿈 */
    .content { max-width: 640px; text-align: center; }
    /* Figma main text: On-Surface-Container #4D4D52, 17px, weight 400, normal */
    .content h1 {
      font-size: 17px;
      font-weight: 400;
      line-height: normal;
      color: var(--title);
    }
    /* Figma sub text: On-Surface-Container-Lowest #848487, 13px, weight 400, normal */
    .content p {
      margin-top: 10px;               /* Figma 텍스트 그룹 gap 10px */
      font-size: 13px;
      font-weight: 400;
      line-height: normal;
      color: var(--muted);
    }

    /* Footer — Footer.tsx: flex-col items-start gap-5 py-10, mx-auto w-full
       px-[10px], min-[960px]:w-[65.6%] px-0 */
    footer {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 20px;                      /* gap-5 */
      width: 100%;
      margin: 0 auto;
      padding: 40px 10px;             /* py-10 px-[10px] */
      user-select: none;
    }
    /* FooterControls: flex items-center justify-between (로케일 제거 → 토글만 우측) */
    .footer-controls {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      width: 100%;
    }
    /* ThemeToggle inline: size-8 rounded-full, icon h-5 w-5, zinc tones */
    .contrast-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border: none;
      background: none;
      border-radius: 9999px;
      color: #71717a;                 /* zinc-500 */
      cursor: pointer;
      transition: transform 0.2s ease, color 0.2s ease;
    }
    .contrast-toggle:hover { transform: scale(1.1); color: #3f3f46; }  /* zinc-700 */
    .contrast-toggle:active { transform: scale(0.95); }
    html.dark .contrast-toggle { color: #d4d4d8; }  /* dark:text-zinc-300 */
    .contrast-toggle svg { width: 20px; height: 20px; }
    html.dark .contrast-toggle svg { filter: invert(1); }  /* dark:invert */

    /* 브랜드 블록: flex-col items-start gap-2.5 */
    .footer-brandblock {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;                      /* gap-2.5 */
      width: 100%;
    }
    /* FooterBrand: flex items-center gap-2, text #848487 */
    .footer-brand {
      display: flex;
      align-items: center;
      gap: 8px;
      color: var(--muted);
    }
    .footer-brand svg { height: 12px; width: auto; }   /* h-3 */
    .footer-copyright { font-size: 8px; line-height: 1; }
    /* FooterLegalLinks: flex-wrap items-center gap-x-3 gap-y-1 text-[11px] #848487 */
    .footer-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: 12px;               /* gap-x-3 */
      row-gap: 4px;                   /* gap-y-1 */
      width: 100%;
      font-size: 11px;
      color: var(--muted);
    }
    .footer-links a {
      color: var(--muted);
      text-decoration: none;
    }
    .footer-links a:hover { text-decoration: underline; }  /* linkClassName */
    /* FooterDivider: h-2 w-px bg-[#17171a]/30, hidden md:inline */
    .footer-divider {
      display: none;
      height: 8px;
      width: 1px;
      background: var(--divider);
    }

    /* RTL */
    [dir="rtl"] .footer-controls { justify-content: flex-start; }
    [dir="rtl"] footer,
    [dir="rtl"] .footer-brandblock { align-items: flex-end; }

    @media (min-width: 768px) {        /* md:inline */
      .footer-divider { display: inline-block; }
    }
    @media (min-width: 960px) {        /* 960+ : 콘텐츠 바디 65.6% 중앙 */
      main { padding: 64px 0; }
      .body-col { width: 65.6%; }
      footer { width: 65.6%; padding: 40px 0; }
    }
  </style>
</head>
