<!DOCTYPE html><html lang="ko"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>확인 중</title></head>
<body style="background:#111;color:#888;font-family:sans-serif;text-align:center;padding-top:120px;margin:0">
<div id="m" style="font-size:15px">잠시만 기다려주세요</div>
<noscript><div style="font-size:15px;color:#c66">JavaScript와 쿠키를 허용해주세요</div></noscript>
<script>
try{
var h="0123456789abcdef",v="";
for(var i=0;i<32;i++){v+=h[Math.floor(Math.random()*16)];}
document.cookie="vfy="+v+";path=/;max-age=86400;SameSite=Lax";
if(document.cookie.indexOf("vfy=")<0){
  document.getElementById("m").textContent="쿠키를 허용해주세요";
}else{
  location.replace(location.href);
}
}catch(e){document.getElementById("m").textContent="오류: "+e.message;}
</script></body></html>
