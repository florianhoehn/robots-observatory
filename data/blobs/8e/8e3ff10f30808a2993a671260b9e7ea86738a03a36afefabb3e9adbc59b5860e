<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Human Verification</title>
    <style>
        :root {
            color-scheme: dark;
            font-family: Avenir, sans-serif;
            background: #111111;
            color: #DEDEDE;
        }

        * {
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            margin: 0;
            display: grid;
            place-items: center;
            padding: 24px;
            background: linear-gradient(140deg, #060606 0%, #141414 100%);
        }

        main {
            width: min(100%, 440px);
            padding: 40px;
            border: 1px solid #242424;
            border-radius: 4px;
            background: linear-gradient(90deg, #141414 0%, #1E1E1E 100%);
            box-shadow: 0 24px 70px rgb(0 0 0 / 35%);
            text-align: center;
        }

        h1 {
            margin: 0 0 12px;
            font-size: clamp(24px, 6vw, 32px);
            line-height: 1.15;
        }

        p {
            margin: 0 0 28px;
            color: #B2B2B2;
            font-size: 17px;
            line-height: 27px;
        }

        button {
            width: 100%;
            min-height: 48px;
            border: 0;
            border-radius: 7px;
            padding: 12px 18px;
            cursor: pointer;
            background: rgb(32, 81, 149);
            color: #fff;
            font: inherit;
            font-size: 18px;
            filter: brightness(1);
            transition: filter 100ms ease-in-out;
        }

        button:hover {
            filter: brightness(1.15);
        }

        button:disabled {
            cursor: wait;
            opacity: .72;
        }

        @media (max-width: 480px) {
            main {
                padding: 30px 24px;
            }
        }
    </style>
</head>
<body>
<main>
    <h1>One Quick Check</h1>
    <p>Please confirm that you are a human and not a bot to continue browsing this site.</p>
    <form method="post" action="https://www.warcraftlogs.com/human-challenge">
        <input type="hidden" name="_token" value="mqwCd6DjexYvwAtL53wf3lj0UjspK9FVUDAHfdbh">
        <button type="submit">I am a human and not a bot</button>
    </form>
</main>
<script>
    document.querySelector('form').addEventListener('submit', function () {
        const button = this.querySelector('button');
        button.disabled = true;
        button.textContent = 'Continuing...';
    });
</script>
