    <!--
      形态判定的唯一真源：判一次 UA，结果只落到 <html data-device> 这一个载体——
      CSS 的 .on-mobile()/.on-pc() 与 JS 的 getIsMobile() 读的是同一个属性，不存在两份状态。
      刻意不往 window 上挂全局变量：页面内有 GTM / tracking SDK 等第三方脚本，
      全局命名空间有被覆盖的风险，且两份状态天然存在不一致的失败模式。
      必须内联且在首屏 CSS 之前，否则会闪一帧错误形态。
      设计与各条规则的前提见 docs/web/260804-mobile-detection-ua/td.md
    -->
    <script>
      ;(function () {
        var ua = navigator.userAgent
        // 规则 0 优先于全部 UA 规则：gabridge 是 Migoo App WebView 注入的 native bridge，
        // 属运行时事实，强于 UA 字符串推断。判定条件与 managers/nativeBridge 的 isInApp()
        // 同源（内联脚本无法 import，两处必须保持一致）。
        // 规则 3 的 Macintosh + 触点 = iPadOS 13+ 桌面模式；前提是 Apple 未出触屏 Mac，
        // 触点信号只用于消歧 Macintosh、不作通用信号（否则触屏 Win 笔记本会被误判）
        var isMobile =
          Boolean(window.gabridge) ||
          /iPhone|iPod|Android|Windows Phone/i.test(ua) ||
          /iPad/i.test(ua) ||
          (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
        // preload 的 contextBridge 在页面脚本之前执行，故此处可读 desktopAPI
        var isShell = typeof window.desktopAPI !== 'undefined'

        var el = document.documentElement
        el.setAttribute('data-device', isMobile ? 'mobile' : 'pc')
        // 壳 / 平台判定走 managers/desktopBridge 的运行时探测，这里不打壳标记
        // 布局形态：在 data-device 的 mobile/pc 二分之上，把桌面壳单独分出第三态。
        // 壳与 web-pc 同为非移动端（UA 判定下壳恒为 pc），但可用区域构成不同——壳有
        // 自绘标题栏与侧边浏览器，多区域布局据此选骨架，故形态需要三态而非二态。
        // 与 data-device 同源同时机写入，不构成第二份判定：mobile 与壳互斥，取值直接由
        // 上面两个变量推出。JS 侧 utils/formFactor.ts 只读本属性，不重跑探测
        el.setAttribute(
          'data-form-factor',
          isShell ? 'desktop-shell' : isMobile ? 'web-h5' : 'web-pc'
        )
        if (/Android/i.test(ua)) el.classList.add('is-android')
      })()
    </script>
