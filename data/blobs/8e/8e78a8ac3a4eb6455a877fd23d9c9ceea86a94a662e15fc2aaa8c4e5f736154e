ITsnA381/qT+aL/hqb5Za8OGBhPrWsYxcpL" crossorigin="anonymous"></script><script>
  let latestEmail = '';

  const newsletterInputs = document.querySelectorAll('[data-newsletter="input"]');
  const modalTriggers = document.querySelectorAll('[data-newsletter-trigger]');

  // Track the latest email from any input
  newsletterInputs.forEach((input) => {
    input.addEventListener('input', (e) => {
      latestEmail = e.target.value;
    });
  });

  // On trigger, populate all targets and clear the inputs
  modalTriggers.forEach((button) => {
    button.addEventListener('click', () => {
      const targets = document.querySelectorAll('[data-newsletter="target"]');
      targets.forEach((target) => {
        if (latestEmail) {
          target.value = latestEmail;
        }
      });

      // Clear the input fields
      newsletterInputs.forEach((input) => {
        input.value = '';
      });
    });
  });
</script>

