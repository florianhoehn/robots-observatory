	function isBlockedScript(node) {
		if (!(node instanceof HTMLScriptElement) || !node.src) {
			return false;
		}

		try {
			const url = new URL(node.src);
			const href = url.href.toLowerCase();
			const hostname = url.hostname;

			// Block URL patterns
			if (BLOCKED_URL_PATTERNS.some(pattern =>
				href.includes(pattern.toLowerCase())
			)) {
				return true;
			}

			// Block domains
			return BLOCKED_DOMAINS.some(domain =>
				hostname === domain ||
				hostname.endsWith('.' + domain)
			);
		} catch (e) {
			return false;
		}
	}

	function blockScript(node, method) {
		if (!isBlockedScript(node)) {
			return false;
		}

		console.warn(
			'[MAL] Blocked script:',
			node.src,
			'Method:',
			method
		);

		if (window.S3Helper) {
			const s3_event = window.S3Helper.getEvent(
				'ScriptBlocked.' + method
			);

			s3_event.wv_element = node.src;

			window.S3Helper.pushToS3(s3_event);
		}

		return true;
