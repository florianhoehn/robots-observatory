<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Security Check | Wellfound</title>
    <style>
      :root {
        color-scheme: light;
        --background: #fbf9fa;
        --ink: #08171d;
        --muted: #565e65;
        --pink: #c92370;
        --pink-bright: #ee3788;
        --white: #ffffff;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        min-height: 100svh;
        margin: 0;
        background:
          radial-gradient(circle at 15% 12%, #fdebf3 0, transparent 30rem),
          radial-gradient(circle at 85% 18%, #fff0f5 0, transparent 28rem),
          var(--background);
        color: var(--ink);
        font-family:
          ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      main {
        display: grid;
        min-height: 100vh;
        min-height: 100svh;
        place-items: center;
        padding: 48px 20px;
      }

      .page {
        width: min(100%, 760px);
        text-align: center;
      }

      .brand {
        display: inline-block;
        width: 190px;
        margin-bottom: 32px;
        color: var(--ink);
      }

      .brand svg {
        display: block;
        width: 100%;
        height: auto;
      }

      .card {
        padding: 60px 64px;
        border: 1px solid rgba(8, 23, 29, 0.07);
        border-radius: 30px;
        background:
          radial-gradient(circle at 100% 0%, rgba(238, 55, 136, 0.14), transparent 15rem),
          radial-gradient(circle at 0% 100%, rgba(8, 23, 29, 0.05), transparent 13rem),
          var(--white);
        box-shadow: 0 28px 70px rgba(8, 23, 29, 0.09);
      }

      .status {
        margin: 0 0 16px;
        color: var(--pink);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-size: clamp(40px, 7vw, 58px);
        line-height: 1;
        letter-spacing: -0.065em;
      }

      h1 span {
        display: block;
        color: var(--pink-bright);
      }

      .message {
        max-width: 560px;
        margin: 24px auto 0;
        color: var(--muted);
        font-size: 17px;
        line-height: 1.6;
      }

      .challenge-box {
        margin: 28px auto 0;
        padding: 24px;
        border: 1px solid rgba(8, 23, 29, 0.09);
        border-radius: 20px;
        background: rgba(251, 249, 250, 0.82);
      }

      .reference {
        display: flex;
        max-width: 430px;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin: 20px auto 0;
        padding: 16px 18px;
        border: 1px solid rgba(8, 23, 29, 0.09);
        border-radius: 14px;
        background: rgba(251, 249, 250, 0.82);
        color: var(--muted);
        font-size: 14px;
        text-align: left;
      }

      .reference code {
        color: var(--ink);
        font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
        font-size: 13px;
        font-weight: 700;
        overflow-wrap: anywhere;
        text-align: right;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 34px;
      }

      .button {
        display: inline-flex;
        min-height: 50px;
        align-items: center;
        justify-content: center;
        padding: 0 22px;
        border: 1px solid var(--ink);
        border-radius: 999px;
        font-size: 16px;
        font-weight: 700;
        text-decoration: none;
      }

      .button-primary {
        background: var(--ink);
        color: var(--white);
      }

      .button-secondary {
        background: var(--white);
        color: var(--ink);
      }

      .button:focus-visible {
        outline: 3px solid var(--pink);
        outline-offset: 3px;
      }

      @media (max-width: 540px) {
        main {
          padding: 28px 16px;
        }

        .brand {
          width: 158px;
          margin-bottom: 24px;
        }

        .card {
          padding: 42px 24px;
          border-radius: 24px;
        }

        .reference {
          align-items: flex-start;
          flex-direction: column;
          gap: 6px;
        }

        .reference code {
          text-align: left;
        }

        .actions {
          flex-direction: column;
        }

        .button {
          width: 100%;
        }
      }
    </style>
