        <script>
        function tmdCheckConsent(category) {
            try {
                if (getCookie('tmd_gdpr') == '0' || getCookie('tmd_gdpr') == '1') {
                    if (typeof Cookiebot !== 'undefined') {
                        if (Cookiebot) {
                            if (Cookiebot.consent) {
