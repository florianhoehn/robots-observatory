<script>
  (function () {
    var container = document.getElementById("LanguageContainer");
    if (!container || container.dataset.langInitialized === "true") {
      return;
    }
    container.dataset.langInitialized = "true";

    function init() {
      var trigger = container.querySelector(".pubFooter-lang-trigger");
      var menu = container.querySelector(".pubFooter-lang-menu");
      if (!trigger || !menu) {
        return;
      }

      function isOpen() {
        return trigger.getAttribute("aria-expanded") === "true";
      }

      function open() {
        menu.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
        container.classList.add("is-open");
      }

      function close(focusTrigger) {
        menu.hidden = true;
        trigger.setAttribute("aria-expanded", "false");
        container.classList.remove("is-open");
        if (focusTrigger) {
          trigger.focus();
        }
      }

      trigger.addEventListener("click", function (event) {
        event.stopPropagation();
        if (isOpen()) {
          close(false);
        } else {
          open();
        }
      });

      trigger.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          close(true);
        } else if (event.key === "ArrowDown") {
          event.preventDefault();
          if (!isOpen()) {
            open();
          }
          var firstLink = menu.querySelector("a");
          if (firstLink) {
            firstLink.focus();
          }
        }
      });

      menu.addEventListener("keydown", function (event) {
        if (event.key === "Escape") {
          close(true);
        }
      });

      document.addEventListener("click", function (event) {
        if (isOpen() && !container.contains(event.target)) {
          close(false);
        }
      });

      document.addEventListener("focusin", function (event) {
        if (isOpen() && !container.contains(event.target)) {
          close(false);
        }
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

  
  
  
  
    
    

    
  
	
	
  
  
    
    
