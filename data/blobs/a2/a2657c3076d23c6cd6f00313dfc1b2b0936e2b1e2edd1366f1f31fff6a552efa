    }

    .fonts-loaded {
      --primary-font: "PvHeadlineSemiBold", var(--fallback);
      --primary-font-semi-bold: "PvTextSemiBold", var(--fallback);
      --secondary-font: "PvTextRegular", var(--fallback);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: var(--secondary-font);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      justify-content: space-between;
    }

    header {
      background-color: #fbbf24;
