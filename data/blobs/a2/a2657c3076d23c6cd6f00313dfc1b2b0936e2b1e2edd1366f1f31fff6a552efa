      padding: 1rem;
      text-align: center;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .container {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
    }

    .title {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 1rem;
      font-family: var(--secondary-font);
    }

    .subtitle {
      font-size: 1rem;
      color: #555;
      margin-bottom: 1.5rem;
    }

    .btn {
      padding: 0.75rem 1.5rem;
      background-color: #b91c1c;
      color: white;
      border: none;
      border-radius: 0.25rem;
      cursor: pointer;
      font-size: 1rem;
      text-decoration: none;
    }

    footer {
      background-color: #f3f3f3;
      padding: 1rem;


    }

    .footer-last {
      color: #555;
      font-family: Noto Sans Kannada;
      margin: 0px;
      text-align: center;
    }

    .footer-links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      padding: 14px;

    }

    .footer-links * {
      margin-bottom: 1rem;
      color: #555;
      text-decoration: none;
      font-size: 16px;
      text-align: center;
      gap: 10;
      font-family: Noto Sans Kannada;
    }


    .social-icons-wrapper {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 20px;
    }

    .social-icons {
      display: flex;
      gap: 10px;
    }

    .store-buttons {
      display: flex;
      gap: 10px;
    }

    @media (min-width: 768px) {
      .social-icons-wrapper {
        justify-content: center;
        flex-direction: row;
      }


    }
  </style>
