        font-family: Playfair Display;
        line-height: 25px;
        margin-bottom: 4px;
        display: inline-block;
        text-decoration: none;
      }

      .pv-logo-navbar {
        font-size: 25px;
        font-family: Playfair Display;
        line-height: 25px;
        display: inline-block;
        text-decoration: none;
        font-weight: bold;
        color: #000;
