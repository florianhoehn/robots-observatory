        flex-direction: row;
        align-items: center;
      }

      .menu-wrapper {
        background: white;
        margin-top: 12px;
      }

      .sidebar-items {
        margin-left: auto;
        margin-right: 16px;
        display: flex;
        flex-direction: row;
        gap: 16px;
        align-items: center;
      }

      .e-paper-button {
        background-color: #ffc300;
        border-radius: 2px;
        color: #000;
        font-family: "Roboto Slab";
        font-size: 12px;
        line-height: 1;
        padding: 4px 5px;
        text-decoration: none;
      }

      .search-button {
        padding-top: 4px;
      }

      .hide-icon-navbar {
        display: none;
        font-weight: bold;
      }

      .show-icon-navbar {
        display: block;
        cursor: pointer;
        font-weight: bold;
        position: relative;
        top: -2px;
        line-height: 16px;
      }

      .up-icon-navbar {
        padding-top: 10px;
        position: relative;
        top: -7px;
        font-size: 24px;
        line-height: 16px;
      }

      .open-btn {
        margin: 20px;
        padding: 10px 20px;
        font-size: 16px;
        background-color: #008ca5;
        color: white;
        border: none;
        cursor: pointer;
        border-radius: 4px;
      }

      .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        display: none;
        z-index: 999;
      }

      .menu-popup {
        position: fixed;
        top: 0;
        left: -320px;
        width: 320px;
        height: 100vh;
        background-color: white;
        box-shadow: 2px 0 5px rgba(0, 0, 0, 0.2);
        transition: left 0.3s ease;
        z-index: 1000;
      }

      .menu-popup.active {
        left: 0;
      }

      .menu-overlay.active {
        display: block;
      }

      .menu-header {
        background-color: #fec10d;
        color: black;
        padding: 0px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo {
        height: 48px;
      }

      .logo span {
        display: block;
        font-size: 10px;
        letter-spacing: 1px;
        margin-top: -5px;
      }

      .close-btn {
        font-size: 24px;
        cursor: pointer;
      }

      .menu-items {
        padding: 20px;
        overflow-y: auto;
        height: calc(100vh - 80px);
      }

      .menu-items * {
        font-size: 14px;
        font-family: "Noto Sans Kannada";
      }

      .menu-item {
        font-size: 20px;
        color: #333;
        margin: 10px 0;
        cursor: pointer;

        list-style: none;
      }

      .menu-item a {
        text-decoration: none;

        color: #333;
        font-weight: bold;

        letter-spacing: 0%;
      }

      .menu-item:hover {
        color: #000;
      }
