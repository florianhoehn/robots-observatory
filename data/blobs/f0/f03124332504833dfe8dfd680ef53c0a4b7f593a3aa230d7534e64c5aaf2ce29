<script>
(function() {
	var wrap = document.getElementById('wqWipWrap');
	if (!wrap) {
		return;
	}

	var cookieName = wrap.getAttribute('data-dismiss-cookie');
	var cookie = document.cookie.match(new RegExp(cookieName + '=([^;]+)'));
	var today = new Date().toISOString().slice(0, 10);
	if (cookie && cookie[1] === today) {
		wrap.style.display = 'none';
	}

	window.addEventListener('scroll', function() {
		var el = document.getElementById('wquest-wipe');
		if (el) {
			el.style.right = '0';
		}
	});
})();

function dismissWipe(maxAge) {
	var today = new Date().toISOString().slice(0, 10);
	var wrap = document.getElementById('wqWipWrap');
	var cookieName = wrap && wrap.getAttribute('data-dismiss-cookie');
	if (cookieName) {
		document.cookie = cookieName + '=' + today + '; path=/; max-age=' + maxAge;
	}
	if (wrap) {
		wrap.style.display = 'none';
	}
}

function dismissWquestWipe() {
	dismissWipe(30*24*60*60);
}

function dismissMarathonWipe() {
	dismissWipe(24*60*60);
}
</script>



