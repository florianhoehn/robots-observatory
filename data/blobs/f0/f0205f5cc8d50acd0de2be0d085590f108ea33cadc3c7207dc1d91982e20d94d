<script type="text/javascript">

    //We get the searchTerm in autocomplete from custom table SearchHistory.
    $(function () {
        var searchInput = $("#azureautocomplete");
        var searchIcon = $('.searchMain-search .icon-search');

        if (searchInput.length > 0) {
            var autocomplete = new Awesomplete(document.querySelector("#azureautocomplete"), {
                list: [],
                minChars: 3,
                maxItems: 5,
                autoFirst: true,
                sort: false
            });

            function doSearch(e) {
                var q = e.value;
                $(".behindText").show();
                $(".searchMain-infoSuggested").show();
                if (q.length < 3) {
                    autocomplete.list = [];
                    autocomplete.evaluate();
                    return;
                }
                var controllerUrl = "/search/AutoComplete_SearchTermField?searchTerm=" + searchInput.val();
                $.ajax({
                    url: controllerUrl,
                    dataType: "json",
                    success: function (data) {
                        if (data.Results && data.Results.length > 0) {
                            titles = [];
                            for (var n = 0; n < data.Results.length - 1; n++) {
                                titles.push({ label: data.Results[n].Title, value: data.Results[n].Title });
                            }
                            autocomplete.list = titles
                            autocomplete.evaluate();
                            autocomplete.open();
                        }
                        searchInput.on('awesomplete-selectcomplete', function () {
                            $("#btn_arrow").click();
                        });
                        searchInput.focus().val(searchInput.val());
                    }
                });
            }

            searchInput.on("input", function () {
                doSearch(this);
            });

            searchIcon.on('click', function () {
                $("#btn_arrow").click();
            });
        }
    });
</script>

