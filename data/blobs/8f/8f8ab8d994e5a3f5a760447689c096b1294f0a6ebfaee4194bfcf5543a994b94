	/* Button style - lebih elegan tanpa efek neon */
	
	.brand-neue-button {
		gap: var(--spacing-2x);
		border-radius: var(--roundness-subtle);
		background: linear-gradient(135deg, #8B6914, #D4A017);
		color: #ffffff;
		font-family: var(--font-family-regular);
		font-size: var(--font-size-2x);
		font-weight: var(--font-weight-median);
		letter-spacing: var(--font-spacing-loose);
		text-align: center;
		padding: 12px 24px;
		border: 1px solid #D4A017;
		cursor: pointer;
		transition: all var(--transition-duration-medium) var(--transition-easing-ease-in-out);
		position: relative;
		overflow: hidden;
		text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
		box-shadow: 0 0 30px rgba(212, 160, 23, 0.15), 0 4px 20px rgba(0, 0, 0, 0.3);
	}
	
	.brand-neue-button:hover,
	.brand-neue-button:active,
	.brand-neue-button:focus {
		background: linear-gradient(135deg, #D4A017, #FFD700);
		transform: translateY(-2px);
		box-shadow: 0 0 40px rgba(212, 160, 23, 0.25), 0 6px 25px rgba(0, 0, 0, 0.4);
	}
	
	.brand-neue-button::before {
		content: "";
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
		transition: left 0.6s ease;
	}
	
	.brand-neue-button:hover::before {
		left: 100%;
	}
	
