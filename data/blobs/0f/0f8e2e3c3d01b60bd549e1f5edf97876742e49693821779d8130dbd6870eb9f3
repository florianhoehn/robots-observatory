<script>
	$(document).ready(() => {
		let frame = null;

		const feedback = {
			$backdropEl: $('[data-element="feedback-backdrop"]'),
			$updateModal: $('[data-element="update-feedback-modal"]'),
			$updatedModal: $('[data-element="updated-feedback-modal"]'),

			showModal: function (type, messageId = null) {
				this.hideAllModals();
				const $modal = $(`[data-element="feedback-modal"][data-modal="${type}"]`);

				if ($modal.length) {
					$modal.data('message-id', messageId);
					$('[data-element="feedback-backdrop"]').show();
					$modal.show();
				}
			},
			hideAllModals: function () {
				this.resetForm();
				$('[data-element="feedback-backdrop"]').hide();
				const $modals = $('[data-element="feedback-modal"]');
				$modals.data('message-id', null);
				$modals.hide();
			},
			sendFeedback: function (messageId, text, $button) {
				ajaxCall('/pl/ai/chat/update-feedback',
					{
						messageId: messageId,
						text: text,
					},
					{
						btn: $button,
					},
					() => {
						this.showModal('updated');
					}
				);
			},
			resetForm: function () {
				$('[data-element="feedback-text"]').val('');
				$('[data-element="feedback-submit-button"]').attr('disabled', 'disabled');
			},
			addListeners: function () {
				$('[data-element="feedback-submit-button"]').on('click', (event) => {
					const messageId = $('[data-element="feedback-modal"][data-element]').data('message-id');
					const text = $('[data-element="feedback-text"]').val();
					const $button = $(event.currentTarget);

					if (messageId === undefined || text === undefined) {
						return;
					}

					this.sendFeedback(messageId, text, $button);
				});
				$('[data-element="feedback-close-button"]').on('click', () => {
					this.hideAllModals();
				});
				$('[data-element="feedback-text"]').on('input', (event) => {
					const $textarea = $(event.currentTarget);
					const text = $textarea.val().trim();
					const $submitButton = $('[data-element="feedback-submit-button"]');

					if (text === '') {
						$submitButton.attr('disabled', 'disabled');
					} else {
						$submitButton.removeAttr('disabled');
					}
				});
			},
		};

		feedback.addListeners();

		$('[data-element="ai-chat-button"]').on('click', function () {
			if (frame) {
				return;
			}

			const $button = $(this);
			const contextName = $button.data('context-name');
			const isRedesigned = Boolean(window.isPageRedesigned);
			const url = '/pl/ai/chat/render?contextName=' + contextName + '&isRedesigned=' + (isRedesigned ? '1' : '0');
			frame = document.createElement('iframe');
			frame.src = url;
			frame.className = 'ai-chat-widget';
			document.body.append(frame);
			const frameContentWindow = frame.contentWindow;

			window.addEventListener('message', (event) => {
				if (event.source !== frameContentWindow) {
					return;
				}

				if (!event.data || !event.data.event) {
					return;
				}

				switch (event.data.event) {
					case 'closeChat': {
						frame.remove();
						frame = null;

						break;
					}
					case 'applyRule': {
						const $segmentConstructWidget = $('.segment-construct-widget');
						const parsedRuleString = JSON.parse(event.data.ruleString);

						if (!parsedRuleString.rule || !$segmentConstructWidget.length) {
							return;
						}

						const widget = $segmentConstructWidget.data()['gc-segmentConstruct'];

						if (!widget) {
							return
						}

						widget.element.find('.segment-selector-wrapper select').val("0").trigger('change');
						widget.rulePluginEl.rulePlugin('setRule', parsedRuleString.rule);

						break;
					}
					case 'negativeFeedbackReceived': {
						const messageId = event.data.messageId;
						feedback.showModal('update', messageId);

						break;
					}
				}
			});
		});
	});
</script>

    
