<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,follow">
  <title>404 | Page not found</title>
  <style>
    :root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172033;background:#f7f8fb}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px}
    main{width:min(620px,100%);background:#fff;border:1px solid #e5e7eb;border-radius:18px;padding:44px 28px;text-align:center;box-shadow:0 12px 35px rgba(15,23,42,.08)}
    .code{font-size:clamp(64px,16vw,112px);font-weight:800;letter-spacing:-.07em;line-height:.9;color:#ee4d5a;margin-inline-start:-.07em}
    h1{font-size:clamp(24px,5vw,36px);margin:22px 0 10px}p{color:#526077;line-height:1.6;margin:0 auto 26px;max-width:480px}
    form{display:flex;gap:8px;max-width:430px;margin:0 auto 22px}input{min-width:0;flex:1;border:1px solid #cbd5e1;border-radius:10px;padding:12px 14px;font:inherit}
    button,a{font:inherit;font-weight:700}button{border:0;border-radius:10px;background:#ee4d5a;color:#fff;padding:12px 18px;cursor:pointer}
    a{color:#d93648;text-underline-offset:3px}@media(max-width:440px){form{display:grid}main{padding:36px 20px}}
  </style>
</head>
<body>
  <main>
    <div class="code" aria-hidden="true">404</div>
    <h1>Page not found</h1>
    <p>We couldn't find that wallpaper. Search for another one or return to the homepage.</p>
    <form action="/search" method="get" role="search">
      <input name="q" type="search" aria-label="Search wallpapers" placeholder="Search wallpapers">
      <button type="submit">Search</button>
    </form>
    <a href="/" title="Return to homepage">Return to homepage</a>
  </main>
</body>
</html>