      .welcome-screen-header {
        height: 2.5rem;
        width: 12.5rem;
        display: flex;
        position: absolute;
        top: 20%;
        transform: translate(-50%, -100%);
        align-items: center;
        justify-content: flex-start;
        text-align: center;
      }

      .welcome-screen-header > img {
        width: 12.5rem;
      }
