        function getQQConnectUrl() {
            //QQ互联新版connect扫码页，回调地址带callback=qq_login_ok，
            //登录成功后由 /callback/qq_login_ok 页面 postMessage 通知父页面
            var state = getCookie('TOK') || '';
            var redirect_uri = encodeURIComponent(encodeURIComponent('https://www.weiyun.com/qq_connect'));
            return 'https://graph.qq.com/connect/?appid=100720601&redirect_uri=' + redirect_uri + '&state=' + encodeURIComponent(state) + '&color_theme=light';
        }

        var qq_login_iframe = null;

        //手动切换的登录方式记录在localStorage的key
        var LOGIN_TAB_STORAGE_KEY = 'wy_login_tab';

        /**
         * 记录用户手动切换的登录方式，下次打开时默认使用
         * @param {string} mod 登录方式：qq / weixin
         */
        function saveLoginTab(mod) {
            if (mod !== 'qq' && mod !== 'weixin') {
                return;
            }
            try {
                window.localStorage.setItem(LOGIN_TAB_STORAGE_KEY, mod);
            } catch (e) {
                //隐私模式等场景localStorage不可用，忽略
            }
        }

        /**
         * 获取初始登录方式，优先级：url参数tab > localStorage上次手动选择 > 默认微信
         * @returns {string} qq / weixin
         */
        function getInitLoginTab() {
            var urlTab = (getQueryString('tab') || '').toLowerCase();
            if (urlTab === 'qq' || urlTab === 'wx' || urlTab === 'weixin') {
                //url上显式指定时优先本次生效：tab=qq用QQ登录，tab=wx用微信登录
                return urlTab === 'qq' ? 'qq' : 'weixin';
            }
            try {
                var saved = window.localStorage.getItem(LOGIN_TAB_STORAGE_KEY);
                if (saved === 'qq' || saved === 'weixin') {
                    return saved;
                }
            } catch (e) {
                //localStorage不可用，走默认
            }
            return 'weixin';
        }

        function switchLoginTab(mod) {
            //微信/QQ均为iframe嵌入，切换选项卡时切换iframe显示
            $('.tab-wrapper .tab').removeClass('checked');
            $('.tab-wrapper .tab[data-mod="' + mod + '"]').addClass('checked');

            //扫码提示仅微信tab展示
            var scan_tip = document.getElementById('wx_scan_tip');
            if (scan_tip) {
                scan_tip.style.display = (mod === 'qq') ? 'none' : '';
            }

            var wx_iframe = document.getElementById('wx_login_iframe');
            if (mod === 'qq') {
                //QQ互联iframe首次点击时再创建，避免不必要的加载
                if (!qq_login_iframe) {
                    qq_login_iframe = create_iframe('qq_login_iframe', getQQConnectUrl());
                    document.getElementById('login').appendChild(qq_login_iframe);
                }
                qq_login_iframe.style.display = '';
                if (wx_iframe) {
                    wx_iframe.style.display = 'none';
                }
            } else {
                if (qq_login_iframe) {
                    qq_login_iframe.style.display = 'none';
                }
                if (wx_iframe) {
                    wx_iframe.style.display = '';
                }
            }
        }

        $('.tab-wrapper .tab').on('click', function() {
            var mod = $(this).data('mod');
            //手动切换登录方式时记录，下次打开默认定位到该方式
            saveLoginTab(mod);
            switchLoginTab(mod);
        });

