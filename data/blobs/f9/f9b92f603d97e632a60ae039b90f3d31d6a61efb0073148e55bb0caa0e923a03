<script>
  function renderQrCodes() {
    if (
      typeof window.AF_SMART_SCRIPT === "undefined" ||
      typeof window.AF_SMART_SCRIPT.displayQrCode !== "function"
    ) {
      console.error("AppsFlyer QR function is missing.");
      return;
    }

    const qrContainers = document.querySelectorAll("[data-qr]");

    if (!qrContainers.length) {
      return;
    }

    qrContainers.forEach((container, index) => {
      if (!container.id) {
        container.id = "af-qr-" + (index + 1);
      }

      container.innerHTML = "";

      window.AF_SMART_SCRIPT.displayQrCode(container.id, {
        codeColor: "#000000",
      });
    });
  }

  function updateCtaLinks(clickURL) {
    const ctaLinks = document.querySelectorAll("[data-onelink]");

    if (!ctaLinks.length) {
      return;
    }

    ctaLinks.forEach((el) => {
      if (el.tagName.toLowerCase() === "a") {
        el.href = clickURL;
        el.target = "_blank";
        el.rel = "noopener noreferrer";
      } else {
        el.setAttribute("data-onelink-url", clickURL);
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    if (
      typeof AF_SMART_SCRIPT_RESULT !== "undefined" &&
      AF_SMART_SCRIPT_RESULT &&
      AF_SMART_SCRIPT_RESULT.clickURL
    ) {
      updateCtaLinks(AF_SMART_SCRIPT_RESULT.clickURL);
      renderQrCodes();

      if (
        window.AF_SMART_SCRIPT &&
        typeof window.AF_SMART_SCRIPT.fireImpressionsLink === "function"
      ) {
        window.AF_SMART_SCRIPT.fireImpressionsLink();
      }
    } else {
      console.error("AppsFlyer Error: No clickURL generated.");
    }
  });
</script>


