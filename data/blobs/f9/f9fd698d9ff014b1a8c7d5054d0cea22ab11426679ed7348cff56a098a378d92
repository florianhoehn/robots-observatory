    (async function checkSiteStability() {
        const url = `https://auth.porofessor.gg/site-status?source=porofessor`;

        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Network response was not ok');
            let data = await response.json();

            if (data.status === 'down') {
                const warningHtml = `
                    <div class="warning-strip">
                        <div class="warning-strip__icon"></div>
                        <div class="warning-strip__text">${data.message}</div>
                    </div>`;
                document.querySelector('body').insertAdjacentHTML('beforeend', warningHtml);
            }
        } catch (error) {
            console.error('Failed to fetch site status:', error);
        }
    })();
