<script>
(function () {
    if (!/(?:^|;\s*)wg_si=1(?:;|$)/.test(document.cookie)) return;

    var profile = null;
    try { profile = JSON.parse(localStorage.getItem("poro_account") || "null"); } catch (e) {}

    document.querySelectorAll("[data-lolg-auth-controls]").forEach(function (container) {
        container.querySelectorAll("[data-lolg-auth-open]").forEach(function (trigger) {
            trigger.hidden = true;
        });

        var account = container.querySelector("[data-lolg-account]");
        if (!account) return;

        // Revealed even with nothing cached to show: an empty name that fills in beats offering a
        // signed-in visitor a Log in button.
        account.classList.remove("lolg-account--hidden");
        account.hidden = false;

        if (!profile) return;

        var nameEl = account.querySelector("[data-lolg-account-name]");
        if (nameEl) nameEl.textContent = profile.name || "";

        var regionEl = account.querySelector("[data-lolg-account-region]");
        if (regionEl && profile.region) {
            regionEl.textContent = "#" + profile.region;
            regionEl.hidden = false;
        }

        var iconEl = account.querySelector("[data-lolg-account-icon]");
        if (iconEl && profile.iconUrl) {
            iconEl.src = profile.iconUrl;
            iconEl.alt = profile.name || "";
            iconEl.hidden = false;
        }
    });
})();
</script>
