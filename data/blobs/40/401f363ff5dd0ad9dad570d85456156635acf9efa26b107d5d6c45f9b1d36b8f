<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>404 — Page not found</title>
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	<!-- Auto-redirect fallback if JS is disabled -->
	<noscript><meta http-equiv="refresh" content="5; url=http://originx.filedownloadlink.xyz" /></noscript>
	<style>
		:root {
			--bg:        #0b0d12;
			--bg-2:      #12151c;
			--ink:       #eef1f6;
			--muted:     #7c8395;
			--line:      #232833;
			--accent:    #4fe3c1;
			--accent-dim: rgba(79, 227, 193, 0.14);
		}

		* { margin: 0; padding: 0; box-sizing: border-box; }

		html, body { height: 100%; }

		body {
			font-family: "Space Grotesk", system-ui, sans-serif;
			background:
				radial-gradient(120% 80% at 50% -10%, #171b24 0%, var(--bg) 55%),
				var(--bg);
			color: var(--ink);
			display: flex;
			align-items: center;
			justify-content: center;
			padding: 32px;
			overflow: hidden;
			position: relative;
		}

		/* faint grid backdrop */
		body::before {
			content: "";
			position: absolute;
			inset: 0;
			background-image:
				linear-gradient(var(--line) 1px, transparent 1px),
				linear-gradient(90deg, var(--line) 1px, transparent 1px);
			background-size: 64px 64px;
			-webkit-mask-image: radial-gradient(60% 55% at 50% 45%, #000 0%, transparent 75%);
			mask-image: radial-gradient(60% 55% at 50% 45%, #000 0%, transparent 75%);
			opacity: 0.5;
			pointer-events: none;
		}

		.card {
			position: relative;
			width: 100%;
			max-width: 560px;
			text-align: center;
		}

		.eyebrow {
			font-family: "JetBrains Mono", monospace;
			font-size: 12px;
			letter-spacing: 0.32em;
			text-transform: uppercase;
			color: var(--accent);
			margin-bottom: 28px;
		}
		.eyebrow .dot {
			display: inline-block;
			width: 7px; height: 7px;
			border-radius: 50%;
			background: var(--accent);
			margin-right: 10px;
			vertical-align: middle;
			animation: blink 1.4s steps(2, jump-none) infinite;
		}
		@keyframes blink { 50% { opacity: 0.25; } }

		.code {
			font-size: clamp(96px, 26vw, 200px);
			font-weight: 700;
			line-height: 0.9;
			letter-spacing: -0.04em;
			background: linear-gradient(180deg, var(--ink) 20%, #59606e 130%);
			-webkit-background-clip: text;
			background-clip: text;
			color: transparent;
			position: relative;
		}
		/* subtle scan flicker on the number */
		.code::after {
			content: "404";
			position: absolute;
			inset: 0;
			color: var(--accent);
			mix-blend-mode: screen;
			opacity: 0;
			animation: glitch 5.5s infinite;
		}
		@keyframes glitch {
			0%, 92%, 100% { opacity: 0; transform: none; }
			93%  { opacity: 0.5; transform: translate(2px, -1px); }
			95%  { opacity: 0.2; transform: translate(-2px, 1px); }
			97%  { opacity: 0.4; transform: translate(1px, 0); }
		}

		h1 {
			font-size: 22px;
			font-weight: 600;
			letter-spacing: -0.01em;
			margin: 18px 0 10px;
		}

		p.lead {
			color: var(--muted);
			font-size: 15px;
			line-height: 1.6;
			max-width: 380px;
			margin: 0 auto;
		}

		/* --- signature: countdown ring around the primary action --- */
		.actions {
			margin-top: 40px;
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 20px;
			flex-wrap: wrap;
		}

		.timer {
			position: relative;
			width: 96px;
			height: 96px;
			flex: none;
		}
		.timer svg { transform: rotate(-90deg); display: block; }
		.timer .track { stroke: var(--line); }
		.timer .progress {
			stroke: var(--accent);
			stroke-linecap: round;
			stroke-dasharray: 276.46;   /* 2 * pi * 44 */
			stroke-dashoffset: 0;
			transition: stroke-dashoffset 1s linear;
			filter: drop-shadow(0 0 6px var(--accent-dim));
		}
		.timer .count {
			position: absolute;
			inset: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			font-family: "JetBrains Mono", monospace;
			font-size: 32px;
			font-weight: 500;
			font-variant-numeric: tabular-nums;
		}

		.copy {
			text-align: left;
			max-width: 220px;
		}
		.copy .now {
			display: inline-flex;
			align-items: center;
			gap: 8px;
			font-family: inherit;
			font-size: 15px;
			font-weight: 600;
			color: var(--bg);
			background: var(--accent);
			border: none;
			border-radius: 999px;
			padding: 11px 20px;
			cursor: pointer;
			text-decoration: none;
			transition: transform 0.15s ease, box-shadow 0.2s ease;
		}
		.copy .now:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--accent-dim); }
		.copy .now:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
		.copy .now svg { width: 15px; height: 15px; }

		.copy .dest {
			font-family: "JetBrains Mono", monospace;
			font-size: 12px;
			color: var(--muted);
			margin-top: 12px;
		}
		.copy .dest b { color: var(--ink); font-weight: 500; }

		.back {
			margin-top: 34px;
			font-size: 13px;
			color: var(--muted);
		}
		.back a {
			color: var(--ink);
			text-decoration: none;
			border-bottom: 1px solid var(--line);
			padding-bottom: 2px;
			transition: border-color 0.2s ease;
		}
		.back a:hover { border-color: var(--accent); }

		@media (max-width: 460px) {
			.actions { flex-direction: column; gap: 24px; }
			.copy { text-align: center; }
		}

		@media (prefers-reduced-motion: reduce) {
			.eyebrow .dot, .code::after { animation: none; }
			.timer .progress { transition: none; }
		}
	</style>
</head>
<body>
	<main class="card">
		<div class="eyebrow"><span class="dot"></span>Error 404</div>

		<div class="code">404</div>

		<h1>This page took a wrong turn.</h1>
		<p class="lead">The link may be broken or the page may have moved. We're sending you somewhere that works.</p>

		<div class="actions">
			<div class="timer" aria-hidden="true">
				<svg width="96" height="96" viewBox="0 0 96 96">
					<circle class="track" cx="48" cy="48" r="44" fill="none" stroke-width="4" />
					<circle class="progress" id="ring" cx="48" cy="48" r="44" fill="none" stroke-width="4" />
				</svg>
				<div class="count" id="count">5</div>
			</div>

			<div class="copy">
				<a class="now" href="https://fry99.com">
					Go now
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
				</a>
				<div class="dest">Redirecting to <b>mydesi.net</b></div>
			</div>
		</div>

		<p class="back">Rather stay? <a href="javascript:history.back()">Go back one step</a></p>
	</main>

	<script>
		(function () {
			var TOTAL = 5;
			var CIRC = 2 * Math.PI * 44; // 276.46
			var ring = document.getElementById('ring');
			var count = document.getElementById('count');
			var remaining = TOTAL;

			ring.style.strokeDashoffset = '0';

			var tick = setInterval(function () {
				remaining -= 1;
				if (remaining <= 0) {
					clearInterval(tick);
					count.textContent = '0';
					ring.style.strokeDashoffset = CIRC;
					window.location.href = 'https://fry99.com/';
					return;
				}
				count.textContent = String(remaining);
				ring.style.strokeDashoffset = CIRC * ((TOTAL - remaining) / TOTAL);
			}, 1000);
		})();
	</script>
</body>
</html>