        initWorldCupBackgroundPan: function () {
            if (this.current !== 'world-cup') {
                return;
            }

            var html = document.documentElement;
            if (html.worldCupBackgroundPanInitialized) {
                return;
            }
            html.worldCupBackgroundPanInitialized = true;

            var imageWidth = 2000;
            var imageHeight = 1333;
            var scheduled = false;

            function update() {
                var body = document.body;
                var viewportWidth = window.innerWidth || html.clientWidth;
                var viewportHeight = window.innerHeight || html.clientHeight;
                var documentHeight = Math.max(html.scrollHeight, body ? body.scrollHeight : 0);
                var scrollMax = Math.max(0, documentHeight - viewportHeight);
                var scrollTop = window.pageYOffset || html.scrollTop || (body ? body.scrollTop : 0) || 0;
                var scrollProgress = scrollMax > 0 ? Math.min(1, Math.max(0, scrollTop / scrollMax)) : 0;
                var scale = Math.max(viewportWidth / imageWidth, viewportHeight / imageHeight);
                var renderedWidth = imageWidth * scale;
                var renderedHeight = imageHeight * scale;
                var imageOverflow = Math.max(0, renderedHeight - viewportHeight);
                var y = -imageOverflow * scrollProgress;

                html.style.setProperty('--world-cup-bg-size', Math.ceil(renderedWidth) + 'px ' + Math.ceil(renderedHeight) + 'px');
