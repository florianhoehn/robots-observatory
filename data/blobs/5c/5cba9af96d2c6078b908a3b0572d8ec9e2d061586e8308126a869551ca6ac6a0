         url = "https://pre-prod.livemint.com/api/lm/remove-premium-icon";
    }else{
         url = "https://www.livemint.com/api/lm/remove-premium-icon";
    }

    fetch(url, {
        method: 'GET',
        headers: {
            'Content-Type': 'application/json'
