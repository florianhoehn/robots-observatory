<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" href="/static/favicon.ico">

    <title>404 Sayfa Bulunamadı</title>
    <meta http-equiv="refresh" content="10; URL='/'">

    <style>
        @font-face {
            font-family: TRT-Light;
            src: url(/static/css/fonts/TRT/TRT_Light.otf);
        }
        @font-face {
            font-family: TRT-Medium;
            src: url(/static/css/fonts/TRT/TRT_Medium.otf);
        }
        @font-face {
            font-family: TRT-Regular;
            src: url(/static/css/fonts/TRT/TRT_Regular.otf);
        }
        html,body {margin: 0; padding: 0;}
        .header {width: calc(100% - 30px); height: 40px; line-height: 40px; background-color: #CF1D39; color: #ffffff; font-size: 18px; padding: 5px 15px;}
        .header span.light { font-family: TRT-Light, Sans-Serif;}
        .header span.medium { font-family: TRT-Medium, Sans-Serif;}
        .content {width: 100%; height: auto; display: flex; flex-flow: column nowrap; align-items: center;}
        .content .logo {width: 80%; max-width: 400px; margin-top: 250px;}
        .content .text {font-family: TRT-Medium, Sans-Serif; font-size: 22px; color: #000000; margin-top: 22px;}
        .content .link {font-family: TRT-Regular, Sans-Serif; font-size: 20px; color: #CF1D39; margin-top: 30px; text-decoration: none; line-height: 30px;}
        .content .link img {float: left; width: 25px; margin-right: 10px;}
        @media (max-width: 576px) {
            .content .text {font-size: 16px;}
            .content .link {font-size: 12px; line-height: 22px;}
            .content .link img {width: 18px;}
        }
    </style>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-26291030-5"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'UA-26291030-5');
    </script>

</head>
<body>

<div class="header">
    <span class="light">404</span> <span class="medium">SAYFA BULUNAMADI</span>
</div>
<div class="content">
    <img src="/static/images/new-logo-black.svg" class="logo" />
    <p class="text">Aradığınız sayfaya ulaşılamadı</p>
    <a href="https://www.trthaber.com" class="link"><img src="/static/images/404-back-to.png" />TRT Haber Anasayfa</a>
</div>
</body>
</html>