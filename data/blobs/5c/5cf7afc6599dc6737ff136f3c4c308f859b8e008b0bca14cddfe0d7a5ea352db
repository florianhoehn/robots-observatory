                    </div>
                    <div style="margin-top: 32px;">
                        <p>
                            <span data-request-date=""></span><br/>
                            <span data-request-ip=""></span><br/>
                            <span data-request-id=""></span><br/>
                            <span data-origin-id=""></span><br/>
                            <button class="button-link" type="button" onclick="copy()" data-copy-button>
                                Скопировать данные
                            </button>
                            <span class="color-second" aria-live="assertive" role="alert" data-copy-success hidden >Скопировано</span>
                        </p>
                    </div>
                    <script>
                        async function copy() {
                            const lines = [
                                ...document.querySelectorAll('[data-request-date], [data-request-ip], [data-request-id], [data-origin-id]')
                            ].map(el => el.textContent);
                            const text = lines.join("\n");
                            if (navigator.clipboard && navigator.clipboard.writeText) {
                                try {
                                    await navigator.clipboard.writeText(text);
                                    return;
                                } catch (err) {
                                    console.warn(err);
                                }
                            }
                            //Fallback
                            const textarea = document.createElement("textarea");
                            textarea.value = text;
                            textarea.style.position = "fixed";
                            textarea.style.opacity = 0;
                            document.body.appendChild(textarea);
                            textarea.focus();
                            textarea.select();
                            try {
                                document.execCommand("copy");
                            } catch (err) {
                                console.error(err);
                            }
                            document.body.removeChild(textarea);
                        }
                        document.addEventListener("DOMContentLoaded", function() {
                            const copyButton = document.querySelector('[data-copy-button]');
                            const copySuccess = document.querySelector('[data-copy-success]');
                            const origin = window.location.host;
                            document.getElementById('ORIGIN-ID').innerHTML = "Origin: " + origin;
                            let params = '';

                             const map = {
                                "REQUEST-DATE": { attr: "data-request-date", label: "Дата запроса" },
                                "REQUEST-IP":   { attr: "data-request-ip",   label: "IP" },
                                "REQUEST-ID":   { attr: "data-request-id",   label: "ID запроса" },
                                "ORIGIN-ID":    { attr: "data-origin-id",    label: "Домен" }
                            };
                            
                            Object.entries(map).forEach(([srcId, { attr, label }]) => {
                                const srcEl = document.getElementById(srcId);
                                const targetEl = document.querySelector(`[${attr}]`);
                                if (srcEl && targetEl) {
                                    const value = srcEl.textContent.split(":").slice(1).join(":").trim();
                                    targetEl.textContent = `${label}: ${value}`;
                                    params += `${label}: ${value} \n`;
                                }
                            });

                            const mailBody = encodeURIComponent(params);
                            const mailtoHref = `mailto:help@skbkontur.ru?subject=${encodeURIComponent("Обращение со страницы - Доступ запрещен")}&body=${mailBody}`;
                            document.getElementById("mailto-link").href = mailtoHref;
                            copyButton.addEventListener('click', function() {
                                copyButton.hidden = true;
                                copySuccess.hidden = false;

                                setTimeout(function() {
                                    copyButton.hidden = false;
                                    copySuccess.hidden = true;
                                }, 2500);
