<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>学习强国</title>
<style>
    body {
      width: 100%;
      min-width: 1200px;
      margin: 0;
      font-family: 微软雅黑, "Microsoft YaHei", PingFangSC;
    }
    .header-wrapper {
      height: 334px;
    }
    .footer-wrapper {
      height: 500px;
    }
    #header {
      width: 100%;
      height: 334px;
    }
    #footer {
      width: 100%;
      height: 500px;
      display: flex;
      justify-content: center;
    }
    #main {
      min-height: 300px;
      opacity: 0;
    }
    .page {
      box-sizing: border-box;
      padding: 100px 0;
    }
    .image-content {
      display: none;
    }
    .image-content > img {
      width: 200px;
      display: block;
      margin: 0 auto 16px;
    }
    .tip-content {
      display: none;
      text-align: center;
    }
    .tip-title {
      font-weight: 400;
      font-size: 18px;
      color: #687078;
      line-height: 20px;
    }
    .tip-details {
      padding: 8px 0 24px;
      font-size: 14px;
      line-height: 20px;
      color: #ABB3BA;
    }
    #tip-time {
      color: #CB1E1E;
      margin-right: 4px;
    }
    .tip-btn {
      display: inline-block;
      padding: 6px 16px;
      background-color: #CB1E1E;
      border-radius: 3px;
      font-weight: 400;
      font-size: 14px;
      color: #FFFFFF;
      cursor: pointer;
      user-select: none;
    }

  </style>
<script type="text/javascript">
    window.PAGE_STATIC_URLS = {
      headerSrc: 'https://www.xuexi.cn/b0b2a39e854d4612c6858aea76861d98/648fafc83297345be269377aefc53c9e.html',
      footerSrc: 'https://www.xuexi.cn/4063dbabf4bad826aeeb5d831ce9624e/60bd1d03c55149fd0e92da70d074d72b.html',
      notFoundImg: 'https://www.xuexi.cn/lgpage/static/images/notFound.png',
      noContent: 'https://www.xuexi.cn/lgpage/static/images/noContent.png',
    };
  </script>
</head>
<body>
<div class="header-wrapper">
<iframe src="https://www.xuexi.cn/b0b2a39e854d4612c6858aea76861d98/648fafc83297345be269377aefc53c9e.html" scrolling="no" frameborder="0" id="header"></iframe>
</div>
<div id="main" class="page">
<div class="content">
<div class="image-content notFound">
<img class="image-notFound" src="">
</div>
<div class="tip-content notFound">
<div class="tip-title">网络异常或您访问的页面不存在</div>
<div class="tip-details">
<span id="tip-time">5</span>秒后自动返回首页，您也可以直接返回
</div>
<div class="tip-btn" onclick="gotoHome()">返回首页</div>
</div>
<div class="image-content noContent">
<img class="image-noContent" src="">
</div>
<div class="tip-content noContent">
<div class="tip-title">暂无相关内容</div>
</div>
</div>
</div>
<div class="footer-wrapper">
<iframe src="https://www.xuexi.cn/4063dbabf4bad826aeeb5d831ce9624e/60bd1d03c55149fd0e92da70d074d72b.html" scrolling="no" frameborder="0" id="footer"></iframe>
</div>
</body>
<script>
  function gotoHome() {
    window.location.replace('https://' + window.location.hostname);
  }
  var pathname = window.location.pathname;
  var isNoContent = (pathname.toLocaleLowerCase().indexOf('/nocontent') >= 0);
  var isNotFound = !isNoContent;
  var tipDoms = [];
  if (isNoContent) {
    tipDoms = document.getElementsByClassName('noContent') || [];
    for (var i = 0; i < tipDoms.length; i ++) {
      tipDoms[i].style.display = 'block';
    }
    document.querySelector('head title').innerText = '暂无相关内容';
    document.querySelector('img.image-noContent').src = (window.PAGE_STATIC_URLS || {}).noContent || 'https://www.xuexi.cn/lgpage/static/images/noContent.png';
  }
  if (isNotFound) {
    tipDoms = document.getElementsByClassName('notFound') || [];
    for (var j = 0; j < tipDoms.length; j ++) {
      tipDoms[j].style.display = 'block';
    }
    document.querySelector('head title').innerText = '网络异常或您访问的页面不存在';
    document.querySelector('img.image-notFound').src = (window.PAGE_STATIC_URLS || {}).notFoundImg || 'https://www.xuexi.cn/lgpage/static/images/notFound.png';
  }
  var headerDom = document.getElementById('header');
  headerDom.onload = function() {
    var main = document.getElementById('main');
    main && (main.style.opacity = 1);
    if (!isNotFound) {
      return;
    }
    var time = 5;
    var tipDom = document.getElementById('tip-time');
    var interval = setInterval(function() {
      time -= 1;
      tipDom.innerText = time;
      if (time <= 0) {
        clearInterval(interval);
        gotoHome();
      }
    }, 1000);
  };
  var headerDom = document.querySelector('#header');
  if (headerDom && headerDom.src !== window.PAGE_STATIC_URLS.headerSrc) {
    headerDom.src = window.PAGE_STATIC_URLS.headerSrc;
  }
  var footerDom = document.querySelector('#footer');
  if (footerDom && footerDom.src !== window.PAGE_STATIC_URLS.footerSrc) {
    footerDom.src = window.PAGE_STATIC_URLS.footerSrc;
  }
</script>
</html>
