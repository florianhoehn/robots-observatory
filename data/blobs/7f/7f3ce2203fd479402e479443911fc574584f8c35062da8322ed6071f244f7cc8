            <span class="support-link-span">Связаться в Telegram</span>
          </div>
        </a>

        <div class="user-info-wrap">
          <div class="user-info-copy-block">
            <p class="user-info-point" >
              Дата и время:
              <span class="user-info-description" id="REQUEST-DATE"
                >2026-10-19 18:54:41 +0000</span
              >
            </p>

            <svg
              width="19"
              height="18"
              viewBox="0 0 19 18"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              onclick="copy()"
            >
              <path
                d="M6.96094 0.75C6.54672 0.75 6.21094 1.08579 6.21094 1.5C6.21094 1.91421 6.54672 2.25 6.96094 2.25H13.7109C14.5394 2.25 15.2109 2.92157 15.2109 3.75V12.75C15.2109 13.1642 15.5467 13.5 15.9609 13.5C16.3752 13.5 16.7109 13.1642 16.7109 12.75V3.75C16.7109 2.09315 15.3678 0.75 13.7109 0.75H6.96094Z"
