              />
            </svg>
          </div>

          <p class="user-info-point">
            Ваш IP:
            <span class="user-info-description" id="REQUEST-IP">82.39.15.43</span>
          </p>
          <p class="user-info-point">
            ID запроса:
            <span class="user-info-description" id="REQUEST-ID">fskQsl4GfiE1</span>
          </p>
        </div>
      </div>
    </main>
  </body>
</html>
