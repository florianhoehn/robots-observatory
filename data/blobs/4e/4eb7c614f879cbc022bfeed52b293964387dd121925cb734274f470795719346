    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var holder = document.getElementById('lastVisitedPage');
            if (!holder) return;
            function readCookie(name) {
                var prefix = name + '=';
                var parts = document.cookie.split(';');
                for (var i = 0; i < parts.length; i++) {
                    var part = parts[i].replace(/^\s+/, '');
                    if (part.indexOf(prefix) === 0) {
                        var raw = part.substring(prefix.length);
                        try { return decodeURIComponent(raw); } catch (e) { return raw; }
                    }
                }
                return null;
            }
            var name = readCookie('p_BookName');
            var id = readCookie('p_BookId');
            var no = readCookie('p_PageNo');
            var tp = readCookie('p_Tp') || '0';
            var db = readCookie('p_Db') || '0';
            if (!name || !id || !no) return;
            var slug = (name || '').replace(/[^0-9A-Za-z ,]/g, '').replace(/ /g, '-');
            var url = '/Page/Story/' + encodeURIComponent(id) + '/page-' + encodeURIComponent(no) + '-of-' + slug + '/' + encodeURIComponent(no) + '/' + encodeURIComponent(tp) + '/' + encodeURIComponent(db);
            var label = 'Page ' + no + ' of ' + name;
            holder.innerHTML = '<div class="last-visited-bar"><div class="last-visited-bar__inner"><span class="last-visited-bar__label">Last visited</span><a href="' + url + '" title="' + label.replace(/"/g, '&quot;') + '">' + label.replace(/</g, '') + '</a></div></div>';
        });
    </script>
    
