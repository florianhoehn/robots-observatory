$(document).ready(function() {
    $(".button-create-header").on("mousemove", ({ target, offsetX, offsetY }) => {
  const { height, width } = event.target.getBoundingClientRect();
  const xPercentage = Math.abs(offsetX / width * 100);
  const yPercentage = Math.abs(offsetY / height * 100);
  $(".button-create-header").get(0).style.setProperty("--mouse-x", xPercentage);
  $(".button-create-header").get(0).style.setProperty("--mouse-y", yPercentage);
});
    
var $window = $(window),
  flexslider = { vars:{} };

function getGridSize() {
  const _innerWidth = window.innerWidth
  return (_innerWidth < 550) ? 1
    : (_innerWidth < 750) ? 2
    : 3;
}

$window.load(function() {
  var gridSize = getGridSize();
  $("#featured-pods").flexslider({
    slideshow: false,
    animation: "slide",
    animationLoop: true,
    prevText: "",
    nextText: "",
    itemWidth: 316,
    minItems: gridSize,
    maxItems: gridSize,
    controlNav: false,
    start: function(slider) {
      flexslider = slider;
    }
  });
});

$window.resize(function() {
  var gridSize = getGridSize();
  flexslider.vars.minItems = gridSize;
  flexslider.vars.maxItems = gridSize;
});

$('.js-video-thumbnail').click(function(e) {
  if ($(this).find('.js-video-thumb-overlay').is(':visible'))
    return;

  $('#story-blurb').html($(this).find('.js-blurb-html').html());
  $('#story-video').html($(this).find('.js-video-html').html());
  $('.js-video-thumb-overlay').hide();
  $(this).find('.js-video-thumb-overlay').show();
  e.preventDefault();
});

});
//]]>
</script>


