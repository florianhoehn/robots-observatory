<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="/themes/custom/paramount/css/style.css" />
    <link rel="icon" type="image/x-icon" href="/themes/custom/paramount/images//icons/icon_logo.svg">
    <title>404</title>
  </head>
  <body id="not-found-page">
    <div id="screen-blanket"></div>
    <nav id="main-navbar" class="navbar title-solid redeem-visible">
      <div class="navbar__container container-fluid g-0 h-100">
        <section class="row region region-top-header">
          <nav role="navigation" aria-labelledby="block-paramount-mainnavigation-menu" id="block-paramount-mainnavigation" class="block block-menu navigation menu--main">
            <div class="main-navigation">
              <a id="home" href="/">
                <img id="paramount-home" alt="Paramount Pictures Logo" src="/themes/custom/paramount/images/icons/icon_logo.svg">
              </a>
              <div class="main-navigation__actions">
                <a href="/#search" class="not-found-main-navigation__search" aria-label="Toggle search"></a>
                <a href="/#menu" class="not-found-main-navigation__toggle" aria-label="Toggle main navigation"></a>
              </div>
            </div>
          </nav>
        </section>
      </div>
    </nav>
    <div id="main-search">
      <div class="search-container">
        <form id="nav-search-form">
          <input class="search-input" type="text" placeholder="Search for titles">
        </form>
        <button class="main-navigation__search search-close"></button>
      </div>
    </div>
    <div class="not-found-page-body">
      <div class="page-not-found-title-wrapper">
        <h1>OOPS PAGE NOT FOUND!</h1>
      </div>
      <a href="/">Return to Homepage</a>
    </div>
  </body>
</html>
