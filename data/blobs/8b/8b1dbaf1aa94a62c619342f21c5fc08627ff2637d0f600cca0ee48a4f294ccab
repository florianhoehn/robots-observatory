    <script>
    (function(){
        var ua = navigator.userAgent || '';
        // Dans l'application ou une webview : jamais de bandeau.
        if (/Turfomania|Dalvik|; wv\)/i.test(ua)) return;
        if (document.cookie.indexOf('smartbanner_ferme=1') !== -1) return;

        // Android uniquement : sur iOS c'est la meta apple-itunes-app qui rend
        // le bandeau natif, et sur desktop il n'y a rien a proposer.
        if (!/Android/i.test(ua)) return;

        var el = document.getElementById('smartbanner-android');
        var a  = document.getElementById('sb-lien');
        if (el && a) {
            a.href = 'https://play.google.com/store/apps/details?id=com.eliraweb.turfomania&referrer=utm_source%3Dturfomania%26utm_medium%3Dsmartbanner%26utm_campaign%3Dbandeau_android';
            el.className = 'sb-visible';
            decalerSite(true);
        }
    })();

    // Decalage du site de la hauteur du bandeau.
    // On AJOUTE aux valeurs existantes au lieu de les remplacer : en mobile le
    // CSS pose deja body{padding-top:55px} et #menu{top:55px !important} pour
    // compenser le header absolu. Ecraser ces valeurs ne decalait la page que
    // de 3px. Chaque element n'est traite qu'une fois (data-sb-decale), le
    // script passant deux fois : avant et apres le parsing du DOM.
    var SB_H = 58;

    function sbAppliquer(el, prop, ajouter) {
        if (!el) return;
        var deja = (el.getAttribute('data-sb-decale') === '1');
        if (ajouter === deja) return; // rien a faire

        var v = parseFloat(window.getComputedStyle(el)[prop]) || 0;
        var cssProp = prop.replace(/([A-Z])/g, '-$1').toLowerCase();
        // setProperty + important : #menu est en top:55px !important.
        el.style.setProperty(cssProp, (v + (ajouter ? SB_H : -SB_H)) + 'px', 'important');

        if (ajouter) { el.setAttribute('data-sb-decale', '1'); }
        else { el.removeAttribute('data-sb-decale'); }
    }

    function decalerSite(ajouter) {
        function appliquer() {
            // .conteneurHeader est en flux : une marge le pousse, lui et tout
            // ce qui suit. #headerCloud et #menu sont hors flux (absolute et
            // fixed), il faut deplacer leur top explicitement.
            sbAppliquer(document.querySelector('.conteneurHeader'), 'marginTop', ajouter);
            sbAppliquer(document.getElementById('headerCloud'), 'top', ajouter);
            sbAppliquer(document.getElementById('menu'), 'top', ajouter);
        }
        appliquer();
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', appliquer);
        }
    }

    function masquerSmartbanner(jours) {
        var el = document.getElementById('smartbanner-android');
        if (el) { el.style.display = 'none'; }
        decalerSite(false);
        document.cookie = 'smartbanner_ferme=1;max-age=' + (60*60*24*jours) + ';path=/';
    }
    </script>
    <script>
/* Thème. Le défaut (sombre en mobile) est rendu côté serveur pour éviter tout flash :
   c'est possible car le cache HTML Cloudflare est configuré en "Cache By Device Type".
   Un choix explicite de l'utilisateur est en localStorage, donc invisible du serveur
   (le cache HTML ignore les cookies) : il ne peut être appliqué qu'ici, en JS.
   Placé en tête de body pour corriger avant le premier rendu. */
(function(){
	var savedTheme = null;
	try { savedTheme = localStorage.getItem('theme'); } catch(e) {}
	if(savedTheme === 'dark') { document.body.classList.add('dark-theme'); }
	else if(savedTheme) { document.body.classList.remove('dark-theme'); }
})();
</script>




