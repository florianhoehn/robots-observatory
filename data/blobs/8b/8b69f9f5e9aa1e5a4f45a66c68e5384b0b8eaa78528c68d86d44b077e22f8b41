            document.addEventListener('DOMContentLoaded', () => {
              const videos = document.querySelectorAll('video.lazy-video:not([data-initialized])');
            
              const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                  if (entry.isIntersecting) {
                    activateVideo(entry.target);
                    obs.unobserve(entry.target);
                  }
                });
              }, { rootMargin: '200px' });
            
              videos.forEach(video => {
                video.dataset.initialized = 'true';
                observer.observe(video);
              });
            
              function activateVideo(video) {
                const isMobile = window.matchMedia('(max-width: 767px)').matches;
                const srcMobile = video.dataset.srcMobile;
                const srcDesktop = video.dataset.srcDesktop;
            
                // usa mobile se existir e a tela for pequena; senão cai pro desktop
                const srcEscolhido = (isMobile && srcMobile) ? srcMobile : srcDesktop;
            
                if (srcEscolhido && !video.querySelector('source')) {
                  const source = document.createElement('source');
                  source.src = srcEscolhido;
                  source.type = 'video/mp4';
                  video.appendChild(source);
                  video.addEventListener('loadedmetadata', () => ajustarProporcao(video), { once: true });
                  video.load();
                }
              }
              
              function ajustarProporcao(video) {
                  const largura = video.videoWidth;
                  const altura = video.videoHeight;
                  if (!largura || !altura) return;
                
                  const container = video.closest('.embed-responsive');
                  if (!container) return;
                
                  const ehVertical = altura > largura;
                  container.classList.remove('embed-responsive-16by9', 'embed-responsive-9by16');
                  container.classList.add(ehVertical ? 'embed-responsive-9by16' : 'embed-responsive-16by9');
                }
            }
            

            );
            
            
            </script>
