window.zDropdown = function(target, parentClass) {
  var _this = this;
  this.target = $(target);
  this.arrow = this.target.find(".zArrow");
  var firstClass = this.target.attr("class").split(" ")[0].replace("z", "").toLowerCase();
  this.flyout = this.target.siblings(".zFlyout." + firstClass);
  this.timeout;
  
  this.touchHandler = function(e) {
    var cur = $(e.target);
    if (!cur.parents(parentClass).length) {
      _this.hideFlyout();
      $(document).off("touchstart.zLogoNavRollovers");
    }
  }
  
  this.showFlyout = function() {
    // Close others
    $(parentClass + " .zFlyout").not(_this.flyout).hide();
    $(parentClass + " [aria-expanded='true']").not(_this.target).attr('aria-expanded', false);
    $(parentClass + " .zArrow").not(_this.arrow).removeClass("arrowTop");
    _this.target.attr('aria-expanded', true);
    _this.flyout.show();
    _this.arrow.addClass("arrowTop");
  }
  
  this.hideFlyout = function() {
    _this.flyout.hide();
    _this.target.attr('aria-expanded', false);
    _this.arrow.removeClass("arrowTop");
  }
  
  this.target
    .on("mouseenter", function() {
      clearTimeout(_this.timeout);
      _this.showFlyout();
    })
    .on("mouseleave", function() {
      _this.timeout = setTimeout(function() {
        _this.hideFlyout();
      }, 250);
    })
    .on("touchstart", function(e) {
      _this.target.off("mouseenter mouseleave");
      if (!_this.flyout.is(":visible")) {
        e.preventDefault();
        e.stopPropagation();
        _this.showFlyout();
        $(document).on("touchstart.zLogoNavRollovers", _this.touchHandler);
      }
    })
    .on("click keydown", function(e) {
      if (e.type === 'click' && e.target !== e.currentTarget) return true;
      if (e.type === "keydown" && e.key !== "Enter" && e.key !== " ") return;
      e.preventDefault();
      e.stopPropagation();
      if (_this.target.attr('aria-expanded') === "true") {
        _this.hideFlyout();
      } else {
        clearTimeout(_this.timeout);
        _this.showFlyout();
      }
    })
    .on("keydown", function(e) {
      if (e.key === "Escape") {
        _this.hideFlyout();
        _this.target.focus();
      }
    });
  
  this.flyout
    .on("mouseenter", function() {
      clearTimeout(_this.timeout);
    })
    .on("mouseleave", function() {
      _this.timeout = setTimeout(function() {
        _this.hideFlyout();
      }, 250);
    })
    .on("keydown", function(e) {
      if (e.key === "Escape") {
        _this.hideFlyout();
        _this.target.focus();
      }
    });
  
  $(document).on("focusin.zDropdown", function(e) {
    const active = e.target;
    if (!_this.flyout[0].contains(active) && !_this.target[0].contains(active)) {
      _this.hideFlyout();
    }
  });
  
  return this;
}

$('.zLogoNav').find('.zWatch, .zConnect').each(function() {
  new zDropdown(this, '.zLogoNav')
});
</script>


