# --- Mises additions -------------------------------------------------------
#
# Appended to core's robots.txt by composer scaffold; see
# composer.json extra.drupal-scaffold.file-mapping. web/robots.txt itself is
# gitignored and regenerated from core, so it must not be edited directly.
#
# Core's file opens a single "User-agent: *" group and ships no other groups,
# so the Disallow lines below continue that group. Sitemap is a non-group
# directive and is kept last.

# TW30046174 - /admin returns 403 to crawlers, and core only disallows
# "/admin/" with a trailing slash, which leaves "/admin" itself crawlable.
# GSC reported it under "Blocked due to access forbidden (403)".
Disallow: /admin
Disallow: /index.php/admin

# TW30046174 - Book export routes carry a noindex tag but are still crawled,
# spending crawl budget on roughly 1.3k URLs that can never be indexed. They
# were the bulk of GSC's "Excluded by 'noindex' tag" examples.
Disallow: /book/export/
Disallow: /index.php/book/export/

# TW30046174 - The Views AJAX pager appends a jQuery cache-buster (?_=<epoch>),
# and those endpoints are being crawled as full duplicate listing pages - they
# recur throughout GSC's "Page with redirect" examples. Blocking them only
# affects crawlers; AJAX from real browsers is unaffected.
Disallow: /*?_=
Disallow: /*&_=

# TW30046174 - Advertise the canonical https sitemap. Every sitemap submitted
# in Search Console is an http:// URL, so Google indexes the https pages but
# records "No referring sitemaps detected" against them. This points crawlers
# at the correct sitemap without waiting on a manual resubmission.
Sitemap: https://mises.org/sitemap.xml
