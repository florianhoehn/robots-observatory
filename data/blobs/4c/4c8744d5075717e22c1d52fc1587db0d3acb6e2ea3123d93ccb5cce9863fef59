      <span id="brand-title">GBitt.info</span>
    </a>
    <div class="nav-links">
      <a class="item" href="#about"><i class="info circle icon"></i> About</a>
      <a class="item" href="#tracker"><i class="broadcast tower icon"></i> Tracker</a>
      <a class="item" href="#status"><i class="heartbeat icon"></i> Status</a>
      <a class="item" href="#statistics"><i class="chart bar icon"></i> Statistics</a>
