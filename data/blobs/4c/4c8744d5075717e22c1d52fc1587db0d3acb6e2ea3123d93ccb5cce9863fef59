    </div>
    <div class="right menu">
      <div class="item theme-toggle-item">
        <div class="theme-switch" role="group" aria-label="Theme">
          <button type="button" data-theme-mode="light" title="Light theme">
            <i class="sun icon"></i>
          </button>
          <button type="button" data-theme-mode="auto" title="Match OS theme">
