<style>
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{
    font-family:"Inter","Helvetica Neue",Arial,-apple-system,BlinkMacSystemFont,sans-serif;
    background:#051114;color:#fff;min-height:100vh;
    display:flex;align-items:center;justify-content:center;padding:24px;
    position:relative;overflow:hidden;-webkit-font-smoothing:antialiased;
  }
  body::before{content:"";position:absolute;inset:0;
    background-image:radial-gradient(rgba(227,252,114,.10) 1px,transparent 1px);
    background-size:24px 24px;-webkit-mask-image:radial-gradient(circle at 50% 40%,#000,transparent 75%);
    mask-image:radial-gradient(circle at 50% 40%,#000,transparent 75%);}
  body::after{content:"";position:absolute;width:680px;height:680px;border-radius:50%;
    background:radial-gradient(circle,rgba(227,252,114,.15),transparent 62%);
    top:-280px;left:50%;transform:translateX(-50%);pointer-events:none;animation:glow 6s ease-in-out infinite}
  @keyframes glow{0%,100%{opacity:.8}50%{opacity:1}}
  .box{position:relative;text-align:center;max-width:520px;animation:up .55s cubic-bezier(.22,.61,.36,1)}
  @keyframes up{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
  .mark{width:64px;height:64px;border-radius:18px;background:#051114;
    display:inline-flex;align-items:center;justify-content:center;margin-bottom:22px;
    animation:bob 3.6s ease-in-out infinite}
  .mark svg{width:44px;height:44px}
  @keyframes bob{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-9px) rotate(-5deg)}}
  .code{font-size:128px;font-weight:800;line-height:1;letter-spacing:-.05em;margin-bottom:4px;
    background:linear-gradient(160deg,#fff 30%,#E3FC72);-webkit-background-clip:text;background-clip:text;color:transparent;
    animation:float 4.5s ease-in-out infinite;filter:drop-shadow(0 10px 44px rgba(227,252,114,.28))}
  @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}
  h1{font-size:24px;margin:6px 0 10px;font-weight:700;letter-spacing:-.01em}
  p{color:rgba(255,255,255,.55);font-size:15px;line-height:1.6;margin:0 0 28px}
  .btns{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
  .btn{display:inline-flex;align-items:center;height:44px;padding:0 22px;border-radius:10px;font:inherit;
    font-size:14px;font-weight:600;text-decoration:none;cursor:pointer;
    border:1px solid rgba(255,255,255,.18);background:transparent;color:#fff;transition:background .15s,filter .15s}
  .btn:hover{background:rgba(255,255,255,.08)}
  .btn.primary{background:#E3FC72;color:#051114;border-color:#E3FC72}
  .btn.primary:hover{filter:brightness(.95);background:#E3FC72}
  .foot{margin-top:36px;color:rgba(255,255,255,.32);font-size:11px;letter-spacing:.16em;text-transform:uppercase}
  @media(prefers-reduced-motion:reduce){*{animation:none!important}}
  @media(max-width:520px){.code{font-size:90px}h1{font-size:21px}}
</style></head>
