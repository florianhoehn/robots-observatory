    },
    Sunday: {
      goldenAnk: "1-2-0-5",
      finalAnk: "K-1, M-5"
    }
  };

  function updateGoldenNumbers() {
    const days = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
    
    const now = new Date();
    const currentDayName = days[now.getDay()];

    // Aaj ke din ka data fetch karke update karein
    const todayData = weekData[currentDayName];
    if (todayData) {
      document.getElementById("golden-ank").innerText = todayData.goldenAnk;
      document.getElementById("final-ank").innerText = todayData.finalAnk;
    }
  }

  // Page load hote hi run karein
  document.addEventListener("DOMContentLoaded", updateGoldenNumbers);
</script>


