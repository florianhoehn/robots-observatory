User-agent: *
Allow: /

# Allow crawling of main content
Allow: /index.php
Allow: /movie.php
Allow: /tag.php
Allow: /assets/

# Disallow raw internal component/template directories (prevents redirect loops and crawling of PHP include files)
Disallow: /components/
Disallow: /layout/

# Allow crawling of sitemaps
Allow: /sitemap-*.xml

# Allow crawling of news and entertainment content
Allow: /news/
Allow: /quicknews/

# Disallow search result pages and internal search endpoints (Standing Rule)
# Never allow on-site search / open-query surfaces to be indexed — that was the spam door.
Disallow: /search
Disallow: /search.php
Disallow: /pages/search
Disallow: /pages/search.php
Disallow: /pages/search-redirect
Disallow: /pages/search-redirect.php
Disallow: /*?q=
Disallow: /*&q=
Disallow: /*?*search=
Disallow: /*?*term=

# Disallow the login flow and account pages (crawlers following them cost a PHP render each)
Disallow: /login
Disallow: /pages/login.php
Disallow: /logout
Disallow: /forgot-password
Disallow: /account
Disallow: /edit-account
Disallow: /signup

# Tag, person and company pages are indexed at their plain address; the parameter copies (?tag=, ?page=,
# ?region=, ?sort=) are thousands of near-duplicates. /login above already covers /login?redirect=...
Disallow: /tag/*?
Disallow: /person/*?
Disallow: /company/*?

# Disallow admin areas
Disallow: /admin/
Disallow: /admin-v2/
Disallow: /admanager/
Disallow: /temp/
Disallow: /dbconfig/
Disallow: /dbscripts/
Disallow: /cache/
Disallow: /cachemanager/
Disallow: /uploads/
Disallow: /scripts/
Disallow: /test/

# Disallow API endpoints that shouldn't be indexed
Disallow: /api/
Disallow: /webconfig/

# Disallow test files
Disallow: /test-*.php
Disallow: /test-*.html

# Disallow cache and temporary files
Disallow: /cache-manager.php
Disallow: /cache-manifest/

# Disallow sensitive configuration files
Disallow: /*.conf
Disallow: /*.ini
Disallow: /.htaccess
Disallow: /.git/

# Allow specific file types
Allow: /*.css$
Allow: /*.js$
Allow: /*.png$
Allow: /*.jpg$
Allow: /*.jpeg$
Allow: /*.gif$
Allow: /*.svg$
Allow: /*.ico$

# Crawl delay (optional - adjust based on server capacity)
Crawl-delay: 1

# Sitemap location (same canonical host family as public pages)
Sitemap: https://www.sacnilk.com/sitemap-index.xml
