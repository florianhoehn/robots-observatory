function bwwRestoreMobileAccountMenuPortal(accountLi) {
  var menu = document.querySelector('ul.bww-account-menu-portal');
  if (!menu || !accountLi) return;
  menu.classList.remove('bww-account-menu-portal');
  menu.removeAttribute('style');
  accountLi.appendChild(menu);
}
function bwwPositionMobileAccountMenu(accountLi) {
  if (window.innerWidth > 768 || !accountLi) return;
  var headerBottom = document.querySelector('.header-bottom.bww-site-header');
  if (!headerBottom || headerBottom.classList.contains('mobile-header-bottom')) return;
  var menu = accountLi.querySelector('.submenu.dropdown-menu, .dropdown-menu');
  if (!menu) return;
  if (!menu.classList.contains('bww-account-menu-portal')) {
    menu.classList.add('bww-account-menu-portal');
    document.body.appendChild(menu);
  }
  var top = Math.round(headerBottom.getBoundingClientRect().bottom);
  menu.style.position = 'fixed';
  menu.style.top = top + 'px';
  menu.style.right = '0px';
  menu.style.left = 'auto';
  menu.style.bottom = 'auto';
  menu.style.width = 'min(280px, 100vw)';
  menu.style.minWidth = '220px';
  menu.style.maxWidth = '100vw';
  menu.style.margin = '0';
  menu.style.transform = 'none';
  menu.style.inset = 'auto 0 auto auto';
  menu.style.zIndex = '10070';
}
function bwwResetMobileAccountMenu() {
  var accountLi = document.querySelector('.login-menu #account > li');
  if (!accountLi) return;
  accountLi.classList.remove('bww-account-open');
  var accountLink = accountLi.querySelector('a[data-bs-toggle="dropdown"]');
  if (accountLink) accountLink.setAttribute('aria-expanded', 'false');
  bwwRestoreMobileAccountMenuPortal(accountLi);
}
function bwwToggleMobileNav(e) {
  if (e) {
    e.preventDefault();
    e.stopPropagation();
  }
  var headerBottom = document.querySelector('.header-bottom');
  if (!headerBottom) return;
  var isOpen = headerBottom.classList.toggle('mobile-header-bottom');
  document.body.classList.toggle('bww-mobile-nav-open', isOpen);
  if (!isOpen) {
    bwwResetMobileAccountMenu();
    if (window.BWWJrNav && window.BWWJrNav.close) window.BWWJrNav.close();
    var openExplore = document.querySelector('.open-explore');
    if (openExplore) openExplore.classList.remove('show');
    if (window.BWWExploreNav && window.BWWExploreNav.reset) window.BWWExploreNav.reset();
    return;
  }
  bwwResetMobileAccountMenu();
  var openExplore = document.querySelector('.open-explore');
  if (openExplore) openExplore.classList.remove('show');
  if (window.BWWExploreNav && window.BWWExploreNav.reset) window.BWWExploreNav.reset();
  if (window.bwwLoadExploreShell) window.bwwLoadExploreShell();
}
function myFunction() { bwwToggleMobileNav(); }
document.addEventListener('click', function(e) {
  if (window.innerWidth > 768) return;
  var accountToggle = e.target.closest('.login-menu #account > li > a[data-bs-toggle="dropdown"]');
  if (accountToggle) {
    e.preventDefault();
    e.stopImmediatePropagation();
    var accountLi = accountToggle.closest('li');
    if (!accountLi) return;
    var willOpen = !accountLi.classList.contains('bww-account-open');
    bwwResetMobileAccountMenu();
    if (willOpen) {
      accountLi.classList.add('bww-account-open');
      accountToggle.setAttribute('aria-expanded', 'true');
      bwwPositionMobileAccountMenu(accountLi);
    }
    return;
  }
  if (!e.target.closest('.login-menu #account > li') && !e.target.closest('ul.bww-account-menu-portal')) {
    bwwResetMobileAccountMenu();
  }
}, true);
</script>



