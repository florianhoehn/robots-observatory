    background: var(--swatch--brand);
    border-radius: 100vw;
    width: .875rem;
    height: .875rem;
    opacity: 0;
    position: absolute;
    top: 0.5rem;
    left: -1.25rem;
    transition: .20s ease-in-out;
    transform: scale(.5) translateZ(0);
  }

  .nav_dropdown_link:hover::before {
    opacity: 1;
    transform: scale(1) translateZ(0);
  }

