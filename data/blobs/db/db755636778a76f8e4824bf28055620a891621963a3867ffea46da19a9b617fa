          'science-engineering': 'Science and engineering',
          'theology-islamic': 'Theology and Islamic Studies'
        };
        
        var currentURL = document.URL;
        currentURL = currentURL.split('/_')[0];
        
        var keyword = 'career-area/';
        var index =currentURL.indexOf(keyword);
        var siteURL = currentURL.replace(/^https?:\/\//, '');
        // siteURL = siteURL.split('?')[0];
        url = new URL(document.URL);
        siteURL = url.origin + url.pathname;
        siteURL = siteURL.split('/_')[0];
        if (index !== -1) {
            var lastPart = currentURL.substring(index + keyword.length);
            lastPart = lastPart.split('/')[0];
            lastPart = lastPart.split('?')[0];
            careerArea = careerAreas[lastPart] !== undefined ? careerAreas[lastPart] : lastPart;

