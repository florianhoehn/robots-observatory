                    "url": siteURL,
                    "isErrorPage": true,
                    "careerArea": careerArea,
                }
            };
        } else {
            var sections = frontend_asset_url_path.split("/").filter(section => section !== "");
            if (sections.length == 0) {
                sections[0] = "home";
            }
            
            var event_object = {
                "event": pageType,
                "page": {
                    "name": "study:" + sections.join(':'),
                    "url": siteURL,
                    "isErrorPage": false,
                    "siteSection1": "study",
                    "contentCategory": sections[0],
