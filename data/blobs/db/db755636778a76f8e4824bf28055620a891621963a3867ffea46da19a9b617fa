    function linkNameTraversal(element) {
        var linkName = "";
        var tempElement = element;
        var count = 0;


        if (mobileMenu) {
                while (!($(tempElement).parent().is('div.modal-body'))) {
                    tempElement = $(tempElement).parent();
                    if ($(tempElement).prop('nodeName') === 'LI') {
                        linkName = linkName + $(tempElement).children('a')[0].innerText + ":";
                    }
            }
        } else {
            while (($(tempElement).parent().prop('nodeName') !== 'NAV')) {
                tempElement = $(tempElement).parent();
                if ($(tempElement).prop('nodeName') === 'LI') {
                    linkName = linkName + $(tempElement).children('a')[0].innerText + ":";
                }
            }
        }
        linkName = linkName.substring(0, linkName.length - 1);
        linkName = linkName.split(":").reverse().join(":");
        mobileMenu = false;
        return linkName; 
    }


    
function createEventObject(pageType) {
        var careerArea = "";
