<script type="text/javascript">
    var frames = ["widget2", "miniYTWidget3", "widget4"]; 
 
    
    var players = [];
    var playerStarted = [];
    var eventCreated = [];
    var ytWatchTime = [];
    var ytWatchTimeInterval;

    function initYoutubeTracking() {
      console.log('youtube tracking initiated');
      var tag = document.createElement('script');
      tag.id = 'iframe-demo';
      tag.src = 'https://www.youtube.com/iframe_api';
      var firstScriptTag = document.getElementsByTagName('script')[0];
      firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
    }
    
    function onYouTubeIframeAPIReady() {
          console.log('onYouTubeIframeAPIReady');
          for (var i = 0; i < frames.length; i++) {
            (function (index) {
              players[index] = new YT.Player(frames[index], {
                events: {
                  'onStateChange': function (event) {
                    onPlayerStateChange(event, index);
                  }
                }
              });
              playerStarted[index] = false;
              eventCreated[index] = [false, false, false, false];
              ytWatchTime[index] = 0;
            })(i);
          }
    
    
    }
    
    function onPlayerStateChange(event, playerIndex) {
      var currentPlayer = players[playerIndex];
      var currentEventCreated = eventCreated[playerIndex];
      switch (currentPlayer.getPlayerState()) {
        case 0:
          clearInterval(ytWatchTimeInterval);
          ytWatchTime[playerIndex] = 0;
          break;
        case 1:
          ytWatchTimeInterval = setInterval(function() {
            updateWatchTime(playerIndex);
          }, 1000);
          if (!playerStarted[playerIndex]) {
            window.adobeDataLayer = window.adobeDataLayer || [];
            adobeDataLayer.push({
              "event": "videoStart",
              "video": {
                "name": currentPlayer.videoTitle,
              }
            });
            playerStarted[playerIndex] = true;
          }
          break;
        default:
          clearInterval(ytWatchTimeInterval);
      }
    }

    function updateWatchTime(playerIndex) {
      ytWatchTime[playerIndex]++;
      var currentPlayer = players[playerIndex];
      var currentEventCreated = eventCreated[playerIndex];
      var watchPercent = (currentPlayer.getCurrentTime() / currentPlayer.getDuration()) * 100;
    
      var milestones = [25, 50, 75, 95];
      for (var i = milestones.length - 1; i >= 0; i--) {
        if (watchPercent >= milestones[i] && !currentEventCreated[i]) {
          currentEventCreated[i] = true;
          var eventName = "videoMilestone" + milestones[i];
          if (milestones[i] === 95) {
            eventName = "videoComplete";
          }
          window.adobeDataLayer = window.adobeDataLayer || [];
          adobeDataLayer.push({
            "event": eventName,
            "video": {
              "name": currentPlayer.videoTitle,
            }
          });
        }
      }
    }

    initYoutubeTracking();
    onYouTubeIframeAPIReady();

</script>
