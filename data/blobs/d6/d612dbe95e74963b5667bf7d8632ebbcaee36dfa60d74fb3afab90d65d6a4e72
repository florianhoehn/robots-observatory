  const match = document.cookie.match(/(?:^|;\s*)hubspotutk=([^;]*)/);
  return match ? decodeURIComponent(match[1]) : null;
}
(function passHubSpotUtkToQualified() {
  const hubspotUtk = getHubSpotUTK();
  // If Hubspot UTK doesn't exist, do nothing
  if (!hubspotUtk || typeof window.qualified !== "function") {
    return;
  }
  // Pass Hubspot UTK to Qualified as a value
  window.qualified("identify", {
    hubspotutk: hubspotUtk
  });
})();

