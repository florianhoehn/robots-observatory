    <script>
		(function() {
			var container = document.querySelector('[data-search-id="search-form-6ad67d2460cf4"]');
			if (!container) return;
			
			var toggle = container.querySelector('.fivec-gps-search-toggle');
			var formWrapper = container.querySelector('.fivec-gps-search-form-reveal-wrapper');
			var input = container.querySelector('.fivec-gps-search-input');
			var form = container.querySelector('.fivec-gps-search-form');
			var closeButton = container.querySelector('.close-search-button');
			
			if (!toggle || !formWrapper || !input || !form) return;
			
			// Toggle form visibility
			toggle.addEventListener('click', function(e) {
				e.stopPropagation();
				var isExpanded = toggle.getAttribute('aria-expanded') === 'true';
				toggle.setAttribute('aria-expanded', !isExpanded);

				if(isExpanded) {
					formWrapper.classList.remove('reveal-search-active');
				} else {
					formWrapper.classList.add('reveal-search-active');
				}

				if(window.innerWidth > 1024) {
					document.body.style.overflow = isExpanded ? '' : 'hidden';
				}
				
				if (!isExpanded) {
					setTimeout(function() {
						input.focus();
					}, 100);
				}
			});
			
			// Close form when clicking outside
			formWrapper.addEventListener('click', function(e) {
				if (!e.target.closest('.fivec-gps-search-form-reveal')) {
					toggle.setAttribute('aria-expanded', 'false');
					formWrapper.classList.remove('reveal-search-active');
					document.body.style.overflow = '';
				}
			});

			closeButton.addEventListener('click', function(e) {
				toggle.setAttribute('aria-expanded', 'false');
				formWrapper.classList.remove('reveal-search-active');
				document.body.style.overflow = '';
			});
			
			// Prevent form from closing when clicking inside
			formWrapper.addEventListener('click', function(e) {
				e.stopPropagation();
			});
			
			// Prevent form redirect on Enter/submit - keep user on page with AJAX results
			form.addEventListener('submit', function(e) {
				e.preventDefault();
				var query = input.value.trim();
				if (!query) return false;
				// Trigger Relevanssi live search if not already showing (e.g. user pressed Enter quickly)
				if (typeof jQuery !== 'undefined' && jQuery(input).data('rlvlive')) {
					jQuery(input).trigger('keyup');
				}
				return false;
			});
		})();
	</script>       
