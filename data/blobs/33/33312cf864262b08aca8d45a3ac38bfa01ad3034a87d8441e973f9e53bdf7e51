<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <title>UNIL - Erreur 404</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
      html,
      body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: #f7f9fa;
        color: #222;
        font-family: system-ui, Verdana, Arial, Helvetica, sans-serif;
        min-height: 100vh;
      }
      .container {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2em 1em;
        box-sizing: border-box;
      }
      .logo {
        width: 190px;
        margin-bottom: 3.5em;
      }
      .mascot {
        width: 220px;
        max-width: 70vw;
        margin-bottom: 3.5em;
        display: block;
	image-rendering: pixelated;
      }
      .headline {
        font-size: 1.6em;
        font-weight: 700;
        color: #0037eb;
        margin: 0 0 0.7em 0;
        text-align: center;
      }
      .sections-row {
        display: flex;
        flex-direction: row;
        gap: 2em;
        justify-content: center;
        width: 100%;
        max-width: 800px;
        margin-bottom: 2em;
      }
      .section {
        width: 100%;
        max-width: 340px;
        text-align: center;
        margin-bottom: 0;
      }
      p {
        margin: 0.7em 0;
        font-size: 1.1em;
      }
      a {
        color: #0037eb;
        text-decoration: none;
        font-weight: 500;
      }
      a:hover {
        text-decoration: underline;
      }
      @media (max-width: 900px) {
        .sections-row {
          flex-direction: column;
          gap: 0;
          max-width: 98vw;
        }
        .section {
          margin-bottom: 2em;
          max-width: 98vw;
        }
      }
      @media (max-width: 600px) {
        .logo,
        .mascot {
          width: 120px;
        }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img
        class="logo"
        src="https://www2.unil.ch/static/unil-logo-black.svg"
        alt="UNIL - Université de Lausanne"
      />
      <img
        class="mascot"
        src="https://www2.unil.ch/static/error-404-mouton.png"
        alt="Mascotte UNIL - Mouton"
      />
      <div class="sections-row">
        <div class="section">
          <div class="headline">
            Désolé ! La page demandée n'est pas accessible
          </div>
          
          <p>
            • aller à la page d'accueil du site
            <a href="https://www.unil.ch">UNIL</a>
          </p>
        </div>
        <div class="section">
          <div class="headline">
            Sorry! The page you requested is not available
          </div>
          
          <p>
            • go to the home page of the site
            <a href="https://www.unil.ch">UNIL</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>


