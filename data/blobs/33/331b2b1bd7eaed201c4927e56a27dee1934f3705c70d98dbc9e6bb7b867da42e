<script>
    function extractHostnameFromOktaIssuer() {
        var hostname = window.location.hostname;
        var parts = hostname.split(".");

        if (["www", "new", "book"].includes(parts[0])) {
            parts[0] = "loyaltysso";
            return parts.join(".");
        }

        if (hostname.includes(".com")) {
            var lastPartIndex = parts.length - 2;
            var defaultDomain = `loyaltysso.qa..com`;
            return defaultDomain;
        } else {
            hostname = hostname || "bestwestern";
            return "loyaltysso.qa." + hostname + ".com";
        }
    }

    window.ddjskey = "98F265B4C60E01E1D49C55E665ED62";

    window.ddoptions = {
        ajaxListenerPath: [
            window.location.hostname,
            extractHostnameFromOktaIssuer()
        ],
        ajaxListenerPathExclusion: ["c.go-mpulse.net"],
        withCredentials: true,
        replayAfterChallenge: true
    };

    // Select DataDome tag domain based on brand
    var hostname = window.location.hostname;
    var ddTagDomain;

    if (hostname.includes("worldhotels")) {
        ddTagDomain = "dd.worldhotels.com";
    } else if (hostname.includes("bwhhotelgroup")) {
        // IBE
        ddTagDomain = "dd.bwhhotelgroup.com";
    } else {
        // Best Western (default)
        ddTagDomain = "dd.bestwestern.com";
    }

    var ddScript = document.createElement("script");
    ddScript.src = "https://" + ddTagDomain + "/tags.js";
    ddScript.async = true;
    document.head.appendChild(ddScript);
</script>

