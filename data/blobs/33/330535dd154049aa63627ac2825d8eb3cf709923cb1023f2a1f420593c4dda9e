<script>
    (function amplitudeOneTrustBootstrap() {
        var AMPLITUDE_KEY = window.isStaging
            ? "06a7d90fcb11e0c4de91acba2dfa39e9"
            : "1050a4fd3e4fd9cd51b69d3f053b4da0";

        var AMPLITUDE_EXPERIMENT_SRC =
            "https://cdn.amplitude.com/script/" +
            AMPLITUDE_KEY +
            ".experiment.js?integration=segment";
        var ANALYTICS_GROUP_IDS = ["2", "C0002"];

        var amplitudeLoaded = false;
        var currentConsentStatus = "pending";

        function getActiveGroups(event) {
            if (event && Array.isArray(event.detail)) {
                return event.detail.map(String);
            }

            if (event && typeof event.detail === "string") {
                return event.detail
                    .split(",")
                    .map(function (group) {
                        return group.trim();
                    })
                    .filter(Boolean);
            }

            return String(window.OnetrustActiveGroups || "")
                .split(",")
                .map(function (group) {
                    return group.trim();
                })
                .filter(Boolean);
        }

        function hasAnalyticsConsent(event) {
            var activeGroups = getActiveGroups(event);

            return ANALYTICS_GROUP_IDS.some(function (groupId) {
                return activeGroups.indexOf(groupId) !== -1;
            });
        }

        // The Amplitude Experiment script (loaded with ?integration=segment)
        // reads Segment's anonymousId to identify users. Our Segment source
        // middleware (registered in js-t.js, see $impression stitching) must
        // be in place before this script starts sending events, otherwise
        // the $impression event lands with Segment's own anonymous_id instead
        // of our attribution_user_id. js-t.js signals readiness via this flag
        // and event once trackingClient/Segment has initialized.
        function whenSegmentMiddlewareReady(callback, attemptsLeft) {
            // STAGING ONLY: skip the wait entirely.
            //
            // Testing whether the gate is needed at all. Measured on staging:
            // Amplitude loaded 3.9s before js-t registered the middleware and
            // the $impression event was STILL stitched to attribution_user_id,
            // because Amplitude (loaded with ?integration=segment) cannot send
            // anything until Segment is ready, and Segment becoming ready is
            // the same call that registers the middleware one statement later.
            // So the gate may be protecting against something that cannot
            // happen. Production keeps the gate until this is confirmed.
            if (window.isStaging) {
                callback();
                return;
            }

            if (typeof attemptsLeft === "undefined") {
                attemptsLeft = 40; // ~2s at 50ms intervals
            }

            if (
                window.__segmentImpressionMiddlewareRegistered ||
                attemptsLeft <= 0
            ) {
                callback();
                return;
            }

            setTimeout(function () {
                whenSegmentMiddlewareReady(callback, attemptsLeft - 1);
            }, 50);
        }

        function loadAmplitudeExperiment() {
            if (amplitudeLoaded) {
                return;
            }

            amplitudeLoaded = true;

            window.experimentConfig = window.experimentConfig || {};
            window.experimentConfig.consentOptions = {
                consentRequired: true,
                consentStatus: currentConsentStatus,
            };

            whenSegmentMiddlewareReady(function () {
                var script = document.createElement("script");
                script.src = AMPLITUDE_EXPERIMENT_SRC;
                script.async = false;
                script.onload = function () {
                    if (
                        window.webExperiment &&
                        typeof window.webExperiment.setConsentStatus ===
                            "function"
                    ) {
                        window.webExperiment.setConsentStatus(
                            currentConsentStatus,
                        );
                    }
                };
                script.onerror = function () {
                    amplitudeLoaded = false;
                };

                document.head.appendChild(script);
            });
        }

        function setAmplitudeConsentStatus(status) {
            currentConsentStatus = status;

            if (
                amplitudeLoaded &&
                window.webExperiment &&
                typeof window.webExperiment.setConsentStatus === "function"
            ) {
                window.webExperiment.setConsentStatus(status);
            }
        }

        function handleOneTrustGroupsUpdated(event) {
            if (hasAnalyticsConsent(event)) {
                setAmplitudeConsentStatus("granted");
                loadAmplitudeExperiment();
                return;
            }

            setAmplitudeConsentStatus("denied");
        }

        window.addEventListener(
            "OneTrustGroupsUpdated",
            handleOneTrustGroupsUpdated,
        );
    })();
</script>
