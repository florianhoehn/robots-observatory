<script>
 // 初始倒计时时间（5秒）
        let seconds = 5;
        const countdownElement = document.getElementById('countdown');

        // 首次渲染初始时间
        countdownElement.textContent = seconds;

        // 每秒执行一次倒计时逻辑
        const timer = setInterval(() => {
            seconds--;
            countdownElement.textContent = seconds;

            // 倒计时结束：清除定时器，提示完成
            if (seconds <= 0) {
                clearInterval(timer);
           window.open("/");
            }
        }, 1000); // 1000毫秒 = 1秒


</script>


