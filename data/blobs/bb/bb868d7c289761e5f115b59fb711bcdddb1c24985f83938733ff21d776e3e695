    <script>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('form.simple-form-ajax').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const form = e.target;
                    const method = (form.getAttribute('method') || 'GET').toUpperCase();
                    const action = form.action || window.location.href;
                    const formData = new FormData(form, e.submitter);
                    formData.append('ajax', 1);

                    let url = action;
                    let options = {
                        method,
                        headers: {}
                    };

                    if (method === 'GET') {
                        const params = new URLSearchParams(formData).toString();
                        url += (url.includes('?') ? '&' : '?') + params;
                    } else {
                        options.body = formData;
                    }

                    try {
                        var response = await fetch(url, options);
                        var result = await response.json(); // или .json()
                    } catch (err) {
                        ajax_toast('error', err, 15);
                        return;
                    }

                    if (result.error && "form" in result.error) {
                        console.error(result.error);
                        ajax_toast('error', result.error.form, 30);
                        return;
                    }

                    if (!response.ok) {
                        ajax_toast('error', "Неизвестная ошибка, попробуйте снова", 30);
                        return;
                    }

                    if ("toastOnSuccess" in form.dataset) {
                        ajax_toast('success', result.data.form);
                    }

                    if ("closeOnSuccess" in form.dataset) {
                        let target = document.getElementById(form.dataset.closeOnSuccess) || form;
                        target.remove();
                    }

                    if ("needReload" in result.data) {
                        window.location.reload();
                    }
                })
            })
        })
    </script>
