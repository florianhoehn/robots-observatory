<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Page not found (404)</title>
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="https://assets-production.datagrail.io/favicons/datagrail.ico">
    <link rel="preload" href="https://assets-production.datagrail.io/fonts/DMSans.ttf" as="font" type="font/ttf" crossorigin="anonymous">

    <style>
      @font-face {
        font-family: 'DM Sans';
        src: url('https://assets-production.datagrail.io/fonts/DMSans.ttf') format('truetype');
      }

      html {
        height: 100%;
      }

      body {
        margin: 0;
        padding: 0;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #F7F9F9;
        font-family: 'DM Sans', sans-serif;
      }

      .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 415px;
        color: #17191A;
        padding: 48px 80px;
        border-radius: 8px;
        border: 1px solid #D6D8D8;
        background-color: #FFFFFF;
      }

      .header {
        font-size: 24px;
        margin-top: 24px;
        line-height: 28px;
      }

      .description {
        font-size: 16px;
        margin-top: 16px;
        line-height: 20px;
        text-align: center;
      }

      @media screen and (max-width: 640px) {
        .container {
          margin: 24px;
          padding: 24px;
          font-size: 22px;
          line-height: 26px;
        }

        .description {
          font-size: 14px;
          line-height: 18px;
        }
      }

      @media screen and (max-width: 320px) {
        .container {
          margin: 16px;
          padding: 24px;
          min-width: 240px;
          font-size: 22px;
          line-height: 26px;
        }

        .description {
          font-size: 14px;
          line-height: 18px;
        }
      }
    </style>
  </head>

  <body>
    <div class="container">
      <img src="https://assets-production.datagrail.io/general_warning.svg" alt="Warning icon" />

      <div class="header">
        404
      </div>

      <div class="description">
        This page isn't available. It may have been deleted or the link might be broken.
      </div>
    </div>
  </body>
</html>
