<script>
  (function () {
    // Lower-cased platform string. userAgentData is preferred; navigator.platform
    // is deprecated but remains the only option in Firefox and Safari.
    function platformName() {
      return (
        navigator.userAgentData
          ? navigator.userAgentData.platform
          : navigator.platform || ""
      ).toLowerCase();
    }

    var os = platformName();
    var isWindows = os.indexOf("win") !== -1;

    /* WINDOWS-ONLY: expose the OS to CSS as data-os. CSS has no OS feature
       query, and some Windows-only box-model rounding artifacts in the
       shared-ui step-number badge can only be corrected from a stylesheet —
       see platform/ui.frontend/src/main/webpack/components/windows-alignment/.
       Set before first paint and independently of the font toggle, so the
       overrides apply on the first render rather than after the toggle
       resolves. Nothing is set on Mac, so those rules never match there. */
    if (isWindows) {
      document.documentElement.setAttribute("data-os", "windows");
    }

    /* rel=preload promoted on load keeps the font CSS off the critical path.
       The promotion re-fetches and fires load a second time, hence the rel
       guard. Pass preload=false for a stylesheet that should just apply. */
    function addStylesheet(href, preload) {
      var link = document.createElement("link");
      link.href = href;
      if (preload) {
        link.rel = "preload";
        link.as = "style";
        link.crossOrigin = "anonymous";
        link.onload = function () {
          if (this.rel === "preload") this.rel = "stylesheet";
        };
      } else {
        link.rel = "stylesheet";
      }
      document.head.appendChild(link);
    }

    var loaded = false;

    function loadFonts(useNewFonts) {
      /* First call wins. common.js invokes this again once the toggle request
         resolves, and a second pass would stack a different font set on top of
         the first — that is how pages ended up loading the DAM faces and
         Typekit's quasimoda together. */
      if (loaded) return;
      loaded = true;

      var domain = window.location.origin;

      if (useNewFonts) {
        // Unconditional: the family must never hang off an optional asset.
        addStylesheet(domain + "/content/dam/hal/fonts/fonts.css", true);

        /* WINDOWS-ONLY: HAL Body sits about 1px above its correct baseline on
           Windows; macOS is correct and is left alone. win-fonts.css repeats the
           same faces with ascent-override / descent-override / line-gap-override
           and is LAYERED ON TOP of fonts.css rather than swapped for it.

           Layering is the point. @font-face precedence follows document order, so
           the later file wins for the faces it redeclares — and when it is
           missing, unpublished, or answered with an AEM error page it simply
           contributes nothing and the font still resolves from fonts.css.

           Swapping could not offer that. It made the entire family depend on a
           DAM asset this repo neither ships nor controls, so while that asset was
           absent every Windows page lost HAL Body outright. An onerror guard did
           not help either: AEM answers a missing path with a redirect or a 200
           error page, so the load looks like a success. Keep the base font
           unconditional and let only the correction be able to fail. */
        if (isWindows) {
          addStylesheet(domain + "/content/dam/hal/fonts/win-fonts.css");
        }
      } else if (os.indexOf("mac") !== -1) {
        addStylesheet(domain + "/mac-fonts.css", true);
      } else if (isWindows) {
        addStylesheet(domain + "/win-fonts.css", true);
      } else {
        // Preconnect saves ~100-200ms of TLS handshake against the Typekit origin.
        var preconnect = document.createElement("link");
        preconnect.rel = "preconnect";
        preconnect.href = "https://use.typekit.net";
        preconnect.crossOrigin = "anonymous";
        document.head.appendChild(preconnect);
        addStylesheet("https://use.typekit.net/vnd1jbj.css", true);
      }

      document.documentElement.setAttribute(
        "data-hal-fonts",
        useNewFonts ? "new" : "original",
      );
    }

    /* There is deliberately no <noscript> fallback. One used to be assembled
       here with document.createElement("noscript"), which cannot work: if
       scripting is disabled this block never runs at all, and a DOM-created
       <noscript> has live children in a script-enabled document. So it only ever
       fired a second, duplicate request for the same stylesheet. */

    try {
      var cached = sessionStorage.getItem("featureToggleData");
      if (cached) {
        loadFonts(
          JSON.parse(cached)?.featuredToggle?.is2026FontsEnabled || false,
        );
      } else {
        /* Toggle not cached yet. loadFeatureToggles() in
           platform/ui.frontend/src/main/webpack/platform/common.js calls
           window.loadHalFonts once the request resolves. */
        document.documentElement.setAttribute("data-hal-fonts", "loading");
        window.halFontsNeedLoading = true;
      }
    } catch (e) {
      document.documentElement.setAttribute("data-hal-fonts", "loading");
      window.halFontsNeedLoading = true;
    }

    window.loadHalFonts = loadFonts;
  })();
</script>




  
    
