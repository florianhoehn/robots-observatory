<script>
(function () {
  var KOK = "https:\/\/webdramaturkey2.com\/public\/upload";

  var HOSTLAR = { "cdn.webdrama.io": 1, "cdn.k46.net": 1, "img.k46.net": 1 };

  var YEDEK_KONAK = "https://cdn.k46.net";

  function parcala(u) {
    try {
      var x = new URL(u, location.href);
      if (!HOSTLAR[x.hostname]) return null;
      var p = x.pathname.split("/").filter(Boolean);
      if (p.length < 2) return null;
      return { konak: x.hostname, yol: x.pathname, dizin: p[p.length - 2], dosya: p[p.length - 1] };
    } catch (e) { return null; }
  }

  function adaylar(u) {
    var b = parcala(u);
    if (!b) return [];
    var liste = [];
    if (b.konak !== "cdn.k46.net") { liste.push(YEDEK_KONAK + b.yol); }
    liste.push(KOK + "/" + b.dizin + "/" + b.dosya);
    if (b.dizin === "actor") { liste.push("https://i.mydramalist.com/" + b.dosya); }
    return liste;
  }

  function dene(liste, i, tamam) {
    if (i >= liste.length) { tamam(null); return; }
    var im = new Image();
    im.onload = function () { tamam(liste[i]); };
    im.onerror = function () { dene(liste, i + 1, tamam); };
    im.src = liste[i];
  }

  window.cdnYerel = function (u) {
    var b = parcala(u);
    return b ? KOK + "/" + b.dizin + "/" + b.dosya : null;
  };

  window.cdnYedek = function (kaynak, tamam) {
    var liste = adaylar(kaynak);
    if (!liste.length) { tamam(null); return; }
    dene(liste, 0, tamam);
  };

  var MEDYA_ETIKET = { IMG: 1, VIDEO: 1, AUDIO: 1, SOURCE: 1 };

  document.addEventListener("error", function (e) {
    var el = e.target;
    if (!el || !MEDYA_ETIKET[el.tagName]) return;

    var asil = el.dataset.cdnAsil || el.currentSrc || el.src;
    var liste = adaylar(asil);
    if (!liste.length) return;
    el.dataset.cdnAsil = asil;

    var adim = parseInt(el.dataset.cdnAdim || "0", 10);
    if (adim >= liste.length) return;
    el.dataset.cdnAdim = String(adim + 1);

    e.stopImmediatePropagation();
    if (el.srcset) el.srcset = "";
    el.src = liste[adim];

    var ana = (el.tagName === "SOURCE") ? el.parentNode : el;
    if (ana && typeof ana.load === "function") { ana.load(); }
  }, true);
})();
</script>
