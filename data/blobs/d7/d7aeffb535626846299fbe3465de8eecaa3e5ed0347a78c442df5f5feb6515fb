    (function () {
        try {
            const state = window.globalState;
            if (!state?.user?.is_logged_in) return;

            const localTheme = window.localStorage?.getItem("theme");
            const cookieTheme = document.cookie
                .split("; ")
                .find((row) => row.startsWith("theme="))
                ?.split("=")[1];
            const rawPreference = localTheme || cookieTheme || "light";
            const preference = ["light", "dark", "system"].includes(
                rawPreference
            )
                ? rawPreference
                : "light";
            const prefersDark =
                window.matchMedia &&
                window.matchMedia("(prefers-color-scheme: dark)").matches;
            const active =
                preference === "dark" ||
                (preference === "system" && prefersDark)
                    ? "dark"
                    : "light";

            const root = document.documentElement;
            root.setAttribute("data-theme", preference);
            root.classList.remove("light", "dark", "system");
            root.classList.add(active);
        } catch (error) {
            // Fail closed: leave the default theme to avoid breaking page load.
        }
    })();
