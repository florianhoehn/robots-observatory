html,
body {
   margin: 0;
   padding: 0;
   text-rendering: optimizeSpeed;
   position: relative;
   /* Mirror Tailwind's --font-sans (the font the loaded `:where(body)` rule
      applies). This block is inlined and paints before the Tailwind CSS loads,
      so we can't reference the variable here; keep this literal in sync with it.
      The previous -apple-system stack named no Linux system font, so on Linux
      first paint diverged from the loaded font and visibly swapped once this
      placeholder header was removed at hydration. See #62134. */
   font-family: ui-sans-serif, system-ui, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';
}

.header-wrapper {
   position: relative;
   display: flex;
   justify-content: center;
   height: 68px;
   background: #11161A;
   box-shadow: 0 1px 2px rgba(17, 22, 26, 0.1), 0 4px 8px rgba(17, 22, 26, 0.1);
   z-index: 100;
}

.header-container {
   position: relative;
   display: flex;
   align-items: center;
   height: 100%;
   width: 1400px;
   max-width: 100%;
   margin-inline: auto;
   padding-inline: 12px;
}

.mobile-menu-icon-slot {
   display: none;
}

.logo-container {
   display: flex;
   height: 36px;
   margin-inline: 16px;
}

.logo-container a {
   display: flex;
}

.headings-container {
   position: relative;
   display: flex;
   align-items: stretch;
   height: 100%;
   margin-right: 16px;
   color: white;
   text-align: left;
}

.headings-container .heading-item {
   display: flex;
   align-items: stretch;
   max-width: 236px;
}

.headings-container .heading {
   align-items: center;
   display: flex;
   padding-inline: 24px;
   color: white;
   font-size: 14px;
   font-weight: 600;
   text-decoration: none;
   white-space: nowrap;
   margin: 0;
}

.headings-container .heading-item:hover > .heading,
.headings-container .heading-item:focus-within > .heading {
   background: #1f2937;
   text-decoration: none;
}

.headings-container .heading-menu {
   position: absolute;
   display: none;
   left: 0;
   top: 100%;
   z-index: 1;
   background: #1f2937;
   box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
}

.headings-container .heading-item:hover > .heading-menu,
.headings-container .heading-item:focus-within > .heading-menu {
   display: flex;
}

.headings-container .menu-item {
   position: relative;
   display: flex;
   flex-direction: column;
   justify-content: space-between;
   width: 222px;
   max-width: 17vw;
   padding: 24px;
   color: white;
   text-decoration: none;
   transition: all 0.2s ease;
}

.headings-container .menu-item:hover {
   background: #0071CE;
   box-shadow: 0 24px 0 0 #0071CE;
   text-decoration: none;
}

.headings-container .menu-item-title {
   color: white;
   margin: 0;
   font-size: 16px;
   font-weight: 600;
}

.headings-container .menu-item-divider {
   height: 4px;
   margin: 16px 0;
   background: #4b5563;
   border-radius: 2px;
   opacity: 0.6;
   transition: background 0.2s ease;
}

.headings-container .menu-item:hover .menu-item-divider {
   background: white;
}

.headings-container .menu-item-description {
   color: #9ca3af;
   margin: 0;
   font-size: 14px;
   font-weight: 500;
   line-height: 1.42857;
   transition: color 0.2s ease;
}

.headings-container .menu-item:hover .menu-item-description {
   color: white;
}

.headings-container .menu-item-arrow {
   margin: 0 auto;
   color: white;
   opacity: 0;
   position: absolute;
   left: calc(50% - 12px);
   bottom: 0;
   width: 24px;
   height: 24px;
   transition: all 0.2s ease;
}

.headings-container .menu-item:hover .menu-item-arrow {
   opacity: 1;
   bottom: -12px;
}

/* Style HeaderInteractive component directly */
[data-name="HeaderInteractive"],
.header-right-actions {
   display: flex;
   align-items: center;
   gap: 12px;
   flex: 1;
   justify-content: flex-end;
}

.header-right-actions button {
   display: flex;
   place-items: center;
}

/* Phones: tighten the action row so its four 40px icons never overflow. */
@media only screen and (max-width: 374px) {
   .header-container {
      padding-inline: 8px;
   }

   .logo-container {
      margin-inline: -4px;
      transform: scale(0.8);
   }

   [data-name="HeaderInteractive"] {
      gap: 0;
   }

   .header-right-actions {
      gap: 8px;
   }
}

@media only screen and (max-width: 1027px) {
   .headings-container {
      display: none;
   }

   .mobile-menu-icon-slot {
      display: flex;
      flex-shrink: 0;
      min-width: 36px;
   }
}

@media only screen and (min-width: 1440px) {
   .header-container {
      padding: 0;
   }
}
