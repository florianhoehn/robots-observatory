    document.querySelectorAll('form:has(hr-captcha)').forEach((form) => {
        let captcha = form.querySelector('hr-captcha');
        let input = form.querySelector('input[name="captcha"]');
        let submitButton = form.querySelector('button');

        const span = document.createElement('span');
        span.append(document.createElement('strong'));
        span.querySelector('strong').textContent = "Unable to load captcha component. Please ensure you are using a supported up-to-date browser or refresh to try again."

        captcha.append(span);

        customElements.whenDefined('hr-captcha').then(() => {
            span.remove();
        })

        form.addEventListener('submit', (event) => {
            event.preventDefault();
            submitButton.disabled = true;

            customElements.whenDefined('hr-captcha').then(async () => {
                let valid = await captcha.validateInput();
                if (!valid) {
                    submitButton.disabled = false;
                    console.log("Captcha validation error")
                    return;
                }

                input.value = captcha.value;
                form.submit();
            })

            return false;
        })
    });
</script>
