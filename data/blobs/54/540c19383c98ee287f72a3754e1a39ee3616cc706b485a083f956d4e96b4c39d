      gap: 0.4rem;
      min-width: 11.8rem;
      height: 3.2rem;
      padding: 0 0.8rem;
      font-size: 1.4rem;
      font-weight: 600;
      color: #5B5FC7;
      border: 1px solid #b4d6fa;
      border-radius: 1.6rem;
      background-color: #ebf3fc;
    }

    .gather-paid-badge img {
      width: 1.6rem;
      height: 1.6rem;
    }

    .gather-bento-grid__item > .gather-paid-badge {
      display: none;
    }

    .gather-bento-grid__item-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .gather-bento-grid__item-header .gather-paid-badge {
      margin-left: auto;
    }

    .gather-bento-grid__item h3 + p {
      margin-top: -2rem;
    }

    .gather-bento-grid__item:has(.gather-bento-image):hover {
      box-shadow: 1px 1px 3rem 0 rgba(211, 205, 255, 0.4);
      position: relative;
      z-index: 1;
    }

    .gather-bento-grid__item:hover .gather-bento-image {
      transform: scale(1.05);
    }

    .gather-bento-grid__item p:has(.gather-bento-image) {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .gather-bento-grid__item--align-bottom p:has(.gather-bento-image) {
      align-items: end;
    }

    /*
    =======================================
    Mobile bento: horizontal row (394-699px)
    =======================================
    */
    @media (max-width: 699px) {
      .gather-entry-source-default .gather-bento-grid__item,
      .gather-entry-source-skype .gather-bento-grid__item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 1.2rem;
        align-items: center;
        padding: 1.6rem;
        min-height: auto;
      }

      .gather-entry-source-default .gather-bento-grid__item-header,
      .gather-entry-source-skype .gather-bento-grid__item-header {
        grid-column: 1;
        grid-row: 1;
      }

      /* Hide desktop badge in header at mobile */
      .gather-entry-source-default .gather-bento-grid__item-header .gather-paid-badge,
      .gather-entry-source-skype .gather-bento-grid__item-header .gather-paid-badge {
        display: none;
      }

      .gather-entry-source-default .gather-icon-with-heading__text,
      .gather-entry-source-skype .gather-icon-with-heading__text {
        grid-column: 2;
        grid-row: 1;
      }

      /* Show mobile badge (direct child of item) */
      .gather-entry-source-default .gather-bento-grid__item > .gather-paid-badge,
      .gather-entry-source-skype .gather-bento-grid__item > .gather-paid-badge {
        display: inline-flex;
        grid-column: 3;
        grid-row: 1;
      }

      .gather-entry-source-default .gather-icon-circle,
      .gather-entry-source-skype .gather-icon-circle {
        width: 48px;
        height: 48px;
      }

      .gather-entry-source-default .gather-icon-circle img,
      .gather-entry-source-skype .gather-icon-circle img {
        width: 24px;
        height: 24px;
      }
    }

    /*
    ==========================================
    Compact mobile bento: stacked (<=393px)
    ==========================================
    */
    @media (max-width: 393px) {
      .gather-entry-source-default .gather-bento-grid__item,
      .gather-entry-source-skype .gather-bento-grid__item {
        grid-template-columns: auto 1fr;
      }

      /* Badge wraps below text in column 2 */
      .gather-entry-source-default .gather-bento-grid__item > .gather-paid-badge,
      .gather-entry-source-skype .gather-bento-grid__item > .gather-paid-badge {
        grid-column: 2;
        grid-row: 2;
        justify-self: start;
      }
    }

    /*
    ======
    Icons.
    ======
    */

    .gather-icon-circle {
      background-color: #f6f6f6;
      border-color: transparent;
      border-radius: 50%;
      border-style: solid;
      border-width: 1px;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 64px;
      height: 64px;
    }

    .gather-icon-circle--light {
      background-color: #fff;
      border-color: #d1d1d1;
    }

    .gather-icon-circle > svg {
      width: 32px;
      height: 32px;
    }

    /*
    ==================
    Icon with heading.
    ==================
    */

    .gather-icon-with-heading {
      display: grid;
      align-items: center;
      gap: 2rem;
    }

    .gather-icon-with-heading small {
      display: block;
      font-weight: normal;
    }

    .gather-bento-grid__item--large .gather-icon-with-heading {
      grid-template-columns: auto 1fr;
    }

    @media (max-width: 699.9px) {
      .gather-icon-with-heading {
        grid-template-columns: auto 1fr;
      }
    }
    
    /*
    =======
    Images.
    =======
    */

    .gather-bento-image {
      display: block;
      width: 80%;
      height: auto;
      transition-duration: 0.4s;
      transition-property: transform;
    }

    /*
    ========
    Buttons.
    ========
    */

    .gather-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;

      color: #000;
      background-color: #fff;

      border-color: #d1d1d1;
      border-radius: 999px;
      border-style: solid;
      border-width: 1px;

      font-weight: 600;
      text-align: start;
      text-decoration: none;

      padding-top: 0.75rem;
      padding-left: 1.75rem;
      padding-right: 1.75rem;
      padding-bottom: 0.75rem;

      transition-duration: 0.25s;
      transition-property: color, background-color, border-color;
    }

    .gather-button:hover {
      background-color: #f5f5f5;
      border-color: #c7c7c7;
    }

    .gather-button--small {
      font-size: 1.75rem;
      padding-top: 0.25rem;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
      padding-bottom: 0.25rem;
    }

    .gather-button--large {
      gap: 1rem;
      line-height: 3.5rem;
      padding-top: 2rem;
      padding-left: 2.5rem;
      padding-right: 2.5rem;
      padding-bottom: 2rem;
    }

    .gather-button--primary {
      color: #fff;
      background-color: #5b5fc7;
      border-color: transparent;
    }

    .gather-button--primary:hover {
      background-color: #4f52b2;
    }

    .gather-button--secondary {
      color: #5b5fc7;
    }

    .gather-button--wide {
      text-align: center;
      width: 100%;
    }

    .gather-button--plain {
      background-color: transparent;
      border-color: transparent;
      color: #424242;
    }

    .gather-button--plain:hover {
      border-color: transparent;
    }

    /*
    =============
    Button group.
    =============
    */

    .gather-button-group {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    @media (min-width: 700px) {
      .gather-button-group {
        align-self: flex-start;
        justify-content: flex-start;
      }
    }
         .gather-button-group > span > .gather-button {
      width: 100%;
    }

    @media (min-width: 700px) {
      .gather-button-group {
        flex-direction: row;
      }
    }

    /*
    ===========
    Focus trap.
    ===========
    */

    .gather-focus-trap {
      opacity: 0;
      overflow: hidden;
      width: 0;
      height: 0;
      position: fixed;
      top: 0;
      left: 0;
    }

    /*
    ======
    Input.
    ======
    */

    .gather-input-label {
      display: inline-block;
      margin-bottom: 0.5rem;
    }

    .gather-input-label__required {
      text-decoration: none;
    }

    .gather-input-wrap {
      display: block;
      position: relative;
    }

    .gather-input-wrap:after {
      content: "";
      border-bottom-color: #5b5fc7;
      border-bottom-style: solid;
      border-bottom-width: 2px;

      border-bottom-left-radius: 4px;
      border-bottom-right-radius: 4px;

      height: 4px;
      transition-duration: 0.05s;
      transition-property: transform;
      transform: scaleX(0);

      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
    }

    .gather-input-wrap:focus-within:after {
      transform: scaleX(1);
    }

    .gather-input {
      appearance: none;
      background-color: #fff;

      display: block;
      outline: 0;

      border-color: #d1d1d1;
      border-bottom-color: #767676;

      border-radius: 0.5rem;
      border-style: solid;
      border-width: 1px;

      padding-top: 0.625rem;
      padding-left: 1rem;
      padding-right: 1rem;
      padding-bottom: 0.875rem;
      width: 100%;
    }

    .gather-input::placeholder {
      color: #707070;
    }

    /*
    ======================
    Media query hide/show.
    ======================
    */

    @media (max-width: 699.9px) {
      .gather-hide-when-media-mobile {
        display: none !important;
      }
    }

    @media (min-width: 700px) {
      .gather-hide-when-media-desktop {
        display: none !important;
      }
    }

