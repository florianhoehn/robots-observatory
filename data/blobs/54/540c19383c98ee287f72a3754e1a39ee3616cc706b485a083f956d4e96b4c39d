    ==========
    Variables.
    ==========
    */

    :root {
      --gather-layout-inner-max-width: 2000px;
      --gather-layout-header-height: 6rem;
    }

    /*
    ========
    Globals.
    ========
    */

    *,
    *:after,
    *:before {
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      border: 0;
      box-sizing: border-box;
      font-size: inherit;
      font-family: inherit;
      line-height: inherit;
      outline-offset: 2px;
      text-wrap: pretty;
      margin: 0;
      padding: 0;
    }

    html {
      cursor: default;
      font-size: 8px;
      overflow-x: hidden;
      overflow-y: auto;
    }

    body {
      color: #242424;
      background-color: #fff;

      font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Helvetica", "Arial", sans-serif;
      font-size: 2rem;
      line-height: 1.4;
      overflow-x: hidden;
    }

    h1 {
      font-size: 4rem;
      font-style: normal;
      font-weight: 600;
      line-height: 1.25;
    }

    h2 {
      font-size: 2.5rem;
      font-weight: 600;
    }

    button {
      appearance: none;
      background-color: transparent;
      cursor: pointer;
    }

    code {
      font-family: monospace;
    }

    /*
    =======
    Hidden.
    =======
    */

    [hidden] {
      display: none !important;
    }

    /*
    ==============
    Generic links.
    ==============
    */

    a:not([class]) {
      color: #5b5fc7;
      text-decoration: none;
    }

    a:not([class]):hover,
    a:not([class]):focus-visible {
      text-decoration: underline;
    }

    /*
    ======
    Modal.
    ======
    */

    .gather-modal {
      background-color: #fff;
      border-color: #ddd;
      border-radius: 1rem;
      border-style: solid;
      border-width: 1px;
      box-shadow: 0 0 2rem 0 rgba(0, 0, 0, 0.25);
      padding-top: 3rem;
      padding-left: 3rem;
      padding-right: 3rem;
      padding-bottom: 3rem;

      margin: auto;
      width: 400px;
      max-width: calc(100% - 4rem);
      max-height: calc(100% - 4rem);
      overflow-y: auto;
    }

    .gather-modal::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
      transition-duration: 0.25s;
      transition-property: background-color;
      position: fixed;
      width: 100%;
      height: 100lvh;
    }

    /* Add `anchor` if supported. */
    @supports (position-anchor: --var) {
      @media (min-width: 700px) {
        .gather-modal[style*="position-anchor"] {
          inset: unset;
          margin: 0;

          position: absolute;
          top: calc(anchor(bottom) + 1rem);
          left: anchor(left);
        }
      }
    }

    .gather-modal__form {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: auto 1fr;
      gap: 2rem;
    }

    .gather-modal__title {
      grid-column-start: 1;
      grid-column-end: 2;

      grid-row-start: 1;
      grid-row-end: 1;
    }

    .gather-modal__close {
      border-radius: 50%;
      line-height: 1;
      width: 3rem;
      height: 3rem;
      overflow: hidden;
      position: relative;
    }

    .gather-modal__close:after,
    .gather-modal__close:before {
      content: "";
      background-color: #000;
      border-radius: 2px;
      width: 1px;
      height: 80%;

      position: absolute;
      top: 50%;
      left: 50%;
    }

    .gather-modal__close:before {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    .gather-modal__close:after {
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .gather-modal__close:hover:before,
    .gather-modal__close:hover:after {
      background-color: #5b5fc7;
      width: 2px;
    }

    @media (forced-colors: active) {
      .gather-modal__close:after,
      .gather-modal__close:before {
        background-color: ButtonText;
        forced-color-adjust: none;
      }

      .gather-modal__close:hover:before,
      .gather-modal__close:hover:after {
        background-color: Highlight;
      }
    }

    .gather-modal__content {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      grid-column-start: 1;
      grid-column-end: 3;

      grid-row-start: 2;
      grid-row-end: 2;
    }

    .gather-modal__content:has(input:invalid) .gather-button {
      color: #bdbdbd;
      background-color: #f0f0f0;
    }

    /*
    =======
    Layout.
    =======
    */

    .gather-layout {
      background-image: linear-gradient(
        to bottom right,
        #fef,
        #fff,
        #fef
      );
      display: flex;
      flex-direction: column;
      min-height: 100dvh;
    }

    /*
    ===============
    Layout: header.
    ===============
    */

    .gather-layout__header {
      -webkit-backdrop-filter: blur(60px);
      backdrop-filter: blur(60px);
      background-color: rgba(255, 255, 255, 0.25);

      padding-left: 2rem;
      padding-right: 2rem;
      width: 100%;

      z-index: 2;
      position: fixed;
      top: 0;
      left: 0;
    }

    .gather-layout__header__inner {
      transform: translateZ(0);
    }

    @media (min-width: 1050px) {
      .gather-layout__header {
        padding-left: 4rem;
        padding-right: 4rem;
      }
    }

    .gather-layout__header__inner {
      display: flex;
      align-items: center;
      gap: 1rem;

      margin-left: auto;
      margin-right: auto;

      max-width: var(--gather-layout-inner-max-width);
      height: var(--gather-layout-header-height);
      width: 100%;
    }

    .gather-layout__header[data-is-scrolled="false"] [data-show-when-scrolled="true"] {
      /* Hide when not scrolled. */
      display: none;
    }

    @media (max-width: 699.9px) {
      .gather-layout__header[data-is-scrolled="true"] [data-show-when-scrolled="false"] {
        /* Hide when scrolled. */
        display: none;
      }
    }

    .gather-layout__header__title {
      display: flex;
      align-items: center;
      gap: 1rem;

      font-size: 1.75rem;
      font-weight: 620;
      line-height: 2.75rem;
      margin-right: auto;

      color: inherit;
      text-decoration: none;
    }

    @media (min-width: 700px) {
      .gather-layout__header__title {
        margin-left: 6rem;
      }
    }

    @media (min-width: 1050px) {
      .gather-layout__header__title {
        margin-left: 4rem;
      }
    }

    .gather-layout__header__title__image {
      width: 3rem;
      height: 3rem;
    }

    /*
    =============
    Layout: main.
    =============
    */

    .gather-layout__main {
      padding-left: 2rem;
      padding-right: 2rem;
    }

    @media (min-width: 1050px) {
      .gather-layout__main {
        padding-left: 4rem;
        padding-right: 4rem;
      }
    }

    .gather-layout__main__inner {
      display: flex;
      flex-direction: column;
      gap: 6rem;

      margin-left: auto;
      margin-right: auto;
      max-width: var(--gather-layout-inner-max-width);
      width: 100%;
    }

    /*
    ===============
    Layout: footer.
    ===============
    */

    .gather-layout__footer {
      display: flex;
      flex-direction: column;
      gap: 3rem;

      font-size: 1.75rem;
      font-weight: 400;

      padding-top: 8rem;
      padding-left: 2rem;
      padding-right: 2rem;
      padding-bottom: 2rem;
    }

    .gather-layout__footer__top {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }

    .gather-layout__footer__bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }

    @media (min-width: 1024px) {
      .gather-layout__footer__bottom {
        column-gap: 8rem;
        justify-content: center;
      }
    }

    .gather-layout__footer__bottom a {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      color: inherit;
    }

    /*
    ==========
    Hero grid.
    ==========
    */

    .gather-hero {
      margin-left: -2rem;
      margin-right: -2rem;
      position: relative;
    }

    .gather-hero__media {
      margin-bottom: 2rem;
      position: relative;
    }

    .gather-hero__media__inner {
      background-color: #d0d1e0;
      height: 300px;
      overflow: hidden;
    }

    .gather-hero__media__inner:after {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
    }

    .gather-hero__media__inner__video {
      object-fit: cover;
      width: 100%;
      height: 100%;
    }

    .gather-hero__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4rem;
      padding-left: 2rem;
      padding-right: 2rem;
    }

    @media (max-width: 699.9px) {
      .gather-hero__content {
        margin-left: 20px;
        margin-right: 20px;
      }
    }

    .gather-hero__content__text {
      display: flex;
      flex-direction: column;
      align-self: start;
      gap: 1rem;
    }

    .gather-hero__content__text p {
      font-size: 3rem;
      font-weight: 300;
      line-height: normal;
    }

    @media (min-width: 700px) {
      .gather-hero__media {
        margin-bottom: 0;
      }

      .gather-hero__media__inner {
        height: 630px;
      }

      .gather-hero__media__inner__video {
        object-position: 50% 45%;
        transform: translateX(-38%);
        width: 160%;

        position: relative;
        left: 50%;
      }

      .gather-hero__content {
        align-items: flex-start;
        padding-top: var(--gather-layout-header-height);
        padding-left: 8rem;
        padding-right: 0;

        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
      }
    }

    @media (min-width: 700px) and (max-width: 1049.9px) {
      .gather-hero__content__text {
        background-image: linear-gradient(
          to right,
          rgba(215, 216, 229, 0.8),
          #D7D8E5
        );

        border-radius: 1rem;
        padding-top: 2rem;
        padding-left: 3rem;
        padding-right: 3rem;
        padding-bottom: 2rem;
        max-width: 425px;
      }
    }

    @media (min-width: 1050px) {
      .gather-hero {
        margin-left: -4rem;
        margin-right: -4rem;
      }

      .gather-hero__content__text {
        max-width: 45%;
      }

      .gather-hero__content__text h1,
      .gather-hero__content__text p {
        text-wrap: balance;
      }
    }

    @media (min-width: 2000px) {
      .gather-hero__media__inner {
        border-bottom-left-radius: 2rem;
        border-bottom-right-radius: 2rem;
      }
    }

    /*
    =============================
    Hero grid: play/pause button.
    =============================
    */

    .gather-video-button {
      /* Hide. */
      display: none;
      align-items: center;
      justify-content: center;

      background-color: #fff;
      border-color: #d1d1d1;
      border-radius: 50%;
      border-style: solid;
      border-width: 2px;

      width: 6rem;
      height: 6rem;

      transition-duration: 0.25s;
      transition-property: filter;

      z-index: 1;
      position: absolute;
      bottom: 2rem;
      right: 2rem;
    }

    .gather-video-button:hover {
      background-color: #f5f5f5;
    }

    @media (min-width: 700px) {
      .gather-video-button {
        bottom: 4rem;
        right: 4rem;
      }
    }

    .gather-hero:has(video[data-is-loaded="true"]) .gather-video-button {
      /* Show. */
      display: flex;
    }

    .gather-hero:has(video[data-is-playing="true"]) .gather-video-button__play,
    .gather-hero:has(video[data-is-playing="false"]) .gather-video-button__pause {
      /*
        - Hide "play" when playing.

        - Hide "pause" when paused.
      */
      display: none;
    }

    /*
    ===========
    Bento grid.
    ===========
    */

    .gather-bento-grid {
      display: grid;
      gap: 2rem;
      font-size: 2.5rem;
      font-weight: 350;
    }

    @media (min-width: 700px) {
      .gather-bento-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (min-width: 1024px) {
      .gather-bento-grid {
        grid-template-columns: repeat(4, 1fr);
      }
    }

    .gather-bento-grid__item {
      display: flex;
      flex-direction: column;
      gap: 2rem;

      background-color: #fff;
      background-position: center bottom;
      background-size: cover;

      border-color: #f0f0f0;
      border-radius: 2rem;
      border-style: solid;
      border-width: 1px;

      padding-top: 4rem;
      padding-left: 4rem;
      padding-right: 4rem;
      padding-bottom: 4rem;

      overflow: hidden;
      transition-duration: 0.25s;
      transition-property: border-color, box-shadow;
    }

    .gather-icon-with-heading__text {
      display: flex;
      flex-direction: column;
    }

    @media (max-width: 699.9px) {
      .gather-bento-grid__item--align-bottom {
        background-image: none !important;
      }
    }

    @media (min-width: 700px) {
      .gather-bento-grid__item--align-bottom {
        padding-bottom: 0;
      }
    }

    @media (max-width: 699.9px) {
      .skype-redirect-bento-grid__item--align-bottom {
        background-image: none !important;
      }
    }

    @media (min-width: 1024px) {
      .gather-bento-grid__item--large {
        grid-column: span 2;
      }
    }

    /* Default + Skype bento: responsive grid (3 → 2 → 1 columns) */
    .gather-entry-source-default,
    .gather-entry-source-skype,
    .gather-whats-new-section {
      margin-left: 2rem;
      margin-right: 2rem;
    }

    @media (min-width: 700px) {
      .gather-entry-source-default,
      .gather-entry-source-skype,
      .gather-whats-new-section {
        margin-left: 4%;
        margin-right: 4%;
      }
    }

    @media (min-width: 1024px) {
      .gather-entry-source-default,
      .gather-entry-source-skype,
      .gather-whats-new-section {
        margin-left: 7%;
        margin-right: 7%;
      }
    }

    .gather-entry-source-default,
    .gather-entry-source-skype {
      grid-template-columns: 1fr;
    }

    @media (min-width: 700px) {
      .gather-entry-source-default,
      .gather-entry-source-skype {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (min-width: 1024px) {
      .gather-entry-source-default,
      .gather-entry-source-skype {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .gather-entry-source-default .gather-bento-grid__item,
    .gather-entry-source-skype .gather-bento-grid__item {
      gap: 1.6rem;
      padding: 2.4rem;
    }

    @media (min-width: 700px) {
      .gather-entry-source-default .gather-bento-grid__item,
      .gather-entry-source-skype .gather-bento-grid__item {
        min-height: 39.2rem;
      }
    }

    .gather-entry-source-default .gather-bento-grid__item p:has(.gather-bento-image),
    .gather-entry-source-skype .gather-bento-grid__item p:has(.gather-bento-image) {
