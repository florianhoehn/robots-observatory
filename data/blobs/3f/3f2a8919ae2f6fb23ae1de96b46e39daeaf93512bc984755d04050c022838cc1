<script>
    // ── Auto-set copyright year ──
    document.getElementById('year').textContent = new Date().getFullYear();

    const titles = {
        en: 'This page no longer exists',
        de: 'Diese Seite existiert nicht mehr'
    };

    const links = {
        en: {
            home: 'https://www.netcetera.com/',
            contact: 'https://www.netcetera.com/contact-us',
            legal: 'https://www.netcetera.com/legal-information',
            privacy: 'https://www.netcetera.com/privacy-policies'
        },
        de: {
            home: 'https://www.netcetera.com/de/',
            contact: 'https://www.netcetera.com/de/contact-us',
            legal: 'https://www.netcetera.com/de/legal-information',
            privacy: 'https://www.netcetera.com/de/privacy-policies'
        }
    };

    // ── Language switcher ──
    function setLang(lang) {
        const nextLang = lang === 'en' ? 'de' : 'en';

        // Show/hide all translated nodes
        document.querySelectorAll('[data-lang]').forEach(el => {
            if (el.dataset.lang === lang) {
                el.hidden = false;
            } else {
                el.hidden = true;
            }
        });

        // Update links for the current language
        document.querySelectorAll('[data-link]').forEach(el => {
            const key = el.dataset.link;
            if (links[lang] && links[lang][key]) {
                el.href = links[lang][key];
            }
        });

        // Update <html lang="…"> and document title
        document.documentElement.lang = lang;
        if (titles[lang]) {
            document.title = titles[lang];
        }

        // Update TYPO3-style language switch target
        const langCodeEl = document.getElementById('lang-code');
        const langSwitchBtn = document.getElementById('lang-switch');
        if (langCodeEl) {
            langCodeEl.textContent = nextLang;
        }
        if (langSwitchBtn) {
            const label = lang === 'en' ? 'Switch to German' : 'Zu Englisch wechseln';
            langSwitchBtn.setAttribute('aria-label', label);
            langSwitchBtn.setAttribute('title', label);
        }

        // Persist preference
        try { localStorage.setItem('nc_lang', lang); } catch(e) {}
    }

    function toggleLang() {
        const currentLang = document.documentElement.lang || 'en';
        const nextLang = currentLang === 'en' ? 'de' : 'en';
        setLang(nextLang);
    }

    // ── Restore saved preference or fall back to browser language ──
    (function () {
        let saved;
        try { saved = localStorage.getItem('nc_lang'); } catch(e) {}
        const browserLang = (navigator.language || 'en').toLowerCase().startsWith('de') ? 'de' : 'en';
        setLang(saved || browserLang);
    })();
</script>

