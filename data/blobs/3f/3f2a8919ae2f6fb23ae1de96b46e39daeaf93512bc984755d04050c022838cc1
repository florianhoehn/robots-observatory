    <style>
        /* ── Typography (Hosted on netcetera.com CDN) ── */
        @font-face {
            font-display: swap;
            font-family: 'Noto Sans';
            font-style: normal;
            font-weight: 400;
            src: url('https://www.netcetera.com/_assets/c2a094a0c500e6bb6cc7b47b09b6554c/Assets/fonts/noto-sans-v42-latin-regular.a368ce60.woff2') format('woff2');
