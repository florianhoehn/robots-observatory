            font-family: 'Noto Sans';
            font-style: normal;
            font-weight: 600;
            src: url('https://www.netcetera.com/_assets/c2a094a0c500e6bb6cc7b47b09b6554c/Assets/fonts/noto-sans-v42-latin-600.47c2075e.woff2') format('woff2');
        }

