      <path class="wire-dash" d="M138 138 C 126 126, 118 120, 112 114" stroke="var(--accent)" stroke-width="3"
            stroke-linecap="round" opacity=".35"/>

      <!-- 闪电断裂符号 -->
      <g transform="translate(88,88) rotate(45)">
        <path d="M0 0 L12 -8 L12 -2 L24 -12 L12 -12 L12 -18 L0 -8 Z" fill="none"/>
      </g>

      <!-- 机器人主体 -->
      <g class="float-group">
        <!-- 天线 -->
        <line x1="100" y1="52" x2="100" y2="66" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"/>
        <circle cx="100" cy="48" r="5" fill="var(--accent)"/>
        <!-- 头部 -->
        <rect x="64" y="66" width="72" height="58" rx="16" fill="var(--bg-soft)" stroke="var(--accent)" stroke-width="3"/>
        <!-- 眼睛（眨眼） -->
        <g fill="var(--accent)">
          <circle class="eye" cx="84" cy="95" r="6"/>
          <circle class="eye" cx="116" cy="95" r="6"/>
        </g>
        <!-- 嘴：困惑的波浪线 -->
        <path d="M88 110 q6 -5 12 0 q6 5 12 0" stroke="var(--text-dim)" stroke-width="2.5"
              stroke-linecap="round" fill="none"/>
        <!-- 身体 -->
        <rect x="74" y="130" width="52" height="34" rx="10" fill="var(--bg-soft)" stroke="var(--line)" stroke-width="2.5"/>
        <rect x="86" y="140" width="28" height="4" rx="2" fill="var(--accent)" opacity=".5"/>
        <!-- 悬空的小手 -->
        <path d="M64 100 q-12 8 -8 22" stroke="var(--line)" stroke-width="3" stroke-linecap="round" fill="none"/>
        <path d="M136 100 q12 8 8 22" stroke="var(--line)" stroke-width="3" stroke-linecap="round" fill="none"/>
      </g>

      <!-- 漂浮问号 -->
      <text class="float-slow" x="152" y="70" font-size="18" fill="var(--accent)" opacity=".6" font-weight="700">?</text>
      <text class="float" x="30" y="130" font-size="14" fill="var(--accent-2)" opacity=".5" font-weight="700">?</text>
    </svg>
  </div>

  <h1 class="title"></h1>
  <p class="desc">
    页面努力加载中...<br>
    <!--您可以<span class="hl">刷新重试</span>，或<span class="hl">返回首页</span>继续浏览其他内容。-->
