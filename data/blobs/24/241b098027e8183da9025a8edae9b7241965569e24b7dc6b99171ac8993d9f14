# Unit lists - allow main pages, block filtered variations
Allow: /characters/
Allow: /ships/
# ?ac= stays crawlable on purpose: those legacy filter URLs 301 to /effects/
# pages, and Googlebot can only see a redirect it is allowed to crawl. The
# longer Allow pattern wins over the wildcard Disallow below.
Allow: /characters/?ac=
Allow: /ships/?ac=
# Same for ?cat= (and ?cat_any=, a prefix match): single-category filter URLs
# 301 to /factions/ and /roles/ pages.
Allow: /characters/?cat=
Allow: /ships/?cat=
Disallow: /characters/*?*
Disallow: /ships/*?*

# Faction and role pages - the bare page is canonical; filtered variants are noindex
# and one URL per filter combination (OAI-SearchBot walked thousands, 2026-10-11).
Disallow: /factions/*?*
Disallow: /roles/*?*

# Stats pages - block filtered variations
Disallow: /stats/*?*

# Player profiles - block filtered variations (already noindex, but saves crawl budget)
Disallow: /p/*?*
Disallow: /p/*/mods/*/
# Unit-vs-player compare pages: one URL per (player, unit, player) triple.
Disallow: /p/*/unit/*/compare/

# Guild datacron review pages - noindex, and one URL per primary per set per build.
# The Datacrons tab itself (/g/<id>/datacrons/, with or without ?datacron_set=) stays crawlable.
Disallow: /g/*/datacrons/*/

