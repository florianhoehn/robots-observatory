<style id="xam-tgb-css" data-no-optimize="1">
.xam-tgb{position:relative;display:block;max-width:760px;margin:6px auto 18px;text-decoration:none!important;color:#fff!important;-webkit-tap-highlight-color:transparent}
.xam-tgb *{box-sizing:border-box}
.xam-tgb:focus-visible{outline:3px solid #fff;outline-offset:3px;border-radius:18px}
.xam-tgb,.xam-tgb *{text-align:left;line-height:normal}
/* dentro das areas de anuncio do tema (post, rodape): o modo escuro forca cor clara em links/spans e o rodape nao tem margem lateral */
.happy-footer-mobile .xam-tgb,.happy-related-videos-mobile .xam-tgb,.happy-header-mobile .xam-tgb{margin-left:12px!important;margin-right:12px!important}
.xam-tgb__card{position:relative;display:block;border-radius:18px}
/* foto que se reveza: 2 camadas, so opacity/transform animam */
.xam-tgb__slot{position:absolute;display:block;overflow:hidden}
.xam-tgb__slot img{position:absolute;left:0;top:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.04)}
/* so a foto que entra anima, por cima (is-top); a que sai fica ate a nova cobrir e some sem animar: metade dos quadros */
.xam-tgb__slot img.is-on{opacity:1;transform:none;transition:opacity .45s ease,transform .5s ease}
.xam-tgb__slot img.is-top{z-index:1}
.xam-tgb__cta{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:999px;font-weight:900;font-size:14px;line-height:1;letter-spacing:.04em;text-transform:uppercase;white-space:nowrap}
.xam-tgb__cta svg{width:17px;height:17px;flex:0 0 auto;margin:0 4px}
.xam-tgb__cta::after{content:"";position:absolute;top:0;right:0;bottom:0;left:0;background:linear-gradient(100deg,transparent 20%,rgba(255,255,255,.5) 50%,transparent 80%);transform:translateX(-120%)}
/* brilho: 1 passada de 0,8 s quando o JS poe is-shine (nenhuma animacao infinita: entre as trocas o navegador fica parado) */
.xam-tgb.is-shine .xam-tgb__cta::after{animation:xamTgbShine .8s ease-in-out}
@keyframes xamTgbShine{from{transform:translateX(-120%)}to{transform:translateX(120%)}}

/* ---------- estilo 1: Vitrine ---------- */
.xam-tgb--1{padding-top:28px} /* espaco para a cabeca da modelo sair do cartao */
.xam-tgb--1 .xam-tgb__card{padding:2px;background:linear-gradient(120deg,#fb0464,#ff5fa2 35%,#8b5cf6 70%,#fb0464);box-shadow:0 10px 28px rgba(251,4,100,.28)}
.xam-tgb--1 .xam-tgb__in{position:relative;display:flex;flex-direction:column;justify-content:center;min-height:150px;padding:12px 12px 12px 112px;border-radius:16px;overflow:hidden;background:radial-gradient(70% 110% at 0% 100%,rgba(251,4,100,.6),transparent 70%),radial-gradient(120% 140% at 100% 0%,rgba(139,92,246,.28),transparent 55%),#111}
.xam-tgb--1 .xam-tgb__in>*+*{margin-top:7px}
.xam-tgb--1 .xam-tgb__slot{top:0;bottom:2px;left:2px;width:108px;border-radius:0 0 0 16px}
.xam-tgb--1 .xam-tgb__slot img{object-position:50% 0}
.xam-tgb--1 .xam-tgb__slot--r{display:none;left:auto;right:2px;border-radius:0 0 16px 0}
.xam-tgb__who{position:absolute;left:50%;bottom:7px;z-index:2;transform:translateX(-50%);max-width:94%;padding:3px 8px;border-radius:999px;background:rgba(0,0,0,.72);color:#fff!important;font-size:10px;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;box-shadow:0 0 0 1px rgba(255,95,162,.55)}
.xam-tgb__who::before{content:"";display:inline-block;width:6px;height:6px;margin:0 5px 1px 0;border-radius:50%;background:#4ade80;vertical-align:middle}
.xam-tgb--1 .xam-tgb__tag{display:flex;align-items:center;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#ff5fa2!important}
.xam-tgb--1 .xam-tgb__tag svg{flex:0 0 auto;width:13px;height:13px;margin-right:6px;color:#37aee2!important}
.xam-tgb--1 .xam-tgb__h{position:relative;display:block;height:40px;overflow:hidden}
.xam-tgb--1 .xam-tgb__p{position:absolute;left:0;right:0;top:0;display:block;font-size:16px;font-weight:800;line-height:20px;color:#fff!important;opacity:0;transform:translateY(60%)}
.xam-tgb--1 .xam-tgb__p b{color:#ff3d8b!important}
.xam-tgb--1 .xam-tgb__p.is-on{opacity:1;transform:none}
.xam-tgb__p.is-on,.xam-tgb__p.is-out{transition:opacity .4s ease,transform .4s ease}
.xam-tgb--1 .xam-tgb__p.is-out{opacity:0;transform:translateY(-60%)}
.xam-tgb__chips{display:flex;flex-wrap:wrap;height:21px;overflow:hidden}
.xam-tgb__chips span{display:inline-flex;align-items:center;margin-right:5px;height:21px;padding:0 8px;border-radius:999px;background:rgba(255,255,255,.1);color:#f1f1f1!important;font-size:10.5px;font-weight:700;white-space:nowrap}
.xam-tgb__chips b{color:#fff!important;margin-right:3px}
.xam-tgb--1 .xam-tgb__cta{height:40px;padding:0 14px;background:linear-gradient(180deg,#ff2a7c,#e0035a);color:#fff!important;box-shadow:0 6px 18px rgba(251,4,100,.5),inset 0 1px 0 rgba(255,255,255,.25)}
.xam-tgb--1:hover .xam-tgb__cta{background:#ff2a7c}

/* ---------- estilo 2: Album do Telegram ---------- */
.xam-tgb--2 .xam-tgb__card{overflow:hidden;background:linear-gradient(135deg,#1d93d2 0%,#2aabee 45%,#1b7fc0 100%);box-shadow:0 8px 26px rgba(34,158,217,.3)}
.xam-tgb--2 .xam-tgb__card::before{content:"";position:absolute;top:0;right:0;bottom:0;left:0;opacity:.13;background-image:radial-gradient(circle at 20% 30%,#fff 1.2px,transparent 1.6px),radial-gradient(circle at 70% 70%,#fff 1.2px,transparent 1.6px);background-size:26px 26px}
