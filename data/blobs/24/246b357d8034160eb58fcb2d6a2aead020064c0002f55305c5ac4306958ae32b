.xam-tgb--2 .xam-tgb__avai{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;align-items:center;justify-content:center;border-radius:50%;background:linear-gradient(145deg,#fb0464,#ff7eb3);box-shadow:0 0 0 2px #fff;color:#fff!important}
