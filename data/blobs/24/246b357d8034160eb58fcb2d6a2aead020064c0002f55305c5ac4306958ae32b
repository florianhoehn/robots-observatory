.xam-tgb--2 .xam-tgb__who2{flex:1 1 auto;min-width:0;display:flex;flex-direction:column}
.xam-tgb--2 .xam-tgb__sub{margin-top:2px}
.xam-tgb--2 .xam-tgb__name{font-size:15px;font-weight:800;color:#fff!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xam-tgb--2 .xam-tgb__sub{font-size:11.5px;font-weight:600;color:#dff2ff!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.xam-tgb--2 .xam-tgb__new{flex:0 0 auto;margin-left:8px;padding:4px 8px;border-radius:999px;background:#fb0464;color:#fff!important;font-size:10px;font-weight:900;letter-spacing:.06em;text-transform:uppercase;box-shadow:0 3px 10px rgba(251,4,100,.45)}
.xam-tgb--2 .xam-tgb__bubble{grid-area:bubble;display:block;padding:4px;border-radius:4px 16px 16px 16px;background:#fff;box-shadow:0 3px 10px rgba(0,0,0,.14)}
.xam-tgb__album{display:grid;grid-template-columns:repeat(4,1fr);gap:3px}
.xam-tgb__tile{position:relative;display:block;height:0;padding-top:125%;border-radius:10px;overflow:hidden;background:#dbe7ef}
.xam-tgb__tile .xam-tgb__slot{top:0;right:0;bottom:0;left:0}
.xam-tgb__tile .xam-tgb__slot img{object-position:50% 20%}
.xam-tgb__more img{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;object-fit:cover;filter:blur(3px) brightness(.5);transform:scale(1.15)}
.xam-tgb__more span{position:absolute;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff!important;font-size:17px;font-weight:900;line-height:1.05;text-align:center}
.xam-tgb__more small{font-size:10.5px;font-weight:700;opacity:.92}
