     Задача: PageSpeed / INP
     Что делает: облегчает обработчик кнопки "Наверх".
     Зачем добавлено: старый jQuery scroll + fadeIn/fadeOut создавал лишнюю нагрузку
     на основной поток при прокрутке страницы.
     ========================================================================== -->
<script>
(function () {
    var topShow = 150;
    var ticking = false;
    var scroller;

    function updateScroller() {
        if (!scroller) return;

        if (window.pageYOffset > topShow) {
            scroller.classList.add('is-visible');
        } else {
            scroller.classList.remove('is-visible');
        }

        ticking = false;
    }

    function onScroll() {
        if (!ticking) {
            window.requestAnimationFrame(updateScroller);
            ticking = true;
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        scroller = document.getElementById('scroller');

        if (!scroller) return;

        window.addEventListener('scroll', onScroll, { passive: true });

        scroller.addEventListener('click', function (event) {
            event.preventDefault();

            window.scrollTo({
                top: 0,
                behavior: 'smooth'
            });
        });

        updateScroller();
    });
})();
</script>
