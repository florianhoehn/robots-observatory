<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>YesStyle.com</title>
<style type="text/css">
@keyframes jump {
 0% {
 margin-top: -5%;
 animation-timing-function: ease-in;
}
 30% {
 margin-top: 5%;
 animation-timing-function: ease-out;
}
 55% {
 margin-top: 3%;
 animation-timing-function: ease-in;
}
 75% {
 margin-top: 5%;
 animation-timing-function: ease-out;
}
 95% {
 margin-top: 4.5%;
 animation-timing-function: ease-in;
}
 100% {
 margin-top: 5%;
 animation-timing-function: ease-out;
}
}
@keyframes headingcolor {
 from {
color:#888;
}
 to {
color:#A33;
}
}
.errorIcon {
	float: left;
	margin: 5% 7%;
	animation: jump 1s;
}
body {
	font-family: oxygen, arial, sans-serif;
	color: #444; background-color:#f1f2f6;
}
h1{
	color: #888;
	font-family: oxygen, arial, sans-serif;
	font-size: 30pt;
	margin-bottom: 0;
	transition: color 1s;
	animation: headingcolor 2s linear 1s infinite alternate;
}
h3{
	color: #888;
	font-size: 18pt;
	margin-top: 0;
}
a{color:#333;}
a:hover{color:#63c956;}
b{color:#888;}
input[type=submit]{padding:0 11px; min-height:36px; line-height:36px; vertical-align:middle; text-align:center; font-size:14px; background-color:#333; border-radius:4px; border:none; color:#FFF; font-weight:bold; cursor:pointer; transition:.3s}
input[type=submit]:hover{background-color:#63c956;}
.content {
	display: table;
	max-width: 600px;
	padding-top: 7%;
	margin-top: 0;
}
.logo {
	margin-top: 80px;
	width: 268px;
}
ul li{margin-bottom:0.3em}
@media(max-width:600px) {
@keyframes jump {
 0% {
 top: -100px;
 animation-timing-function: ease-in;
}
 30% {
 top: 30px;
 animation-timing-function: ease-out;
}
 55% {
 top: 10px;
 animation-timing-function: ease-in;
}
 75% {
 top: 30px;
 animation-timing-function: ease-out;
}
 95% {
 top: 20px;
 animation-timing-function: ease-in;
}
 100% {
 top: 30px;
 animation-timing-function: ease-out;
}
}
body {
	text-align: center;
}
.errorIcon {
	margin: 0;
	top: 30px;
	position: absolute;
	left: 50%;
	transform: translateX(-50%);
	float: none;
}
.content {
	float: none;
	padding: 250px 10px 0;
	margin-top:0 auto;
}
h1{
	font-size: 26pt;
}
h3{
	font-size: 14pt;
}
.logo {
	margin-top: 50px;
	width: 201px;
}
.explain, ul {
	text-align: left;
}
}
</style>
</head>

