<style>
:root{
  color-scheme:light;

  /* Ground: cool paper, white sheets, one shaded band for table heads. */
  --paper:#eceff0;
  --sheet:#ffffff;
  --shade:#e2e7e9;

  /* Ink */
  --ink:#0f1416;    /* headings, rules of record */
  --ink-2:#2b3437;  /* body */
  --ink-3:#545f62;  /* labels, secondary readouts */

  /* Rules. Hairline is the structural unit of this design. */
  --rule:#c8d0d2;
  --rule-2:#9fabae;

  /* Signal. Three states, and nothing else gets colour. */
  --signal:#0d4f6c;
  --signal-2:#093a51;
  --warn:#7a4f00;
  --alert:#a3271b;

  /* Chart marks, held apart from text colours on purpose. */
  --bar:#3d7f9c;
  --bar-key:#0d4f6c;
  --bar-warn:#b8791a;
  --bar-alert:#a3271b;
  --track:#dce1e3;
  --hi:#f2f6f8;      /* the recommended plan column, one tint above sheet */

  /* Type: grotesque display, transitional serif body, mono for measurements. */
  --display:"Segoe UI","Avenir Next",Avenir,"Noto Sans",sans-serif;
  --body:Charter,"Bitstream Charter",Georgia,"Nimbus Roman No9 L","Times New Roman",serif;
  --mono:ui-monospace,SFMono-Regular,"Cascadia Mono",Menlo,Consolas,"Liberation Mono",monospace;

  /* Scale: 13.5 / 17 / 21.5 / 27 / 42, each step at least 1.25x the last. */
  --t-mono:13.5px;
  --t-body:17px;
  --t-3:21.5px;
  --t-2:27px;
  --t-1:42px;

  /* Shape: marks 2, panels and controls 4, pill for tags only. */
  --r-mark:2px;
  --r-panel:4px;
  --r-pill:999px;

  --maxw:1140px;
  --ease:cubic-bezier(.16,1,.3,1);
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;background:var(--paper)}
body{margin:0;background:var(--paper);color:var(--ink-2);
  font:var(--t-body)/1.6 var(--body);font-variant-numeric:tabular-nums;
  -webkit-font-smoothing:antialiased;text-align:left}
h1,h2,h3,h4{font-family:var(--display);color:var(--ink);margin:0;font-weight:600}
h1{font-size:var(--t-1);line-height:1.06;letter-spacing:-.022em;max-width:16ch}
h2{font-size:var(--t-2);line-height:1.16;letter-spacing:-.016em;max-width:24ch}
h3{font-size:var(--t-3);line-height:1.28;letter-spacing:-.01em}
h4{font-size:var(--t-body);line-height:1.4}
p{margin:0 0 12px;max-width:68ch}
p:last-child{margin-bottom:0}
a{color:var(--signal);text-decoration:none;border-bottom:1px solid var(--rule-2);
  transition:color 160ms var(--ease),border-color 160ms var(--ease)}
a:hover{color:var(--signal-2);border-bottom-color:var(--signal)}
code{font-family:var(--mono);font-size:.85em;color:var(--ink)}
strong{font-weight:600;color:var(--ink)}
::selection{background:var(--signal);color:var(--sheet)}
:focus-visible{outline:2px solid var(--signal);outline-offset:2px}

.wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
.skip{position:absolute;left:-9999px}
.skip:focus{left:12px;top:12px;background:var(--sheet);color:var(--ink);padding:10px 16px;
  z-index:9;border:1px solid var(--ink);border-radius:var(--r-panel)}
.vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}

/* the one label register: mono, uppercase, tracked. Never used above a heading. */
.lbl{font-family:var(--mono);font-size:var(--t-mono);letter-spacing:.12em;
  text-transform:uppercase;color:var(--ink-3);margin:0}

/* ---------- masthead bar + live strip ---------- */
.top{position:sticky;top:0;z-index:6}
header{background:var(--sheet);border-bottom:1px solid var(--rule)}
.bar{display:flex;align-items:center;gap:26px;height:56px}
.brand{display:flex;align-items:center;gap:9px;font-family:var(--display);font-size:19px;
  font-weight:600;letter-spacing:-.02em;color:var(--ink);border:0}
.brand:hover{color:var(--ink)}
.brand em{font-style:normal;color:var(--signal)}
.brand svg{display:block;flex:none}
nav.pri{margin-left:auto;display:flex;align-items:center;gap:20px;
  font-family:var(--display);font-size:15px}
nav.pri a{position:relative;color:var(--ink-2);border:0;padding:18px 0}
nav.pri a:hover{color:var(--ink)}
nav.pri a::after{content:"";position:absolute;left:0;right:0;bottom:14px;height:2px;
  background:var(--ink);transform:scaleX(0);transform-origin:left center;
  transition:transform 180ms var(--ease)}
nav.pri a:hover::after{transform:scaleX(1)}
nav.pri a[aria-current="page"]{color:var(--ink);font-weight:600}
nav.pri a[aria-current="page"]::after{transform:scaleX(1);background:var(--signal)}
nav.pri a.act{padding:0}
nav.pri a.act::after{display:none}

.btn{display:inline-block;font-family:var(--mono);font-size:13px;letter-spacing:.08em;
  text-transform:uppercase;padding:9px 16px;border-radius:var(--r-panel);cursor:pointer;
  border:1px solid var(--ink);background:transparent;color:var(--ink);
  transition:background-color 160ms var(--ease),color 160ms var(--ease),
    border-color 160ms var(--ease),transform 120ms var(--ease)}
.btn:hover{background:var(--ink);color:var(--sheet)}
.btn:active{transform:translateY(1px)}
.btn.pri{background:var(--ink);color:var(--sheet)}
.btn.pri:hover{background:var(--signal);border-color:var(--signal)}
.btn.sm{padding:7px 12px;font-size:12px}

/* the live strip: inverted instrument readout, static values, no pulsing */
.strip{background:var(--ink);color:var(--paper);overflow-x:auto}
.strip .wrap{display:flex;align-items:center;gap:26px;height:34px;white-space:nowrap;
  font-family:var(--mono);font-size:12.5px;letter-spacing:.04em}
.strip dl{display:flex;gap:22px;margin:0;padding:0}
.strip div{display:flex;align-items:center;gap:7px}
.strip dt{color:var(--rule-2)}
.strip dd{margin:0;color:var(--paper)}
.strip .sq{width:8px;height:8px;border-radius:var(--r-mark);background:var(--bar);flex:none}
.strip .sq.up{background:var(--bar-warn)}
.strip .last{margin-left:auto;color:var(--rule-2)}

/* ---------- the two-column ruled ledger ---------- */
.ledger{display:grid;grid-template-columns:1fr 1fr;border-top:2px solid var(--ink);
  background:var(--sheet);border-bottom:1px solid var(--rule)}
.ledger > *{padding:24px 26px 26px;min-width:0}
.ledger > *:nth-child(odd){border-right:1px solid var(--rule)}
.ledger > *:nth-child(n+3){border-top:1px solid var(--rule)}
.ledger.open{background:transparent;border-bottom:0}
.mast{margin:28px 0 0}
.mast .lede{font-size:var(--t-3);line-height:1.45;color:var(--ink-2);margin:14px 0 0;max-width:40ch}
.acts{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.meta{font-family:var(--mono);font-size:var(--t-mono);line-height:1.65;color:var(--ink-3);
  margin:18px 0 0;max-width:62ch}
.meta a{border-bottom-color:var(--rule)}

/* ---------- bands ---------- */
.band{margin-top:56px}
.band > h2:first-child,.bandhead{margin-bottom:18px}
.bandhead{display:flex;align-items:baseline;justify-content:space-between;gap:24px;
  flex-wrap:wrap;border-top:2px solid var(--ink);padding-top:14px}
.band .intro{font-size:var(--t-3);line-height:1.45;color:var(--ink-2);max-width:56ch;margin:0 0 22px}
.band .meta:first-child{margin-top:0}

/* ---------- sheets ---------- */
.sheet{background:var(--sheet);border:1px solid var(--rule);border-radius:var(--r-panel)}
.sheet + .sheet{margin-top:18px}
.cap{display:flex;align-items:baseline;justify-content:space-between;gap:18px;flex-wrap:wrap;
  font-family:var(--mono);font-size:var(--t-mono);letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink-3);padding:12px 16px;margin:0;border-bottom:1px solid var(--rule);max-width:none}
.cap b{color:var(--ink);font-weight:600;letter-spacing:.06em}
.pad{padding:18px 16px}

/* ---------- tables: dense, ruled, tabular ---------- */
.scroller{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:var(--t-mono)}
caption{text-align:left;font-family:var(--mono);font-size:var(--t-mono);letter-spacing:.1em;
  text-transform:uppercase;color:var(--ink-3);padding:12px 16px;border-bottom:1px solid var(--rule)}
caption b{color:var(--ink);font-weight:600;letter-spacing:.06em}
.wf caption{display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap}
th,td{text-align:left;padding:9px 16px;border-top:1px solid var(--rule);vertical-align:top;
  line-height:1.5}
thead th{border-top:0;background:var(--shade);font-size:12.5px;letter-spacing:.1em;
  text-transform:uppercase;color:var(--ink-3);font-weight:600;white-space:nowrap;
  border-bottom:1px solid var(--rule-2)}
tbody th{font-weight:600;color:var(--ink);white-space:nowrap}
tbody tr{transition:background-color 150ms var(--ease)}
tbody tr:hover{background:var(--shade)}
td.num,th.num{text-align:right;white-space:nowrap;font-variant-numeric:tabular-nums}
tfoot th,tfoot td{border-top:3px double var(--ink-3);color:var(--ink);font-weight:600;
  background:var(--sheet)}
.plans td,.plans th{white-space:nowrap}
.plans thead th{font-family:var(--display);font-size:15px;letter-spacing:0;text-transform:none;
  color:var(--ink);padding-bottom:10px;vertical-align:bottom}
.plans thead th span{display:block;font-family:var(--mono);font-size:12.5px;letter-spacing:.06em;
  color:var(--ink-3);font-weight:400;margin-top:4px}
.plans col.hi{background:var(--hi)}
.plans tbody th{white-space:normal}

/* ---------- signature device: trace waterfall ---------- */
.wf{table-layout:fixed}
.wf th,.wf td{padding:7px 16px;vertical-align:middle}
.wf .sp{width:31%;font-weight:400;color:var(--ink-2)}
.wf .ms{width:17%}
.wf .bc{width:52%}
.bar{position:relative;display:block;height:9px;background:var(--track);border-radius:var(--r-mark);
  min-width:130px}
.bar i{position:absolute;top:0;height:9px;display:block;border-radius:var(--r-mark);
  left:var(--o,0);width:var(--w,0);background:var(--bar);transform-origin:left center}
.bar i.key{background:var(--bar-key)}
.bar i.warn{background:var(--bar-warn)}
.bar i.alert{background:var(--bar-alert)}
.axis{position:relative;display:flex;padding-top:5px;border-top:1px solid var(--rule-2)}
.axis b{flex:1 1 0;border-left:1px solid var(--rule-2);margin-top:-5px;padding:5px 0 0 5px;
  font:400 12px/1 var(--mono);color:var(--ink-3)}
.axis b:first-child{border-left:0;padding-left:0}
.axis em{position:absolute;right:0;top:5px;font:400 12px/1 var(--mono);font-style:normal;
  color:var(--ink-3)}
.wf tfoot td.axc{padding-top:2px;padding-bottom:10px;border-top:0}
.wf tfoot tr.ax th,.wf tfoot tr.ax td{border-top:0;background:transparent}
.wf tfoot tr.tot th,.wf tfoot tr.tot td{border-top:3px double var(--ink-3)}
.wf tbody tr:hover .bar i{background:var(--signal-2)}

/* ---------- key/value readout rows ---------- */
.kv{list-style:none;margin:0;padding:0;font-family:var(--mono);font-size:var(--t-mono)}
.kv li{display:flex;justify-content:space-between;gap:18px;padding:9px 16px;
  border-top:1px solid var(--rule)}
.kv li:first-child{border-top:0}
.kv b{font-weight:600;color:var(--ink);letter-spacing:.02em}
.kv span{color:var(--ink-3);text-align:right}

/* ---------- ordered procedure ---------- */
ol.steps{list-style:none;margin:0;padding:0;counter-reset:s}
ol.steps li{counter-increment:s;padding:14px 0 14px 38px;border-top:1px solid var(--rule);
  position:relative;max-width:66ch}
ol.steps li:first-child{border-top:0;padding-top:2px}
ol.steps li::before{content:counter(s) '.';position:absolute;left:0;top:16px;
  font-family:var(--mono);font-size:12.5px;color:var(--signal)}
ol.steps li:first-child::before{top:4px}
ol.steps b{font-family:var(--display);font-weight:600;color:var(--ink)}
pre{margin:0;padding:16px;overflow-x:auto;font-family:var(--mono);font-size:var(--t-mono);
  line-height:1.65;color:var(--ink-2)}
pre .c{color:var(--ink-3)}
pre .k{color:var(--signal)}

/* ---------- tags and severity marks ---------- */
.tags{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 10px;padding:0;list-style:none}
.tags li{font-family:var(--mono);font-size:12px;letter-spacing:.07em;text-transform:uppercase;
  color:var(--ink-3);border:1px solid var(--rule-2);border-radius:var(--r-pill);padding:2px 10px}
.tags li.on{color:var(--signal);border-color:var(--signal)}
.sev{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.06em;
  border:1px solid currentColor;border-radius:var(--r-mark);padding:1px 5px;white-space:nowrap}
.sev.s1{color:var(--alert)}
.sev.s2{color:var(--warn)}
.sev.s3{color:var(--signal)}

/* ---------- ledger entries: incidents, releases, cases ---------- */
.entry{display:grid;grid-template-columns:168px 1fr;gap:32px;padding:26px 0;
  border-top:1px solid var(--rule)}
.entry:first-of-type{border-top:2px solid var(--ink)}
.entry h3{margin-bottom:10px}
.stamp{font-family:var(--mono);font-size:var(--t-mono);color:var(--ink);margin:0}
.stamp span{display:block;font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;
  color:var(--ink-3);margin-top:6px}
ul.bul{margin:10px 0 0;padding-left:20px}
ul.bul li{margin-bottom:6px;max-width:66ch}
.tl{list-style:none;margin:14px 0 0;padding:0;font-size:16px}
.tl li{padding:8px 0 8px 100px;position:relative;border-top:1px solid var(--rule);max-width:70ch}
.tl li:first-child{border-top:0}
.tl li b{position:absolute;left:0;top:8px;font-family:var(--mono);font-size:12.5px;
  font-weight:400;color:var(--ink-3)}

/* ---------- status day bars ---------- */
.comp{padding:16px}
.comp + .comp{border-top:1px solid var(--rule)}
.chd{display:flex;justify-content:space-between;align-items:baseline;gap:18px;
  font-family:var(--mono);font-size:var(--t-mono);margin:0 0 10px;max-width:none}
.chd b{color:var(--ink);font-weight:600}
.chd span{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3)}
.chd span.up{color:var(--warn)}
.bars{display:flex;gap:2px;height:24px;align-items:flex-end}
.bars i{display:block;flex:1 1 0;height:100%;border-radius:var(--r-mark);background:var(--bar);
  transform-origin:bottom center;transition:transform 140ms var(--ease)}
.bars i:hover{transform:scaleY(1.15)}
.bars i.w{background:var(--bar-warn)}
.bars i.e{background:var(--bar-alert)}
.legend{display:flex;gap:22px;flex-wrap:wrap;font-family:var(--mono);font-size:12.5px;
  letter-spacing:.08em;text-transform:uppercase;color:var(--ink-3);padding:12px 16px;
  border-top:1px solid var(--rule);margin:0;max-width:none}
.legend i{display:inline-block;width:9px;height:9px;border-radius:var(--r-mark);
  margin-right:7px;background:var(--bar)}
.legend i.w{background:var(--bar-warn)}
.legend i.e{background:var(--bar-alert)}

/* ---------- forms (inert) ---------- */
.field{margin:0 0 16px}
.field label{display:flex;justify-content:space-between;gap:12px;font-family:var(--mono);
  font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-3);margin-bottom:6px}
.field label em{font-style:normal;color:var(--signal);letter-spacing:.06em}
.field input,.field select,.field textarea{width:100%;background:var(--sheet);
  border:1px solid var(--rule-2);border-radius:var(--r-panel);color:var(--ink);
  font:var(--t-mono)/1.5 var(--mono);padding:11px 12px;
  transition:border-color 160ms var(--ease)}
.field input::placeholder,.field textarea::placeholder{color:var(--ink-3)}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--signal)}
.field textarea{min-height:140px;resize:vertical}
.hint{font-family:var(--body);font-size:15px;line-height:1.5;color:var(--ink-3);
  margin:6px 0 0;max-width:56ch}
.err{display:block;font-family:var(--mono);font-size:12.5px;color:var(--alert);
  margin-top:6px;min-height:17px}
[aria-invalid="true"]{border-color:var(--alert)}
.formbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-top:2px}
.formbar .sub{font-size:15px;color:var(--ink-3)}
.notice{font-family:var(--body);font-size:15px;line-height:1.55;background:var(--paper);
  border:1px solid var(--rule-2);border-radius:var(--r-panel);padding:14px 16px;
  margin:16px 0 0;max-width:62ch}
.notice:empty{display:none}
.notice b{display:block;font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;
  text-transform:uppercase;font-weight:600;margin-bottom:6px;color:var(--alert)}
.notice.good b{color:var(--signal)}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}

/* ---------- docs ---------- */
.docwrap{display:grid;grid-template-columns:196px 1fr;gap:0;border-top:2px solid var(--ink);
  background:var(--sheet);border-bottom:1px solid var(--rule)}
.docnav{position:sticky;top:106px;align-self:start;padding:20px 20px 26px;font-size:15px;
  border-right:1px solid var(--rule)}
.docnav p{font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink-3);margin:0 0 8px}
.docnav ul{list-style:none;margin:0 0 22px;padding:0}
.docnav ul:last-child{margin-bottom:0}
.docnav li{border-top:1px solid var(--rule)}
.docnav a{display:block;padding:7px 0;color:var(--ink-2);border:0}
.docnav a:hover{color:var(--signal)}
.docnav a.on{color:var(--ink);font-weight:600;font-family:var(--display)}
.doc{padding:26px;min-width:0}
.doc section{border-top:1px solid var(--rule);padding:30px 0 6px}
.doc section:first-of-type{border-top:0;padding-top:0}
.doc section > h3{font-size:var(--t-2);line-height:1.16;letter-spacing:-.016em;margin:0 0 12px}
.doc h4{margin:26px 0 10px;font-size:var(--t-body);color:var(--ink)}

/* ---------- prose ---------- */
.prose p,.prose li{max-width:68ch}
.prose ul{margin:0 0 14px;padding-left:20px}
.prose li{margin-bottom:6px}
.prose h3{font-size:var(--t-body);margin:24px 0 8px}
.prose .sheet{margin:18px 0}

/* ---------- footer ---------- */
footer{background:var(--sheet);border-top:2px solid var(--ink);margin-top:64px;padding:36px 0 24px}
.fcols{display:grid;grid-template-columns:1.4fr repeat(4,1fr);gap:28px}
.fcols h2{font-family:var(--mono);font-size:12.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--ink-3);margin:0 0 10px;font-weight:600;max-width:none}
.fcols ul{list-style:none;margin:0;padding:0;font-size:15px;line-height:1.95}
.fcols a{color:var(--ink-2);border:0}
.fcols a:hover{color:var(--signal)}
.fcols a[aria-current="page"]{color:var(--ink);font-weight:600}
.fnote{font-size:15px;line-height:1.5;color:var(--ink-3);max-width:34ch;margin-top:12px}
.fbot{display:flex;flex-wrap:wrap;gap:18px;justify-content:space-between;margin-top:32px;
  padding-top:16px;border-top:1px solid var(--rule);font-family:var(--mono);font-size:12.5px;
  color:var(--ink-3)}
.fbot p{margin:0;max-width:none}

/* ---------- motion. Everything below is transform and opacity only. ---------- */
@keyframes rise{from{opacity:0;transform:translateY(9px)}to{opacity:1;transform:none}}
@keyframes draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.js .rise{animation:rise 380ms var(--ease) both;animation-delay:var(--d,0ms)}
.js .bar i{animation:draw 300ms var(--ease) both;animation-delay:var(--d,0ms)}

