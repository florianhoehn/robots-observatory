# Faceted / argument listing URLs. These take term-id combinations
# (/en/resources/filter/70+958+9+920, /fr/speeches/70,958,9,127,179) and expand
# combinatorially, so every crawl hit is a fresh uncached render. During the
# 2026-09-24 outage Googlebot spent ~9,500 of 50,000 sampled requests on
# /resources/filter alone. None of these are content: the real pages are
# date-based (/en/speeches/20171125/slug) and stay crawlable.
Disallow: /resources/filter/
Disallow: /*/resources/filter/
Disallow: /index.php/resources/filter/
Disallow: /index.php/*/resources/filter/
Disallow: /speeches/*,*
Disallow: /*/speeches/*,*
Disallow: /documents/*,*
Disallow: /*/documents/*,*
# Raw node paths under NON-DEFAULT language prefixes. Only ~1,500 of 18,800
# nodes have a French translation (and far fewer in ar/es/pt/sw), so an
# untranslated node has no alias in those languages and is served at
# /<lang>/node/<nid> — roughly 85,000 unaliased duplicates of English content,
# which the language switcher links from every page. Googlebot spent 2,220 of
# 2,410 sampled node-path requests on /fr/node/ alone (2026-09-24).
# NOT /node/ or /en/node/: 35 nodes (0.17%) have no alias at all and are
# reachable only by raw node path, so blocking those would deindex them.
Disallow: /fr/node/
Disallow: /ar/node/
Disallow: /es/node/
Disallow: /pt/node/
Disallow: /sw/node/
# Quicktabs no-JS AJAX endpoints: render a tab's content, never a page.
