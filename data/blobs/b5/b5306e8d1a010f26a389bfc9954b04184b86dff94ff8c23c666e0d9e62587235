            document.addEventListener("DOMContentLoaded", function() {
                // get the current domain
                const currentDomain = window.location.origin;

                // update the href for the anchor with class "primary-navigation-logo"
                const logoLink = document.querySelector('.primary-navigation-logo');
                if (logoLink) {
                    logoLink.href = currentDomain;
                }

                // update the href for the specific anchor link to the homepage
                const homepageLink = document.querySelector('#homepage-link');
                if (homepageLink) {
                    homepageLink.href = currentDomain;
                }

                // update the <b> tag text with the current domain
                const domainText = document.querySelector('#homepage-text');
                if (domainText) {
                    domainText.textContent = currentDomain.replace(/^https?:\/\//, '');
                }
            });
