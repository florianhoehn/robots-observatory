    // 動的コンテンツの言語別出し分けで各ページから利用する共通ヘルパー。
    // 言語の判定は Weglot が翻訳時に書き換える <html> の lang 属性を正とし、
    // 属性の変更を MutationObserver で監視して切替を検知する。
    // （Weglot の initialized は翻訳適用前に発火し、ページ読込時の自動翻訳では
    //   languageChanged を取りこぼすことがあるため、イベントだけには依存しない）
    window.weglotLangHelper = (function () {
        var IR_LIBRARY_ENGLISH_KEYWORDS = {
            kessan: 'Consolidated Financial Results',
            presentation: 'Business Results Briefing',
            meeting: 'Annual General Meeting of Shareholders'
        };
        var NO_ENGLISH_LIBRARY_PAGES = [
            '/ir/library/securities.html',
            '/ir/library/report.html',
            '/ir/library/integrated.html'
        ];
        var changeCallbacks = [];
        var lastLang;
        function currentLang() {
            return (document.documentElement.getAttribute('lang') || 'ja').toLowerCase();
        }
        function isEnglish() {
            return currentLang().indexOf('en') === 0;
        }
        function notifyIfChanged() {
            var lang = currentLang();
            if (lang === lastLang) { return; }
            lastLang = lang;
            for (var i = 0; i < changeCallbacks.length; i++) {
                try { changeCallbacks[i](); } catch (e) { if (window.console && console.error) { console.error(e); } }
            }
        }
        lastLang = currentLang();
        if (typeof MutationObserver !== 'undefined') {
            new MutationObserver(notifyIfChanged)
                .observe(document.documentElement, { attributes: true, attributeFilter: ['lang'] });
        }
        if (typeof Weglot !== 'undefined' && typeof Weglot.on === 'function') {
            // 念のため Weglot のイベントでも検知する（同一言語なら notifyIfChanged 側で抑止される）
            Weglot.on('languageChanged', notifyIfChanged);
        }
        function onReady(callback) {
            var done = false;
            var run = function () { if (!done) { done = true; callback(); } };
            if (typeof Weglot === 'undefined') { run(); return; }
            if (Weglot.initialized) { run(); return; }
            if (typeof Weglot.on === 'function') { Weglot.on('initialized', run); }
            // initialized を取りこぼしても描画されるようフォールバック
            setTimeout(run, 1000);
        }
        function onChange(callback) {
            changeCallbacks.push(callback);
