    <script type="text/javascript">
var showcase_pos = 0, showcase_cnt = 8;
var showcase_len, showcase_arr=new Array();
function showcase_scroll() {
	var showcase_end = showcase_pos+showcase_cnt-1;
	var showcase_pad = showcase_end-showcase_len;
	var html = "";
	if(showcase_pad<0){
		html = showcase_fetch(showcase_pos, showcase_end);
		showcase_pos = showcase_pad == -1 ? 0 : showcase_end+1 ;
	} else if(showcase_pad>=0){
		html = showcase_fetch(showcase_pos, showcase_len-1);
		html += showcase_fetch(0, showcase_pad);
		showcase_pos = showcase_pad+1;
	}
	$("#showcase").html(html);	
};
function showcase_fetch(start, end) {
	var obj, html = "";
	for(var i=start;i<=end;i++){
		obj = showcase_arr[i];
		//html +="<li><a href='"+ obj.href+ "' title='"+ obj.title+ "' target='_blank'>"+$(obj).text()+"</a></li>"
		html +="<li>"+obj+"</li>"
	}
	return html;
}

