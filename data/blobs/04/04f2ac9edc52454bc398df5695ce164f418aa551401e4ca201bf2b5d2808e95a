<!doctype html>
<html lang="ru">
   <head>
      <meta charset="UTF-8"/>
      <meta name="viewport" content="width=device-width,initial-scale=1"/>
      <title>Доступ к сайту временно ограничен владельцем веб-ресурса.</title>
      <style>:root{--color-primary:#000000;--bg-primary:#fff;--font-family-header:Arial,Helvetica,Roboto,Roboto Condensed,sans-serif;--font-family-text:var(--font-family-header);--font-size-sm:14px;--font-size-md:16px;--font-size-xl:28px;--font-size-2xl:40px;--font-weight-regular:400;--line-height-heading:140%;--line-height-text:160%;--button-color:#93a2af;--button-border:1px solid #d4e0eb}*,:after,:before{box-sizing:border-box;margin:0;padding:0}body{display:flex;flex-direction:column;height:100vh;font-family:var(--font-family-text);font-weight:400;font-size:16px;line-height:160%;color:var(--color-primary);background-color:var(--bg-primary)}button{font-size:inherit}.logo{height:auto;margin:0 auto 1rem;width:230px}.main{display:flex;align-items:center;flex-direction:column;margin:125px auto;text-align:center}.section{max-width:780px}.heading{font-family:var(--font-family-header);font-size:var(--font-size-2xl);font-weight:var(--font-weight-regular);line-height:var(--line-height-heading)}.text{margin:16px auto;font-family:var(--font-family-text);font-size:var(--font-size-md);font-weight:var(--font-weight-regular);line-height:var(--line-height-text)}.info{align-items:center;display:flex;flex-direction:column;margin-top:100px;width:100%}.info_item{column-gap:6px;display:flex;align-items:center;justify-content:space-between;flex-direction:row;border:var(--button-border);padding:15px;width:100%;position:relative}.info_item+.info_item{margin-top:20px}.info_data{font-weight:var(--font-weight-regular)}.icon-button{display:flex;align-items:center;border:none;background:0 0;color:var(--button-color);cursor:pointer}img.logo[src=""]{display:none}@media (max-width:1365px){body{margin-left:auto;margin-right:auto;padding:11px;max-width:1000px}}@media (max-width:1023px){body{max-width:750px}.info{margin-top:75px}}@media (max-width:767px){body{max-width:542px}.main{margin-top:15%}.heading{font-size:var(--font-size-xl)}.text{font-size:var(--font-size-sm)}}@media (max-width:576px){body{max-width:450px}.info_caption{position:absolute;top:-30px;white-space:nowrap}.info_item+.info_item{margin-top:45px}}</style>
   </head>
   <body>
      <div class="main">
         <img id="logo" class="logo" width="230" height="50" loading="lazy" src="https://netstorage.aeroflot.ru/mailimg/logo_blue_no_skyteam_ru.png"/>
         <section class="section">
            <h1 class="heading">CODE: 3749707</h1>
            <p class="text">Если считаете, что произошла ошибка, пожалуйста, обратитесь к владельцу веб-ресурса и сообщите данные, указанные ниже.</p>
            <div class="info">
               <div class="info_item">
                  <div><span class="info_caption">Ваш IP адрес: </span><span id="ip" class="info_data">82.39.15.43</span></div>
                  <button class="icon-button" onclick='copy("ip")'>
                     <svg alt="" width="10" height="12" fill="currentColor">
                        <path d="M8.738 10.5H3.254V3.492h5.484zm0-7.992H3.254q-.422 0-.727.281a.95.95 0 00-.28.703V10.5q0 .422.28.703.305.282.727.305h5.484a1.04 1.04 0 00.703-.305.92.92 0 00.305-.703V3.492a.92.92 0 00-.305-.703.95.95 0 00-.703-.281M7.238.492h-6a1.04 1.04 0 00-.703.305.95.95 0 00-.281.703v7.008h.984V1.5h6z"/>
                     </svg>
                  </button>
               </div>
               <div class="info_item">
                  <div><span class="info_caption">Ваш ID запроса к ресурсу: </span><span id="request_id" class="info_data">711b6381ac4d721aa67b1c030ce826ab</span></div>
                  <button class="icon-button" onclick='copy("request_id")'>
                     <svg alt="" width="10" height="12" fill="currentColor">
                        <path d="M8.738 10.5H3.254V3.492h5.484zm0-7.992H3.254q-.422 0-.727.281a.95.95 0 00-.28.703V10.5q0 .422.28.703.305.282.727.305h5.484a1.04 1.04 0 00.703-.305.92.92 0 00.305-.703V3.492a.92.92 0 00-.305-.703.95.95 0 00-.703-.281M7.238.492h-6a1.04 1.04 0 00-.703.305.95.95 0 00-.281.703v7.008h.984V1.5h6z"/>
                     </svg>
                  </button>
               </div>
               <div class="info_item">
                  <div><span class="info_caption">Время блокировки (UTC): </span><span id="block_time" class="info_data">2026-10-19T18:47:16.184Z</span></div>
                  <button class="icon-button" onclick='copy("block_time")'>
                     <svg alt="" width="10" height="12" fill="currentColor">
                        <path d="M8.738 10.5H3.254V3.492h5.484zm0-7.992H3.254q-.422 0-.727.281a.95.95 0 00-.28.703V10.5q0 .422.28.703.305.282.727.305h5.484a1.04 1.04 0 00.703-.305.92.92 0 00.305-.703V3.492a.92.92 0 00-.305-.703.95.95 0 00-.703-.281M7.238.492h-6a1.04 1.04 0 00-.703.305.95.95 0 00-.281.703v7.008h.984V1.5h6z"/>
                     </svg>
                  </button>
               </div>
            </div>
         </section>
      </div>
      <script>
         function copy(id){
            var el=document.getElementById(id),text=(el.textContent||"").trim();
            if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(text);return}
            var r=document.createRange();r.selectNodeContents(el);
            var s=window.getSelection();s.removeAllRanges();s.addRange(r);
            try{document.execCommand("copy")}catch(e){}
            s.removeAllRanges()
         }
      </script>
   </body>
</html>
