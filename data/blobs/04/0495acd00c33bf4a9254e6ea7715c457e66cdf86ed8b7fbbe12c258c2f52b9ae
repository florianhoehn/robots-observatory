	<script>
		let customHubspotButton = null;
		// HubSpot Web Chat
		function createHubspotCustomButton() {
			//load script while creating button
			loadHubSpot();

			let imgElem = document.createElement('img');
			imgElem.src = "https://www.pubnation.com/wp-content/themes/pubnation/dist/img/pubnation-icon.svg"
			customHubspotButton = document.createElement('div');
			customHubspotButton.style.cssText = 'display: block; bottom: 15px; right: 15px; background-color: black; border: none; position: fixed; border-radius: 50%; height: 61px; width: 61px; z-index:9999;';
			customHubspotButton.id = "custom-hubspot-button";
			customHubspotButton.addEventListener('click', () => {
				hideHubspotCustomButton();
				window.HubSpotConversations.widget.open();
			})
			customHubspotButton.addEventListener('mouseover',() => {
				customHubspotButton.style.transform = 'scale(1.1)';
			})
			customHubspotButton.addEventListener('mouseout',() => {
				customHubspotButton.style.transform = 'scale(1)';
			})

			customHubspotButton.appendChild(imgElem);
		}

		function showHubspotCustomButton() {
            customHubspotButton.style.display = 'block';
        }

        function hideHubspotCustomButton() {
            customHubspotButton.style.display = 'none';
        }

		var loadHubSpot = function() {
			var loadedHubSpot = false;
			const isStaging = window.location.href.includes("staging") || window.location.href.includes("local")
			const hubId = isStaging ? "47461438" : "44320890";

			var loadHubSpotScript = function() {
				var t = document.getElementsByTagName("script")[0];
				var e = document.createElement("script");
				e.type = "text/javascript";
				e.async = true;
				e.defer = true;
				e.id = "hs-script-loader";
				e.src = `https://js-na1.hs-scripts.com/${hubId}.js`;
				e.onload = function() {
					loadedHubSpot = true;
					window.hsConversationsOnReady = [() => {
						document.body.prepend(customHubspotButton);

						// max number of times we are looking for an active widget
						let checkedCount = 0
						const activeInterval = setInterval(() => {
							// determining the active widget based on classes that are outside the iframe.
							// this could be subject to change if hubspot updates their class or element structure
							const el = document.querySelector(".hs-shadow-container.active");

							// checking up to 10 times (10 x 200 = 2 seconds) for an active widget
							// if exceeded checks or there is an el found then clearing the interval
							if (checkedCount > 10) {
								clearInterval(activeInterval)
							}
							if (el) {
								hideHubspotCustomButton();
								clearInterval(activeInterval);
							}
							checkedCount++
						}, 200)
					}];

					// determining when the eventing sdk is present
					const eventsInterval = setInterval(() => {
						if (window.HubSpotConversations && window.HubSpotConversations.on) {
							window.HubSpotConversations.on('widgetClosed', () => {
								showHubspotCustomButton();
							});
							clearInterval(eventsInterval)
						}
					}
					, 200)
                }
				t.parentNode.insertBefore(e, t);
				window.removeEventListener('scroll', loadHubSpotScript);
			};
			loadHubSpotScript();
			var clickOpenHubSpot = function() {
				openOnLoad = true;
				if (!loadedHubSpot) {
					loadHubSpotScript();
				} else {
					hideHubspotCustomButton();
					window.HubSpotConversations?.widget.open();
				}
			};

			// Open HubSpot chat when class name clicked.
			const intercomLinks = document.getElementsByClassName('open-intercom') || [];
			if ( intercomLinks.length > 0 ) {
				for (let intercomLink of intercomLinks) {
					intercomLink.addEventListener('click', clickOpenHubSpot);
				}
			}

		};

        window.addEventListener('ConsentManagerInitialized', () => {
            // On Load
            if (window.ConsentManager.consent.marketing && window.ConsentManager.consent.function && window.ConsentManager.consent.measurement) {
                createHubspotCustomButton();
            }
            if (window.ConsentManager.consent.data_sales_and_sharing ) {
                createHubspotCustomButton();
            }
            if (window.ConsentManager.regulationKey === "") {
                createHubspotCustomButton();
            }
            window.ConsentManager.addEventListener("consent", () => {
                if (window.ConsentManager.hasUpdated()) {

                    if (
                        (window.ConsentManager.consent.measurement &&
                            window.ConsentManager.consent.function &&
                            window.ConsentManager.consent.marketing) || window.ConsentManager.consent.data_sales_and_sharing || window.ConsentManager.regulationKey === ""
                    ) {
                        createHubspotCustomButton();
                    } else {
                        window.ConsentManager.clearCookies();
                        window.location.reload();
                    }
                }
            });
        })

	</script>
