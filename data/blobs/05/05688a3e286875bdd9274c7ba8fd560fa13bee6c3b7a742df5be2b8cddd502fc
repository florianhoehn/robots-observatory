*/

var MAX_NAV_TOPICS = 5;
var DELAY_SECONDS = 15;
var NAVIGATION_PREFIX = "nav";
var NAVIGATION_LS_KEY = "ind.navTopics";
var SEPARATOR = "_";
var EXTRA_TOPICS = [''];


/*
|--------------------------------------------------------------------------
| CONFIGURACIÓN POPUP DE PREFERENCIAS
|--------------------------------------------------------------------------
*/

var NOTIFICATION_PREFERENCES_STORAGE_KEY =
    'indigitall_notification_preferences_saved';

var NOTIFICATION_PREFERENCES_TOPICS_KEY =
    'indigitall_notification_topics';

var notificationPreferencesModalOpened = false;

window.notificationPreferenceTopics = [];


/*
|--------------------------------------------------------------------------
| CÓDIGO ORIGINAL INDIGITALL
|--------------------------------------------------------------------------
*/

function isDeviceRegisteredOnIndigitall() {

    var p = localStorage.getItem(
        "indigitall.repository.PERMISSION_PUSH"
    );

    var isDeviceRegistered = false;

    if (p === "accept") {

        p = "acceptedOnThisDomain";
        isDeviceRegistered = true;

    } else if (p === "reject") {

        p = "notAcceptedOnThisDomain";
        isDeviceRegistered = false;

    } else {

        p = "acceptedOnOtherDomain";
        isDeviceRegistered = true;

    }

    return isDeviceRegistered;
}


/*
|--------------------------------------------------------------------------
| INDIGITALL LOADED
|--------------------------------------------------------------------------
*/

function onIndigitallLoaded() {

    indigitall.init({

        appKey: '3ac96f72-a946-45a1-93cb-fc62deae69f1',

        urlDeviceApi:
            'https://am1.device-api.indigitall.com/v1',

        workerPath:
            'https://www.eleconomista.com.mx/worker.min.js',

        requestLocation: true,

        onInitialized:
            onIndigitallInitialized
    });


    if (
        indigitall.isSafariPushNotificationSupported() &&
        !localStorage.getItem(
