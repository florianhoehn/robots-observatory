/*********topNavBar starts********/
.topNavBar{border-top:1px solid var(--border-gray-light);border-bottom:1px solid var(--border-gray-light);}
nav #menu-button{display:none;}
.primary-nav{float:left;width:auto;max-width:1292px;padding:0;margin:0;position:relative;z-index:5;width:100%;padding-right:30px;}
.primary-nav ul, 
.primary-nav ul li, 
.primary-nav ul li a, 
.primary-nav #menu-button{margin:0;padding:0;border:0;list-style:none;display:block;position:relative;-webkit-box-sizing:border-box;-moz-box-sizing:border-box;box-sizing:border-box;z-index:99}
.primary-nav{position:static;}
.primary-nav #menu-button, 
.primary-nav ul li:before{display:none;}
.primary-nav ul.main-nav{display:inline-flex;align-items:stretch;flex-wrap:nowrap}
.primary-nav ul{position:static}
.primary-nav ul > li{float:left;overflow:visible;position:relative}
.primary-nav ul > li + li{margin-left:30px;}
.primary-nav ul > li > a{display:inline-flex;align-items:center;justify-content:flex-start;gap:5px;padding:10px 0;font-size:16px;line-height:22px;color:var(--black-11);text-decoration:none;text-transform:none;white-space:nowrap;font-weight:600;}
html[lang="hi"] .primary-nav ul > li > a{font-size:18px;padding-top:13px;padding-bottom:7px;}
.primary-nav ul > li > a .svg-icon{display:inline-flex;}
html[lang="hi"] .primary-nav ul > li > a .svg-icon{margin-top:-6px;}
.primary-nav ul > li.has-sub > a{padding-right:12px;position:relative;}
.primary-nav ul > li .submenu-button{position:absolute;top:11px;right:0;z-index:5;width:auto;height:auto;display:none;}
.primary-nav ul > li.has-sub > a:after{content:'';display:inline-block;position:absolute;right:0;top:16px;z-index:5;width:5px;height:5px;border-top:1px solid var(--black-11);border-right:1px solid var(--black-11);transform:rotate(136deg);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;transition:transform .25s linear;-webkit-transition:-webkit-transform .25s linear;}
.primary-nav ul > li.has-sub:hover > a:after,
.primary-nav ul > li.has-sub > a:hover:after{transform:rotate(-45deg);top:20px;}
.primary-nav ul > li > a:before{content:'';top:auto;bottom:-2px;height:3px;position:absolute;width:100%;overflow:hidden;-webkit-transform:scaleX(0);-ms-transform:scaleX(0);transform:scaleX(0);-webkit-transform-origin:right center;-ms-transform-origin:right center;transform-origin:right center;-webkit-transition:-webkit-transform .4s cubic-bezier(0.645,.045,.355,1);transition:transform .4s cubic-bezier(0.645,.045,.355,1);background:var(--orange);z-index:-1;border-radius:0;}
.primary-nav ul > li:hover > a:before, 
.primary-nav ul > li > a:hover:before,
.primary-nav ul > li.current-menu-item > a:before, 
.primary-nav ul > li.current-menu-ancestor > a:before{-webkit-transform:none;-ms-transform:none;transform:none;-webkit-transform-origin:left center;-ms-transform-origin:left center;transform-origin:left center;width:100%}
.primary-nav ul ul > li > a:before{display:none;}
.primary-nav ul ul li.has-sub > a:after{right:10px!important; top:16px!important; left: auto;border:0;border-top:1px solid var(--black-11);border-right:1px solid var(--black-11);transform: rotate(45deg)!important;}

.primary-nav ul > li.highlights{padding:6px 0;}
.primary-nav ul > li.highlights > a{color:var(--orange); border-radius:6px; border:1px solid var(--orange); padding:3px 10px;}
.primary-nav ul > li.highlights > a:hover{color:var(--white);border-color:var(--orange); background-color:var(--orange);}
.primary-nav ul > li.highlights > a::before{display:none!important;}
html[lang="hi"] .primary-nav ul > li.highlights > a{padding-top:6px!important;padding-bottom:0!important;}
 
 
/********sub nav menu********/
.primary-nav ul ul ul:before,
.primary-nav ul ul ul:after{display:none}
.primary-nav > ul.nav > li > ul{top:100%;}
.primary-nav ul ul ul{left:100%;}
.primary-nav ul ul > li:hover > ul{left:98%;top:0;}
@media only screen and (min-width:1024px){
.primary-nav ul li ul{-moz-transition:.3s linear!important;-webkit-transition:.3s linear!important;-ms-transition:.3s linear!important;transition:.3s linear!important;}
}
.primary-nav ul ul li{float:left;width:100%;padding:0;margin:0!important;vertical-align:top;overflow:visible;}
.primary-nav ul ul li + li{border-top:1px solid var(--border-gray-light)}
.primary-nav ul ul li:last-child{border-bottom:none}
.primary-nav ul ul li a{font-weight:normal;width:auto;white-space:normal;text-transform:capitalize;text-transform:none;font-size:16px!important;line-height:1.48;color:var(--black-11);padding:8px 10px 8px 20px!important;text-decoration:none;transition:none;-moz-transition:none;-webkit-transition:none;-ms-transition:none;-o-transition:none;font-weight:600;display:block}
html[lang="hi"] .primary-nav ul ul li a{font-size:18px!important; padding-top:12px!important; padding-bottom:4px!important;}
.primary-nav ul ul li.has-sub a{padding-right:35px}
.primary-nav ul ul ul li a{text-transform:none!important;}
.primary-nav ul li.current-menu-item > a, 
.primary-nav ul li.current-menu-ancestor > a{color:var(--orange);background-color:transparent;}
.primary-nav ul > li.current-menu-item > a:before,
.primary-nav ul > li.current-menu-item:hover > a:before,
.primary-nav ul > li.current-menu-ancestor > a:before,
.primary-nav ul > li.current-menu-ancestor:hover > a:before{transform-origin:top right;transform:scaleX(1)}
.primary-nav ul ul li:hover > a, 
.primary-nav ul ul li > a:hover, 
.primary-nav ul ul li.current-menu-item > a, 
.primary-nav ul ul li.current-menu-ancestor > a{color:var(--black-11);background:var(--color-05);}
.primary-nav ul > li#navlinks-primary{display:none;}
/**********Nav ends********/

/************sub menu starts************/
.primary-nav ul > li > ul{position:absolute;top:calc(100% + 1px);left:0;width:168px;margin:0;padding:0;background-color:var(--white);text-align:left;visibility:hidden;align-items:flex-start;background-clip:padding-box;-webkit-transition:.2s;opacity:0;transform:translateY(15px);border-radius:0;box-shadow:0px 3px 6px #00000029;}
.primary-nav ul > li > ul.auto-nav-more-list{right:0;left:auto;}
.primary-nav ul > li:hover > ul{opacity:1;visibility:visible;-webkit-transition:.45s;transform:translateY(0);max-height:800px;}
.primary-nav ul > li > ul li ul{left:100%;top:0;width:225px}
.primary-nav ul > li:hover > ul li ul{top:0}
.primary-nav ul > li ul li{display:block;border-bottom:none;border-left:none}
.primary-nav ul > li ul li:hover{background:var(--white)}
.primary-nav ul > li ul li:last-child{border-bottom:none}
.primary-nav ul ul li a:after{content:'';height:5px;width:5px;display:block;border:1px solid var(--black-11);border-right-width:0;border-top-width:0;transform:rotate(-135deg);position:absolute;top:11px;left:15px;background:none;display:none;}
.primary-nav ul > li > ul > li:hover > a:before{opacity:1}
/************sub menu ends************/

/************more in nav starts************/
.primary-nav ul > li.auto-nav-more{position:absolute;right:0px;top:0;background-color:var(--white)!important;z-index:106;margin:0; padding:0!important;}
.primary-nav ul > li.auto-nav-more,
.primary-nav ul > li.auto-nav-more a.more-nav{width:35px;height:42px;}
.primary-nav ul > li.auto-nav-more .submenu-button{display:none;}
.primary-nav ul > li.auto-nav-more ul.auto-nav-more-list:before{content:'';height:0;width:0;display:block;border:5px transparent solid;border-top-width:0;border-bottom-color:var(--color-1);position:absolute;right:17px;top:-5px;z-index:55}
.primary-nav ul > li.auto-nav-more a.more-nav{padding:0!important;outline:0;border:0;background:none;position:relative;font-size:0;border-radius:0}
.primary-nav ul > li.auto-nav-more a.more-nav:before{display:none}
.primary-nav ul > li.auto-nav-more a.more-nav:after{content:'';height:5px!important;width:5px!important;background:var(--orange);border-radius:5px;display:block;position:absolute;top:8px;left:13px;right:auto;box-shadow:0 10px 0 var(--orange), 0 20px 0 var(--orange);border-top:0; border-right:0;transform:inherit;}
.primary-nav ul > li.auto-nav-more:hover .more-nav{background:var(--color-05);}
.primary-nav ul > li.auto-nav-more ul.auto-nav-more-list{left:auto;right:0;}
.primary-nav ul > li.auto-nav-more ul.auto-nav-more-list ul{left:auto;right:97%;}
.topNavBarInner{float: left; width:100%;}
.topNavBarInner:after{position:absolute;right:-100%;top:1px;bottom:1px;width:100%;height:auto;content:'';background-color:var(--white);z-index:106}
/************more in nav ends************/

/*********top right icons starts********/
.top-right-icons{display:inline-flex;justify-content:flex-start;align-items:center;}
.top-right-icons ul{gap:10px;width:auto;flex-wrap:nowrap;}
.top-right-icons ul li{display:inline-flex;}
.top-right-icons ul li .svg-icon,
.top-right-icons ul li span,
.top-right-icons ul li a{display:inline-flex;align-items:center;justify-content:center;width:35px;height:35px;border-radius:4px;cursor:pointer;}
.top-right-icons ul li.searchAll{overflow:hidden;}
.top-right-icons ul li .search-triger{display:inline-flex;}
.top-right-icons ul li img{max-width:20px;display:inline-flex;cursor:pointer;}
.top-right-icons ul li .svg-icon:hover,
.top-right-icons ul li span:hover,
.top-right-icons ul li a:hover{background-color:var(--light-yellow);}
.top-right-icons ul li .search-icon{background-color:var(--border-gray-light);}
.top-right-icons ul li .login{border-radius:100px;}
.top-right-icons ul li .login img{max-width:24px;}
.top-right-icons ul li.notification{position:relative;}
.top-right-icons ul li.notification .no{background-color:var(--red);color:var(--white);text-align:center;font-size:9px;line-height:14px;border-radius:30px;width:14px;height:14px;position:absolute;right:4px;top:0;font-weight:600;}
html[lang="hi"] .top-right-icons ul li.notification .no{padding-top:2px;}
.top-right-icons ul li.google-preferred-btn,
.top-right-icons ul li.google-preferred-btn a,
.top-right-icons ul li.google-preferred-btn img{width:122px;height:36px;max-width:inherit;}

