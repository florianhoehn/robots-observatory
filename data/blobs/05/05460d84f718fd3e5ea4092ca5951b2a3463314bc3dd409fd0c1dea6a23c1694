<script>
$(document).ready(function () {
    $('#forgotPasswordLink').click(function () {
        const emailField = $('#email');
        if (!emailField) return;

        const email = emailField.val();
        if (!email) return;

        sessionStorage.setItem("FORM_LOGIN_EMAIL", email);
    });
});
