    <script>
      (function () {
        const isNativeApp =
          window.webkit &&
          window.webkit.messageHandlers &&
          window.webkit.messageHandlers.nativeApp;

        if (isNativeApp) {
          if (!window.bfcacheHandler) {
            window.bfcacheHandler = {};
          }
          window.bfcacheHandler.payload = {};
          window.bfcacheHandler.onRestore = function (payload) {};

          window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
              try {
                window.bfcacheHandler.onRestore(window.bfcacheHandler.payload);
                console.log('BFCache Page restored');
              } catch (err) {
                console.error('Error Restoring Page from BFCache', err);
              }
            }
          });
        }
      })();
    </script>
