      @font-face {
        font-family: Inter-Regular;
        src: url(https://cdn.wm.com/content/dam/wm/fonts/inter-regular.woff2)
          format("woff2");
      }
      body {
        font-family: Maax-Black, HelveticaNeue-Light, Helvetica Neue Light,
          Helvetica Neue, Helvetica, Arial, Lucida Grande, sans-serif;
        font-weight: 300;
        font-size: 16px;
        margin: 0;
        padding: 0;
      }
      a {
        text-decoration: none;
        color: #108db8;
        font-weight: 700;
      }
      img {
        max-width: 100%;
      }
      nav {
        width: 100%;
        background: #108db8;
      }
      nav a {
        color: #fff;
        padding: 1rem;
        display: inline-block;
      }
      .Search-icon {
        background-image: url(https://cdn.wm.com/content/dam/wm/icons/error-search-icon.svg);
        background-repeat: no-repeat;
        padding-left: 20px;
        cursor: pointer;
      }
      input {
        padding-left: 2px;
        font-size: 16px;
        background-color: #fff !important;
        color: #767676;
        font-weight: 400;
        line-height: 1.1876em;
        font-family: Inter-Regular;
      }
      .content {
        padding: 1rem;
        height: 1080px;
      }
      .App {
        text-align: center;
      }
      .heading-style {
        font-family: Maax-Regular, Arial, sans-serif;
        color: #fff;
        font-size: 20px;
        line-height: 1.2;
        padding-top: 5vh;
      }
      .heading-style-main {
        margin-bottom: 0;
        font-size: 56px;
      }
      .heading-style-sub {
        font-weight: 100;
        font-size: 22px;
        margin-top: 1rem;
      }
      .Search-form {
        display: grid;
        justify-items: center;
        text-align: left;
      }
      .Search-form .container {
        color: "#4f4f58";
        font-family: Inter-Bold, Arial, sans-serif;
        font-style: normal;
        background: #fff;
        padding: 1.5rem;
        min-width: 300px;
        max-width: 700px;
        width: 90%;
      }
      @media screen and (max-width: 376px) {
        .customer-support {
          font-size: 15px;
        }
        .Search-form .container {
          padding: 1rem;
        }
      }
      @media screen and (max-width: 321px) {
        .Search-form .container {
          min-width: 250px;
        }
        .customer-support {
          font-size: 13px;
        }
      }
      @media screen and (min-width: 1025px) {
        .Search-form {
          padding: 0 16rem;
        }
        .heading-style-main {
          padding-left: 1rem;
        }
      }
      @media screen and (max-width: 767px) {
        .content {
          padding: 3rem 1rem 1rem;
        }
      }
      .heading {
        color: #4f4f58;
        font-weight: 600;
        padding-top: 5px;
      }
      .customersupportLink {
        padding: 1rem 0;
      }
      .OR-option {
        padding: 1.5rem 0;
        width: 100%;
        display: grid;
        grid-template-columns: 45% 10% 45%;
        font-family: normal;
      }
      .OR-option > div {
        height: 2px;
        background: #d6d6d6;
        width: 50%;
        margin-top: 0.5rem;
        width: 100% !important;
      }
      .OR-option > span {
        justify-self: center;
        color: #4f4f58;
        font-family: Inter-Regular, Arial, sans-serif;
        font-style: normal;
      }
      input {
        border: none !important;
        width: 100%;
      }
      input:active,
      input:focus {
        outline: none !important;
      }
      .submit-form label {
        padding-left: 2px;
      }
      .submit-form {
        border: 1px solid #d6d6d6;
        border-radius: 4px;
        display: grid;
        grid-template-columns: 6% 94%;
        padding: 0.8rem;
      }
      .submit-form:hover {
        border-color: rgba(0, 0, 0, 0.87);
      }
      .searchName {
        color: #4f4f58;
        font-weight: 600;
        padding-bottom: 1rem;
        text-align: left;
      }
      .customer-support {
        display: inline-flex;
        padding: 6px 4px 12px;
        line-height: 1.5rem;
      }
      .customer-support img {
        justify-self: center;
        min-height: 14px;
        margin-left: 0.625rem;
      }
      .buttonArrowText {
        display: inline-flex !important;
        color: green;
      }
      .list-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
      }
      .customer-support > img {
        max-width: 9px;
      }
      .logo-svg {
        display: flex;
        justify-content: center;
      }
      @media screen and (max-width: 767px) {
        .list-container {
          display: grid;
          grid-template-columns: 1fr;
        }
      }
      @media screen and (min-width: 1336px) {
        .list-container {
          display: grid;
          grid-template-columns: 1fr 1fr;
        }
      }
      @media screen and (max-width: 760px) {
        .heading-style {
          padding-top: 0;
        }
      }
