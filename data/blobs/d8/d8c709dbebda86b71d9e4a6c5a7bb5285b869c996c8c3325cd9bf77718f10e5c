        .input-container .floating-label {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #626772;
            font-size: 14px;
            pointer-events: none;
            transition: all 0.2s ease;
            background: transparent;
        }

        .input-container input:focus+.floating-label,
        .input-container input:not(:placeholder-shown)+.floating-label {
            top: 4px;
            font-size: 11px;
            color: #626772;
            transform: translateY(0);
            margin-bottom: 2px;
        }

        .input-container input:focus+.floating-label.error,
        .input-container input:not(:placeholder-shown)+.floating-label.error {
