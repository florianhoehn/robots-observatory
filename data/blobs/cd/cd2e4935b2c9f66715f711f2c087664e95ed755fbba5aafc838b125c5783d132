<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Page not found | Bentley Systems</title>
    <style>
        :root {
            color-scheme: light;
            font-family: Arial, Helvetica, sans-serif;
            color: #25262a;
            background: #f7f8fa;
        }

        * { box-sizing: border-box; }
        body { margin: 0; }
        .not-found-page {
            min-block-size: 100vh;
            display: grid;
            place-items: center;
            padding: 2rem;
            text-align: center;
        }

        .not-found-page__content { width: min(100%, 42rem); }
        .not-found-page__brand {
            display: inline-block;
            margin-block-end: 3rem;
            color: inherit;
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -.03em;
            text-decoration: none;
        }

        .not-found-page__code {
            margin: 0 0 .75rem;
            color: #56616f;
            font-family: monospace;
            font-size: .875rem;
            font-weight: 600;
            letter-spacing: .08em;
        }

        .not-found-page__title {
            margin: 0;
            font-size: clamp(2.25rem, 7vw, 4.5rem);
            line-height: 1;
            letter-spacing: -.04em;
        }

        .not-found-page__message {
            max-width: 34rem;
            margin: 1.5rem auto 2rem;
            font-size: 1.125rem;
            line-height: 1.6;
        }

        .not-found-page__home {
            display: inline-block;
            padding: .875rem 1.25rem;
            border-radius: .25rem;
            background: #25262a;
            color: #fff;
            font-weight: 700;
            text-decoration: none;
        }

        .not-found-page__home:hover { background: #3b3d42; }
        .not-found-page__home:focus-visible {
            outline: 3px solid #0570dd;
            outline-offset: 3px;
        }
    </style>
</head>
<body>
    <main id="main-content" class="not-found-page" tabindex="-1">
        <div class="not-found-page__content">
            <a class="not-found-page__brand" href="/" aria-label="Bentley Systems home">Bentley Systems</a>
            <p class="not-found-page__code">ERROR 404</p>
            <h1 class="not-found-page__title">Page not found.</h1>
            <p class="not-found-page__message">The page you requested could not be found. Let’s get you back on track.</p>
            <a class="not-found-page__home" href="/">Return to home</a>
        </div>
    </main>
</body>
</html>
