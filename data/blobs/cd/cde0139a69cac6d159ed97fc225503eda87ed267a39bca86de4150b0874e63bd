<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
    <title>Erreur de navigation - Crédit Mutuel</title>
    <style>
        * {
			box-sizing: border-box;
		}

		.show {
			display: block;
		}

		.hide {
			display: none;
		}

		.hideifscript .defaultlang {
			display: block;
		}

		body {
			background-color: #fff;
			margin: 0;
			font-family: InterVariable, Arial, Helvetica, sans-serif;
			font-weight: 400;
		}

		main {
			display: block;
			padding: 0;
		}

		.invisible {
			position: absolute;
			left: -99999px;
		}

		.main-header {
			position: relative;
			width: 100%;
			padding: 16px 12px;
			background-color: #fff;
			box-shadow: 0 0 8px 0 rgba(134,134,134,0.5)
		}

		.main-header:after {
			position: absolute;
			display: block;
			content: "";
			background-color: #e0e0e0;
			width: 100%;
			height: 3px;
			bottom: 0;
			left: 0;
			right: 0;
			top: auto;
		}

		.main-article {
			padding: 16px 0 24px;
		}

		.wrapper {
			max-width: 100%;
			margin: auto;
		}

		h1 {
			color: #161616;
			font-size: 2.1rem;
			line-height: 42px;
			margin-top: 0;
		}

		h2 {
			color: #3c5daa;
			font-weight: 400;
		}

		a {
			color: #fff;
			text-decoration: none;
		}

		a:hover,
		a:focus {
			color: #fff;
			text-decoration: underline;
		}
		
		a.btn {
			display: inline-flex;
			justify-content: center;
			align-items: center;
			border-radius: 25px;
			padding: 12px 20px;
			font-size: 16px;
			font-weight: 700;
			text-decoration: none;
			position: relative;
			overflow: hidden;
			background-color: #003192;
		}

		a.btn span {
			position: relative;
			z-index: 10;
		}

		a.btn:before {
			content: "";
			position: absolute;
			top: 0; left: 0; right: 0; bottom: 0;
			z-index: 1;
			pointer-events: none;
			transition: background-color 0.3s ease-in-out;
			border-radius: 0;
		}

		a.btn:hover:before { background-color: rgba(0,0,0,0.38); }

		.logo {
			display: inline-block;
			position: relative;
			margin: 0 12px;
		}

		#ei_tpl_logo span {
			position: absolute;
			left: -1000px;
		}
		
		.container {
		  	display: grid;
			grid-template-columns: repeat(4, 1fr);
			justify-content: center;
			overflow: hidden;
			margin-top: 125px;
		}
		.item {
			position: relative;
			z-index: 1;
		}
		
		.item_left {
			grid-column: 2/4;
			grid-row: 1;
			z-index: 2;
			width: 22rem;
		}
		.item_left img {
			width: 22rem;
			height: 19.6875rem;
			position: relative;
			top: 5.2rem;
		}
		
		.item_right {
			grid-column: 1/4;
			grid-row: 1;
			margin-left: 1.5rem;
		}
		
		.item_right:after {
		  content: url("https://sit-cdnwm.e-i.com/SITW/wm/global/1.0.0/af/assets/shapes/ellipse_old.svg");
		  position: absolute;
		  top: 3.375rem;
		  width: 900px;
		  height: fit-content;
		  z-index: -1;
		}
		
		@media (max-width: 1024px) {
			.item_left {
				width: auto;
				height: calc(5.2rem + 19.6875rem);
			}
			.item_left img {
				width: 28.875rem;
				/*height: auto;*/
			}
			.item_right {
				display: flex;
				justify-content: space-between;
				flex-direction: column;
				max-width: 39.5rem;
				min-height: 500px;
			}
			.item_right h1, .item_right a {
				width: 100%;
			}
			.item_right h1 {
				margin-top: 0;
				width: 100%;
			}
			item_right a {
				margin-bottom: 8px;
			}
		}
		@media (max-width: 640px) {
			.container {
				margin-top: 24px;
			}
			.item_left {
				width: 22rem;
				height: 22rem;
			}
			.item_left img {
				width: 22rem;
				height: auto;
			}
			.item_right {
				max-width: none;
				min-height: 410px;
			}
			.item_right h1 {
				font-size: 1.4rem;
				line-height: 1.65rem;
				width: 80%;
			}
		}
		
		@media screen and (max-width: 1023px) {
			.hidesm {
				display: none!important;
			}
		}
		
		@media (min-width: 1024px) {
			.showsm {
				display: none!important;
			}
			.item_left {
				grid-column: 2/3;
				grid-row: 1;
				width: 100%;
			}
			.item_left img {
				top: 0;
				width: 26rem;
				height: 28.875rem;
			}
			.item_right {
				grid-column: 3/4;
				padding: 0;
				margin-left: 3rem;
				min-width: 39.5rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
			}
			.item_right:after {
				top: 0;
				rotate: 4deg;
				left: 38px;
			}
			.item_right h1 {
				width: 86%;
			}
			.item_right a {
				width: 50%;
			}
		}
		
		@media screen and (max-width: 768px) {
			.main-header {
				padding: 16px 8px;
			}
		}
	</style>
</head>

<body>
