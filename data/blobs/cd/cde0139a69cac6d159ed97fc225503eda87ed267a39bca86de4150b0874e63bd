    <script type="text/javascript">
    window.onload = function() {
        var errPage = document.getElementById("errPage");

        //---------------------- On selectionne ici la langue par défaut du site --------------------------
        var defaultLang = "fr";
        // /!\ ATTENTION /!\ déplacer également la classe '.defaultlang' sur le bloc correspondant
        //-------------------------------------------------------------------------------------------------

        //Detection langue navigateur + compatibilité IE
        var navLang = navigator.userLanguage || navigator.language;

        //On sélectionne les deux premiers caractères retournés par navLang qui correspondent à la langue.
        var Lang = navLang.substring(0, 2);

        if (errPage) {
            errPage.classList.remove("hideifscript");
            errPage.classList.add("js-active");

            //Français
            if (Lang === "fr") {
                document.title = "Erreur de navigation (404)";
                hideShow(Lang);
                //setURL(Lang);

                //Anglais
            } else if (Lang === "en") {
                document.title = "Navigation error (404)";
                hideShow(Lang);
                //setURL(Lang);

                //Italien
            } else if (Lang === "it") {
                document.title = "Errore di navigazione (404)";
                hideShow(Lang);
                //setURL(Lang);

                //Espagnol
            } else if (Lang === "es") {
                document.title = "Error de navegación (404)";
                hideShow(Lang);
                //setURL(Lang);

                //Allemand
            } else if (Lang === "de") {
                document.title = "Navigationsfehler (404)";
                hideShow(Lang);
                //setURL(Lang);

                //Néerlandais
            } else if (Lang === "nl") {
                document.title = "Navigatiefout (404)";
                hideShow(Lang);
                //setURL(Lang);
            } else {
                hideShow(defaultLang);
                //setURL(defaultLang);
            }
        } else {
            return 0;
        }

        //Fonction hide/Show
        function hideShow(lang) {
            //On crée une variable qui cible l'élement voulu par son id par rapport à la langue
            let selectLang = document.getElementById(lang);

            //On enlève la classe 'hide' selon l'id selectionné
            selectLang.classList.remove("hide");

            //On ajoute la classe 'show' selon l'id sélectionné
            selectLang.classList.add("show");
        }
    };
    </script>
