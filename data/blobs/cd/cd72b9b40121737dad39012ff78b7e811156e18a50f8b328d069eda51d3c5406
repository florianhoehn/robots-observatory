.kyroo-banner--plus{--ink:#302566;--muted:#6c5d91;--accent:#5d48de;background:#f1eef9}

.kyroo-banner--plus .kyroo-banner__cta{background:#473d8a;color:#f1effa}

.kyroo-banner__plus{width:148px;height:148px;top:50%;right:max(32px,calc((100% - 1360px)/2));transform:translateY(-50%);background:#ded6f2;mask:url("data:image/svg+xml;base64,") center/contain no-repeat}

/* Translation only: brand arrows keep their original, horizontal geometry. */

@keyframes kyroo-return{from{translate:42px 0;opacity:0}to{translate:0 0}}

@keyframes kyroo-settle{from{translate:0 10px;opacity:.2}to{translate:0 0;opacity:1}}

.kyroo-banner[data-motion=on] .kyroo-banner__arrows i{animation:kyroo-return 1.25s cubic-bezier(.16,1,.3,1) both}

.kyroo-banner[data-motion=on] .kyroo-banner__arrows i:first-child{animation-delay:100ms}

