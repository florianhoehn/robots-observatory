<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
	<title>Error 404: Not Found</title>
	<meta name="description" content="">
	<meta name="viewport" content="width=device-width">
	<style>
		html,body {
			margin: 0;
			padding: 0;
		}
		.logo {
			margin: 2em;
		}
		.error {
			text-align: center;
		}
		.error a {
			color: #00759c;
			font-size: 1.3em;
		}
		.error-message {
			background: #ffe6e1;
			padding: 1em;
		}
		h1 {
			color: #ff718f;
			margin: 0;
			font-size: 2.5em;
			font-family: Tahoma, Roboto, Arial, monospace;
		}
	</style>
</head>
<body>
<div class="error">
	<div>
		<div class="logo"><a href="/"><img width="304" src="/img/forecast7-big.svg" alt="Forecast7.com Logo"></a></div>
		<div class="error-message">
				<h1>Error 404: Page not found</h1>
				<p>
					The page you were looking for cannot be found or has been removed from this server.<br>
					Please re-check the URL or click the link below to go to the homepage.
				</p>
			<div><a href="/">return to the homepage</a></div>
		</div>
	</div>
</div>
</body>
</html>
