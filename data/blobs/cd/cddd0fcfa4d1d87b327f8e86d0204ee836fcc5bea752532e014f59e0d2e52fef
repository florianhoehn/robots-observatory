  .nav-rjb > li { border-right:none; border-bottom:1px solid #4d4d4d; box-shadow:none; }
  .nav-rjb > li:first-child { border-left:none; box-shadow:none; }
  .nav-rjb > li > a { height:48px; font-size:14px; padding:0 20px; justify-content:space-between; }

  /* accordion */
  .nav-rjb .rjb-drop { position:static; border:none; box-shadow:none; background:#2e2e2e; min-width:0; display:none; }
  .nav-rjb > li.mob-open .rjb-drop { display:block; }
  .nav-rjb > li.mob-open > a .rjb-arrow { transform:rotate(180deg); }
