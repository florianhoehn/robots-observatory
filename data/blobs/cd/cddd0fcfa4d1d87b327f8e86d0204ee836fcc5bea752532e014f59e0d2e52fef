<style>
/* ── Menu principal ojogodobicho.com ── */
.nav-rjb-wrap { background:#4d4d4d; position:relative; z-index:500; }

/* toggle hamburger — oculto no desktop */
.nav-rjb-toggle { display:none; }

/* atalhos fixos do mobile — ocultos no desktop */
.nav-rjb-quick { display:none; }

/* lista principal */
.nav-rjb {
  list-style:none;
  display:flex;
  flex-wrap:nowrap;
  margin:0 auto; padding:0;
  max-width:940px;
}

/* itens de primeiro nível */
.nav-rjb > li {
  position:relative;
  border-right:1px solid #3a3a3a;
  box-shadow:1px 0 0 rgba(255,255,255,.1) inset;
}
.nav-rjb > li:first-child {
  border-left:1px solid #3a3a3a;
  box-shadow:none;
}

/* links de primeiro nível */
.nav-rjb > li > a {
  display:flex;
  align-items:center;
  gap:5px;
  padding:0 15px;
  height:42px;
  color:#e6e6e6;
  text-decoration:none;
  font-size:13px;
  font-weight:bold;
  white-space:nowrap;
  transition:background .15s;
}
.nav-rjb > li > a .rjb-arrow { font-size:8px; opacity:.7; transition:transform .2s; }

.nav-rjb > li:hover > a,
.nav-rjb > li:focus-within > a { background:#333; }

.nav-rjb > li:hover > a .rjb-arrow,
.nav-rjb > li:focus-within > a .rjb-arrow { transform:rotate(180deg); }

/* dropdown */
.nav-rjb .rjb-drop {
  display:none;
  position:absolute;
  top:42px; left:0;
  min-width:205px;
  background:#fff;
  border:1px solid #ccc;
  border-top:3px solid #2ba6cb;
  list-style:none;
  z-index:999;
  box-shadow:0 6px 16px rgba(0,0,0,.18);
}
.nav-rjb > li:hover .rjb-drop,
.nav-rjb > li:focus-within .rjb-drop { display:block; }

.nav-rjb .rjb-drop li a {
  display:block;
  padding:11px 16px;
  color:#333;
  text-decoration:none;
  font-size:13px;
  border-bottom:1px solid #ebebeb;
  transition:background .12s, padding-left .1s;
}
.nav-rjb .rjb-drop li:last-child a { border-bottom:none; }
/* LOOK (Goias): cor da palheta verde. E a pista, ANTES do clique, de que o
   item leva para outra apuracao — nao para o RJ. Decisao do doc de SEO §5.3. */
.nav-rjb > li.nav-look > a { color:#8fe3b4; }
.nav-rjb > li.nav-look:hover > a,
.nav-rjb > li.nav-look:focus-within > a { background:#0d6b3f; color:#fff; }
.nav-rjb-quick a.quick-look { color:#8fe3b4; }
.nav-rjb .rjb-drop li a:hover { background:#2ba6cb; color:#fff; padding-left:20px; }

/* ── MOBILE ≤ 767px ── */
@media (max-width:767px) {
  .nav-rjb-toggle {
    display:flex;
    align-items:center;
    justify-content:space-between;
    width:100%;
    padding:0 14px;
    height:48px;
    background:#4d4d4d;
    border:none;
    color:#e6e6e6;
    font-size:14px;
    font-weight:bold;
    cursor:pointer;
  }
  .nav-rjb-toggle .rjb-ham { display:flex; flex-direction:column; gap:5px; }
  .nav-rjb-toggle .rjb-ham span {
    display:block; width:22px; height:2px;
    background:#e6e6e6; border-radius:2px; transition:all .25s;
  }
  .nav-rjb-toggle.aberto .rjb-ham span:nth-child(1) { transform:rotate(45deg) translate(5px,5px); }
  .nav-rjb-toggle.aberto .rjb-ham span:nth-child(2) { opacity:0; }
  .nav-rjb-toggle.aberto .rjb-ham span:nth-child(3) { transform:rotate(-45deg) translate(5px,-5px); }

  /* atalhos fixos — sempre visíveis no mobile */
