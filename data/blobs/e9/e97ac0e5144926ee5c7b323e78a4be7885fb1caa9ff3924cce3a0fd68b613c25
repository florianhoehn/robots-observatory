function doPostFrame(url)
{
	var defaultAction = '/ocom/idcplg';
	var parts, action, params;
	
	if (url.indexOf("?") == -1)
	{
		params = url.split("&");
		action = defaultAction;
	}
	else
	{
		parts = url.split("?");
		action = parts[0];
	}
	
	if (parts != undefined && parts[1] != undefined)
	{
		params = parts[1].split("&");
	}

	params.push('idcToken=' + idcToken);

	var form = document.createElement("form");
	form.method = "POST";
	form.action = action;
		form.target = "contentFrame";
	for (var i in params) 
	{
		var tmp;
		if (params[i] != undefined)
		{
			tmp = params[i].split("=");
		}
		
		var key = tmp[0], value = decodeURI(tmp[1]);
		
		var element = document.createElement("input");
		element.type = "hidden";
		element.name = key;
		element.value = value;
		form.appendChild(element);
	}
	document.body.appendChild(form);
	form.submit();
}

