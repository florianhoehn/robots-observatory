	{
		if (taskModified || pageChanged)
		{
			if (!confirm("All changes will be lost. Continue?"))
			{
				tmpHref = obj.href;
				tmpObj = obj;

				obj.href="#";
				setTimeout("setBack()", 500);
			}
		}
		return true;
	}

	function setBack()
	{
		tmpObj.href = tmpHref;
	}

