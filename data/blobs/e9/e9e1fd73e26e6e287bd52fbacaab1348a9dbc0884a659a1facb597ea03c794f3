<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"/>
<meta http-equiv="X-UA-Compatible" content="ie=edge" />
<title>404</title>
<style>
  *{
    margin:0;
    padding:0;
  }
  html,body{
    min-height:100%;
    height: 100%;
  }
  body{
    background-image:url('/static/img/404_bg.png');
    background-repeat:no-repeat;
    background-position:center;
    background-size:cover;
  }
  .content{
    position:relative;
    top:calc(50% - 175px);
    text-align:center;
  }
  .content .desc{
    color:#fff;
    font-size:28px;
    font-weight:bold;
    margin-top:21px;
  }
  .content #search_form{
    width:593px;
    height:18px;
    padding:15px 16px;
    background: #FFFFFF;
    box-shadow: 0px 2px 8px 0px rgba(0, 0, 0, 0.42);
    margin:56px auto 0;
    text-align:left;
  }
  .content #search_form input{
    width:562px;
    border:0;
    outline:0;
    background:#fff;
    color:#333;
    font-size:16px;
    vertical-align:top;
  }
  .content #search_form img{
    float:right;
  }
</style>
<script defer data-domain="movieboxpro.app" src="https://www.movieboxpro.app/js/script.js"></script>
</head>
<body>
  <div class="content">
    <img src="/static/img/404_2.png" width="211">
    <p class="desc">Sorry, we can’t find the page</p>
    <form action="/index/search" method="get" id="search_form" results="5" autocomplete="off">
      <input type="text" name="word" placeholder="Search for movies, TV shows…" />
      <img src="/static/img/search_2.png" width="20">
    </form>
    <p style="margin-top:28px;"><img src="/static/img/logo3.png" width="111"></p>
  </div>
</body>
</html>