PTTS.override(
  [
    "modules/launcher/platforms/caliente-theme/base.3rdParty.platform",
    "managers/common-theme/org.manager",
    "user",
    "underscore",
    "i18n",
    "util/language.util",
    "modules/popup/popup.view",
    "util/server.util",
    "modules/launcher/platforms/common-theme/base.3rdParty.platform",
    "config", "util/url.util"
  ],
  function (
    BaseLauncher,
    orgManager,
    user,
    _,
    i18n,
    language,
    PopupView,
    serverUtil,
    BaseThirdParty,
    config, url
  ) {
    _.extend(BaseLauncher, {
      open: function (game, mode) {
        // singular changes between desktop & mobile platform
         this.provider = game.get(
          this.isDesktop() ? "gameType" : "mobileGameType",
        )
        var gameTypes = config.get(
          this.isDesktop()
            ? "thirdPartyDesktopGameTypes"
            : "thirdPartyMobileGameTypes",
        )

        var gameType = _.findWhere(gameTypes, { name: this.provider })
        var isPreviewMode = Number(config.get("previewMode")) === 1
        var isRedirectInNewWindow =
          (this.getLaunchOptions() || {}).launchMethod === "redirectInNewWindow"
        var gameWindow = isRedirectInNewWindow
          ? url.openNewWindowWithNoOpener()
          : null
        var typeUrl

        function failedLaunch() {
          if (gameWindow) {
            gameWindow.close()
          }

          new PopupView({
            data: {
              title:
                game.get("name") +
                " " +
                i18n.t(
                  "playtech.mobile.system.launcher.gameUnavailablePopup.title",
                ),
              content: i18n.t(
                "playtech.mobile.system.launcher.gameUnavailablePopup.desktop-content",
              ),
            },
          })
        }

        if (isPreviewMode) {
          typeUrl = gameType[mode ? "previewRealPlayUrl" : "previewDemoPlayUrl"]
        }

        if (!isPreviewMode || !typeUrl) {
          typeUrl = gameType[mode ? "realPlayUrl" : "demoPlayUrl"]
        }

        serverUtil
          .getURLsRequest({
            language: language.getTwoLetterLanguage(user.get("lang")),
            clientPlatform: this.isDesktop() ? "web" : "mobile",
            clientType:
              orgManager.getCurrentOrgName() === "bingo"
                ? "bingo"
                : config.get("clientType"),
            urlTypeList: [typeUrl],
          })
          .done(
            function (response) {
              var launchUrl = ""
              var baseUrl = ""
              var launchUrlParams

              if (response.data && response.data.urlList.length) {
                launchUrl = response.data.urlList[0].url || ""

                if (!launchUrl) {
                  return failedLaunch()
                }
                launchUrl = launchUrl
                  .replace(
                    /\[mobilegamecode]/g,
                    game.get("mobileGameCode") || game.get("gameCode"),
                  )
                  .replace(/\[gamecode]/g, game.get("gameCode"))
                  .replace("[gamename]", game.get("name"))
                  .replace(
                    "[language]",
                    language.getTwoLetterLanguage(user.get("lang")),
                  )
                  .replace("[back_url]", url.origin)
                  .replace(
                    "[integrationtype]",
                    game.get("integrationType") || "",
                  )
                  .replace(
                    "[roomname]",
                    game
                      .get("gameCode")
                      .trim()
                      .replace(/\s+/g, " ")
                      .toLowerCase()
                      .replace(/ /g, "-"),
                  )

                baseUrl = launchUrl.split("?")[0]
              
              } else {
                new PopupView({
                  data: {
                    title:
                      game.get("name") +
                      " " +
                      i18n.t(
                        "playtech.mobile.system.launcher.gameUnavailablePopup.title",
                      ),
                    content: i18n.t(
                      "playtech.mobile.system.launcher.gameUnavailablePopup.desktop-content",
                    ),
                  },
                })
                return
              }

              launchUrlParams = url.getURLParams(launchUrl)

              launchUrl = this.getGenericLaunchUrl(launchUrlParams, mode, {
                baseUrl: baseUrl,
              })

              this.launch({
                provider: this.provider,
                game: game,
                mode: mode,
                launchUrl: launchUrl,
                gameWindow: gameWindow,
              })
            }.bind(this),
          )
          .fail(failedLaunch.bind(this))
      },
    })
  },
)


