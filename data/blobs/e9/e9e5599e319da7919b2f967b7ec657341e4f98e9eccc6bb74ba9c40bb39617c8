    <script>
      var counter_click = 0;
      var on_click = document.getElementById("my-account");
      if (on_click) {
        on_click.addEventListener("click", function () {
          check_click(counter_click);
        });
      }

      function check_click() {
        counter_click++;
        counter_click = counter_click % 2;
        var display = document.getElementById("display-menu");
        if (counter_click) {
          on_click.classList.add("clicked");
          display.style.display = "block";
        } else {
          on_click.classList.remove("clicked");
          display.style.display = "none";
        }
      }
    </script>

