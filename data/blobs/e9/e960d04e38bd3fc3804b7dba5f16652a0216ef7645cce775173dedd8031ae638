      <script type="text/javascript">
        if (window.document.documentMode) {
          window.location.href =
            "https://www.scania.com/staticpages/outdated-browser/outdated-browser.html";
        }
        window.ScaniaNS = {};

        window.adobeDataLayer = window.adobeDataLayer || [];
        const siteType =
          "group";
        let country =
          "SE";
        const language =
          "EN";
        let pageName;
        const url = "\/content\/www\/group\/en\/home\/admin\/misc\/404\u002Derror";
        const parts = url.split("/home/");

        if (parts.length <= 1) {
          pageName = "home";
        } else {
          const pageNodes = parts[1].replace(/\//g, ":");
          pageName = "home:" + pageNodes;
        }

        if (siteType === "group") {
          country = "group";
        }

        const isCommunication = document.body.classList.contains('communication-template');
        const site = isCommunication ? "brand-portal" : "w3";

        if(isCommunication) {
          let section;
          if (parts.length <= 1 || parts[1] === "") {
            pageName = "home";
            section = "home";
          } else {
            const segments = parts[1].split("/").filter(Boolean);
            pageName = segments[segments.length - 1];
            section = segments.length > 1 ? segments[segments.length - 2] : "home";
          }
          window.adobeDataLayer.push({
              "event": "pageView",
              "pageInfo": {
                  "name": site + ":" + pageName,
                  "market": country.toLowerCase(),
                  "language": language.toLowerCase(),
                  "site": site,
                  "siteSection": section
              }
          });
        }
         else {
          adobeDataLayer.push({
            event: "pageView",
            pageInfo: {
              pageName: pageName,
              market: country.toLowerCase(),
              language: language.toLowerCase(),
              site: site,
            },
          });
        }
        
      </script>
      
        
      
        
          
        
      
       
      
      
        



