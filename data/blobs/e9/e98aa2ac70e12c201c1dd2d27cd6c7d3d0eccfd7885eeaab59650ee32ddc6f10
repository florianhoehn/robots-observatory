<style>
  /*==*/
  /* Force article content rich text to fill by default */

  .rich-text.cc-article figure.w-richtext-align-center.w-richtext-figure-type-image {
    /* default article figure imgs to 100% */
    width: 100%;
    max-width: 100%;
  }
  .rich-text.cc-article figure.w-richtext-align-center.w-richtext-figure-type-image > div,
  .rich-text.cc-article figure.w-richtext-align-center[data-rt-type='image'] > div {
    width: 100%;
  }

  /*==*/

  html:not(.wf-design-mode) .hide-live {
    display: none;
  }
  .component-initialized .tab-content_content.hide-live {
    display: block;
  }
  .component-initialized .tab-content_field.hide-live {
    display: flex;
  }
  /*==*/
  /* Page Overrides */
  .page-main:has(.landing-page_hero) {
    background: var(--_color---brand--50-beige, #f5eee5);
  }
  /*==*/
  /* Heading Blue Highlights and bolding tweaks */
  .blue-strong :is(h1, h2) :is(bold, strong) {
    font-weight: 500;
    color: var(--_color---brand--nextech-blue, #00a7b5);
  }

  .rich-text.cc-article h2 :is(strong, b),
  h3 :is(strong, b) {
    font-weight: 400;
    color: inherit;
  }

  /*==*/
  /* Rich text tweaks */
  .rich-text :is(p, blockquote, ol, ul) + :is(h2, h3, h4, h5, h6) {
    /* heading directly preceded by text element gets extra margin-top*/
    margin-top: 1rem;
  }

  .rich-text :is(figure, img, video) + :is(h2, h3, h4, h5, h6) {
    /* heading directly preceded by rich content element gets extra margin-top*/
    margin-top: 1.75rem;
  }

  .rich-text.extra-copy-space :is(p, ul, ol):not(first-child),
  .section-header.extra-copy-space .rich-text :is(p, ul, ol):not(first-child) {
    margin-top: 1.25rem;
  }

  @media screen and (min-width: 992px) {
    :is(.timeline-rich-text .rich-text, .rich-text.timeline-rich-text) :is(h2, h3) {
      font-size: 2rem;
    }
  }

  :is(.rich-text.border-images, .border-images .rich-text) img {
    border-radius: var(--_utilities---radius-xs-6px, 0.375rem);
  }
  /*==*/
  /* Timeline Divider */
  @media screen and (max-width: 768px) {
    .timeline-divider-col {
      flex: 0 1 auto !important;
      margin-right: 0.875rem;
    }
  }

  /*==*/
  /* Button Hover for Links */

  .button:hover .btn-text {
    /* text-decoration: underline; */
  }

  /*==*/

  /* Stretch columns where card is present */

  .row:has(.col > .card) .col {
    /* align-self: stretch; */
  }

  /*==*/

  /* Flex Sep List */

  .flex-sep-list .flex-sep-list_item:not(:last-child):after {
    content: '|';
    display: block;
    position: absolute;
    right: -0.25rem;
    top: 0;
  }

  /*==*/

  /* Menu link hover arrows*/
  .menu-item_link-text:after {
    --fa: '\f061';
    --_fa-family: var(--fa-family, var(--fa-style-family, 'Font Awesome 7 Pro'));
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    display: inline;
    font-family: var(--_fa-family);
    font-feature-settings: normal;
    font-style: normal;
    font-synthesis: none;
    font-variant: normal;
    font-weight: var(--fa-style, 900);
    line-height: 1;
    text-align: center;
    text-rendering: auto;
    width: var(--fa-width, 1.25em);
    content: var(--fa) / '';
    opacity: 0;
    transform: translateX(-100%);
    transition:
      opacity 0.2s,
      transform 0.2s;
    will-change: transform, opacity;
    margin-left: 10px;
  }
  :where(.menu-item_link[data-wf--menu-item-link--variant='plain']:hover, .menu-item_link[data-wf--menu-link-w-description--variant='plain']:hover) .menu-item_link-text:after {
    opacity: 1;
    transform: translateX(0%);
  }
  @media (prefers-reduced-motion: reduce) {
    :where(.menu-item_link[data-wf--menu-item-link--variant='plain']:hover, .menu-item_link[data-wf--menu-link-w-description--variant='plain']:hover) .menu-item_link-text:after {
      opacity: 0;
      transition: none;
    }
  }

  /*==*/

  /* Hide ToC until initialized */
  #table-of-contents:not(.initialized) .table-of-contents_item,
  #table-of-contents-mobile:not(.initialized) .table-of-contents_item {
    display: none;
  }

  #table-of-contents[hidden],
  #table-of-contents-mobile[hidden] {
    display: none;
  }

  /* Custom ToC Counter */

  .table-of-contents {
    counter-reset: item;
    list-style: none;
    padding-left: 0;
  }

  .table-of-contents > li {
    counter-increment: item;
  }

  .table-of-contents > li > a::before {
    content: counter(item, decimal-leading-zero) ' ';
    min-width: 1.5rem;
    display: none; /* ejh not a fan, but leaving this here in case it makes a comeback */
  }

  /*==*/

  /* Logo Garden custom */

  @media screen and (min-width: 768px) {
    .logo-garden_wrapper {
      container-type: inline-size;
    }

    @container (min-width: 1280px) {
      .logo-garden:has(> :nth-child(8):last-child) {
        justify-content: space-between;
      }
    }

    @container (max-width: 1279.98px) {
      .logo-garden {
        display: block;
        text-align: center;
        text-wrap: balance;
      }

      .logo-garden .logo-garden_holder {
        display: inline-block;
        margin: 0.75rem 1.75rem;
        line-height: 1;
      }
    }
  }

  /*==*/

  /* Button Hover */

  :where(.button, .button-hover-target) {
    --button-hover-chev-opacity: 1;
    --button-hover-chev-transform: translateX(0) scale(0.9);
    --button-hover-arrow-opacity: 0;
    --button-hover-arrow-transform: translateX(-0.25rem);
    --button-hover-arrow-delay: 0ms;
  }

  :where(.button, .button-hover-target) :where(.button-hover-chev, .button-hover-arrow) {
    position: absolute;
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  html.wf-design-mode :where(.button, .button-hover-target) .button-hover-arrow {
    display: none; /* hide arrow in design mode */
  }

  :where(.button, .button-hover-target) .button-hover-chev {
    opacity: var(--button-hover-chev-opacity);
    font-size: 0.9em;
    transform: var(--button-hover-chev-transform);
  }

  :where(.button, .button-hover-target) .button-hover-arrow {
    opacity: var(--button-hover-arrow-opacity);
    transform: var(--button-hover-arrow-transform);
    transition-delay: var(--button-hover-arrow-delay);
  }

  /* Parent/card hover */
  :where(.card:hover) :where(.button, .button-hover-target):not(.button-hover-noparent) {
    --button-hover-chev-opacity: 0;
    --button-hover-chev-transform: translateX(0.5rem) scale(0.85);
    --button-hover-arrow-opacity: 1;
    --button-hover-arrow-transform: translateX(0);
    --button-hover-arrow-delay: 40ms;
  }

  /* Direct hover */
  :where(button:hover, .button:hover, .button-hover-target:hover) {
    --button-hover-chev-opacity: 0;
    --button-hover-chev-transform: translateX(0.5rem) scale(0.85);
    --button-hover-arrow-opacity: 1;
    --button-hover-arrow-transform: translateX(0);
    --button-hover-arrow-delay: 40ms;
  }

  /*==*/

  /* Site Generic Styles */

  /* Apply font smoothing */
  body {
    -webkit-font-smoothing: antialiased;
    -moz-font-smoothing: antialiased;
    -o-font-smoothing: antialiased;
  }

  /* Rich text modifiers */
  .w-richtext > :first-child {
    margin-top: 0;
  }

  /* Line clamp modifiers */
  .u-text-clamp-1 {
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .u-text-clamp-2 {
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .u-text-clamp-3 {
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }

  /* Row/col gap modifiers */
  .row.row-gap-0 .col {
    --_layout---grid--gap-main: 0;
  }
  .row.row-gap-0:has(.col[class*='contain']) .col {
    --_layout---grid--gap-main: 1px;
  }
  .row.row-gap-md .col {
    --_layout---grid--gap-main: var(--_layout---grid--gap-md);
  }
  .row.row-gap-sm .col {
    --_layout---grid--gap-main: var(--_layout---grid--gap-sm);
  }
  .row.row-gap-button .col {
    --_layout---grid--gap-main: var(--_layout---grid--gap-button);
  }
  @media screen and (max-width: 768px) {
    .row.row-gap-timeline .col {
      --_layout---grid--gap-main: var(--_layout---grid--gap-sm);
    }
  }

  /* col/col slot gap modifiers */
  .col.col-gap-sm .slot {
    gap: var(--_layout---grid--gap-sm);
  }

  .col.col-gap-md .slot {
    gap: var(--_layout---grid--gap-md);
  }

  .col.col-gap-main .slot {
    gap: var(--_layout---grid--gap-main);
  }

  /* Build mode modifiers */
  /* TODO: Check ALL below against generated code */

  .slot .button:not([data-slider]) {
    align-self: flex-start;
  }
  /* .slot > *:last-child, */
  /* .slot > .heading-component:last-child *, */
  .slot > .rich-text-component:last-child .rich-text > *:last-child,
  .rich-text-component.u-mb-0 .rich-text > *:last-child,
  .eyebrow-component.u-mb-0 .eyebrow {
    margin-bottom: 0;
  }
  .slot.cc-column > .eyebrow-component {
    align-self: start;
  }
  .card:has(> .u-link-cover:focus-visible) {
    outline: 2px solid var(--primary--accent);
