        line-height: 1.4;
      }
      header {
        background-color: #ffef64;
        border-bottom: 1px solid #e7d85c;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
        padding: 16px 16px 14px;
        position: relative;
        text-align: center;
      }
      .tagline {
        display: none;
        color: #756d2d;
        margin-left: 10px;
        position: relative;
        top: -4px;
        font-size: 17px;
      }
      .error-message {
        background: #fff;
        border-bottom: 1px solid #ced7dc;
        padding: 30px 20px;
        text-align: center;
      }
      .grx-link {
        color: #007aff;
        text-decoration: none;
      }
      @media (min-width: 768px) {
        header {
          padding-left: 48px;
          padding-right: 48px;
          text-align: left;
        }
        .tagline {
          display: inline-block;
        }
        h1 {
          font-size: 32px;
        }
        p {
          font-size: 17px;
        }
        .error-message {
          border-radius: 4px;
          box-shadow: 0 2px 5px rgba(0, 0, 0, 0.25);
          max-width: 640px;
          margin: 48px auto 0;
          padding: 64px 48px;
        }
        .img {
          margin: 20px auto;
        }
      }
    </style>
  </head>
