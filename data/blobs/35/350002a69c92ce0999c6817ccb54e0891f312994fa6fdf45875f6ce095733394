  const body = document.body;

  let bannerCenterHeight = 0;
  let bannerTopHeight = 0;
  let bannerStickyHeight = 0;
  let bannerCommonHeight = 0;
  let bannerWidth = 0;
  let bannerLink = '';
  let isCollapsed = 0;
  let isMobile = window.innerWidth < 1200;
  let animationFrameId = null;
  let lastScrollY = window.pageYOffset;

  function setStyles(element, styles) {
    if (!element) {
      return;
    }

    Object.entries(styles).forEach(([property, value]) => {
      element.style[property] = value;
    });
  }

  function defer(callback) {
    setTimeout(callback, 0);
  }

  function getConfig() {
    if (isMobile) {
      return {
        bannerTopHeight: 120,
        bannerCenterHeight: 300,
        bannerStickyHeight: 100,
        bannerCommonHeight: 520,
        bannerWidth: 767,
        bannerLink: 'https://bankomania.pkobp.pl/kultura-i-nauka/czytanie-procentuje-pko-bank-polski-partnerem-kampanii-cala-polska-czyta-dzieciom/?utm_source=lubimyczytac&utm_medium=display&utm_campaign=2026_q4_sponsoring_czytanieprocentuje&utm_content=direct_fix_doublebillboard_bkm-wiz_wyobraznia&portal=102&adfcd=1794387055.MptwtaKbhkWN8N7AVsWK-A.MzgwNTQ3OCwyMzMyMzMw',
        bannerSrc: 'https://s.lubimyczytac.pl/upload/topbanner/240/1405436.jpg',
