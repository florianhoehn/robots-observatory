<script type="1eb0200ac55102e027d993df-text/javascript">
document.addEventListener('DOMContentLoaded', function() {
  const adsContainerHld = document.querySelector('#top-sponsorship-banner');

  if (!adsContainerHld) {
    return;
  }

  const adsContainer = adsContainerHld.querySelector('#top-sponsorship-banner-wrapper');
  const adsContainerSticky = adsContainerHld.querySelector('#top-sponsorship-wrapper-sticky');
