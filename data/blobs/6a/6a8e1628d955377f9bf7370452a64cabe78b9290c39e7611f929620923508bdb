    <script>
      // Suppress "ResizeObserver loop completed with undelivered notifications" — a benign browser
      // notice fired by react-resizable-panels and ReactFlow. Must run before any bundle loads so
      // this handler is registered before React's own error listener.
      window.addEventListener('error', (e) => {
        if (e.message && e.message.includes('ResizeObserver loop')) {
          e.stopImmediatePropagation();
        }
      }, true);
    </script>
