    b.siteName = 'live';
    b.pageId = '404:ce4bb88f-0006-460b-bbeb-c06c5b69cbf5';
    b.template = 'content';
    b.askPublicationPoint = 'buienradarnl';
    b.askUI = 'buienradarnl';
    b.pageParams = {};
    window.apiKey = '3c4a3037-85e6-4d1e-ad6c-f3f6e4b75f2f';
    b.photoVideoAPIURL = 'https://photovideoapi.buienradar.nl';
    b.photoVideoMainImageSizeId = '100116';
    b.photoVideoAgreementVersion = '0.2';
    b.prebidUrl = 'https://securepubads.g.doubleclick.net/tag/js/gpt.js';
    b.weerzineShowsAdAllianceBanners = false;
    b.pipData = {
        pipUrl: 'https://account.buienradar.nl',
        pipIntegratorId: 'buienradar-nl',
        myEnvironmentUrl: 'https://mijnomgeving.buienradar.nl',
        usePip: 'False'
    }

    const usePip = b.pipData.usePip === "True" 

    const loginUrl = usePip 
        ? `${b.pipData.pipUrl}/login?integration_id=${b.pipData.pipIntegratorId}&callback_url=${window.location.href}` 
        : "/auth/login?theme=buienradar";
    const logoutUrl = usePip
        ? `${b.pipData.pipUrl}/logout?integration_id=${b.pipData.pipIntegratorId}&callback_url=${window.location.href}`
        : "/auth/logout";
    const registerUrl = usePip ? loginUrl : "/account/register";
    const userUrl = "/auth/user?slide=false";
    let userPromise = null;
    const dpgAppId = window.location.hostname.includes("buienradar.be") 
        ? 'buienradar.be.web' 
        : 'buienradar.nl.web';

    const trackLoginSuccessEvent = function (claims) {
        const sidClaim = claims?.find(
            (claim) => claim.type === "sid"
        );

        if (!sidClaim?.value) {
            return;
        }

        window.trackDpgSelfDescribingEvent?.({
            event: {
                schema: 'iglu:dpgmedia/authentication_interaction/jsonschema/1-0-3',
                data: {
                    action: 'login_success'
                }
            },
            context: [
                {
                    schema: 'iglu:dpgmedia/user/jsonschema/3-0-7',
                    data: {
                        is_logged_in: true,
                        account_id: sidClaim.value,
                    },
                },
            ],
        }, dpgAppId);
    };

    b.login = function login () {
        cookieManager.deleteCookie("br-plus")
        cookieManager.setCookie({ name: 'hasLoggedIn', value: 'true', expDays: 2});
        window.location = loginUrl;
    }

    b.register = function register () {
        const claims = JSON.parse(sessionStorage.getItem('claims')) ?? [];
        const sidClaim = claims.find(
            (claim) => claim.type === "sid"
        );
        window.trackDpgSelfDescribingEvent?.({ 
            event: {
                schema: 'iglu:dpgmedia/authentication_interaction/jsonschema/1-0-3',
                data: {
                    action: 'logout',
                }
            },
            context: [
				{
					schema: 'iglu:dpgmedia/user/jsonschema/3-0-7',
					data: {
						is_logged_in: !!sidClaim?.value,
						account_id: sidClaim?.value,
					},
				},
			],
        }, dpgAppId)
        cookieManager.deleteCookie("br-plus")
        cookieManager.setCookie({ name: 'hasLoggedIn', value: 'true', expDays: 2});

        if (usePip || window.buienradar.enableOidcRegistration.toLowerCase() !== 'true') {
            window.location = registerUrl;
        }
        else {
            window.location = window.buienradar.openIdAuthority + "/register" + window.buienradar.returnUrl + "?theme=buienradar";
        }
    }

    b.logout = function logout() {
        if (usePip) {
            window.location.href = logoutUrl;
            return;
        }
        const claims = JSON.parse(sessionStorage.getItem('claims'));
        const logoutUrlClaim = claims.find(
            (claim) => claim.type === "bff:logout_url"
        );

        cookieManager.deleteCookie("br-plus");
        cookieManager.deleteCookie("hasLoggedIn");
        sessionStorage.removeItem('UID');
        sessionStorage.removeItem('claims');
        if (logoutUrlClaim) {
            window.location = logoutUrlClaim.value;
        }
        window.buienradar.claims = "";
    }

    b.getPipUser = function () {
        return new Promise((resolve) => {
            const cachedPipUser = b.pipUser;
            if (cachedPipUser) {
                return resolve(cachedPipUser);
            }
            fetch('/api/accountdetails')
                .then(res => res.json())
                .then(pipUserData => {
                    if (pipUserData.expiredToken) {
                        window.location.href = `${loginUrl}&prompt=none`
                        return resolve(null);
                    }
                    b.pipUser = pipUserData;
                    return resolve(pipUserData);
                })
                .catch(e => {
                    console.error('Error getting PIP user', e);
                    return resolve(null);
                });
        });
    }

    b.getUser = function () {
        if (userPromise) {
            return userPromise;
        }

        userPromise = new Promise(async (resolve, reject) => {
            const hasLoggedInCookie = cookieManager.getCookie("hasLoggedIn");
            const brPlusCookie = cookieManager.getCookie("br-plus");
            const cachedClaims = sessionStorage.getItem("claims");

            if (!hasLoggedInCookie || hasLoggedInCookie !== 'true' && cachedClaims && brPlusCookie !== 'true') {
                return reject(new Error("User has not logged in before"));
            }

            // Check if the response is already cached
            if (cachedClaims) {
                const parsedClaims = JSON.parse(cachedClaims);
                resolve(parsedClaims);
                userPromise = null;
            }
            const req = new Request(userUrl, {
                headers: new Headers({
                    "X-CSRF": "1",
                }),
            });

            try {
                const response = await fetch(req);
                if (response.ok) {
                    const claims = await response.json();

                    sessionStorage.setItem("claims", JSON.stringify(claims));
                    cookieManager.setCookie({ name: 'hasLoggedIn', value: 'true', expDays: 2});
                    if (!cachedClaims) {
                        trackLoginSuccessEvent(claims);
                    }
                    resolve(claims);
                } else if (response.status === 401) {
                    cookieManager.deleteCookie("br-plus");
                    cookieManager.deleteCookie("hasLoggedIn");
                    sessionStorage.removeItem("claims");
                    sessionStorage.removeItem("UID");
                    reject(new Error("User not logged in"));
                } else {
                    reject(new Error("Failed to fetch user"));
                }
            } catch (error) {
                reject(error);
            } finally {
                userPromise = null;
            }
        });

        return userPromise;
    };
</script>

