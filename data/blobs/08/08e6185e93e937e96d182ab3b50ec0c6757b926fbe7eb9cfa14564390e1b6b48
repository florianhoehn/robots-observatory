    var cookieMatch = document.cookie.match(/\bjui-theme=([a-z\d-]+)/)
    if (cookieMatch) {
      var theme = cookieMatch[1]
      document.documentElement.className = document.documentElement.className + ' jui-theme-' + theme
    }
  })()
