<script>
const menu = document.querySelector('.navbar1_menu');

// Helper to check if display is block
function isVisible() {
  return getComputedStyle(menu).display === 'block';
}

// Use IntersectionObserver to check if it's in view
const intersectionObserver = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (entry.isIntersecting && isVisible()) {
      document.body.style.overflow = 'hidden';
      console.log('Menu is visible & in view — scroll locked.');
    } else {
      document.body.style.overflow = '';
      console.log('Menu not visible or not in view — scroll unlocked.');
    }
  });
});

// Observe the menu
intersectionObserver.observe(menu);

// Watch for style changes to catch display toggles
const mutationObserver = new MutationObserver(() => {
  if (isVisible()) {
    // Re-check if it's actually in view
    menu.getBoundingClientRect(); // force reflow (optional)
    // `intersectionObserver` will handle it on next frame
  } else {
    document.body.style.overflow = '';
    console.log('Menu hidden — scroll unlocked.');
  }
});

mutationObserver.observe(menu, { attributes: true, attributeFilter: ['style'] });

// Optional: check initial state
if (isVisible()) {
  // Check if in view immediately
  const rect = menu.getBoundingClientRect();
  if (
    rect.top < window.innerHeight &&
    rect.bottom > 0 &&
    rect.left < window.innerWidth &&
    rect.right > 0
  ) {
    document.body.style.overflow = 'hidden';
    console.log('Initial: Menu visible & in view — scroll locked.');
  }
}

</script></body></html>