<script type="text/javascript">
$(document).ready(function(){
	if($(window).width() >= 890){
		$(".mm").removeClass("shwx");
		$('.mobile-slide').addClass("hidden");
		$('.pop-list-desktop').removeClass("hidden");
		$('.pop-list').addClass("hidden");
