<!doctype html>
<html>
<head>
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, user-scalable=no, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta http-equiv="cleartype" content="on" />
    <link type="text/css"  href="/dist/css/custom?v=w-E3WZu0poyC881itez8t5fyuc7PCW-kIZ_q6vMSjZQ1" rel="stylesheet" />

    <title>404. Не удалось найти данный файл или страницу</title>

    <style type="text/css">
        body {
            background: #eef3fb;
            font-family: Tahoma, Arial, sans-serif;
            line-height: 1.6;
        }

        h1 {
            font-size: 25px;
        }

        h1, p {
            text-align: center;
        }

        p {
            font-size: 20px;
        }

        img {
            margin: auto;
            display: block;
        }

        .content {
            background: #ffffff;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-shadow: 0 1px 0 rgba(0,0,0,0.2);
            margin: 60px auto 0;
            padding: 20px;
            max-width: 640px;
        }

        @media(max-width: 640px) {
            body {
                background-color: #ffffff;
            }

            .content {
                border: 0;
                margin: 0 auto 0;
                box-shadow: none;
            }

            .content img {
                max-width: 200px;
            }
        }
    </style>
</head>
<body>
    <div class="content">
        <h1><b>404</b> <br/> Не удалось найти данный файл или страницу</h1>

        <img src="/distCommon/images/customErrors/404.png" alt="Error 404" width="400"/>

        <p>
            <a class="btn btn-success mt" href="/">Вернуться на главную страницу</a>
        </p>
    </div>
</body>
</html>