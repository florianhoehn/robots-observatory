<style id="wp-custom-css">
/* =========================================
   MODERN CARD (SHADOW TIPIS & POSISI BARU)
   ========================================= */

/* 1. Container Utama */
.locked-card-wrapper {
    display: block;
    max-width: 480px; /* Lebar ideal untuk kartu tengah */
    margin: 100px auto;
    padding: 40px;
    /* Background & Border */
    background: #1e1e1e;
    border: 1px solid #d20f39; /* Border sangat halus */
    border-radius: 10px;
    text-align: center;
}

/* 2. Icon Gembok */
.main-lock-icon {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 70px;
    height: 70px;
    background: rgba(210, 15, 57, 0.08); /* Merah sangat transparan */
    border-radius: 50%;
    margin-bottom: 20px;
    color: #d20f39; /* Warna Merah Utama */
}

/* 3. Judul & Deskripsi */
.locked-titles h1 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 8px;
    line-height: 1.4;
}

.locked-titles h1 a {
    color: #fff;
    text-decoration: none;
    border-bottom: 1px dotted #666;
}

.locked-titles p {
    font-size: 0.9rem;
    color: #999;
    margin-bottom: 20px;
    line-height: 1.5;
}

/* 4. Badge Status (Early Access) */
.locked-status {
    display: inline-block;
    padding: 5px 12px;
    background: #d20f39;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    
    /* Margin bawah kecil agar dekat dengan timer */
    margin-bottom: 12px; 
}

/* 5. Timer Countdown (Dibawah Status) */
.timer-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    
    /* Tampilan Minimalis */
    background: #161616;
    border: 1px solid #333;
    padding: 8px 16px;
    border-radius: 50px; /* Bentuk pil/kapsul */
    width: fit-content;
    margin: 0 auto 30px auto; /* Tengah & Jarak ke tombol */
}

.timer-container span {
    font-size: 0.85rem;
    color: #ccc;
}

.timer-val {
    font-family: monospace; /* Font jam digital */
    font-weight: bold;
    color: #fff;
}

.timer-container svg {
    width: 16px;
    height: 16px;
    color: #d20f39;
    animation: pulse 1.5s infinite; /* Animasi detak halus */
}

/* 6. Tombol Aksi */
.action-area {
    display: flex;
    flex-direction: column; /* Tombol atas-bawah */
    gap: 10px;
}

.unlock-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background 0.2s;
}

/* Tombol Premium (Merah/Hijau sesuai selera, disini Merah agar matching) */
a.unlock-btn[href*="premium"] {
    background: #d20f39;
    color: #fff;
    border: 1px solid #d20f39;
}

a.unlock-btn[href*="premium"]:hover {
    background: #b00c30;
}

/* Tombol Login (Outline) */
a.unlock-btn[href*="login"] {
    background: transparent;
    border: 1px solid #444;
    color: #ccc;
}

a.unlock-btn[href*="login"]:hover {
    border-color: #888;
    color: #fff;
}

/* Footer Note */
.locked-card-wrapper > div:last-child {
    margin-top: 15px;
    font-size: 0.8rem;
    color: #555;
}

.bs.stylefiv {
    width: 20%;
}

.bs.stylefiv .bsx .tt {
	font-size:.95em;
}

.um-item-link a {
  color:#888;
  font-size:16px;
  line-height:20px
}

.um-item {
  padding:20px 0;
  border-bottom:1px solid #222;
  position:relative
}

/* Animasi */
@keyframes pulse {
    0% { opacity: 0.6; }
    50% { opacity: 1; }
    100% { opacity: 0.6; }
}

/* Responsif Mobile */
@media (max-width: 600px) {
    .locked-card-wrapper {
        margin: 0px 20px 10px 20px;
				padding: 15px;
    }
}

@media only screen and (max-width: 500px) {
    .bs.stylefiv {
        width: 33.333333%;
    }
		.bs.stylefiv .bsx .chfiv li .fivtime {
		display: none;
	}
}

@media only screen and (max-width: 715px) {
  .bs.stylefiv .bsx .chfiv li .fivtime {
    display: none;
  }
}

.my-custom-ads {
	display: flex;
	justify-content: center;
	align-items: center;
	width: 100%;
	height: 90px;
}
.my-custom-ads-inner {
	display: flex;
	flex-direction: row;
	gap: 10px;
	transform: scale(0.9);
	transform-origin: center;
}

@media screen and (max-width: 728px) {
	.my-custom-ads {
		height: auto;
		padding: 10px 0; 
	}
	.my-custom-ads-inner {
		flex-direction: column; 
		transform: scale(1); 
	}
}
