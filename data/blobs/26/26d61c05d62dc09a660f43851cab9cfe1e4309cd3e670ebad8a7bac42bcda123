    (function() {
        window.CQuotient.widgets = window.CQuotient.widgets || [];
        const nativePush = window.CQuotient.widgets.push;

        function checkEmptyRecommendationSlots(args) {
            const recommSlots = document.querySelectorAll('div[id^="cq_recomm_slot-"]');
            recommSlots.forEach(slot => {
                const skeletonParent = slot.closest('.c-skeleton__loading');
                if (skeletonParent) {
                    const scriptInfo = skeletonParent.querySelectorAll('script');
                    const isSlot = Array.from(scriptInfo).some(script => 
                        script.textContent.includes(args.slotId)
                    );

                    const isEmpty = slot.children.length === 0 && slot.textContent.trim() === '';
                    if (isSlot && isEmpty) {
                        const skeletonChild = skeletonParent.querySelector('.skeleton-container');
                        skeletonChild.style.display = 'none';
                        skeletonParent.classList.add('no-recomendations');
                    }
                }
            });
        }

        window.CQuotient.widgets.push = function(args) {
            if (args !== null && typeof args === 'object' && args.recommenderName && args.callback && typeof args.callback === 'function') {
                const originalCallback = args.callback;
                const argsP = args.parameters;

                args.callback = function(response) {
                    let productRecommendations = null;
                    let args = argsP;
                    if (response && typeof response === 'object') {
                        if (Array.isArray(response.recs)) {
                            productRecommendations = response.recs;
                        } else {
                            const innerObjectWithRecs = Object.values(response).find(item => item !== null && typeof item === 'object' && Array.isArray(item.recs));
                            if (innerObjectWithRecs) {
                                productRecommendations = innerObjectWithRecs.recs;
                            }
                        }
                    }
                    if (!productRecommendations || productRecommendations.length === 0) {
                        checkEmptyRecommendationSlots(args);
                    }
                    return originalCallback.apply(this, arguments);
                };
            }
            return nativePush.apply(window.CQuotient.widgets, [args]);
        };
    })();
</script>
