<script>
(function () {
  var queue = [];
  function track(name, data) {
    if (window.umami && umami.track) { umami.track(name, data || {}); } else { queue.push([name, data]); }
  }
  window.trbTrack = track;
  window.addEventListener('load', function () {
    queue.splice(0).forEach(function (e) { track(e[0], e[1]); });
  });

  var path = location.pathname;
  var params = new URLSearchParams(location.search);
  // Page context the templates already know (empty on pages where it does not apply):
  // result count on listings, category and id on torrent pages.
  var ctx = {
    results: "",
    category: "",
    post: ""
  };
  function withCtx(data) {
    if (ctx.results !== '') { data.results = Number(ctx.results); data.zero_results = Number(ctx.results) === 0; }
    if (ctx.category) { data.category = ctx.category; }
    return data;
  }

  // 1. search: listing DSL (/get-posts/keywords:...) or the ext browse page (?q=)
  var listing = path.match(/^\/get-posts\/(.*)$/);
  if (listing && /(^|:)keywords:/.test(listing[1])) {
    var kw = decodeURIComponent((listing[1].match(/keywords:([^:\/]*)/) || ['', ''])[1]).trim();
    if (kw) { track('search', withCtx({ q: kw.slice(0, 100), via: 'listing' })); }  // skip empty queries
  } else if (path === '/browse/' && (params.get('q') || '').trim()) {
    track('search', { q: params.get('q').trim().slice(0, 100), via: 'browse' });
  }

  // 2. detail view (torrent page); title pages are tracked too, as their own event
  var detail = path.match(/^\/post-detail\/([^\/]+)\//);
  if (detail) { track('detail_view', withCtx({ post: ctx.post || detail[1] })); }
  var title = path.match(/^\/imdb-detail\/(tt\d+)\//);
  if (title) { track('title_view', { imdb: title[1] }); }

  // 3. magnet click: plain magnet links and every theme's copy-magnet control
  document.addEventListener('click', function (ev) {
    var el = ev.target.closest && ev.target.closest(
      'a[href^="magnet:"], [data-magnet], #copy_magnet, .copy-magnet-btn, .magnet-btn');
    if (el) { track('magnet_click', withCtx({ post: ctx.post || (detail ? detail[1] : ''), page: path.slice(0, 60) })); }
  }, true);

  // 4. return visit: once per browser session, when a previous visit is over 30 min old
  try {
    var now = Date.now();
    var last = parseInt(localStorage.getItem('trb_last_visit') || '0', 10);
    if (!sessionStorage.getItem('trb_visit_counted')) {
      sessionStorage.setItem('trb_visit_counted', '1');
      if (last && now - last > 30 * 60 * 1000) {
        track('return_visit', { days_since: Math.round((now - last) / 864e5) });
      }
    }
    localStorage.setItem('trb_last_visit', String(now));
  } catch (e) {}
})();
</script>


