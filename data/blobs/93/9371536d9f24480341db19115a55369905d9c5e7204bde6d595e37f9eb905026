<!DOCTYPE html>
<html lang="en" data-bm-mode="auto">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>পেজ পাওয়া যায়নি &middot; BizMation</title>
    
    <link rel="shortcut icon" href="https://bizmation.io/uploads/info/favicon.png?c=5">
    
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&display=swap">
    <style>
    /* ===================================================================
       V2 tokens, hand-inlined. new-ui.css never loads on an error page.
       =================================================================== */
    :root{
      --bm-teal-900:#064E48; --bm-teal-800:#0A6B62; --bm-teal-700:#0C9488;
      --bm-teal-600:#0FA89A; --bm-teal-500:#14B8A6; --bm-teal-300:#5EEAD4;
      --bm-teal-50:#F0FDFA;
      --bm-coral-500:#FF6A1F; --bm-coral-100:#FFE3D3;

      --bm-bg-app:#F4F2F8; --bm-surface:#FFFFFF; --bm-surface-sunken:#F0EDF4;
      --bm-border-subtle:#E8E4ED; --bm-border-default:#DCD6E3;

      --bm-text-primary:#1A1233; --bm-text-secondary:#4B4163;
      /* Lifted from the #7C7388 token: micro-labels at 10px/600 need
         headroom. #6B6279 = 5.76:1 on surface, 6.6:1 on sunken. */
      --bm-text-tertiary:#6B6279;

      --bm-danger:#E5474D;  --bm-danger-bg:#FCE6E7;
      --bm-warning:#F5A623; --bm-warning-bg:#FEF3DD;

      --bm-shadow-xs:0 1px 2px rgba(12,30,28,.04);
      --bm-shadow-md:0 4px 12px rgba(12,30,28,.08),0 2px 4px rgba(12,30,28,.04);
      --bm-shadow-teal:0 6px 18px rgba(6,78,72,.28);

      /* Inter Tight first (Latin + the tabular numerals), Hind Siliguri
         second to catch the Bengali codepoints Inter Tight has no glyphs
         for. Ordering is the whole mechanism — do not reorder. */
      --bm-font:"Inter Tight","Hind Siliguri","Source Sans 3",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;

      /* Non-token additions, each measured — see the verification notes. */
      --bm-ghost-border:#8E839F;   /* 3.56:1 on surface — WCAG 1.4.11 */
      --bm-focus:#0C9488;          /* 3.75:1 on surface */
      --bm-focus-halo:rgba(20,184,166,.20);

      /* Per-page accent, rebound by the .ac-* classes below. */
      --bm-accent:var(--bm-teal-600);
      --bm-accent-tint:var(--bm-teal-50);
      --bm-accent-ink:var(--bm-teal-800);
      color-scheme:light;
    }

    /* Accent map. Teal owns the navigation/session pages (the ones users
       actually hit); coral is the app's own live attention colour
       (sidebar active bar, notification count) and owns 403; amber and red
       are reserved for the genuinely semantic cases.
       Purple is deliberately unused: the --bm-purple-* tokens have ZERO
       component consumers in new-ui.css — purple is substrate in V2
       (bg-app, the text ramp), never an accent. */
    .ac-teal   {--bm-accent:var(--bm-teal-600); --bm-accent-tint:var(--bm-teal-50);   --bm-accent-ink:var(--bm-teal-800)}
    .ac-deep   {--bm-accent:var(--bm-teal-800); --bm-accent-tint:var(--bm-teal-50);   --bm-accent-ink:var(--bm-teal-800)}
    .ac-coral  {--bm-accent:var(--bm-coral-500);--bm-accent-tint:var(--bm-coral-100); --bm-accent-ink:#A33A0B} /* 5.42:1 */
    .ac-warning{--bm-accent:var(--bm-warning);  --bm-accent-tint:var(--bm-warning-bg);--bm-accent-ink:#8A5A05} /* 5.38:1 */
    .ac-danger {--bm-accent:var(--bm-danger);   --bm-accent-tint:var(--bm-danger-bg); --bm-accent-ink:#C42B31} /* 4.71:1 */

    /* ===================================================================
       Dark. Three signals, correct precedence.
       Theme is DB-only (saveUiPreference() writes users.others and
       session()->forget()s the key — no cookie is ever set), so on
       401/402/403/419/429/503 the user's real theme is UNKNOWABLE and we
       emit data-bm-mode="auto" and defer to the OS. data-bm-mode="light"
       matches nothing here, so an authenticated V2-Light user on a dark OS
       is correctly NOT force-flipped — the bug every
       prefers-color-scheme-only page ships.
       =================================================================== */
    html[data-bm-mode="dark"], body.new_ui_dark{
      --bm-bg-app:#061715; --bm-surface:#0E2421; --bm-surface-sunken:#081A18;
      --bm-border-subtle:#1A3D38; --bm-border-default:#245049;
      --bm-text-primary:#F0FDFA; --bm-text-secondary:#B7CDC9; --bm-text-tertiary:#7E9692;
      --bm-danger-bg:rgba(229,71,77,.15); --bm-warning-bg:rgba(245,166,35,.15);
      --bm-teal-50:rgba(20,184,166,.12); --bm-coral-100:rgba(255,106,31,.20);
      --bm-shadow-xs:0 1px 2px rgba(0,0,0,.3);
      --bm-shadow-md:0 4px 12px rgba(0,0,0,.5),0 2px 4px rgba(0,0,0,.3);
      --bm-shadow-teal:0 6px 18px rgba(0,0,0,.45);
      --bm-ghost-border:#4E8C82;  /* 4.17:1 on dark surface */
      --bm-focus:#5EEAD4;         /* 10.98:1 on dark surface */
      color-scheme:dark;
    }
    /* The documented tint + dark-ink trap (new-ui.css:1716-1726): a soft
       tint becomes a low-alpha overlay on dark, so the dark ink that was
       correct on light goes invisible. Every accent ink lifts with it. */
    html[data-bm-mode="dark"] .ac-teal,   body.new_ui_dark .ac-teal,
    html[data-bm-mode="dark"] .ac-deep,   body.new_ui_dark .ac-deep   {--bm-accent-ink:var(--bm-teal-300)}
    html[data-bm-mode="dark"] .ac-coral,  body.new_ui_dark .ac-coral  {--bm-accent-ink:#FF9E66}
    html[data-bm-mode="dark"] .ac-warning,body.new_ui_dark .ac-warning{--bm-accent-ink:#F7BC5A}
    html[data-bm-mode="dark"] .ac-danger, body.new_ui_dark .ac-danger {--bm-accent-ink:#F27D81}

    @media (prefers-color-scheme:dark){
      html[data-bm-mode="auto"]{
        --bm-bg-app:#061715; --bm-surface:#0E2421; --bm-surface-sunken:#081A18;
        --bm-border-subtle:#1A3D38; --bm-border-default:#245049;
        --bm-text-primary:#F0FDFA; --bm-text-secondary:#B7CDC9; --bm-text-tertiary:#7E9692;
        --bm-danger-bg:rgba(229,71,77,.15); --bm-warning-bg:rgba(245,166,35,.15);
        --bm-teal-50:rgba(20,184,166,.12); --bm-coral-100:rgba(255,106,31,.20);
        --bm-shadow-xs:0 1px 2px rgba(0,0,0,.3);
        --bm-shadow-md:0 4px 12px rgba(0,0,0,.5),0 2px 4px rgba(0,0,0,.3);
        --bm-shadow-teal:0 6px 18px rgba(0,0,0,.45);
        --bm-ghost-border:#4E8C82;
        --bm-focus:#5EEAD4;
        color-scheme:dark;
      }
      html[data-bm-mode="auto"] .ac-teal,
      html[data-bm-mode="auto"] .ac-deep   {--bm-accent-ink:var(--bm-teal-300)}
      html[data-bm-mode="auto"] .ac-coral  {--bm-accent-ink:#FF9E66}
      html[data-bm-mode="auto"] .ac-warning{--bm-accent-ink:#F7BC5A}
      html[data-bm-mode="auto"] .ac-danger {--bm-accent-ink:#F27D81}
    }

    /* ===================================================================
       Shell
       =================================================================== */
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    body{
      min-height:100vh; min-height:100dvh;
      display:flex; align-items:center; justify-content:center;
      padding:32px 24px;
      background:var(--bm-bg-app);
      font-family:var(--bm-font); font-size:14px;
      color:var(--bm-text-primary);
      -webkit-font-smoothing:antialiased; -moz-osx-font-smoothing:grayscale;
    }
    .bm-card{
      width:100%; max-width:760px;
      background:var(--bm-surface);
      border:1px solid var(--bm-border-subtle);
      border-radius:14px;                 /* the top-level shell radius */
      box-shadow:var(--bm-shadow-md);     /* the only precedented step up
                                             from xs for a lone panel;
                                             -lg is reserved for overlays */
    }

    /* --- header rail: 13px top corners inside the 14px shell --- */
    .bm-head{
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      padding:14px 20px;
      border-bottom:1px solid var(--bm-border-subtle);
      border-radius:13px 13px 0 0;
    }
    /* The mark is INLINED as a data URI, not linked with asset().
       Why: /public/uploads is gitignored (.gitignore:29), so anything under
       uploads/info/ is deploy-time cargo, not source. logo-pdf.png returns
       404 on bizmation.io for exactly that reason — verified with curl —
       and logo.png only happens to be there because someone uploaded it.
       An error page is the last surface that should depend on a file the
       repo does not own: it must render on a hard-down 500, in maintenance
       mode, and in a fresh environment with an empty uploads dir.
       Inlined, it costs one 9.4KB payload, zero network requests, and
       cannot 404. 252x88 source = 2x the 126x44 box, so it stays crisp on
       retina; background-size:contain holds the 2.87 ratio at every size. */
    .bm-logo{
      width:126px; height:44px; display:block; flex:none;
      background:url("data:image/png;base64,") no-repeat left center;
      background-size:contain;
    }
    .bm-tag{
      font-size:11px; font-weight:600; letter-spacing:.06em; text-transform:uppercase;
      padding:3px 9px; border-radius:999px;
      background:var(--bm-surface-sunken); color:var(--bm-text-secondary);
      white-space:nowrap;
    }

    /* --- body: the editorial split --- */
    .bm-body{
      display:grid;
      grid-template-columns:minmax(0,196px) 1fr;
      gap:28px;
      padding:28px 24px;
    }
    .bm-plate{
      position:relative;
      padding-left:18px;
      border-right:1px solid var(--bm-border-subtle);
      min-width:0;
    }
    /* The app's native decor move: .custom_dashboard_card::before, verbatim
       (4px wide, inset 12px top/bottom, cap radius 0 4px 4px 0). */
    .bm-plate::before{
      content:''; position:absolute; left:0; top:12px; bottom:12px;
      width:4px; background:var(--bm-accent); border-radius:0 4px 4px 0;
    }
    /* The cdc_icon recipe (new-ui.css:1372-1383) in its soft-tint variant
       (L1370-1371), which auto-flips to the alpha overlay on dark. */
    .bm-chip{
      width:36px; height:36px; border-radius:10px;
      display:inline-flex; align-items:center; justify-content:center;
      background:var(--bm-accent-tint); color:var(--bm-accent-ink);
      margin-bottom:14px;
    }
    .bm-chip svg{
      width:18px; height:18px; display:block;
      stroke:currentColor; stroke-width:1.75; fill:none;
      stroke-linecap:round; stroke-linejoin:round;
    }
    /* The KPI-number recipe (700 / -0.02em / tnum) scaled to hero and
       pushed to 800 (Inter Tight loads 800).
       MEASURED: the plate track is 196px minus 18px padding = 178px of
       content. "404" at 92px in Inter Tight 800 with tabular figures is
       ~166px wide. It fits with margin at every desktop width — the
       numeral never crosses the border-right hairline. */
    .bm-code{
      display:block; white-space:nowrap;
      font-size:clamp(64px,8vw,92px); font-weight:800;
      line-height:.9; letter-spacing:-.02em;
      font-feature-settings:"tnum";
      color:var(--bm-text-primary);
    }
    /* Legacy/compat: errors::minimal can pass a non-numeric code (the old
       503 sent 'Maintenance Mode'). Never let a word blow out the slot. */
    .bm-code.is-word{
      font-size:clamp(18px,2.2vw,22px); line-height:1.2;
      white-space:normal; overflow-wrap:anywhere;
    }
    .bm-eyebrow{
      display:block; margin-top:12px;
      font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
      color:var(--bm-text-tertiary);
    }

    /* --- content --- */
    .bm-content{min-width:0}
    /* The copy is Bangla (Hind Siliguri). Bengali needs materially more
       leading than Latin — matras sit above the headline and the
       descenders of ্র/ু/ৃ hang below — so line-height is 1.35/1.75
       rather than the 1.2/1.6 a Latin-only page would use.
       letter-spacing stays NEGATIVE only on the title, where it applies to
       the Latin "BizMation" and the numerals; Bengali conjuncts are not
       tracked apart (see .bm-note b). */
    .bm-title{
      font-size:clamp(22px,2.6vw,28px); font-weight:700; letter-spacing:-.01em;
      line-height:1.35; color:var(--bm-text-primary); margin-bottom:10px;
    }
    .bm-lede{
      font-size:14.5px; line-height:1.75; color:var(--bm-text-secondary);
      max-width:52ch; overflow-wrap:anywhere;
    }
    /* errors::minimal forwards only a one-line `message`, so it supplies no
       lede. An empty <p> would still take its margin box. */
    .bm-lede:empty{display:none}
    /* The borderless 10px soft-tint alert (new-ui.css:1257-1262). */
    .bm-note{
      margin-top:16px; padding:11px 14px;
      border:none; border-radius:10px; font-weight:500;
      font-size:13.5px; line-height:1.7; overflow-wrap:anywhere;
      background:var(--bm-accent-tint); color:var(--bm-accent-ink);
    }
    /* This label is Bangla, so it drops the uppercase + .12em tracking the
       Latin micro-labels use. text-transform:uppercase is a no-op on
       Bengali (the script is unicameral), but letter-spacing is actively
       destructive: it forces gaps between the parts of a conjunct and
       detaches matras from their base glyph. Weight and colour carry the
       hierarchy instead. */
    .bm-note b{
      display:block; margin-bottom:1px;
      font-size:11.5px; font-weight:700; opacity:.85;
    }

    /* --- CTAs: the .btn recipe --- */
    .bm-actions{display:flex; flex-wrap:wrap; gap:10px; margin-top:22px}
    .bm-btn{
      display:inline-flex; align-items:center; justify-content:center; gap:7px;
      min-height:40px; padding:8px 15px;
      border:1px solid transparent; border-radius:9px;   /* the control radius */
      /* 1.6 leading, not the 1.2 a Latin label needs: Bangla button text
         has ascending matras and descenders that 1.2 clips. */
      font:600 13.5px/1.6 var(--bm-font);
      text-decoration:none; cursor:pointer;
      transition:background .15s, border-color .15s, box-shadow .15s, transform .1s;
    }
    .bm-btn:active{transform:translateY(.5px)}
    .bm-btn:focus-visible{
      outline:2px solid var(--bm-focus); outline-offset:2px;
      box-shadow:0 0 0 3px var(--bm-focus-halo);
    }
    /* DELIBERATE DEVIATION, documented: new-ui.css's .btn-primary is
       linear-gradient(135deg, teal-500, teal-700). White on teal-500 is
       2.49:1 and on teal-700 is 3.75:1 — both fail WCAG AA at 13px/600.
       An error page is the one screen where the exit must be legible, so
       the ramp shifts to teal-800 -> teal-900 (6.38:1 at its lightest
       point). The 135deg axis, the teal identity, the glow and the
       darken-on-hover rule are all preserved. */
    .bm-btn--primary{
      background:linear-gradient(135deg,var(--bm-teal-800),var(--bm-teal-900));
      color:#fff; box-shadow:var(--bm-shadow-teal);
    }
    .bm-btn--primary:hover{
      background:linear-gradient(135deg,var(--bm-teal-900),#043B36);
      color:#fff;   /* re-pinned: dark mode's link colour bleeds into
                       anchor-styled buttons (new-ui.css:1872-1876) */
    }
    .bm-btn--ghost{
      background:var(--bm-surface);
      border-color:var(--bm-ghost-border);
      color:var(--bm-text-secondary);
    }
    .bm-btn--ghost:hover{
      background:var(--bm-surface-sunken);
      color:var(--bm-text-primary);
    }

    /* --- the manifest strip --- */
    .bm-manifest{
      display:flex; flex-wrap:wrap; align-items:flex-end; gap:10px 26px;
      padding:12px 20px;
      background:var(--bm-surface-sunken);
      border-top:1px solid var(--bm-border-subtle);
      border-radius:0 0 13px 13px;
    }
    .bm-manifest dt{
      font-size:10px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
      color:var(--bm-text-tertiary); margin-bottom:2px;
    }
    .bm-manifest dd{
      font-size:12.5px; font-weight:600; font-feature-settings:"tnum";
      color:var(--bm-text-secondary); overflow-wrap:anywhere;
    }
    .bm-manifest .bm-path{
      max-width:34ch; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
      /* NB: direction:rtl is deliberately NOT used to truncate from the
         left — bidi rule UAX#9 N2 relocates the leading "/" to the visual
         right and misprints the path as "admin/orders/1841/". Plain
         right-side ellipsis is honest. */
    }
    .bm-copy{
      margin-left:auto; align-self:center;
      background:none; border:1px solid var(--bm-ghost-border); border-radius:8px;
      padding:5px 11px; cursor:pointer;
      font:600 11.5px/1.6 var(--bm-font); color:var(--bm-text-secondary);
      transition:background .15s, color .15s, box-shadow .15s;
    }
    .bm-copy:hover{background:var(--bm-surface); color:var(--bm-text-primary)}
    .bm-copy:focus-visible{
      outline:2px solid var(--bm-focus); outline-offset:2px;
      box-shadow:0 0 0 3px var(--bm-focus-halo);
    }

    /* ===================================================================
       Responsive
       =================================================================== */
    @media (max-width:720px){
      .bm-body{grid-template-columns:1fr; gap:22px; padding:24px 20px}
      .bm-plate{
        border-right:none;
        border-bottom:1px solid var(--bm-border-subtle);
        padding-bottom:22px;
        display:flex; align-items:center; gap:14px;
      }
      .bm-chip{margin-bottom:0; flex:none}
      .bm-eyebrow{margin-top:0}
      .bm-code.is-word{flex:1 1 auto}
    }
    /* The header is a flex row: logo + the "SYSTEM RESPONSE" tag. At 44px
       the logo is 126px wide, which together with the tag would overrun a
       320px viewport — so it steps down before that can happen. */
    @media (max-width:480px){
      .bm-logo{width:98px; height:34px}
      .bm-head{padding:12px 16px}
    }
    @media (max-width:420px){
      body{padding:16px 12px}
      .bm-body{padding:20px 16px}
      .bm-actions{flex-direction:column; align-items:stretch}
      .bm-btn{min-height:44px}   /* touch target */
      .bm-manifest{gap:10px 18px}
      .bm-copy{margin-left:0}
    }
    @media (max-height:520px){
      body{align-items:flex-start; padding-top:20px; padding-bottom:20px}
    }

    /* ===================================================================
       Motion. new-ui.css contains ZERO @keyframes, zero `animation` and
       zero `backdrop-filter` across all 1,931 lines. This page adds none
       of the three — an animated error page would be the single most
       foreign thing in the product. The whole budget is the system's own
       .15s colour / .1s transform transitions on interactive elements.
       Because there is no keyframe, the reduced-motion block is trivially
       complete and nothing is lost: no content, meaning or wayfinding is
       carried by motion.
       =================================================================== */
    @media (prefers-reduced-motion:reduce){
      *,*::before,*::after{transition-duration:.01ms !important}
      .bm-btn:active{transform:none}
    }

    /* Windows High Contrast: keep the accent rail and controls perceivable. */
    @media (forced-colors:active){
      .bm-card{border:1px solid CanvasText}
      .bm-plate::before{background:Highlight; forced-color-adjust:none}
      .bm-btn{border:1px solid ButtonText}
    }

    @media print{
      .bm-actions, .bm-copy{display:none}
      body{padding:0; background:#fff}
      .bm-card{box-shadow:none; border-color:#999; max-width:none}
    }
    </style>
</head>
<body class="">

<main class="bm-card ac-teal">

