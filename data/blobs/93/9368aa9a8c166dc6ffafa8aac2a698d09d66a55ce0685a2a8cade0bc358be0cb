<script>

document.addEventListener('DOMContentLoaded', function () {
  const fetchSuggestions = async (query, limit = 5) => {
    if (!query) return [];
    const res = await fetch(
      `/ajax/get_suggest_word/?keyword=${encodeURIComponent(query)}&suggest_limit=${limit}`,
      { headers: { 'X-Requested-With': 'XMLHttpRequest' } }
    );
    const json = await res.json();
    return Array.isArray(json.suggest)
      ? json.suggest.map(([word]) => word)
      : [];
  };

  
  const commonConfig = {
    wrapper: true,
    searchEngine: 'loose',
    threshold: 2,
    debounce: 400,
    resultItem: { highlight: true },
    events: {
      input: {
        selection: (event) => {
          const selection = event.detail.selection.value;
          event.target.value = selection;
        }
      }
    }
  };

  const initAutoComplete = ({ selector, placeHolder, limit }) => {
    
    if (!document.querySelector(selector)) {
      return;
    }

    return new autoComplete({
      selector,
      placeHolder,
      maxResults: limit,
      resultsList: { maxResults: limit },
      data: {
        src: query => fetchSuggestions(query, limit),
        cache: false
      },
      ...commonConfig
    });
  };

  
  initAutoComplete({
    selector: '.search-keyword-input',
    placeHolder: 'Search for Used Car',
    limit: 10
  });

  
  initAutoComplete({
    selector: '.sp-search-keyword-input',
    placeHolder: 'Search by Make, Model (e.g. Toyota)',
    limit: 5
  });
});
</script>




