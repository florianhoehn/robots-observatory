  <script>

    // Check URL parameters for platformName
    const urlParams = new URLSearchParams(window.location.search);
    const platformName = urlParams.get("platformName");
    
    // Set webView to true if platformName is android or ios
    if (platformName === "android" || platformName === "ios") {
      window.webView = true;
      try {
        localStorage.setItem("platform", platformName);
      } catch (e) {}
    } else {
      window.webView = false;
    }
    
    // Prevent flash of unstyled content (FOUC) by applying theme before React loads
    (function() {
      const theme = localStorage.getItem('app-theme');
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else if (theme === null) {
        // Check system preference if no stored theme
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark');
        }
      }
    })();

    </script>
  
  
  
  
  
<script>(function () {
  var CDN_BASE = "https://eba-public-small.eba.gov.tr/prod/ui-assets/";
  var FALLBACK_BASE = "/assets/";
  var CDN_HOST = "eba-public-small.eba.gov.tr";
  var APP_ORIGIN = "https://eba.gov.tr";
  var FALLBACK_KEY = "dep:ui-assets-use-fallback";
  var CHUNK_RELOAD_KEY = "dep:chunk-reload-once";
  var FONT_RE = /\.(woff2?|ttf|otf|eot|ttc)(\?.*)?$/i;

  function toBundleFileName(filename) {
    return String(filename || "").replace(/^assets\//, "");
  }

  function isFontAsset(filename) {
    return FONT_RE.test(filename);
  }

  function isOnFallback() {
    try {
      return sessionStorage.getItem(FALLBACK_KEY) === "1";
    } catch (e) {
      return false;
    }
  }

  function getActiveBase() {
    return isOnFallback() ? FALLBACK_BASE : CDN_BASE;
  }

  window.__depUiAssetUrl = function (filename) {
    var name = toBundleFileName(filename);
    if (APP_ORIGIN && isFontAsset(name)) {
      return APP_ORIGIN + FALLBACK_BASE + name;
    }
    return getActiveBase() + name;
  };

  function switchToFallbackAndReload() {
    if (isOnFallback()) return false;
    try {
      sessionStorage.setItem(FALLBACK_KEY, "1");
    } catch (e) {}
    location.reload();
    return true;
  }

  function tryReloadOnce() {
    try {
      if (sessionStorage.getItem(CHUNK_RELOAD_KEY) === "1") return false;
      sessionStorage.setItem(CHUNK_RELOAD_KEY, "1");
    } catch (e) {
      return false;
    }
    location.reload();
    return true;
  }

  function isUiBundleUrl(src) {
    if (!src || src.indexOf("/src/") !== -1) return false;
    return src.indexOf("/ui-assets/") !== -1 || src.indexOf("/assets/") !== -1;
  }

  function isCdnUrl(src) {
    return Boolean(src && src.indexOf(CDN_HOST) !== -1);
  }

  window.__depBootstrapUiAssets = function (config) {
    var activeBase = getActiveBase();

    function loadStyles(styles) {
      return Promise.all(
        (styles || []).map(function (item) {
          return new Promise(function (resolve, reject) {
            var link = document.createElement("link");
            link.rel = "stylesheet";
            link.href = activeBase + item.href;
            if (item.crossorigin) link.crossOrigin = "anonymous";
            link.onload = function () {
              resolve();
            };
            link.onerror = function () {
              if (isOnFallback()) {
                reject(new Error("stylesheet failed"));
                return;
              }
              if (switchToFallbackAndReload()) return;
              reject(new Error("stylesheet failed"));
            };
            document.head.appendChild(link);
          });
        })
      );
    }

    function loadPreloads(preloads) {
      (preloads || []).forEach(function (item) {
        var link = document.createElement("link");
        link.rel = "modulepreload";
        link.href = activeBase + item.href;
        if (item.crossorigin) link.crossOrigin = "anonymous";
        link.onerror = function () {
          if (!isOnFallback() && switchToFallbackAndReload()) return;
        };
        document.head.appendChild(link);
      });
    }

    function loadScripts(scripts) {
      return (scripts || []).reduce(function (chain, item) {
        return chain.then(function () {
          return new Promise(function (resolve, reject) {
            var script = document.createElement("script");
            script.type = "module";
            script.src = activeBase + item.src;
            if (item.crossorigin) script.crossOrigin = "anonymous";
            script.onload = function () {
              resolve();
            };
            script.onerror = function () {
              if (isOnFallback()) {
                reject(new Error("script failed"));
                return;
              }
              if (switchToFallbackAndReload()) return;
              reject(new Error("script failed"));
            };
            // Stil yoksa bu satır <head> parse edilirken çalışır; body henüz null olabilir
            (document.body || document.head).appendChild(script);
          });
        });
      }, Promise.resolve());
    }

    loadPreloads(config.preloads || []);
    loadStyles(config.styles || [])
      .then(function () {
        return loadScripts(config.scripts || []);
      })
      .catch(function () {
        if (!isOnFallback() && switchToFallbackAndReload()) return;
      });
  };

  if (!/^localhost$|^127\.0\.0\.1$/i.test(location.hostname)) {
    window.addEventListener(
      "error",
      function (ev) {
        var target = ev && ev.target;
        if (!target || target.tagName !== "SCRIPT") return;
        var src = target.src || "";
        if (!isUiBundleUrl(src)) return;
        if (isCdnUrl(src) && !isOnFallback()) {
          if (switchToFallbackAndReload()) {
            ev.preventDefault();
            return;
          }
        }
        if (tryReloadOnce()) ev.preventDefault();
      },
      true
    );

    window.addEventListener("unhandledrejection", function (ev) {
      var reason = ev && ev.reason;
      var message = String((reason && (reason.message || reason)) || "");
      if (
        !/Failed to fetch dynamically imported module|error loading dynamically imported module|Loading chunk \d+ failed|ChunkLoadError|Importing a module script failed/i.test(
          message
        )
      ) {
        return;
      }
      if (!isOnFallback()) {
        if (switchToFallbackAndReload()) {
          ev.preventDefault();
          return;
        }
      }
      if (tryReloadOnce()) ev.preventDefault();
    });
  }
})();</script>
