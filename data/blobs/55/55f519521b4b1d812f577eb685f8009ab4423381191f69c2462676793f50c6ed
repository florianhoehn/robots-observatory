# AI crawlers share the SAME group as every other bot, on purpose. A named
# user-agent group REPLACES the "*" group for that agent (RFC 9309 2.2.1: "*" is
# used only when no group matches the agent's own token), so giving these their
# own "Allow: /" block would exempt them from every Disallow below, including
# /config/* and /api/*. And do NOT add a second group naming a token that is
# already here: the RFC says groups matching the same token MUST be combined, so
# it would merge with this one rather than stand alone.
# Listing them here instead is explicit and changes nothing: same rules, one copy,
# nothing to drift. Training opt-out TOKENS (Google-Extended, Applebot-Extended)
# are deliberately absent: they have no crawler behind them, so naming them is a
# consent decision about model training, not a crawl rule.
User-agent: GPTBot
User-agent: OAI-SearchBot
User-agent: ChatGPT-User
User-agent: ClaudeBot
User-agent: Claude-User
User-agent: Claude-SearchBot
User-agent: PerplexityBot
User-agent: *
Disallow: /location
# /api/examples/ and /api/core.html are deliberately CRAWLABLE (Allow overrides the
# /api/* Disallow) but serve X-Robots-Tag: noindex + the demos carry
# meta noindex. A Disallow here would freeze URLs as "indexed though blocked" - Google
# must crawl them to see the noindex and drop them.
Allow:    /api/examples/
Allow:    /api/docs/
Allow:    /api/portal/
Allow:    /api/core.html
# legacy /api/doc/* 301s to /api/docs/ - crawlable so Google sees the redirect
# instead of freezing the old URLs as "indexed though blocked"
Allow:    /api/doc
Disallow: /api/*
Disallow: /ad
Disallow: /ad/*
Disallow: /samplefiles/*
Disallow: /old
Disallow: /old/*
Disallow: /old/m
Disallow: /config/*

Allow:    /api
Allow:    /ads.txt

sitemap: https://speedof.me/sitemap.xml

# ARD capability manifest for agent registries (agenticresourcediscovery.org).
# Same role as the sitemap line, for crawlers that index tools rather than pages.
Agentmap: https://speedof.me/.well-known/ai-catalog.json
