<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <title>Link Inactive | EasySyncr</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #030712; color: #f8fafc; min-height: 100vh; display: flex; flex-direction: column; }
        /* Using Rose glow to signal an error state */
        .bg-glow { position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; background: radial-gradient(circle at 50% 0%, rgba(244, 63, 94, 0.08) 0%, transparent 50%); }
        .glass-card { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); width: 100%; max-width: 480px; }
        .pulse { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
    </style>
</head>
<body>
    <div class="bg-glow"></div>

    <nav class="w-full border-b border-white/5 bg-black/40 backdrop-blur-xl sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-6 h-16 sm:h-20 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-rose-600 rounded-lg flex items-center justify-center">
                    <i data-lucide="zap" class="text-white w-4 h-4 fill-white"></i>
                </div>
                <a class="text-lg font-bold tracking-tighter uppercase" href="/">EasySyncr</a>
            </div>
            <a href="/" class="text-[10px] font-black text-slate-400 hover:text-white transition uppercase tracking-widest">Exit</a>
        </div>
    </nav>

    <main class="flex-grow flex items-center justify-center py-12 px-6">
        <div class="glass-card rounded-[2.5rem] p-10 sm:p-14 shadow-2xl text-center border-t-2 border-rose-500/20">
            <div class="inline-flex items-center justify-center w-24 h-24 bg-rose-500/5 rounded-[2rem] mb-8 border border-rose-500/10">
                <i data-lucide="ghost" class="w-12 h-12 text-rose-500/50"></i>
            </div>
            
            <h1 class="text-3xl font-extrabold text-white mb-4 tracking-tight">Link Inactive</h1>
            <p class="text-slate-400 text-sm font-medium leading-relaxed mb-10">
                The content you are looking for has been removed or the link has reached its expiration limit.
            </p>

            <div class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-rose-500/10 border border-rose-500/20 mb-12">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-500 pulse"></span>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-rose-400">404 - Not Found</span>
            </div>

            <a href="/contact" class="flex items-center justify-center gap-3 w-full py-5 rounded-2xl bg-white text-black font-black text-[11px] uppercase tracking-[0.2em] hover:bg-slate-200 transition shadow-xl">
                <i data-lucide="life-buoy" class="w-4 h-4"></i>
                Contact Support
            </a>

            <div class="mt-8 text-center">
                <a href="/" class="text-[9px] font-bold text-slate-500 hover:text-slate-300 uppercase tracking-widest transition">
                    Return to Homepage
                </a>
            </div>
        </div>
    </main>

    <footer class="border-t border-white/5 py-10 px-6 mt-auto opacity-30">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex gap-8 text-[10px] font-bold uppercase tracking-widest">
                <a href="/dmca">DMCA</a>
                <a href="/contact">Support</a>
            </div>
            <p class="text-[10px] uppercase tracking-widest">&copy; 2026 EasySyncr</p>
        </div>
    </footer>

    <script>lucide.createIcons();</script>
</body>
</html>