<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Uh oh! / Streamlabs</title>
    <link rel="icon" type="image/svg+xml" href="https://cdn.streamlabs.com/static/imgs/streamlabs-logos/favicon/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="https://cdn.streamlabs.com/static/imgs/streamlabs-logos/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="https://cdn.streamlabs.com/static/imgs/streamlabs-logos/favicon/favicon-16x16.png">
<link rel="apple-touch-icon" sizes="180x180" href="https://cdn.streamlabs.com/static/imgs/streamlabs-logos/favicon/apple-touch-icon.png">
<link rel="manifest" href="/images/favicons/site.webmanifest">
<meta name="msapplication-TileColor" content="#80f5d2">
<meta name="theme-color" content="#ffffff">


    <style>
      @import url('https://fonts.googleapis.com/css?family=Roboto:400,500');

      body, html {
        height: 100%;
        width: 100%;
        background-color: #17242d;
        margin: 0;
        padding: 0;
      }

      .error-body {
        position: relative;
        display: flex;
        align-items: center;
        align-content: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        font-family: 'Roboto', sans-serif;
        background-image: url('https://cdn.streamlabs.com/static/imgs/error/error-bg-bottom.png'), url('https://cdn.streamlabs.com/static/imgs/error/error-bg-top.png');
        background-position: bottom left, top right;
        background-repeat: no-repeat, no-repeat;
      }

      .error-body__inner {
        position: relative;
        display: flex;
        flex-flow: column;
        align-items: center;
        justify-content: center;
      }

      .error__icon {
        position: relative;
        width: 90px;
        margin-bottom: 32px;
      }

      .error__title {
        position: relative;
        font-size: 22px;
        font-weight: 500;
        color: #ffffff;
        margin-bottom: 24px;
      }

      .error__message {
        position: relative;
        max-width: 375px;
        font-size: 16px;
        font-weight: 400;
        color: #bdc2c4;
        margin-bottom: 32px;
      }

      .error__button {
        position: relative;
        display: flex;
        align-items: center;
        align-content: center;
        justify-content: center;
        height: 64px;
        background-color: #4f5e65;
        border-radius: 32px;
        color: #ffffff;
        font-size: 16px;
        font-weight: 500;
        text-decoration: none;
        padding: 0 24px; 
        margin-bottom: 32px;
      }

      .error__link {
        font-size: 14px;
        font-weight: 500;
        color: #91979a;
      }
    </style>
  </head>
  <body>
    <div class="error-body">
      <div class="error-body__inner">
        <img src="https://cdn.streamlabs.com/static/imgs/streamlabs-logos/light/streamlabs-logo.svg" class="error__icon" alt="Streamlabs">
        <div class="error__title">    Page not found
</div>
        <div class="error__message">    We were unable to find this broadcaster.
</div>
        <a href="https://streamlabs.com/dashboard" class="error__button">Go to homepage</a>
        <a href="https://support.streamlabs.com/hc/en-us/requests/new" class="error__link">Still having problems?</a>
      </div>
    </div>
  </body>
</html>
