<script type="text/javascript">
(function () {
    var key = 'first_visit_channel_source'
    // stage 短码映射:
    // i: init
    // gs: get_script_url
    // gp: get_params
    // rc: read_cookie
    // uc: update_cookie
    // bv: build_value
    // wc: write_cookie
    var stage = 'i'
    try {
        var domain = getMainDomain(new URL(window.location.href))
        if (domain !== '.yunzhan365.com' && domain !== '.fliphtml5.com') {
            return
        }
        if (window.location.protocol === 'http:') {
            window.location.href = window.location.href.replace("http://", "https://")
        }
        stage = 'gs'
        // var currentScriptUrl = new URL(document.currentScript.src)
        var currentScriptUrl = new URL(window.location.href)
        stage = 'gp'
        var params = getParamsFromURL()
        stage = 'rc'
        const oldVal = getCookieValue(key)

        
        if (oldVal && oldVal.uuid) {
            stage = 'uc'
            if (oldVal.gclid && oldVal.fbclid) {
                return
            }
            if (!oldVal.gclid && params.gclid) {
                oldVal.gclid = params.gclid
                oldVal.ggtime = new Date().getTime()
                delete oldVal.updated
            }
            if (!oldVal.fbclid && params.fbclid) {
                oldVal.fbclid = params.fbclid
                oldVal.fbtime = new Date().getTime()
                delete oldVal.updated
            }
            setCookie(key, JSON.stringify(oldVal), currentScriptUrl)
        } else {
            stage = 'bv'
            const uuid = generateUUID()
            var value = {
                channel: '',
                referer: document.referrer,
                page: window.location.href,
                time: new Date().getTime(),
                uuid: uuid,
                gclid: '',
                ggtime: 0,
                fbclid: '',
                fbtime: 0,
            }
            if (oldVal && oldVal.msg) {
                value.msg = oldVal.msg
            }
            
            if (params.source) {
                value.channel = params.source
            } else if (params.i) {
                value.channel = 'invite_code'
            } else if (params.utm_code) {
                value.channel = params.utm_code
            } else if (Object.keys(params).length === 1 && Object.values(params)[0] === null) {
                value.channel = Object.keys(params)[0]
            }
            if (params.gclid) {
                value.gclid = params.gclid
                value.ggtime = new Date().getTime()
            }
            if (params.fbclid) {
                value.fbclid = params.fbclid
                value.fbtime = new Date().getTime()
            }
            stage = 'wc'
            setCookie(key, JSON.stringify(value), currentScriptUrl)
            // saveUUID(currentScriptUrl)
        }
    } catch (error) {
        console.log('site-commonjs error', error)
        writeDebugCookie(error)
    }
    function setCookie (cookieName, cookieValue, urlObj) {
        var date = new Date()
        date.setTime(date.getTime() + (365 * 24 * 60 * 60 * 1000 * 100)) // 100年后过期
        const domain = getMainDomain(urlObj)
        document.cookie = cookieName + "=" + cookieValue + ";expires=" + date.toUTCString() + ";domain=" + domain + ";path=/"
    }
    function getParamsFromURL () {
        var urlParams = {}
        var searchParams = window.location.search.substring(1).split('&')

        for (var i = 0; i < searchParams.length; i++) {
            var param = searchParams[i].split('=')
            var paramName = decodeURIComponent(param[0])
            var paramValue = param[1] ? decodeURIComponent(param[1]) : null
            urlParams[paramName] = paramValue
        }

        return urlParams
    }
    function getMainDomain (urlObj) {
        try {
            const domain = urlObj.hostname
            const parts = domain.split('.')
            const mainDomain = '.' + parts.slice(-2).join('.')
            return mainDomain
        } catch (error) {
            console.error('无效的 URL:', error)
            return null
        }
    }
    function generateUUID () {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
            var r = Math.random() * 16 | 0,
                v = c === 'x' ? r : (r & 0x3 | 0x8)
            return v.toString(16)
        })
    }
    function buildDebugMsg (error) {
        var errorMessage = ''
        try {
            errorMessage = error && error.message ? String(error.message) : String(error || '')
        } catch (e) {
            errorMessage = 'unknown_error'
        }
        errorMessage = errorMessage.replace(/\s+/g, ' ').substring(0, 120)
        // msg 字段映射:
        // s: 报错阶段 stage，取值见顶部 stage 短码映射
        // m: 错误信息 message
        return {
            s: stage,
            m: errorMessage,
        }
    }
    function getCookieUrlForDebug () {
        return new URL(window.location.href)
    }
    function writeDebugCookie (error) {
        try {
            var oldVal = getCookieValue(key)
            if (oldVal && oldVal.uuid) {
                return
            }
            var value = {
                msg: buildDebugMsg(error),
            }
            setCookie(key, JSON.stringify(value), getCookieUrlForDebug())
        } catch (e) {
        }
    }
    function getCookieValue (cookieName) {
        var name = cookieName + "="
        var decodedCookie = decodeURIComponent(document.cookie)
        var cookieArray = decodedCookie.split(";")

        for (var i = 0; i < cookieArray.length; i++) {
            var cookie = cookieArray[i].trim()
            if (cookie.indexOf(name) === 0) {
                return JSON.parse(cookie.substring(name.length))
            }
        }
        return null
    }
    function _ajax () {
        function createxmlHttpRequest (data) {
            if (window.ActiveXObject) {
                return new ActiveXObject("Microsoft.XMLHTTP")
            } else if (window.XMLHttpRequest) {
                return new XMLHttpRequest()
            }
        }
        function convertData (data) {
            if (typeof data === 'object') {
                var convertResult = ""
                for (var c in data) {
                    convertResult += c + "=" + data[c] + "&"
                }
                convertResult = convertResult.substring(0, convertResult.length - 1)
                return convertResult
            } else {
                return data
            }
        }
        var ajaxData = {
            type: (arguments[0].type || "GET").toUpperCase(),
            url: arguments[0].url || "",
            async: arguments[0].async || "true",
            data: arguments[0].data || null,
            dataType: arguments[0].dataType || "json",
            contentType: arguments[0].contentType || "application/x-www-form-urlencoded; charset=utf-8",
            beforeSend: arguments[0].beforeSend || function () { },
            success: arguments[0].success || function () { },
            error: arguments[0].error || function () { }
        }
        ajaxData.beforeSend()
        var xhr = createxmlHttpRequest()
        xhr.responseType = ajaxData.dataType

        xhr.open(ajaxData.type, ajaxData.url, ajaxData.async)
        xhr.setRequestHeader("Content-Type", ajaxData.contentType)
        xhr.send(convertData(ajaxData.data))

        xhr.onreadystatechange = function () {
            if (xhr.readyState == 4) {
                if (xhr.status == 200) {
                    ajaxData.success(xhr.response)
                } else {
                    ajaxData.error()
                }
            }
        }
    }
})();
</script>
