<div class="modal" x-show="authOpen" x-cloak x-transition.opacity.duration.200ms @click="closeAuth()">
    <div class="auth" @click.stop>
        <button class="auth__close" aria-label="Close" @click="closeAuth()">×</button>
        <div class="auth__brand"><span class="logo"><b>123</b><span>AV</span><i></i></span></div>
        <div class="auth__tabs">
            <button :class="{ 'is-on': authTab === 'login' }" @click="authTab = 'login'; auth.error = ''">Log in</button>
            <button :class="{ 'is-on': authTab === 'register' }" @click="authTab = 'register'; auth.error = ''">Register</button>
            <button :class="{ 'is-on': authTab === 'reset' }" @click="authTab = 'reset'; auth.error = ''">Reset</button>
        </div>
        <div class="auth__form">
            <div class="auth__error" x-show="auth.error" x-cloak>
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 7v6M12 16.5h.01"/></svg>
                <span x-text="auth.error"></span>
            </div>
            <template x-if="authTab === 'login'">
                <label class="field"><span>Username or email</span><input type="text" placeholder="yourname" x-model="auth.username"></label>
            </template>
            <template x-if="authTab === 'register'">
                <label class="field"><span>Username</span><input type="text" placeholder="yourname" x-model="auth.username"></label>
            </template>
            <template x-if="authTab === 'register' || authTab === 'reset'">
                <label class="field"><span>Email</span><input type="email" placeholder="you@example.com" x-model="auth.email"></label>
            </template>
            <template x-if="authTab === 'reset'">
                <label class="field"><span>Username</span><input type="text" placeholder="yourname" x-model="auth.username"></label>
            </template>
            <label class="field">
                <span x-text="authTab === 'reset' ? 'New password' : 'Password'"></span>
                <input type="password" placeholder="••••••••" x-model="auth.password">
            </label>

            <template x-if="authOpen">
                <div x-data="captcha" class="cf-turnstile"
                    data-sitekey="0x4AAAAAADkzNCt1vIP70it4"
                    data-theme="dark"
                    data-size="flexible"></div>
            </template>

            <button class="auth__submit" @click.prevent="submitAuth()" :disabled="auth.loading"
                    x-text="auth.loading ? 'Please wait…' : (authTab === 'login' ? 'Log in' : (authTab === 'register' ? 'Create account' : 'Set password &amp; log in'))"></button>
        </div>
    </div>
</div>
