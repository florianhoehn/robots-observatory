            $.confirm({
                type: 'blue',
                title: $(this).data('title') ? $(this).data('title') : 'Prosz\u0119\u0020potwierdzi\u0107.',
                content: $(this).data('content') ? $(this).data('content') : 'Czy\u0020na\u0020pewno\u0020chcesz\u0020dokona\u0107\u0020zmiany\u003F',
