<script>
  /* Keeps exactly one of the [data-familybar-rotate] links. Stays a plain blocking
     inline script so the pick lands before first paint and the differing label
     widths cause no CLS. Without JS the 河好如初 link is the one already visible. */
  (function () {
    var candidates = Array.prototype.slice.call(
      document.querySelectorAll('.channel-link a[data-familybar-rotate]')
    );
    if (!candidates.length) return;

    var winner = candidates[Math.floor(Math.random() * candidates.length)];

    candidates.forEach(function (candidate) {
      if (candidate === winner) candidate.removeAttribute('hidden');
      else candidate.parentNode.removeChild(candidate);
    });
  })();
</script>

