    // Color luminosity detection functions
    function hexToRgb(hex) {
        const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
        return result ? {
            r: parseInt(result[1], 16),
            g: parseInt(result[2], 16),
            b: parseInt(result[3], 16)
        } : null;
    }

    function getLuminance(r, g, b) {
        const a = [r, g, b].map(v => {
            v /= 255;
            return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
        });
        return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
    }

    function isDarkColor(color) {
        const rgb = hexToRgb(color);
        if (!rgb) return true; // Default to dark if parsing fails
        const luminance = getLuminance(rgb.r, rgb.g, rgb.b);
        return luminance < 0.5;
    }

    // Apply theme based on background color
    function applyTheme() {
        try {
            const savedBgColor = localStorage.getItem('backgroundColor');
            if (savedBgColor) {
                const isDark = isDarkColor(savedBgColor);
                const root = document.documentElement;
                
                root.style.setProperty('--bg-color', savedBgColor);
                root.style.setProperty('--text-color', isDark ? '#ffffff' : '#000000');
                root.style.setProperty('--secondary-text-color', isDark ? 'rgb(154, 160, 166)' : 'rgb(95, 99, 104)');
            }
        } catch (error) {
            console.warn('Failed to apply theme from localStorage:', error);
        }
    }

    // Get browser locale
    function getBrowserLocale() {
        try {
            const browserLang = navigator.language || navigator.userLanguage;
            if (browserLang) {
                // Map browser locales to our supported locales
                const localeMap = {
                    'uk': 'uk',
                    'uk-UA': 'uk',
                    'en': 'en-US',
                    'en-US': 'en-US',
                    'en-GB': 'en-US',
                    'de': 'de-DE',
                    'de-DE': 'de-DE',
                    'pl': 'pl-PL',
                    'pl-PL': 'pl-PL',
                    'ja': 'ja-JP',
                    'ja-JP': 'ja-JP',
                    'crh': 'crh-UA',
                    'crh-UA': 'crh-UA',
                    'fr': 'fr-FR',
                    'fr-FR': 'fr-FR'
                };
                
                // Try exact match first
                if (localeMap[browserLang]) {
                    return localeMap[browserLang];
                }
                
                // Try language code only
                const langCode = browserLang.split('-')[0];
                if (localeMap[langCode]) {
                    return localeMap[langCode];
                }
            }
        } catch (error) {
            console.warn('Failed to detect browser locale:', error);
        }
        return 'uk'; // Default fallback
    }

    // Apply localization
    function applyLocalization() {
        try {
            const savedLocale = localStorage.getItem('locale');
            const locale = savedLocale || getBrowserLocale();
            const translation = translations[locale] || translations['uk'];
            
            document.getElementById('errorMessageTitle').textContent = translation.title;
            document.getElementById('errorMessageDetails').textContent = translation.details;
            document.getElementById('navigationLabel').textContent = translation.navigationLabel;
            
            // Update navigation link texts
            document.getElementById('mainSiteLink').textContent = translation.mainSite;
            document.getElementById('liteLink').textContent = translation.liteVersion;
            document.getElementById('enLink').textContent = translation.english;
            document.getElementById('deLink').textContent = translation.german;
            document.getElementById('plLink').textContent = translation.polish;
            document.getElementById('crhLink').textContent = translation.crimeanTatar;
        } catch (error) {
            console.warn('Failed to apply localization:', error);
        }
    }

    // Apply theme and localization on page load
    applyTheme();
    applyLocalization();



