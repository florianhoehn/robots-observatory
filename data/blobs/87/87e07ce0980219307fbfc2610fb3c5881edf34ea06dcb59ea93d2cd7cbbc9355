    <!--
        Real-user analytics only. This page is served as a static file (no server-side
        layout/VMB), so tracking is client-side. Bots don't execute JS, so the ~800k/day
        junk 404s never trigger any of this; only real users hitting dead links do.
        Gated to the production hostname so dev/staging 404s don't pollute prod data
        (this static file ships un-transformed to every environment).
    -->
    <script>
        (function () {
            if (location.hostname !== 'www.musicnotes.com') return;

            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }

            // Consent Mode v2: default-deny BEFORE GTM loads. This static page has no
            // server-derived compliance_status (no shopper/DB/GeoIP lookup), so we fail
            // closed: GA4 runs cookieless/consent-denied and ad tags are suppressed for
            // every user. Compliant regardless of the GTM container's own consent config.
            gtag('consent', 'default', {
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied',
                'analytics_storage': 'denied',
                'functionality_storage': 'denied',
                'personalization_storage': 'denied',
                'security_storage': 'granted',
                'wait_for_update': 500
            });

            window.dataLayer.push({
                event: 'page_view',
                page_type: 'errorPage',
                error_status: 404,
                page_path: location.pathname,
                referrer: document.referrer || ''
            });

            // Google Tag Manager (feeds GA4 + container tags). page_type=errorPage above
            // lets GTM exclude this from conversion/remarketing tags.
            (function (w, d, s, l, i) {
                w[l] = w[l] || [];
                w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
                var f = d.getElementsByTagName(s)[0],
                    j = d.createElement(s),
                    dl = l != 'dataLayer' ? '&l=' + l : '';
                j.async = true;
                j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
                f.parentNode.insertBefore(j, f);
            })(window, document, 'script', 'dataLayer', 'GTM-5CQ8CLH');

            // First-party behavioral collector -> /api/analytics/events -> Snowflake.
            // Intercepts dataLayer and replays existing items, so it captures the
            // page_view pushed above. Independent of GTM.
            var sc = document.createElement('script');
            sc.src = '/Scripts/Track/snowflakeCollector.js';
            sc.defer = true;
            document.head.appendChild(sc);
        })();
    </script>
