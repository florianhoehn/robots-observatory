<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gap</title>
    <meta name="description" content="Gap Franchise" />
    <style>
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        width: 100%;
        font-family: "Helvetica Neue", Helvetica, Arial, Roboto, sans-serif;
        background: #fff;
        color: #333;
      }

      .franchiseLP {
        position: relative;
        width: 100%;
      }

      /* ── Banner ── */
      .flp-banner {
        position: relative;
        width: 100%;
      }
      .flp-banner img:not(.flp-svg) {
        width: 100%;
        display: block;
      }

      /* ── Overlay (desktop) ── */
      .flp-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 5%;
      }

      .flp-svg {
        width: clamp(100px, 14vw, 200px);
        margin-bottom: 1rem;
      }

      .flp-overlay h1 {
        font-size: clamp(1.2rem, 2.2vw, 2rem);
        font-weight: 400;
        color: #fff;
        margin-bottom: 1.5rem;
        max-width: 620px;
        cursor: default;
      }

      .flp-overlay .body-copy {
        font-size: clamp(0.72rem, 1vw, 0.95rem);
        color: #fff;
        max-width: 380px;
        line-height: 1.5;
        margin-bottom: 1rem;
      }

      .flp-buttons {
        display: flex;
        flex-direction: row;
        gap: 12px;
        margin-top: 1.5rem;
      }

      .franchise-redirect-button {
        border: none;
        padding: 0.6rem 1.2rem;
        background: #fff;
        color: #000;
        text-decoration: none;
        font-size: 1rem;
        font-family: inherit;
        letter-spacing: 0.03em;
        white-space: nowrap;
        transition: background 0.2s;
      }
      .franchise-redirect-button:hover {
        background: #e9e9e9;
      }

      .flp-disclaimer {
        font-size: 0.82rem;
        color: #fff;
        max-width: 738px;
        line-height: 1.4;
        margin-top: 1.2rem;
      }

      .mob-br {
        display: none;
      }
      .desk-only {
        display: inline;
      }
      .mob-only {
        display: none;
      }

      /* ── Mobile ── */
      @media (max-width: 767px) {
        .flp-overlay {
          padding: 2.5rem 1.5rem;
        }
        .flp-svg {
          width: 100px;
          margin-bottom: 0.75rem;
        }
        .flp-overlay h1 {
          font-size: 1.45rem;
          max-width: 100%;
          margin-bottom: 1.25rem;
        }
        .flp-overlay .body-copy {
          font-size: 0.92rem;
          max-width: 100%;
          margin-bottom: 1rem;
        }
        .mob-br {
          display: block;
        }
        .desk-only {
          display: none;
        }
        .mob-only {
          display: block;
        }
        .flp-buttons {
          flex-direction: column;
          gap: 10px;
          margin-top: 1.25rem;
        }
        .franchise-redirect-button {
          border: none;
          background: #fff;
          color: #000;
          text-align: center;
          padding: 0.6rem 1rem;
          font-size: 1rem;
          width: 100%;
        }
        .franchise-redirect-button:hover {
          background: #e9e9e9;
        }
        .flp-disclaimer {
          margin-top: 1.25rem;
          max-width: 100%;
        }
      }
    </style>
  
