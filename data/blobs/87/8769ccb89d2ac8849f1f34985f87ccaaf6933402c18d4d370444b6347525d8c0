  <body>
    <div class="franchiseLP">
      <div class="flp-banner">
        <picture>
          <source
            media="(max-width: 767px)"
            srcset="
              https://digitalassets.gapinc.com/AssetLink/6kj288gid0734mhyvbxi4dpv63y5c8m7.auto?TP=GAP2
            "
          />
          <img
            src="https://digitalassets.gapinc.com/AssetLink/6006cq0ho0w4s7rf12cexl16e8p6f72p.auto?TP=GAP2"
            alt="Gap"
          />
        </picture>

        <div class="flp-overlay">
          <picture>
            <source
              media="(max-width: 767px)"
              srcset="
                https://digitalassets.gapinc.com/AssetLink/54dc7mr4rmkgkkgk647kw45ym74tfh0u.svg?TP=GAP2
              "
            />
            <img
              class="flp-svg"
              src="https://digitalassets.gapinc.com/AssetLink/27sa8pnhgbtb7t3y1pp521jp612nsil8.svg?TP=GAP2"
              alt="Gap logo"
            />
          </picture>

          <h1>
            We see you have tried <br class="mob-br" />to access
            <strong>Gap.com</strong>
          </h1>

          <p class="body-copy">
            Gap.com currently does not support <br class="mob-br" />shipping
            outside of the United States to <br class="mob-br" />your location.
          </p>
          <p class="body-copy">
            Based on your location, would you like to <br class="mob-br" />shop
            on your local website or continue to <br class="mob-br" />the United
            States site?
          </p>

          <div class="flp-buttons">
            <a
              class="franchise-redirect-button"
              id="franchiseRedirectLink"
              href="#"
              >Go to Gap UK</a
            >
            <a
              class="franchise-redirect-button"
              id="sendToDotCom"
              href="https://www.gap.com/"
              >Continue to Gap US</a
            >
          </div>

          <p class="flp-disclaimer">
            Please note that local sites are operated by Gap franchisees whose
            terms and conditions and delivery locations vary. We advise you
            check the terms and conditions of the relevant site before making
            any purchase to ensure any orders can be processed to your location
            on terms acceptable to you.
          </p>
        </div>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        var franchiseRedirectLink = "https://www.gap.co.uk";
        document.getElementById("franchiseRedirectLink").href =
          franchiseRedirectLink;

        document.getElementById("sendToDotCom").onclick = function (e) {
          e.preventDefault();
          var myDate = new Date();
          myDate.setDate(myDate.getDate() + 3);
          document.cookie =
            "frRedirect=true; expires=" +
            myDate +
            "; domain=.gap.com; path=/; SameSite=None; Secure";
          location.href = "https://www.gap.com/";
        };
      });
    </script>
