          //remove value from SMS code fields if larger than 9
          $('.input-number-widget').on('keyup keydown', function (e) {

            var thisVal = $(this).val();
            var getLastVal = parseInt(+thisVal.toString().split('').pop());
            if ($(this).val() > 9
              && e.keyCode !== 46
              && e.keyCode !== 8
            ) {
              e.preventDefault();
              $(this).val(getLastVal);
