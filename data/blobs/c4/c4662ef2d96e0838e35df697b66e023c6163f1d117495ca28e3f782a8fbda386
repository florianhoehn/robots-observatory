window.__DATADOG_CONFIG__ = {"applicationId":"","clientToken":"","site":"datadoghq.com","service":"base44-homepage","version":"unknown"};</script><script id="b44-i18n-resources" type="application/json">{"en":{"common":{"brandedEnterprise":{"meta":{"title":"Enterprise app development for Every Team | Base44","description":"Base44 offers an enterprise app development platform built for scale, with the security and governance IT requires – so every team builds what they need."},"a11y":{"skipToContent":"Skip to content"},"hero":{"title":"Unleash the builders\nin all your teams","subtitle":"Base44 enterprise solutions give every department the power\nto build exactly the tools they need on one platform - in days, not\nquarters - with the governance IT needs to roll it out safely.","cta":"Talk to Sales","montageAlt":"A montage of dashboards and internal tools built across departments with Base44.","montagePauseLabel":"Pause or resume the app montage animation","depts":{"finance":"Finance","hr":"HR \u0026 People","marketing":"Marketing","operations":"Operations","customerSuccess":"Customer Success","financeTwo":"Finance"},"cardLabels":{"finance1":"Finance","hr":"HR \u0026 People","marketing":"Marketing","operations":"Operations","it":"IT","finance2":"Finance","dataAnalytics":"Data \u0026 Analytics","education":"Education","operations2":"Operations","customerSuccess":"Customer Success"}},"certifications":{"title":"Built to roll out\nsafely across\nyour org","description":"Base44 runs on Wix's enterprise security infrastructure so every department ships fast without creating new risk for IT.","badges":{"soc2":"SOC 2 Type 2 compliant","iso":"ISO 27001 certified","gdpr":"GDPR compliant"}},"useCases":{"title":"Any team can\nbuild any solution","description":"From workflows to creatives, every\nneed can be solved using Base44 for\nenterprise.","visualAlt":"A team collaborating around a table, with a Base44-built task-status dashboard.","depts":{"hr":{"title":"HR \u0026 People","description":"Build tools that shape your employee experience — built around your process, on your own timeline.","tools":"Onboarding portals for new hires\nLeave \u0026 PTO manager\nPerformance \u0026 review manager\nShift \u0026 roster scheduler\n+ more"},"operations":{"title":"Operations","description":"Ship live dashboards, risk registers and field tools that run critical processes in real time.","tools":"Project \u0026 portfolio management\nKPI \u0026 multi-site performance dashboard\nResource \u0026 capacity planner\nVendor comparison \u0026 scoring tool\nSafety, HSE \u0026 inspection tracker\n+ more"},"finance":{"title":"Finance","description":"Build dashboards, trackers and planners that put real numbers in front of the people who need them — without a two-week modeling cycle in between.","tools":"Budget scenario planner\nBurn rate \u0026 spend tracker\nFinancial reporting dashboard\nUnit Economics Calculator\n+ more"},"sales":{"title":"Sales","description":"Ship the dashboards, deal tools and rep views your CRM doesn't deliver. Built by the team to match exactly how you really sell.","tools":"Custom pipeline views \u0026 deal dashboards\nQuote, estimate \u0026 proposal builder\nCommission \u0026 sales compensation tracker\nTerritory \u0026 account mapping\n+ more"},"marketing":{"title":"Marketing","description":"Build the content engines, campaign trackers and SEO tools your team used to outsource — now built in-house, at your existing budget and headcount.","tools":"Multi-channel content generator\nCampaign approval \u0026 project tracker\nSEO \u0026 schema markup generator\nInfluencer \u0026 Creator Hub\n+ more"},"dataAnalytics":{"title":"Data \u0026 Analytics","description":"Any team can now ship dashboards, experiment archives and product analytics tools without waiting for the Data team — self-serve, same-day deployment.","tools":"Self-service dashboard \u0026 BI builder\nA/B testing \u0026 experiment archive\nFeature ROI \u0026 product analytics tracker\nInternal data analytics \u0026 reporting tool\n+ more"},"customerSuccess":{"title":"Customer Success","description":"Build the churn scorers, QBR generators and account health trackers that surface risk weeks before the churn email.","tools":"Customer support \u0026 help desk\nAccount health \u0026 churn risk Scorer\nQBR deck generator\nCustomer onboarding health tracker\n+ more"},"it":{"title":"IT","description":"While every department builds for itself, free IT to ship software for IT — asset trackers, security dashboards and integration tools, without RFP cycles.","tools":"IT asset inventory system\nLegacy system Modernisation app\nAI/Chatbot builder\nIoT \u0026 hardware Integration Dashboard\n+ more"},"legal":{"title":"Legal","description":"Build contract workflows, redline workspaces and risk tools — turning the team's three-week review bottleneck into a same-day green light.","tools":"Contract draft \u0026 template generator\nContract redline \u0026 review workspace\nLegal CRM \u0026 case management\nDigital risk management platform\n+ more"}}},"break":{"left":"Your teams already\nknow what they\nwant to solve","right":"Give them the\ntools to build\nwhat they need","symbolAlt":"The Base44 frame mark"},"socialProof":{"attribution":"— Israel Bedolla Hermosillo, GM, BenQ Latin America","quote":"\"A report that used to take one of our team members 10 days to produce — we now run it in 20 minutes. What would have cost us $50,000–$100,000 to outsource, we built ourselves in Base44.\"","stats":{"time":{"stat":"10 days to 20 min","label":"E-commerce report, BenQ Latin America"},"cost":{"stat":"$50k–$100k saved","label":"vs. a custom CRM platform — for one quoting workflow"},"apps":{"stat":"9 apps shipped","label":"across Sales, Supply Chain, HR \u0026 Ops · 2 months · 3 countries"}}},"banner":{"headline":"Bring real problems. Leave with real apps. One day, every team, everything your business has been waiting years to ship.","cta":"Schedule your company Base44 Hackathon","photoAlt":"Two colleagues walking and talking in a modern office."},"features":{"title":"Made to scale from day one","description":"The controls IT needs. The speed everyone else wants. No tradeoffs.","cards":{"access":{"heading":"Control who\ngets access","features":"SCIM provisioning / SSO Enforcement across platform and apps / IP allowlisting / App user connectors via OAuth 2.0"},"govern":{"heading":"Configure,\nmonitor and audit","features":"Granular roles and permissions / Publish controls / Connector management / Credit consumption caps per user / Monitoring APIs / Audit logs API / Data residency / Training data opt-out"},"customize":{"heading":"Customize and\nscale your setup","features":"Custom rate limit multiplier / Workspace templates + skills / 2-way GitHub integration / Import designs from Figma"},"support":{"heading":"Get priority support","features":"Dedicated enterprise support queue / Dedicated Account Manager \u0026 Solution Engineer / Custom enablement sessions"}}},"security":{"title":"Move fast.\nStay in control.","cta":"Go to security trust center","points":{"encryption":{"title":"Encryption","description":"TLS 1.2+ in transit, AES-256 at rest. Secrets managed via cloud KMS."},"optout":{"title":"Training data opt-out","description":"Enterprise customers can opt out of having their workspace data used to train AI models."},"sso":{"title":"Single Sign-On","description":"Enterprise SSO via organizational IdP, enforced across the workspace and every app inside it."},"network":{"title":"Network restrictions","description":"Restrict workspace and app access to approved IP addresses."},"pentest":{"title":"Continuous security testing","description":"Internal and third-party OWASP-based penetration tests, plus an active bug bounty program."},"applevel":{"title":"App-level security","description":"Built-in pre-publish security scan. Row-level security isolates data inside apps."},"supplychain":{"title":"Supply chain security","description":"A third-party risk management program covering every vendor."},"sharing":{"title":"Controlled app sharing","description":"Decide who can publish apps and at what visibility level — private, workspace-only, or public."}}},"faq":{"title":"Frequently\nasked questions","items":{"what":{"q":"What is Base44?","a":"Base44 is an AI app builder for the whole company. Your team describes what they need in plain English, and Base44 builds the full app: frontend, backend, database, auth, all of it. It's a no code platform that ships real production apps, not prototypes. Every department works from the same workspace.","linkText":"AI app builder"},"who":{"q":"Who can actually build with Base44?","a":"Anyone in your company. Sales reps build pipeline tools, HR builds onboarding portals, finance builds dashboards. No coding background required. Any solution that any team needs, can be shipped by end of day."},"training":{"q":"Does Base44 train AI models on our data?","a":"No. Enterprise workspaces are opted out of model training by default. Your data, your apps, and your prompts stay yours."},"secure":{"q":"Is Base44 secure enough for enterprise?","a":"Yes. Base44 runs on Wix's enterprise security infrastructure. SOC 2 Type II, ISO 27001, and GDPR compliant. TLS 1.2+ in transit, AES-256 at rest, secrets managed through cloud KMS. Plus OWASP-based pen tests, an active bug bounty program, and a third-party vendor risk program covering every supplier. Learn more","linkText":"Learn more"},"control":{"q":"How do we control who can build, publish, and access what?","a":"SSO through your organizational IdP, enforced across the workspace and every app inside it. SCIM provisioning and OAuth 2.0 connectors are included. Granular roles let you decide who can build, who can publish, and at what visibility level: private, workspace-only, or public. IT monitors every action through the API."},"websites":{"q":"Can Base44 build customer-facing websites, or only internal apps?","a":"Both. Use it as an AI website builder for marketing pages, customer portals, and lead forms, or as an internal platform for dashboards, trackers, and workflows. Same workspace, same governance, separate visibility levels per app.","linkText":"AI website builder"},"agents":{"q":"Can our team build AI agents inside their apps?","a":"Yes. Every Base44 app can include an AI agent that reads from your data, calls APIs, and runs workflows. Customer support copilots, internal research bots, document classifiers, all built the same way regular apps are."},"integrations":{"q":"How does Base44 connect to systems we already use?","a":"Through OAuth 2.0 connectors, REST APIs, and direct database connections. Two-way GitHub sync and direct Figma import are included. Apps can read and write to Salesforce, SAP, Workday, HubSpot, and most internal databases without custom integration work."},"risky":{"q":"What happens if someone builds something risky?","a":"Every app runs through a built-in security scan before it can be published. Row-level security isolates data inside apps. IT can restrict workspace and app access to approved IP addresses, and set publish permissions per user so nothing ships externally without sign-off."},"hackathon":{"q":"What's a Base44 Hackathon?","a":"One day where your teams bring real problems and leave with working apps. Our team runs the session, your departments ship what they've been waiting years to build. Most companies leave with 5 to 15 apps live by the end of the day."},"pricing":{"q":"How does enterprise pricing work?","a":"Enterprise plans use a workspace credit pool. You buy a credit allocation that your whole org draws from. IT can set up per-user caps to control how much each person can use. Custom volume pricing scales with workspace size. Talk to sales for a quote based on your team and expected workload."}}},"sendoff":{"headline":"Your teams are\nready to build","cta":"Talk to sales"}},"brandedPricing":{"title":"Base44 Plans \u0026 Pricing | Start Free, Scale as You Build","description":"Compare Base44 pricing plans for building apps, websites and agents on a no-code AI platform. Start free and scale with credits, integrations and support.","headline":"Plans from first idea to full scale","subtitle":"Start for free. Upgrade when you're ready.","yearly":"Yearly","monthly":"Monthly","getStarted":"Start building","popular":"Popular","plansHeading":"Pricing plans","billedAnnually":"Billed annually","mo":"/mo","messageCredits":"message credits","integrationCredits":"integration credits","creditsTooltip":"Credits are your monthly usage allowance for AI messages and integration actions. Exact usage varies based on the action and the selected AI model.","planHighlights":"Plan highlights:","enterprise":{"title":"Looking for enterprise solutions?","description":"Custom credits, a dedicated architect, SSO, advanced security controls, and an account team that knows your stack.","cta":"Learn more"},"features":{"title":"Eliminate costly, complex add-ons.","subtitle":"Every Base44 plan includes:","aiPowered":"AI powered app building","cloudStorage":"Cloud storage","backend":"Integrated backend and database system","auth":"Authentication and user management","visualEditor":"Responsive visual editor","analytics":"Analytics dashboard","marketing":"Marketing tools","collaboration":"Multi-user editing and collaboration","debugging":"Debugging and troubleshooting tools"},"faq":{"title":"Frequently\nasked questions","q1":"What is Base44 and how does it work?","a1":"Base44 is a [no-code AI platform](https://base44.com/) that uses vibe coding to build fully-functional apps and websites. You describe what you need in plain language, and Base44 builds the full thing: frontend, backend, database, user auth, payments, all of it. The apps run on real production infrastructure, not a sandbox. Integrate it easily to all your daily tools, such as Gmail, Slack, Notion, Google Drive, Hubspot, Salesforce, etc. Keep your apps and websites private, share with your team, or publish to the web.","q2":"Do I own my app, and can I export the code?","a2":"Yes. You own everything you build on Base44: your code, your data, your users. Two-way GitHub sync exports the full source code to your own repo at any time. Nothing is locked to the platform.","q3":"How much does it cost to use Base44?","a3":"You can start building with Base44 for free, with every core feature included. Paid plans scale by credits and add tools, integrations, and support: Starter for your own projects, Builder for teams stepping up, Pro for complex apps, and Elite for builders going all in. Choose monthly or yearly billing, with a 20% discount on yearly billing. Enterprise pricing is custom — talk to sales for a quote.","q4":"How do I know which plan is right for me?","a4":"The Free plan is a full [free AI app maker](https://base44.com/ai-app-builder) with every core feature, and you can ship complete apps on it. When you hit your monthly credit limit or want premium integrations, you can upgrade to a paid plan. Most app creators land on Starter. Teams shipping multiple apps tend to land on Builder or Pro. Elite is for people running their main product or business on Base44.","q5":"Can I cancel or change my plan at any time?","a5":"Yes. Upgrade, downgrade, or cancel any time from your account settings. Changes take effect at the next billing cycle. Your apps stay live, your data stays in your workspace.","q6":"Does Base44 offer discounts on annual plans?","a6":"Yes. Annual billing saves 20% on every paid plan (Starter, Builder, Pro, and Elite). The discount applies to the monthly price multiplied by twelve, charged once a year.","q7":"What forms of payment do you accept?","a7":"All major credit and debit cards (Visa, Mastercard, American Express, Discover). Enterprise customers can pay by invoice or ACH transfer.","q8":"Are there any additional fees beyond the plan price?","a8":"No hidden fees. Your plan covers monthly credits, included integrations, and the support level for your tier. Third-party services you connect to your apps (Stripe, SendGrid, OpenAI, etc.) bill you directly on their own pricing.","q9":"Do you offer discounts for students, non-profits, or special organizations?","a9":"Yes. We offer education and non-profit pricing on a case-by-case basis. Sign up with your student email to verify your status or reach out to support with [details about your org](https://base44.com/highered) and what you're building, and we'll see what fits.","q10":"Where can I learn more about building with Base44?","a10":"The fastest way is to start building — the Free plan gives you full access as an AI app maker and you can ship your first app or website in an afternoon. For deeper AI app development reading, see [Base44 docs](https://docs.base44.com/) or browse the community [app templates gallery](https://base44.com/templates/apps)."},"cta":{"title":"So, what are we building?","button":"Get started"},"plans":{"elite":{"name":"Elite","description":"Top credits and dedicated support for builders going all in.","highlights":{"yearly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Free domain for 1 year","25 credits to share with a friend","Github integration","Early access to beta features","Premium support"],"monthly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Github integration","Early access to beta features","Premium support"]}},"pro":{"name":"Pro","description":"Advanced tools and support for building complex apps.","highlights":{"yearly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Free domain for 1 year","25 credits to share with a friend","Github integration","Early access to beta features"],"monthly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Github integration","Early access to beta features"]}},"builder":{"name":"Builder","description":"Go further with your ideas — more credits, more room to build.","highlights":{"yearly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Free domain for 1 year","25 credits to share with a friend","Github integration"],"monthly":["Unlimited number of apps","In-app code edits","AI model select","Connect a domain","Github integration"]}},"starter":{"name":"Starter","description":"Build your first apps — personal \u0026 early stage projects, and beyond.","highlights":{"yearly":["Unlimited number of apps","In-app code edits","Connect a domain","Free domain for 1 year"],"monthly":["Unlimited number of apps","In-app code edits","Connect a domain"]}},"free":{"name":"Free","description":"All of Base44's core features, for free. See what you can build.","highlights":{"yearly":["Core Base44 Features","Up to 5 apps","Authentication, database functionality, analytics."],"monthly":["Core Base44 Features","Up to 5 apps","Authentication, database functionality, analytics."]}}},"yearlySave":"SAVE 20%"},"brandedSecurity":{"hero":{"headline":"Security you can build on","subcopy":"Every app built on Base44 comes with AES-256 encryption, built-in security scans and AI-powered fixes – backed by SOC 2 Type II and ISO 27001 certification.","primaryCta":"Talk to sales","secondaryCta":"Report a Security Issue"},"badges":{"enterprise":"Enterprise"},"compliance":{"heading":"Compliance, covered","cards":{"soc2":{"title":"SOC 2 Type II","badgeAlt":"SOC 2 Type II logo","description":"Independent audit of the design and operating effectiveness of our security controls.","cta":"Request SOC Report"},"iso":{"title":"ISO 27001","badgeAlt":"ISO 27001 logo","description":"Certified information security management – the international standard.","cta":"View Certification"},"gdpr":{"title":"GDPR","badgeAlt":"GDPR logo","description":"EU data protection standards, with a Data Processing Agreement available on request.","cta":"Overview"}}},"dataRules":{"heading":"Your data,\nyour rules","intro":"Control where your data lives, who can access it and whether it trains AI models.","rows":{"residency":{"title":"Data residency","description":"Choose the region where your app data is stored.","linkText":"Learn more","linkHref":"https://docs.base44.com/Community-and-support/Privacy-and-security#changing-your-workspace-data-residency"},"trainingOptOut":{"title":"Training data opt-out","description":"Opt your workspace's data out of AI model training."},"deletion":{"title":"Deleting your app's user data","description":"Base44 supports a GDPR Deletion Flow to help you comply with users' right to erasure."}}},"practices":{"heading":"Your security, our priority.","intro":"We apply these practices at every stage – and independent auditors verify them.","cards":{"sdlc":{"title":"Secure development life-cycle","body":"Security runs through every stage of building Base44 – threat modeling, secure design, code reviews and penetration testing, so risks surface early and get fixed early."},"pentest":{"title":"Penetration testing","body":"Internal teams and third-party firms test our defenses against real-world attack scenarios, based on OWASP methodologies. Our security team reviews, prioritizes and tracks every finding to resolution."},"encryption":{"title":"Encryption \u0026 key management","body":"Base44 encrypts your app data in transit with TLS 1.2+ and at rest with AES-256, and manages secrets in a cloud key management service (KMS). Encryption covers backups too.","learnMore":"Learn more","bullet1":"HTTPS enforced on every domain, certificates issued and renewed automatically","bullet2":"An additional encryption layer on secrets and credentials","bullet3":"Automatic encryption key rotation"},"payments":{"title":"Secure payments \u0026 anti-fraud","body":"Payments run through PCI DSS-certified providers. Base44 encrypts sensitive payment data in transit and never stores it, and a layered anti-fraud system combines specialized fraud-detection providers with Base44's own detection."},"vendors":{"title":"Third-party risk management","body":"We assess every vendor against defined security and compliance requirements, and re-validate periodically. See the vendors that handle your data in the subprocessor directory below."},"bugBounty":{"title":"Bug bounty program","body":"Independent security researchers probe our systems and disclose what they find – responsibly. Our security team reviews and validates every submission, prioritizes confirmed vulnerabilities by severity and fixes them.","cta":"Ask for an Invite","mailtoSubject":"Bug bounty invite request"},"disasterRecovery":{"title":"Disaster Recovery \u0026 Business Continuity","body":"We maintain defined Recovery Time and Recovery Point Objectives aligned with industry standards, backed by frequent automated backups and documented recovery procedures. Detailed commitments are available to Enterprise customers as part of their Service Level Agreement."},"monitoring":{"title":"24/7 Security Monitoring","body":"Our platform is monitored around the clock by a 24/7/365 Security Operations Center (SOC), powered by SIEM technology and supported by a dedicated security team."},"incidentResponse":{"title":"Incident Response","body":"A dedicated Security Incident Response Team operates under a formal Incident Response Plan and Security Incident Management Policy, ensuring security events are identified, contained, and resolved quickly."}}},"subprocessors":{"heading":"Subprocessor directory","intro":"Third-party partners who help us securely process your data.","countryLabel":"Country","viewAll":"View all","purposes":{"mongo":"Data storage and hosting","sendgrid":"Email transmission and external communication","render":"Server services","gcp":"Analytics services","openai":"API calls to LLM","anthropic":"API calls to LLM","wix":"Providing and improving the services","datadog":"General logging purposes","langfuse":"LLM logging","logfire":"General logging purposes"},"countries":{"us":"US","israel":"IL","germany":"DE","uk":"UK"}},"everyApp":{"heading":"Security for\nevery app","intro":"Every app built on Base44 comes\nwith these controls:","items":{"scans":{"title":"Built-in security scans","description":"Run a security scan from every app's Security tab. It checks for vulnerable third-party dependencies (SCA), insecure code patterns (SAST), exposed secrets, missing login checks and weak data access rules. Each finding comes with a severity rating and a plain explanation – and AI fixes it for you."},"dataAccess":{"title":"Data access control","description":"Row-level security restricts data access at the database level, with granular create, read, update and delete rules per entity."},"appAccess":{"title":"App access","description":"Choose who can access each app – Private, Workspace-only or Public – and how they sign in: email, Social or SSO. For Enterprises, workspace admins can require SSO on every app."},"secrets":{"title":"Secrets management","description":"Store API keys and credentials in an encrypted vault. Only your app's backend can access them, and the people using your app never see them."},"versionHistory":{"title":"Data backup \u0026 restore","description":"See how your app's data records changed over time and recover a previous state when you need it. Admins can review, export and restore data per entity, with up to 30 days of history."},"connectors":{"title":"Connector security","description":"Connectors link your app to services like Slack, Notion and Google Workspace through OAuth. Choose the model per connector: one shared account for the whole app, or a separate account for each app user."},"wiz":{"title":"Scan with Wiz","description":"Connect your organization's Wiz tenant, and Wiz SCA and SAST scanning runs as part of every app's security scan, with findings shown alongside Base44's built-in checks."},"extensible":{"title":"Extensible security","description":"The 2-way GitHub integration exports your application code, so you can run your own security tooling or specialized compliance scanners alongside Base44's built-in protections."}}},"workspace":{"heading":"Workspace Security","intro":"Give every team a safe space to build.","cta":"Talk to sales","cards":{"roles":{"title":"Workspace roles","description":"Owner, Editor and Viewer roles on every workspace – enterprise workspaces add Admin. Each role scopes what a builder can do, from full control to read-only."},"authentication":{"title":"Workspace authentication","description":"Sign in to Base44 with Google, Apple or email and password – backed by anti-bot controls, email verification and optional 2-FA with an authenticator app, or SMS on paid plans. Organizations can sign-in with their SSO (OIDC) – Entra ID, Okta, Google, and more."},"ssoEnforcement":{"title":"SSO enforcement","description":"Enterprises can enforce organizational SSO across every app built in the workspace."},"verifiedDomain":{"title":"Verified workspace domain","description":"Verify your organization's domain with a DNS TXT record. Base44 uses it to enforce access policies and auto-onboard your team through SSO."},"ipAllowlist":{"title":"IP allowlist","description":"Restrict workspace and app access to specific networks – single IPs, CIDR ranges, IPv6 included. Requests from anywhere else get a 403."},"securityCenter":{"title":"Workspace security center","description":"One place for workspace admins to scan and review security issues across every app in the workspace."}}},"governance":{"heading":"Workspace Governance \u0026 Monitoring","intro":"From who publishes to what each builder spends – every lever in admin hands, and the logs to prove it.","cta":"Talk to sales","cards":{"scim":{"title":"SCIM provisioning","description":"Run the full lifecycle from your IdP: create, update, deactivate and delete accounts and groups, with stable external-ID matching."},"publishing":{"title":"Role-based publishing control","description":"Control who can publish and which visibility levels each role can use, with defaults applied across the workspace. Anyone blocked from publishing directly can send an approval request, so changes reach end users only through an approved path."},"connectors":{"title":"Connector management","description":"Workspace admins control which connectors are available across every app, agent and Superagent. Enable or disable connectors workspace-wide – including shared and app-user connectors – and review which apps are affected before confirming a change."},"creditLimits":{"title":"Credit limits","description":"Set a monthly credit limit per member. Spend stays predictable – and no single builder can burn through the budget."},"monitoringApi":{"title":"Monitoring API","description":"Pull workspace usage, health and analytics into your own tools through the Monitoring API – with workspace API keys that carry only the permissions you give them."},"auditLogs":{"title":"Audit logs","description":"A complete record of who did what across your workspace – sign-ins, publishing and governance events included. Stream events into your own monitoring tools through the Audit Logs API."}}},"faq":{"title":"The questions security reviews ask.","note":"Visit the Trust Center","items":{"isSecure":{"question":"Is Base44 secure?","answer":"Base44 is SOC 2 Type II and ISO 27001 certified, GDPR compliant and independently penetration-tested. Every app comes with built-in security scans, row-level security and encrypted secrets – and enterprise workspaces add SSO enforcement, IP allowlists, full audit logs and more. Visit the Base44 Trust Center.","linkText":"Base44 Trust Center"},"certifications":{"question":"What compliance certifications does Base44 have?","answer":"Base44 has SOC 2 Type II, confirmed by independent audit, and ISO 27001 certification. Base44 is also GDPR compliant, with a Data Processing Agreement available. Request reports from the compliance section above."},"dataStorage":{"question":"Where is my Base44 data stored?","answer":"Base44 stores your app data in the US by default. Workspaces on Elite and Enterprise plans can choose other regions to store instead."},"encryption":{"question":"Is my data encrypted?","answer":"Base44 encrypts your data in transit with TLS 1.2+ and at rest with AES-256."},"sso":{"question":"Can I use my company's SSO with Base44?","answer":"Yes, at two levels. Apps on Elite plans and up can offer sign-in through any OIDC identity provider – Google Workspace, Microsoft, GitHub, Okta and more. On enterprise workspaces, builders sign in with the organization's own SSO, and Enterprise admins can enforce it across every app in the workspace."},"twoFactor":{"question":"Does Base44 support two-factor authentication?","answer":"Yes. Turn on two-factor authentication with an authenticator app, or SMS on paid plans – Base44 then asks for your password and a verification code each time you sign in."},"aiProtection":{"question":"Can the AI change parts of my app I want protected?","answer":"You set the rules the AI fo