<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Sayfa Bulunamadı</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            text-align: center;
            padding: 50px;
            background: #f8f9fa;
            color: #333;
        }

        .container {
            background: white;
            padding: 40px;
            border-radius: 12px;
            display: inline-block;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            max-width: 90%;
            width: 500px;
        }

        h1 {
            color: #e74c3c;
            margin-top: 0;
        }

        .code {
            font-size: 48px;
            font-weight: bold;
            color: #bdc3c7;
            margin-bottom: 10px;
        }

        .info {
            color: #7f8c8d;
            margin: 20px 0;
            word-break: break-all;
        }

        .btn {
            text-decoration: none;
            background: #3498db;
            color: white;
            padding: 12px 25px;
            border-radius: 5px;
            display: inline-block;
            transition: background 0.3s;
        }

        .btn:hover {
            background: #2980b9;
        }

        hr {
            border: 0;
            border-top: 1px solid #eee;
            margin: 20px 0;
        }
    </style>
</head>

<body>

    <div class="container">
        <div class="code">404</div>
        <h1>Sayfa Bulunamadı</h1>

        <p class="info">İstenen adres: <br><strong>/humans.txt</strong></p>

        
        <hr>
        <a href="/" class="btn">Ana Sayfaya Dön</a>
    </div>

</body>

</html>