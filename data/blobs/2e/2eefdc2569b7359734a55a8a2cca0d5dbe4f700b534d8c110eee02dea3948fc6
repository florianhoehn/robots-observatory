<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Page not found</title>
    <style>
      :root {
        --border-radius-default: 4px;
        --color-white: #ffffff;
        --color-navy: #003366;
        --color-blue: #006699;
        --color-orange: #ff6633;
        --color-red: #e5323e;
        --font-color-heading: #404040;
        --font-color-primary: rgba(64, 64, 64, 0.87);
        --font-family-default: Roboto, 'Helvetica Neue', Helvetica, 'Segoe UI', Arial, sans-serif;
        --font-lineHeight-bigText: 1.2;
        --font-lineHeight-default: 1.5;
        --font-size-default: 14px;
        --font-size-4xl: 38px;
        --font-weight-medium: 500;
        --font-weight-bold: 700;
        --space-xl: 32px;
      }

      html {
        line-height: 1.5;
        line-height: var(--font-lineHeight-default);
        font-family: Roboto, Helvetica Neue, Helvetica, Segoe UI, Arial, sans-serif;
        font-family: var(--font-family-default);
        font-size: 14px;
        font-size: var(--font-size-default);
        color: rgba(64, 64, 64, 0.87);
        color: var(--font-color-primary);
        text-rendering: geometricPrecision;
        overflow-y: scroll;
        -webkit-font-smoothing: antialiased;
      }

      .container {
        height: 100vh;
      }

      .content {
        width: 460px;
        z-index: 1;
      }

      .alignChild--center--center {
        justify-content: center;
        align-items: center;
        display: flex;
      }

      .btnWrapper {
        text-decoration: none;
      }

      .btnWrapper span {
        font-weight: var(--font-weight-bold);
      }

      .btnWrapper:hover {
        text-decoration: none;
      }

      .color--blue {
        color: var(--color-blue) !important;
      }

      .color--navy {
        color: var(--color-navy) !important;
      }

      .color--orange {
        color: var(--color-orange) !important;
      }

      .type--head1 {
        color: var(--font-color-heading);
        font-family: var(--font-family-default);
      }

      .type--head1 {
        font-size: var(--font-size-4xl);
        font-weight: var(--font-weight-bold);
        line-height: var(--font-lineHeight-bigText);
      }

      .code {
        font-size: 100px;
        margin-top: 0;
      }

      .margin--bottom--xl,
      .margin--y--xl,
      .margin--all--xl {
        margin-bottom: var(--space-xl);
      }
      .display--none {
        display: none !important;
      }

      .display--block {
        display: block !important;
      }

      .display--flex {
        display: flex !important;
      }
      .display--inline {
        display: inline !important;
      }

      .display--inlineBlock {
        display: inline-block !important;
      }
      .display--inlineFlex {
        display: inline-flex !important;
      }
      .display--grid {
        display: grid !important;
      }

      .fdsButton {
        letter-spacing: 1px;
        font-weight: var(--font-weight-medium);
        font-size: var(--font-size-default);
        line-height: normal;
        user-select: none;
        border: 1px solid transparent;
        background-color: transparent;
        min-height: auto;
        box-sizing: border-box;
      }
      .fdsButton--m {
        padding: 0 15px;
      }

      .fdsButton--m .fdsButton-label {
        padding: 7px 0;
      }

      .fdsButton--orange {
        color: var(--color-white);
        background-color: var(--color-orange);
      }

      .fdsButton--orange.fdsButton--isActive {
        background-color: var(--color-orange);
      }

      .fdsButton--orange:hover {
        background-color: #ff7243;
      }

      .fdsButton--orange:active {
        background-color: #ff9774;
      }

      .fdsButton--orange.fdsButton--isActive:focus {
        background-color: #ff9774;
      }

      .fdsButton--orange.fdsButton--isDestructive {
        background-color: var(--color-red);
      }

      .fdsButton--orange.fdsButton--isDestructive.fdsButton--isActive {
        background-color: #ed737c;
      }

      .fdsButton--orange.fdsButton--isDestructive:hover {
        background-color: #e7424d;
      }

      .fdsButton--orange.fdsButton--isDestructive:active {
        background-color: #ed737c;
      }

      .fdsButton--orange.fdsButton--isDestructive.fdsButton--isActive:focus {
        background-color: #ed737c;
      }

      .fontStyle--caps {
        text-transform: uppercase;
      }

      .rounded--all {
        border-radius: 4px;
        border-radius: var(--border-radius-default);
      }
    </style>
  </head>
  <body>
    <div>
      <div class="alignChild--center--center container">
        <div class="content">
          <h1 class="code type--head1 color--blue margin--bottom--xl">404</h1>
          <h2 class="type--head1 color--navy">Whoops! Looks like that page doesn&#39;t exist.</h2>
          <a class="display--block margin--y--xl btnWrapper" href="https://www.cbinsights.com"
            ><button
              class="fdsButton fontStyle--caps display--inlineFlex rounded--all alignChild--center--center border--focus--noTransition transition--default fdsButton--m fdsButton--orange"
            >
              <div class="display--inlineFlex fdsButton--loading-spinnerWrapper">
                <div class=""></div>
                <span class="fdsButton-label">return to homepage</span>
              </div>
            </button></a
          >
          <p class="color--heading fontSize--l">
            <span
              >If you are having trouble finding what you&#39;re looking for, please contact us at
              <a class="color--orange" href="mailto:info@cbinsights.com"> info@cbinsights.com</a>.
            </span>
          </p>
        </div>
        <div
          style="
            display: block;
            overflow: hidden;
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            right: 0;
            box-sizing: border-box;
            margin: 0;
          "
        >
          <img
            alt="404 background"
            src="/error-pages/error-bg.svg"
            decoding="async"
            style="
              position: absolute;
              top: 0;
              left: 0;
              bottom: 0;
              right: 0;
              box-sizing: border-box;
              padding: 0;
              border: none;
              margin: auto;
              display: block;
              width: 0;
              height: 0;
              min-width: 100%;
              max-width: 100%;
              min-height: 100%;
              max-height: 100%;
              object-fit: cover;
            "
            sizes="100vw"
            srcset="
              /error-pages/error-bg.svg  640w,
              /error-pages/error-bg.svg  750w,
              /error-pages/error-bg.svg  828w,
              /error-pages/error-bg.svg 1080w,
              /error-pages/error-bg.svg 1200w,
              /error-pages/error-bg.svg 1920w,
              /error-pages/error-bg.svg 2048w,
              /error-pages/error-bg.svg 3840w
            "
          />
        </div>
      </div>
    </div>
  </body>
</html>
