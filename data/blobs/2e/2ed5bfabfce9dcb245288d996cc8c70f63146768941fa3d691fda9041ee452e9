    const legacyScriptTags = [
      `/js/apps/admin/sinclair-migration.admin.min.js`,
    ];

    function getAllScriptTags() {
      return Array.from(document.getElementsByTagName('SCRIPT'));
    }

    function forEachScriptTag() {
      const [predicate] = arguments;
      document.getAllScriptTags()
        .forEach(el => predicate(el))
    }

    function createScriptTag() {
      const [urls = '', options = {}] = arguments;
      const _urls = Array.isArray(urls) ? urls : [urls];

      return Promise.all(_urls.map(url => {
        const opts = Object.assign({name: undefined, id: undefined}, options);
        const alreadyLoaded = getAllScriptTags().some((el) => el.src === url);
        if (alreadyLoaded) {
          return Promise.resolve(null);
        }
        const script = document.createElement('SCRIPT');
        Object.assign(
          script,
          Object.keys(opts).reduce(
            (carry, key) => Object.assign(carry, typeof opts[key] !== 'undefined' ? {[key]: opts[key]} : {}),
            {}
          )
        );
        return new Promise((resolve, reject) => {
          script.onload = function () {
            resolve();
          };
          script.onerror = function () {
            console.log(`onError`, {arguments});
            reject();
          }
          script.src = url;
          document.body.appendChild(script);
        });
      }));
    }

    function serializePromiseCalls() {
      const [callList = [], inPromise = Promise.resolve()] = arguments;
      return callList.reduce(
        (prom, callback) => {
          return prom.then(() => {
            if (typeof callback === 'function') {
              const result = callback();
              return (result instanceof Promise)
                ? result
                : Promise.resolve(result);
            }
            return Promise.resolve(callback);
          });
        },
        inPromise
      );
