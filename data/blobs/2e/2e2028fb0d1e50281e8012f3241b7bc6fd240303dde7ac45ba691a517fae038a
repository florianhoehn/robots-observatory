    <script>
      (function() {
        if (typeof window.fetch !== "function" || typeof Request !== "function" || typeof Headers !== "function") {
          return;
        }
        var tokenMeta = document.querySelector('meta[name="csrf-token"]');
        if (!tokenMeta) {
          return;
        }
        var originalFetch = window.fetch.bind(window);
        var unsafeMethods = { POST: true, PUT: true, PATCH: true, DELETE: true };
        window.fetch = function(input, init) {
          var request = new Request(input, init);
          try {
            var method = String(request.method || "GET").toUpperCase();
            if (!unsafeMethods[method]) {
              return originalFetch(request);
            }
            var token = String(tokenMeta.getAttribute("content") || "").trim();
            if (!token) {
              return originalFetch(request);
            }
            var requestURL = new URL(request.url, window.location.href);
            if (requestURL.origin !== window.location.origin) {
              return originalFetch(request);
            }
            var headers = new Headers(request.headers);
            if (!headers.has("X-CSRF-Token")) {
              headers.set("X-CSRF-Token", token);
              request = new Request(request, { headers: headers });
            }
          } catch (e) {}
          return originalFetch(request);
        };
      })();
