  <style>
    :root {
      --bg-color: #f8f9fa;
      --bg-accent: #262626;
      --text-color: #212529;
      --text-muted: #a0a0a0;
      --text-message: #495057;
      --primary-color: #ff880b;
      --border-color: #dee2e6;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg-color: #121212;
        --text-color: #e0e0e0;
        --text-message: #bdbdbd;
        --border-color: #333333;
      }
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Exo 2', sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-height: 100dvh;
      line-height: 1.6;
    }
    .container {
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }
    main .container {
      max-width: 800px;
    }
    header {
      padding: 2rem 0;
      border-bottom: 5px solid var(--primary-color);
      background: var(--bg-accent);
    }
    .logo a {
      text-decoration: none;
    }
    .logo svg {
      height: 40px;
      width: auto;
      display: block;
    }
    .logos {
      display: flex;
      gap:10px;
      align-items: center;
      flex-wrap:wrap;
    }
    .logos img, .logos svg {
      vertical-align:bottom;
    }
    .logos li {
      list-style-type: none;
    }
    .logos .logo {
      flex-grow: 1;
    }
    .icon a {
      display:inline-block;
      border:3px solid transparent;
      transition:border 0.3s ease;
    }
    .icon a:hover {
      border:3px solid var(--primary-color);
    }
    .main {
      flex: 1;
      display: flex;
      align-items: center;
      padding: 4rem 0;
    }
    h1 {
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    h1 span {
      color: var(--primary-color);
    }
    .message {
      font-size: 1.2rem;
      font-weight: 300;
      color: var(--text-message);
      margin-bottom: 2rem;
    }
    .btn {
      display: inline-block;
      background-color: var(--primary-color);
      color: #ffffff;
      padding: 0.75rem 1.5rem;
      border: 0;
      border-radius: 4px;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 600;
      cursor: pointer;
      transition: opacity 0.2s ease;
    }
    .btn:hover {
      opacity: 0.9;
    }
    .btn:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 3px;
    }
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .btn:disabled:hover {
      opacity: 0.5;
    }
    footer {
      padding: 2rem 0;
      border-top: 1px solid var(--border-color);
      font-size: 0.9rem;
      color: var(--text-muted);
      background: var(--bg-accent);
    }
    footer .container {
      display:flex;
      align-items: center;
      gap:20px;
    }
    .publisher a {
      display:inline-block;
    }
    .publisher svg {
      width:150px;
      height:20px;
      display:inline-block;
      vertical-align:bottom;
    }
    footer a {
      color: var(--text-muted);
      text-decoration: none;
    }
    footer a:hover {
      color: var(--primary-color);
      text-decoration: underline;
    }
    .debug {
      margin-top: 0.5rem;
      font-family: monospace;
    }
    @media (max-width: 480px) {
      h1 {
        font-size: 1.8rem;
      }
      .message {
        font-size: 0.86rem;
      }
      .btn {
        font-size: 0.9rem;
      }
      footer {
        font-size: 0.75rem;
      }
    }
    @media (max-width:800px) {
      .logos {
        text-align:center;
        justify-content: center;
      }
      .logos .logo {
        width:100%;
      }
      .logos .logo svg {
        margin:auto;
      }
      .logos .icon {
        display:none;
      }
    }
    .logo:not(.logo-hookshot) {
      display:none;
    }
    .site-nintendolife { --primary-color:#E60012; }.site-nintendolife .logo-nintendolife { display:block; }.site-nintendolife .logo-hookshot { display:none; }.site-pushsquare { --primary-color:#0952AE; }.site-pushsquare .logo-pushsquare { display:block; }.site-pushsquare .logo-hookshot { display:none; }.site-purexbox { --primary-color:#5CB91F; }.site-purexbox .logo-purexbox { display:block; }.site-purexbox .logo-hookshot { display:none; }.site-timeextension { --primary-color:#F43590; }.site-timeextension .logo-timeextension { display:block; }.site-timeextension .logo-hookshot { display:none; }.site-digitalfoundry { --primary-color:#EA3F00; }.site-digitalfoundry .logo-digitalfoundry { display:block; }.site-digitalfoundry .logo-hookshot { display:none; }.site-steamhype { --primary-color:#0B81B7; }.site-steamhype .logo-steamhype { display:block; }.site-steamhype .logo-hookshot { display:none; }
  </style>
