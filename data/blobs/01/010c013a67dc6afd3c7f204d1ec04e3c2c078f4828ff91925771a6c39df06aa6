          // Add the value to the form's hidden field
          updateField(attrValue, attributeName)
        }
      }

      function updateField(attValue, fieldName) {
        let field = form.querySelector('input[name="' + fieldName + '"]');
        if (field) {
          field.value = attValue
        }
