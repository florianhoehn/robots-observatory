<script>
    (function() {
        var configEl = document.getElementById('sourcepoint-config');
        var config = JSON.parse(configEl.textContent);

        var isApp = false;
        var userAgent = window.navigator.userAgent;

        if (userAgent.includes("GlossyShell")) {
            isApp = true;
        }

        window._sp_queue = [];
        window._sp_ = {
            config: {
                accountId: config.accountId,
                baseEndpoint: config.baseEndpoint,
                gdpr: {
                    includeTcfApi: true
                },
                targetingParams: {
                    subscription: false,
                    isApp: isApp
                },
                events: {
                    onMessageReady: function() {
                        _sp_.config.messageShown = true;
                    },
                    onConsentReady: function(message_type, consentUUID, euconsent, info) {
                        if (info.consentedToAll) {
                            tp.push(['init', function() {
                                window.tp.consent.setAllPurposes('opt-in');
                            }]);
                        }
                        if (_sp_.config.messageShown && !info.consentedToAll && !_sp_.config.targetingParams
                            .subscription) {
                            if (config.puraboCheckoutUrl) {
                                window.location.href = config.puraboCheckoutUrl;
                            }
                        }
                        window.OE24.events.raise('cmp-changed');
                    }
                }
            }
        };

        if (config.propertyHref) _sp_.config.propertyHref = config.propertyHref;
        if (config.propertyId) _sp_.config.propertyId = config.propertyId;
        if (config.campaignEnv) _sp_.config.campaignEnv = config.campaignEnv;
        if (config.purabo) _sp_.config.isSPA = true;

        if (config.purabo) {
            window.addEventListener('pageshow', checkPurAbo);

            function checkPurAbo() {
                window.OE24.events.on('access.update', function(accessInfos) {
                    if (Object.values(accessInfos).some(i => i.granted && i.resource && i.resource.rid ===
                            config.puraboResource)) {
                        // purabo User
                        window.tp.consent.setAllPurposes('opt-out');
                        window._sp_.config.targetingParams.subscription = true;
                        Alpine.store('piano').setAbo('pur');
                        __tcfapi('postRejectAll', 2, () => {
                            submitRequiredConsents();
                        });
                    }
                    window._sp_.executeMessaging();
                });
            }

            function submitRequiredConsents(callback) {
                __tcfapi('addEventListener', 2, function(tcdata, success) {
                    __tcfapi('getCustomVendorConsents', 2, (tcdata, success) => {
                        if (tcdata.consentedAll) {
                            window.tp.consent.setAllPurposes('opt-in');
                            if (callback) {
                                callback();
                            }
                            return;
                        }

                        const grants = (tcdata && tcdata.grants) ? tcdata.grants : [];
                        const required = config.requiredConsents;

                        Object.entries(grants).forEach(([i, grant]) => {
                            const purposeGrantIds = Object.entries(grant.purposeGrants)
                                .filter(([k, v]) => v === true)
                                .map(([k, v]) => k);

                            if (required[i] && JSON.stringify(required[i].purposeIds) ===
                                JSON.stringify(purposeGrantIds)) {
                                delete required[i];
                            }
                        });

                        Object.entries(required).forEach(([vendor, vendorData]) => {
                            __tcfapi('postCustomConsent', 2, () => {}, [vendor], vendorData
                                .purposeIds, vendorData.legitimateInterestPurposeIds);
                        });

                        if (callback) {
                            callback();
                        }
                    });
                });

                window.OE24.events.on('auth.update', function(userInfo) {
                    if (!userInfo.hasSession) {
                        __tcfapi('postRejectAll', 2, () => {
                            window._sp_.resetUserState();
                        });
                        window.location.reload();
                    }
                });
            }
        }


    })();
</script>
