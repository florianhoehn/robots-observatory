        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        // Erken dir (yazi yonu) senkronizasyonu
        try {
            const ybLangsRaw = localStorage.getItem('YbLanguagesAPI');
            if (ybLangsRaw) {
                const ybParsed = JSON.parse(ybLangsRaw);
                const langsList = ybParsed ? (Array.isArray(ybParsed) ? ybParsed : ybParsed.value) : null;
                if (Array.isArray(langsList)) {
                    const currentLang = (document.documentElement.lang || 'tr').toLowerCase();
                    const langObj = langsList.find(l => (l.code || '').toLowerCase() === currentLang);
                    if (langObj && langObj.dir) {
                        document.documentElement.setAttribute('dir', langObj.dir);
                    }
                }
            }
        } catch (e) { }
    </script>
