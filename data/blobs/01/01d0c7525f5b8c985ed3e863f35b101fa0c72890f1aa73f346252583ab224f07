            height: 1.25rem;
            line-height: 1.25rem;
            overflow: hidden;
            transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .header-user-group:has(.header-logout-btn:hover) .header-user-slide-wrap {
            transform: translateX(-6px);
        }
        /* Otomatik Metin Degisim Efekti: Belirli araliklarla asagi kayarak Uye Islemleri gosterir */
        @keyframes autoUserTextSlide {
            0%, 58% {
                transform: translateY(0);
            }
            65%, 90% {
                transform: translateY(-1.25rem);
            }
            97%, 100% {
                transform: translateY(0);
            }
        }
        .header-user-slide-track {
            display: flex;
            flex-direction: column;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            animation: autoUserTextSlide 6s cubic-bezier(0.16, 1, 0.3, 1) infinite;
        }
        .header-user-btn:hover .header-user-slide-track {
            animation: none !important;
            transform: translateY(-1.25rem) !important;
        }
        .header-user-slide-item {
            height: 1.25rem;
            line-height: 1.25rem;
            font-size: 0.85rem !important;
            white-space: nowrap;
        }
        .header-logout-btn {
            position: absolute;
            right: 1px;
            top: 1px;
            bottom: 1px;
            width: 2.5rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-top-left-radius: 0;
            border-bottom-left-radius: 0;
            border-top-right-radius: calc(0.75rem - 1px);
            border-bottom-right-radius: calc(0.75rem - 1px);
            border-left: 1px solid rgba(255, 255, 255, 0.2);
            background: var(--primary);
            color: #ffffff;
            overflow: hidden;
            z-index: 2;
            cursor: pointer;
            transition: width 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-radius 0.28s ease, background-color 0.2s ease, box-shadow 0.28s ease;
        }
        .header-logout-btn:hover {
            width: 5.6rem;
            border-top-left-radius: calc(0.75rem - 1px);
            border-bottom-left-radius: calc(0.75rem - 1px);
            box-shadow: -3px 0 10px rgba(216, 112, 0, 0.3);
            justify-content: center;
            padding-left: 0.65rem;
            padding-right: 0.5rem;
        }
        .header-logout-text {
            display: inline-block;
            max-width: 0;
            opacity: 0;
            overflow: hidden;
            white-space: nowrap;
            font-size: 0.8rem;
            font-weight: 800;
            letter-spacing: -0.01em;
            margin-right: 0;
            transform: translateX(10px);
            transition: max-width 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease, margin-right 0.25s ease, transform 0.25s ease;
        }
        .header-logout-btn:hover .header-logout-text {
            max-width: 3.5rem;
            opacity: 1;
            margin-right: 0.35rem;
            transform: translateX(0);
        }

        /* Logo SVG Dark Mode Kurali: fill niteligi icermeyen en alttaki siyah path koyu modda beyaz olur */
        .site-logo {
            display: inline-block;
            vertical-align: middle;
            transition: transform 0.3s ease;
        }
        .site-logo path:not([fill]) {
            fill: #000000;
            transition: fill 0.25s ease;
        }
        .dark .site-logo path:not([fill]),
        html.dark .site-logo path:not([fill]) {
            fill: #ffffff !important;
        }
        .dark img.site-logo-img,
        .dark img[src*="logo.svg"],
        html.dark img.site-logo-img,
        html.dark img[src*="logo.svg"] {
            filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.85));
        }

