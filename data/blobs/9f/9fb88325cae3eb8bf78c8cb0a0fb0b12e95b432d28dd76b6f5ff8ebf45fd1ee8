			fb.textContent = location.hostname; fb.hidden = false;
		};
		logo.alt = location.hostname;
		logo.src = "/assets/" + location.hostname + "/images/logo_header.svg";

		// ─── LEAVE ────────────────────────────────────────────────────────────────
