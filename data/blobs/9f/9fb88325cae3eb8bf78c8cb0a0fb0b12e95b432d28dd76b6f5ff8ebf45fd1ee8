<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="robots" content="noindex, nofollow">
	<title>Adult content — 18+</title>
	<!-- Tema: cookie 'theme' (auto|light|dark). 'auto'/ausente → prefers-color-scheme (dispositivo).
	     Corre antes del render → sin flash. -->
	<script>(function(){var m=document.cookie.match(/(?:^|;\s*)theme=(light|dark)\b/);if(m)document.documentElement.setAttribute('data-theme',m[1]);})();</script>
	<style>
		/* ── Paleta del sitio · claro (default) ── */
		:root {
			--bg: #ffffff;                 /* fondo de página */
			--box: #ffffff;                /* card: blanco + sombra en claro */
			--shadow: 0 4px 24px rgba(0,0,0,.10), 0 1px 3px rgba(0,0,0,.06);
			--fg: #444444;                 /* texto rgb(68,68,68) */
			--strong: #242526;             /* títulos */
			--muted: #8a8d91;
			--stroke: rgba(0,0,0,.10);
			--btn2-bg: #e4e6eb;            /* botón secundario / neutro */
			--btn2-hover: #d8dadf;
			--lang-fg: #8a8d91;
			--lang-active-bg: #e4e6eb;
			--lang-active-fg: #444444;
			--accent: #1877f2;             /* CTA azul Facebook (flat) */
			--accent-hover: #166fe5;
		}
		/* ── Oscuro: auto (dispositivo) + override manual [data-theme] ── */
		@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) {
			--bg: #18191a; --box: #242526; --shadow: none;
			--fg: #e4e6eb; --strong: #f0f2f5; --muted: #9aa0a6;
			--stroke: rgba(255,255,255,.12);
			--btn2-bg: #464747; --btn2-hover: #4e4f4f;
			--lang-fg: #9aa0a6; --lang-active-bg: #464747; --lang-active-fg: #e4e6eb;
		} }
		:root[data-theme="dark"] {
			--bg: #18191a; --box: #242526; --shadow: none;
			--fg: #e4e6eb; --strong: #f0f2f5; --muted: #9aa0a6;
			--stroke: rgba(255,255,255,.12);
			--btn2-bg: #464747; --btn2-hover: #4e4f4f;
			--lang-fg: #9aa0a6; --lang-active-bg: #464747; --lang-active-fg: #e4e6eb;
		}
		* { box-sizing: border-box; margin: 0; padding: 0; }
		html, body { height: 100%; }
		body {
			min-height: 100%;
			display: flex; align-items: center; justify-content: center;
			padding: max(24px, env(safe-area-inset-top)) 20px max(24px, env(safe-area-inset-bottom));
			font-family: "Noto Sans", sans-serif;
			color: var(--fg);
			background: var(--bg);
			-webkit-font-smoothing: antialiased;
		}
		.card {
			width: 100%; max-width: 480px;
			background: var(--box);
			border: 1px solid var(--stroke);
			border-radius: 34px;
			padding: 40px 32px 32px;
			text-align: center;
		}
		.logo { height: 52px; width: auto; max-width: 78%; margin: 0 auto 24px; display: block; object-fit: contain; }
		.logo-fallback { font-size: 1.35rem; font-weight: 800; letter-spacing: .04em; margin-bottom: 24px; color: var(--strong); }
		h1 {
			font-size: 1.28rem; font-weight: 700; line-height: 1.25; margin-bottom: 16px;
			letter-spacing: -.01em; color: var(--strong);
		}
		.disclaimer { font-size: .93rem; line-height: 1.6; color: var(--muted); margin-bottom: 24px; }
		.disclaimer a { color: var(--fg); text-decoration: underline; }
		.disclaimer a:hover { color: var(--strong); }
		.actions { display: flex; flex-direction: column; gap: 12px; }
		.btn {
			appearance: none; border: 0; cursor: pointer;
			font-family: inherit; font-size: 1.02rem; font-weight: 700; letter-spacing: .06em;
			padding: 16px 20px; border-radius: 16px; width: 100%;
			transition: transform .12s ease, box-shadow .2s ease, opacity .2s ease, background .15s ease;
		}
		.btn:active { transform: translateY(1px); }
		.btn-enter {
			color: #fff;
			background: var(--accent);
		}
		.btn-enter:hover { background: var(--accent-hover); }
		.btn-enter:disabled { opacity: .7; cursor: progress; }
		.btn-leave { color: var(--fg); background: var(--btn2-bg); }
		.btn-leave:hover { background: var(--btn2-hover); }
		#captchaBox { display: flex; justify-content: center; margin-bottom: 16px; }
		#captchaBox[hidden] { display: none; }
		.langs { margin-top: 24px; display: flex; flex-wrap: wrap; gap: 8px 4px; justify-content: center; }
		.lang {
			background: none; border: 0; cursor: pointer; color: var(--lang-fg);
			font: inherit; font-size: .72rem; padding: 4px 8px; border-radius: 8px; letter-spacing: .02em;
		}
		.lang[aria-current="true"] { color: var(--lang-active-fg); background: var(--lang-active-bg); }
		@media (max-width: 380px) { .card { padding: 28px 20px 24px; border-radius: 28px; } h1 { font-size: 1.15rem; } }
	</style>
</head>
<body>
	<main class="card" role="dialog" aria-labelledby="title">
		<img class="logo" id="logo" alt="" hidden>
		<div class="logo-fallback" id="logoFallback" hidden></div>

		<h1 id="title"></h1>
		<p class="disclaimer" id="disclaimer"></p>

		<div id="captchaBox" hidden></div>

		<div class="actions">
			<button class="btn btn-enter" id="enter" type="button"></button>
			<button class="btn btn-leave" id="leave" type="button"></button>
		</div>

		<nav class="langs" id="langs" aria-label="Language"></nav>
	</main>

	<script>
