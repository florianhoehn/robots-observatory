<!DOCTYPE html PUBLIC
        "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Page Not Found</title>
    <style>
        html, body, .container {
            height: 100%;
        }
        body {
            font-family: sans-serif;
            font-size: 40px;
            margin: 0;
            font-weight: bold;
        }
        b {
            font-size: 1.5em;
        }

        small {
            font-size: .5em;
        }
        .container {
            display: table;
            width: 100%;
        }
        .container-inner {
            display: table-cell;
            text-align: center;
            vertical-align: middle;
        }
        .info-block {
            position: relative;
            color: rgb(32, 70, 151);
        }
        .error-code {
            opacity: .4;
            font-size: 300px;
            font-weight: bold;
        }
        .error-message {
            position: absolute;
            width: 100%;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            -ms-transform: translateY(-50%);
            -webkit-transform: translateY(-50%);
            text-align: center;
        }
        @media screen and (max-width: 768px) {
            body {
                font-size: 20px;
            }
            .error-code {
                font-size: 100px;
            }

            img {
                max-width: 200px;
            }
        }
        @media screen and (max-width: 1400px) {
            body {
                font-size: 30px;
            }
            .error-code {
                font-size: 200px;
            }

            img {
                max-width: 300px;
            }
        }
    </style>
</head>

<body>
<div class="container">
    <div class="container-inner">
        <img src="/static/images/cat-404.png" alt=""/>
        <div class="info-block">
            <div class="error-code">
                404
            </div>
            <div class="error-message">
                <b>Oops!</b><br>
                You’ve tried to reach <br>a page we cannot find<br>
                <small>
                    You will be redirected to the Search page in
                    <span id="counterElement"></span>
                </small>
            </div>
        </div>

    </div>
</div>
</body>
<script>
    var REDIRECT_DELAY_SEC = 5,
        counter = 0,
        counterElement = document.getElementById('counterElement');
    if (counterElement) {
        counterElement.innerText = REDIRECT_DELAY_SEC;
        setInterval(timer, 1000);
    }
    function timer() {
        counter += 1;
        if (counter === REDIRECT_DELAY_SEC) {
            location.href = '/';
        }
        counterElement.innerText = REDIRECT_DELAY_SEC - counter;
    }
</script>

</html>