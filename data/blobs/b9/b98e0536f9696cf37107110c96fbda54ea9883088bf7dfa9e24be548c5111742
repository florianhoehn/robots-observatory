    <style>
        * {
    padding: 0;
    margin: 0;
    font-family: 'Roboto', sans-serif;
    box-sizing: border-box;
}

html {
    height: 100%;
}

/* BODY */
body {
    min-height: 100vh;
    display: grid;
    grid-template-rows: auto 85% auto;
    grid-template-areas:
        'header'
        'main'
        'footer';
}

/* HEADER */
header {
    width: 100%;
    align-items: center;
    justify-content: center;
    height: 79px;
    grid-area: header;
    background: #FFFFFF;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
}
header .section-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 22px 12px 22px 12px;
}
@media (max-width: 850px) {
    header .section-logo {
        height: 79px;
        padding: 0px 12px 0px 12px;
    }
    header .section-logo img {
        width: 137px;
    }
}

/* CONTENT */
main {
    width: 0 auto;
    flex: 1;
    flex-direction: center;
    margin-left: 15%;
    grid-area: main;
}
main .main-icon svg{
    margin-top: calc(50% - 69px);
}
main .align-content {
    display: grid;
    grid-auto-flow: column;
    gap: 77px;
    display: flex;
    margin-top: 10%;
    margin-bottom: 5%;
}
main .align-option {
    margin-top: 40px;
    gap: 37px;
    display: flex;
    flex-direction: column;
}
main .align-content h1 {
    font-style: normal;
    font-weight: 400;
    font-size: 32px;
    line-height: 45px;
    letter-spacing: 0.04em;
    color: #D71920;
    margin-bottom: 16px;
}
main .align-content h2{
    font-style: normal;
    font-weight: 400;
    font-size: 24px;
    line-height: 160%;
    color: #000000;
    width: 75%;
    margin-bottom: 17px;
}
main .align-content p {
    font-weight: 400;
    font-size: 16px;
    line-height: 160%;
    color: #333333;
    width: 80%;
}
main .align-option .option {
    display: flex;
    gap: 13px;
    margin-bottom: 5px;
}
main .align-option .option p span {
    display: flex;
    font-style: normal;
    font-weight: 400;
    font-size: 16px;
    line-height: 160%;
    color: #5C5C5C;
    flex-direction: column;
}
main .align-option .option p {
    margin-top: 3px;
    margin-bottom: 10px;
}
main .align-option span {
    font-size: 14px;
    line-height: 160%;
}
@media (max-width: 850px) {
    main {
        margin-left: 0;
        gap: 40px;
        margin: 5%;
    }
    main .align-content {
        gap: 30px;
        margin-top: 5%;
        display: grid;
        grid-auto-flow: row;
    }
    main .align-content h1 {
        text-align: center;
    }
    main .align-content h2{
        width: 100%;
        text-align: center;
    }
    main .align-content p {
        margin-left: 3vh;
    }
    main .align-content .text {
        width: 95% !important;
    }
    main .main-icon svg{
        margin-top: -20px;
        margin: 0 auto;
        display: flex;
        height: 121px;
    }
}
@media (max-width: 520px) {
    main .align-content p {
        width: 90%;
    }
}
/* FOOTER */
footer {
    width: 100%;
    text-align: center;
    height: 125px;
    justify-content: center;
    background: #EBEBEB;
    display: flex;
    bottom: 0;
    grid-area: footer;
    
}
footer p {
    margin: 2%;
    font-style: normal;
    font-weight: 400;
    font-size: 12px;
    line-height: 21px;
    color: #333333;
}
footer .align-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
}
footer .align-network {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0px 53px;
}
footer .align-network i {
    color: #333333;
    font-size: 20px;
}
@media (max-width: 850px) {
    footer {
        height: auto;
        padding: 2% 0 2% 0;
    }
    footer .align-footer {
        flex-direction: column;
        gap: 6px;
    }
    footer p {
        text-align: center;

    }
}
