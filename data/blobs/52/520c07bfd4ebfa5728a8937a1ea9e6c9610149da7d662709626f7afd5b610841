<script>
    function handleSImageOnError(img) {
        if (img.src) {
            var avifSource = img.parentElement && img.parentElement.querySelector('.avif-source');

            function isAvif(src) {
                return src && src.split('.').pop() === 'avif';
            }

            function replaceToJPG (src) {
                return src.substring(0, src.lastIndexOf('.')) + '.jpg';
            }

            if (avifSource && isAvif(avifSource.srcset)) {
                avifSource.srcset = replaceToJPG(img.src);
            } else if (isAvif(img.src)) {
                img.src = replaceToJPG(img.src);
            } else {
                img.onerror = null;
                img.removeAttribute('onerror');
            }

            img.setAttribute('data-error-handled', 'true');
        }
    }
