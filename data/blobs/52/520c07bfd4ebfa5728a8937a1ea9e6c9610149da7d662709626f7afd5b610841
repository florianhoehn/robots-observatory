                resolveFn = resolve;
                rejectFn = reject;
            });

            Object.defineProperty(self, 'promise', {
                value: promise,
                writable: false
            });

            DeferWrapper.prototype.resolve = function (x) {
                resolveFn(x);
            };

            DeferWrapper.prototype.reject = function (x) {
                rejectFn(x);
