/* floatfix ::before/::after ������ CSS Grid � �������� ������ */
.index-page .h-plans.floatfix::before,
.index-page .h-plans.floatfix::after,
.index-page .guarantee.floatfix::before,
.index-page .guarantee.floatfix::after {
    content: none;
    display: none;
}

.index-page .h-plans > li {
