             server-side. Mirrors @eventbrite/rokt-sdk's consent model. -->
        <script type="text/javascript">
            (function(w, d) {
                var JURISDICTION = w.__ROKT_JURISDICTION__;
                var loaded = false;

                function accepted(names) {
                    try {
                        var consent = w.airgap && w.airgap.getConsent
                            ? w.airgap.getConsent()
                            : null;
                        var purposes = consent && consent.purposes;
                        if (!purposes) {
                            return false;
                        }
                        for (var i = 0; i < names.length; i++) {
                            var value = purposes[names[i]];
                            if (value !== undefined) {
                                return value === true || value === 'Auto';
                            }
                        }
                        return false;
                    } catch (e) {
                        return false;
                    }
                }

                function targeting() {
                    return accepted(['Advertising', 'advertising', 'Targeting', 'targeting']);
                }

                // Injecting app.js installs a third-party advertising SDK and
                // discloses the IP, device details and referrer, so nobody
                // gets it without advertising consent, in any region.
                function load() {
                    if (loaded || !targeting()) {
                        return;
                    }
                    loaded = true;
                    w.mParticle = w.mParticle || {};
                    w.mParticle.config = w.mParticle.config || {};
                    w.mParticle.config.isDevelopmentMode = false;
                    var launcherOptions = w.mParticle.config.launcherOptions || {};
