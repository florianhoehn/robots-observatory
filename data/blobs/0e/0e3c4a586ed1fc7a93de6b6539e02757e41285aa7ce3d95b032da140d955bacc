<script>
if (window.LUX) {
    LUX.addData("dbQueryCount", 0);
    LUX.addData("dbQueryTime", 0);

    window.addEventListener("load", () => {
        // Record the difference between the user's local timezone offset and the account offset
        const offsetHours = Math.round(Math.abs(window.timezoneOffset - (new Date()).getTimezoneOffset()) / 60);

        if (!isNaN(offsetHours)) {
            LUX.addData("timezone-offset-hours", offsetHours);
        }
    });

    const getInlineScriptBytes = () => [...document.querySelectorAll("script")].reduce((b, s) => b + s.innerHTML.length, 0);
    let totalDownloadedBytes = 0;
    let externalScriptBytes = 0;
    let addDataTimeout = 0;

    const pageDataObserver = new PerformanceObserver((list) => {
        list.getEntries().forEach((res) => {
            totalDownloadedBytes += res.transferSize;

            if (res.initiatorType === "script" && res.name.indexOf("jsonp=") === -1) {
                externalScriptBytes += res.decodedBodySize;
            }

            if (res.name.indexOf("https://cdn.mxpnl.com/") === 0 && res.duration > 0) {
                LUX.addData("ad-blocker-detected", "false");
            }
        });

        // Wait 2 seconds before sending the updated data to avoid sending too many beacons.
        clearTimeout(addDataTimeout);
        addDataTimeout = setTimeout(() => {
            LUX.addData("total-bytes-downloaded", totalDownloadedBytes);
            LUX.addData("uncompressed-js-bytes", externalScriptBytes + getInlineScriptBytes());
        }, 2000);
    });

    pageDataObserver.observe({ type: "resource", buffered: true });

    // Stop recording data after 30 seconds.
    setTimeout(() => pageDataObserver.disconnect(), 30_000);
}
</script>

