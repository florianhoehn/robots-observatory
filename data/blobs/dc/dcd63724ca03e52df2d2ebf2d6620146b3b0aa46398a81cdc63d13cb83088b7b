  }
  .mgm-col{padding:0!important;border-right:none!important;border-bottom:1px solid var(--bdr)}
  .mgm-col:last-child{border-bottom:none}
  .mgm-col-title{padding:10px 20px 6px!important;margin:0!important;border-bottom:none!important;font-size:.69rem}
  .mgm-col a{padding:11px 20px 11px 34px!important;border-radius:0!important;border-bottom:1px solid var(--bdr)!important;white-space:normal!important}
