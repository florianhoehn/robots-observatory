<style>
/* ================================================================
   RESET & VARIABILE
================================================================ */
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Plus Jakarta Sans',sans-serif;color:#1e293b;background:#fff;line-height:1.6;-webkit-font-smoothing:antialiased}
a { text-decoration: none; color: inherit; }

p a, li a, .content a {
  color: var(--p);
  text-decoration: underline;
  text-underline-offset: 3px;
}

p a:hover, li a:hover, .content a:hover {
  color: var(--pdk);
}
ul{list-style:none}
img{max-width:100%;display:block}
:root{
  --p:#2563eb;--pdk:#1d4ed8;--plt:rgba(37,99,235,.1);
  --ok:#10b981;--warn:#f59e0b;--bad:#ef4444;
  --bg:#fff;--card:#fff;--soft:#f8fafc;
  --txt:#1e293b;--sub:#475569;--bdr:#e2e8f0;
  --r:16px;--rlg:24px;
  --transition:.2s ease;  
}
@media(prefers-color-scheme:dark){
  :root{--bg:#0f172a;--card:#1e293b;--soft:#111a2e;--txt:#f1f5f9;--sub:#94a3b8;--bdr:#334155;--p-text:#93c5fd;}
  body{background:var(--bg);color:var(--txt)}
}

/* ================================================================
   UTILITARE
================================================================ */
.container{max-width:1200px;margin:0 auto;padding:0 20px}
.section-padding{padding-top:70px;padding-bottom:70px}
.section-header{text-align:center;margin-bottom:50px}
.section-header h2{font-size:2.2rem;font-weight:800;line-height:1.2}
.section-header p{color:var(--sub);margin-top:10px;font-size:1rem;max-width:600px;margin-left:auto;margin-right:auto}

.btn-primary,.btn-p{display:inline-flex;align-items:center;justify-content:center;background:var(--p);color:#fff!important;padding:12px 26px;border-radius:10px;font-weight:700;border:none;cursor:pointer;font-size:.95rem;font-family:inherit;white-space:nowrap;transition:.2s;text-align:center}
.btn-primary:hover,.btn-p:hover{background:var(--pdk);transform:translateY(-1px);box-shadow:0 6px 20px rgba(37,99,235,.3)}
.btn-outline,.btn-o{display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--p);color:var(--p)!important;padding:10px 26px;border-radius:10px;font-weight:700;font-size:.95rem;background:transparent;white-space:nowrap;transition:.2s;text-align:center}
.btn-outline:hover,.btn-o:hover{background:var(--p);color:#fff!important;transform:translateY(-1px)}
.btn-white,.btn-w{display:inline-flex;align-items:center;justify-content:center;background:#fff;color:var(--p)!important;padding:12px 26px;border-radius:10px;font-weight:700;transition:.2s}
.btn-white:hover,.btn-w:hover{background:#f1f5f9;transform:translateY(-1px)}

.badge{display:inline-block;padding:5px 14px;border-radius:50px;font-size:.78rem;font-weight:700;letter-spacing:.5px}
.badge-blue{background:var(--plt);color:var(--p)}
.badge-green{background:rgba(16,185,129,.15);color:var(--ok)}
.badge-orange{background:rgba(245,158,11,.15);color:var(--warn)}

/* ================================================================
   TOP BAR
================================================================ */
#gz-top{background:#f1f5f9;border-bottom:1px solid var(--bdr);padding:8px 0;font-size:.8rem;font-weight:600}
@media(prefers-color-scheme:dark){#gz-top{background:#1e293b}}
.top-row{display:flex;justify-content:space-between;align-items:center;gap:16px}
.top-l,.top-r{display:flex;gap:16px;align-items:center}
.top-l a,.top-r a{color:var(--sub);display:flex;align-items:center;gap:5px}
.top-l a:hover,.top-r a:hover{color:var(--p)}
.top-r .tlogin{background:var(--p);color:#fff!important;padding:5px 14px;border-radius:6px}
.top-r .tlogin:hover{background:var(--pdk)}
.top-r .tcart{display:inline-flex;align-items:center;gap:6px;background:var(--ok);color:#fff!important;padding:5px 14px;border-radius:6px;font-weight:700;transition:.2s}
.top-r .tcart:hover{background:#059669}
.top-r .tsoc{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:6px;font-size:.85rem;transition:.2s;color:var(--sub)!important}
.top-r .tsoc:hover{color:#fff!important}
.top-r .tsoc.fb:hover{background:#1877f2;color:#fff!important}
.top-r .tsoc.tw:hover{background:#000;color:#fff!important}
.top-r .tsoc.is:hover{background: radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285aeb 90%);color: #fff !important;}
.top-r .tsep{width:1px;height:16px;background:var(--bdr);flex-shrink:0}

/* ================================================================
   HEADER  — sticky, z-index 1000
================================================================ */
#gz-hdr{
  background:rgba(255,255,255,.97);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--bdr);
  position:sticky;top:0;
  z-index:1000;          /* suficient de mare */
  padding:14px 0;
  transition:box-shadow .2s;
}
@media(prefers-color-scheme:dark){#gz-hdr{background:rgba(15,23,42,.97)}}
#gz-hdr.scrolled{box-shadow:0 4px 20px rgba(0,0,0,.08)}
.hdr-row{
  display:flex;align-items:center;
  justify-content:space-between;
  gap:16px;
  position:relative;  /* anchor pentru meniul mobil absolute */
}
.gz-logo{flex-shrink:0;line-height:0}
.gz-logo img{height:52px;width:auto;display:block}
.gz-logo .logo-dark{display:none}
@media(prefers-color-scheme:dark){.gz-logo .logo-light{display:none}.gz-logo .logo-dark{display:block}}



/* ================================================================
   NAV — desktop: flex row normal
================================================================ */
#gz-nav{
  display:flex;
  align-items:center;
  gap:2px;
  list-style:none;
}

/* link direct nivel 1 */
.nav-link{
  display:inline-flex;align-items:center;gap:5px;
  padding:8px 12px;border-radius:8px;
  font-weight:600;font-size:.88rem;color:var(--txt);
  white-space:nowrap;cursor:pointer;
  vertical-align:middle;
}
.nav-link:hover,.nav-link.active{background:var(--soft);color:var(--p)}

/* item cu dropdown */
.has-dd{position:relative}
.has-dd > .nav-link .arr{font-size:.65rem;margin-left:2px;transition:transform .2s}
.has-dd:hover > .nav-link .arr{transform:rotate(-180deg)}

/* panel dropdown — desktop: apare la hover */
.dd-panel{
  display:none;
  position:absolute;top:100%;left:0;
  padding-top:8px;   /* pod invizibil */
  min-width:230px;
  z-index:1001;
}
.dd-inner{
  background:var(--card);
  border:1px solid var(--bdr);
  border-radius:14px;
  padding:8px;
  box-shadow:0 20px 50px rgba(0,0,0,.12);
}
.has-dd:hover > .dd-panel{display:block}
.dd-panel{max-width:calc(100vw - 40px)}

.dd-panel a{
  display:flex;align-items:center;gap:10px;
  padding:10px 14px;border-radius:8px;
  font-size:.87rem;font-weight:600;color:var(--txt)!important;
}
.dd-panel a i{color:var(--p);width:16px;font-size:.8rem}
.dd-panel a:hover{background:var(--soft);color:var(--p)!important}
.dd-panel hr{border:none;border-top:1px solid var(--bdr);margin:6px 0}

/* CTA desktop */
.gz-cta{flex-shrink:0}

/* ================================================================
   BURGER — ascuns desktop, vizibil mobil
================================================================ */
#gz-burger{
  display:none;
  background:none;border:1px solid var(--bdr);border-radius:8px;
  width:42px;height:42px;cursor:pointer;
  align-items:center;justify-content:center;
  font-size:1.3rem;color:var(--txt);flex-shrink:0;
}
#gz-burger:hover{background:var(--soft)}

/* ================================================================
   MOBIL (<=768px)
   Aceeasi abordare ca pe gazduire.net:
   - nav-links ascuns implicit
   - apare cu .active ca bloc absolut sub header
   - fara fixed, fara overlay, simplu si functional
================================================================ */
@media(max-width:768px){

  #gz-top{padding:6px 0}
  .top-l{display:none}
  .top-row{gap:0}
  .top-r{flex:1;gap:8px;align-items:center}
  .top-r .tsep{display:none}
  .top-r .tsoc.fb{margin-left:auto}
  .gz-cta{display:none}
  #gz-burger{display:inline-flex}

  /* Panoul de navigare — ascuns implicit */
  #gz-nav{
    display:none;                  /* ascuns */
    flex-direction:column;
    align-items:stretch;
    gap:0;
    position:absolute;
    top:100%;                      /* chiar sub header */
    left:0;
    width:100%;
    background:var(--card);
    box-shadow:0 8px 20px rgba(0,0,0,.12);
    border-top:1px solid var(--bdr);
    z-index:999;
    max-height:80vh;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
  }

  /* Vizibil cand e activ */
  #gz-nav.active{display:flex}

  /* Link simplu */
  .nav-link{
    padding:15px 20px;
    font-size:1rem;font-weight:700;
    border-bottom:1px solid var(--bdr);
    border-radius:0;gap:10px;
    display:flex;
  }
  .nav-link i{color:var(--p)}

  /* Dropdown mobil */
  .has-dd{border-bottom:1px solid var(--bdr)}
  .has-dd > .nav-link{border-bottom:none;justify-content:space-between}
  .arr{margin-left:auto}
  .has-dd.active > .nav-link .arr{transform:rotate(-180deg)}

  /* Panel dropdown — accordion */
  .dd-panel{
    display:block;     /* mereu in DOM */
    position:static;
    padding-top:0;
    min-width:unset;
    z-index:auto;
    max-height:0;
    overflow:hidden;
    transition:max-height .25s ease;
  }
  .dd-inner{
    background:var(--soft);
    border:none;border-radius:0;
    padding:0;box-shadow:none;
  }
  .has-dd.active > .dd-panel{max-height:600px}

  /* Hover dezactivat pe mobil */
  .has-dd:hover > .dd-panel{display:block;max-height:0;overflow:hidden}
  .has-dd.active > .dd-panel{display:block;max-height:600px}

  .dd-panel a{
    padding:14px 20px 14px 44px;
    border-radius:0;
    border-bottom:1px solid var(--bdr);
    font-size:.92rem;
  }
  .dd-panel a:last-of-type{border-bottom:none}
  .dd-panel hr{display:none}
}

/* ================================================================
   COMPONENTE PAGINA
================================================================ */
.breadcrumb{background:var(--soft);border-bottom:1px solid var(--bdr);padding:11px 0;font-size:.83rem}
.breadcrumb-inner{display:flex;gap:8px;align-items:center;color:var(--sub);flex-wrap:wrap}
.breadcrumb-inner a{color:var(--p)}
.breadcrumb-inner a:hover{text-decoration:underline}
.breadcrumb-inner .sep{font-size:.65rem}

.page-hero{background:linear-gradient(135deg,#0a1628 0%,#0f172a 50%,#1a2744 100%);color:#fff;padding:65px 0 55px;text-align:center;position:relative;overflow:hidden}
.page-hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 50% -20%,rgba(37,99,235,.25) 0%,transparent 65%);pointer-events:none}
.page-hero .container{position:relative;z-index:1}
.page-hero h1{font-size:clamp(1.8rem,4vw,2.7rem);font-weight:800;margin-bottom:14px;line-height:1.15}
.page-hero h1 .accent{color:#3b82f6}
.page-hero p{color:#94a3b8;font-size:1.05rem;max-width:580px;margin:0 auto;line-height:1.7}
.page-badge{display:inline-flex;align-items:center;gap:7px;background:rgba(37,99,235,.25);border:1px solid rgba(37,99,235,.5);color:#93c5fd;padding:5px 16px;border-radius:50px;font-size:.78rem;font-weight:700;letter-spacing:.8px;margin-bottom:18px}
@media(max-width:768px){.page-hero{padding:48px 0 38px}}

.card{background:var(--card);border:1px solid var(--bdr);border-radius:var(--rlg);padding:33px 28px;transition:.2s;position:relative;display:flex;flex-direction:column}
.card:hover{box-shadow:0 15px 40px rgba(0,0,0,.07);transform:translateY(-3px)}
.card.featured{border:2px solid var(--p);box-shadow:0 20px 50px rgba(37,99,235,.12)}
.card-badge{position:absolute;top:-13px;left:50%;transform:translateX(-50%);background:var(--p);color:#fff;padding:4px 18px;border-radius:50px;font-size:.7rem;font-weight:800;white-space:nowrap}
.price-old{color:var(--sub);text-decoration:line-through;font-size:.95rem;margin-top:8px}
.price-main{font-size:2.8rem;font-weight:800;color:var(--p);line-height:1;margin:8px 0 5px}
.price-main span{font-size:.88rem;color:var(--sub);font-weight:400}
.specs-list li{margin-bottom:11px;display:flex;align-items:center;gap:10px;font-size:.92rem}
.specs-list i.fa-check{color:var(--ok);font-size:.78rem}
.specs-list i.fa-xmark{color:var(--bad);font-size:.78rem}
.card-actions{margin-top:20px;display:flex;flex-direction:column;gap:10px}
.pricing-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(255px,1fr));gap:24px}
@media(max-width:600px){.pricing-grid{grid-template-columns:1fr}}

.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));text-align:center;background:var(--soft);border:1px solid var(--bdr);border-radius:var(--rlg);margin:50px 0;overflow:hidden}
.stat-item{padding:34px 14px;border-right:1px solid var(--bdr)}
.stat-item:last-child{border-right:none}
.stat-item i{font-size:1.8rem;color:var(--p);margin-bottom:10px;display:block}
.stat-item h4{font-size:1.8rem;font-weight:800}
.stat-item p{color:var(--sub);font-size:.84rem}
@media(max-width:768px){.stats-row .stat-item{border-right:none;border-bottom:1px solid var(--bdr)}.stats-row .stat-item:last-child{border-bottom:none}}

.migration-banner{background:linear-gradient(135deg,#1e3a5f 0%,#0f172a 100%);border:1px solid rgba(37,99,235,.3);color:#fff;padding:52px 60px;border-radius:var(--rlg);text-align:center;margin:50px 0;position:relative;overflow:hidden}
.migration-banner::before{content:'';position:absolute;top:-60px;right:-60px;width:220px;height:220px;background:radial-gradient(circle,rgba(37,99,235,.2),transparent 70%);pointer-events:none}
.migration-banner .promo-tag{display:inline-flex;align-items:center;gap:7px;background:rgba(37,99,235,.3);border:1px solid rgba(37,99,235,.5);color:#93c5fd;padding:5px 16px;border-radius:50px;font-size:.78rem;font-weight:700;margin-bottom:16px}
.migration-banner h2{font-size:1.9rem;margin-bottom:12px}
.migration-banner p{color:#94a3b8;max-width:580px;margin:0 auto 24px;line-height:1.7}
.mig-features{display:flex;justify-content:center;gap:13px;flex-wrap:wrap;margin-bottom:26px}
.mig-features span{background:rgba(255,255,255,.07);padding:6px 14px;border-radius:8px;font-size:.84rem;display:flex;align-items:center;gap:8px}
.mig-features span i{color:#22c55e}
@media(max-width:768px){.migration-banner{padding:36px 22px}}

.info-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin:38px 0}
.info-box{background:var(--card);border:1px solid var(--bdr);border-radius:var(--r);padding:26px 22px;text-align:center;transition:.2s}
.info-box:hover{border-color:var(--p);box-shadow:0 8px 20px rgba(37,99,235,.08);transform:translateY(-2px)}
.info-box i{font-size:1.9rem;color:var(--p);margin-bottom:13px;display:block}
.info-box h4{font-weight:700;margin-bottom:8px;font-size:.98rem}
.info-box p{font-size:.87rem;color:var(--sub);line-height:1.6}

.faq-item{background:var(--card);border:1px solid var(--bdr);border-radius:12px;margin-bottom:10px;overflow:hidden;transition:border-color .2s}
.faq-item.open{border-color:var(--p)}
.faq-question{padding:18px 22px;font-weight:700;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-size:.94rem;gap:12px;user-select:none}
.faq-question:hover{color:var(--p)}
.faq-question i{transition:transform .2s;color:var(--sub);flex-shrink:0}
.faq-item.open .faq-question i{transform:rotate(180deg);color:var(--p)}
.faq-answer{padding:0 22px;color:var(--sub);font-size:.91rem;line-height:1.75;max-height:0;overflow:hidden;transition:max-height .35s ease,padding .25s ease}
.faq-item.open .faq-answer{max-height:600px;padding-bottom:18px}

.compare-table{width:100%;border-collapse:collapse;margin:28px 0;border-radius:12px;overflow:hidden}
.compare-table th{background:var(--p);color:#fff;padding:13px 16px;text-align:left;font-size:.87rem}
.compare-table td{padding:12px 16px;border-bottom:1px solid var(--bdr);font-size:.87rem}
.compare-table tr:last-child td{border-bottom:none}
.compare-table tr:nth-child(even) td{background:var(--soft)}
.compare-table .check{color:var(--ok)}
.compare-table .cross{color:var(--bad)}

.domain-search{background:#fff;padding:8px;border-radius:13px;display:flex;max-width:680px;margin:0 auto 18px;box-shadow:0 22px 45px rgba(0,0,0,.3)}
.domain-search input{flex:1;border:none;padding:13px 17px;font-size:1rem;outline:none;border-radius:8px;color:#1e293b;font-family:inherit;background:transparent;min-width:0}
.domain-search button{background:var(--p);color:#fff;border:none;padding:13px 28px;font-weight:700;border-radius:8px;cursor:pointer;font-family:inherit;font-size:.93rem;white-space:nowrap;flex-shrink:0;transition:.2s}
.domain-search button:hover{background:var(--pdk)}
.domain-prices{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;font-size:.84rem}
.domain-prices span{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);padding:5px 13px;border-radius:50px;color:#cbd5e1}
.domain-prices span strong{color:#fff}
@media(max-width:600px){.domain-search{flex-direction:column}.domain-search button{padding:13px;border-radius:8px}}

.logos-strip{background:var(--soft);border:1px solid var(--bdr);border-radius:var(--r);padding:28px 38px;margin:40px 0}
.logos-strip-inner{display:flex;align-items:center;justify-content:center;gap:38px;flex-wrap:wrap;filter:grayscale(1) opacity(.45);transition:filter .4s}
.logos-strip-inner:hover{filter:grayscale(0) opacity(.9)}
.logo-partner{font-weight:800;font-size:.9rem;color:var(--sub)}

.wa-float{position:fixed;bottom:28px;right:28px;background:#25d366;color:#fff;width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:26px;z-index:2000;box-shadow:0 8px 25px rgba(37,211,102,.35);transition:transform .2s}
.wa-float:hover{transform:scale(1.1);color:#fff}

.news-item{background:var(--card);padding:20px 22px;border-radius:12px;margin-bottom:14px;border:1px solid var(--bdr);border-left:4px solid var(--p);transition:.2s}
.news-item:hover{box-shadow:0 8px 25px rgba(0,0,0,.08);transform:translateX(3px)}
.news-item small{color:var(--p);font-weight:700;font-size:.73rem;letter-spacing:1px}
.news-item h4{font-size:1rem;margin:5px 0}
.news-item p{font-size:.85rem;color:var(--sub);line-height:1.6}

.form-group{margin-bottom:18px}
.form-group label{display:block;font-weight:600;margin-bottom:7px;font-size:.9rem}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:12px 15px;border:1px solid var(--bdr);border-radius:10px;background:var(--card);color:var(--txt);font-family:inherit;font-size:.93rem;outline:none;transition:.2s}
.form-group input:focus,.form-group textarea:focus,.form-group select:focus{border-color:var(--p);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.form-group textarea{min-height:130px;resize:vertical}

.feature-row{display:flex;align-items:center;gap:55px;margin:60px 0;flex-wrap:wrap}
.feature-row.reverse{flex-direction:row-reverse}
.feature-content{flex:1;min-width:270px}
.feature-content h2{font-size:1.85rem;font-weight:800;margin-bottom:16px}
.feature-content p{color:var(--sub);margin-bottom:22px;line-height:1.75}
.feature-image{flex:1;min-width:270px;background:var(--soft);height:270px;border-radius:var(--rlg);display:flex;align-items:center;justify-content:center;font-size:4.5rem;color:var(--p);border:1px solid var(--bdr)}
/* ================================================================
   WHATSAPP FLOAT
   ================================================================ */
