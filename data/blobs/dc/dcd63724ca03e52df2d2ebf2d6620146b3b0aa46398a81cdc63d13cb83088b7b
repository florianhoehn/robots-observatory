.mgm-has:hover > .nav-link .arr{transform:rotate(-180deg)}

/* Panoul principal — fixed, lipit de header, lat cat pagina */
.mgm-panel{
  visibility:hidden;
  opacity:0;
  pointer-events:none;
  position:fixed;
  left:0;
  right:0;
  top:80px;
  z-index:2000;
  transition:opacity .15s .1s,visibility .15s .1s;
}
.mgm-has.mgm-open > .mgm-panel{
  visibility:visible;
  opacity:1;
  pointer-events:auto;
  transition:opacity .1s,visibility .1s;
}



/* Interior panou — latimea containerului, centrat */
.mgm-inner{
  max-width:1200px;
  margin:0 auto;
  padding:24px 20px;
  background:var(--card);
  border-left:1px solid var(--bdr);
  border-right:1px solid var(--bdr);
  border-bottom:1px solid var(--bdr);
  border-top:3px solid var(--p);
  box-shadow:0 20px 50px rgba(0,0,0,.15);
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:0;
}
.mgm-inner.mgm-c2{grid-template-columns:1fr 1fr}
/* Banda de fundal full-width sub header */
.mgm-panel::before{
  content:'';
  position:absolute;
  inset:0;
  background:var(--card);
  border-top:3px solid var(--p);
  border-bottom:1px solid var(--bdr);
  z-index:-1;
}

/* Coloana */
.mgm-col{
  padding:0 18px;
  border-right:1px solid var(--bdr);
}
.mgm-col:first-child{padding-left:0}
.mgm-col:last-child{border-right:none;padding-right:0}

