  document.querySelectorAll("[data-site-header]").forEach((header) => {
    const triggers = [...header.querySelectorAll("[data-nav-trigger]")];
    const drawers = [...header.querySelectorAll("[data-nav-drawer]")];
    const mobileOpenButton = header.querySelector("[data-mobile-menu-open]");
    const mobileMenu = header.querySelector("[data-mobile-menu]");
    const mobileCloseButtons = [...header.querySelectorAll("[data-mobile-menu-close]")];
    const mobileSubmenuTriggers = [...header.querySelectorAll("[data-mobile-submenu-trigger]")];
    const mobileSubmenus = [...header.querySelectorAll("[data-mobile-submenu]")];
    const mobileSubmenuBackButtons = [...header.querySelectorAll("[data-mobile-submenu-back]")];
    const mobileMenuOpenLabel = header.getAttribute("data-mobile-menu-open-label") || "Open navigation menu";
    const mobileMenuCloseLabel = header.getAttribute("data-mobile-menu-close-label") || "Close navigation menu";
    const desktopMediaQuery = window.matchMedia("(min-width: 901px)");
    const reducedMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
    const mobilePanel = mobileMenu?.querySelector('[role="dialog"]');
    const mobileRootSections = [...(mobilePanel?.children || [])].filter((element) => !element.hasAttribute("data-mobile-submenu"));
    let mobileMenuIsOpen = false;
    let activeSubmenu = null;
    let activeSubmenuTrigger = null;
    let backgroundElements = [];
    let mobileMenuCloseTimer;
    let mobileSubmenuCloseTimer;

    const focusControl = (element) => element?.focus({ preventScroll: true });
    const activeControls = () => [...(activeSubmenu || mobilePanel).querySelectorAll('a[href], button, [tabindex]')]
      .filter((element) => element.tabIndex >= 0 && !element.disabled && !element.closest('[inert], [hidden]') && element.getClientRects().length);

    const setBackgroundInert = () => {
      // Disable siblings along the ancestor path without making the dialog inert.
      for (let branch = mobileMenu; branch?.parentElement; branch = branch.parentElement) {
        [...branch.parentElement.children].forEach((element) => {
          if (element !== branch && element instanceof HTMLElement && !element.inert) {
            backgroundElements.push(element);
            element.inert = true;
          }
        });
        if (branch.parentElement === document.body) break;
      }
    };

    const restoreBackground = () => {
      backgroundElements.forEach((element) => { element.inert = false; });
      backgroundElements = [];
    };

    const closeDesktopDrawers = () => {
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      drawers.forEach((drawer) => {
        drawer.hidden = true;
      });
    };

    const closeMobileSubmenus = () => {
      window.clearTimeout(mobileSubmenuCloseTimer);
      mobileSubmenuTriggers.forEach((trigger) => trigger.setAttribute("aria-expanded", "false"));
      mobileSubmenus.forEach((submenu) => {
        submenu.removeAttribute("data-state");
        submenu.hidden = true;
        submenu.inert = true;
      });
      mobileRootSections.forEach((element) => { element.inert = false; });
      activeSubmenu = null;
      activeSubmenuTrigger = null;
    };

    const openMobileMenu = () => {
      if (!mobileMenu || !mobileOpenButton || mobileMenuIsOpen || desktopMediaQuery.matches) {
        return;
      }

      closeDesktopDrawers();
      window.clearTimeout(mobileMenuCloseTimer);
      closeMobileSubmenus();
      mobileMenuIsOpen = true;
      mobileMenu.hidden = false;
      mobileMenu.inert = false;
      mobileMenu.getBoundingClientRect();
      mobileMenu.setAttribute("data-state", "open");
      mobileOpenButton.setAttribute("aria-expanded", "true");
      mobileOpenButton.setAttribute("aria-label", mobileMenuCloseLabel);
      header.setAttribute("data-mobile-menu-state", "open");
      document.documentElement.setAttribute("data-mobile-nav-open", "");
      setBackgroundInert();
      focusControl(mobilePanel.querySelector("[data-mobile-menu-close]"));
    };

    const closeMobileMenu = (immediate = false) => {
      if (!mobileMenu || !mobileOpenButton) {
        return;
      }

      const wasOpen = mobileMenuIsOpen;
      const focusWasInMenu = mobileMenu.contains(document.activeElement);
      mobileMenuIsOpen = false;
      window.clearTimeout(mobileMenuCloseTimer);
      closeMobileSubmenus();
      mobileMenu.inert = true;
      mobileMenu.removeAttribute("data-state");
      mobileOpenButton.setAttribute("aria-expanded", "false");
      mobileOpenButton.setAttribute("aria-label", mobileMenuOpenLabel);
      header.removeAttribute("data-mobile-menu-state");
      document.documentElement.removeAttribute("data-mobile-nav-open");
      restoreBackground();
      if (wasOpen || focusWasInMenu) {
        // The mobile opener is display:none after the desktop breakpoint.
        focusControl(desktopMediaQuery.matches ? header.querySelector(".nav-row .brand-link") : mobileOpenButton);
      }
      if (immediate || reducedMotionQuery.matches || !wasOpen) {
        mobileMenu.hidden = true;
      } else {
        mobileMenuCloseTimer = window.setTimeout(() => { mobileMenu.hidden = true; }, 180);
      }
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const drawer = header.querySelector(`#${CSS.escape(trigger.getAttribute("aria-controls"))}`);
        const isOpen = trigger.getAttribute("aria-expanded") === "true";

        closeDesktopDrawers();

        if (drawer && !isOpen) {
          trigger.setAttribute("aria-expanded", "true");
          drawer.hidden = false;
        }
      });
    });

    mobileOpenButton?.addEventListener("click", () => {
      const isOpen = mobileOpenButton.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        closeMobileMenu();
      } else {
        openMobileMenu();
      }
    });

    mobileCloseButtons.forEach((button) => {
      button.addEventListener("click", () => closeMobileMenu());
    });

    mobileSubmenuTriggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const submenu = header.querySelector(`#${CSS.escape(trigger.getAttribute("aria-controls"))}`);
        if (!submenu || !mobileMenuIsOpen) {
          return;
        }

        closeMobileSubmenus();
        activeSubmenu = submenu;
        activeSubmenuTrigger = trigger;
        trigger.setAttribute("aria-expanded", "true");
        submenu.hidden = false;
        submenu.inert = false;
        submenu.getBoundingClientRect();
        submenu.setAttribute("data-state", "open");
        focusControl(submenu.querySelector("[data-mobile-submenu-back]"));
        mobileRootSections.forEach((element) => { element.inert = true; });
      });
    });

    mobileSubmenuBackButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!activeSubmenu) return;
        const submenu = activeSubmenu