          .reduce((acc, v) => {
            acc[decodeURIComponent(v[0].trim())] = decodeURIComponent(v[1].trim());
            return acc;
          }, {});

        const getCookie = (name) => getCookies()[name];

        const getSparrowId = () => {
          const cookie = getCookie('sparrow_id');
          try {
            return JSON.parse(cookie)?.userId;
          } catch(e) {
            return undefined;
          }
        };

        const getEcid = () => {
          return window.ecid;
