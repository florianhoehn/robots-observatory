    const countFrame = document.querySelector('.count');
    let count = 6;

    function Counter() {
        if(count <= 4 && count > 1) {
            countFrame.textContent = count + ' секунды';
        } else if(count === 1) {
            countFrame.textContent = count + ' секунду';
        } else {
            countFrame.textContent = count + ' секунд';
        }
        if(count > 1) {
            count--;
        }
    }
    let timer = setInterval(Counter, 1000);

    function search (form) {
        const inputSearch = form.querySelector('#q')

        if(!inputSearch.value.length) {
            inputSearch.value = inputSearch.placeholder
        }
        form.submit()
    }
    const formSearchElement = document.querySelector('#search')

