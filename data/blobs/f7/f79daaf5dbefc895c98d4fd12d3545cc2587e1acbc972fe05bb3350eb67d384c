        (function() {
            const myPages = ['/tv-programm'];
            const cookieName = "mychannelsorting"
            const date = new Date();
            const daysOfExp = 10
            date.setTime(date.getTime() + (daysOfExp * 24 * 60 * 60 * 1000));
            const expires = "expires=" + date.toUTCString();
            if(myPages.length){
                myPages.forEach((el) => {
                    document.cookie = cookieName + "=1; " + expires + "; path=" + el; 
                })
            }

            if(!window.TvsData){
                window.TvsData = {}
            }

            function getCookie(name) {
                let match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
                if (match) return match[2];
                return null;
            }

            var targetCookie = getCookie('auth0UserLocal1');
            window.TvsData.loggedIn = !!targetCookie
           
        })();
    </script>




