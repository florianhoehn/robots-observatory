    <style>
        html,
        body {
            height: 100%;
        }
        body {
            color: #DDD;
            background-color: #171717;
        }
        h1,h2,h3 {
            margin: 0;
            font-weight: 400;
        }
        h1, h2 {
            margin-bottom: 16px;
        }
        h1 {
            font-size: 50px;
        }
        h2 {
            font-size: 30px;
        }
        h3 {
            font-size: 26px;
        }
        .en {
            color: #888;
        }
        .wrapper {
            width: 100%;
            padding-top: 40px;
            margin: 0 auto;
        }
        .wrapper .title-wrapper, .bot {
            width: 100%;
            max-width: 960px;
            margin: 0 auto;
            padding: 0 10px;
            text-align: left;
        }
        .wrapper .mid {
            position: relative;
            margin: 40px 0 30px;
            background-color: #D9D9D9;
        }
        .wrapper .mid .bg-wrapper {
            position: relative;
            width: 100%;
            max-width: 960px;
            margin: 0 auto;
            padding-top: 40px;
        }
        .wrapper .mid .bg-wrapper #bg {
            width: 100%;
            max-width: 960px;
        }
        .wrapper .mid .bg-wrapper .img-wrapper {
            position: absolute;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            max-width: 32vw
        }
        .wrapper .mid .img-wrapper #block {
            width: 100%;
            height: 100%;
        }
        .wrapper .mid .img-wrapper #emoji {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 58%;
        }

        .wrapper .bot {
            display: flex;
        }
        .wrapper .bot .info {
            width: 100%;
            font-size: 16px;
            text-align: left;
            line-height: 24px;
        }
        .wrapper .bot .info .desc {
            margin-top: 8px;
            font-size: 16px;
            color: #888;
        }
        .wrapper .bot .divider {
            width: 87px;
        }
        .wrapper .email {
            margin-top: 30px;
            font-size: 13px;
            color: #DDD;
            font-weight: 600;
            text-align: center;
        }

        .wrapper .cloudflare-info {
            width: 100%;
            margin-top: 8px;
            font-size: 14px;
            text-align: center;
        }
        .wrapper .cloudflare-info #ip-reveal {
            display: inline-block;
            cursor: pointer;
        }
        @media (max-width: 767px) {
            h1 {
                font-size: 30px;
            }
            h2 {
                font-size: 24px;
            }
            h3 {
                font-size: 18px;
            }
            body {
                overflow-x: hidden;
            }
            .wrapper {
                padding: 25px 0;
            }
            .wrapper .title-wrapper, .bot {
                padding: 0 16px;
            }
            .wrapper .mid {
                margin: 30px 0;
            }
            .wrapper .mid .bg-wrapper {
                padding-top: 16px;
            }
            .wrapper .mid .bg-wrapper .img-wrapper {
                width: 30vw;
                bottom: 10px;
            }
            .wrapper .bot {
                width: auto;
                display: block;
            }
            .wrapper .bot .info span {
                font-size: 14px;
            }
            .wrapper .bot .divider {
                height: 45px;
            }
            .wrapper .email {
                margin: 50px 16px 0;
                padding-top: 16px;
                text-align: start;
                border-top: 1px solid #444;
            }
            .wrapper .cloudflare-info {
                padding: 0 16px;
                text-align: left;
            }
            .wrapper .cloudflare-info span {
                display: block;
            }
            .wrapper .cloudflare-info .dot {
                display: none;
            }
        }
    </style>
