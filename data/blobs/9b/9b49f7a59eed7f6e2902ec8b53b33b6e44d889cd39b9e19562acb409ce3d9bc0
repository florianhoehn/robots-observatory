  <script>
    let initialiseMenu

    document.addEventListener('DOMContentLoaded', (event) => {
      function InitialiseMenu(state = -1) {
        const add = (ele, clss) => {
          if (typeof ele === 'string') {
            ele = document.querySelectorAll(ele)[0]
          }
          ele.classList.add(clss)
        }

        const remove = (ele, clss) => {
          if (typeof ele === 'string') {
            ele = document.querySelectorAll(ele)[0]
          }
          if (ele.classList.contains(clss)) {
            ele.classList.remove(clss)
          }
        }

        const arrows = document.querySelectorAll('.navitem_arrow__icon').forEach((ele) => {
          ele.addEventListener('click', (e) => {

            const on = 'navitem--open'
            const off = 'navitem_nested-menu--collapse'
            if (e.target.parentElement.parentElement.classList.contains(on)) {
              remove(e.target.parentElement.parentElement, on)
              add(e.target.parentElement.nextElementSibling, off)
            } else {
              add(e.target.parentElement.parentElement, on)
              remove(e.target.parentElement.nextElementSibling, off)
            }
          })
        })

        return () => {
          if ((state *= -1) === 1) {
            add('.navbar_hamburger__icon', 'navbar_hamburger__icon--change')
          } else {
            remove('.navbar_hamburger__icon', 'navbar_hamburger__icon--change')
          }
