<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta name="theme-color" content="#313338">
    <meta
      name="description"
      content="janitor is managing traffic. Try again shortly, or use the iOS or Android app."
    >
    <title>Please wait — janitor</title>

      <meta http-equiv="refresh" content="20">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    >

    <style>
      :root {
        color-scheme: dark;
        --bg: #313338;
        --text: #f2f3f5;
        --muted: #a9aeb5;
        --pink: #f786f4;
        --font: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        background: var(--bg);
        -webkit-text-size-adjust: 100%;
      }

      body {
        min-height: 100vh;
        min-height: 100dvh;
        margin: 0;
        display: grid;
        place-items: center;
        padding:
          max(24px, env(safe-area-inset-top))
          max(20px, env(safe-area-inset-right))
          max(24px, env(safe-area-inset-bottom))
          max(20px, env(safe-area-inset-left));
        color: var(--text);
        background: var(--bg);
        font-family: var(--font);
        font-size: 15px;
        line-height: 1.55;
        text-align: center;
        -webkit-font-smoothing: antialiased;
      }

      main {
        width: min(100%, 360px);
      }

      .logo {
        display: block;
        height: 28px;
        width: auto;
        margin: 0 auto 28px;
      }

      h1 {
        margin: 0 0 12px;
        font-size: 1.25rem;
        font-weight: 500;
        letter-spacing: -0.01em;
        line-height: 1.3;
      }

      p {
        margin: 0 0 12px;
        color: var(--muted);
      }

      p:last-child {
        margin-bottom: 0;
      }

      .wait {
        margin: 20px 0;
        color: var(--text);
        font-weight: 500;
      }

      .apps {
        margin: 24px 0 0;
        color: var(--muted);
      }

      .apps a {
        color: var(--pink);
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      .apps a:hover {
        color: #f9a4f7;
      }

      .turnstile:empty {
        display: none;
      }

      .turnstile {
        min-height: 65px;
        margin: 24px auto 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .note {
        margin-top: 20px;
        font-size: 13px;
      }
    </style>
  </head>

  <body>
    <main aria-labelledby="page-title">
      <img
        class="logo"
        src="https://ella.janitorai.com/logo.svg"
        alt="janitor"
        width="302"
        height="84"
      >

      <h1 id="page-title">You’re in line</h1>
      <p>
        Traffic is high right now, so we’re letting people in slowly to keep things stable.
        Keep this page open, or chat in the app while you wait.
      </p>

      <p class="wait" aria-live="polite" aria-atomic="true">
          Estimated wait: 20 minutes

      </p>

      <p class="apps">
        Get the app:
        <a href="https://apps.apple.com/app/janitor-ai-official-app/id6692609366">iOS</a>
        ·
        <a href="https://play.google.com/store/apps/details?id=com.janitor.ai">Android</a>
      </p>

      <div class="turnstile" aria-label="Security check"></div>

        <p class="note">
          This page refreshes every 20 seconds.
        </p>

    </main>
  </body>
</html>
