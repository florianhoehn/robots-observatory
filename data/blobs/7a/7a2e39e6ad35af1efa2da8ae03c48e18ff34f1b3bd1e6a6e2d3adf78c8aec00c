<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Country Blocked</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #000000;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .container {
            width: 100%;
            max-width: 600px; 
            padding: 20px;
			background-color: #242424;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0px 2px 8px rgba(0, 0, 0, 0.1);
            margin: 20px;
        }
						        /* Decorative Divider */
        .decorative-divider {
            border: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, #ffe062, transparent);
            margin: 20px 0;
            opacity: 1;
        }
		   .divider {
            border: 0;
            height: 1px;
            background: linear-gradient(to right, transparent, #ffe062, transparent);
            margin: 10px 0;
            opacity: 1;
        }

        .container h1 {
		
            font-size: 1.8rem;
            color: #f0f0f5;
            margin-bottom: 20px;
        }

        .container p {
            font-size: 1rem;
            color: #f0f0f5;
            margin: 15px 0;
        }

        .icon {
            display: block;
            margin: 30px auto;
            width: 150px;
            height: 150px;
        }

        .contact {
            margin-top: 20px;
        }

        .contact a {
            color: #4299e1;
            text-decoration: none;
        }

        .contact a:hover {
            text-decoration: underline;
        }

        .note {
            font-weight: bold;
        }

        /* Media Queries for responsiveness */
        @media (min-width: 1024px) {
            .container {
                max-width: 500px;
            }
        }

        @media (min-width: 1440px) {
            .container {
                max-width: 600px;
            }

            .container h1 {
                font-size: 2rem;
            }

            .container p {
                font-size: 1.1rem;
            }

            .icon {
                width: 75px;
                height: 75px;
            }
        }

        @media (max-width: 768px) {
            .container {
                padding: 15px;
            }

            .container h1 {
                font-size: 1.5rem;
            }

            .container p {
                font-size: 0.9rem;
            }

            .icon {
                width: 75px;
                height: 75px;
            }
        }

        @media (max-width: 480px) {
            .container {
                padding: 10px;
                margin: 10px;
            }

            .container h1 {
                font-size: 1.4rem;
            }

            .container p {
                font-size: 0.85rem;
            }

            .icon {
                width: 75px;
                height: 75px;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Country Blocked</h1>
	<p>Unfortunately, bwinners.gm is not available in your country at the moment.</p>
