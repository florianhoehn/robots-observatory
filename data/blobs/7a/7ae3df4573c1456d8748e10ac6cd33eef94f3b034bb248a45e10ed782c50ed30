		<script>
			const collapseWhiteSpace = (value) => {
				return(value.trim().replace(/\s+/g, " "))
			}

			const extractLinesFromTextNode = (textNode) => {
				if (textNode.nodeType === 3) {
					// Safari needs this.
					textNode.textContent = collapseWhiteSpace(textNode.textContent)

					const textContent = textNode.textContent
					const range = document.createRange()
					let lines = []
					let lineCharacters = []

					for (let i = 0; i < textContent.length; i++) {
						range.setStart(textNode, 0)
						range.setEnd(textNode, (i + 1))

						const lineIndex = (range.getClientRects().length - 1)

						if (!lines[lineIndex]) {
							lines.push(lineCharacters = [])
						}

						lineCharacters.push(textContent.charAt(i))
					}

					lines = lines.map((characters) => {
						return(collapseWhiteSpace(characters.join("")))
					})

					return lines
				}
			}

			const getLineWidth = (line, size = null) => {
				const testSpan = document.getElementById('invisibleTitleBlocking')
				const title = document.querySelector('.title > h1')
				const titleStyle = window.getComputedStyle(title, null)
				const fontSize = !size ? titleStyle.getPropertyValue('font-size') : size + 'px'
				const fontFamily = titleStyle.getPropertyValue('font-family')
				const fontStyle = titleStyle.getPropertyValue('font-style')
				const fontWeight = titleStyle.getPropertyValue('font-weight')
				const lineHeight = titleStyle.getPropertyValue('line-height')
				const letterSpacing = titleStyle.getPropertyValue('letter-spacing')

				testSpan.innerHTML = line
				testSpan.style.fontSize = fontSize
				testSpan.style.fontFamily = fontFamily
				testSpan.style.fontStyle = fontStyle
				testSpan.style.fontWeight = fontWeight
				testSpan.style.lineHeight = lineHeight
				testSpan.style.letterSpacing = letterSpacing

				const lineWidth = testSpan.clientWidth + 1

				return {lineWidth, fontSize}
			}

			const blockTitle = () => {
				const title = document.querySelector('.title > h1')
				const titleWidth = title.offsetWidth - 1
				const titleArray = title.firstChild

				const titleLines = extractLinesFromTextNode(titleArray)


				title.innerHTML = ''

				titleLines.forEach(line => {
					const {lineWidth, fontSize} = getLineWidth(line)
					const span = document.createElement('span')
					let adjustedFont = Math.floor(((titleWidth * parseInt(fontSize, 10)) / lineWidth))
					const { lineWidth: adjustedLineWidth } = getLineWidth(line, adjustedFont)
					const isBigger = (titleWidth - adjustedLineWidth) < -1
					if (isBigger) {
						adjustedFont = adjustedFont - Math.floor((adjustedLineWidth - titleWidth) / 3)
					}
					span.innerHTML = line
					span.style.fontSize = adjustedFont + 'px'
					if (adjustedFont > parseInt(fontSize, 10)) {
						span.style.lineHeight = 1
					}
					title.appendChild(span)

				})
			}

			window.onload = () => {
				blockTitle()
			}
		</script>
