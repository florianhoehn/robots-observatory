        var updatedValue = replaceText.call(node, node.nodeValue || '', countryCode);
        if (updatedValue !== node.nodeValue) {
          node.nodeValue = updatedValue;
        }
      }

      updateLegalContactLinks();
      ensureInternationalRegistration(countryCode);
      d.body.setAttribute('data-legal-country', useRussianLegalEntity ? 'RU' : 'INT');
    }

    function fetchBrowserCountry() {
      return fetch('https://api.country.is/', { cache: 'no-store' })
        .then(function (response) {
          if (!response.ok) {
            throw new Error('Browser geo lookup failed');
          }
          return response.json();
        })
        .then(function (data) {
          return String(data.country || '').toUpperCase();
        })
        .catch(function () {
          return '';
        });
    }

    function fetchServerCountry() {
      return fetch('/wp-json/kids360/v1/country', {
        cache: 'no-store',
        credentials: 'same-origin'
      })
      .then(function (response) {
        if (!response.ok) {
          throw new Error('Geo lookup failed');
        }
        return response.json();
      })
      .then(function (data) {
        return String(data.country_code || '').toUpperCase();
      })
      .catch(function () {
        return '';
      });
    }

    fetchBrowserCountry()
      .then(function (browserCountry) {
        if (/^[A-Z]{2}$/.test(browserCountry)) {
