      var internationalRegistration = (isRussianLanguage ? 'Регистрационный номер ' : 'Registration number ')
        + internationalRegistrationNumber;
      var internationalRegistrationSentence = internationalRegistration + '.';
      var isLegalText = this && this.parentElement
        && this.parentElement.closest('.policy__content, .technical-page');
      var registrationPattern = /(?:Registration\s*(?:number|No\.?|№)|Регистрационн(?:ый|ого)\s+номер|License\s+number|лицензи(?:я|и)\s*№?)\s*(?:№\s*)?(?:HE489355|60339380Q|1778509)\.?/gi;
      var updatedValue;

      if (useRussianLegalEntity) {
        updatedValue = value
          .replace(/MINDCARE LAB LTD/gi, russianName)
          .replace(/MINDCARE LAB LTD/gi, russianName)
          .replace(/Aeolou\s*(?:&|&amp;|&#0*38;)\s*Panagiotis Diomidous,\s*9,\s*Katholic 3020,\s*Limassol,\s*Cyprus/gi, russianAddress)
