      var registrationNumber = "HE489355";
      var internationalAddress = w.atob("QWVvbG91ICYgUGFuYWdpb3RpcyBEaW9taWRvdXMsIDksIEthdGhvbGljIDMwMjAsIExpbWFzc29sLCBDeXBydXM=");
