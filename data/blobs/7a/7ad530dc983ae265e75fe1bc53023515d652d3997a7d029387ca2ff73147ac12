        + registrationNumber + '.';
      var hasRegistration = roots.some(function (root) {
        return String(root.textContent || '').indexOf(registrationNumber) !== -1;
      });

      if (hasRegistration) {
        return;
      }

      for (var rootIndex = 0; rootIndex < roots.length; rootIndex += 1) {
        var candidates = roots[rootIndex].querySelectorAll('li, p');

        for (var candidateIndex = 0; candidateIndex < candidates.length; candidateIndex += 1) {
          var candidate = candidates[candidateIndex];
          if (String(candidate.textContent || '').indexOf(internationalAddress) === -1) {
            continue;
          }

          var textWalker = d.createTreeWalker(candidate, NodeFilter.SHOW_TEXT);
          var textNode;

          while ((textNode = textWalker.nextNode())) {
            var addressIndex = String(textNode.nodeValue || '').indexOf(internationalAddress);
            if (addressIndex === -1) {
              continue;
            }

            var insertionIndex = addressIndex + internationalAddress.length;
            var beforeRegistration = String(textNode.nodeValue || '').slice(0, insertionIndex);
            var afterRegistration = String(textNode.nodeValue || '').slice(insertionIndex);
            textNode.nodeValue = beforeRegistration.replace(/\.*$/, '') + '. '
              + registrationText + afterRegistration;
            return;
          }
        }
      }
    }

    function applyLegalEntity(countryCode) {
      if (!d.body) {
        return;
      }

      var isRussianLanguage = /^ru(?:-|$)/i.test(d.documentElement.lang || '');
      var useRussianLegalEntity = countryCode === 'RU' && isRussianLanguage;
      var companyName = useRussianLegalEntity
        ? "\u041e\u041e\u041e \u00ab\u041a\u0418\u0414\u0421 \u0410\u041f\u041f\u0421\u00bb"        : w.atob("TUlORENBUkUgTEFCIExURA==");
      var companyAddress = useRussianLegalEntity
        ? "614066, \u0420\u043e\u0441\u0441\u0438\u044f, \u041f\u0435\u0440\u043c\u0441\u043a\u0438\u0439 \u043a\u0440\u0430\u0439, \u0433. \u041f\u0435\u0440\u043c\u044c, \u0443\u043b. \u0421\u0442\u0430\u0445\u0430\u043d\u043e\u0432\u0441\u043a\u0430\u044f \u0443\u043b., \u0434. 54, \u0441\u0442\u0440. \u041e"        : w.atob("QWVvbG91ICYgUGFuYWdpb3RpcyBEaW9taWRvdXMsIDksIEthdGhvbGljIDMwMjAsIExpbWFzc29sLCBDeXBydXM=");

      d.querySelectorAll('.footer__company-name, .contacts__info-company-name').forEach(function (element) {
