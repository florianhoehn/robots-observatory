<script>
    window.rjConsentHandler = {
        handleAllConsents: function () {
            console.log('Osano - RJ HandleAllConsents');
            const consent = window.Osano.cm.getConsent();
            window.rjConsentHandler.marketingConsent.handle(consent);
            window.rjConsentHandler.analyticsConsent.handle(consent);
        },
        deletePlaceholders: function (selector) {
            const elementsToDelete = document.querySelectorAll(selector);
            elementsToDelete.forEach(element => {
                element.remove();
            });
        },
        createPlaceholder: function (text, className) {
            const placeholder = document.createElement('div');
            placeholder.className = 'rj-consent-placeholder ' + className;
            placeholder.innerHTML = `
            <div>
                <p>${text}</p>
                <button onclick="window.Osano.cm.showDrawer()">Manage Privacy Settings</button>
            </div>
            `;
            return placeholder;
        },
        marketingConsent: {
            delete: function () {
                window.rjConsentHandler.deletePlaceholders('.rj-consent-placeholder-marketing');
            },
            handle: function (consent) {
                console.log('Osano - Marketing Consent: ', consent.MARKETING);
                if (consent.MARKETING !== "ACCEPT") {
                    // window.rjConsentHandler.marketingConsent.stn(consent);
                    window.rjConsentHandler.marketingConsent.trinityAudio(consent);
                }

            },
            stn: function (consent) {
                // const blockedElems = document.querySelectorAll('script[type="osano/blocked"][data-type="s2nScript"]');
                const blockedElems = document.querySelectorAll('.s2nPlayer');
                const text = `
                    Your privacy settings have blocked this video. To access, please adjust your cookie preferences.
                    <br>Please provide consent for <b>Targeted Advertising</b> to view this content.
                `;
                blockedElems.forEach(elem => {
                    const placeholder = window.rjConsentHandler.createPlaceholder(text, 'rj-consent-placeholder-marketing');
                    elem.insertAdjacentElement("beforebegin", placeholder);
                });
            },
            trinityAudio: function (consent) {
                const blockedElems = document.querySelectorAll('#most-view-audio');
                const text = `
                    Your privacy settings have blocked this audio. To access, please adjust your cookie preferences.
                    <br>Please provide consent for <b>Targeted Advertising</b> to view this content.
                `;
                blockedElems.forEach(elem => {
                    const placeholder = window.rjConsentHandler.createPlaceholder(text, 'rj-consent-placeholder-marketing');
                    elem.insertAdjacentElement("beforebegin", placeholder);
                });
            },
        },
        analyticsConsent: {
            delete: function () {
                window.rjConsentHandler.deletePlaceholders('.rj-consent-placeholder-analytics');
            },
            handle: function (consent) {
                console.log('Osano - Analytics Consent: ', consent.ANALYTICS);
                if (consent.ANALYTICS !== "ACCEPT") {
                    // Most read.
                    window.rjConsentHandler.analyticsConsent.mostRead(consent);
                }
            },
            mostRead: function () {
                const blockedElems = document.querySelectorAll('.rj-most-view .field-story, #recommend-marfeel');
                const text = `
                    Your privacy settings have blocked this content. To access, please adjust your cookie preferences.
                    <br>Please provide consent for <b>Analytics</b> to view this content.
                `;
                blockedElems.forEach(elem => {
                    const placeholder = window.rjConsentHandler.createPlaceholder(text, 'rj-consent-placeholder-analytics');
                    elem.insertAdjacentElement("beforebegin", placeholder);
                });
            },
        },
    };

    window.Osano.cm.addEventListener('osano-cm-initialized', () => {
        console.log('Osano - Initialized', 'Jurisdiction: ' + window.Osano.cm.jurisdiction);
        const jurisdiction = window.Osano.cm.jurisdiction;
        if (
            jurisdiction &&
            jurisdiction.startsWith('us-') &&
            ![
                'us-ca', 'us-co', 'us-ct', 'us-de', 'us-ia',
                'us-mn', 'us-mt', 'us-ne', 'us-nh', 'us-nj',
                'us-or', 'us-tn', 'us-tx', 'us-ut', 'us-va'
            ].includes(jurisdiction)
        ) {
            const observer = new MutationObserver((mutations, obs) => {
                const message = document.querySelector('.osano-cm-content__message.osano-cm-message');
                if (message) {
                    message.textContent = "This website uses cookies and similar tracking technologies and collects information about you and your visit. You may manage your cookie preferences by clicking the “Manage Preferences” button below.";
                    obs.disconnect();
                }
            });
            observer.observe(document.body, { childList: true, subtree: true });
        }

        window.rjConsentHandler.handleAllConsents();

    });
    window.Osano.cm.addEventListener('osano-cm-script-blocked', function (item) {
        console.log('Osano - Script blocked: ', item);
    });
    window.Osano.cm.addEventListener('osano-cm-cookie-blocked', function (item) {
        console.log('Osano - Cookie blocked: ', item);
    });
    window.Osano.cm.addEventListener('osano-cm-analytics', function () {
        console.log('Osano - Consent granted for analytics. Delete analytics placeholders.');
        window.rjConsentHandler.analyticsConsent.delete();
    });
    window.Osano.cm.addEventListener('osano-cm-marketing', function () {
        console.log('Osano - Consent granted for marketing. Delete marketing placeholders.');
        window.rjConsentHandler.marketingConsent.delete();
    });
</script>
