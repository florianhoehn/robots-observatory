		<script id="sophi-init">
    console.log('sophi-init');
    window.sophi = window.sophi || {};
    sophi.demeter = { actions: [] };
    window.demeter = window.demeter || async function () {
        var resolve, reject;
        const s = new Promise((res, rej) => {
            resolve = res, reject = rej;
        });
        sophi.demeter.actions.push([arguments, resolve, reject]);
        return s;
    };

    var addSophiScriptToPage = function ({ isConsented = false }) {
        const hostId = '1659958469';
        const script = document.createElement('script');
        script.id = 'sophi-loader';
        script.async = true;
        script.src = `https://cdn.sophi.io/assets/demeter/1/stable/${hostId}.js?isConsented=${isConsented}`;
        script.onload = function () {
            console.log('sophi_script_is_loaded');
            var event_sophi_is_load = new CustomEvent('sophi_is_loaded');
            document.dispatchEvent(event_sophi_is_load);
        };
        document.head.appendChild(script);
        console.log('sophi-load-script:'+script.src);
    };

    var consentProvider = async function () {
        if (window.Osano && window.Osano.cm) {
            const consent = window.Osano.cm.getConsent().ANALYTICS;
            console.log('sophi_consent_osano', consent);
            return consent === "ACCEPT";
        }
        console.log('sophi_consent_no_osano');
        return false;
    }

    consentProvider().then(consentStatus => {
        console.log('sophi_consent_provider', consentStatus);
        if (consentStatus === undefined) {
            addSophiScriptToPage({ isConsented: false });
        } else if (consentStatus == true) {
            addSophiScriptToPage({ isConsented: true });
        } else {
            addSophiScriptToPage({ isConsented: false });
        }
    }).catch(err => {
        console.error('sophi_consent_provider_error', err);
        addSophiScriptToPage({ isConsented: false });
    });
</script>

<script>
let sophi_page_info = sophi_get_page_info();
console.log('sophi_page_info_v4.1', sophi_page_info);

window.rj_visitor_type = 'anonymous';
if ( localStorage && localStorage.getItem('rj_visitor_type') ) {
    window.rj_visitor_type = localStorage.getItem('rj_visitor_type');
}

window.rj_sophi_decision_wall = '';

function check_sophi_is_loaded() {
    return new Promise(resolve => {
        document.addEventListener('sophi_is_loaded', function handler(e) {
            document.removeEventListener('sophi_is_loaded', handler);
            resolve(true);
        });
    });
}

function check_rj_event_wallhit() {
    return new Promise(resolve => {
        document.addEventListener('rj_event_wallhit', function handler(e) {
            document.removeEventListener('rj_event_wallhit', handler);
            resolve(true);
        });
    });
}

//let promise_check_visitor_type = check_visitor_type();
let promise_check_sophi_is_loaded = check_sophi_is_loaded();
let promise_check_rj_event_wallhit = check_rj_event_wallhit();

async function sophi_page_view() {
    let promise_results = await Promise.all([promise_check_sophi_is_loaded]); //promise_check_visitor_type, 
    let sophiData = window.sophi.dataLayer;
   
    let event_data = {
        event: 'sophi_page_view',
        visitor_type: window.rj_visitor_type, //All events
        page_section: sophi_page_info.section, //Top-level section the content belongs to // pageviews
        sophi_page_type: sophi_page_info.page_type, //All events
        sophi_experiments_code: sophiData.experimentsCode, //All events
        sophi_inputs: sophiData.inputs, //wall_hits and pageviews
        sophi_context: sophiData.context, //wall_hits and pageviews
        sophi_trace: sophiData.trace, //wall_hits and pageviews
        sophi_decision_source: sophiData.decisionSource //wall_hits and pageviews,
    };
    window.dataLayer.push(event_data);
    console.log('sophi_page_view', event_data);

    demeter('pageview', {
        args: { article: sophi_page_info.isArticle, section: sophi_page_info.section }
    });
    console.log('sophi_demeter_pageview', sophi_page_info.section);


    //subscription event
    let q_str = new URLSearchParams(window.location.search);
    let buy_subscription = q_str.get('buy_subscription');
    if ( '1' === buy_subscription ) {
        let subs_event_data = {
            event: 'subscription',
            visitor_type: window.rj_visitor_type, 
            sophi_page_type: sophi_page_info.page_type,
            sophi_experiments_code: sophiData.experimentsCode, 
            sophi_inputs: sophiData.inputs, 
            sophi_context: sophiData.context, 
            sophi_trace: sophiData.trace, 
            sophi_decision_source: sophiData.decisionSource,
            subscription_type: 'monthly', 
            subscription_status: 'active'
        };
        window.dataLayer.push(subs_event_data);
        console.log('sophi_subscription', subs_event_data);
    }


    // Retrieve the AB test context from Sophi.
    let assignedGroup = sophiData.assignedGroup; //variant, control
    console.log('sophi_assignedGroup', assignedGroup, window.rj_visitor_type); 

    if ( window.rj_visitor_type != 'subscriber'
        && typeof(window.dataLayer[0]) === 'object' 
        && typeof(window.dataLayer[0].metrics) === 'object'
        && window.dataLayer[0].metrics.pageType === 'article' ) { 
        
        let meta_rj_paywall = document.querySelector('meta[name="rj:paywall"]'); 
        let meta_rj_paywall_val = meta_rj_paywall ? meta_rj_paywall.getAttribute('content') : 'private'; //free, private, premium
        console.log('sophi_meta_rj_paywall', meta_rj_paywall_val);
        if ( meta_rj_paywall_val === 'premium' ) {
            window.rj_sophi_decision_wall = 'yes';
        }

        if ( meta_rj_paywall_val === 'private' && assignedGroup === 'variant' ) {
            try {
                //let decision = await demeter('getDecision');
                let decision = await demeter('getDecision', { 
                    args: { visitor: window.rj_visitor_type }, // 'anonymous' or 'registered' 
                });
                
                console.log('sophi_decision', decision);
                if (decision.outcome.wallVisibility === 'always') {
                    //myWallExperienceSystem.showWall(decision.outcome.wallType); // 'regwall' or 'paywall'
                    //Engage does not have the function to show paywall, David told to store the Sophi responses within the window object.
                    window.rj_sophi_decision_wall = 'yes';
                } else {
                    window.rj_sophi_decision_wall = 'no';
                }
            } catch (err) {
                console.error('sophi_decision_error', err);
            }
        }
    }

}

async function sophi_wallhit() {
    let promise_results = await Promise.all([promise_check_sophi_is_loaded, promise_check_rj_event_wallhit]); //promise_check_visitor_type, 
    let sophiData = window.sophi.dataLayer;
    
    let event_data = {
        event: 'wallhit',
        visitor_type: window.rj_visitor_type, 
        sophi_page_type: sophi_page_info.page_type, 
        sophi_experiments_code: sophiData.experimentsCode,
        sophi_inputs: sophiData.inputs, 
        sophi_context: sophiData.context,
        sophi_trace: sophiData.trace,
        sophi_decision_source: sophiData.decisionSource,
        wall_type: 'paywall'
    };
    window.dataLayer.push(event_data);
    console.log('sophi_wallhit', event_data);

    demeter('wall', {
        args: { wallType: 'paywall', section: sophi_page_info.section }
    });
    console.log('sophi_demeter_wall', sophi_page_info.section);

}

async function sophi_exec() {
    await sophi_page_view();
    await sophi_wallhit();
}

sophi_exec();

function sophi_get_page_info() {
    let resp = {
        isArticle: false,
        section: 'unknown',
        page_type: 'unknown' //should be article, section, account, subscription
    };

    if (typeof(window.dataLayer[0]) !== 'object' || typeof(window.dataLayer[0].metrics) !== 'object') {
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'homepage') {
        resp.section = 'homepage';
        resp.page_type = 'homepage';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'section') {
        if ( window.dataLayer[0].metrics['hl-category'] ) { 
            resp.section = window.dataLayer[0].metrics['hl-category']; //resp.section = window.dataLayer[0].metrics.hierarchy;
        }
        resp.page_type = 'section';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'article') {
        resp.isArticle = true;
        if ( window.dataLayer[0].metrics['hl-category'] ) {
            resp.section = window.dataLayer[0].metrics['hl-category']; //resp.section = window.dataLayer[0].metrics.hierarchy;
        }
        resp.page_type = 'article';
        return resp;
    }

    let path = window.location.pathname;
    path = path.replace(/^\/+|\/+$/g, '');
    path = path.replace(/\//g, ' | ');

    if (window.dataLayer[0].metrics.pageType === 'video') {
        resp.section = 'videos'; //path; //videos | slug
        resp.page_type = 'video';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'page') {
        resp.section = 'page'; // 'page | '+path;
        resp.page_type = 'page';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'tag') {
        /*
        resp.section = path;
        if ( window.dataLayer[0].metrics.name ) {
            resp.section = 'tag | '+window.dataLayer[0].metrics.name;
        }
        */
        resp.section = 'tag';
        resp.page_type = 'section';
        return resp;
    }

    if (path === 'pc') {
        resp.section = 'sponsored_category';
        resp.page_type = 'section';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'taxonomy' && window.dataLayer[0].metrics.taxonomy_type && window.dataLayer[0].metrics['hl-category']) {
        resp.section = window.dataLayer[0].metrics.taxonomy_type + ' | ' + window.dataLayer[0].metrics['hl-category']; //rj_author | Adam Hill, sponsored_category | Business
        resp.page_type = 'section';
        return resp;
    }

    if (window.dataLayer[0].metrics.pageType === 'article.sponsored') {
        //resp.isArticle = true; //not sure if we need to set as article
        if ( window.dataLayer[0].metrics['hl-category'] ) {
            resp.section = 'sponsored_category | '+ window.dataLayer[0].metrics['hl-category']; //window.dataLayer[0].metrics.hierarchy 
        }
        resp.page_type = 'section';
        return resp;
    }

    /*
    if (window.dataLayer[0].metrics.pageType) {
        resp.section = window.dataLayer[0].metrics.pageType + ' | '+path;
        return resp;
    }
    */

    return resp;

}
</script>
