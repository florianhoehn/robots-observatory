  <script>
    var runTimer;
    var deadline = "October 19 2026 23:59:59 UTC-0700";
    var countdownTimer = function () {
      var t = Date.parse(deadline) - Date.parse(new Date());
      
      if (t <= 0) {
        var timerDiv = document.getElementById("timerdiv");
        if (timerDiv) timerDiv.style.display = "none";
        return;
      }

      var seconds = Math.floor((t / 1000) % 60);
      var minutes = Math.floor((t / 1000 / 60) % 60);
      var hours = Math.floor(t / (1000 * 60 * 60));
      
      var clock = document.getElementById("clockdiv");
      var hoursSpan = clock.querySelector(".hours");
      var minutesSpan = clock.querySelector(".minutes");
      var secondsSpan = clock.querySelector(".seconds");
      
      var displayHours = ("0" + hours).slice(-2);
      var displayMinutes = ("0" + minutes).slice(-2);
      var displaySeconds = ("0" + seconds).slice(-2);

      // FIX: Only update visual DOM if values have changed (fixes iOS VoiceOver trapping)
      if (hoursSpan && hoursSpan.innerHTML !== displayHours) hoursSpan.innerHTML = displayHours;
      if (minutesSpan && minutesSpan.innerHTML !== displayMinutes) minutesSpan.innerHTML = displayMinutes;
      if (secondsSpan && secondsSpan.innerHTML !== displaySeconds) secondsSpan.innerHTML = displaySeconds;

      // FIX: Update visually-hidden screen reader text dynamically (instead of manipulating aria-label)
      var srText = document.getElementById("timerSRText");
      if (srText) {
        var newSrText = hours + " hours, " + minutes + " minutes, and " + seconds + " seconds remaining";
        if (srText.textContent !== newSrText) {
          srText.textContent = newSrText;
        }
      }
      
      runTimer = requestAnimationFrame(countdownTimer);
    };
    
    // request animation frame on render
    runTimer = requestAnimationFrame(countdownTimer);
