<!-- 
Navigation and Footer Prev/Next Links Automation
This script updates the href attributes for navigation and footer links based on their slugs.
-->
<script defer>
    /**
     * Updates the href attribute for each element matching the className.
     * The new href is constructed using the window's current origin and the element's href value.
     * 
     * @param {string} className - The class name of the elements to update.
     */
    const updateNavHrefs = (className) => {
        document.querySelectorAll(className).forEach((element) => {
            const slug = element.getAttribute("href");
            const baseUrl = window.location.origin;
            element.setAttribute("href", `${baseUrl}${slug}`);
        });
    };

    /**
     * Updates the href attribute for each footer navigation link.
     * The new href is constructed using the current URL path and the slug inside `.slug-container`.
     * It also removes the `.slug-wrapper` element after updating.
     * 
     * @param {string} className - The class name of the footer navigation links.
     */
    const updateFooterHref = (className) => {
        const elements = document.querySelectorAll(className);

        if (!elements.length) return;

        elements.forEach((element) => {
            const slug = element.querySelector('.slug-container')?.innerText ?? "";
            const currentURL = window.location.href;
            const newURL = currentURL.replace(/\/[^/]*$/, '/');

            element.setAttribute('href', `${newURL}${slug}`);
            element.querySelector('.slug-wrapper')?.remove();
        });
    };

    // Initialize the updates
    updateFooterHref('.section-content-link.popup-nav');
</script>


