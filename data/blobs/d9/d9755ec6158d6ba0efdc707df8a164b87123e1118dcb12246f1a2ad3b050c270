<!DOCTYPE html>
<html lang="nl">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verboden toegang - HEMA</title>
  <style>
    @font-face {
      font-family: 'HurmeHEMA';
      src: url('/_platform/assets/maintenance/assets/HurmeHEMA-Regular.woff2') format('woff2');
      font-weight: 400;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'HurmeHEMA';
      src: url('/_platform/assets/maintenance/assets/HurmeHEMA-SemiBold.woff2') format('woff2');
      font-weight: 600;
      font-style: normal;
      font-display: swap;
    }

    @font-face {
      font-family: 'HurmeHEMA';
      src: url('/_platform/assets/maintenance/assets/HurmeHEMA-Bold.woff2') format('woff2');
      font-weight: 700;
      font-style: normal;
      font-display: swap;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'HurmeHEMA', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #ffffff;
      color: #1b1b1b;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    /* ===== Layout container (sfcc-layout) ===== */

    .layout {
      max-width: 1280px;
      margin-inline: auto;
      width: auto;
      padding-inline: 16px;
    }

    @media (min-width: 768px) {
      .layout {
        padding-inline: 32px;
      }
    }

    @media (min-width: 1025px) {
      .layout {
        padding-inline: 48px;
      }
    }

    /* ===== Header ===== */

    .header {
      position: sticky;
      top: 0;
      left: 0;
      right: 0;
      background: #ffffff;
      z-index: 100;
    }

    /* Top links bar */
    .top-links {
      display: none;
      padding: 0 0 12px;
      border-bottom: 1px solid #f5f5f5;
      width: 100%;
    }

    .top-links ul {
      display: flex;
      justify-content: space-between;
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .top-links li {
      margin-right: 24px;
    }

    .top-links li:nth-child(4) {
      margin-right: auto;
    }

    .top-links li:last-child {
      margin-right: 0;
    }

    .top-links a {
      font-size: 14px;
      font-weight: 600;
      line-height: 16px;
      color: #323232;
      text-decoration: none;
      position: relative;
      display: block;
    }

    .top-links a::after {
      content: '';
      width: 100%;
      height: 1px;
      background: #323232;
      position: absolute;
      left: 0;
      bottom: 0;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease-in-out;
    }

    .top-links a:hover::after {
      transform: scaleX(1);
    }

    /* Main nav row */
    .nav-main {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 8px 0;
      position: relative;
    }

    .nav-logo {
      display: block;
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      margin-top: 4px;
    }

    .nav-logo img {
      width: 100%;
      height: 100%;
      border-radius: 2px;
    }

    /* Categories button */
    .nav-categories-btn {
      display: none;
      align-items: center;
      gap: 8px;
      border: 0;
      padding: 0;
      background: transparent;
      cursor: pointer;
      font-family: 'HurmeHEMA', sans-serif;
      font-size: 16px;
      font-weight: 600;
      color: #1b1b1b;
      margin-left: 16px;
    }

    .nav-categories-btn svg {
      width: 24px;
      height: 24px;
      flex-shrink: 0;
    }

    .nav-categories-btn .chevron {
      width: 24px;
      height: 24px;
    }

    /* Search bar */
    .nav-search {
      display: none;
      align-items: center;
      flex: 1;
      min-width: 0;
      height: 44px;
      padding: 0 24px;
      padding-right: 48px;
      background-color: #efefef;
      border-radius: 100px;
      position: relative;
      margin-left: 8px;
      transition: background-color 0.2s ease;
    }

    .nav-search:hover {
      background-color: #dfdfdf;
    }

    .nav-search span {
      flex: 1;
      font-size: 16px;
      font-weight: 400;
      line-height: 20px;
      color: #767676;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .nav-search svg {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      color: #323232;
    }

    /* Mobile search */
    .nav-search-mobile {
      display: block;
      height: 44px;
      margin-top: 2px;
      margin-right: 8px;
      margin-bottom: 12px;
    }

    .nav-search-mobile a {
      display: flex;
      align-items: center;
      width: 100%;
      height: 100%;
      padding: 0 24px;
      padding-right: 48px;
      background-color: #efefef;
      border-radius: 100px;
      position: relative;
    }

    .nav-search-mobile a:hover {
      background-color: #dfdfdf;
    }

    .nav-search-mobile span {
      flex: 1;
      font-size: 16px;
      font-weight: 400;
      line-height: 20px;
      color: #767676;
    }

    .nav-search-mobile svg {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      width: 24px;
      height: 24px;
      flex-shrink: 0;
      color: #323232;
    }

    /* Header actions */
    .nav-actions {
      display: flex;
      flex: 1;
      align-items: center;
      gap: 16px;
      justify-content: flex-end;
    }

    .nav-action-link {
      display: flex;
      align-items: center;
      padding: 4px 12px 4px 8px;
      border-radius: 8px;
      transition: background-color 0.15s ease;
    }

    .nav-action-link:hover {
      background-color: #f5f5f5;
    }

    .nav-action-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
    }

    .nav-action-icon svg {
      width: 24px;
      height: 24px;
    }

    .nav-action-label {
      font-size: 16px;
      font-weight: 600;
      line-height: 1.2;
      display: none;
    }

    .nav-icon-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      border-radius: 8px;
      transition: background-color 0.15s ease;
    }

    .nav-icon-btn:hover {
      background-color: #f5f5f5;
    }

    .nav-icon-btn svg {
      width: 24px;
      height: 24px;
    }

    .nav-wishlist {
      display: none;
    }

    /* Hamburger (mobile only) */
    .nav-hamburger-mobile {
      display: flex;
      align-items: center;
      align-self: center;
    }

    .nav-hamburger-mobile a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: 8px;
    }

    .nav-hamburger-mobile svg {
      width: 24px;
      height: 24px;
    }

    /* ===== Responsive: md (768px+) ===== */

    @media (min-width: 768px) {
      .nav-main {
        gap: 24px;
        padding: 12px 0;
      }

      .nav-search {
        display: flex;
        margin-left: 8px;
        margin-right: 20px;
      }

      .nav-search-mobile {
        display: none;
      }

      .nav-actions {
        flex: initial;
      }

      .nav-action-label {
        display: inline;
      }

      .nav-wishlist {
        display: flex;
      }
    }

    /* ===== Responsive: lg (1025px+) ===== */

    @media (min-width: 1025px) {
      .top-links {
        display: block;
      }

      .nav-logo {
        width: 56px;
        height: 56px;
      }

      .nav-categories-btn {
        display: flex;
        margin-left: 16px;
      }

      .nav-search {
        margin-left: 20px;
        margin-right: 0;
      }

      .nav-hamburger-mobile {
        display: none;
      }
    }

    /* ===== Main Content ===== */

    main {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 32px 24px 64px;
      width: 100%;
    }

    .error-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      max-width: 768px;
      width: 100%;
    }

    .error-image {
      width: 100%;
      border-radius: 8px;
      object-fit: contain;
    }

    .error-text {
      display: flex;
      flex-direction: column;
      gap: 12px;
      text-align: center;
      width: 100%;
    }

    .error-text h1 {
      font-size: 40px;
      font-weight: 700;
      line-height: 1.2;
    }

    .error-text p {
      font-size: 16px;
      font-weight: 400;
      line-height: 1.2;
      color: #1b1b1b;
    }

    .error-button {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 310px;
      max-width: 456px;
      height: 56px;
      min-height: 56px;
      padding: 0 24px;
      background-color: #1b1b1b;
      color: #ffffff;
      font-family: 'HurmeHEMA', sans-serif;
      font-size: 16px;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: background-color 0.2s ease;
    }

    .error-button:hover {
      background-color: #333333;
    }

    .error-button:focus-visible {
      outline: 2px solid #1b1b1b;
      outline-offset: 2px;
    }

    /* ===== Footer ===== */

    .footer-links {
      padding: 16px 0;
    }

    .footer-links-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
      padding: 16px 0;
      border-top: 1px solid #e5e5e5;
      border-bottom: 1px solid #e5e5e5;
    }

    .footer-links-section h4 {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 8px;
      color: #1b1b1b;
    }

    .footer-links-section ul {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .footer-links-section li {
      margin-bottom: 4px;
    }

    .footer-links-section a {
      font-size: 14px;
      font-weight: 400;
      color: #1b1b1b;
    }

    .footer-links-section a:hover {
      text-decoration: underline;
    }

    /* Logo + Legal links row */
    .footer-legal {
      padding: 24px 0;
    }

    .footer-legal-inner {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .footer-legal .footer-logo {
      flex-shrink: 0;
    }

    .footer-legal .footer-logo img {
      width: 80px;
      height: 80px;
      border-radius: 2px;
    }

    .footer-legal-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 32px;
      position: relative;
    }

    .footer-legal-links a {
      font-size: 14px;
      font-weight: 600;
      line-height: 16px;
      color: #1b1b1b;
      text-decoration: underline;
      text-decoration-color: transparent;
      text-underline-offset: 4px;
      transition: text-decoration-color 0.3s;
      position: relative;
    }

    .footer-legal-links a:hover {
      text-decoration-color: currentColor;
    }

    /* Vertical separators between legal links */
    .footer-legal-links a:not(:last-child)::after {
      content: '';
      position: absolute;
      width: 1px;
      height: 16px;
      right: -17px;
      top: 50%;
      transform: translateY(-50%);
      background-color: #d4d4d4;
    }

    /* Contact details */
    .footer-contact {
      padding: 0 0 32px;
      text-align: left;
    }

    .footer-contact ul {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .footer-contact li {
      font-size: 12px;
      line-height: 16px;
      color: #616161;
    }

    @media (min-width: 768px) {
      .footer-links {
        padding: 24px 0;
      }

      .footer-links-grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
      }

      .footer-links-section h4 {
        margin-bottom: 12px;
      }

      .footer-legal {
        padding: 32px 0;
      }

      .footer-contact {
        text-align: center;
        padding: 0 32px 32px;
      }
    }

    @media (min-width: 1025px) {
      .footer-legal-inner {
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        gap: 56px;
        padding-bottom: 24px;
        border-bottom: 1px solid #e5e5e5;
      }

      .footer-contact {
        padding: 24px 48px 32px;
      }
    }

    @media (max-width: 640px) {
      main {
        padding: 24px 20px 48px;
      }

      .error-text h1 {
        font-size: 28px;
      }

      .error-button {
        width: 100%;
        max-width: 310px;
      }
    }
  </style>
</head>

