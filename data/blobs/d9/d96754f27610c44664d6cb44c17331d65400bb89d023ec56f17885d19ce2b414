<script>
document.addEventListener("DOMContentLoaded", function(){

  var SEARCH_SKELETON = '<li><div class="sp-skel"><span class="bl-skel sp-skel-img"></span><div class="sp-skel-lines"><span class="bl-skel sp-skel-line"></span><span class="bl-skel sp-skel-line sp-skel-line--short"></span></div></div></li>'.repeat(3);

  document.querySelectorAll('.card-series__image-media, .card-actor__image img').forEach(function (img) {
    if (img.complete && img.naturalWidth > 0) return;
    var box = img.closest('.card-series__image, .card-actor__image');
    if (!box) return;
    box.classList.add('is-loading');
    var done = function () { box.classList.remove('is-loading'); };
    img.addEventListener('load', done);
    img.addEventListener('error', done);
  });

  function wireSearch(opts){
    const input   = document.getElementById(opts.inputId);
    const preview = document.getElementById(opts.previewId);
    const list    = document.getElementById(opts.listId);
    const empty   = document.getElementById(opts.emptyId);
    const queryEl = document.getElementById(opts.queryId);

    if(!input || !preview || !list || !empty || !queryEl) return;

    let timeout = null;

    input.addEventListener("input", function(){

      const value = this.value.trim();

      if(value.length < 2){
        preview.style.display = "none";
        list.innerHTML = "";
        empty.style.display = "none";
        return;
      }

      clearTimeout(timeout);

      timeout = setTimeout(function(){

        preview.style.display = "block";
        empty.style.display = "none";
        list.innerHTML = SEARCH_SKELETON;

        fetch("/ajax/posts?q=" + encodeURIComponent(value))
          .then(res => res.json())
          .then(response => {

            preview.style.display = "block";

            const data = response.data || [];

            if(data.length === 0){
              list.innerHTML = "";
              queryEl.textContent = value;
              empty.style.display = "block";
              return;
            }

            let html = "";

            data.forEach(item => {
              html += `
                <li>
                  <a href="${item.url}">
                    <img src="${item.image}" alt="">
                    <div class="sp-content">
                      <div class="sp-title">${item.name}</div>
                      <div class="sp-meta">${item.type}</div>
                    </div>
                  </a>
                </li>
              `;
            });

            list.innerHTML = html;
            empty.style.display = "none";

          })
          .catch(() => {
            preview.style.display = "none";
          });

      }, 250);

    });

    if(opts.closeOnOutside){
      document.addEventListener("click", function(e){
        if(!e.target.closest(opts.closeOnOutside)){
          preview.style.display = "none";
        }
      });
    }
  }

  wireSearch({
    inputId:   "search",
    previewId: "searchPreview",
    listId:    "searchList",
    emptyId:   "searchEmpty",
    queryId:   "searchQuery",
    closeOnOutside: ".header-search-wrapper"
  });

  wireSearch({
    inputId:   "mobile-search",
    previewId: "mSearchPreview",
    listId:    "mSearchList",
    emptyId:   "mSearchEmpty",
    queryId:   "mSearchQuery",
    closeOnOutside: null
  });

});
</script>

