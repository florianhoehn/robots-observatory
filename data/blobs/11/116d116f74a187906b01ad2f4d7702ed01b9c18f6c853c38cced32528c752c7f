<!--   Scroll-Based Sticky Footer CTA -->
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        let interactionCompleted = false; // Track if the process is completed

        function handleScroll() {
            if (interactionCompleted) return; // Stop execution if already completed

            const firstBand = document.getElementById('first-band');
            const footerCta = document.getElementById('footer-cta');
            const footerCtaArea = document.querySelector('.footer-cta-area');
            const footerCtaContent = document.querySelector('.footer-cta-content');

            if (firstBand && footerCta && footerCtaArea && footerCtaContent) {
                const firstBandPosition = firstBand.getBoundingClientRect().top;
                const footerCtaPosition = footerCta.getBoundingClientRect().top;
                const windowHeight = window.innerHeight;

                if (footerCtaPosition > windowHeight) {
                    footerCtaArea.classList.add('fixed');
                    footerCtaContent.style.display = 'none';
                } else if (footerCtaPosition <= windowHeight) {
                    footerCtaArea.classList.remove('fixed');
                    footerCtaContent.style.display = 'block';

                    // Stop further execution
                    interactionCompleted = true;
                    window.removeEventListener('scroll', handleScroll);
                }
            }
        }

        window.addEventListener('scroll', handleScroll);
    });

</script>
