<!-- Combined Header and Logo Styling for Scroll, Hover, and /api Page Load -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const header = document.querySelector('.header');
        const svgElement = document.querySelector('.header .container-large .navbar-area .nav-brand-wrap .brand-link .brand-logo-embeded svg g#isotype');

        // Check if the URL is /api and apply styles immediately
        if (window.location.pathname === '/api') {
            if (header) {
                header.classList.add('active');
            }
            if (svgElement) {
                svgElement.style.fill = '#FFCB1F';
            }
        } else {
            // Scroll event listener for other pages
            document.addEventListener('scroll', function () {
                if (window.scrollY > 0) {
                    if (header) header.classList.add('active');
                    if (svgElement) svgElement.style.fill = '#FFCB1F';
                } else {
                    if (header) header.classList.remove('active');
                    if (svgElement) svgElement.style.fill = ''; // Revert to original fill
                }
            });

            // Hover event listeners for nav links
            const navlinksElements = document.querySelectorAll('#navlinks, #navbuttons');
            navlinksElements.forEach(navlink => {
                navlink.addEventListener('mouseenter', function () {
                    if (header) header.classList.add('active');
                    if (svgElement) svgElement.style.fill = '#FFCB1F';
                });

                navlink.addEventListener('mouseleave', function () {
                    // Revert only if not scrolled
                    if (window.scrollY === 0) {
                        if (header) header.classList.remove('active');
                        if (svgElement) svgElement.style.fill = ''; // Revert to original fill
                    }
                });
            });
        }
    });
</script>
