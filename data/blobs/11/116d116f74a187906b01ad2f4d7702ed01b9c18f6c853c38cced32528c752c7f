<!--  Dynamic YouTube Video Popup with Overlay  -->
<script>
    // video popup JavaScript Code
    document.addEventListener("DOMContentLoaded", function () {
        // Select the hero video element
        const heroVideo = document.getElementById("hero-video");
        const videoPopup = document.querySelector(".video-popup");
        const videoOverlay = document.querySelector(".video-overlay");

        // Check if hero-video exists
        if (heroVideo) {
            // Click event on hero-video element
            heroVideo.addEventListener("click", function () {
                // Check if the video is already video-active
                if (!heroVideo.classList.contains("video-active")) {
                    // Create iframe for the YouTube video
                    const iframe = document.createElement("iframe");
                    iframe.id = "videoPlayer";
                    iframe.width = "100%";
                    iframe.height = "100%";
                    iframe.frameBorder = "0";
                    iframe.allow =
                        "autoplay; fullscreen; picture-in-picture; encrypted-media";
                    iframe.src =
                        "https://www.youtube.com/embed/hhJnR1Iu6y0?rel=0&autoplay=1&controls=0&showinfo=0&modestbranding=1";

                    // Append iframe to video popup
                    videoPopup.appendChild(iframe);

                    // Show the overlay with a fade-in effect
                    videoOverlay.style.display = "block";
                    videoOverlay.style.opacity = "0";
                    setTimeout(() => {
                        videoOverlay.style.opacity = "1";
                        videoOverlay.style.transition = "opacity 0.5s ease-in-out";
                    }, 10);

                    // Add video-active class to hero-video and noscroll-video to body
                    heroVideo.classList.add("video-active");
                    document.body.classList.add("noscroll-video");
                }
            });

            // Close video on overlay click
            videoOverlay.addEventListener("click", function () {
                // Fade out overlay
                videoOverlay.style.opacity = "0";
                setTimeout(() => {
                    videoOverlay.style.display = "none";
                }, 500); // Match the fade-out duration

                // Remove video-active class and noscroll-video class
                heroVideo.classList.remove("video-active");
                document.body.classList.remove("noscroll-video");

                // Remove iframe to stop the video
                const videoPlayer = document.getElementById("videoPlayer");
                if (videoPlayer) {
                    videoPlayer.remove();
                }
            });
        }
    });

</script>
