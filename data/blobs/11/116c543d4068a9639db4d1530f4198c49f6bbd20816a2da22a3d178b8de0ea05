			<script>
			(function() {
				// [20260801] /api/get_logos.php 호출 제거 - 서버사이드에서 직접 주입(HTTP 왕복 0회)
				//            v= 는 파일 mtime 기준 -> 로고 교체 시 즉시 반영, 평소엔 브라우저 캐시 유지
				let logos = [];
				let currentIndex = 0;
				let intervalId = null;

				if (logos.length > 0) { initLogo(); }   // 함수선언 호이스팅으로 정상 동작

				function initLogo() {
					// 텍스트 폴백 숨기기
					document.querySelectorAll('.logo-text-fallback').forEach(el => el.style.display = 'none');
					
					// 로고 랜덤 섞기
					logos = shuffleArray(logos);
					
					// mini 로고 생성
					const miniWrap = document.getElementById('logoMiniWrap');
					logos.forEach((logo, idx) => {
						const img = document.createElement('img');
						img.src = logo.path;
						img.className = 'random-logo-img' + (idx === 0 ? ' active' : '');
						img.alt = 'Tcafe21';
						miniWrap.appendChild(img);
					});

					// lg 로고 생성
					const lgWrap = document.getElementById('logoLgWrap');
					logos.forEach((logo, idx) => {
						const img = document.createElement('img');
						img.src = logo.path;
						img.className = 'random-logo-img' + (idx === 0 ? ' active' : '');
						img.alt = 'Tcafe21';
						lgWrap.appendChild(img);
					});


					// "우리들의 쉼터" 텍스트 추가
					const subtitle = document.createElement('span');
					subtitle.textContent = ' 우리들의 쉼터';
					subtitle.style.fontSize = '16px';
					subtitle.style.marginLeft = '5px';
					subtitle.style.fontFamily = "'Noto Sans KR', 'Nanum Gothic', 'Malgun Gothic', sans-serif";
					subtitle.style.fontWeight = '500';
					subtitle.style.position = 'relative';
					subtitle.style.top = '8px';
					lgWrap.appendChild(subtitle);
					// 로고가 2개 이상이면 6초마다 전환
					if (logos.length > 1) {
						intervalId = setInterval(switchLogo, 6000);
					}
				}

				function switchLogo() {
					const miniImgs = document.querySelectorAll('#logoMiniWrap .random-logo-img');
					const lgImgs = document.querySelectorAll('#logoLgWrap .random-logo-img');
					
					miniImgs[currentIndex].classList.remove('active');
					lgImgs[currentIndex].classList.remove('active');
					
					currentIndex = (currentIndex + 1) % logos.length;
					
					miniImgs[currentIndex].classList.add('active');
					lgImgs[currentIndex].classList.add('active');
				}

				function shuffleArray(array) {
					const arr = [...array];
					for (let i = arr.length - 1; i > 0; i--) {
						const j = Math.floor(Math.random() * (i + 1));
						[arr[i], arr[j]] = [arr[j], arr[i]];
					}
					return arr;
				}
			})();
			</script>
