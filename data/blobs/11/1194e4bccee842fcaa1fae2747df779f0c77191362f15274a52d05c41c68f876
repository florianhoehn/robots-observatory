<script>
    (function () {
        const alert = document.querySelector('.modal .alert');

        if (!alert) {
            return;
        }

        const closeBtn = alert.querySelector('.alert__close');

        if (!closeBtn) {
            return;
        }

        closeBtn.addEventListener('click', () => {
            alert.classList.add('hidden');
            alert.addEventListener('transitionend', () => alert.remove(), {once: true});
        });

        const optionsButton = document.querySelector('.options-button');
        const additionalOptions = document.querySelector('.additional-options');

        if (!optionsButton || !additionalOptions) {
            return;
        }

        const buttonText = optionsButton.querySelector('.options-button-text');

        const TEXT_MORE = 'Show more verification options';
        const TEXT_LESS = 'Show less verification options';

        buttonText.textContent = additionalOptions.classList.contains('active') ? TEXT_LESS : TEXT_MORE;

        optionsButton.addEventListener('click', () => {
            const isActive = additionalOptions.classList.toggle('active');
            buttonText.textContent = isActive ? TEXT_LESS : TEXT_MORE;
            optionsButton.classList.toggle('active');
        });
    })();
</script>
