          </svg>
        </a>
      </nav>
    </header>
    <main id="maincontent">
      <h1 class="visuallyhidden">404 Page Not Found</h1>
      <div class="not_found">
        <picture class="not_found_background_image"
          ><source
            media="(min-width: 1440px)"
            srcset="
              https://www-tc.pbs.org/custom404/nature/nature-wild-1700@2x.jpg 2x,
              https://www-tc.pbs.org/custom404/nature/nature-wild-1700@1x.jpg 1x
            " />
          <source
            media="(min-width: 1024px)"
            srcset="
              https://www-tc.pbs.org/custom404/nature/nature-wild-1024@2x.jpg 2x,
              https://www-tc.pbs.org/custom404/nature/nature-wild-1024@1x.jpg 1x
            " />
          <source
            media="(min-width: 768px)"
            srcset="
              https://www-tc.pbs.org/custom404/nature/nature-wild-768@2x.jpg 2x,
              https://www-tc.pbs.org/custom404/nature/nature-wild-768@1x.jpg 1x
            " />
          <source
            media="(min-width: 320px)"
            srcset="
              https://www-tc.pbs.org/custom404/nature/nature-wild-320@2x.jpg 2x,
              https://www-tc.pbs.org/custom404/nature/nature-wild-320@1x.jpg 1x
            " />
          <img
            alt=""
            src="https://www-tc.pbs.org/custom404/nature/nature-wild-1024@1x.jpg"
            loading="lazy"
            aria-hidden="true"
            style="opacity: 0.6"
        /></picture>
        <div class="not_found_info_wrapper">
          <h2>That’s wild, your page could not be found.</h2>
          <p>
            Lucky for you, there are lots of PBS shows &amp; films to explore.
          </p>
          <div class="not_found_info_links">
            <a
              class="button_white_ghost"
              href="https://pbs.org/explore/science-and-nature/"
              >Science &amp; Nature</a
            >
          </div>
        </div>
        <a class="not_found_show_logo" href="https://pbs.org/show/nature/">
          <img
            src="https://www-tc.pbs.org/custom404/nature/nature-logo@1x.png"
            srcset="
              https://www-tc.pbs.org/custom404/nature/nature-logo@1x.png 1x,
              https://www-tc.pbs.org/custom404/nature/nature-logo@2x.png 2x
            "
            alt="Nature"
            width="200"
            loading="lazy"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
            viewBox="0 0 10.5 18.6"
          >
            <path
              d="M10.3 10.2c.5-.7.2-1.4-.3-2L2.4.4C1-.8-.8.9.4 2.4c.3.4 6.8 6.8 6.8 7 0 .3-6.3 6.6-6.7 7-1.2 1.2.7 3 1.9 1.9a148 148 0 0 0 7.9-8.1z"
