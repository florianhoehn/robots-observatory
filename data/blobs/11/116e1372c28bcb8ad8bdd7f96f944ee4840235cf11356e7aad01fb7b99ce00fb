<script type="text/javascript">// ============================================================
// Sierra Click Tracking
// ============================================================
async function sierraTrack(tagName) {
  try {
    var sierra = window.sierra || window.Sierra;
    if (!sierra || typeof sierra.addAgentTags !== 'function') {
      return;
    }
    await sierra.addAgentTags([tagName], { omitPresent: true });
  }
  catch (e) {
    // Chat not open -- ignore.
  }
}

(function () {
  var page = window.location.pathname.replace(/^\//, '').replace(/\/$/, '') || 'homepage';
  sierraTrack('page:' + page);
})();

function trackButton(selector, tagName) {
  var el = document.querySelector(selector);
  if (el) {
    el.addEventListener('click', function () {
      sierraTrack(tagName);
    });
  }
}

function trackChatLinkClicks() {
  document.addEventListener('click', function (event) {
    var target = event.target && event.target.closest ? event.target.closest('a[href]') : null;
    if (!target) {
      return;
    }

    var inSierraWidget = target.closest('[class*="sierra"], [id*="sierra"], [data-sierra], [data-sierra-chat], [aria-label*="Sierra"]');
    if (!inSierraWidget) {
      return;
    }

    var href = target.getAttribute('href');
    if (href && !href.startsWith('#') && !href.startsWith('javascript:')) {
      sierraTrack('clicked-chat-link');
    }
  }, true);
}

trackChatLinkClicks();</script>
