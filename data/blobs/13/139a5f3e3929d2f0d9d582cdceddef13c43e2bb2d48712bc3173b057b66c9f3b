<script>
    (function ()
    {
        'use strict';

        var SAMPLE_RATE = 1;

        //  GA4 discards parameter values longer than 100 characters.
        var MAX_PARAM_LENGTH = 100;

        var MAX_PLAUSIBLE_MS = 60000;

        if (Math.random() >= SAMPLE_RATE)
        {
            return;
        }

        function text(value)
        {
            if (typeof value !== 'string' || value === '')
            {
                return '(none)';
            }

            return value.length > MAX_PARAM_LENGTH ? value.slice(0, MAX_PARAM_LENGTH) : value;
        }

        function whole(value)
        {
            return Math.round(value || 0);
        }

        function scriptSource(attribution)
        {
            var longest = attribution.longestScript;

            if (!longest || !longest.entry)
            {
                return '(none)';
            }

            return text(longest.entry.sourceURL || '(anonymous)');
        }

        function scriptInvoker(attribution)
        {
            var longest = attribution.longestScript;

            if (!longest || !longest.entry)
            {
                return '(none)';
            }

            return text(longest.entry.invoker || '(unknown)');
        }

        function send(metric)
        {
            if (metric.name !== 'CLS' && metric.value > MAX_PLAUSIBLE_MS)
            {
                return;
            }

            var attribution = metric.attribution || {};

            var params = {
                metric_name: metric.name,
                metric_id: metric.id,
                metric_rating: metric.rating,
                metric_nav_type: metric.navigationType,
                metric_value: whole(metric.value)
            };

            if (metric.name === 'INP')
            {
                params.metric_target = text(attribution.interactionTarget);
                params.metric_load_state = attribution.loadState;
                params.inp_interaction_type = attribution.interactionType;
                params.inp_input_delay = whole(attribution.inputDelay);
                params.inp_processing_duration = whole(attribution.processingDuration);
                params.inp_presentation_delay = whole(attribution.presentationDelay);
                params.inp_script_source = scriptSource(attribution);
                params.inp_script_invoker = scriptInvoker(attribution);
            }
            else if (metric.name === 'LCP')
            {
                params.metric_target = text(attribution.target);
                params.lcp_ttfb = whole(attribution.timeToFirstByte);
                params.lcp_resource_load_delay = whole(attribution.resourceLoadDelay);
                params.lcp_resource_load_duration = whole(attribution.resourceLoadDuration);
                params.lcp_element_render_delay = whole(attribution.elementRenderDelay);
            }
            else if (metric.name === 'CLS')
            {
                params.metric_value = whole(metric.value * 1000);
                params.metric_target = text(attribution.largestShiftTarget);
                params.metric_load_state = attribution.loadState;
