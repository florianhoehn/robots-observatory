<script>
    //  select the text in a field when it gets focus or is clicked 2026-10-06 across site
    //
    //  This replaces the inline onfocus="this.select()" (attribute data-selectonfocus) and
    //  onclick="this.select()" (attribute data-selectonclick), which ad blockers remove.
    //  An attribute rather than a class, because many inputs get their class from a PHP
    //  variable such as $nmbr_real_inputmode, and a second class attribute is ignored.
    //  Outside the $is_calculator block because some pages with these fields are not
    //  calculators (website-financial-calculators.php embed-code boxes).

    document.addEventListener('focusin', function (e)
    {
        if (e.target.hasAttribute && e.target.hasAttribute('data-selectonfocus') && e.target.select)
        {
            e.target.select();
        }
    });

    document.addEventListener('click', function (e)
    {
        if (e.target.hasAttribute && e.target.hasAttribute('data-selectonclick') && e.target.select)
        {
            e.target.select();
        }
    });
</script>

