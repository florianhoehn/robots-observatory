<script>
    // hide sticky ad when mobile keyboard opens
    (function() {
        // if (!window.visualViewport || window.innerWidth >= 768) return;
        if (!window.visualViewport) return;

        const adWrapper = document.getElementById('asc-ad-wrapper');
        if (!adWrapper) return;

        let initialHeight = window.visualViewport.height;

        window.visualViewport.addEventListener('resize', function() {
            // Update initial height on orientation change
            if (window.visualViewport.height > initialHeight) {
                initialHeight = window.visualViewport.height;
            }

            // Hide if viewport shrinks by more than 25%
            if (window.visualViewport.height < initialHeight * 0.75) {
                adWrapper.style.visibility = 'hidden';
            } else {
                adWrapper.style.visibility = '';
            }
        });
    })();
</script>

