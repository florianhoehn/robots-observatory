<script>
    window.addEventListener('load', function ()
    {
        //  Read on the next task, not inside the load handler. While the load
        //  event is still running, loadEventEnd is 0, and startTime is always 0
        //  for a navigation entry, so reading now would report 0 for every
        //  visitor. The GTM tag avoided this only because it evaluated its
        //  variable after the load event had finished.
        setTimeout(function ()
        {
            if (typeof gtag !== 'function' || !window.performance || !performance.getEntriesByType)
            {
                return;
            }

            var nav = performance.getEntriesByType('navigation')[0];
            if (!nav)
            {
                return;
            }

            //  Seconds to two decimals. The EPSILON term matches the rounding
            //  the GTM variable used, so values stay comparable across the
            //  change.
            var seconds = Math.round(100 * ((nav.loadEventEnd - nav.startTime) / 1000 + Number.EPSILON)) / 100;

            //  The GTM tag had a blocking rule for negative values.
            if (seconds < 0)
            {
                return;
            }

            gtag('event', 'page_load_time', { loading_time_seconds: seconds });
        }, 0);
    });
</script>
