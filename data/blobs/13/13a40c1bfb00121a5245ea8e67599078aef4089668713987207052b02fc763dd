<script type="text/javascript">
// DISH Website
const HelpDocs = {
    product: 'DISH Website',
    category: 'pvsfm6ozla',
};

window.hdlh = {
    widget_key: 'jw2809gj7iiegxx84cpn',
    suggestions: [`category:`],
    language_code: "en",
    brand: "DISH WEBSITE",
    launcher_button_image: 'https://cdn.website.dish.co/static/20260929134120/static/img/questionmark.png',
    primary_color: "#fab307",
    color_mode: 'light',
    disable_contact_button: false,
    i18n: {
        // added new key to properties for translation
        empty_state_text: "No results found",
        search_placeholder: "Find articles..."
        },
    onSearch: function (data) {
        // remove empty state (if available)
        const emptyState = document.getElementById('search_empty_state_text');
        if (emptyState) emptyState.remove();

        if (!data) return;

        // register all article titles with matching tag (for product)
        const titlesToShow = {};
        for (const result of data.results) {
            if (!result.tags.includes(HelpDocs.product)) continue;
            titlesToShow[result.title] = result;
        }

        // hide all non-matching articles from search
        const iframe = document.getElementById('MainFrame');
        const results = iframe.contentWindow.document.getElementsByClassName('SearchResult');
        let hidingAllResults = true;
        for (const article of results) {
            const h3s = article.getElementsByTagName('H3');
            if (h3s.length == 0) continue;
            const title = h3s[0].innerHTML;
            if (!title) continue;
            if (titlesToShow[title]) {
                hidingAllResults = false;
            } else {
                article.style.display = 'none';
            }
        }

        if (!hidingAllResults) return;

        // show empty state if all results were hidden (or non available)
        const resultsDiv = iframe.contentWindow.document.getElementsByClassName('SearchResults');
        
        if (!resultsDiv || resultsDiv.length !== 1) return;
        
        const emptyStateDiv = iframe.contentWindow.document.createElement('div');
        emptyStateDiv.id = 'search_empty_state_text';
        emptyStateDiv.style = 'text-align: center; margin: 20px';
        emptyStateDiv.innerHTML = this.i18n.empty_state_text;

        resultsDiv[0].appendChild(emptyStateDiv);
    },
    onShow: function () {
        Lighthouse.navigate('category', HelpDocs.category); // Category id of DISH Website
        setTimeout(function () {
          var iframe = document.getElementById('MainFrame');
          var lighHouseTitle = iframe.contentWindow.document.getElementsByClassName('LighthouseTitle');
          // remove the external link
          var externalLinkNode = lighHouseTitle[0].getElementsByClassName("fa-external-link");
          if (externalLinkNode.length === 0) return;
          var externalLinkParent = externalLinkNode[0].parentElement.remove();
        }, 250);
    }

        
      
};

