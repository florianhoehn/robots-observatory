   }

   /* =========================================
      CONTAINER TOMBOL
   ========================================= */
   .n-columns-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
    margin: 20px auto;
    padding: 0 16px;
    font-family: 'Segoe UI', 'Helvetica Neue', Helvetica, Arial, sans-serif;
   }

   .n-columns-2 a {
    text-align: center;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: 0.5px;
    border-radius: 24px; /* Bentuk kapsul bulat ala UI Chat Modern */
    padding: 12px 20px;
    transition: all 0.2s ease-in-out;
    position: relative;
    overflow: hidden;
    text-transform: capitalize; /* Lebih natural dibaca */
   }

   /* =========================================
      TOMBOL LOGIN (Gaya Secondary - Putih Elegan)
   ========================================= */
   .login,
   .login-button {
    background-color: #d3b325;
    color: #ffffff; /* Teks Hijau WA */
    border: 1.5px solid #d3b325;
    box-shadow: 0 1px 3px rgba(255, 255, 255, 0.05);
   }

   .login:hover,
   .login-button:hover {
    background-color: #00000000; /* Warna abu-abu background chat WA saat disentuh */
    border-color: #000000;
    box-shadow: 0 3px 6px rgba(0,0,0,0.08);
    transform: translateY(-2px);
   }

   .login:active,
   .login-button:active {
    transform: translateY(1px);
    box-shadow: 0 1px 2px rgba(0,0,0,0.05);
   }

   /* =========================================
      TOMBOL REGISTER (Gaya Primary - Hijau WA)
   ========================================= */
   .register,
   .register-button {
    background-color: #d3b325; /* Hijau Terang khas tombol WhatsApp */
    color: #ffffff;
    border: 1.5px solid #d3b325;
    box-shadow: 0 2px 5px rgba(255, 255, 255, 0.3);
   }

   .register:hover,
   .register-button:hover {
    background-color: #00000004; /* Hijau lebih gelap (WA Dark) saat disentuh */
    border-color: #000000;
    box-shadow: 0 4px 8px rgba(18, 140, 126, 0.4);
    transform: translateY(-2px);
   }

   .register:active,
   .register-button:active {
    transform: translateY(1px);
    box-shadow: 0 1px 2px rgba(18, 140, 126, 0.3);
   }

   /* Efek ikon panah (opsional jika ada icon di dalam tombol) */
   .login span, .register span {
    display: inline-block;
    transition: transform 0.2s ease;
    margin-left: 6px;
   }

   .login:hover span, .register:hover span {
    transform: translateX(4px);
   }

