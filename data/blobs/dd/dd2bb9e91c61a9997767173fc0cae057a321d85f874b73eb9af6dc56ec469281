    <script>
        (function () {
            try {
                var ref = document.referrer || "";
                if (!ref) return console.log("Referrer not found");

                // Домен ровно тот, которым RefererHandler куку потом гасит: свой у JS браузер
                // снять серверным Set-Cookie не даст, и она подставится в следующий челлендж.
                document.cookie = "ab_orig_ref=" + encodeURIComponent(ref) +
                    "; Max-Age=3600; Path=/; SameSite=Lax; Domain=" + ".musescore.com" +
                    (location.protocol === "https:" ? "; Secure" : "");
            } catch (e) {}
        })();
    </script>
