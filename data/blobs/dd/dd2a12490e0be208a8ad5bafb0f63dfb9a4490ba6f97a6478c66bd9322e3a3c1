                                             {{../this.basePrice.formattedValue}}
                                        </div>
                                   </div>
                              </div>
                              {{/isEquals}}
                              {{#notEqual this.product.price.value
                              this.priceWithoutCouponAutoRedemption.reducedPricePerUnit.value}}
