        var _anchorScrollSpy = { isScrolling: false, spyTriggered: false };

        function scrollToAnchor (anchor) {
            if (_anchorScrollSpy.spyTriggered) {
                _anchorScrollSpy.spyTriggered = false;
                return;
            }

            _anchorScrollSpy.isScrolling = true;
            setTimeout(function () {
                var yOffset = -124;
                var element = document.getElementById(anchor);

                if (!element) {
                    _anchorScrollSpy.isScrolling = false;
                    return;
                }

                var y =element.getBoundingClientRect().top + window.pageYOffset + yOffset;

                window.scrollTo({top: y, behavior: 'smooth'});

                setTimeout(function () { _anchorScrollSpy.isScrolling = false; }, 800);
            }, 50);
        }
    </script>

    
    
