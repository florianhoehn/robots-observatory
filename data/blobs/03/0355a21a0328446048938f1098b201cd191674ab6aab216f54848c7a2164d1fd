    <!-- Dark Mode Initialization Script (must run before page renders) -->
    <script>
        (function() {
            const root = document.documentElement;

            function getStoredTheme() {
                try {
                    return localStorage.getItem('darkMode');
                } catch (error) {
                    return null;
                }
            }

            function setStoredTheme(value) {
                try {
                    localStorage.setItem('darkMode', value);
                } catch (error) {
                    // Ignore storage errors (privacy mode, blocked storage, etc.).
                }
            }

            function systemPrefersDark() {
                return window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            }

            function resolveIsDark(stored) {
                return stored === 'dark' || (stored === null && systemPrefersDark());
            }

            function applyTheme(isDark) {
                root.classList.toggle('dark', isDark);
                root.style.colorScheme = isDark ? 'dark' : 'light';

                if (document.body) {
                    document.body.classList.toggle('dark', isDark);
                }
            }

            const stored = getStoredTheme();
            applyTheme(resolveIsDark(stored));

            document.addEventListener('DOMContentLoaded', function() {
                applyTheme(resolveIsDark(getStoredTheme()));
            });

            window.BST = window.BST || {};
            window.BST.Theme = {
                isDark: function() {
                    return root.classList.contains('dark');
                },
                set: function(isDark) {
                    applyTheme(isDark);
                    setStoredTheme(isDark ? 'dark' : 'light');
                }
            };
        })();
    </script>

