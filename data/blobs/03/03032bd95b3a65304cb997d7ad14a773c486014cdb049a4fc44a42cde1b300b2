function isTimeBetween(startTime, endTime, timezone) {
    // Convert the current time to the desired timezone
    const now = new Date().toLocaleString('en-US', {
        timeZone: timezone,
        hour12: false,
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit'
    });

    // Extract hours and minutes from the formatted string
    const [hour, minute] = now.split(':').map(Number);

    // Convert the start and end times to minutes for easier comparison
    const [startHour, startMinute] = startTime.split(':').map(Number);
    const startInMinutes = startHour * 60 + startMinute;

    const [endHour, endMinute] = endTime.split(':').map(Number);
    const endInMinutes = endHour * 60 + endMinute;

    const nowInMinutes = hour * 60 + minute;

    return nowInMinutes >= startInMinutes && nowInMinutes <= endInMinutes;
}



