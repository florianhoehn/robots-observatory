<script type="text/javascript">
function generateCustomVisitorId() {
      if (typeof window === 'undefined') {
          return '0';
      }
      if (typeof navigator === 'undefined' || !navigator.userAgent) {
        //console.error("User agent not defined.");
        return '1';
      }
      if (typeof window.screen === 'undefined' || 
          typeof window.screen.width === 'undefined' || 
          typeof window.screen.height === 'undefined') {
        //console.error("Screen width or height not defined.");
        return '0';
      }
      const userAgent = navigator.userAgent;
      const screenWidth = window.screen.width;
      const screenHeight = window.screen.height;
      const language = navigator.language || '';
      const platform = navigator.platform || '';
      const vendor = navigator.vendor || '';
      const colorDepth = window.screen.colorDepth || '';
      const pixelDepth = window.screen.pixelDepth || '';
      const hardwareConcurrency = navigator.hardwareConcurrency || '';
      const timezoneOffset = new Date().getTimezoneOffset();

      // Combine all strings into one
      const combinedStr = [
        userAgent,
        screenWidth,
        screenHeight,
        language,
        platform,
        vendor,
        colorDepth,
        pixelDepth,
        hardwareConcurrency,
        timezoneOffset
      ].join('');
      let total = 0;
      for (let i = 0; i < combinedStr.length; i++) {
        total += combinedStr.charCodeAt(i);
      }
      const totalStr = total.toString();
     // console.log("-----:", combinedStr+' '+totalStr);
      return totalStr.charAt(totalStr.length - 1);
}
</script>



