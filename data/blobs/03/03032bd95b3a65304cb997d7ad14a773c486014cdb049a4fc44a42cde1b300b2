async function getCloudflareCountryCodeCookies1_browser() {
  try {
    // Retrieve the browser's IANA time zone.
    const timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
    let region = "Other";

    // Full list for U.S. time zones:

    // Eastern Time Zones
    const easternTimeZones = [
      "America/New_York",
      "America/Detroit",
      "America/Indiana/Indianapolis",
      "America/Indiana/Marengo",
      "America/Indiana/Petersburg",
      "America/Indiana/Vincennes",
      "America/Indiana/Winamac",
      "America/Kentucky/Louisville",
      "America/Kentucky/Monticello"
    ];

    // Central Time Zones
    const centralTimeZones = [
      "America/Chicago",
      "America/Indiana/Knox",
      "America/Menominee",
      "America/North_Dakota/Center",
      "America/North_Dakota/New_Salem",
      "America/North_Dakota/Beulah"
    ];

    // Mountain and Pacific/Alaska/Hawaii (grouped as "West")
    const westernTimeZones = [
      "America/Denver",      // Mountain
      "America/Phoenix",     // Mountain (no DST)
      "America/Boise",       // Mountain
      "America/Los_Angeles", // Pacific
      "America/Anchorage",   // Alaska
      "America/Adak",        // Hawaii-Aleutian (Aleutian)
      "Pacific/Honolulu" ,    // Hawaii
      "America/Tijuana" // Added for Baja California
    ];

    if (easternTimeZones.includes(timeZone)) {
      region = "East";
    } else if (centralTimeZones.includes(timeZone)) {
      region = "Central";
    } else if (westernTimeZones.includes(timeZone)) {
      region = "West";
    } else if (timeZone.startsWith("America/")) {
      // This covers U.S. territories or any other American zones not in the lists.
      region = "Other";
    }

    // Construct the result string matching the original format.
    const data = { all: `-11.11.11.11-xx-yy-${region}-Unknown-` };

    //console.log('333==',data.all);
    return { status: "success", value: data.all };
  } catch (error) {
    console.error("Failed to get country code:", error);
    return { status: "error", value: null };
  }
}





