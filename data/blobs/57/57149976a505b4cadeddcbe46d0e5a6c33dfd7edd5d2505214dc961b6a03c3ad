        //".shortpixel.com" - the same scope the PHP fallback writes to
        var base = location.hostname.split('.').slice(-2).join('.');
        var ref = document.referrer || '';
        var host = '';
        if (ref) {
            try { host = new URL(ref).hostname.toLowerCase(); } catch (e) { host = ''; }
        }
        //our own pages are internal navigation, not an acquisition source
        if (!host || host === base || host.slice(-(base.length + 1)) === '.' + base) {
            ref = '(direct)';
        }
        //encoded because PHP's setcookie() encodes too and $_COOKIE decodes on read
        document.cookie = NAME + '=' + encodeURIComponent(ref)
            + ';max-age=2592000;path=/;domain=.' + base;
    })();
