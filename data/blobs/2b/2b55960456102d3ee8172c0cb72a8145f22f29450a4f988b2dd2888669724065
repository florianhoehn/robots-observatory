        <script>
        (function () {
            var observer = null;
            var pollTimer = null;
            // Zgodne ze starszą logiką kreacji expand (zakomentowany próg pageYOffset>400).
            var BELKA_HIDE_AFTER_PX = 400;

            function getBelkaFrameWindow() {
                var slotEl = document.getElementById('belka_expand');
                var iframe = slotEl && slotEl.querySelector('iframe');
                return iframe && iframe.contentWindow;
            }

            function installBelkaEarlyHide(frameWindow) {
                if (!frameWindow || frameWindow.__inforBelkaEarlyHideInstalled) {
                    return !!frameWindow;
                }
                if (typeof frameWindow.onScroll !== 'function' || typeof frameWindow.callHide !== 'function') {
                    return false;
                }

                frameWindow.__inforBelkaEarlyHideInstalled = true;
                var originalOnScroll = frameWindow.onScroll;
                frameWindow.onScroll = function () {
                    if (window.pageYOffset > BELKA_HIDE_AFTER_PX) {
                        frameWindow.callHide();
                        return;
                    }
                    return originalOnScroll.call(frameWindow);
                };
                return true;
            }

            function correctBelkaForScroll() {
                var containerAd = document.getElementById('container-ad');
                // Rozwinięcie przyciskiem ma zostać, dopóki użytkownik znowu nie przewinie.
                if (!containerAd || containerAd.classList.contains('expand')) {
                    return;
                }
                var frameWindow = getBelkaFrameWindow();
                if (!frameWindow) {
                    return;
                }
                installBelkaEarlyHide(frameWindow);
                if (typeof frameWindow.onScroll !== 'function') {
                    return;
                }
                try {
                    frameWindow.onScroll();
                } catch (e) {}
            }

            // Rozwinięta po załadowaniu kreacja nie ma jeszcze inline height —
            // wtedy bierzemy wyrenderowaną wysokość, inaczej zasłania menu.
            function getContainerAdHeight(containerAd) {
                if (!containerAd) {
                    return '';
                }
                if (containerAd.style.height) {
                    return containerAd.style.height;
                }
                var rendered = containerAd.offsetHeight;
                return rendered > 0 ? rendered + 'px' : '';
            }

            function getBelkaOffsetHeight() {
                return getContainerAdHeight(document.getElementById('container-ad')) || '0px';
            }

            function syncHeaderTopForBelka() {
                var header = document.querySelector('.header');
                if (!header) {
                    return;
                }
                var top = getBelkaOffsetHeight();
                if (header.style.top !== top) {
                    header.style.top = top;
                }
            }

            function syncBelkaExpandHeight() {
                var containerAd = document.getElementById('container-ad');
                var slotEl = document.getElementById('belka_expand');
                if (!containerAd || !slotEl) {
                    return;
                }
                var belka = slotEl.closest('.belka_expand');
                if (!belka) {
                    return;
                }
                // Jawna wysokość kreacji ma pierwszeństwo: offsetHeight w trakcie animacji
                // jest jeszcze „otwarty” i rozpychałby slot z powrotem.
                var height = getContainerAdHeight(containerAd);
                if (height && belka.style.height !== height) {
                    belka.style.height = height;
                }
                // Zwinięta belka jest position:fixed — sticky menu musi zejść pod nią.
                syncHeaderTopForBelka();
            }

            function attachExpandContainer() {
                var pushDownBar = document.querySelector('#adSpacer #pushDownBar');
                if (pushDownBar) {
                    pushDownBar.style.position = 'absolute';
                }

                var containerAd = document.getElementById('container-ad');
                var header = document.querySelector('.header');
                if (!header || !containerAd) {
                    return false;
                }

                if (containerAd.parentElement !== header) {
                    header.prepend(containerAd);
                }
                if (containerAd.getAttribute('data-belka-scroll-watch') !== '1' && typeof MutationObserver !== 'undefined') {
                    containerAd.setAttribute('data-belka-scroll-watch', '1');
                    var containerObserver = new MutationObserver(function () {
                        correctBelkaForScroll();
                        syncBelkaExpandHeight();
                    });
                    containerObserver.observe(containerAd, { attributes: true, attributeFilter: ['style', 'class'] });
                    correctBelkaForScroll();
                }
                syncBelkaExpandHeight();
                return true;
            }

            function startWatching() {
                if (attachExpandContainer()) {
                    // Kreacja może zmienić wysokość / przebudować DOM — dalej synchronizujemy.
                }

                window.addEventListener('scroll', function () {
                    correctBelkaForScroll();
                    syncBelkaExpandHeight();
                }, { passive: true });

                if (!pollTimer) {
                    var iterations = 0;
                    pollTimer = setInterval(function () {
                        attachExpandContainer();
                        correctBelkaForScroll();
                        iterations++;
                        if (iterations > 60) {
                            clearInterval(pollTimer);
                            pollTimer = null;
                        }
                    }, 1000);
                }

                if (observer || typeof MutationObserver === 'undefined') {
                    return;
                }

                observer = new MutationObserver(function () {
                    attachExpandContainer();
                });
                observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, attributeFilter: ['style'] });
                setTimeout(function () {
                    if (observer) {
                        observer.disconnect();
                        observer = null;
                    }
                }, 120000);
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', startWatching);
            } else {
                startWatching();
            }
        })();
    </script>

    
