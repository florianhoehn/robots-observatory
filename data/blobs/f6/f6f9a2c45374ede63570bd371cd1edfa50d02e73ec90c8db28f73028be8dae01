<!DOCTYPE html>
<html>
  <head>
    <link rel="icon" href="/favicon.ico" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <meta
      name="viewport"
      content="initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />

    <title>Page Not Found</title>

    <style>
      @font-face {
        font-family: "ProximaSoft";
        src: url("/fonts/proxima_soft_bold.otf");
      }

      body {
        height: 100vh;
        margin: 0;
        font-family: ui-rounded, "ProximaSoft", sans-serif;
        background: linear-gradient(black, #2b1f00);
        -webkit-font-smoothing: antialiased;
      }

      .flex-centered {
        height: 100%;
        padding: 0;
        margin: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .flex-vertical {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }

      .gold-shadow {
        box-shadow: 0 0 60px rgba(255, 199, 0, 0.5);
      }

      .app-icon-container {
        width: 120px;
        height: 120px;
        margin-bottom: 24px;
      }

      .app-icon {
        width: 100%;
        height: 100%;
      }

      .title {
        color: rgba(255, 255, 255, 0.9);
        font-weight: 700;
        font-size: 70px;
        padding: 0;
        margin: 0;
        margin-bottom: 6px;
      }
      .subtitle {
        color: rgba(255, 255, 255, 0.64);
        font-weight: 700;
        font-size: 30px;
        padding: 0;
        margin: 0;
        max-width: 240px;
        text-align: center;
        margin-bottom: 34px;
        line-height: 24px;
      }
      .text {
        color: rgba(255, 255, 255, 0.64);
        font-weight: 700;
        font-size: 15px;
        padding: 0;
        margin: 0;
        max-width: 240px;
        text-align: center;
        margin-bottom: 34px;
        line-height: 24px;
      }
    </style>
  </head>
  <body>
    <div class="flex-centered gold-shadow">
      <div class="flex-vertical">
        <div class="app-icon-container">
          <img class="app-icon" src="/images/app_icon.png" />
        </div>
        <h1 class="title">404</h1>
        <h2 class="subtitle">Page Not Found</h2>
        <h3 class="text">Please check the URL for mistakes and try again.</h3>
      </div>
    </div>
  </body>
</html>
