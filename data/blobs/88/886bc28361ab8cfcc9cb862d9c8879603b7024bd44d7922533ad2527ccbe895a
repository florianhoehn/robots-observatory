    min-width: 170px;
    padding: 14px 22px;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
}
.nh-button:hover { transform: translateY(-2px); text-decoration: none; }
.nh-button-primary {
    background: linear-gradient(135deg, #ff7a1a, #e85310);
    color: #fff;
    box-shadow: 0 10px 24px rgba(232, 83, 16, 0.30);
}
.nh-button-primary:hover { color: #fff; box-shadow: 0 14px 32px rgba(232, 83, 16, 0.38); }
.nh-button-secondary {
    background: #fff;
    color: #0d2a45;
    border: 1.5px solid #c0c0c0;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.10);
}
.nh-button-secondary:hover { color: #0d2a45; }
.nh-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
    justify-content: center;
}
.nh-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(255,255,255,0.9);
    color: #444;
    border: 1px solid #ccc;
    font-size: 13px;
    font-weight: 600;
}

/* ── Panel (hero right column) ─────────────────────────── */
.nh-panel {
    background: #3a3a3a;
    border-radius: 24px;
    padding: 28px;
    color: #fff;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.18);
}
.nh-panel-title {
    font-size: 22px;
    font-weight: 800;
    margin-bottom: 8px;
}
.nh-panel-copy {
    color: rgba(255,255,255,0.78);
    line-height: 1.65;
    font-size: 15px;
    margin-bottom: 20px;
}
.nh-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
}
.nh-stat {
    padding: 14px;
    border-radius: 14px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
}
.nh-stat strong {
    display: block;
    font-size: 16px;
    line-height: 1.2;
    margin-bottom: 4px;
}
.nh-stat span {
    display: block;
    color: rgba(255,255,255,0.65);
    font-size: 12px;
    line-height: 1.5;
}

/* ── Stats strip ───────────────────────────────────────── */
.nh-stats-strip {
    background: #222;
    padding: 18px 0;
}
.nh-stats-inner {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
}
.nh-stat-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 32px;
    border-right: 1px solid rgba(255,255,255,0.12);
    color: #fff;
}
.nh-stat-item:last-child { border-right: none; }
.nh-stat-item i { color: #ff8c3a; font-size: 18px; }
.nh-stat-item strong { font-size: 20px; font-weight: 800; }
.nh-stat-item span { font-size: 13px; color: rgba(255,255,255,0.72); }

/* ── Free services quick grid ──────────────────────────── */
.nh-free-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px,1fr));
    gap: 20px;
}
.nh-free-card {
    padding: 24px 20px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e0e0e0;
    box-shadow: 0 4px 14px rgba(0,0,0,0.07);
