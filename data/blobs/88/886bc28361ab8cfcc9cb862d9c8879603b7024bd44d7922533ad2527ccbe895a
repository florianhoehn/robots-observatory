.nh-free-card:hover {
    box-shadow: 0 10px 28px rgba(0,0,0,0.12);
    transform: translateY(-2px);
    text-decoration: none;
    color: inherit;
}
.nh-free-card-icon {
    font-size: 36px;
    margin-bottom: 12px;
    color: #e05218;
}
.nh-free-card h3 {
    margin: 0 0 8px;
    font-size: 17px;
    font-weight: 800;
    color: #0d2a45;
}
.nh-free-card p {
    margin: 0 0 14px;
    font-size: 13.5px;
    color: #666;
    line-height: 1.6;
}
.nh-free-card-link {
    display: inline-block;
    font-size: 13px;
    font-weight: 700;
    color: #e05218;
}

/* ── Domain pricing ────────────────────────────────────── */
.nh-tld-prices {
    display: flex;
