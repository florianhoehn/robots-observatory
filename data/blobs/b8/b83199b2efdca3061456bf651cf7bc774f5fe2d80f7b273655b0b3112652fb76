                $('#count-mins-pf').html(time_obj.mins !=1 ? 'mins':'min');
                $('#count-hrs-pf').html(time_obj.hrs !=1 ? 'hrs':'hour');
                $('#count-days-pf').html(time_obj.days !=1 ? 'days':'day');
                $('#count-days').html(time_obj.days);
                $('#count-hrs').html(time_obj.hrs);
                $('#count-mins').html(time_obj.mins);
                $('#count-secs').html(time_obj.secs);

