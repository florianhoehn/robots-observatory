            render: function () {
                var $el = $(".contest-signup-stub");
                var $message = $el.find(".message");
                var $action_button = $el.find(".action-button");
                var $br = $el.find("br");
                var $participating = $el.find(".pariticipating");
                var $loggedin_message = $el.find(".loggedin-message");
                window.facebook_mode = this.facebook_mode;

                if (hacker.signed_in()) {
                    $loggedin_message.html("You are logged in as <b>" + hacker.username() + "</b>.").show();
                }

                if (!contest.started()) {
                    // Contest Not Started
                    // show countdown timer
                    if (version == 4)
                    {
                        $(".contest-messages").hide();
                        $('#block-timer-head').html('Starts in');
                        this.countdown_timer_v4(contest.start_time);
                    }
                    else
                    {
                        $message.html("The contest starts in <span class='countdown'></span>");
                        this.countdown_timer(contest.start_time, $message);
                    }
                    if (hacker.participating()) {
                        $action_button.hide();
                        $br.hide();
                        $participating.show().html("Hey <b>" + hacker.username() + "</b>! You have been signed up for the contest!");
                        $loggedin_message.hide();
                    } else {
                        $br.show();
                        $action_button.show();
                        $participating.hide();
                        if (hacker.signed_in()) {
                            $action_button.html("Sign Up");
                        } else {
                            if (this.facebook_mode()) {
                                $action_button.html(this.facebook_text()).addClass("facebook-button");
                            } else {
                                $action_button.html("Sign Up");
                            }
                        }
                        $action_button.unbind("click").bind("click", this.actionButtonClick);
                    }

                } else if (contest.started() && !contest.ended()) {
                    // During The Contest
                    // show countdown timer
                    if (version == 4)
                    {
                        $message.hide();
                    }
                    if (!contest.no_endtime()) {
                        if (version == 4) {
                            this.countdown_timer_v4(contest.end_time);
                            $('#block-timer-head').html('Ends in');
                        }
                        else {
                            $message.html("The contest ends in <span class='countdown'></span>.");
                            this.countdown_timer(contest.end_time, $message);
                        }
                    } else {
                        $message.hide();
                        if (version == 4) {
                            $('#block-timer').hide();
                        }
                    }
                    $br.show();
                    $participating.hide();
                    $action_button.show();
                    if (hacker.signed_in()) {
                        $action_button.html("Enter");
                    } else {
                        if (this.facebook_mode()) {
                            $action_button.html(this.facebook_text()).addClass("facebook-button");
                        } else {
                            $action_button.html("Sign Up");
                        }
                    }
                    $action_button.unbind("click").bind("click", this.actionButtonClick);

                } else if (contest.ended()) {
                    if (version == 4) {
                        $('#block-timer').hide();
                        this.countdown_timer_v4(3,0);
                        $message.hide();
                    }
                    // After The Contest
                    $message.html("The contest has ended. " + (hacker.signed_in() ? "Enter " : "Signup ") + " to solve archived challenges.");
                    $br.show();
                    $participating.hide();
                    $action_button.show();
                    if (hacker.signed_in()) {
                        $action_button.html("Enter");
                    } else {
                        if (this.facebook_mode()) {
                            $action_button.html(this.facebook_text()).addClass("facebook-button");
                        } else {
                            $action_button.html("Sign Up");
                        }
                    }
                    $action_button.unbind("click").bind("click", this.actionButtonClick);

                }

                if(contest.disable_signup == 'true' && !hacker.participating()){
                    $message.hide();
                    $participating.show().html("This is a private contest.");
                    $action_button.hide()
                }

                return this;
            },

