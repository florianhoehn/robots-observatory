			display: flex;
			justify-content: center;
			align-items: center;
			height: 100vh;
			color: #333;
		  }
		  .container {
			background-color: #fff;
			padding: 20px;
			border-radius: 8px;
			box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
			text-align: center;
		  }
		  .container h1 {
			color: #d9534f;
		  }
		  .container p {
			font-size: 16px;
		  }
		  .container a {
			display: inline-block;
			margin-top: 20px;
			padding: 10px 20px;
			color: #fff;
			background-color: #0275d8;
			border-radius: 4px;
			text-decoration: none;
		  }
		  .container a:hover {
