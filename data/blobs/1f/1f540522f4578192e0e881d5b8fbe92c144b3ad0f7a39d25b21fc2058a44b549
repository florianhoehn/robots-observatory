                                            <div data-ng-switch-when="2">
                                                <div class="bw-question">You're in <strong data-ng-bind="selectedMarket.label"></strong>. What are you looking for?</div>
                                                <div class="bw-categories">
                                                    <div class="bw-category-card"
                                                         data-ng-repeat="(catName, catItems) in selectedMarket.categories"
                                                         data-ng-click="selectCategory(catName)"
                                                         data-ng-class="{ selected: selectedCategory === catName }">
                                                        <div class="bw-cat-content">
                                                            <div class="bw-cat-title" data-ng-bind="catName"></div>
                                                            <div class="bw-cat-desc" data-ng-bind="getCategoryDesc(catItems)"></div>
                                                        </div>
                                                        <span class="bw-cat-arrow">&rarr;</span>
                                                    </div>
                                                </div>
                                                <div class="bw-footer">
                                                    <a class="bw-back-link" data-ng-click="goToStep(1)">&larr; Back</a>
                                                    <button class="bw-continue-btn" data-ng-click="continueToForm()" data-ng-disabled="!selectedCategory">Continue &rarr;</button>
                                                </div>
                                            </div>

                                            
                                            <div data-ng-switch-when="3">
                                                <div data-ng-if="!submitted">
                                                    <div class="bw-form-intro">Last step &mdash; Provide us your details so we can get in touch with you!</div>
                                                    <div class="bw-form-fields">
                                                        <input class="bw-input" type="text" placeholder="Full name *" data-ng-model="formData.name" required />
                                                        <input class="bw-input" type="email" placeholder="Work email *" data-ng-model="formData.email" required />
                                                        <input class="bw-input" type="text" placeholder="Company *" data-ng-model="formData.company" required />
                                                        <div class="bw-select-wrap">
                                                            <select
                                                                class="bw-input bw-select"
                                                                data-ng-model="formData.country"
                                                                data-ng-options="country for country in countries"
                                                                data-ng-class="{ 'bw-select-placeholder': !formData.country }"
                                                                required>
                                                                <option value="" disabled>Country *</option>
                                                            </select>
                                                            <i class="bc-glyph-chevron-down bw-select-arrow"></i>
                                                        </div>
                                                        <textarea class="bw-input bw-textarea" placeholder="Tell us a bit about what you're looking for *" data-ng-model="formData.message" data-ng-model-options="{ allowInvalid: true }" data-ng-minlength="messageMinLength" maxlength="5000" required></textarea>
                                                        <div class="bw-char-hint" data-ng-if="formData.message.length < messageMinLength">
                                                            <span data-ng-bind="formData.message.length"></span>/<span data-ng-bind="messageMinLength"></span> characters minimum
                                                        </div>
                                                    </div>
                                                    <div class="bw-recaptcha">
                                                        <div class="bw-captcha-target" data-sitekey="6LcNsloUAAAAAC__s4May65JH2njdXm5khSqc3Hr"></div>
                                                    </div>
                                                    <button class="bw-submit-btn" data-ng-click="submitForm()" data-ng-disabled="submitting || !formData.name || !formData.email || !formData.company || !formData.country || formData.message.length < messageMinLength">
                                                        <span data-ng-if="!submitting">Get in touch &rarr;</span>
                                                        <span data-ng-if="submitting">Sending...</span>
                                                    </button>
                                                    <div class="bw-form-note">* All fields required. A specialist will respond within 1 business day.</div>
                                                    <div class="bw-error-msg" data-ng-if="submitError" data-ng-bind="submitError"></div>
                                                    <div class="bw-footer">
                                                        <a class="bw-back-link" data-ng-click="goToStep(2)">&larr; Back</a>
                                                    </div>
                                                </div>
                                                <div data-ng-if="submitted" class="bw-success-msg">
                                                    <h3>Thank you!</h3>
                                                    <p>We've received your inquiry. A specialist will reach out within 1 business day.</p>
                                                    <a class="bw-back-link" data-ng-click="resetWizard()" style="margin-top:1rem;display:inline-block;">Start over</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    
                    