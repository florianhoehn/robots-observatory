  (function () {
    if (!document.head) return;

    var styleEl =
      document.getElementById('signin-menu-initial-state') ||
      (function () {
        var el = document.createElement('style');
        el.id = 'signin-menu-initial-state';
        document.head.insertBefore(el, document.head.firstChild);
        return el;
      })();

    var styles = [];
    var hasCookie = document.cookie.indexOf('unifiedloggedinuser=') !== -1;

    if (hasCookie) {
      styles.push(
        '.cmp-sign-in .cmp-sign-in-menu__toggle .svg-icon { display: none !important; }'
      );
      styles.push(
        '.cmp-sign-in-menu__toggle #unifiedUserIcon { display: block !important; }'
      );
    }

    var registeredEventIdsStr = sessionStorage.getItem('registeredEventIds');
    var registeredEventIds = registeredEventIdsStr
      ? JSON.parse(registeredEventIdsStr) || []
      : [];
    var isRegistered =
      Array.isArray(registeredEventIds) && registeredEventIds.length > 0;

    if (!isRegistered) {
      styles.push('.event-register--btn { display: flex !important; }');
      styles.push('.attendee--btn { display: none !important; }');
      styleEl.textContent = styles.join(' ');
    } else {
      styles.push('.event-register--btn { display: flex !important; }');
      styles.push('.attendee--btn { display: none !important; }');
      styleEl.textContent = styles.join(' ');

      var checkButtons = function () {
        var btns = document.querySelectorAll('.event-register--btn');
        if (!btns.length) {
          requestAnimationFrame(checkButtons);
          return;
        }

        var shouldSwap = Array.prototype.some.call(btns, function (btn) {
          var href = btn.getAttribute('href');
          return (
            href &&
            registeredEventIds.some(function (id) {
              return href.includes(id);
            })
          );
        });

        if (shouldSwap) {
          styleEl.textContent +=
            ' .event-register--btn { display: none !important; } .attendee--btn { display: flex !important; }';
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', checkButtons);
      } else {
        checkButtons();
      }
    }
  })();
