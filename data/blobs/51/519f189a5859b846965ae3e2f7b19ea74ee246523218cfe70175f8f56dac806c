 * AN Font Sizes: $text0=1.3rem, $text1=1.4rem, $text2=1.6rem, $text3=1.8rem
 * Stars: AN uses gold #d8a241 for filled stars
 */

/* ─── Polling injection — runs on initial load AND after SPA navigation ─── */
setInterval(attemptInjection, 500);

function attemptInjection() {
  if (!/\/shop\//.test(window.location.pathname)) return;
  var container = document.querySelector('.c-pwa-product-accordions');
  var data = getCatalogReviewsData();
  if (!container || !data || !data.latestReviews || data.latestReviews.length === 0) return;

  var existing = document.getElementById('ss-review-highlights');
  if (existing) {
    /* If wrapper exists but Vue wiped its contents, remove and rebuild */
    var hasCards = existing.querySelectorAll('[data-dot]').length > 0;
    if (existing.dataset.productSlug === data.slug && hasCards) return;
    existing.parentNode.removeChild(existing);
  }
  renderHighlights(container, data, CONFIG);
}

function getCurrentSlug() {
  var match = window.location.pathname.match(/\/shop\/([^\/\?]+)/);
  return match ? match[1] : '';
}

function getCatalogReviewsData() {
  try {
    var state = window.urbn.app.$store.$pinia.state.value;
    var products = state.catalog && state.catalog.products;
    if (!products) return null;
    var slug = getCurrentSlug();
    var slugEntry = products[slug] || Object.values(products)[0];
    if (!slugEntry || !slugEntry.reviews) return null;
    return {
      count: slugEntry.reviews.count || 0,
      averageRating: slugEntry.reviews.averageRating || 0,
      latestReviews: slugEntry.reviews.latestReviews || [],
      slug: slug
    };
  } catch (e) {
    return null;
  }
}

/* ── Pull 3 most recent reviews with 4+ stars.
      Featured-badge reviews are prioritized over recency.
      For AN, Insider-badged reviews are prioritized within featured. ── */
function selectReviews(allReviews) {
  /* Filter to 4+ star reviews only */
  var qualified = allReviews.filter(function(r) {
    return r.rating >= 4;
  });

  /* Identify featured reviews */
  function isFeatured(r) {
    if (r.isFeatured) return true;
    if (r.badges && (r.badges.featured || r.badges.Featured)) return true;
    return false;
  }

  /* Identify AN Insider reviews */
  function isInsider(r) {
    if (r.additionalFields && r.additionalFieldsOrder) {
      for (var i = 0; i < r.additionalFieldsOrder.length; i++) {
        var key = r.additionalFieldsOrder[i];
        var f = r.additionalFields[key];
        if (f && f.value && /insider/i.test(String(f.id || ''))) return true;
      }
    }
    if (r.badges && (r.badges.insider || r.badges.Insider)) return true;
    return false;
  }

  /* Sort: featured first, then by recency (most recent first) */
  qualified.sort(function(a, b) {
    var aFeat = isFeatured(a) ? 1 : 0;
    var bFeat = isFeatured(b) ? 1 : 0;
    if (bFeat !== aFeat) return bFeat - aFeat; /* featured first */

    /* For AN: within same featured tier, insiders first */
    if (isAnthro) {
      var aIns = isInsider(a) ? 1 : 0;
      var bIns = isInsider(b) ? 1 : 0;
      if (bIns !== aIns) return bIns - aIns;
    }

    /* Then by recency */
    return new Date(b.submissionTime || 0) - new Date(a.submissionTime || 0);
  });

  return qualified.slice(0, 3);
}

/* ─── Stars — AN uses gold #d8a241 ─── */
function renderStars(rating) {
  var s = '';
  for (var i = 1; i <= 5; i++) {
    s += '<span style="color:' +
         (i <= Math.round(rating || 0) ? '#d8a241' : '#ccc') +
         ';line-height:1;">★</span>';
  }
  return s;
}

/* ─── Badges ─── */
function renderBadges(r) {
  var out = '';
  /* Incentivized badge */
  var hasIncentivized = r.badges && (r.badges.incentivizedReview || r.badges.IncentivizedReview || r.badges.incentivizedtrue);
  if (hasIncentivized) {
    out += '<div style="display:inline-block;font:1.3rem/1.5 var(--font-body);' +
           'color:var(--text-dark);background:var(--site-background-secondary,#f4f4f4);' +
           'padding:6px 10px;margin-top:4px;">Incentivized Review</div><br>';
  }
  /* Featured badge */
  if (r.isFeatured || (r.badges && (r.badges.featured || r.badges.Featured))) {
    out += '<span style="font:1.3rem/1.5 var(--font-body-bold);color:var(--text-dark);' +
           'margin-right:8px;">Featured</span>';
  }
  return out;
}

function escapeHTML(str) {
  if (!str) return '';
  return String(str).replace(/[&<>"']/g, function(c) {
    return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
  });
}

function formatDate(dateStr) {
  if (!dateStr) return '';
  var d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

/* ─── Field extraction helper ─── */
function getField(r, keyMatch) {
  var keyLower = keyMatch.toLowerCase();
  if (r[keyMatch]) return r[keyMatch];
  if (r.userLocation && keyLower === 'location') return r.userLocation;
  if (r.contextDataValues) {
    var cKeys = Object.keys(r.contextDataValues);
    for (var i = 0; i < cKeys.length; i++) {
      if (cKeys[i].toLowerCase().indexOf(keyLower) > -1) {
        return r.contextDataValues[cKeys[i]].valueLabel || r.contextDataValues[cKeys[i]].ValueLabel || r.contextDataValues[cKeys[i]].value || r.contextDataValues[cKeys[i]].Value;
      }
    }
  }
  if (r.additionalFields) {
    var aKeys = Object.keys(r.additionalFields);
    for (var j = 0; j < aKeys.length; j++) {
      if (aKeys[j].toLowerCase().indexOf(keyLower) > -1) {
        return r.additionalFields[aKeys[j]].valueLabel || r.additionalFields[aKeys[j]].ValueLabel || r.additionalFields[aKeys[j]].value || r.additionalFields[aKeys[j]].Value;
      }
    }
  }
  return null;
}

/* ─── Scroll to reviews section ─── */
function scrollToReviews() {
  /* Step 1: Scroll to bottom of page to force lazy-loaded reviews to mount */
  window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' in window ? 'auto' : 'auto' });

  /* Step 2: Poll for the reviews section to actually appear with content */
  var attempts = 0;
  var maxAttempts = 1;
  var interval = setInterval(function() {
    attempts++;
    var target = document.getElementById('product-reviews') ||
                 document.querySelector('.c-pwa-product-reviews');

    /* Wait until target exists AND has substantial content (not just a placeholder) */
    if (target && target.offsetHeight > 200) {
      clearInterval(interval);
      /* Final smooth scroll to the actual reviews section */
      setTimeout(function() {
        var y = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }, 150);
    } else if (attempts >= maxAttempts) {
      clearInterval(interval);
      /* Fallback: scroll to wherever it ended up */
      if (target) {
        var y = target.getBoundingClientRect().top + window.scrollY - 80;
        window.scrollTo({ top: y, behavior: 'smooth' });
      }
    }
  }, 100);
}

