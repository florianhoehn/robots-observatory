itle\":\"$undefined\",\"introParagraph\":\"$undefined\",\"accordionSections\":[{\"id\":\"2uENtjQ14Zlx0hPUjwLDp5\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"2uENtjQ14Zlx0hPUjwLDp5\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"What is MUTV?\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"data\":{},\"content\":[{\"data\":{},\"content\":[{\"data\":{},\"marks\":[],\"value\":\"MUTV is home to must-see exclusives, never-before-seen club content and gets you closer to the action with more behind-the-scenes access than ever before. Watch the full Premier League collection, match replays, MUTV Originals and Boxsets, the entire pre-season tour live, plus live Women’s team and Academy games, and much more. \",\"nodeType\":\"text\"}],\"nodeType\":\"paragraph\"}],\"nodeType\":\"document\"},\"__typename\":\"AccordionSectionContent\",\"links\":{\"__typename\":\"AccordionSectionContentLinks\",\"entries\":{\"__typename\":\"AccordionSectionContentEntries\",\"block\":[]}}}},{\"id\":\"1HotYwcn8KO5feVrVjb7dC\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"1HotYwcn8KO5feVrVjb7dC\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"What sort of programmes can I watch?\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"MUTV offers the most in-depth on-demand and live coverage of Manchester United anywhere. \\n\\nOur dedicated teams produce original programmes that get you closer to our Men's, Women's and Academy sides – and you can watch them at any time, anywhere, or add to your watchlist to view later.\\n\\nWe also offer regular live coverage of matches and events, ranging from live pre-season tour coverage of our men's team, to selected Women's and Academy games throughout the season, and live press conferences.\\n\\nOur production teams are on location to cover every single match – even when we don't have live rights to show the games. We offer in-depth build-up, radio commentary, match highlights, post-match reaction and analysis across all our games. \\n\\nWith your subscription, you'll unlock unbelievable insider access to your club...\\n\",\"marks\":[],\"data\":{}}]},{\"nodeType\":\"unordered-list\",\"data\":{},\"content\":[{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"24/7 access to the MUTV stream\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – live all year round\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"The full Premier League collection\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – every goal, game. Explore our archive and witness every inspirational moment from every game in our Premier League history\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Full match replays and highlights\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – relive it all, watch highlights, 90 in 20 and full match replays\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"MUTV Originals \u0026 Boxsets\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – binge your way through exclusive club films, documentaries and boxsets\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Live pre-season\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – exclusive to MUTV, watch every pre-season tour game live and exclusive\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Live matches\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – watch all the action with LIVE coverage of Manchester United Men and Women, U18s and U23s fixtures\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Manager’s press conference live\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – get game ready with the Manager’s Press conference live and uncut\",\"marks\":[],\"data\":{}}]}]},{\"nodeType\":\"list-item\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Pre-match show\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\",\"value\":\" – the insider view on matchday with exclusive pre-game build-up from our expert pundits and pitchside team.\",\"marks\":[],\"data\":{}}]}]}]},{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"\",\"marks\":[],\"data\":{}}]}]},\"__typename\":\"AccordionSectionContent\",\"links\":{\"__typename\":\"AccordionSectionContentLinks\",\"entries\":{\"__typename\":\"AccordionSectionContentEntries\",\"block\":[]}}}},{\"id\":\"6Zn8fmMtmPypng2lnRDj63\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"6Zn8fmMtmPypng2lnRDj63\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"Can I watch live games on MUTV?\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Yes, with access to MUTV you gets lots of live matches throughout the year. You can watch every Men's pre-season Tour game live, as well as live MU Women and Academy fixtures throughout the entire season.\\n\\nDue to broadcasting rights, we cannot show live Men's matches during the season, but you can listen to our live audio commentary and watch the pre-match show, half-time show and post-match analysis, exclusively live on MUTV every matchday.\",\"marks\":[],\"data\":{}}]}]},\"__typename\":\"AccordionSectionContent\",\"links\":{\"__typename\":\"AccordionSectionContentLinks\",\"entries\":{\"__typename\":\"AccordionSectionContentEntries\",\"block\":[]}}}},{\"id\":\"PjfN2b9RnPpF1u41oq0Ik\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"PjfN2b9RnPpF1u41oq0Ik\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"How do I add shows to my List?\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Create your own watchlists of your favourite shows and episodes by adding them to My List via the MUTV section on the app and website. Here's how:\\n\\n1. Select any show or a specific episode from a show\\n2. Select the My List plus icon and the show will be added to your watchlist\\n3. You'll know it's been saved when the My List icon displays a tick\\n\\nOn the Manchester United app, you can find My List in the top left corner of the MUTV section in the Manchester United app. On the website, you can view My List from the main MUTV homepage by clicking the ‘My List’ icon in the top right hand corner of the homepage, or via the main website menu under MUTV.\\n\\nYou need to be registered to add programmes and Shows to My List, so that you can access your favourite shows on any of your devices to watch any time.\\n\\nWe'll also show you programmes you've started, but haven't finished, in the Continue Playing section, so you can pick up where you left off.\",\"marks\":[],\"data\":{}}]}]},\"__typename\":\"AccordionSectionContent\",\"links\":{\"__typename\":\"AccordionSectionContentLinks\",\"entries\":{\"__typename\":\"AccordionSectionContentEntries\",\"block\":[]}}}},{\"id\":\"4IyyBbo4fwrunLObSJL9BU\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"4IyyBbo4fwrunLObSJL9BU\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"Can I watch MUTV on my TV?\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Yes! MUTV is available on Amazon Fire, Android TV, AppleTV, LG TVs and Samsung TVs (2020 models onwards), Xbox, and Roku (selected markets only).\\n\\nOnce you have access to MUTV via the Manchester United App or ManUtd.com, you can log in on your Amazon Fire TV, Android TV, Apple TV, LG and Samsung TVs, Xbox or Roku device with your registered MUTV Digital Email and Password.\\n\\nYou can also cast MUTV to any Chromecast or Airplay connected TV. Your device and the Chromecast or Airplay TV will need to be on the same Wi-Fi network.\",\"marks\":[],\"data\":{}}]}]},\"__typename\":\"AccordionSectionContent\",\"links\":{\"__typename\":\"AccordionSectionContentLinks\",\"entries\":{\"__typename\":\"AccordionSectionContentEntries\",\"block\":[]}}}},{\"id\":\"6h0reyHjkkz9xh3Y85j8yb\",\"publishedAt\":\"$undefined\",\"sys\":{\"id\":\"6h0reyHjkkz9xh3Y85j8yb\",\"__typename\":\"Sys\"},\"__typename\":\"AccordionSection\",\"title\":\"Can I access MUTV digitally as a Sky Subscriber\",\"assistiveText\":\"$undefined\",\"content\":{\"json\":{\"nodeType\":\"document\",\"data\":{},\"content\":[{\"nodeType\":\"paragraph\",\"data\":{},\"content\":[{\"nodeType\":\"text\",\"value\":\"Yes, you can access MUTV digital as a Sky subscriber.\",\"marks\":[],\"data\":{}},{\"nodeType\":\"text\",\"value\":\"\\n\\n1\",\"marks\":[{\"type\":\"bold\"}],\"data\":{}},{\"nodeType\":\"text\