        header{border-bottom:1px solid var(--line);}
        header .wrap{max-width:860px;margin:0 auto;padding:0 22px;height:64px;display:flex;align-items:center;}
        header img{height:31px;width:auto;display:block;}
        main{flex:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:48px 22px;}
        .box{max-width:560px;}
        .code{font-size:84px;font-weight:700;line-height:1;color:var(--download);letter-spacing:-2px;}
        h1{font-size:28px;font-weight:700;margin:14px 0 10px;}
        p{color:var(--muted);font-size:17px;margin:0 auto 28px;max-width:440px;line-height:1.6;}
        .cta{display:inline-block;background:var(--download);color:#06231f;font-weight:700;font-size:18px;padding:14px 40px;border-radius:40px;box-shadow:0 6px 22px rgba(46,198,199,.25);}
        .cta:hover{text-decoration:none;transform:translateY(-1px);}
        .links{margin-top:26px;display:flex;flex-wrap:wrap;gap:10px;justify-content:center;}
        .links a{background:#1c2330;border:1px solid var(--line);border-radius:30px;padding:8px 16px;color:var(--text);font-size:14px;}
        .links a:hover{border-color:var(--download);text-decoration:none;}
        footer{border-top:1px solid var(--line);padding:20px 22px;text-align:center;color:var(--muted);font-size:13px;}
        footer a{color:inherit;text-decoration:underline;text-underline-offset:2px;}
    </style>
</head>
