  <script>
(function () {
  if (window.__bplUserMenuInit) {
    console.warn('[bpl-user-menu] duplicate init skipped');
    return;
  }
  window.__bplUserMenuInit = true;
  function userFromDetail(d) {
    if (!d || typeof d !== 'object') return null;
    if (d.user && typeof d.user === 'object') return d.user;
    if (d.logged_in || d.user_id != null || d.user_login) return d;
    return null;
  }
  function loginFromUser(u) {
    if (!u) return '';
    if (typeof u.user_login === 'string' && u.user_login) return u.user_login;
    if (typeof u.login === 'string' && u.login) return u.login;
    if (u.user && typeof u.user.login === 'string' && u.user.login) return u.user.login;
    var p = u.profile_info || u.profileInfo;
    if (p && typeof p === 'object' && typeof p.login === 'string' && p.login) return p.login;
    return '';
  }
  function isLoggedIn(detail) {
    var u = userFromDetail(detail);
    if (!u) return false;
    if (u.logged_in === true) return true;
    if (u.id != null && u.id !== '') return true;
    if (u.user_id != null && u.user_id !== '') return true;
    return !!loginFromUser(u);
  }
  function showUserMenu(detail) {
    if (!isLoggedIn(detail)) return;
    var login = loginFromUser(userFromDetail(detail));
    document.querySelectorAll('.js-bpl-user-login').forEach(function (el) {
      el.textContent = login;
    });
    document.querySelectorAll('.js-bpl-user-when-guest').forEach(function (el) {
      el.style.display = 'none';
    });
    document.querySelectorAll('.js-bpl-user-when-logged, .js-bpl-user-logout-li').forEach(function (el) {
      el.style.display = 'block';
    });
  }
  function showBreadcrumb(detail) {
    if (!isLoggedIn(detail)) return;
    document.querySelectorAll('.js-bpl-breadcrumb-konto').forEach(function (el) {
      el.style.display = 'block';
    });
  }
  function applyUser(detail, source) {
    var src = source || (detail && detail.source) || 'unknown';
    var u = userFromDetail(detail);
    if (!isLoggedIn(detail)) {
      if (u) console.warn('[bpl-user-menu] payload without session', src, u);
      return;
    }
    showUserMenu(detail);
    showBreadcrumb(detail);
    console.warn('[bpl-user-menu] updated', {
      login: loginFromUser(u) || null,
      user_id: u.user_id != null ? u.user_id : u.id,
      source: src
    });
  }
  function replayFromBootstrap() {
    var el = document.getElementById('bankier-user-bootstrap-data');
    if (!el || !el.textContent) return;
    try {
      applyUser({ user: JSON.parse(el.textContent) }, 'bootstrap');
    } catch (e) {
      console.warn('[bpl-user-menu] bootstrap parse failed', e);
    }
  }
  document.addEventListener('bankier:user', function (ev) {
    applyUser(ev.detail, ev.detail && ev.detail.source);
  });
  document.addEventListener('bankier:user-error', function (ev) {
    console.warn('[bpl-user-menu] user fetch failed', ev.detail);
  });
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', replayFromBootstrap);
  } else {
    replayFromBootstrap();
  }
})();
