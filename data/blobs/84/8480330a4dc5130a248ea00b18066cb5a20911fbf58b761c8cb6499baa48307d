  if (!text) return;

  copyToClipboard(text).then(function () {
    var $icon = $el.find('i');
    var originalIconClass = $icon.attr('class');

    var tooltip = null;
    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
      tooltip = bootstrap.Tooltip.getInstance($el[0]) || bootstrap.Tooltip.getOrCreateInstance($el[0]);
    }
    var originalTitle = $el.attr('data-bs-original-title') || $el.attr('title') || $el.attr('data-bs-title') || '';

    if (tooltip) {
      if (typeof tooltip.setContent === 'function') {
        tooltip.setContent({ '.tooltip-inner': 'Afritað!' });
      } else if (typeof tooltip._fixTitle === 'function') {
        $el.attr('data-bs-original-title', 'Afritað!');
      }
      tooltip.show();
    }

    if ($icon.length) {
      $icon.attr('class', 'bi bi-check-lg text-success ms-1');
    }

    setTimeout(function () {
      if ($icon.length && originalIconClass) {
        $icon.attr('class', originalIconClass);
      }
      if (tooltip) {
        if (typeof tooltip.setContent === 'function') {
          tooltip.setContent({ '.tooltip-inner': originalTitle });
        } else if (typeof tooltip._fixTitle === 'function') {
          $el.attr('data-bs-original-title', originalTitle);
        }
        tooltip.hide();
      }
    }, 1500);
  }).catch(function (err) {
    console.error('Failed to copy: ', err);
  });
});

$(document).on('keydown', '[data-copy]', function (e) {
  if (e.key === 'Enter' || e.key === ' ') {
    e.preventDefault();
    $(this).trigger('click');
  }
});


                
                
            </script>
            
            
