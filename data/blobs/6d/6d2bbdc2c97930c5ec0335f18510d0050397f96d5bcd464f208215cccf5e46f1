#home .accordion-section .accordion-title-input {
  display: none;
}

#app .custom-parallax-v4 {
    --parallax-v4-mask-bg-color: inherit;
}

#cms-gallery #g2::after,
#app .video-stories-section .see-all-container.see-all-top {
  background-color: var(--primary-color);
}

#page .row.ts-full-width-row:nth-child(1) .image-container:after,
#page .full-width-column-row:nth-child(1) .image-container:after {
    background: none !important;
}

@media screen and (min-width: 1200px) {
    #app #view-header #cms-header #schoolsbutton {
        display: none;
    }
}

/* START Extra Social Media Icons */
#app .footer-social-links li[data-social-media=threads] a,
#app .footer-social-links li[data-social-media=flickr] a,
#app .footer-social-links li[data-social-media=threads] a:hover,
#app .footer-social-links li[data-social-media=flickr] a:hover {
    background-color: transparent;
    -webkit-mask-image: none;
    mask-image: none;
    display: flex;
    align-items: center;
    justify-content: center;
}

#app .footer-social-links li[data-social-media=threads] a img,
#app .footer-social-links li[data-social-media=flickr] a img {
    clip-path: none;
    width: 70%;
    height: 70%;
    object-fit: contain;
    filter: brightness(0) invert(1);
}

@media screen and (max-width: 960px) {
    #app .footer-social-links li[data-social-media=threads] a img,
    #app .footer-social-links li[data-social-media=flickr] a img {
        width: var(--icon-size-mobile);
        height: var(--icon-size-mobile);
    }
}
