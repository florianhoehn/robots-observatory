                return {};
            }
        }

        resolvePlanData(planData = null) {
            if (planData && typeof planData === 'object') {
                return planData;
            }

            return this.getLevelData();
        }

        resolvePaymentValue(amount) {
            const tier = Number(sessionStorage.getItem('level-tier'));

            return Number.isFinite(tier) && tier > 0 ? tier : (amount ?? this.getLevelData().price);
        }

        getLevelCurrency(planData = null) {
            let levelData = this.resolvePlanData(planData);

            return String(levelData.currency_code || levelData.currency || 'USD');
        }

        getSnapContentId(planData = null) {
            let levelData = this.resolvePlanData(planData);

            if (levelData && levelData.id) {
                return String(levelData.id);
            }

            return levelData && levelData.product_id ? String(levelData.product_id) : '';
        }

        hasSessionFlag(key) {
            try {
                return sessionStorage.getItem(key) === '1';
            } catch (e) {
                console.log(e);

                return false;
            }
        }

        setSessionFlag(key) {
            try {
                sessionStorage.setItem(key, '1');
            } catch (e) {
                console.log(e);
            }
        }

        clearSessionFlag(key) {
            try {
                sessionStorage.removeItem(key);
            } catch (e) {
                console.log(e);
            }
        }

        beginPendingSessionSend(key) {
            try {
                if (sessionStorage.getItem(key)) {
                    return false;
                }

                sessionStorage.setItem(key, 'pending');

                return true;
            } catch (e) {
                console.log(e);

                return true;
            }
        }

        sendAnalyticsEvent(formData, sessionKey = '') {
            return fetch('/api/analytics/event/fire', {
                method: 'POST',
                body: formData
            }).then((response) => {
                if (!response.ok) {
                    throw new Error('analytics event fire failed');
                }

                if (sessionKey) {
                    this.setSessionFlag(sessionKey);
                }

                return response;
            }).catch((e) => {
                if (sessionKey) {
                    this.clearSessionFlag(sessionKey);
                }

                console.log(e);
                throw e;
            });
        }

        buildSnapCustomData(contentId = '', contentName = '', amount = '', orderId = '', contentType = 'product', planData = null) {
            let data = {};
            let resolvedPlanData = this.resolvePlanData(planData);
            let resolvedContentId = contentId ? String(contentId) : this.getSnapContentId(resolvedPlanData);
            let resolvedContentName = contentName ? String(contentName) : (resolvedPlanData && resolvedPlanData.title ? String(resolvedPlanData.title) : '');
            let resolvedGroupId = this.getSnapItemGroupId();

            if (resolvedGroupId) {
                data.content_category = resolvedGroupId;
            }

            if (resolvedContentId) {
                data.content_ids = [resolvedContentId];
            }

            if (resolvedContentName) {
                data.content_name = resolvedContentName;
            }

            if (contentType) {
                data.content_type = String(contentType);
            }

            data.num_items = '1';

            if (amount !== '' && amount !== null && !Number.isNaN(Number(amount))) {
                data.value = Number(amount);
                data.currency = this.getLevelCurrency(resolvedPlanData);
                data.contents = [{
                    quantity: 1,
                    item_price: Number(amount),
                }];

                if (resolvedContentId) {
                    data.contents[0].id = resolvedContentId;
                }
            }

            if (orderId) {
                data.order_id = String(orderId);
            }

            return data;
        }

