<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Page Not Found</title>
  <style>
    .outerContainer {
        display: flex;
        flex: 1;
        clear: both;
        padding-left: 10px;
        padding-right: 10px;
        margin: auto;
    }
    @media (min-width: 992px) {
        .outerContainer {
            padding-left: 90px;
            padding-right: 90px;
        }
    }

    .innerContainer {
        display: flex;
        flex: 1;
        clear: both;
        max-width: 1280px;
        margin: auto;
        gap: unset;
        flex-direction: column;
        align-items: center;
    }

    .page404Img {
        position: relative;
        margin: 40px 0 30px 0;
        width: 100%;
        overflow: hidden;
        max-width: 300px;
        height: auto;
    }
    @media (min-width: 992px) {
        .page404Img {
            margin: 60px 0 30px 0;
        }
    }

    .page404Title {
        font-family: 'Tiempos Headline', Georgia, Times, 'Times New Roman', serif;
        font-size: 40px;
        line-height: 51px;
        font-weight: 600;
        letter-spacing: 0.02em;
        margin-bottom: 17px;
    }

    .page404BodyTxt {
        font-family: Georgia, Times, 'Times New Roman', serif;
        font-size: 17px;
        line-height: 28px;
        margin-bottom: 10px;
    }
    @media (min-width: 992px) {
        .page404BodyTxt {
            font-size: 20px;
            line-height: 32px;
            margin-bottom: 17px;
        }
    }

    .primaryCTAButton {
        font-family: Arial, 'Helvetica Neue', Helvetica, sans-serif;
        font-size: 13px;
        line-height: 19px;
        font-weight: 900;
        border: 1px solid #e4003b;
        border-radius: 50px;
        color: #e4003b;
        padding: 11px 22px 12px 22px;
        cursor: pointer;
        background: #fff;
        text-decoration: none;
        display: inline-block;
        transition: color 0.2s, border-color 0.2s;
    }
    .primaryCTAButton:hover {
        color: #a8002c;
        border-color: #a8002c;
    }
    .primaryCTAButton:focus-visible {
        border-radius: 50px;
        outline: #005fcc solid 1px;
        color: #a8002c;
        border-color: #a8002c;
        outline-offset: 5px;
    }

    .buttonGroup {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-top: 5px;
        margin-bottom: 60px;
    }
    @media (min-width: 992px) {
        .buttonGroup {
            margin-bottom: 100px;
        }
    }
  </style>
</head>
<body>
  <div class="outerContainer">
    <div class="innerContainer">
      <img
        alt="404 graphic image"
        src="https://cdn.kqed.org/wp-content/uploads/2026/02/404-error-1200x846@2x.png"
        class="page404Img"
        loading="eager"
        decoding="async"
      />
      <h1 class="page404Title">Page Not Found</h1>
      <p class="page404BodyTxt">The page you are looking for could not be found.</p>
      <p class="page404BodyTxt">Try one of these pages instead:</p>
      <div class="buttonGroup">
        <a href="/" class="primaryCTAButton">Homepage</a>
        <a href="/radio" class="primaryCTAButton">Radio</a>
        <a href="/podcasts" class="primaryCTAButton">Podcasts</a>
        <a href="/support/membership" class="primaryCTAButton">Membership</a>
        <a href="https://kqed-helpcenter.kqed.org/s/" class="primaryCTAButton">Help Center</a>
      </div>
    </div>
  </div>
</body>
</html>