<script>
  // Init Adobe library before Adobe Launch loads
  window.adobeDataLayer = window.adobeDataLayer || [];

  (function () {
    var hostname = window.location.hostname;

    var isResearchExchange = hostname === 'researchexchange.com' || hostname === 'www.researchexchange.com' || hostname === 'uat.researchexchange.com';

    var isLive = hostname === 'wiley.com' || hostname === 'www.wiley.com' || hostname === 'prod.webflow.wiley.com';

    function loadScript(src) {
      return new Promise(function (resolve, reject) {
        var script = document.createElement('script');
        script.async = true;
        script.src = src;

        script.onload = resolve;
        script.onerror = reject;

        document.head.appendChild(script);
      });
    }

    function preconnect(src) {
      var link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = new URL(src).origin;
      document.head.appendChild(link);
    }

    // Global tracking
    var osanoUrl;
    var globalTrackingUrl;
    var adobeLaunchUrl;

    if (isResearchExchange) {
      osanoUrl = 'https://cmp.osano.com/AzZdRbSORDOOzF9W/dc05c5ea-6f10-4a4c-aa80-b1c85a860e34/osano.js';
