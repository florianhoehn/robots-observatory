      console.error('[Osano] Failed to load:', error);
    });
  })();
</script>

<!-- Webflow Optimise and Analyse link to Osano consents -->
<script>
  console.log('[Osano > Webflow] Bridge script reached');

  wf.ready(function () {
    console.log('[Osano > Webflow] wf.ready fired');

    var isStaging = window.location.hostname === 'staging.webflow.wiley.com';

    function log() {
      if (isStaging) {
        console.log.apply(console, arguments);
      }
    }

    function warn() {
      if (isStaging) {
        console.warn.apply(console, arguments);
      }
    }

    function logError() {
      if (isStaging) {
        console.error.apply(console, arguments);
      }
    }

    function handleWebflowTrackingConsent() {
      try {
        log('[Osano > Webflow] Checking consent state...');

        if (!window.Osano || !window.Osano.cm) {
          warn('[Osano > Webflow] Osano CMP unavailable.');
          return;
        }

        var consent = window.Osano.cm.getConsent();

        log('[Osano > Webflow] Full consent object from Osano:', consent);

        var analyticsConsent = consent['ANALYTICS'];
        var personalizationConsent = consent['PERSONALIZATION'];

        log('[Osano > Webflow] ANALYTICS category value:', analyticsConsent);

        log('[Osano > Webflow] PERSONALIZATION category value:', personalizationConsent);

        var hasRequiredConsent = analyticsConsent === 'ACCEPT' && personalizationConsent === 'ACCEPT';

        if (hasRequiredConsent) {
          log('[Osano > Webflow] Analytics + Personalization ACCEPT > calling wf.allowUserTracking()');

          wf.allowUserTracking();
        } else {
          log('[Osano > Webflow] Analytics and/or Personalization not accepted > calling wf.denyUserTracking()');

          wf.denyUserTracking();
        }

        log('[Osano > Webflow] Webflow tracking choice:', wf.getUserTrackingChoice());
      } catch (error) {
        logError('[Osano > Webflow] Consent handler error:', error);
      }
    }

    log('[Osano > Webflow] Waiting for Osano...');

    if (!window.osanoReady) {
      logError('[Osano > Webflow] window.osanoReady does not exist.');
      return;
    }

    window.osanoReady
      .then(function () {
      log('[Osano > Webflow] Osano script loaded.');

      if (!window.Osano || !window.Osano.cm) {
        warn('[Osano > Webflow] Osano loaded but CMP API unavailable.');
        return;
      }

      // Apply existing consent
      handleWebflowTrackingConsent();

      // Re-check whenever consent changes
      window.Osano.cm.addEventListener('osano-cm-consent-saved', function () {
        log('[Osano > Webflow] Consent saved event fired.');

        handleWebflowTrackingConsent();
      });

      log('[Osano > Webflow] Consent listener attached.');
    })
      .catch(function (error) {
      logError('[Osano > Webflow] Osano failed to load:', error);
    });
  });
