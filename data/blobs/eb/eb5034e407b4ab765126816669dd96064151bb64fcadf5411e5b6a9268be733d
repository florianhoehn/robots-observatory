<script>
(function () {
  'use strict';

  var ORIGIN = 'https://www.read.ai';
  var LOCALES = ['es', 'it', 'pt', 'fr', 'ja', 'hi', 'ru', 'de', 'zh'];

  /* Route config — order matters (most specific first).
     parent.path MUST be a real, published page. */
  var ROUTES = [
    // Blog posts (collection slug /post, hub /blog)
    { match: /^\/post\/([^\/]+)\/?$/,             parent: { name: 'Blog',           path: '/blog' } },

    // Collections that roll up to the Resources hub
    { match: /^\/articles\/([^\/]+)\/?$/,         parent: { name: 'Resources',      path: '/resources' } },
    { match: /^\/research-article\/([^\/]+)\/?$/, parent: { name: 'Resources',      path: '/resources' } },
    { match: /^\/tech-briefs\/([^\/]+)\/?$/,      parent: { name: 'Resources',      path: '/resources' } },
    { match: /^\/resources\/([^\/]+)\/?$/,        parent: { name: 'Resources',      path: '/resources' } },

    // Product / section collections
    { match: /^\/integrations\/([^\/]+)\/?$/,     parent: { name: 'Integrations',   path: '/integrations' } },
    { match: /^\/agents\/([^\/]+)\/?$/,           parent: { name: 'Agents',         path: '/agents' } },
    { match: /^\/partnership\/([^\/]+)\/?$/,      parent: { name: 'Partnerships',   path: '/partnership' } },

    // Static sub-pages (not CMS, but still 3-level)
    { match: /^\/search-copilot\/([^\/]+)\/?$/,   parent: { name: 'Search Copilot', path: '/search-copilot' } }
  ];

  function splitLocale(pathname) {
    var parts = pathname.split('/').filter(Boolean);
    if (parts.length && LOCALES.indexOf(parts[0]) !== -1) {
      return { locale: '/' + parts[0], path: '/' + parts.slice(1).join('/') };
    }
    return { locale: '', path: pathname };
  }

  function getPageTitle() {
    var h1 = document.querySelector('h1');
    if (h1 && h1.textContent.trim()) return h1.textContent.trim();
    var og = document.querySelector('meta[property="og:title"]');
    if (og && og.content) return og.content.trim();
    return document.title.split(/[|•—–-]/)[0].trim();
  }

  function buildSchema(parent, title, locale) {
    var base = ORIGIN + locale;
    return {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home',      item: base || ORIGIN },
        { '@type': 'ListItem', position: 2, name: parent.name, item: base + parent.path },
        { '@type': 'ListItem', position: 3, name: title,       item: base + window.location.pathname.replace(/\/$/, '') }
      ]
    };
  }

  function injectSchema(schema) {
    var existing = document.querySelector('script[data-breadcrumb-schema]');
    if (existing) existing.remove();
    var tag = document.createElement('script');
    tag.type = 'application/ld+json';
    tag.setAttribute('data-breadcrumb-schema', 'true');
    tag.textContent = JSON.stringify(schema, null, 2);
    document.head.appendChild(tag);
  }

  function run() {
    var split = splitLocale(window.location.pathname);
    for (var i = 0; i < ROUTES.length; i++) {
      var m = split.path.match(ROUTES[i].match);
      if (!m) continue;
      var title = getPageTitle();
      if (!title) return;
      injectSchema(buildSchema(ROUTES[i].parent, title, split.locale));
      return;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
})();
</script>
