<!DOCTYPE html>
<html
  lang="no"
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:sec="http://www.thymeleaf.org/thymeleaf-extras-springsecurity3"
>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <title>Fant ikke siden</title>
    <link
      type="text/css"
      media="all"
      href="https://cdn.aftenposten.no/ap/css/404/fonts_v2.css"
      rel="stylesheet"
    />
    <link
      type="text/css"
      media="all"
      href="https://cdn.aftenposten.no/ap/css/404/style_v3.css"
      rel="stylesheet"
    />
    <script
      src="https://cdn.aftenposten.no/ap/js/404/scripts.js"
      type="text/javascript"
      defer
    ></script>
    <script type="application/javascript">
      (function (w, d, n, t, s, a, b) {
        w[n] =
          w[n] ||
          function () {
            (window[n].q = window[n].q || []).push(arguments);
          };
        a = d.createElement(t);
        b = document.getElementsByTagName(t)[0];
        a.async = 1;
        a.src = s;
        b.parentNode.insertBefore(a, b);
      })(
        window,
        document,
        'pulse',
        'script',
        '//sdk.pulse.schibsted.com/versioned/3/pulse.min.js',
      );
      pulse('init', 'aftenposten');
      pulse('update', {
        object: {
          type: 'Page',
          id: 'error-404',
          name: 'Error page: 404 - not found',
        },
      });
      pulse('trackPageView');
    </script>
  </head>
  <body>
    <div class="container">
      <div class="illustration-container">
        <video class="illustration" autoplay muted playsinline loop>
          <source
            src="https://cdn.aftenposten.no/ap/images/404/404_video.mp4"
            type="video/mp4"
          />
          Din nettleser støtter ikke videoavspilling.
        </video>
      </div>
      <main>
        <h1>Vi beklager.</h1>

        <p class="lead">
          <span>Vi kunne ikke finne siden du lette etter: </span>
          <span class="search-query"></span>
        </p>
        <div class="actions">
          <div class="buttons">
            <a
              class="buttons__home"
              href="https://www.aftenposten.no"
              rel="noopener nofollow noreferrer"
              >Gå til Aftenposten.no</a
            >
            <a
              class="buttons__previous"
              href="javascript:window.history.back()"
              rel="noopener nofollow noreferrer"
              >Forrige side</a
            >
          </div>
          <a
            class="report"
            href="mailto:tips@aftenposten.no"
            rel="noopener nofollow noreferrer"
            target="_blank"
            >Rapporter en ødelagt lenke</a
          >
        </div>
      </main>
    </div>
  </body>
</html>
