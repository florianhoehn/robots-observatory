<script>
  (function () {
    function patchButtons(root = document) {
      root.querySelectorAll('a.book-demo-btn').forEach(function (btn) {
        btn.onclick = null;               // zdejmuje inline handler w JS
        btn.removeAttribute("onclick");   // zdejmuje atrybut
        btn.setAttribute("href", "/book-a-demo");
        btn.setAttribute("target", "_self");
      });
    }

    // 1) od razu
    patchButtons();

    // 2) po pełnym załadowaniu (często w Webflow elementy “dojeżdżają” później)
    window.addEventListener("load", function () {
      patchButtons();
    });

    // 3) jeśli coś dynamicznie podmienia DOM (navbar, symbol, itp.) – obserwuj zmiany
    const observer = new MutationObserver(function () {
      patchButtons();
    });
    observer.observe(document.documentElement, { childList: true, subtree: true });

    // 4) i najważniejsze: przechwytuj klik zanim dojdzie do innych handlerów
    document.addEventListener("click", function (e) {
      const a = e.target.closest("a.book-demo-btn");
      if (!a) return;
      e.preventDefault();
      e.stopPropagation();
      window.location.assign("/book-a-demo");
    }, true);
  })();
