<script>
// "SEO/AEO Dec Fix" - Homepage Safety & Cleanup Script
// Purpose: Removes risky CMS-generated schema + conflicting microdata.
// 1. NUKE MICRODATA: Cleans up HTML attributes.
// 2. SCAVENGE REVIEWS: Deletes orphan JSON-LD reviews from the slider.

(function() {
    // Function to clean up the code
    function makePageSafe() {
        
        // --- A. MICRODATA NUKE ---
        const conflicts = document.querySelectorAll('[itemscope], [itemtype], [itemprop]');
        if (conflicts.length > 0) {
            conflicts.forEach(el => {
                el.removeAttribute('itemscope');
                el.removeAttribute('itemtype');
                el.removeAttribute('itemprop');
            });
        }

        // --- B. JSON-LD SCAVENGER (The fix for your CMS Snippets) ---
        const allScripts = document.querySelectorAll('script[type="application/ld+json"]');
        
        allScripts.forEach(script => {
            // SAFETY: Ignore your Master Schema (id="menlo-homepage-schema")
            if (script.id === 'menlo-homepage-schema') return;

            try {
                const content = script.textContent;
                // TARGET: Look for scripts that are JUST reviews (from your CMS)
                // If it has "Review" but is NOT your main SoftwareApplication
                if (content.includes('"@type": "Review"') && !content.includes('SoftwareApplication')) {
                    script.remove();
                    // console.log("SEO Clean: Removed a CMS Review snippet.");
                }
            } catch (e) { /* Ignore parse errors */ }
        });
    }

    // Run immediately to catch crawlers fast
    makePageSafe();
    
    // Run again when DOM is fully parsed (double-check)
    window.addEventListener('DOMContentLoaded', makePageSafe);
    
    // Run one last time after window load (for any stragglers)
    window.addEventListener('load', makePageSafe);

})();
</script>

