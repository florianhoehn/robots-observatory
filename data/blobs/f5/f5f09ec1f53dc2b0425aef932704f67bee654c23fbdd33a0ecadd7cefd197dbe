    var GOOGLE_ADS_VENDORS = [755, 's1498'];
    // La CMP est livree en async par GTM et peut ne prendre la main qu'au bout d'une
    // trentaine de secondes (mesure terrain sur www.paris-roubaix.fr) : relecture
    // rapide au debut, puis au ralenti jusqu'a CMP_WATCH_DEADLINE_MS. Au-dela, seul
    // l'evenement `consent` peut encore declencher le chargement.
    var CMP_POLL_MS = 300;
    var CMP_LATE_POLL_MS = 2000;
    var CMP_FAST_WINDOW_MS = 10000;
    var CMP_WATCH_DEADLINE_MS = 60000;
    // L'evenement `consent` peut partir avant que vendorConsents soit applique
    // (constate sur consentGate.js) : on relit quelques fois apres chaque signal.
    var CMP_APPLY_MS = 400;
    var CMP_APPLY_RETRIES = 4;

    (function() {
        var loaded = false;
        var subscribed = false;
        var startedAt = Date.now();

        // true uniquement sur un accord explicite du vendor. Tout le reste (stub,
        // CMP absente, pas encore de choix, refus, map pas encore appliquee) veut
        // dire "on ne charge pas maintenant".
        function hasAdConsent() {
            if (typeof window.__cmp !== 'function') {
                return false;
            }

            var status;
            try {
                status = window.__cmp('consentStatus');
            } catch (e) {
                return false;
            }

            // Le stub repond undefined ; userChoiceExists ne passe a true qu'apres
            // un clic reel (consentExists, lui, vaut toujours true : faux ami).
            if (!status || typeof status !== 'object' || status.userChoiceExists !== true) {
                return false;
            }

            var data = null;
            try {
                // getCMPData repond par callback (synchrone) ou par valeur de retour
                // selon la version : on accepte les deux.
                var returned = window.__cmp('getCMPData', null, function(payload) {
                    if (payload && typeof payload === 'object') {
                        data = payload;
                    }
                });
                if (!data && returned && typeof returned === 'object') {
                    data = returned;
                }
            } catch (e) {
                return false;
            }

            var consents = (data && data.vendorConsents) || {};

            return GOOGLE_ADS_VENDORS.some(function(key) {
                return consents[key] === true;
            });
        }

        function loadGpt() {
            if (loaded) {
                return;
            }
            loaded = true;

            var gads = document.createElement("script");
            gads.async = true;
            gads.type = "text/javascript";
            gads.src = "https://securepubads.g.doubleclick.net/tag/js/gpt.js";
            var node = document.getElementsByTagName("script")[0];
            node.parentNode.insertBefore(gads, node);
        }

        function check() {
            if (!loaded && hasAdConsent()) {
                loadGpt();
            }

            return loaded;
        }

        // Relectures apres un evenement `consent` (cf. CMP_APPLY_RETRIES).
        function checkSoon() {
            var left = CMP_APPLY_RETRIES;

            (function retry() {
                if (check() || left-- <= 0) {
                    return;
                }
                window.setTimeout(retry, CMP_APPLY_MS);
            })();
        }

        // Acceptation en cours de visite, ou changement d'avis via l'ecran de
        // preferences. Pose des que la vraie CMP est la (le stub n'est pas fiable).
        function subscribe() {
            if (subscribed || typeof window.__cmp !== 'function') {
                return;
            }
            subscribed = true;

            try {
                window.__cmp('addEventListener', ['consent', checkSoon, false], null);
            } catch (e) {
                // CMP sans API d'evenements : la relecture periodique reste le filet.
            }
        }

        (function poll() {
            if (check()) {
                return;
            }
            subscribe();

            var elapsed = Date.now() - startedAt;
            if (elapsed < CMP_WATCH_DEADLINE_MS) {
                window.setTimeout(poll, elapsed < CMP_FAST_WINDOW_MS ? CMP_POLL_MS : CMP_LATE_POLL_MS);
            }
        })();
    })();

