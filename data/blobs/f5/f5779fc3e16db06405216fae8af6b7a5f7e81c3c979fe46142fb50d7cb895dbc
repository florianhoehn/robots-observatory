            {path: '/region/hamburg/', host: 'https://hamburg.t-online.de'},
            {path: '/region/hannover/', host: 'https://hannover.t-online.de'},
            {path: '/region/koeln/', host: 'https://koeln.t-online.de'},
            {path: '/region/leipzig/', host: 'https://leipzig.t-online.de'},
            {path: '/region/muenchen/', host: 'https://muenchen.t-online.de'},
            {path: '/region/muenster/', host: 'https://muenster.t-online.de'},
            {path: '/region/nuernberg/', host: 'https://nuernberg.t-online.de'},
            {path: '/region/stuttgart/', host: 'https://stuttgart.t-online.de'},
            {path: '/region/wuppertal/', host: 'https://wuppertal.t-online.de'},

            // Add more paths and tenant URLs as needed
            {path: '/', host: 'https://www.t-online.de'}, // Fallback
        ];

        function tenantRedirect() {
            const currentPathname = window.location.pathname;
            const isNotIframe = window.location === window.parent.location;
            for (const entry of orderedRedirectMapping) {
                console.log('currentPathname', window.location.pathname);
                console.log('entry', entry);
                const redirectUrl = entry['host'] + currentPathname;
                if (currentPathname.startsWith(entry['path']) && isNotIframe && window.location.href !== redirectUrl && entry['path'] !== '/') {
                    window.location.href = redirectUrl;
                    return;
                }
            }
            // prevent meta refresh in iframe i.e. embedded content
            window.stop(); // prevent meta refresh
        }

        function fallbackRedirect() {
            const isNotIframe = window.location === window.parent.location;
            if (isNotIframe) {
                for (const entry of orderedRedirectMapping) {
                    if (window.location.href.startsWith(entry['host'])) {
                        window.location.href = entry['host'] + entry['path'];
                        return;
                    }
                }
            } else {
                // prevent meta refresh in iframe i.e. embedded content
                window.stop();
            }
        }

        setTimeout(() => {
            tenantRedirect();
        }, 4200);
        setTimeout(() => {
            fallbackRedirect();
        }, 5000);
    </script>
