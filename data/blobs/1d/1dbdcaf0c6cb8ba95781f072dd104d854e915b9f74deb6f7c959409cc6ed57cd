<!DOCTYPE html>
<html lang="en">
    <head>
        
        <title>Login</title>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="shortcut icon" type="image/png" href="/favicon.ico" />
        <link rel="stylesheet" href="/semanticui/semantic.min.css" />
        <script src="/js/pub/jquery-3.7.1.min.js"></script>
        <script src="/semanticui/semantic.min.js"></script>
        <script src="/ckeditor/ckeditor.js"></script>
        <script src="/js/lib/tablesort.min.js"></script>
        <script src="/js/lib/tablesort.number.min.js"></script>
        <link rel="stylesheet" href="/css/admin.css" />
        <link rel="stylesheet" href="/css/tablesort.css" />
        <script>

            document.addEventListener('DOMContentLoaded', () => {

                // User menu dropdown
                $('#user-dropdown').dropdown();

                // Message closing
                document.querySelectorAll('.message > i.close').forEach(element => {
                    element.addEventListener('click', () => element.parentNode.style.display = 'none');
                });

                // Tooltips
                loadGeneralTooltips();
                loadTableTooltips()
                setTimeout(() => loadTableTooltips(), 500); // Avoids tooltips issues on tables

                // Accordions
                $('.ui.accordion').accordion();

                // Image lightbox
                const dialog = document.getElementById('support-image-dialog');
                dialog.addEventListener('click', () => dialog.close());
                document.querySelectorAll('.ui.segment img').forEach(image => {
                    image.addEventListener('click', () => {
                        dialog.innerHTML = '<img src="' + image.src + '" />';
                        dialog.showModal();
                    })
                });

                // New tab links
                document.querySelectorAll('.ui.segment a').forEach(element => element.setAttribute('target', '_blank'));

                // Table sorting
                document.querySelectorAll('table.sortable-table').forEach(table => {
                    const tablesort = new Tablesort(table, {descending: table.hasAttribute('data-sort-desc')});
                    table.addEventListener('afterSort', () => loadTableTooltips()); // Refresh tooltips after sorting
                    // First time, table could be descending order sorted to show interesting results first, but ascending next times
                    tablesort.options.descending = false;
                });

                // Expands
                const expandIcon = document.getElementById('expandIcon');
                if (expandIcon) {
                    document.querySelectorAll('.expand').forEach(element => element.style.display = 'none');
                    expandIcon.addEventListener('click', () => {
                        if (expandIcon.classList.contains("plus")) {
                            $('.expand').show(500);
                            expandIcon.classList.remove("plus");
                            expandIcon.classList.add("minus")
                        } else {
                            $('.expand').hide(500);
                            expandIcon.classList.remove("minus");
                            expandIcon.classList.add("plus")
                        }
                    });
                }

            });

            // Tooltips
            function loadGeneralTooltips() {
                document.querySelectorAll('.tooltip').forEach(tooltip => {
                    tooltip.classList.add('help', 'circle', 'icon', 'black');
                    $(tooltip).popup();
                });
            }

            function loadTableTooltips() {
                document.querySelectorAll('.stats-tooltip').forEach(tooltip => {
                    tooltip.classList.add('info', 'circle', 'icon', 'grey');
                    $(tooltip).popup();
                });
            }

            // User menu form
            function clearForm() {
                document.querySelector('#query').value = '';
                document.querySelector('#query').focus();
            }

        </script>
        
    </head>
    <body>
        <div class="ui container">
            <header class="ui inverted violet borderless menu stackable">
                <div class="header item">
                    <a href="/logged.html">Code Black Belt • Shopify Apps • PRODUCTION • JVM: 25.0.3</a>
                </div>
                
                <div id="search-box" class="right menu">
                    
                </div>
                <div class="right mobile-hidden">
                    
                </div>
            </header>
            
            
            <div id="main" class="stackable grid">
                <div class="content">
            <div class="ui center aligned grid">
                <div class="ui column left aligned login">
                    <h1>Login</h1>
                    
                    
                    <form action="/login" method="post" class="ui segment form">
                        <div class="field">
                            <label for="username">Username</label>
                            <div class="ui left icon input">
                                <i class="user icon"></i>
                                <input type="text" id="username" name="username" required="required" autofocus="autofocus" />
                            </div>
                        </div>
                        <div class="field">
                            <label>Password</label>
                            <div class="ui left icon input">
                                <i class="lock icon"></i>
                                <input type="password" id="password" name="password" required="required" />
                            </div>
                        </div>
                        <button class="ui fluid large teal submit button" type="submit">Login</button>
                    </form>
                    <div class="ui horizontal divider">or</div>
                    <a href="oauth2/authorize/google"
                       class="ui fluid large google plus button">
                        <i class="google icon"></i> Sign in with Google
                    </a>
                </div>
            </div>
        </div>
            </div>
            <br/>
            

            <!-- Image modal -->
            <dialog id="support-image-dialog"></dialog>
        </div>
    </body>
</html>