		// ZVA Auto-Login
		function initZoomAutoLogin() {
		  const ZVA_JWT_ENDPOINT = (function () {
		    const h = window.location.hostname;
		
		    if (h.indexOf('dev1') !== -1) return 'https://apigw.dev1.smiles.com.br/atd/zoom-consumer-auth/jwt/v1';
		    if (h.indexOf('hml1') !== -1) return 'https://apigw-hml1.smiles.com.br/atd/zoom-consumer-auth/jwt/v1';
		    if (h.indexOf('uat1') !== -1) return 'https://apigw-hml1.smiles.com.br/atd/zoom-consumer-auth/jwt/v1';
		
		    return 'https://apigw.smiles.com.br/atd/zoom-consumer-auth/jwt/v1';
		  })();
		
		  const SESSION_TOKEN_KEY = 'session-token';
		  const MEMBER_NUMBER_CLAIM = 'https://smiles.api/memberNumber';
		  const LOG_PREFIX = '[ZVA-AutoLogin]';
		
		  function safeParseJwt(token) {
		    try {
		      if (!token || token.split('.').length !== 3) return null;
		
		      let base64 = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
		
		      while (base64.length % 4) {
		        base64 += '=';
		      }
		
		      const json = decodeURIComponent(
		        atob(base64)
		          .split('')
		          .map(function (c) {
		            return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
		          })
		          .join('')
		      );
		
		      return JSON.parse(json);
		    } catch (e) {
		      return null;
		    }
		  }
		
		  function readSessionToken() {
		    try {
		      const token = localStorage.getItem(SESSION_TOKEN_KEY);
		
		      if (!token || token.split('.').length !== 3) return null;
		
		      const payload = safeParseJwt(token);
		
		      if (!payload) return null;
		      if (payload.exp && payload.exp <= Math.floor(Date.now() / 1000)) return null;
		      if (!payload[MEMBER_NUMBER_CLAIM]) return null;
		
		      return token;
		    } catch (e) {
		      return null;
		    }
		  }
		
		  function fetchZoomJwt() {
		    const sessionToken = readSessionToken();
		
		    if (!sessionToken) {
		      console.info(LOG_PREFIX, 'sem sessão Smiles -> anônimo');
		      return Promise.resolve(null);
		    }
		
		    return fetch(ZVA_JWT_ENDPOINT, {
		      method: 'GET',
		      credentials: 'include',
		      headers: {
		        Authorization: 'Bearer ' + sessionToken,
		        Accept: 'application/json'
		      }
		    })
		      .then(function (resp) {
		        if (!resp.ok) {
		          console.warn(LOG_PREFIX, 'endpoint respondeu', resp.status, '-> anônimo');
		          return null;
		        }
		
		        return resp.json();
		      })
		      .then(function (data) {
		        if (!data || typeof data.loginUserIdJwt !== 'string') {
		          console.warn(LOG_PREFIX, 'resposta sem loginUserIdJwt -> anônimo');
		          return null;
		        }
		
		        console.info(LOG_PREFIX, 'JWT obtido -> auto-login ativado');
		        return data.loginUserIdJwt;
		      })
		      .catch(function (err) {
		        console.warn(LOG_PREFIX, 'falha ao buscar JWT:', err && err.message, '-> anônimo');
		        return null;
		      });
		  }
		
		  function whenSdkReady(callback) {
		    let attempts = 0;
		
		    const interval = setInterval(function () {
		      attempts++;
		
		      const cfg = window.ZoomWebSDKDef__GlobalConfigs;
		
		      if (
		        cfg &&
		        cfg.getUserLoginData &&
		        typeof cfg.getUserLoginData.write === 'function'
		      ) {
		        clearInterval(interval);
		        callback(cfg);
		        return;
		      }
		
		      if (attempts > 120) {
		        clearInterval(interval);
		        console.warn(LOG_PREFIX, 'SDK Zoom não inicializou em 30s');
		      }
		    }, 250);
		  }
		
		  whenSdkReady(function (cfg) {
		    cfg.getUserLoginData.write(fetchZoomJwt);
		    console.info(LOG_PREFIX, 'hook getUserLoginData registrado');
		  });
		}
		
		function hideZoomSources() {
		  (function () {
		    'use strict';
		
		    try {
		      if (window.__zva_hide_sources_loaded__) return;
		      window.__zva_hide_sources_loaded__ = true;
		
		      const CSS = '' +
		        '.livesdk__multiKb__source__btn,' +
		        '.livesdk__multiKb__button--sources,' +
		        '.livesdk__multiKb__source__content,' +
		        '.livesdk__multiKb__source__content__text,' +
		        '[class*="multiKb__source__btn"],' +
		        '[class*="multiKb__button--sources"],' +
		        '[class*="multiKb__source__content"]' +
		        '{ display: none !important; }';
		
		      const STYLE_ID = '__zva_hide_sources__';
		
		      function hideHr(root) {
		        try {
		          const hrs = root.querySelectorAll('hr');
		
		          for (let i = 0; i < hrs.length; i++) {
		            const next = hrs[i].nextElementSibling;
		
		            if (next) {
		              const className = next.className || '';
		
		              if (
		                typeof className === 'string' &&
		                (
		                  className.indexOf('source__btn') >= 0 ||
		                  className.indexOf('button--sources') >= 0
		                )
		              ) {
		                hrs[i].style.display = 'none';
		              }
		            }
		          }
		        } catch (e) { }
		      }
		
		      function injectStyle(root) {
		        try {
		          if (!root || root.querySelector('#' + STYLE_ID)) return;
		
		          const style = document.createElement('style');
		          style.id = STYLE_ID;
		          style.textContent = CSS;
		
		          root.appendChild(style);
		        } catch (e) { }
		      }
		
		      function injectAll() {
		        try {
		          injectStyle(document.head);
		
		          const walker = document.createTreeWalker(
		            document,
		            NodeFilter.SHOW_ELEMENT,
		            null,
		            false
		          );
		
		          let node = walker.currentNode;
		
		          while (node) {
		            if (node.shadowRoot) {
		              injectStyle(node.shadowRoot);
		              hideHr(node.shadowRoot);
		            }
		
		            node = walker.nextNode();
		          }
		        } catch (e) { }
		      }
		
		      injectAll();
		
		      let attempts = 0;
		
		      const interval = setInterval(function () {
		        injectAll();
		
		        if (++attempts >= 30) {
		          clearInterval(interval);
		        }
		      }, 1000);
		
		      try {
		        const observer = new MutationObserver(function () {
		          injectAll();
		        });
		
		        observer.observe(document.body, {
		          childList: true,
		          subtree: true
		        });
		
		        setTimeout(function () {
		          try {
		            observer.disconnect();
		          } catch (e) { }
		        }, 60000);
		      } catch (e) { }
		    } catch (e) {
		      if (window.console && console.error) {
		        console.error('[zva-hide-sources] failed:', e);
		      }
		    }
		  })();
		}
		
		async function enableZoomChatbot() {
		  console.info('[Chatbot Zoom] Verificando LaunchDarkly...');
		
		  const enabled = await shouldEnableChatbotZoom();
		
		  if (!enabled) {
		    console.info('[Chatbot Zoom] Desabilitado via LaunchDarkly.');
		    return;
		  }
		
		  try {
		
		    await loadZoomSdk();
		    initZoomAutoLogin();
		    hideZoomSources();
		
		    console.info('[Chatbot Zoom] Habilitado via LaunchDarkly com sucesso.');
		  } catch (error) {
		    console.warn('[Chatbot Zoom] Erro ao carregar SDK.', error);
		  }
		}
		
		window.addEventListener('load', async function () {
		  hideWatsonChatbot();
		  await enableZoomChatbot();
		});
