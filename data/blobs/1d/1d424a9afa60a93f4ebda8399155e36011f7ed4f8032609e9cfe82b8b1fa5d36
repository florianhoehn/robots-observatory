		    dev2: 'https://ldrelay.dev2.smiles.com.br/sdk/evalx/5ff64893991a4c0aa4974fc7/users/eyJrZXkiOiJERVYyLU4ifQ%3D%3D',
		    dev3: 'https://ldrelay.dev3.smiles.com.br/sdk/evalx/5ff64893991a4c0aa4974fc7/users/eyJrZXkiOiJERVYzLU4ifQ%3D%3D',
