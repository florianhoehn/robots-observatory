  var canonicalUrl = customOrigin + path;

  var existingCanonical = document.querySelector('link[rel="canonical"]');

  if (path.includes('/products/')) {
    // Always overwrite or create canonical tag for /products/ URLs
    if (!existingCanonical) {
      existingCanonical = document.createElement('link');
      existingCanonical.rel = 'canonical';
      document.head.appendChild(existingCanonical);
    }
    existingCanonical.href = canonicalUrl;
  } else {
    // Only add if it doesn't already exist
    if (!existingCanonical) {
      var canonical = document.createElement('link');
      canonical.rel = 'canonical';
      canonical.href = canonicalUrl;
      document.head.appendChild(canonical);
    }
  }
})();
</script>
