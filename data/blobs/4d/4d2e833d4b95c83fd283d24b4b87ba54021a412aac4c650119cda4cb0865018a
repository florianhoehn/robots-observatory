<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <!-- Header -->
    <header class="header header--home">
        <nav class="nav">
            <div class="nav-container">
                <div class="nav-logo">
                    <a href="/">
                        <img src="/images/Master_Logo_Final.png" alt="Master" class="logo-img">
                        <span class="logo-text">Master</span>
                    </a>
                </div>
                <div class="nav-right">
                    <a href="https://play.google.com/store/apps/details?id=com.master.learn.ai&hl=en" target="_blank" rel="noopener noreferrer" class="play-badge play-badge--header">
                        <span class="play-badge__mark" aria-hidden="true"><img src="/images/playstore.png" alt="" width="32" height="32" decoding="async"></span>
                        <span class="play-badge__text">
                            <span class="play-badge__label">GET IT ON</span>
                            <span class="play-badge__name">Google Play</span>
                        </span>
                    </a>
                </div>
            </div>
        </nav>
    </header>

    <!-- 404 Content -->
    <section class="error-page">
        <div class="error-container">
            <div class="error-content">
                <div class="error-icon">
                    <i class="fas fa-search"></i>
                </div>
                <h1 class="error-title">404</h1>
                <h2 class="error-subtitle">Page Nahi Mila!</h2>
                <p class="error-description">
                    Lagta hai aap jo page dhund rahe hain wo exist nahi karta. 
                    Kya aap galat link pe click kar diye?
                </p>
                <div class="error-actions">
                    <a href="/" class="btn-primary">
                        <i class="fas fa-home"></i>
                        Home Pe Jayen
                    </a>
                    <a href="javascript:history.back()" class="btn-secondary">
                        <i class="fas fa-arrow-left"></i>
                        Wapas Jayen
                    </a>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/main.js"></script>
</body>
</html> 