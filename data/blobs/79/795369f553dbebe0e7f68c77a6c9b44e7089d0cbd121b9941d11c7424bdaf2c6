<script>
    document.addEventListener("DOMContentLoaded", function () {
        if (window.BELL && BELL.gConnector && typeof BELL.gConnector.init === 'function') {
            BELL.gConnector.init();
        }

        function getCartTarget() {
          return document.getElementById('cartBtnG') || document.getElementById('cartBtnItemized');
        }

        function getVisiblePopularButtons() {
        var popularWrap = document.getElementById('searchPopularConnector');
        if (!popularWrap) {
            return [];
        }

        var isActive = popularWrap.classList.contains('g-active');
        var isHidden = popularWrap.classList.contains('g-visually-hidden');
        if (!isActive || isHidden) {
            return [];
        }

        var allButtons = popularWrap.querySelectorAll('.g-connector-search-popular-btn');
        var visibleButtons = [];
        for (var i = 0; i < allButtons.length; i++) {
            var btn = allButtons[i];
            if (!btn.disabled && btn.offsetParent !== null) {
                visibleButtons.push(btn);
            }
        }

        return visibleButtons;
    }


        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Tab' || e.shiftKey) {
                return;
            }

            var target = e.target;
            if (!target) {
                return;
            }

            var isSearchInput = target.id === 'searchFieldG' ||
                (target.classList && target.classList.contains('g-connector-search-field'));

           if (isSearchInput) {
            var popularButtonsFromInput = getVisiblePopularButtons();
            if (popularButtonsFromInput.length > 0) {
                popularButtonsFromInput[0].setAttribute('tabindex', '0');
                e.preventDefault();
                popularButtonsFromInput[0].focus();
                return;
            }

            var cartFromInput = getCartTarget();
            if (cartFromInput) {
                cartFromInput.setAttribute('tabindex', '0');
                e.preventDefault();
                cartFromInput.focus();
            }
            return;
        }

        var isPopularBtn = target.classList && target.classList.contains('g-connector-search-popular-btn');
        if (!isPopularBtn) {
            return;
        }

        var popularButtons = getVisiblePopularButtons();
        if (popularButtons.length === 0) {
            return;
        }

        var lastPopular = popularButtons[popularButtons.length - 1];
        if (target === lastPopular) {
            var cartFromPopular = getCartTarget();
            if (cartFromPopular) {
                cartFromPopular.setAttribute('tabindex', '0');
                e.preventDefault();
                cartFromPopular.focus();
            }
        }
    }, true);
});
</script>


