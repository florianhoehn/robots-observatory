<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <link href="//fonts.googleapis.com/css?family=Droid+Sans:400,700|Droid+Sans+Mono" rel="stylesheet" type="text/css">
    <title>404 Not Found</title>
    <meta name="robots" content="noindex">
    <meta name="viewport" content="initial-scale=1.0">
    <meta name="viewport" content="width=320.1">
    <link rel="icon" type="image/png" href="https://cdn.t3n.de/global/images/icons/t3n-favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="https://cdn.t3n.de/global/images/icons/t3n-favicon-32x32.png" sizes="32x32">
    <link rel="icon" type="image/png" href="https://cdn.t3n.de/global/images/icons/t3n-favicon-96x96.png" sizes="96x96">
  <style>
  .error {
    background: #2a2a2a;
    font-family: "Droid Sans", sans-serif, Arial, Helvetica;
    font-size: 16px;
    line-height: 1.5;
    margin: 0;
  }
  .error__wrapper {
    color: white;
    max-width: 680px;
    width: 90%;
    margin: 0 auto;
    -webkit-transform: translate(0, 5%);
    -ms-transform: translate(0, 5%);
    transform: translate(0, 5%);
    position: relative;
    z-index: 4;
  }
  .error__logo {
    width: 125px;
  }
  .error__header {
    margin: 0 0 40px 0;
    position: relative;
    left: -5px;
  }
  .error__message {
    margin: 40px 0 0;
    overflow: hidden;
  }
  .error__title {
    float: left;
    color: white;
    font-size: 90px;
    line-height: 90px;
    margin: 0 10px 0 0;
  }
  @media (max-width: 40em) {
    .error__title {
      float: none;
      margin: 0;
    }
  }
  .error__subtitle-container {
    float: left;
    margin-bottom: 20px;
  }
  .error__subtitle {
    color: rgba(250, 250, 250, 0.5);
    margin-top: 8px;
  }

  .error__subtitle.-PRIMARY {
    font-size: 46px;
    line-height: 46px;
    text-transform: uppercase;
  }
  .error__subtitle.-SECONDARY {
    font-size: 22px;
    line-height: 22px;
    margin-top: 4px;
  }
  .error__link {
    color: white;
    text-decoration: underline;
  }
  .error__image {
    margin: 1em 0;
    width: 100%;
  }
  .error__text {
    margin-bottom: 1.25rem;
    position: relative;
    z-index: 99;
  }
  .error__link:hover {
    color: rgba(250, 250, 250, 0.8);
  }
  </style>
</head>

<body class="error">

<div class="error__wrapper">
    <div class="error__message">
        <h1 class="error__title">404</h1>

        <div class="error__subtitle-container">
            <div class="error__subtitle -PRIMARY">Uups</div>
            <div class="error__subtitle -SECONDARY">Seite nicht gefunden.</div>
        </div>
    </div>

    <img class="error__image" src="https://cdn.t3n.de/global/images/500er-jump.gif" alt="Team">

    <p class="error__text">
        Die aufgerufene Seite <span id="t3nLocation"></span>existiert nicht oder wurde gelöscht.
    </p>

</div>

<script>
    document.getElementById('t3nLocation').innerHTML = window.location + ' ';
</script>

</body>
</html>
