<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Mappy - Page non trouvée</title>
    <meta
      name="viewport"
      content="width=device-width, minimum-scale=1.0, maximum-scale=1.0, initial-scale=1.0, user-scalable=no"
    />
    <link rel="stylesheet" type="text/css" href="/assets/css/app.4cb435b1313d69124ed2.css" integrity="sha384-lLVYlEdzHAnOVvz8RjspQe4sgapLB9ZyMQ93/LilclvbMQYK9JMzAS0ZmYustJMi" />
    <style type="text/css">
      .link {
        text-decoration: none;
        color: white;
        cursor: default;
        font: 14px 'Fira Sans';
      }
      .logo {
        padding: 20px 0 17px 100px;
        cursor: pointer;
      }

      @media screen and (max-width: 999px) {
        .logo {
          padding: 20px 0 17px;
          text-align: center;
        }
      }
      .bgLinear {
        background: linear-gradient(to bottom, #63ad5b 0, #44a9bb 100%);
      }
      .content {
        background: url('/assets/images/error404.c41bcd1a7594e2d5a70e.png') center no-repeat;
        height: 572px;
        text-align: center;
      }
      @media screen and (max-width: 999px) {
        .content {
          background-position: 30% center;
        }
      }
      .message {
        margin: 0 auto;
        padding-top: 100px;
      }
      h1 {
        display: block;
        margin-bottom: 10px;
        font-size: 44px;
      }
      h2 {
        display: block;
        font-size: 24px;
        margin-bottom: 30px;
      }
      .button {
        display: inline-block;
        padding: 4px 8px;
        height: 24px;
        border-radius: 14px;
        background: white;
        font-weight: 500;
        text-transform: uppercase;
        color: #27a75b;
        font-size: 14px;
        line-height: 18px;
        cursor: pointer;
      }
      .button:hover {
        background: #51d558;
        color: white;
      }
    </style>
  </head>
  <body>
    <a href="/" class="link">
      <div class="logo">
        <img src="/assets/images/logo-mappy.8da17bf4513914e43409.svg" width="145" height="33" />
      </div>
      <div class="bgLinear">
        <div class="content">
          <div class="message">
            <h1>Oooups !</h1>
            <h2>il semble que vous soyez perdu</h2>
            <div class="button">Retour à l'accueil</div>
          </div>
        </div>
      </div>
    </a>
    
    <script async src="https://tag.aticdn.net/509857/smarttag.js"></script>
    <script>
      window.addEventListener('load', () => {
        const tag = new window.ATInternet.Tracker.Tag({
          secure: true,
          cookieDomain: location.hostname.substring(location.hostname.indexOf('.')),
          site: '509857'
        })
        const audienceTracking = localStorage.getItem('trackingOptOut')
        if (audienceTracking === 'optout') {
          tag.privacy?.setVisitorOptout()
        } else if (audienceTracking === 'optin') {
          tag.privacy?.setVisitorOptin()
        } else {
          tag.privacy?.setVisitorMode('cnil', 'exempt')
        }
        setTimeout(function () {
          tag.events.send('page.display', {"tag_version":"V3","page":"Erreur404","site_level2":"5"});
        }, 500);
      }, false)
    </script>

  </body>
</html>
