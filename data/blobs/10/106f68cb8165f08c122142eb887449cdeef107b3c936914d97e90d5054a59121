<script>
document.addEventListener("DOMContentLoaded", function() {
    const form = document.getElementById('wf-form-Book-a-Demo-form');
    
    // Top 50+ Personal/Consumer Email Domains
    const personalDomains = [
        'gmail.com', 'yahoo.com', 'outlook.com', 'hotmail.com', 'icloud.com', 
        'me.com', 'mac.com', 'aol.com', 'mail.com', 'gmx.com', 'yandex.com', 
        'protonmail.com', 'proton.me', 'zoho.com', 'hushmail.com', 'lycos.com', 
        'mail.ru', 'live.com', 'msn.com', 'rocketmail.com', 'verizon.net', 
        'att.net', 'sbcglobal.net', 'comcast.net', 'cox.net', 'charter.net', 
        'bellsouth.net', 'earthlink.net', 'optonline.net', 'roadrunner.com', 
        'rediffmail.com', 'orange.fr', 'wanadoo.fr', 'free.fr', 't-online.de', 
        'web.de', 'gmx.de', 'freenet.de', 'virgilio.it', 'libero.it', 
        'alice.it', 'tin.it', 'uol.com.br', 'bol.com.br', 'terra.com.br', 
        'ig.com.br', 'qq.com', '163.com', '126.com', 'fastmail.com',
        'privaterelay.appleid.com' 
    ];

    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault(); 
            
            var email = document.querySelector('[name="email"]').value.toLowerCase().trim();
            var firstName = document.querySelector('[name="first_name"]').value;
            var lastName = document.querySelector('[name="last_name"]').value;
            var company = document.querySelector('[name="company"]').value;
            
            var domain = email.split('@')[1];
            var isPersonal = personalDomains.includes(domain);

            if (!isPersonal) {
                // *** CASE 1: BUSINESS EMAIL (FULL SUCCESS) ***
                
                // 1. Trigger GTM tracking (High-quality lead)
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push({
                    'event': 'emailVerified',
                    'email': email 
                });
                
                // 2. Send to HubSpot Calendar
                var hubSpotUrl = 'https://meetings.hubspot.com/joeym/7?' +
                                 'email=' + encodeURIComponent(email) +
                                 '&firstname=' + encodeURIComponent(firstName) +
                                 '&lastname=' + encodeURIComponent(lastName) +
                                 '&company=' + encodeURIComponent(company);
                
                window.location.href = hubSpotUrl;

            } else {
                // *** CASE 2: PERSONAL EMAIL (SOFT FAIL) ***
                
                // 1. We skip the GTM 'emailVerified' event to keep your data clean.
                
                // 2. Show a generic success message so they don't try again.
                alert('Thank you! Your request has been submitted. Our team will reach out shortly to schedule your demo.');
                
                // 3. Send them to the homepage instead of the calendar.
                window.location.href = 'https://www.verisoul.ai';
            }
        });
    }
});
</script>




<script>
    document.addEventListener('DOMContentLoaded', function() {
        const body = document.body;
        const menuToggle = document.querySelector('.menu-toggle');
        const menu = document.querySelector('.menu');

        menuToggle.addEventListener('click', function() {
            // Переключение класса для блокировки/разблокировки скролла
            body.classList.toggle('no-scroll');
        });

        // Закрытие меню при клике по фону
        menu.addEventListener('click', function(event) {
            if (event.target === this) {
                body.classList.remove('no-scroll');
            }
        });
    });
</script>


