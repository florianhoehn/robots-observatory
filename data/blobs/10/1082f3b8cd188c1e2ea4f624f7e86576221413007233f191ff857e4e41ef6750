<!DOCTYPE html>
<html>
  <head>
    <meta name="referrer" content="no-referrer-when-downgrade">
    <style>
      body {
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        background-color: #f4f4f4;
        font-family: Arial, sans-serif;
      }
      #captcha_frame {
        background-color: white;
        padding: 2em;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        width: 90%;
        max-width: 500px;
        text-align: center;
      }
      #captcha_frame p {
        text-align: justify;
        line-height: 1.5;
        margin-bottom: 1.5em;
        color: #333;
      }
      #captcha_container {
        display: flex;
        justify-content: center;
        width: 100%;
      }
      .g-recaptcha {
        display: table !important;
        margin-left: auto !important;
        margin-right: auto !important;
      }
    </style>
    <title>Security Verification</title>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script type="text/javascript">
      function captcha_done(grecaptcharesp)
      {
        var captcha_resp_body = "grecaptcharesp=" + grecaptcharesp + "&location=" + encodeURIComponent(document.URL);
        var makereport = new XMLHttpRequest();
        makereport.open("POST", "/.well-known/haproxy/captcha_callback", true);
        makereport.setRequestHeader("Content-type", "application/x-www-form-urlencoded");
        makereport.setRequestHeader("Content-length", captcha_resp_body.length);
        makereport.setRequestHeader("Connection", "close");
        makereport.onreadystatechange = function () {
          if(makereport.readyState == 4 && makereport.status == 200 ) {
            document.cookie = "solved_captcha="+makereport.responseText;
            location.reload();
          }
        }
        makereport.send(captcha_resp_body);
      }
    </script>
  </head>
  <body>
    <div id="captcha_frame">
      <p>To ensure the security of our platform and protect your data, we need to verify you are human before you can continue. Please complete this brief verification challenge, and you will be redirected to your requested destination immediately after. We appreciate your understanding.</p>
      <div class="captcha_container">
        <div class="g-recaptcha" data-sitekey="6LeS4QAtAAAAADywe0iDK2tHZpHsIR-XSTuAM58o" data-callback="captcha_done"></div>
      </div>
    </div>
  </body>
</html>
