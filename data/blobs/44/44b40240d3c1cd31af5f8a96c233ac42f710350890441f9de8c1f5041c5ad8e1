<script>
    const A11y = {
        menu: document.getElementById('a11y-menu'),
        guide: document.getElementById('reading-guide'),
        speechEnabled: false,
        synth: window.speechSynthesis,
        voices: [],

        init: function() {
          
            document.getElementById('a11y-toggle').addEventListener('click', (e) => {
                e.stopPropagation();
                this.menu.classList.toggle('show');
            });

           
            document.addEventListener('click', (e) => {
                if (!this.menu.contains(e.target) && e.target.id !== 'a11y-toggle') {
                    this.menu.classList.remove('show');
                }
            });

            
            this.loadVoices();
            if (window.speechSynthesis.onvoiceschanged !== undefined) {
                window.speechSynthesis.onvoiceschanged = () => this.loadVoices();
            }

            
            document.addEventListener('click', (e) => {
                if (this.speechEnabled && e.target.innerText) {
                    const text = e.target.innerText.trim();
                    if (text && !this.menu.contains(e.target) && e.target.id !== 'a11y-toggle') {
                        e.preventDefault();
                        this.speak(text);
                    }
                }
            });

           
            document.addEventListener('mousemove', (e) => {
                if (this.guide.style.display === 'block') {
                    this.guide.style.top = (e.clientY - 25) + 'px';
                }
            });

            
            this.applySettings();
        },

        loadVoices: function() {
            this.voices = window.speechSynthesis.getVoices();
        },

        applySettings: function() {
            if(localStorage.getItem('a11y_contrast') === 'true') this.toggleContrast(false);
            if(localStorage.getItem('a11y_font') === 'true') this.toggleFont(false);
            if(localStorage.getItem('a11y_links') === 'true') this.toggleLinks(false);
            if(localStorage.getItem('a11y_cursor') === 'true') this.toggleCursor(false);
            if(localStorage.getItem('a11y_guide') === 'true') this.toggleGuide(false);
            if(localStorage.getItem('a11y_images') === 'true') this.toggleImages(false);



        },

       
       toggleContrast: function(save = true) {
    const isActive = document.body.classList.toggle('high-contrast');
    document.getElementById('btn-contrast').classList.toggle('active', isActive);

    const link = document.getElementById('stylesheet-high-contrast');
    if (link) link.disabled = !isActive;

    if (save) localStorage.setItem('a11y_contrast', isActive);
},




        toggleFont: function(save = true) {
            const isActive = document.body.classList.toggle('large-font');
            document.getElementById('btn-font').classList.toggle('active', isActive);
            if(save) localStorage.setItem('a11y_font', isActive);
        },

        toggleLinks: function(save = true) {
            const isActive = document.body.classList.toggle('highlight-links');
            document.getElementById('btn-links').classList.toggle('active', isActive);
            if(save) localStorage.setItem('a11y_links', isActive);
        },

        toggleCursor: function(save = true) {
            const isActive = document.body.classList.toggle('big-cursor');
            document.getElementById('btn-cursor').classList.toggle('active', isActive);
            if(save) localStorage.setItem('a11y_cursor', isActive);
        },

        toggleImages: function(save = true) {
            const isActive = document.body.classList.toggle('hide-images');
            document.getElementById('btn-images').classList.toggle('active', isActive);
            if(save) localStorage.setItem('a11y_images', isActive);
        },

        toggleGuide: function(save = true) {
            const guide = document.getElementById('reading-guide');
            const btn = document.getElementById('btn-guide');
            if (guide.style.display === 'block') {
                guide.style.display = 'none';
                btn.classList.remove('active');
                if(save) localStorage.setItem('a11y_guide', 'false');
            } else {
                guide.style.display = 'block';
                btn.classList.add('active');
                if(save) localStorage.setItem('a11y_guide', 'true');
            }
        },

        toggleSpeech: function() {
            this.speechEnabled = !this.speechEnabled;
            const btn = document.getElementById('btn-speech');
            if (this.speechEnabled) {
                document.body.classList.add('speech-active');
                btn.classList.add('active');
                alert('Sesli okuma aktif. Okumak istediğiniz metne tıklayın.');
            } else {
                document.body.classList.remove('speech-active');
                btn.classList.remove('active');
                this.stopSpeaking();
            }
        },

        speak: function(text) {
            this.stopSpeaking();
            if (!text || text.trim() === '') return;
            const utterance = new SpeechSynthesisUtterance(text);
            const trVoice = this.voices.find(voice => voice.lang.includes('tr') || voice.name.includes('Turkish'));
            if (trVoice) utterance.voice = trVoice;
            else utterance.lang = 'tr-TR';
            utterance.rate = 0.9; 
            this.synth.speak(utterance);
        },

        stopSpeaking: function() {
            if (this.synth.speaking) this.synth.cancel();
        },

        reset: function() {
            document.body.classList.remove('high-contrast', 'large-font', 'highlight-links', 'speech-active', 'big-cursor', 'hide-images');
            document.getElementById('reading-guide').style.display = 'none';
            document.querySelectorAll('.a11y-btn').forEach(btn => btn.classList.remove('active'));
	const link = document.getElementById('stylesheet-high-contrast');
       if (link) link.disabled = true;            


            // LocalStorage Temizle
            ['contrast', 'font', 'links', 'cursor', 'guide', 'images'].forEach(k => localStorage.removeItem('a11y_' + k));
            
            this.speechEnabled = false;
            this.stopSpeaking();
        }
    };

    document.addEventListener('DOMContentLoaded', function() {
        A11y.init();
    });
</script>


