<!DOCTYPE html>
<html>
<head lang="en">
  <meta charset="UTF-8">
  <title>403 Forbidden</title>
  <link href='//fonts.googleapis.com/css?family=Roboto:400,100,300,500,400italic' rel='stylesheet' type='text/css'>
  <style>
    body {
      font-family: Roboto, sans-serif;
      font-weight: 100;
      text-align: center;
      font-size: 20px;
    }
    h1 {
      margin-top: 5em;
      font-weight: 300;
      margin-bottom: 0.4em;
    }
    h2 {
      font-weight: 200;
    }
    p {
      margin-top: 0;
      font-size: 0.9em;
    }
    a {
      color: #333;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <h1>403 Forbidden</h1>
  <h2>Sorry, this page is forbidden.</h2>
  <p><a href="" class="h"></a></p>
  <script type="text/javascript">
    var lnk = document.getElementsByClassName('h');
    if(lnk.length) {
        lnk[0].href = location.protocol + '//' + location.host;
        lnk[0].innerHTML = location.hostname;
    }
  </script>
</body>
</html>

