    function ensureVkLoader(onReady, onError) {
        var state = window.__showjetVkLoaderState;
        if (!state) {
            state = window.__showjetVkLoaderState = { status: "idle", waiters: [] };
        }

        if (state.status === "ready") {
            onReady();
            return;
        }

        if (state.status === "error") {
            if (typeof onError === "function") onError();
            return;
        }

        state.waiters.push({ onReady: onReady, onError: onError });

        if (state.status === "loading") return;
        state.status = "loading";

        function flush(ok) {
            state.status = ok ? "ready" : "error";
            var waiters = state.waiters.splice(0, state.waiters.length);
            for (var i = 0; i < waiters.length; i++) {
                if (ok) waiters[i].onReady();
                else if (typeof waiters[i].onError === "function") waiters[i].onError();
            }
        }

        var existing = document.querySelector('script[src="' + VK_LOADER_SRC + '"]');
        if (existing) {
            setTimeout(function () { flush(true); }, 0);
            return;
        }

        var s = document.createElement("script");
        s.src = VK_LOADER_SRC;
        s.async = true;
        s.onload = function () { flush(true); };
        s.onerror = function () { flush(false); };
        document.head.appendChild(s);
    }

