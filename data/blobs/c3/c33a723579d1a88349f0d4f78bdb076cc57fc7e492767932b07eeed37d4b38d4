@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600&display=swap');

.sio-header, .sio-header * { box-sizing: border-box; font-family: 'Outfit', sans-serif; }
.sio-header {
  background: transparent;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 19;
  width: 100%;
  text-align: left;
}
.sio-header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 18px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
}
.sio-logo {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
  flex-shrink: 0;
}
.sio-logo svg { display: block; }
.sio-nav {
  display: flex;
  align-items: center;
  gap: 40px;
  flex: 1;
  justify-content: center;
  text-align: left;
}
.sio-nav-item { position: relative; }
.sio-nav-link {
  font-size: 17px;
  line-height: 27px;
  font-weight: 500;
  color: #181C39;
  text-decoration: none;
  padding: 8px 0;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color 0.15s ease;
  cursor: pointer;
  background: none;
  border: none;
}
.sio-nav-link:hover { color: rgba(24, 28, 57, 0.7); }
.sio-caret {
  width: 10px;
  height: 6px;
  transition: transform 0.2s ease;
}
.sio-nav-item:hover .sio-caret { transform: rotate(180deg); }
.sio-dropdown {
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 12px 32px rgba(24, 28, 57, 0.12);
  padding: 8px;
  min-width: 200px;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  text-align: left;
}
.sio-nav-item:hover .sio-dropdown,
.sio-nav-item:focus-within .sio-dropdown {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0);
}
.sio-dropdown a {
  display: block;
  padding: 10px 14px;
  font-size: 15px;
  font-weight: 500;
  color: #181C39;
  text-decoration: none;
  border-radius: 8px;
  transition: background 0.15s ease, color 0.15s ease;
}
.sio-dropdown a:hover { background: #F6F6F9; color: rgba(24, 28, 57, 0.7); }
.sio-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.sio-signin {
  font-size: 17px;
  line-height: 27px;
  font-weight: 500;
  color: #181C39;
  text-decoration: none;
}
.sio-signin:hover { color: rgba(24, 28, 57, 0.7); }
.sio-cta-btn {
  background: #00A0FF;
  color: #FFFFFF;
  font-size: 17px;
  line-height: 27px;
  font-weight: 500;
  padding: 12px 24px;
  border-radius: 8px;
  text-decoration: none;
  display: inline-block;
  transition: background 0.15s ease;
}
.sio-cta-btn:hover { background: rgb(0, 180, 255); }
.sio-burger {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
}
.sio-mobile-menu {
  display: none;
  background: #FFFFFF;
  border-top: 1px solid #EEF0F4;
  padding: 16px 24px 24px;
  text-align: left;
}
.sio-mobile-menu a {
  display: block;
  padding: 12px 0;
  font-size: 16px;
  font-weight: 500;
  color: #181C39;
  text-decoration: none;
  text-align: left;
  border-bottom: 1px solid #F1F2F6;
}
.sio-mobile-menu .sio-cta-btn { display: inline-block; width: 100%; text-align: center; margin-top: 16px; border-bottom: none; }
.sio-header.sio-open .sio-mobile-menu { display: block; }

@media (max-width: 1024px) {
  .sio-nav { display: none; }
  .sio-signin { display: none; }
  .sio-burger { display: inline-flex; }
}
@media (max-width: 640px) {
  .sio-header-inner { padding: 14px 16px; }
  .sio-cta-btn { padding: 10px 16px; font-size: 14px; }
}
