    $(this).hide();
    $(".share #copied-text").show();
  });

  function GetQueryString(name) {
    var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
    var r = window.location.search.substr(1).match(reg);
    var context = "";
    if (r != null) context = r[2];
    reg = null;
    r = null;
    return context == null || context == "" || context == "undefined"
      ? ""
      : context;
  }

  function diversion_log(Position, Event, Domain) {
    $.ajax({
      url: "/api/v2/log/diversion_log",
      method: "post",
      dataType: "json",
      data: {
        AppSource: "cp_seo_diversion-web",
        DiversionType: "app",
        Shape: "page",
        Uri: window.location.href,
        Position: Position,
        Event: Event,
        Domain: Domain,
      },
      success: function (data) {},
    });
  }

  function impr() {
    let domain = GetQueryString("utm_domain");
    domain = domain ? domain : "";
    ga(
      "send",
      "event",
      "impr",
      "app_footer-impr",
      `/app/page/footer/impr/${domain}`,
      1,
      { nonInteraction: 1 }
    );
    diversion_log("footer", "impr", domain, "page");
  }

  $(".svg_bian1").click(function () {
    let domain = GetQueryString("utm_domain");
    domain = domain ? domain : "";
    ga(
      "send",
      "event",
      "click-app",
      "app_footer-click",
      `/app/page/footer/click-app/${domain}`,
      1,
      { nonInteraction: 1 }
    );
    diversion_log("footer", "click-app", domain, "page");
  });

  impr();

  if (window.location.pathname == "/mobile") {
    $(".get_titel").hide();
    $(".Img_erweiphoto").hide();
    $(".lang_wrap").show();
  } else {
    $(".get_titel").show();
    $(".Img_erweiphoto").show();
    $(".lang_wrap").hide();
  }
  function set_cookie(name, value, day = 30) {
    var exp = new Date();
    exp.setTime(exp.getTime() + day * 24 * 60 * 60 * 1000);
    document.cookie =
      name + "=" + value + ";expires=" + exp.toGMTString() + ";path=/";
  }
  function switchLanguage(lang) {
    set_cookie("_LANG", escape(lang));
    window.scrollTo(0, -1);
    window.location.reload();
  }

  function getCountry(lang) {
    let RES_VERSION = $("#RES_VERSION").val();
    $(".lang_country").css(
      "background",
      `url(https://www.coupert.com/img/language-${$.cookie(
        "_LANG"
      )}.png?v=${RES_VERSION}) no-repeat center /cover`
    );
  }
  getCountry();
  $(".lang_box").on("click", function (e) {
    if ($(".language_list").css("display") == "none") {
      $(".language_list").show();
    } else {
      $(".language_list").hide();
    }
  });
</script>

