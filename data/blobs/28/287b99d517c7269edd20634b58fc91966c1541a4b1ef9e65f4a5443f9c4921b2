(function() {
    var PIANO_SRC = "https://experience-ap.piano.io/xbuilder/experience/load?aid=7CIQrKHYpj";

    var STORAGE_KEY      = "piano_auth";
    var EXP_BUFFER_SEC   = 60;
    var FETCH_TIMEOUT_MS = 10000;

    function getCookie(name) {
        var matches = document.cookie.match(new RegExp(
            "(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"
        ));

        return matches ? decodeURIComponent(matches[1]) : undefined;
    }

    function loadPianoTag(jwt) {
        if (jwt) {
            tp = window["tp"] || [];

            tp.push(["setExternalJWT", jwt]);
            tp.push(["init", function () {
               tp.pianoId.updateLang('ja_JP');
               tp.pianoId.init()
            }]);
        }

        var a = document.createElement("script");
        a.type = "text/javascript";
        a.async = true;
        a.src = PIANO_SRC;
        var b = document.getElementsByTagName("script")[0];
        b.parentNode.insertBefore(a, b);

    }

    if (getCookie('is_logged_in') !== '1') {
        loadPianoTag(null);
        return;
    }

    var piano_uid = getCookie('piano_uid');

    var stored = null;
    try {
        stored = JSON.parse(sessionStorage.getItem(STORAGE_KEY));
    } catch (e) {
        stored = null;
    }

    var now_sec = Math.floor(Date.now() / 1000);

    if (stored && stored.token && stored.exp && stored.sub &&
        stored.exp > now_sec + EXP_BUFFER_SEC &&
        stored.sub === piano_uid) {
        loadPianoTag(stored.token);
        return;
    }

    try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) {}

    if (typeof window.fetch !== 'function') {
        loadPianoTag(null);
        return;
    }

    var controller = (typeof AbortController !== 'undefined') ? new AbortController() : null;
    if (controller) {
        setTimeout(function() { controller.abort(); }, FETCH_TIMEOUT_MS);
    }

    fetch('/api/piano-token/', {
        method: 'GET',
        credentials: 'same-origin',
        cache: 'no-store',
        signal: controller ? controller.signal : undefined
    }).then(function(res) {
        if (!res.ok) {
            return null;
        }
        return res.json();
    }).then(function(data) {
        if (data && data.token && data.exp && data.sub) {
            try {
                sessionStorage.setItem(STORAGE_KEY, JSON.stringify({
                    token: data.token,
                    exp:   data.exp,
                    sub:   data.sub
                }));
            } catch (e) {}

            loadPianoTag(data.token);
        } else {
            loadPianoTag(null);
        }
    }).catch(function() {
        loadPianoTag(null);
    });
})();
