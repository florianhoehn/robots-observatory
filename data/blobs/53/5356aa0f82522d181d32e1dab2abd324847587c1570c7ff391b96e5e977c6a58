      link.style.display = "unset"
    }
}
var updateLinks = (privacyManagerId) => {
  var $links = document.querySelectorAll("a.politico-sourcepoint-link")
  for (var link of $links) {
    link.setAttribute("href", "javascript:window._sp_.usnat.loadPrivacyManagerModal("+ privacyManagerId +")")
  }
}
var waitForPrivacyLinks = (callback, params) => {
  var stopped = false
  function stopChecking() {
    stopped = true
  }
  var timer = setTimeout(stopChecking, 10000)
  function step() {
    var $links = document.querySelectorAll("a.politico-sourcepoint-link")
    if ($links != null && $links.length != 0) {
      clearTimeout(timer)
      callback(params)
    } else {
      if (!stopped) {
        window.requestAnimationFrame(step)
      }
    }
  }

  window.requestAnimationFrame(step)
}
var waitForDOM = (callback, params) => {
  if (document.readyState !== 'loading') {
    callback(params);
  } else {
    document.addEventListener('DOMContentLoaded', (event) => { callback(params) })
  }
}
var waitForElement = (selector, time, function_to_run, params, max_runs, this_run) => {
    var requestAnimationFrame = window.requestAnimationFrame || window.mozRequestAnimationFrame || window.webkitRequestAnimationFrame || window.msRequestAnimationFrame
    if (typeof max_runs === 'undefined') {
        max_runs = performance.now() + time * 10
    }
    if (typeof this_run === 'undefined') {
        this_run = performance.now()
    }
    if (max_runs < this_run) {
        return
    }
    if (document.querySelectorAll(selector).length > 0) {
        function_to_run(params)
        return
    } else {
        requestAnimationFrame(function() {
            waitForElement(selector, time, function_to_run, params, max_runs)
        }, time)
    }
}
