<script>
/* Tagger data-source-box của A/B "Search vs RCM" (đã gỡ).
   Thí nghiệm đó đổi CẢ search lẫn RCM (nhánh B = Elastic + RCM V1) nên gắn hậu
   tố lên mọi data-source-box là đúng. A/B đang chạy bây giờ là Vertex-vs-Typesense,
   CHỈ đổi search — gắn nhãn lên box RCM sẽ đẻ ra tracking_value rác kiểu
   'also-like--v', 'bought-together--v' và cắt đôi thống kê RCM vô cớ.
   Vì vậy nguồn hậu tố ở đây để rỗng; nhãn nhánh search giờ dán ở server, trong
   ZSearch HomeController::decorSearchItems(), theo engine đã thực sự phục vụ.
   window.__AB_SUFFIX vẫn giữ vì Cart/make-change.js còn đọc.
   Toàn bộ bọc try/catch + guard từng thao tác -> KHÔNG BAO GIỜ throw. */
(function () {
    try {
        try {
            window.__AB_SUFFIX = "";
        } catch (e) { return; }

        var sfx = window.__AB_SUFFIX;
        if (!sfx || typeof sfx !== 'string') return;   // '' khi tắt A/B -> không đụng gì

        function tag(el) {
            try {
                if (!el || typeof el.getAttribute !== 'function') return;
                var v = el.getAttribute('data-source-box');
                if (v && v.slice(-sfx.length) !== sfx && typeof el.setAttribute === 'function') {
                    el.setAttribute('data-source-box', v + sfx);
                }
            } catch (e) {}
        }
        function sweep(root) {
            try {
                if (root && typeof root.querySelectorAll === 'function') {
                    var nodes = root.querySelectorAll('[data-source-box]');
                    for (var i = 0; i < nodes.length; i++) tag(nodes[i]);
                }
            } catch (e) {}
        }

        try {
            if (document && typeof document.addEventListener === 'function') {
                document.addEventListener('DOMContentLoaded', function () { sweep(document); });
            }
        } catch (e) {}

        // RCM box render bất đồng bộ + item.blade.php set data-source-box động.
        try {
            if (typeof MutationObserver === 'function' && document && document.documentElement) {
                var mo = new MutationObserver(function (muts) {
                    try {
                        for (var i = 0; i < muts.length; i++) {
                            var m = muts[i];
                            if (m.type === 'attributes' && m.target && typeof m.target.hasAttribute === 'function'
                                && m.target.hasAttribute('data-source-box')) {
                                tag(m.target);
                            }
                            if (m.addedNodes) {
                                for (var j = 0; j < m.addedNodes.length; j++) {
                                    var n = m.addedNodes[j];
                                    if (n && n.nodeType === 1) {
                                        if (typeof n.hasAttribute === 'function' && n.hasAttribute('data-source-box')) tag(n);
                                        sweep(n);
                                    }
                                }
                            }
                        }
                    } catch (e) {}
                });
                mo.observe(document.documentElement, {
                    childList: true, subtree: true, attributes: true, attributeFilter: ['data-source-box']
                });
            }
        } catch (e) {}
    } catch (e) {}
})();
