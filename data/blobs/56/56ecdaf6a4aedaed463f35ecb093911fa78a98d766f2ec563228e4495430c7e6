	ignorableFileExtensions.push('.gif');
	ignorableFileExtensions.push('.png');
	ignorableFileExtensions.push('.jpg');
	ignorableFileExtensions.push('.js');
	
	var address = window.location.href;
	var shouldRedirect = true;
	
	for (var i = 0; i < ignorableFileExtensions.length; i++) {
		if(address.endsWith(ignorableFileExtensions[i])) {
			shouldRedirect = false;
			break;
		}
	}
	if(shouldRedirect) {
		window.location = "/portalfront/error/redirect_tekniskfeil.php";
	}
	</script>
	
