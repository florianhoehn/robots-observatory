        <script>
            // Clicks from our Mailchimp sends arrive with ?nl=<newsletter slug>. Remembering
            // those slugs lets us stop pitching newsletters a reader already gets. This runs
            // in <head> and injects its own rule so a promo never renders and then vanishes.
            (function () {
                var STORE_KEY = "sr_newsletter_clicks";
                var MAX_AGE_MS = 90 * 24 * 60 * 60 * 1000;
                // Guards the CSS below: `nl` is attacker-controlled URL input.
                var SAFE_SLUG = /^[a-z0-9][a-z0-9_-]{0,63}$/;

                function stored() {
                    try {
                        var raw = window.localStorage.getItem(STORE_KEY);
                        if (!raw) { return []; }
                        var record = JSON.parse(raw);
                        if (!record || record.v !== 1 || !Array.isArray(record.slugs)) { return []; }
                        if (Date.now() - record.ts > MAX_AGE_MS) {
                            window.localStorage.removeItem(STORE_KEY);
                            return [];
                        }
                        return record.slugs.filter(function (slug) { return SAFE_SLUG.test(slug); });
                    } catch (err) {
                        return [];
                    }
                }

                var slugs = stored();
                var arrived = new URLSearchParams(window.location.search).get("nl");

                if (arrived && SAFE_SLUG.test(arrived)) {
                    if (slugs.indexOf(arrived) === -1) { slugs.push(arrived); }
                    try {
                        window.localStorage.setItem(STORE_KEY, JSON.stringify({
                            v: 1, ts: Date.now(), slugs: slugs
                        }));
                    } catch (err) {
                        // Private mode or quota exceeded; gating still holds for this pageview.
                    }
                }

                // Exposed for a Naviga Engage JSVar segment, which cannot read storage itself.
                window.SR_NEWSLETTER_CLICKS = slugs;

                if (slugs.length) {
                    var style = document.createElement("style");
                    style.appendChild(document.createTextNode(slugs.map(function (slug) {
                        var target = '[data-newsletter-promo="' + slug + '"]';
                        return target + ",aside:has(>" + target + "){display:none!important}";
                    }).join("")));
                    document.head.appendChild(style);
                }
            }());
        </script>

        
