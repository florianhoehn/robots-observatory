        rel="stylesheet"
      />
      <title>Maxon 404 Page</title>
      <style>
        * {
          box-sizing: border-box;
        }
  
        body {
          display: block;
          position: relative;
          margin: 0;
          padding: 0;
          overflow-x: hidden;
        }
  
        /* --- HEADER --- */
        header {
          width: 100%;
          height: 5rem;
          display: flex;
          align-items: center;
          position: relative;
          background-color: #000;
          z-index: 50;
        }
  
        .logo-section {
          flex-grow: 1;
          width: 100%;
        }
  
        .logo-link {
          display: flex;
          flex-direction: row;
          align-items: center;
        }
  
        .maxon-logo {
          width: 2.5rem;
          margin-right: 1.25rem;
          margin-left: 2.5rem;
        }
  
        .branding-text {
          display: flex;
          flex-direction: column;
          align-items: end;
        }
  
        .logo-type {
          margin-bottom: 0.5rem;
          transform: translateY(-50%);
          transition-timing-function: ease-in-out, cubic-bezier(0.4, 0, 0.2, 1);
          transition-duration: 0.7s;
          transition-delay: 0.3s;
          opacity: 0;
        }
  
        .logo-tagline {
          margin-top: -1px;
          transition-timing-function: ease-in-out, cubic-bezier(0.4, 0, 0.2, 1);
          transition-duration: 0.7s;
          transition-delay: 0.3s;
          opacity: 0;
        }
  
        .logo-link:hover,
        .logo-link:focus-visible,
        .initial-display {
          .logo-text {
            transform: translateY(0);
          }
  
          .logo-type {
            opacity: 1;
          }
          .logo-tagline {
            opacity: 0.8;
          }
        }
  
        /* --- TOP NAV --- */
        .dropdown {
          position: relative;
          display: inline-block;
          top: 10px;
        }
  
        .dropdown-arrow {
          opacity: 0;
        }
  
        .show-arrow {
          opacity: 1;
          position: relative;
          left: 5%;
          transform: translate(-50%, -50%);
          height: 0.5rem;
          width: 0.5rem;
        }
  
        .prod-drop-btn {
          background-color: #000;
          border: none;
          cursor: pointer;
          font-family: Rajdhani, Helvetica, Arial, sans-serif;
          font-weight: 700;
          font-size: 1rem;
          letter-spacing: 0.025rem;
          color: #fff;
          text-decoration: none;
          text-transform: uppercase;
        }
  
        .top-nav {
          flex-grow: 1;
        }
  
        .dropdown-content {
          display: none;
          position: absolute;
          z-index: 1;
          list-style: none;
          background-color: #fff;
          padding: 0.5rem 1rem;
          text-transform: uppercase;
          border-bottom-style: solid 1px;
          border-bottom-left-radius: 0.375rem;
          border-bottom-right-radius: 0.375rem;
          box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1),
            0 2px 4px -2px rgb(0 0 0 / 0.1);
        }
  
        .dropdown-content > .top-nav-item > a {
          color: #1c232b;
          text-decoration: none;
          display: block;
          min-width: 13.1rem;
          font-family: Rajdhani, Helvetica, Arial, sans-serif;
          font-size: 1rem;
          letter-spacing: 0.025rem;
          line-height: 1.5rem;
          font-weight: 500;
        }
  
        .dropdown-content > .top-nav-item > a:hover {
          background-color: #eaedf0;
        }
  
        .nav-divider {
          border-color: #1c232b;
          border-bottom-style: solid;
          border-bottom-width: 1px;
          width: 100%;
          display: block;
          margin: 0.5rem auto;
        }
  
        .show {
          display: block;
          position: absolute;
          margin: 0;
          top: 3.22rem;
          right: -166px;
          width: 100vw;
        }
  
        .spacer {
          flex-grow: 1;
          width: 100%;
        }
  
        /* --- CONTENT --- */
        .error {
          display: flex;
          position: relative;
          flex-direction: column;
          align-items: flex-start;
          justify-content: flex-start;
          padding-top: 5rem;
          overflow-y: hidden;
        }
  
        .container {
          width: 100%;
          margin-left: auto;
          margin-right: auto;
        }
  
        .content {
          font-family: Rajdhani, Helvetica, Arial, sans-serif;
          margin-left: auto;
          margin-right: auto;
          background-color: #eaedf0;
          padding: 2rem;
          text-align: center;
          border-radius: 0.5rem;
        }
  
        .column {
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          padding: 0;
          width: 100%;
        }
  
        .error-heading {
          font-size: 1rem;
          line-height: 1;
          font-weight: 700;
        }
  
        .error-message {
          font-size: 1rem;
          font-weight: 300;
        }
  
        .error-message a {
          font-size: 1.125rem;
          font-weight: 700;
          color: #007aff;
        }
  
        .error-img {
          display: block;
          height: auto;
          width: 25rem;
          padding-bottom: 62px;
        }
  
        /* --- FOOTER --- */
        footer {
          width: 100%;
          padding: 1.5rem;
          position: absolute;
          background: #000;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          gap: 10px;
        }
  
        .footer-container {
          display: flex;
          justify-content: center;
        }
  
        .footer-nav-items {
          list-style-type: none;
          margin: 0;
          padding-left: 0;
        }
  
        .nav-item {
          padding-top: 0.5rem;
          padding-bottom: 0.5rem;
          text-align: center;
        }
  
        .nav-item > a {
          font-family: Rajdhani, Helvetica, Arial, sans-serif;
          font-weight: 700;
          font-size: 0.85rem;
          color: #fff;
          text-decoration: none;
          text-transform: uppercase;
        }
  
        .copyright-text {
          font-family: Roboto, Helvetica, Arial, sans-serif;
          font-size: 8px;
          color: #cdd5df;
          letter-spacing: 0.025rem;
          line-height: 2;
          text-transform: uppercase;
          text-align: center;
          margin-top: 0.5rem;
          margin-bottom: 0;
        }
  
        /* --- MEDIA QUERIES --- */
  
        @media (min-width: 720px) {
          .show-arrow {
            transform: translate(-50%);
          }
          .error-heading {
            font-size: 2rem;
          }
  
          .error-message {
            font-size: 1.125rem;
          }
  
          .error-img {
            height: auto;
            width: 55rem;
            padding-bottom: 0;
          }
  
          .show {
            position: absolute;
            left: -35px;
            top: 3.22rem;
            width: 16rem;
          }
  
          footer {
            padding-top: 2.5rem;
            padding-bottom: 2.5rem;
          }
  
          .nav-item {
            padding: 0 0.55rem;
            display: inline-block;
          }
  
          .nav-item > a {
            font-size: 0.875rem;
            letter-spacing: 0.025rem;
            font-weight: 600;
          }
        }
        @media (min-width: 960px) {
          .logo-type {
            height: auto;
            width: 120px;
          }
  
          .maxon-logo {
            width: 40px;
          }
          .logo-tagline {
            width: 80px;
            height: 4px;
            margin-right: -1px;
          }
  
          nav {
            display: flex;
          }
  
          .error {
            padding-left: 0;
            padding-right: 0;
          }
        }
        @media (min-width: 1500px) {
          .column {
            padding: 0 18rem;
          }
        }
      </style>
