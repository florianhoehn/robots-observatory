    <script>

(function () {

    window.addEventListener('load', function () {

        setTimeout(function () {

            const hasUserCookie =
                document.cookie.includes('user=');

            const hasRefreshToken =
                document.cookie.includes('refreshToken=');

            const alreadyReloaded =
                sessionStorage.getItem('auth_reload_done');

            const loginButtons =
                document.getElementById('login-buttons');

            const userMenu =
                document.getElementById('user-menu-container');

            const isVisuallyLoggedOut =
                loginButtons &&
                !loginButtons.classList.contains('hidden');

            const isVisuallyLoggedIn =
                userMenu &&
                !userMenu.classList.contains('hidden');

            const hasAuthCookie =
                hasUserCookie || hasRefreshToken;

          /*console.log({
                hasAuthCookie,
                isVisuallyLoggedOut,
                isVisuallyLoggedIn,
                alreadyReloaded
                });*/

            if (
                hasAuthCookie &&
                isVisuallyLoggedOut &&
                !alreadyReloaded
            ) {

                sessionStorage.setItem(
                    'auth_reload_done',
                    'true'
                );

                window.location.reload();

                return;
            }

            if (isVisuallyLoggedIn) {

                sessionStorage.removeItem(
                    'auth_reload_done'
                );
            }

        }, 300);

    });

})();


</script>

