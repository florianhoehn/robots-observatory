    <script>
        const structuredDataElement = document.getElementById('structuredGraph');

        function parseSameAs(value) {
            if (!value) {
                return [];
            }

            const normalized = value.trim();
            try {
                const parsed = JSON.parse(normalized);
                return Array.isArray(parsed) ? parsed.filter(Boolean) : [];
            } catch (e) {
                return normalized
                    .split(',')
                    .map(function (item) {
                        return item.trim().replace(/^"|"$/g, '');
                    })
                    .filter(Boolean);
            }
        }

        function sanitizeSiteUrl(url) {
            if (!url) {
                return '';
            }

            return url.trim();
        }

        function normalizeSiteUrlForIds(url) {
            const sanitized = sanitizeSiteUrl(url);
            if (!sanitized) {
                return '';
            }

            return sanitized.endsWith('/') ? sanitized : sanitized + '/';
        }

        function toBaseUrl(url) {
            const normalized = normalizeSiteUrlForIds(url);
            return normalized ? normalized.replace(/\/$/, '') : '';
        }

        const data = structuredDataElement.dataset;
        const siteUrl = sanitizeSiteUrl(data.url);
        const baseUrl = toBaseUrl(siteUrl);
        const websiteId = baseUrl ? baseUrl + '/#website' : undefined;
        const organizationId = baseUrl ? baseUrl + '/#organization' : undefined;
        const logoId = baseUrl ? baseUrl + '/#logo' : undefined;
        const sameAs = parseSameAs(data.sameas);

        const websiteNode = {
            "@type": "WebSite",
            "@id": websiteId,
            "url": siteUrl,
            "name": data.name
        };

        if (data.alternatename) {
            websiteNode.alternateName = data.alternatename;
        }

        if (data.websitedescription) {
            websiteNode.description = data.websitedescription;
        }

        websiteNode.inLanguage = data.language || 'es-AR';
        websiteNode.isAccessibleForFree = true;

        if (organizationId) {
            websiteNode.publisher = {
                "@id": organizationId
            };
        }

        if (data.target) {
            const urlTemplate = data.target.indexOf('{search_term_string}') > -1
                ? data.target
                : data.target + '?q={search_term_string}';

            websiteNode.potentialAction = {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": urlTemplate
                },
                "query-input": "required name=search_term_string"
            };
        }

        const graphNodes = [websiteNode];

        if (organizationId || data.name || siteUrl) {
            const organizationNode = {
                "@type": "Organization",
                "@id": organizationId,
                "name": data.name,
                "url": siteUrl
            };

            if (data.email) {
                organizationNode.email = data.email;
            }

            if (data.organizationdescription) {
                organizationNode.description = data.organizationdescription;
            }

            if (data.phone) {
                organizationNode.contactPoint = {
                    "@type": "ContactPoint",
                    "telephone": data.phone,
                    "contactType": "General"
                };
            }

            if (sameAs.length) {
                organizationNode.sameAs = sameAs;
            }

            if (data.logo && logoId) {
                organizationNode.logo = {
                    "@id": logoId
                };
            }

            graphNodes.push(organizationNode);
        }

        if (data.logo && logoId) {
            const logoNode = {
                "@type": "ImageObject",
                "@id": logoId,
                "url": data.logo,
                "contentUrl": data.logo
            };

            graphNodes.push(logoNode);
        }

        const structuredGraph = {
            "@context": "https://schema.org",
            "@graph": graphNodes
        };

        const structuredGraphScript = document.createElement('script');
        structuredGraphScript.type = 'application/ld+json';
        structuredGraphScript.text = JSON.stringify(structuredGraph);
        document.head.appendChild(structuredGraphScript);
    </script>
