<style>
/* Размытие превью на плитке без модалки верификации */
body.age-gate-active .age-gate-page .i_img img:not(.no-blur) {
    -webkit-filter: blur(18px);
    filter: blur(18px);
}
body.age-gate-active .age-gate-page .i_img img.no-blur {
    -webkit-filter: none;
    filter: none;
}
/* Без верификации трейлеры на плитке не показываем */
body.age-gate-active .age-gate-page .i_img .preview {
    display: none;
}
body.age-gate-active .age-gate-page .i_img video.trailer {
    display: none !important;
}
/* JW: неверифицированный — блюр превью и video в любом состоянии (верифицированный без age-gate-active) */
body.age-gate-active .age-gate-page #player_box .jw-preview:not(.no-blur),
body.age-gate-active .age-gate-page #player_box .jw-media video:not(.no-blur) {
    -webkit-filter: blur(18px);
    filter: blur(18px);
}
body.age-gate-active .age-gate-page #player_box .jw-preview.no-blur,
body.age-gate-active .age-gate-page #player_box .jw-media video.no-blur {
    -webkit-filter: none;
    filter: none;
}
/* Открыт play-gate верификации на watch: без скролла страницы */
html.age-verify-play-gate-open,
body.age-verify-play-gate-open {
    overflow: hidden;
    overscroll-behavior: none;
}
/*
 * Ширина скроллбара задаётся в JS: --age-verify-scrollbar-gap на :root (до overflow:hidden).
 * body — поток; .header и нижняя плашка — position:fixed (right, не padding, чтобы не ломать box-model).
 */
body.age-verify-play-gate-open {
    padding-right: var(--age-verify-scrollbar-gap, 0px);
}
body.age-verify-play-gate-open .header {
    right: var(--age-verify-scrollbar-gap, 0px);
}
body.age-verify-play-gate-open .age-verify-bottom-bar {
    right: var(--age-verify-scrollbar-gap, 0px);
}
/* Нижняя плашка верификации (не на watch — там play-gate) */
body.age-gate-active {
    padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
}
.age-verify-bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 999999999998;
    box-sizing: border-box;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
    background: #000;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, Helvetica, sans-serif;
    border-top: 1px solid #222;
}
.age-verify-bottom-bar__inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px 36px;
    flex-wrap: wrap;
}
.age-verify-bottom-bar__msg {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}
.age-verify-bottom-bar__shield {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: block;
}
.age-verify-bottom-bar__text {
    margin: 0;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.35;
}
.age-verify-bottom-bar__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
}
.age-verify-bottom-bar__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 22px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    background: #e50914;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    text-align: center;
    text-decoration: none;
    box-sizing: border-box;
    font-family: inherit;
    white-space: nowrap;
    box-shadow:
        0 3px 14px rgba(229, 9, 20, 0.45),
        0 0 22px rgba(229, 9, 20, 0.3);
    transition: background 0.2s ease, box-shadow 0.2s ease;
}
.age-verify-bottom-bar__btn:hover:not(:disabled) {
    background: #ff1522;
    box-shadow:
        0 5px 20px rgba(229, 9, 20, 0.55),
        0 0 30px rgba(255, 45, 55, 0.4);
}
.age-verify-bottom-bar__btn:disabled {
    background: #555;
    cursor: not-allowed;
    box-shadow: none;
}
.age-verify-bottom-bar__btn--muted {
    background: #3a3a3a;
    font-size: 14px;
    padding: 0 14px;
    min-height: 36px;
    border-radius: 12px;
    box-shadow: none;
}
.age-verify-bottom-bar__btn--muted:hover {
    background: #222;
    color: #fff;
}
.age-verify-bottom-bar__denied {
    margin: 0;
    color: #ffb4b4;
    font-size: 14px;
}
.age-verify-bottom-bar__easy {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
}
.age-verify-bottom-bar__check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    color: #fff;
    font-size: 13px;
    cursor: pointer;
    white-space: nowrap;
}
.age-verify-bottom-bar__check input {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}
.age-verify-bottom-bar__btn.button_disable {
    box-shadow: none;
    opacity: 0.45;
    pointer-events: none;
}
@media (max-width: 600px) {
    body.age-gate-active {
        padding-bottom: calc(128px + env(safe-area-inset-bottom, 0px));
    }
    .age-verify-bottom-bar__inner {
        flex-direction: column;
        align-items: center;
        gap: 12px;
        width: 100%;
        text-align: center;
    }
    .age-verify-bottom-bar__msg {
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        max-width: 320px;
        padding: 0 8px;
        box-sizing: border-box;
    }
    .age-verify-bottom-bar__text {
        width: 100%;
        text-align: center;
    }
    .age-verify-bottom-bar__actions {
        width: 100%;
        max-width: 280px;
        justify-content: center;
    }
    .age-verify-bottom-bar__btn {
        width: 100%;
        max-width: 280px;
    }
    .age-verify-bottom-bar__easy {
        width: 100%;
        flex-direction: column;
        align-items: center;
    }
}
/* watch: play-gate поверх плеера по клику на play; нижняя плашка как на десктопе */
@media (max-width: 768px) {
    body.page-watch .player_wrap {
        position: relative;
    }
    body.page-watch #age-verify-play-gate:not([hidden]) {
        position: absolute;
        inset: 0;
        z-index: 20;
    }
    body.page-watch #age-verify-play-gate .age-verify-backdrop {
        position: absolute;
        inset: 0;
        z-index: 1;
        padding: 12px 10px;
    }
    body.page-watch.age-verify-play-gate-open,
    html:has(body.page-watch.age-verify-play-gate-open) {
        overflow: auto;
        overscroll-behavior: auto;
    }
    body.page-watch #age-verify-play-gate .age-verify-minimal {
        max-width: 100%;
        padding: 22px 32px 20px 20px;
    }
    body.page-watch #age-verify-play-gate .age-verify-minimal__text {
        font-size: 15px;
        margin-bottom: 16px;
    }
}
@media (min-width: 769px) {
    body.page-watch .player_wrap {
        position: relative;
    }
    body.page-watch #age-verify-play-gate:not([hidden]) {
        position: absolute;
        inset: 0;
        z-index: 20;
        pointer-events: none;
    }
    body.page-watch #age-verify-play-gate .age-verify-backdrop {
        position: fixed;
        inset: 0;
        pointer-events: auto;
    }
}
