<!doctype html>

<html lang="en">
  <head>
    <title>The page you were looking for doesn't exist (404)</title>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">

    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        font-size: 16px;
      }

      body {
        margin: 0;
        background-color: #fff;
        color: #666;
        font-family: Arial, Helvetica, sans-serif;
        text-align: center;
      }

      a {
        color: #c1320b;
        text-decoration: none;
        border-bottom: 1px dotted #999;
      }

      a:visited {
        color: #c1320b;
      }

      a:hover,
      a:focus {
        color: #000;
        border-bottom-color: #000;
        border-bottom-style: solid;
      }

      .page {
        width: min(100% - 32px, 900px);
        margin: 24px auto 0;
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 10px 28px;
        padding: 16px;
        border-top: 1px dotted #999;
        border-bottom: 1px dotted #999;
        font-size: 1rem;
      }

      .dialog {
        padding: 52px 16px 32px;
      }

      h1 {
        margin: 0;
        color: #c1320b;
        font-size: clamp(1.25rem, 3vw, 1.75rem);
        line-height: 1.4;
      }

      .message {
        margin: 22px 0 0;
        font-size: clamp(1.1rem, 2.5vw, 1.5rem);
        line-height: 1.4;
      }

      .logo {
        display: block;
        width: 100%;
        max-width: 800px;
        height: auto;
        margin: 90px auto 0;
      }

      @media (max-width: 600px) {
        .page {
          width: min(100% - 24px, 900px);
          margin-top: 12px;
        }

        .links {
          gap: 10px 22px;
          padding: 14px 8px;
          font-size: 0.95rem;
        }

        .dialog {
          padding: 40px 4px 24px;
        }

        .message {
          margin-top: 16px;
        }

        .logo {
          margin-top: 60px;
        }
      }
    </style>
  </head>

  <body>
    <!-- This file lives in public/404.html -->

    <main class="page">
      <nav class="links" aria-label="Error page navigation">
        <a href="https://www.tapology.com/">Home</a>
        <a href="https://www.tapology.com/search">Search</a>
        <a href="https://www.tapology.com/sign_in">Login</a>
        <a href="https://www.tapology.com/faq">FAQ</a>
      </nav>

      <section class="dialog">
        <h1>It doesn't look like the page you requested exists.</h1>
        <p class="message">Maybe you don't exist either.</p>

        <img
          class="logo"
          src="/images/big_t.png"
          alt="Tapology"
        >
      </section>
    </main>
  </body>
</html>
