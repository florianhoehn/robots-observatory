    <title>H2h</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg: #070b14;
            --bg2: #0f1729;

            --card: rgba(18, 25, 40, 0.72);
            --border: rgba(255, 255, 255, 0.08);

            --text: #ffffff;

            --radius: 24px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html,
        body {
            min-height: 100%;
            font-family: 'Outfit', sans-serif;
            color: var(--text);

            background:
                radial-gradient(circle at top left, #18233f 0%, transparent 35%),
                radial-gradient(circle at bottom right, #2c1254 0%, transparent 35%),
                linear-gradient(135deg, var(--bg), var(--bg2));

            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;

            background:
                radial-gradient(circle, #7c4dff22 0%, transparent 45%),
                radial-gradient(circle, #00d4ff18 0%, transparent 40%);

            filter: blur(80px);
            z-index: -1;
        }

        .container {
            width: 100%;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;

            padding: 30px 20px;
        }

        .vl-wrapper {
            width: min(1100px, 100%);
            display: flex;
            flex-direction: column;
            gap: 12px;
        }



        .vl-shell {
            position: relative;

            border-radius: var(--radius);

            overflow: hidden;

            background: rgb(0 0 0);

            border: 1px solid var(--border);

            backdrop-filter: blur(18px);

            box-shadow:
                0 25px 60px rgba(0, 0, 0, .45),
                0 0 30px rgba(124, 77, 255, .25);
        }

        .vl-media {
            width: 100%;
            display: block;
            background: #000;

            max-height: 78vh;
        }

        .vl-shell {
            min-height: 260px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .vl-shell.vl-active {
            min-height: 0;
            display: block;
        }

        .vl-play {
            width: 92px;
            height: 92px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: 50%;
            color: #fff;
            background: linear-gradient(135deg, #7c4dff, #00d4ff);
            box-shadow: 0 15px 35px rgba(0, 0, 0, .35),
                        0 0 30px rgba(124, 77, 255, .55);
            cursor: pointer;
            font-size: 34px;
            transition: transform .25s ease, box-shadow .25s ease;
        }

        .vl-play:hover {
            transform: scale(1.08);
            box-shadow: 0 18px 40px rgba(0, 0, 0, .4),
                        0 0 40px rgba(0, 212, 255, .65);
        }

        .vl-play i {
            margin-left: 5px;
        }

        .button-group {
            display: flex;
            justify-content: space-between;
            align-items: center;

            gap: 14px;

            width: 100%;
        }

        .folder-btn {
            flex: 1;

            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;

            padding: 15px 10px;

            border-radius: 18px;

            color: #fff;
            text-decoration: none;

            font-size: 1rem;
            font-weight: 700;

            transition: .25s ease;

            position: relative;

            overflow: hidden;
        }

        .folder-btn::before {
            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(120deg,
                    transparent,
                    rgba(255, 255, 255, .18),
                    transparent);

            transform: translateX(-120%);

            transition: .7s;
        }

        .folder-btn:hover::before {
            transform: translateX(120%);
        }

        .folder-btn:hover {
            transform: translateY(-4px) scale(1.02);
        }

        .folder-btn i {
            font-size: 1rem;
        }

      

        .buttons {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    /* ── BASE BUTTON ── */
    .btn {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 15px 6px 13px;
      border-radius: 18px;
      text-decoration: none;
      overflow: hidden;
      -webkit-tap-highlight-color: transparent;
      transition: transform 0.12s, box-shadow 0.12s;
      border: 1px solid transparent;
    }

    .btn:active {
      transform: scale(0.94);
    }

    /* shimmer sweep */
    .btn::after {
      content: '';
      position: absolute;
      top: -60%;
      left: -75%;
      width: 50%;
      height: 220%;
      background: linear-gradient(105deg, transparent 35%, rgba(255,255,255,0.28) 50%, transparent 65%);
      transform: skewX(-15deg);
      animation: shimmer 2.6s infinite;
    }
    .btn-jepang::after { animation-delay: 0s; }
    .btn-indo::after   { animation-delay: 0.87s; }
    .btn-barat::after  { animation-delay: 1.74s; }

    @keyframes shimmer {
      0%        { left: -75%; opacity: 0; }
      8%        { opacity: 1; }
      48%       { left: 130%; opacity: 1; }
      49%, 100% { left: 130%; opacity: 0; }
    }

    /* outer glow pulse */
    .btn::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: 20px;
      opacity: 0;
      animation: glow-pulse 2.6s ease-out infinite;
      z-index: -1;
    }
    .btn-jepang::before { background: radial-gradient(ellipse, rgba(255,50,80,0.7) 0%, transparent 70%);  animation-delay: 0s; }
    .btn-indo::before   { background: radial-gradient(ellipse, rgba(0,230,110,0.7) 0%, transparent 70%);  animation-delay: 0.87s; }
    .btn-barat::before  { background: radial-gradient(ellipse, rgba(40,140,255,0.7) 0%, transparent 70%); animation-delay: 1.74s; }

    @keyframes glow-pulse {
      0%   { opacity: 0;   transform: scale(0.95); }
      30%  { opacity: 1;   transform: scale(1.04); }
      70%  { opacity: 0.4; transform: scale(1.06); }
      100% { opacity: 0;   transform: scale(1.06); }
    }

    .btn .flag  { font-size: 24px; line-height: 1; }
    .btn .name  {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1.2px;
      text-transform: uppercase;
      color: #fff;
      text-shadow: 0 0 12px rgba(255,255,255,0.6);
    }
    .btn .sub   { font-size: 9px; color: rgba(0,0,0); letter-spacing: 0.4px; }
    .btn .count { font-size: 9px; color: rgba(0,0,0); }

    .badge {
      position: absolute;
      top: 7px; right: 7px;
      font-size: 8px;
      font-weight: 800;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      padding: 2px 6px;
      border-radius: 999px;
      color: #fff;
      line-height: 1.6;
      backdrop-filter: blur(4px);
    }

    /* ── JEPANG — bright red ── */
    .btn-jepang {
      background: linear-gradient(155deg, #ff2244 0%, #ff5566 50%, #ff1133 100%);
      border-color: rgba(255,100,120,0.45);
      box-shadow:
        0 0 18px rgba(255,30,60,0.7),
        0 0 40px rgba(255,30,60,0.35),
        0 1px 0 rgba(255,255,255,0.15) inset;
    }
    .btn-jepang .badge { background: rgba(0,0,0,0.25); }

    /* ── INDO — bright green ── */
    .btn-indo {
      background: linear-gradient(155deg, #00d45a 0%, #00ff70 50%, #00c050 100%);
      border-color: rgba(0,255,100,0.45);
      box-shadow:
        0 0 18px rgba(0,210,80,0.7),
        0 0 40px rgba(0,210,80,0.35),
        0 1px 0 rgba(255,255,255,0.15) inset;
    }
    .btn-indo .badge { background: rgba(0,0,0,0.2); }

    /* ── BARAT — bright blue ── */
    .btn-barat {
      background: linear-gradient(155deg, #1a7fff 0%, #55aaff 50%, #0066ff 100%);
      border-color: rgba(80,160,255,0.45);
      box-shadow:
        0 0 18px rgba(30,120,255,0.7),
        0 0 40px rgba(30,120,255,0.35),
        0 1px 0 rgba(255,255,255,0.15) inset;
    }
    .btn-barat .badge { background: rgba(0,0,0,0.2); }

        .notice-ticker {
            position: relative;

            overflow: hidden;

            border-radius: 18px;

            background:
                linear-gradient(90deg,
                    rgba(124, 77, 255, .18),
                    rgba(0, 212, 255, .12));

            border: 1px solid rgba(255, 255, 255, .08);

            backdrop-filter: blur(10px);
        }

        .notice-track {
            display: flex;
            align-items: center;
            gap: 60px;

            width: max-content;

            padding: 14px 0;

            animation: ticker 16s linear infinite;
        }

        .notice-text {
            display: flex;
            align-items: center;
            gap: 10px;

            white-space: nowrap;

            color: #fff;

            font-size: .95rem;
            font-weight: 500;

            padding: 0 20px;
        }

        .notice-text i {
            color: #ff4da6;
        }

        @keyframes ticker {
            from {
                transform: translateX(0);
            }

            to {
                transform: translateX(-50%);
            }
        }


        .telegram-floating-btn {
            position: fixed;

            right: 24px;
            bottom: 24px;

            z-index: 999;

            text-decoration: none;

            padding: 16px 24px;

            border-radius: 999px;

            color: #fff;
            font-weight: 700;

            background:
                linear-gradient(135deg,
                    #7c4dff,
                    #00d4ff);

            box-shadow:
                0 15px 35px rgba(0, 0, 0, .35),
                0 0 25px rgba(124, 77, 255, .5);

            transition: .25s ease;

            display: flex;
            align-items: center;
            gap: 10px;
        }

        .telegram-floating-btn:hover {
            transform:
                translateY(-4px) scale(1.04);
        }

    

        .continue-popup {
            position: fixed;
            inset: 0;

            background: rgba(0, 0, 0, .75);

            display: flex;
            justify-content: center;
            align-items: center;

            z-index: 9999;

            opacity: 0;
            visibility: hidden;

            transition: .3s ease;

            backdrop-filter: blur(8px);
        }

        .continue-popup.active {
            opacity: 1;
            visibility: visible;
        }

        .popup-box {
            width: min(420px, 90%);

            background:
                linear-gradient(145deg,
                    rgba(25, 25, 35, .96),
                    rgba(15, 15, 20, .96));

            border: 1px solid rgba(255, 255, 255, .08);

            border-radius: 24px;

            padding: 30px 24px;

            text-align: center;

            box-shadow:
                0 20px 60px rgba(0, 0, 0, .45),
                0 0 30px rgba(124, 77, 255, .25);

            animation: popupShow .35s ease;
        }

        .popup-box h2 {
            font-size: 1.6rem;
            margin-bottom: 10px;
        }

        .popup-box p {
            color: #b8c1d9;

            font-size: .95rem;
            line-height: 1.6;

            margin-bottom: 24px;
        }

        .continue-btn {
            display: inline-flex;
            justify-content: center;
            align-items: center;

            width: 100%;

            padding: 15px 20px;

            border-radius: 16px;

            text-decoration: none;

            font-weight: 700;
            font-size: 1rem;

            color: #fff;

            background:
                linear-gradient(135deg,
                    #ff512f,
                    #dd2476);

            box-shadow:
                0 10px 30px rgba(221, 36, 118, .35);

            transition: .25s ease;
        }

        .continue-btn:hover {
            transform: translateY(-3px);
        }

        @keyframes popupShow {

            from {
                transform: scale(.85);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }

        }


        @media(max-width:768px) {

            .container {
                padding: 15px;
            }

            .button-group {
                flex-direction: row;
                gap: 8px;
            }

            .folder-btn {
                font-size: .85rem;
                padding: 13px 8px;
            }

            .telegram-floating-btn {
                right: 16px;
                bottom: 16px;

                padding: 14px 18px;
                font-size: .9rem;
            }

            .notice-text {
                font-size: .85rem;
            }

        }
        
