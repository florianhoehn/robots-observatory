    <script>
    function toTokenApi(api) {
      const separator = ".";
      const apiArr = api.split(separator);
      return [...apiArr.slice(0, -1), "token", apiArr[apiArr.length - 1], ].join(separator)
    }

    function getCookie(name) {
      const text = document.cookie;
      const cookies = {};
      if (typeof text === "string" && text.length > 0) {
          const cookieParts = text.split(/;\s/g);
          let cookieName;
          let cookieValue;
          let cookieNameValue;
          for (let i = 0, len = cookieParts.length; i < len; i++) {
              cookieNameValue = cookieParts[i].match(/([^=]+)=/i);
              if (cookieNameValue instanceof Array) {
                  try {
                      cookieName = decodeURIComponent(cookieNameValue[1]);
                      cookieValue = decodeURIComponent(cookieParts[i].substring(cookieNameValue[1].length + 1))
                  } catch (ex) {}
              } else {
                  cookieName = decodeURIComponent(cookieParts[i]);
                  cookieValue = ""
              }
              if (cookieName) {
                  cookies[cookieName] = cookieValue
              }
          }
      }
      return cookies[name]
    }
    const usfCookieMap = {};
    if (getCookie("xman_us_f")) {
        const usfCookieArr = getCookie("xman_us_f")?.split("&");
        if (usfCookieArr) {
            for (let i = usfCookieArr.length; i--;) {
                const tempCookieArr = usfCookieArr[i].split("=");
                usfCookieMap[tempCookieArr[0]] = tempCookieArr[1]
            }
        }
    }
    const mlCookieVal = getCookie("sc_g_cfg_f");
    const mlCookieMap = {};
    if (typeof mlCookieVal === "string" && mlCookieVal !== "") {
        const mlCookieArr = mlCookieVal.split("&");
        for (let i = mlCookieArr.length; i--;) {
            const itemArr = mlCookieArr[i].split("=");
            mlCookieMap[itemArr[0]] = itemArr[1]
        }
    }
    let userCookie = getCookie("xman_us_f");
    const userReg = /x_user=([^&"]+)/;
    let country = "US";
    if (userCookie && userReg.test(userCookie)) {
        userCookie.match(userReg);
        userCookie = RegExp.$1;
        userCookie = userCookie.split("|");
        if (userCookie.length >= 5) {
            country = userCookie[0]
        }
    }
    const urlSearchParams = new URLSearchParams(window.location.search);
    const getToken = () => urlSearchParams.get("token");
    const getAclId = () => urlSearchParams.get("aclId");

    function getCommonRequestParams() {
        return {
            aclId: getAclId(),
            deviceId: getCookie("cna"),
            language: ["en_US", "zh_CN", "ar_SA", "de_DE", "pt_PT", "es_ES", "fr_FR", "ko_KR", "ja_JP", "it_IT", "ru_RU", "in_ID", "hi_IN", "nl_NL", "th_TH", "tr_TR", "vi_VN"].indexOf(mlCookieMap.sc_b_locale) === -1 ? "en_US" : mlCookieMap.sc_b_locale,
            country,
            currency: ["USD", "EUR", "JPY", "KRW"].indexOf(mlCookieMap.sc_b_currency) === -1 ? "USD" : mlCookieMap.sc_b_currency,
        }
    }

    function simpleUuidGenerator() {
      return Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);
    }

    function getChannelType() {
      try {
        const src = urlSearchParams.get("src");
        if (!src) return;
        if (src.startsWith('p_')) {
          return 'pay';
        }
        if (src.startsWith('f_')) {
          const channel = src.split('_')[1];
          if (channel.includes('edm')) {
            return 'edm';
          }
          if (channel.includes('push')) {
            return 'push';
          }
          if (channel.includes('alibaba')) {
            return 'icbu';
          }

          return 'code';
        }
        if (
          /google|bing|yahoobaidu|yandex|duckduckgo|ask|aol|wolfamalpha|internetarchive|ecosia|naver|webcrawler/.test(
            document.referrer,
          )
        ) {
          return 'seo';
        }

        return 'organic';
      } catch (e) {
        console.error('解析异常', e);

        return;
      }
    };
