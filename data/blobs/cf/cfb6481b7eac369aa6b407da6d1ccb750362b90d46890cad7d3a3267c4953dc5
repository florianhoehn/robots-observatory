        // 4. 支持的语言列表
        const langs = ['en_US', 'zh_CN', 'ar_SA', 'de_DE', 'pt_PT', 'es_ES', 'fr_FR', 'ko_KR', 'ja_JP', 'it_IT', 'ru_RU', 'in_ID', 'hi_IN', 'nl_NL', 'th_TH', 'tr_TR', 'vi_VN'];
        const langMap = langs.reduce((prev, cur) => {
          const prefix = cur.split('_')[0];
          prev[prefix] = cur;
          return prev;
        }, {});

        // 5. 获取浏览器语言
        const browserLang = navigator.language && navigator.language.split('-')[0];

        // 6. 判断是否为 asource.com 或 accio-ai.com
        const domain = location.hostname;
        const isExcludedDomain = domain.includes('asource.com') || domain.includes('accio-ai.com');

        // 对于 asource.com 和 accio-ai.com,如果没有浏览器语言,默认使用中文
        const targetLang = !langMap[browserLang] && isExcludedDomain ? 'zh_CN' : langMap[browserLang];

        if (!targetLang || targetLang === 'en_US') {
          return;
