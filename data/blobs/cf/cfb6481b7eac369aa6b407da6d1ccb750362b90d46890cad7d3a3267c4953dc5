        // 7. 排除特殊页面(asource.com 和 accio-ai.com 不 exclusion)
        if ((location.pathname === '/ask-start' || (browserLang === 'zh' && location.pathname === '/about-us')) && !isExcludedDomain) {
          return;
        }

        // 8. 拼接重定向 URL 并执行重定向
        let reloadUrl = location.origin + location.pathname;
        s.set('language', targetLang);
        s.set('langRedirect', 1);
