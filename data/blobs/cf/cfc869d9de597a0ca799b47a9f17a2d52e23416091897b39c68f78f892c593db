<!-- Category Active Links -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const row = document.querySelector('.cat-row');
    if (!row) return;

    const links = [...row.querySelectorAll('a.cat-button')];

    // Read current category_name from URL
    const params = new URLSearchParams(window.location.search);
    const currentCat = params.get('category_name'); // e.g. "mlb-the-show-26"

    // Clear existing active classes
    links.forEach(a => a.classList.remove('is-active'));

    if (!currentCat) {
      // No category_name -> All
      const allLink = links.find(a => {
        const url = new URL(a.getAttribute('href'), window.location.origin);
        return url.pathname.replace(/\/+$/, '') === '/news' && !url.search;
      });
      if (allLink) allLink.classList.add('is-active');
      return;
    }

    // Match the link whose category_name equals currentCat
    const activeLink = links.find(a => {
      const url = new URL(a.getAttribute('href'), window.location.origin);
      return new URLSearchParams(url.search).get('category_name') === currentCat;
    });

    if (activeLink) activeLink.classList.add('is-active');
  });
</script>

