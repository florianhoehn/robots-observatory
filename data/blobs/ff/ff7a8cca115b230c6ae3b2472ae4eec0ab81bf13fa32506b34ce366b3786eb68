    fetchDocument();

    function currentDateTimeFormate(timestamp){
        const date = new Date(timestamp * 1000);
        const options = {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
            timeZone: 'Asia/Kolkata'
        };
        const parts = new Intl.DateTimeFormat('en-US', options).formatToParts(date);
        const values = {};
        parts.forEach(part => {
            values[part.type] = part.value;
        });
        const formatted = `${values.month} ${values.day}, ${values.year} | ${values.hour}:${values.minute} IST`;
        const el = document.getElementById("liveTime");
        // Check if element exists
        if (el) {
            el.innerHTML = formatted;
            el.classList.add('loaded');
        }
    }

