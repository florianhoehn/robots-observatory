    const wfCurrent = document.querySelector(".weglot-current");
    
    wfCurrent.textContent = currLang.toUpperCase();

    
    initiateLinks()
    
    
  }
  
  Weglot.on("initialized", () => {
  currLang();
});
  
  
  
  
</script>



