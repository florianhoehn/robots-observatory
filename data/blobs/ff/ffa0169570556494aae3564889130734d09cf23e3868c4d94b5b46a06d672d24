<script>
  
  
  const initiateLinks = () => {
    
    const availableLanguages = Weglot.options.languages
        .map(function(language) {
            return language.language_to;
        })
        .concat(Weglot.options.language_from);
    
    const currLang =  Weglot.getCurrentLang()   
    
    const langOptions = document.querySelectorAll(
      ".weglot-lang-selection"
    );
     
   
    const filterredOptions = availableLanguages.filter((lang) => lang !== currLang)
  

  	/**
    NOTE TO FUTURE SELF
    Support for multiple languages could be added by filtering available languages by removing the 
    current lang and just looping by the result generating each items values
    */
	const langOptionsArray = Array.from(langOptions);
    
    /**
    
    Note:
    Issue is caused that each lang options have duplicates due to the mobile menu being separate
    */
    
    const prefix = filterredOptions[0] === 'en' ? 'www' : filterredOptions[0]
    langOptionsArray.forEach((item, id) => {
      console.log(id)
      
	item.setAttribute("data-lang", filterredOptions[0]);
      
	// item.setAttribute('href', `https://${prefix}.optable.co/`)
    
  
    setTimeout(() => {
  item.setAttribute('href', `https://${prefix}.optable.co/`)
}, 1000)
	
      
    item.textContent = filterredOptions[0].toUpperCase();
    })
    
   	 
  }
  
  const currLang = () => {
    console.log(`curr lang: `, Weglot.getCurrentLang())
    
