<script>
  function setTheme(theme) {
    if (theme === undefined) theme = localStorage.getItem("contentTheme") || "light";
    $(".content-theme").attr("data-bs-theme", theme);
    document.documentElement.removeAttribute("data-bs-theme");
    $("#themeToggle i, #themeToggleMobile i")
      .toggleClass("fa-moon-stars", theme === "dark")
      .toggleClass("fa-sun-bright", theme === "light");
  }

  if (typeof window.jQuery !== 'undefined') {
    $(function () {

      // ── Login form: move single instance into whichever dropdown opens ──
      const loginForm = document.querySelector('#loginFormTemplate .login-dropdown-inner');
      $('[data-login-dropdown]').on('show.bs.dropdown', function () {
        $(this).find('.dropdown-menu').append(loginForm);
      });

      // ── Smooth dropdown animations (desktop only) ──
      $('.dropdown').on('show.bs.dropdown', function () {
        if ($(window).width() >= 1200) {
          $(this).find('.dropdown-menu').first().stop(true, true).hide().slideDown(200);
        }
      });
      $('.dropdown').on('hide.bs.dropdown', function () {
        if ($(window).width() >= 1200) {
          $(this).find('.dropdown-menu').first().stop(true, true).slideUp(200);
        }
      });

      setTheme();

      $("#themeToggle, #themeToggleMobile").click(function () {
        const t = localStorage.getItem("contentTheme") === "dark" ? "light" : "dark";
        localStorage.setItem("contentTheme", t);
        setTheme(t);
      });

      // ── Close mobile menu on outside click ──
      $(document).on('click', function (e) {
        const $navbar = $('#mainNav');
        const $toggler = $('.navbar-toggler');
        if (!$navbar.is(e.target) && $navbar.has(e.target).length === 0 &&
            !$toggler.is(e.target) && $toggler.has(e.target).length === 0) {
          const instance = bootstrap.Collapse.getInstance($navbar[0]);
          if (instance) instance.hide();
        }
      });

      // ── Prevent login dropdown from closing on inside click ──
      $('[data-login-dropdown]').on('click', '.dropdown-menu', function (e) {
        e.stopPropagation();
      });

    });
  }
