    <!--
      Apply the stored light/dark theme before first paint to avoid a flash.
      Keys must stay in sync with STORAGE_KEY / ASPEN_SHELL_STORAGE_KEY in
      src/hooks/useColorTheme.ts.

      Why the aspen-shell check: the toggle lives only on the Aspen nav. If
      aspenWeb is off we must not paint `.dark` or the user has no way back
      (Agents/SDM on this origin would also pick up dark). We still keep
      vd-color-theme — do not reset the preference here.

      Apply `.dark` only when last session explicitly recorded Aspen
      (`vd-color-theme-aspen-shell === '1'`). Missing or `'0'` stays light so
      classic users on a dark OS do not flash. Preference: forced `'dark'`, or
      `'system'` / missing following prefers-color-scheme.

      Temporary: drop the vd-color-theme-aspen-shell check once everyone is on
      Aspen. Then this script should only read vd-color-theme (+ media).
    -->
    <script>
      (function () {
        try {
          if (localStorage.getItem('vd-color-theme-aspen-shell') !== '1') return;
          var preference = localStorage.getItem('vd-color-theme');
          var dark =
            preference === 'dark' ||
            ((preference === 'system' || preference === null) &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {
          // localStorage / matchMedia may be blocked — fall back to light.
        }
      })();
    </script>

    <!-- Unsupported browser detection using nomodule -->
    <script nomodule>
      (function () {
        // This script only runs in browsers that don't support ES modules
        document.addEventListener('DOMContentLoaded', function () {
          var currentPath = window.location.pathname;
          var isAlarmRoute = currentPath.startsWith('/alarm/');
          var isShareRoute = currentPath.startsWith('/share/');
          var isPublicRoute = isAlarmRoute || isShareRoute;

          var isProduction =
            window &&
            (window.location.host === 'solinkcloud.com' ||
              window.location.host === 'www.solinkcloud.com');

          if (isProduction && !isPublicRoute) {
            document.getElementById('static-loading-wrapper').classList.add('hide');
            document.getElementById('content').classList.add('hide');
            document.getElementById('unsupported-browser').classList.remove('hide');
          }
        });
      })();
    </script>

