name="generator" content="WordPress 7.1.3"><style id=dac-critical-css>/*<![CDATA[*//* Responsive Grid for Dynamic Ads */
.dac-section {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
}

.dac-grid {
    display: grid;
    grid-template-columns: repeat(var(--dac-col-pc, 1), 1fr);
    margin: 20px 0;
    width: 100%;
    box-sizing: border-box;
}

.dac-grid__item {
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
    grid-column: span var(--dac-col-span, 1);
    grid-row: span var(--dac-row-span, 1);
}

/* Mobile columns */
@media (max-width: 600px) {
    .dac-grid {
        grid-template-columns: repeat(var(--dac-col-mob, 1), 1fr);
    }
    .dac-grid__item {
        grid-column: span var(--dac-col-span-mob, 1);
        grid-row: span var(--dac-row-span-mob, 1);
    }
}

.dac-grid__item a {
    display: block;
    width: 100%;
    height: 100%;
}

.dac-grid__item img.dac-img,
.dac-section--banner img.dac-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    max-width: 100%;
}

/* ── Multi-image: separate  per image ───────────────────────── */
.dac-grid__item--multi-v {
    display: flex;
    flex-direction: column;
}

.dac-grid__item--multi-h {
    display: flex;
    flex-direction: row;
}

.dac-grid__item .dac-multi__link {
    display: block;
    overflow: hidden;
    min-height: 0;
    min-width: 0;
    height: auto;
}

.dac-grid__item--multi-v > .dac-multi__link {
    flex: 1 1 auto;
}

.dac-grid__item--multi-h > .dac-multi__link {
    flex: 1 1 0;
}

.dac-grid__item .dac-multi__link img.dac-img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
}

/* ── Center mode: image centered within span at single-column size */
.dac-grid__item--center {
    display: flex;
    align-items: center;
    justify-content: center;
}

.dac-grid__item--center a {
    width: calc(100% / var(--dac-col-span, 1));
    height: auto;
    max-height: 100%;
}

.dac-grid__item--center img.dac-img {
    width: 100%;
    height: auto;
    display: block;
    max-height: 100%;
}

@media (max-width: 600px) {
    .dac-grid__item--center a {
        width: calc(100% / var(--dac-col-span-mob, 1));
    }
}

/* ── Fallback: aspect-ratio → padding-top for Safari < 15 ──────── */
@supports not (aspect-ratio: 1 / 1) {
    .dac-grid__item {
        padding-top: var(--ar-fallback, 0%);
    }
    .dac-grid__item > a:not(.dac-multi__link) {
        position: absolute;
        top: 0;
        left: 0;
    }
    .dac-grid__item--multi-v > .dac-multi__link {
