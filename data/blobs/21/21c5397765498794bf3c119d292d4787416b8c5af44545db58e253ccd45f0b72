.dac-float--top-left,
.dac-float--top-right,
.dac-float--center-left,
.dac-float--center-right,
.dac-float--bottom-left,
.dac-float--bottom-right {
    flex-direction: column;
    width: 140px;
    box-shadow: 0 4px 8px rgb(0 0 0 / .2);
