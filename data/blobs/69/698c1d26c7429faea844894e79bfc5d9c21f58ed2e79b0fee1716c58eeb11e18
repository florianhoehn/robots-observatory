<script>
const url_dataset = "/justicia/chicos-extraviados/listado";
/**
 * Retorna un subconjunto aleatorio de entradas.
 * @param {Array} entries - Array de entradas de donde seleccionar.
 * @param {number} [totalResults=4] - Cantidad de entradas aleatorias a retornar.
 * @returns {Array} Un nuevo array con las entradas seleccionadas.
 */
function randomEntries(entries, totalResults = 4) {
    if (!Array.isArray(entries) || entries.length === 0) {
        return [];
    }
    const count = Math.min(totalResults, entries.length);
    const shuffled = [...entries].sort(() => 0.5 - Math.random());
    return shuffled.slice(0, count);
}



/**
 * Crea un elemento HTML con la información de una persona extraviada.
 * @param {Object} entry - Datos de la persona.
 * @param {string} entry.fullName - Nombre completo.
 * @param {string} entry.description - Descripción del caso.
 * @param {string} entry.image - URL de la imagen.
 * @param {string} entry.url - Enlace a la ficha completa.
 * @returns {HTMLElement|false} Elemento `<article>` o `false` si los datos son inválidos.
 */
function themeA(entry) {
    if (!entry || typeof entry !== "object") {
        return false;
    }

    const { fullName, description, image, url } = entry;
    if (!fullName || !description || !image || !url) {
        return false;
    }

    const article = document.createElement("article");
    article.className = "missingperson__entry";
    article.setAttribute("itemscope", "");
    article.setAttribute("itemtype", "https://schema.org/Person");

    const link = document.createElement("a");
    link.href = url;
    link.setAttribute("aria-label", `Ver más información sobre ${fullName}`);

    const imgContainer = document.createElement("div");
    imgContainer.className = "missingperson__img-container";

    const imgBlur = document.createElement("div");
    imgBlur.className = "img-blur";
    imgBlur.style.backgroundImage = `url('${image}')`;

    const imgVisible = document.createElement("div");
    imgVisible.className = "img-visible";
    imgVisible.style.backgroundImage = `url('${image}')`;

    const img = document.createElement("img");
    img.src = image;
    img.loading = "lazy";
    img.width = 200;
    img.alt = fullName;
    img.setAttribute("itemprop", "image");
    img.className = "sr-only";

    imgContainer.append(imgBlur, imgVisible, img);

    const content = document.createElement("div");
    content.className = "content p-x-1 p-y-05";

    const h4 = document.createElement("h4");
    h4.setAttribute("itemprop", "name");
    h4.className = "h6 font-sans-serif m-b-05";
    h4.textContent = fullName;

    const p = document.createElement("p");
    p.textContent = description;

    content.append(h4, p);
    link.append(imgContainer, content);
    article.appendChild(link);

    return article;
}


/**
 * Renderiza la grilla de personas extraviadas dentro del contenedor indicado.
 * @param {string} selector - Selector CSS del contenedor destino.
 * @returns {void}
 */
function setGrid(selector, entries) {
    if (!selector) {
        console.error("setGrid: no se proporcionó un selector.");
        return;
    }

    const container = document.querySelector(selector);
    if (!container) {
        console.error(`setGrid: no se encontró el elemento "${selector}".`);
        return;
    }

    if (!entries.length) {
        console.warn("setGrid: la lista está vacía.");
        return;
    }

    const fragment = document.createDocumentFragment();
    for (const person of entries) {
        const node = themeA(person);
        if (node) {
            fragment.appendChild(node);
        }
    }
    container.innerHTML = "";
    container.appendChild(fragment);
}


// Init
(async () => {
    const jsonData = await fetch_json(url_dataset);
    const randomList = randomEntries(jsonData, 4);
    setGrid("#id-chicos-extraviados", randomList);
})();
</script>
