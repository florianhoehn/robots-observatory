const AUTO_ROTATE_MS = 6000;
let current = 0;
let animating = false;
let autoTimer = null;
const apron = document.getElementById("apron");
const center = apron.querySelector(".apron__center");
const btnPrev = document.getElementById("btn-prev");
const btnNext = document.getElementById("btn-next");
const messages = Array.from(center.querySelectorAll(".apron__message"));
const total = messages.length;
function setPosition(el, state) {
// Remove all state classes
el.classList.remove(
"visible",
"exit-up",
"exit-down",
"enter-from-below",
"enter-from-above"
);
if (state) el.classList.add(state);
}
function resetTimer() {
clearInterval(autoTimer);
autoTimer = setInterval(
() => goTo((current + 1) % total, "up"),
AUTO_ROTATE_MS
);
}
function goTo(next, direction) {
if (animating || next === current) return;
animating = true;
const outgoing = messages[current];
const incoming = messages[next];
// Place incoming off-screen instantly (no transition)
incoming.style.transition = "none";
setPosition(
incoming,
