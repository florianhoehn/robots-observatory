    function moveLogRocket() {

        const $root = $("#_lr_guides_root");
        const $target = $(".user-feedback");

        if (
            $root.length &&
            $target.length &&
            !$target.find("#_lr_guides_root").length
        ) {
            $target.append($root);
        }
    }

    function forceLogRocketOpen() {

        const $root = $("#_lr_guides_root");

        if (!$root.length) {
            return false;
        }

        if (sessionStorage.getItem(getPageKey())) {
            $root.addClass("lr-page-complete");
            return true;
        }

        $root.show();
        $root.css("display", "");

        const $launcherBtn = $root.find("button").first();

        $launcherBtn.addClass("lr-hidden-launcher");

        const hasSurveyContent =
            $root.find("textarea").length > 0 ||
            $root.find("input[type='radio']").length > 0;

        if (
            !hasSurveyContent &&
            $launcherBtn.length
        ) {
            $launcherBtn.trigger("click");
        }

        return true;
    }

    function stripLogRocketInlineStyles() {

        const $root = $("#_lr_guides_root");

        if (!$root.length) {
            return false;
        }

        $root.removeAttr("style");

        const $level1 = $root.children("div").first();
        $level1.removeAttr("style");

        const $level2 = $level1.children("div").first();
        $level2.removeAttr("style");

        return true;
    }

    function updateSurveyState() {

        const root = document.querySelector("#_lr_guides_root");

        if (!root) {
            return;
        }

        if (sessionStorage.getItem(getPageKey())) {
            root.classList.add("lr-page-complete");
            return;
        }

        root.querySelectorAll("div").forEach(el => {

            const text = (el.textContent || "").trim();

            if (text === "Select one option.") {
                el.classList.add("lr-helper-text");
            }

            if (text === "0/1000") {
                el.classList.add("lr-helper-text-hint");
            }
        });

        const rows = Array.from(
            root.querySelectorAll("div")
        ).filter(div => {

            const btns = div.querySelectorAll(
                ":scope > button[type='button']"
            );

            if (!btns.length) {
                return false;
            }

            btns.forEach(btn => {

                const text = (
                    btn.textContent || ""
                ).trim().toLowerCase();

                if (
                    text === "back" ||
                    text === "left"
                ) {
                    btn.classList.add("lr-back-button");
                }
            });

            return Array.from(btns).some(btn =>
                /back|next|done/i.test(
                    btn.textContent || ""
                )
            );
        });

        rows.forEach(row => {

            row.style.setProperty(
                "display",
                "flex",
                "important"
            );
        });

        const radios = root.querySelectorAll(
            "input[type='radio']"
        );

        if (
            radios.length >= 2 &&
            !root.dataset.lrRadioBound
        ) {

            root.dataset.lrRadioBound = "true";

            radios[0].addEventListener(
                "change",
                () => {
                    root.dataset.lrSelection = "first";
                }
            );

            radios[1].addEventListener(
                "change",
                () => {
                    root.dataset.lrSelection = "second";
                }
            );
        }

        const textarea = root.querySelector(
            "textarea"
        );

        /*
         * Feedback path
         */
        if (textarea) {

            const buttons = root.querySelectorAll(
                "button[type='button']"
            );

            const finalButton =
                buttons[buttons.length - 1];

            if (
                finalButton &&
                !finalButton.dataset.lrBound
            ) {

                finalButton.dataset.lrBound = "true";

                finalButton.addEventListener(
                    "click",
                    () => {

                        sessionStorage.setItem(
                            getPageKey(),
                            "true"
                        );

                    }
                );
            }
        }

        /*
         * First page path
         */
 /*
