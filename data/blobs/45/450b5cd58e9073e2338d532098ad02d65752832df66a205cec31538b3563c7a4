) {

    const buttons = root.querySelectorAll(
        "button[type='button']"
    );

    const nextButton =
        buttons[buttons.length - 1];

    if (
        nextButton &&
        !nextButton.dataset.lrYesBound
    ) {

        nextButton.dataset.lrYesBound =
            "true";

        nextButton.addEventListener(
            "click",
            () => {

                if (
