                                                            <script>document.addEventListener("DOMContentLoaded", function () {
    function gestisciDiv() {
        if (window.innerWidth <= 768) { // Su mobile
            let body = document.body;
            let targetDiv = document.querySelector('[data-elementor-id="274"]');
            
            // Controlla se siamo su una pagina con ID 74438, un single post di "prodotti", "locali", 
            // su una pagina di un termine di "localieaziende_tipologia" o "prodotti_tipologia"
            if (targetDiv && 
                (body.classList.contains("single-prodotti") || 
                 body.classList.contains("single-locali") || 
                 body.classList.contains("tax-localieaziende_tipologia") || 
                 body.classList.contains("tax-prodotti_tipologia") || 
                 body.classList.contains("page-id-74438"))) {
                targetDiv.style.display = "none";
            }
        } else { // Su desktop o larghezze superiori
            let targetDiv = document.querySelector('[data-elementor-id="274"]');
            if (targetDiv) {
                targetDiv.style.display = "block";
            }
        }
    }

    // Esegui subito la funzione
    gestisciDiv();

    // Aggiungi l'event listener per il resize della finestra
    window.addEventListener("resize", gestisciDiv);
});
</script>
