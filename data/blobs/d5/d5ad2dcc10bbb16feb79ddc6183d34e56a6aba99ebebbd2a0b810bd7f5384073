<script type="text/javascript">
function loadUtmsParam() {
  const payload = {
      src:            "",
      utm_ibsource:   "",
      w:              "",
      c:              "",
      gad_campaignid: "",
      device:         ""  };
  fetch('/mkt/ibkrutmtracking.php', {
      method: 'POST',
      headers: {
          'Content-Type': 'application/json'
      },
      credentials: 'same-origin',
      body: JSON.stringify(payload)
  })
  .then(function (response) {
      if (!response.ok) {
          throw new Error('Network response was not ok: ' + response.status);
      }
      return response.json();
  })
  .then(function (data) {
      if (data && data.utm_params) {
          reloadWithUtmParams(data.utm_params);
      }
  })
  .catch(function (error) {
      console.error('UTM tracking request failed:', error);
  });
}
function reloadWithUtmParams(utmParams) {
    const url = new URL(window.location.href);
    const hasSrc = url.searchParams.has('src') && url.searchParams.get('src') !== '';
    const hasIbSource = url.searchParams.has('utm_ibsource') && url.searchParams.get('utm_ibsource') !== '';
    if (!utmParams.utm_source || utmParams.utm_source === '') {
        console.warn('utm_source missing from API response, skipping reload.');
        return;
    }
    if (hasSrc) {
      url.searchParams.delete('src');
    }
    if (hasIbSource) {
      url.searchParams.delete('utm_ibsource');
    }
    Object.keys(utmParams).forEach(function (key) {
        const value = utmParams[key];
        const isUtmParam = key.indexOf('utm_') === 0;
        const alreadySetInUrl = url.searchParams.has(key) && url.searchParams.get(key) !== '';
        if (isUtmParam && alreadySetInUrl) {
            return;
        }
        
        if (value !== undefined && value !== null && value !== '') {
            url.searchParams.set(key, value);
        }
    });
    url.searchParams.set('utm_applied', '1');
    window.history.replaceState(null, '', url.toString());
}
