			.maincontent {
				padding:50px 20px;
				text-align:center;
				display:flex;
				flex-direction:column;
			}
			.maincontent .logo {
				width:100%;
				max-width :780px;
				margin:0 auto;
			}
			.maincontent .icon {
				width:100%;
				max-width :150px;
				margin:50px auto;
			}
			.maincontent .message {
				border-radius:40px;
				line-height:4;
				background-color: #212529!important;
				background-image:linear-gradient(180deg, rgba(255, 255, 255, 0.15), rgba(255, 255, 255, 0));
				display:flex;
			}
			.maincontent .message span{
				font-size:20px;
				color:#fff;
				display:inline-block;
			}
			.maincontent .redlight {
				max-width:60px;
				margin:10px 20px 10px 10px;
			}
			@media (max-width: 550px) {
				.maincontent .icon {
					max-width :70px;
					margin:20px auto;
				}
				.maincontent .message {
					line-height:2;
				}
				.maincontent .message span {
					font-size:16px;
				}
				.maincontent .redlight {
					max-width:25px;
				}
			}
		</style>
