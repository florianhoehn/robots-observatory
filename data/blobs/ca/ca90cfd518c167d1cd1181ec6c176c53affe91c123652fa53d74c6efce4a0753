<script type="text/javascript">
    function getTitleFromUrl(url) {
        var splitUrl = url.split("/");

        var titleWithExtras = splitUrl[splitUrl.length - 1];

        var title = titleWithExtras
            .replace(/\\|[0-9]|\.[^\/]*$/gi, '')
            .replace(/[^a-zA-Z]+/g, '+')
            .replace(/^\+|\+$/g, '');

        // Split the title into words, filter out those with less than 2 characters, then join back with '+'
        title = title.split('+').filter(function(word) {
            return word.length > 1;
        }).join('+');

        return title;
    }

    window.onload = function() {
        var currentUrl = window.location.href;

        var title = getTitleFromUrl(currentUrl);

        var newUrl = '/search/?q=' + title + '&type=storyline&contextPublication=true';

        window.location.href = newUrl;
    };
</script>              </div>
