    <script>
/*
 * Premium ad-skip flag, written by icyveins-topbar-account.js from GET /v1/billing/status.
 *
 * icy-auth's `icy_session` cookie is httpOnly and host-only to the auth domain, so neither
 * this page nor the www server can see it -- premium status is only knowable after an
 * authenticated fetch. This flag caches the last answer so the ad and analytics loaders
 * below can decide at first paint. It is a paint optimisation, not a security boundary.
 *
 * The key is shared with the Astro app (src/lib/billing/premium-flag.ts); both are served
 * from the www origin, so a signed-in reader crossing between them keeps the flag.
 */
function icyIsPremium () {
  try {
    return window.localStorage.getItem('icy:premium') === '1'
  } catch (e) {
    return false
  }
}

function writeToLocalStorage(key, content) {
  try {
    window.localStorage.setItem(key, content);
  } catch(e) {
    for (var i = 0; i < window.localStorage.length; i++) {
      current_key = window.localStorage.key(i);
      if (current_key != 'premium_tracking' && current_key != 'premium_origin' && current_key != 'icy:premium') {
        window.localStorage.removeItem(current_key);
      }
    }
    window.localStorage.setItem(key, content);
  }
}
