			"DEMO ANFORDERN",
			"DEMANDEZ UNE DÉMO",
			"申请产品演示",
			"RICHIEDI UNA DEMO",
			"デモを依頼",
			"데모 요청",
			"ЗАПРОСИТЬ ДЕМОНСТРАЦИЮ",
			"SOLICITA UNA DEMO",
			"Prośba o demo",
			"REQUEST A DEMO"

		]

		setTimeout(function(){
			const buttons = $('.btn');
			for(let j = 0; j < buttons.length; j++){
				demoButtons.forEach(function(text){
					if(buttons[j].innerText == text) {
						buttons[j].onclick = function(){
							var selectIds = document.getElementsByName('reason_for_contact');
							for(var i = 0; i < selectIds.length; i++){
								var selectId = selectIds[i].id;
								$('#'+selectId).val('Request a demo').change()


								if(window.location.pathname.indexOf('/gfknewron') !== -1 ) {
									var inputs = document.getElementsByName('solution_category');
									for(var k = 0; k < inputs.length; k++){
										if(inputs[k].value === 'gfknewron'){
											$('#'+inputs[k].id).prop( "checked", true )
										} 
									}
								}
							}
						}
					}
				})

			}

		}, 3000)

		prefillings.forEach(function(item){
			item.pages.forEach(function(page){
				if(window.location.pathname.includes(page)){
					setTimeout(function(){

