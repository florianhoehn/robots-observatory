<script type="text/javascript">
  var searchVars = {'tip':'Search...', 'index':0, 'opts':[{"url":"https://www.diigo.com/search/community?q=_KEYWORD_","title":"Search <em>community library</em> for _KEYWORD_"},{"url":"https://www.diigo.com/search/g?q=_KEYWORD_","title":"Search in Google for _KEYWORD_"},{"url":"https://www.diigo.com/people/search/name?type=name&query=_KEYWORD_","title":"Find <em>users</em> matching _KEYWORD_"},{"url":"https://groups.diigo.com/group_mana/search_groups?keywords=_KEYWORD_","title":"Find <em>groups</em> interested in _KEYWORD_"}]};
  function initSearchBox(){
    var searchBox = $("searchBox");
    searchBox.onfocus = enableSearchOpts;
    searchBox.onblur = disableSearchOpts;
    searchBox.value = searchVars.tip;
    searchBox.setStyle({"color":"#999"});
    var f = $("topSearchForm");
    f.action = "javascript:void(0);";
    f.onsubmit = function(){submitSearch();return false;}
  }

  function submitSearch(){
    var url = searchVars.opts[searchVars.index]["url"];
    var keyword = encodeURI($F("searchBox"));
    self.location.href = url.replace(/_KEYWORD_/, keyword);
  }
  
  function makeSearchOpts(){
    var b = new Element("div", {"id":"searchOpts"});
    var u = new Element("ul");
    for(var i=0; i<searchVars.opts.length; i++){
      var l = new Element("li", {"id":"searchOpt_"+i, "onmouseover":"overSearchOpt("+i+");", "onmouseout":"outSearchOpt("+i+")", "onclick":"submitSearch();"}).update(searchVars.opts[i]["title"]);
      if(i==0){l.className = "hover";}
      u.appendChild(l);
    }
    b.appendChild(u);
    document.body.appendChild(b);
    searchVars.optsTemplate = b.innerHTML;
  }
  function overSearchOpt(i){
    searchVars.index = i;
    $("searchOpt_"+searchVars.index).className = "hover";
  }
  function outSearchOpt(i){
    $("searchOpt_"+searchVars.index).className = "";
  }
  function initSearchOpts(){
    if(!$("searchOpts")){makeSearchOpts();}
    var o = $("searchOpts");
    o.hide();
  }

  function updateSearchOpts(){
    var searchOpts = $("searchOpts");
    if($F("searchBox")==''){
      searchOpts.hide();
    }else {
      updateOptsKeywords();
      if(!searchOpts.visible()){
        showSearchOpts();
        searchVars.index = 0;
      }
    }
  }

  function updateOptsKeywords(){
    $("searchOpts").innerHTML = searchVars.optsTemplate.replace(/_KEYWORD_/g, "<strong>"+$F("searchBox")+"</strong>");
  }

  function enableSearchOpts(){
    var searchBox = $("searchBox");
    searchBox.onkeyup = searchKeyup;
    searchBox.onkeydown = searchKeydown;
    if(searchBox.value==searchVars.tip){
      searchBox.value = '';
      searchBox.setStyle({"color":"#000"});
    }
    initSearchOpts();
  }

  function disableSearchOpts(){
    var searchBox = $("searchBox");
    searchBox.onkeyup = null;
    searchBox.onkeydown = null;
    hideSearchOpts();
    if(searchBox.value==''){
      searchBox.value = searchVars.tip;
      searchBox.setStyle({"color":"#999"});
    }
  }

  function showSearchOpts(){
    var searchOpts = $("searchOpts");
    searchOpts.show();
    var p = Element.cumulativeOffset($("searchBox"));
    searchOpts.setStyle({
      "position":"absolute",
      "left":p[0]+"px",
      "top":p[1]+$("searchBox").getHeight()+1+"px",
      "zIndex":999
    });
    if(!$("searchOptsIframe")){
      document.body.appendChild(new Element('iframe', {id: "searchOptsIframe"}));
    }
    var ifra = $("searchOptsIframe");
    p = Position.cumulativeOffset(searchOpts);
    ifra.setStyle({
      position:'absolute',
      border:0,
      frameborder:'no',
      left: p[0]+"px",
      top: p[1]+"px",
      width: searchOpts.getWidth()+"px",
      height: searchOpts.getHeight()+"px",
      zIndex: "998"
    });
    Event.observe(window, 'resize', showSearchOpts);
  }

  function hideSearchOpts(){
    setTimeout(function(){
      $("searchOpts").hide();
      var ifra = $("searchOptsIframe");
      if(ifra){ifra.hide();}
      Event.stopObserving(window, 'resize', showSearchOpts);
    }, 300);
  }

  function searchKeydown(e){
    var keycode;
    if (window.event){keycode = window.event.keyCode;} else if (e){keycode = e.which}
    // tab
    if(keycode==9) {
      if(!$("searchOpts").visible()){return true;}
      var searchBox = $("searchBox");
      var currentOpt = $("searchOpt_"+searchVars.index);
      if(currentOpt){currentOpt.className = "";}
      var nextOpt = $("searchOpt_"+(searchVars.index+1));
      if(nextOpt){
        nextOpt.className = "hover";
        searchVars.index = searchVars.index+1;
      }else{
        searchVars.index = -1;
      }
      searchBox.focus();
      return false;
    }
  }

  function searchKeyup(e){
    var keycode;
    if (window.event){keycode = window.event.keyCode;} else if (e){keycode = e.which}
    switch(keycode){
      case 40: {// down
          var currentOpt = $("searchOpt_"+searchVars.index);
          if(currentOpt){currentOpt.className = "";}
          var nextOpt = $("searchOpt_"+(searchVars.index+1));
          if(nextOpt){
            nextOpt.className = "hover";
            searchVars.index = searchVars.index+1;
          }else{
            searchVars.index = -1;
          }
        }return false;
      case 38: {// up
          var currentOpt = $("searchOpt_"+searchVars.index);
          if(currentOpt){currentOpt.className = "";}
          var nextOpt = $("searchOpt_"+(searchVars.index-1));
          if(nextOpt){
            nextOpt.className = "hover";
            searchVars.index = searchVars.index-1;
          }else{
            searchVars.index = -1;
          }
        }return false;
      case 13: {// enter
          submitSearch();
        }return false;
      case 9:{}return false;
      default:{
          updateSearchOpts();
        }return false;
    }
  }
</script>


