# Content Signals declare AI usage preferences (https://contentsignals.org/).
# Per IETF draft-romm-aipref-contentsignals, Content-Signal directives must
# appear inside a User-agent group, so they are repeated below.
#
# search=yes    Allow appearing in search results and indexes.
# ai-input=yes  Allow use as input/grounding for AI answers (e.g. RAG).
# ai-train=no   Disallow use for training AI models.

# General access
User-agent: *
Content-Signal: search=yes, ai-input=yes, ai-train=no
Allow: /
Disallow: /style-guide
Disallow: /style-guide.php

