<body>
  <div id="off-canvas-wrapper" class="off-canvas-wrapper">
    <main class="main-wrap section-pattern">


      <!-- Top navigation -->
      <div data-sticky-container class="sticky-container">



        <nav id="navigation-top-js" class="navigation-top sticky" data-sticky data-margin-top="0"
          data-sticky-on="small">
          <!-- The menu -->
          <div class="top-bar">
            <div class="row column">
              <div class="top-bar-left">

                <a href="/">
                  <img width="225" src="https://bcassetcdn.com/assets/images/designcom/logos/dcom-logo-white.svg"
                    alt="Design.com">
                </a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <section class="section">
        <div class="row column">
          <div class="frame text-left">
            <h1 id="error-title">404 - Page not found</h1>
            <h3 id="error-subtitle">Looks like this page wandered off the map. No worries - we'll get you back to where you should be shortly.</h3>
            <ul>
              <li><a href="https://www.design.com/" id="home-link">Return home</a></li>
              <li><a href="https://www.design.com/logo-maker" id="logo-maker-link">Logo maker</a></li>
              <li><a href="https://www.design.com/maker/contact" id="support-link">Contact support</a></li>
            </ul>
            <div id="error-body">
              <h4>What may have happened</h4>
              <ul>
                <li>The link you followed might be outdated or misspelled.</li>
                <li>The page could have been moved or removed while we improve the site.</li>
                <li>There may be a temporary server hiccup. Try refreshing or come back shortly.</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

    </main>

  </div>
