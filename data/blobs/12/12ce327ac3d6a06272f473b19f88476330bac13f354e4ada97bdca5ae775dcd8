        ]
      }
    };

    // Function to get the preferred language from browser
    function getPreferredLanguage() {
      // Get browser languages
      const languages = navigator.languages || [navigator.language || navigator.userLanguage];

      // Find the first supported language in the browser's language list
      for (let lang of languages) {
        // Get just the language code (e.g., 'en-US' -> 'en')
        const shortLang = lang.split('-')[0];

        // Check if this language is supported
        if (translations[shortLang]) {
          return shortLang;
        }
      }

      // Default to English if no supported language is found
      return 'en';
    }

    // Function to update the page content based on language
    function updatePageContent() {
      const lang = getPreferredLanguage();
      const content = translations[lang];

      // Update page title
      document.title = content.title;

      // Update html lang attribute
      document.documentElement.lang = lang;

      // Update content elements
      document.getElementById('error-title').innerHTML = content.h1;
      document.getElementById('error-subtitle').innerHTML = content.h3;

      // Update links
      document.getElementById('home-link').href = content.homeUrl;
      document.getElementById('home-link').textContent = content.homeText;
      document.getElementById('logo-maker-link').href = content.logoMakerUrl;
      document.getElementById('logo-maker-link').textContent = content.logoMakerText;
      document.getElementById('support-link').href = content.supportUrl;
      document.getElementById('support-link').textContent = content.supportText;

      // Update "What may have happened" section
      const errorBody = document.getElementById('error-body');
      errorBody.innerHTML = `
        <h4>${content.whatHappenedTitle}</h4>
        <ul>
          ${content.reasons.map(reason => `<li>${reason}</li>`).join('')}
        </ul>
      `;

      // Update logo link
      const logoLink = document.querySelector('a[href="/"]');
      if (logoLink) {
        logoLink.href = content.homeUrl;
      }
    }

    // Execute when the page is loaded
    document.addEventListener('DOMContentLoaded', updatePageContent);
  </script>
</body>

</html>