<!--Responsive images: keep srcset, set sizes to the drawn width so images stay sharp-->
<script>
  (function () {
    var KEEP_ORIGINAL = '[data-keep-original]';

    function fit(img) {
      if (img.tagName !== 'IMG' || !img.hasAttribute('srcset')) return;
      if (img.closest(KEEP_ORIGINAL)) {
        img.removeAttribute('srcset');
        img.removeAttribute('sizes');
        return;
      }
      // offsetWidth ignores transforms, so an image caught mid-way through a
      // scale-in animation is not handed a small file it then keeps.
      var width = Math.max(img.offsetWidth, img.getBoundingClientRect().width);
      if (!width && img.parentElement) width = img.parentElement.getBoundingClientRect().width;
      // Hidden images (closed tabs, dropdowns, popups) measure 0. They are left
      // alone here and fitted by the ResizeObserver the moment they are shown.
      if (!width) return;
      var sizes = Math.ceil(width) + 'px';
      if (img.getAttribute('sizes') !== sizes) img.setAttribute('sizes', sizes);
    }

    // Runs after layout and before paint whenever an image's box changes size:
    // first layout, window resize, breakpoint changes, a hidden image being shown.
    var sizeWatcher = window.ResizeObserver
      ? new ResizeObserver(function (entries) {
          for (var i = 0; i < entries.length; i++) fit(entries[i].target);
        })
      : null;

    function watch(img) {
      if (img.tagName !== 'IMG' || !img.hasAttribute('srcset')) return;
      if (sizeWatcher) sizeWatcher.observe(img);
      else fit(img);
    }

    function watchTree(node) {
      if (node.nodeType !== 1) return;
      if (node.tagName === 'IMG') watch(node);
      else node.querySelectorAll('img[srcset]').forEach(watch);
    }

    new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        var m = mutations[i];
        if (m.type === 'attributes') {
          watch(m.target);
          requestAnimationFrame(fit.bind(null, m.target));
        } else {
          for (var j = 0; j < m.addedNodes.length; j++) watchTree(m.addedNodes[j]);
        }
      }
    }).observe(document.documentElement, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['srcset'],
    });

    watchTree(document.documentElement);

    // Browsers without ResizeObserver re-fit on load and on resize instead.
    if (!sizeWatcher) {
      var fitAll = function () {
        document.querySelectorAll('img[srcset]').forEach(fit);
      };
      window.addEventListener('load', fitAll);
      var timer;
      window.addEventListener('resize', function () {
        clearTimeout(timer);
        timer = setTimeout(fitAll, 200);
      });
    }
  })();
</script>

