<script>
(function () {
  // Libellé personnalisé uniquement pour le brésilien
  const customNames = { "pt-BR": "Português BR" };

  // Normalise les codes renvoyés par Weglot vers un format unique
  function normalizeLangCode(code) {
    if (!code) return code;
    const key = String(code).toLowerCase().replace("_", "-");
    const aliases = {
      "br": "pt-BR",     // <— ton cas
      "pt": "pt-BR",     // si tu n’utilises que le portugais brésilien
      "pt-br": "pt-BR",
      "ptbr": "pt-BR"
    };
    return aliases[key] || code;
  }

  function loadConnectSwitcher() {
    const otherLanguages = Weglot.getAvailableLanguages().filter(l => l !== "en");
    if (!otherLanguages.length) return removeSwitchers();

    setSelectedLanguageName();
    removeExcludedLanguages();
    setTimeout(removeSelectedLanguageFromList, 50);
  }

  // Remove all switchers from an excluded page
  function removeSwitchers() {
    const switchers = document.querySelectorAll("div.language-selektor");
    switchers.forEach(switcher => {
      const container = switcher.closest(".wrap-relative-selector");
      if (!container) return;
      const replacement = document.createElement("div");
      replacement.style.setProperty("margin-right", window.getComputedStyle(container).marginRight);
      container.replaceWith(replacement);
    });
  }

  // Remove languages that are not available for current page
  function removeExcludedLanguages() {
    for (const option of document.querySelectorAll('a[href*="Weglot-"')) {
      const language = option.href.split("-").pop();
      if (!Weglot.getAvailableLanguages().includes(language)) {
        option.remove();
      }
    }
  }

  // Remove the selected language from the available options list
  function removeSelectedLanguageFromList() {
    const languageOptions = document.querySelectorAll("div.wrap-language-selector nav.w-dropdown-list a");
    for (const option of languageOptions) {
      if (option.matches(".weglot-link--active")) {
        option.style.setProperty("display", "none");
      } else {
        option.style.removeProperty("display");
      }
    }
  }

  // Close language switchers when a new language is selected
  function closeSwitcher() {
    const switchers = document.querySelectorAll("div.language-selektor");
    switchers.forEach(switcher => switcher.classList.remove("w--open"));
  }

  // Met à jour le libellé de la langue active
  function setSelectedLanguageName() {
    const rawLang = Weglot.getCurrentLang();     // ex: "br"
    const norm = normalizeLangCode(rawLang);     // -> "pt-BR"
    const official = Weglot.getLanguageName(rawLang);
    const finalName = customNames[norm] || official;

    const selectedElements = document.querySelectorAll("div.language-selektor div");
    for (const el of selectedElements) {
      // Si l'UI attend un code sur 2 caractères, on affiche la partie région si présente (BR), sinon le code (EN/FR)
      if (el.textContent.trim().length === 2) {
        const regionOrCode = (norm.includes("-") ? norm.split("-").pop() : norm).slice(0,2).toUpperCase();
        el.textContent = regionOrCode; // "BR" pour pt-BR, "EN" pour en, etc.
      } else {
        el.textContent = finalName;    // "Português BR" pour pt-BR
      }
    }
  }

  // Réapplique le libellé si Weglot réécrit après coup
  function attachObservers() {
    const targets = document.querySelectorAll("div.language-selektor");
    targets.forEach(t => {
      const obs = new MutationObserver(() => setSelectedLanguageName());
      obs.observe(t, { childList: true, subtree: true, characterData: true });
    });
  }

  // Hooks Weglot
  Weglot.on("initialized", () => {
    setTimeout(() => {
      loadConnectSwitcher();
      attachObservers();
    }, 0);
  });

  Weglot.on("languageChanged", () => {
    setTimeout(() => {
      setSelectedLanguageName();
      removeSelectedLanguageFromList();
      closeSwitcher();
    }, 0);
  });
})();
</script>




