<script>
/*
  Objectif :
  - Si l'URL contient ?fpr=xxx et pas encore kfl_ln
  - Alors on duplique fpr dans kfl_ln et on met à jour l'URL (sans reload)

  Notes perf :
  - 0 accès DOM / 0 boucle / 0 dépendance
  - Early exit si pas de "?fpr=" dans la chaîne (évite la création d'objet URL)
  - replaceState n’entraîne pas de rechargement, donc impact imperceptible
*/
(function () {
  try {
    // Early exit hyper-rapide : si la chaîne n'a pas "fpr", on sort tout de suite
    // (évite new URL(...) inutile sur 99% des pages sans paramètre)
    if (!window.location.search || window.location.search.indexOf('fpr=') === -1) return;
    if (window.location.search.indexOf('kfl_ln=') !== -1) return;

    // Utilisation sûre de l'API URL une fois qu'on sait que c'est pertinent
    var url = new URL(window.location.href);
    var params = url.searchParams;
    var fprValue = params.get('fpr');

    // Si fpr existe et kfl_ln n'est pas encore présent, on le pose
    if (fprValue && !params.has('kfl_ln')) {
      params.set('kfl_ln', fprValue);

      // Reconstruit l'URL complète (conserve hash, chemin, etc.)
      var newUrl = url.origin + url.pathname + '?' + params.toString() + (url.hash || '');

      // Mise à jour propre sans rechargement
      window.history.replaceState({}, '', newUrl);
    }
  } catch (e) {
    // En cas de vieux navigateurs/edge cases, on ne casse rien
    // (Option : logger e si besoin de debug)
  }
})();
</script>

