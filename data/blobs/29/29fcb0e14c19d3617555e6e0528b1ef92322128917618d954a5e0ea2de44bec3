<script>
  (async () => {
    const data = await fetch('https://shop.mcn.ru/api/protected/cart', { 
      method: 'get', 
      credentials: 'include' 
    })
    const parsedData = await data.json()
    const btnBuy = document.getElementById('btnBuy')
    const btnBasket = document.getElementById('btnBasket')
    const btnBuyMob = document.getElementById('btnBuyMob')
    const btnBasketMob = document.getElementById('btnBasketMob')

    btnBuy.style.marginLeft = "auto"

    function btnBasketNone() {
      btnBuy.style.display = 'flex'
      btnBasket.style.display = 'none'
      btnBuyMob.style.display = 'flex'
      btnBasketMob.style.display = 'none'
    }

    function btnBuyNone() {
      btnBuy.style.display = 'none'
      btnBasket.style.display = 'flex'
      btnBuyMob.style.display = 'none'
      btnBasketMob.style.display = 'flex'
    }

    console.log(parsedData.items)

    if (parsedData.items.length === 0) {
      btnBasketNone()
    }
    else {
      let count = 0
      // if (typeof (parsedData.chatofon) === 'object' && parsedData.chatofon !== null && parsedData.chatofon.length !== 0) {
      //   count += 1
      // }
      // if (typeof (parsedData.vpbx) === 'object' && parsedData.vpbx !== null && parsedData.vpbx.length !== 0) {
      //   count += 1
      // }
      
      if (parsedData.items !== []) {
        count += parsedData.items.length;
      }
      if (count == 0) {
        btnBasketNone()
      } else {
        btnBuyNone()
      }

      const element = document.getElementById('basket-btn')
      let span = document.createElement('span')
      span.classList.add('items-counter')
      span.textContent = count;
      element.appendChild(span)
      const elementMob = document.getElementById('basket-btn-mob')
      let span2 = document.createElement('span')
      span2.classList.add('items-counter')
      span2.textContent = count;
      elementMob.appendChild(span2)
    }

  })();
</script>

