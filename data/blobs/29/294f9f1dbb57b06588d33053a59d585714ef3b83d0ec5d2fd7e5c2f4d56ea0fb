<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
    <head>
        <title>Instant-Gaming.com - Oops</title>
        <meta name="robots" content="index,follow,all" />
        <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1.0, maximum-scale=1">
        <link rel="shortcut icon" type="image/png" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
        <link href="https://plus.google.com/+InstantgamingPC" rel="publisher" />
        <script src="/themes/igv2/js/jquery-3.6.3.min.js"></script>
        <script>
            $(function () {
                $('.link').hover(function () {
                    $('#rotate').toggleClass('hide');
                });
            });
        </script>
        <style type="text/css">
            @font-face {
                src: url('https://www.instant-gaming.com/themes/igv2/fonts/barlow-regular.woff2') format('woff2');
                font-family: barlow;
                font-weight: normal;
                font-display: swap;
            }
            @font-face {
                src: url('https://www.instant-gaming.com/themes/igv2/fonts/barlow-medium.woff2') format('woff2');
                font-family: barlow;
                font-weight: bold;
                font-display: swap;
            }

            html,
            body {
                font-family: barlow, arial, sans-serif;
                font-weight: normal;
                height: 100%;
                background-color: #272727;
                position: relative;
                margin: 0;
                padding: 0;
                color:  #ff5400;
            }
            body {
                display: flex;
                align-content: center;
                justify-content: center;
                overflow: hidden;
            }
            body .content {
                display: flex;
                flex-direction: column;
                justify-content: center;
                margin-top: -15px;
                backdrop-filter: blur(10px) saturate(100%);
                -webkit-backdrop-filter: blur(10px) saturate(100%);
                background-color: rgba(0,0,0,.5);
                align-self: center;
                width: 230px;
                height: 230px;
                border-radius: 100%;
                overflow: hidden;
                top: 5px;
                position: relative;
                text-decoration: none;
                text-transform: uppercase;
                font-weight: bold;
                gap: 10px;
            }
            body .content * {
                align-self: center;
            }
            body .content .e404 {
                margin-top: -25px;
                font-size: 50px;
                font-weight: bold;
                line-height: 40px;
            }
            body .content .rage {
                font-size: 14.5px;
            }
            body .content .action {
                font-size: 15px;
                color: #ff5400;
                text-decoration: underline;
            }
            body .rotate {
                position: absolute;
                top: -1000px;
                left: -1000px;
                right: -1000px;
                bottom: -1000px;
                transform: rotate(120deg);
                animation: rotating 100s linear infinite;
            }
            body .rotate.hide .top {
                bottom: -14px;
            }
            body .rotate.hide .bottom {
                top: -14px;
            }
            body .rotate .top {
                background: url(/themes/igv2/images/404top.svg) bottom center no-repeat;
                background-size: 40px;
                width: 100%;
                height: calc(50%);
                z-index: 1;
                position: relative;
                transition: .2s;
                bottom: 150px;
            }
            body .rotate .bottom {
                background: url(/themes/igv2/images/404bottom.svg) top center no-repeat;
                background-size: 40px;
                width: 100%;
                height: calc(50%);
                transition: .2s;
                position: relative;
                top: 150px;
            }
            body .logo-ig {
                position: absolute;
                left: 30px;
                z-index: 1;
                background-image: url('/themes/igv2/images/logos/logo-instant-gaming.svg');
                background-size: 100%;
                background-repeat: no-repeat;
                width: 135px;
                aspect-ratio: 17.5 / 5;
            }
            body img {
                position: absolute;
                left: 50%;
                top: 50%;
            }
            body a {
                color: #ff5400;
                font-size: 15px;
                margin-top: 21px;

            }
            @keyframes rotating {
                from {
                    transform: rotate(0deg);
                }
                to {
                    transform: rotate(360deg);
                }
            }
        </style>
    </head>
    <body>
        <a href="/" class="logo-ig link"></a>

        <div class="rotate" id="rotate">
            <div class="top"></div>
            <div class="bottom"></div>
        </div>

        <a class="content link" href="/">
            <span class="e404">4O4</span>
            <span class="error">PAGE NOT FOUND</span>
            <span class="action">Click here to continue</span>
        </a>
    </body>
</html>
