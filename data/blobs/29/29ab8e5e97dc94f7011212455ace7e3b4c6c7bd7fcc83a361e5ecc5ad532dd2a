/** changes for download category **/

/* Base grid setup */
.tax-download_category .site-main {
  display: flex;
  flex-wrap: wrap;
  /* creates room for side margins on items */
  margin-left: -15px;
  margin-right: -15px;
}

/* Base card styles (kept exactly as you had) */
.tax-download_category .site-main article {
  /* mobile: single column */
  flex: 1 1 calc(100% - 30px);
  margin: 0 15px 20px;

  border: 10px solid #fff;
  background: #fff;
  -webkit-box-shadow: 0 2px 2px rgba(0, 0, 0, .08);
  box-shadow: 0 2px 2px rgba(0, 0, 0, .08);
  -webkit-border-radius: 4px;
  border-radius: 4px;
}

/* Title + icons (kept) */
.tax-download_category .site-main .entry-title {
  font-size: 1.2em;
}
.tax-download_category .entry-footer svg {
 display: none;
}

/* ≥768px: two columns */
@media (min-width: 768px) {
  .tax-download_category .site-main article {
    -webkit-flex-basis: calc((100% / 2) - 30px);
    flex-basis: calc((100% / 2) - 30px);
  }
}

/* ≥1024px: three columns with a 60px gutter (30px left + 30px right) */
@media (min-width: 1024px) {
  .tax-download_category .site-main article {
    margin-left: 30px;
    margin-right: 30px;
    -webkit-flex-basis: calc((100% / 3) - 60px);
    flex-basis: calc((100% / 3) - 60px);
  }
}

/* ≤1600px: keep three columns but tighten gutter to 45px (22.5px each side)
   — this reproduces your exact max-width:1600px rule */
@media only screen and (max-width: 1600px) and (min-width: 1024px) {
  .tax-download_category .site-main article {
    margin-left: 22.5px;
    margin-right: 22.5px;
    -webkit-flex-basis: calc((100% / 3) - 45px);
    flex-basis: calc((100% / 3) - 45px);
  }
}

/* Optional: slightly smaller title on very small screens */
@media (max-width: 400px) {
  .tax-download_category .site-main .entry-title {
    font-size: 1.1em;
  }
}

