	( function () {
		const config = window.mngAdFree7DayConfig;
		if ( ! config ) {
			return;
		}

		function currentUserId() {
			const parts = document.cookie ? document.cookie.split( ';' ) : [];
			for ( let i = 0; i < parts.length; i++ ) {
				const pair = parts[ i ].split( '=' );
				if ( pair[ 0 ].trim() === config.userCookie ) {
					try {
						return decodeURIComponent( pair.slice( 1 ).join( '=' ) );
					} catch ( e ) {
						return '';
					}
				}
			}
			return '';
		}

		function decodeJwtPayload( token ) {
			try {
				const segment = token.split( '.' )[ 1 ];
				if ( ! segment ) {
					return null;
				}
				let b64 = segment.replace( /-/g, '+' ).replace( /_/g, '/' );
				while ( b64.length % 4 ) {
					b64 += '=';
				}
				return JSON.parse( atob( b64 ) );
			} catch ( e ) {
				return null;
			}
		}

		function entitlementClaims() {
			try {
				const session = JSON.parse(
					window.localStorage.getItem( config.sessionKey ) || '{}'
				);
				return ( session.entitlementToken &&
					decodeJwtPayload( session.entitlementToken ) ) || {};
			} catch ( e ) {
				return {};
			}
		}

