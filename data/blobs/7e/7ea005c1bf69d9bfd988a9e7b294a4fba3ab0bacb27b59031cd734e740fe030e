		let originalIsUserAdFree = window.MNGAuthentication.isUserAdFree;

		// Existing ad-free users (premium, employees, ad-free templates)
		// must stay ad-free even if they are not in this experiment.
		function underlyingSaysAdFree() {
			if ( originalIsUserAdFree === true ) {
				return true;
			}
			if ( typeof originalIsUserAdFree === 'function' ) {
				return !! originalIsUserAdFree.call( window.MNGAuthentication );
			}
			return false;
		}

		function isUserAdFree() {
			return underlyingSaysAdFree() || readCachedEnabled();
		}

