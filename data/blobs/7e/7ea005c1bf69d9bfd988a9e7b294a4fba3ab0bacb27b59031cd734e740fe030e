		// datafile. Still resolves after this page's ad scripts have run,
		// so the arm applies from the next page view.
		function resolve() {
			ensureLogoutClear();
			const visor = window.mngfeatures && window.mngfeatures.visor;
			if ( ! visor ) {
				return;
			}
			const userId = currentUserId();
			const claims = entitlementClaims();
			if ( ! userId || ! claims.entitlement_level ) {
				return;
			}
			const level = String( claims.entitlement_level ).trim().toLowerCase();
			const service = String( claims.entitlement_serviceCode || 'unknown' ).trim();

			const enabled = visor.isEnabled( config.flagId, {
				userId: userId,
				subscriptionLevel: level + '-' + service
			} );
			writeCachedEnabled( enabled );
		}

		ensureLogoutClear();

		// Whichever fires first: the session may land before the datafile
		// or after it.
		if ( window.mngfeatures && window.mngfeatures.visor ) {
			resolve();
		}
		window.addEventListener( 'mng-feature-flags-init', resolve );
		window.addEventListener( 'mng-feature-flags-ready', resolve );
	} )();
