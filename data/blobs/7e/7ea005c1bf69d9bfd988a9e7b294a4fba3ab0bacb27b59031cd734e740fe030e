			try {
				window.localStorage.removeItem( config.cacheKey );
			} catch ( e ) {}
		}

		// Bound to the reader it was resolved for, so it cannot outlive a
		// logout or leak on a shared device. Positive results expire after TTL.
		function readCachedEnabled() {
			try {
				const raw = window.localStorage.getItem( config.cacheKey );
				if ( ! raw ) {
					return false;
				}
				const cached = JSON.parse( raw );
				const userId = currentUserId();
				if (
					! userId ||
					cached.userId !== userId ||
					cached.enabled !== true ||
					! cached.expiresAt ||
					Date.now() > cached.expiresAt
				) {
					clearCachedEnabled();
					return false;
				}
				return true;
			} catch ( e ) {
				clearCachedEnabled();
				return false;
			}
		}

		function writeCachedEnabled( enabled ) {
			if ( ! enabled ) {
				clearCachedEnabled();
				return;
			}
			try {
				const userId = currentUserId();
				if ( ! userId ) {
					clearCachedEnabled();
					return;
				}
				window.localStorage.setItem( config.cacheKey, JSON.stringify( {
					userId: userId,
					enabled: true,
					expiresAt: Date.now() + config.cacheTtlMs
				} ) );
			} catch ( e ) {}
		}

		function ensureLogoutClear() {
			window.MNGAuthentication = window.MNGAuthentication || {};
			const callbacks = window.MNGAuthentication.logoutCallbacks;
			if (
				Array.isArray( callbacks ) &&
				callbacks.indexOf( clearCachedEnabled ) === -1
