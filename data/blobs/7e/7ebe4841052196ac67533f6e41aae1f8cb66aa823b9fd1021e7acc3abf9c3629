/* =========================================
   Persona links
   Faculty & Staff / NTU Students
   ========================================= */

.site-header-revamp__profiles .profile-selector ul {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
}

.site-header-revamp__profiles .profile-selector li {
    margin: 0;
    padding: 0;
    list-style: none;
}

.site-header-revamp__profiles .profile-selector li a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 6px 10px;
    border-radius: 4px;
    color: #4a4a4a;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition:
        color 0.2s ease,
        background-color 0.2s ease;
}

/* Small arrow to indicate that the item is clickable */
.site-header-revamp__profiles .profile-selector li a::after {
    content: "›";
    color: #777;
    font-size: 16px;
    font-weight: 400;
    line-height: 1;
    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

/* Hover and keyboard focus */
.site-header-revamp__profiles .profile-selector li a:hover,
.site-header-revamp__profiles .profile-selector li a:focus-visible {
    color: #00005b;
    background-color: #f1f2f8;
    text-decoration: none;
}

.site-header-revamp__profiles .profile-selector li a:hover::after,
.site-header-revamp__profiles .profile-selector li a:focus-visible::after {
    color: #00005b;
    transform: translateX(2px);
}

.site-header-revamp__profiles .profile-selector li a:focus-visible {
    outline: 2px solid #00005b;
    outline-offset: 2px;
}

/* Keep visited links consistent */
.site-header-revamp__profiles .profile-selector li a:visited {
    color: #4a4a4a;
}

.site-header-revamp__profiles .profile-selector li a:visited:hover,
.site-header-revamp__profiles .profile-selector li a:visited:focus-visible {
    color: #00005b;
}

/* =========================================
   Desktop only
   Divider only between the two actual links
   ========================================= */

@media (min-width: 768px) {
    /* Ensure there is no divider after the non-link profile label */
    .site-header-revamp__profiles #profile-label + li {
        margin-left: 0;
        padding-left: 0;
    }

    .site-header-revamp__profiles #profile-label + li::before {
        content: none !important;
        display: none !important;
    }

    /* Divider before NTU Students only */
    .site-header-revamp__profiles #profile-label + li + li {
        position: relative;
        margin-left: 2px;
        padding-left: 4px;
    }

    .site-header-revamp__profiles #profile-label + li + li::before {
        content: "";
        display: block;
        position: absolute;
        left: 0;
        top: 25%;
        width: 1px;
        height: 50%;
        background-color: #d5d5d5;
    }
}
