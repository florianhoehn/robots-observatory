# VAZNO — kako se ovdje stvarno kontrolise Google:
# Googlebot ima vlastitu grupu nize (Allow: /). Po pravilima robots.txt-a crawler
# koristi SAMO grupu sa najspecificnijim user-agentom koji ga opisuje i ignorise
# sve ostale — dakle Googlebot NE vidi nijedan Disallow iz "User-agent: *".
# Za Googlebota indeksiranje se kontrolise <meta name="robots" content="noindex">
# u view-ovima, ne ovdje. Disallow-i ispod vrijede za ostale crawlere.
#
# NE dodavati Disallow za stranice koje se oslanjaju na noindex (npr. komentari):
# Google mora moci dohvatiti stranicu da bi uopste vidio noindex. Blokiras li je
# prije nego ispadne iz indeksa, zamrznes postojeci unos zauvijek.
User-agent: *
Disallow: /pretraga
Disallow: /komentari/*
Disallow: /xplayer
Disallow: /xplayer2
Disallow: /redirect/*
Disallow: /api/*

# Allow Google crawlers full access
#
# Disallow: /redirect/ mora stajati OVDJE, ne u "User-agent: *" — Googlebot cita
# samo ovu grupu. CMS svaki vanjski link u clanku upise kao /redirect/{sifra}?url=…
# pa je to milionski crawlabilan prostor koji nikad ne moze biti indeksiran.
# Duzi path pobjeduje nad "Allow: /", pa ostalo ostaje dozvoljeno.
User-agent: Googlebot
Allow: /
Disallow: /redirect/
User-agent: Googlebot-Image
Allow: /
Disallow: /redirect/

