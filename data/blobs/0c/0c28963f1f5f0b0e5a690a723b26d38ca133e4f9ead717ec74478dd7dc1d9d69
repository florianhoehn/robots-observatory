<script>
function styleToClass(className) {
  const targetElement = $(`.${className}`);

  if (targetElement.length > 0) {
	const inlineStyle = targetElement.attr("style");

	if (inlineStyle) {
	  targetElement.removeClass(className).addClass(className).removeAttr("style");
	  const cssRule = `.${className} { ${inlineStyle} }`;

	  const styleSheet = document.styleSheets[0];
	  if (styleSheet.insertRule) {
		styleSheet.insertRule(cssRule, styleSheet.cssRules.length);
	  } else if (styleSheet.addRule) {
		styleSheet.addRule(cssRule, -1);
	  }
	}
  }
}
</script>

