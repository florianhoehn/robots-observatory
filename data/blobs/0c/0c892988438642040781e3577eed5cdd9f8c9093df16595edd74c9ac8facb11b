        letter-spacing: -0.4px;
        color: rgba(0, 0, 0, 0.9);
        }

      p {
        font-size: 17px;
        line-height: 24px;
        text-align: center;
        color: rgba(0, 0, 0, 0.59);
      }

      .error-correlation-id-container p {
        font-size: 14px;
        line-height: 20px;
        text-align: center;
        color: rgba(0, 0, 0, 0.59);
      }

      .bluelink {
