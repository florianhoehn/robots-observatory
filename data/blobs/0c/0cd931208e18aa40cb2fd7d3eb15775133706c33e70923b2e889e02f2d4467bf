					<script>
        function handleCookieLogic() {
          const hasToken = document.cookie.split('; ').some(cookie => cookie.startsWith('PL24TOKEN='));
          const isIndexPage = window.location.pathname === '/en/index.html';

          // if user is logged in and on index page, navigate to /portal-ui
          if (hasToken && isIndexPage) {
            const redirect = new URLSearchParams(window.location.search).get('redirect');
            window.location = '/portal-ui' + (redirect ? '?redirect=' + encodeURIComponent(redirect) : '');
          }
        }

                window.addEventListener('DOMContentLoaded', () => {
          const hasToken = document.cookie.split('; ').some(cookie => cookie.startsWith('PL24TOKEN='));
          if (!hasToken) {
            document.querySelector('.nav__item--login')?.removeAttribute('data-logged-in');
          }
        });

        window.addEventListener('pageshow', (event) => {
          if (event.persisted) {
            handleCookieLogic();
          };
        });

        handleCookieLogic();
			</script>

