            }
        });
        return {'listName': pathname, 'productArray': productArray}
    }

    function determineProductDetails(description) {
        var rawName = description.slice(0, description.lastIndexOf(" ")); // Input examples: "Annual all (EUR)", "Monthly (USD)"
        var productName = "";                                             // Desired output: "Annual all"      , "Monthly"
        var productVariant = "";
        switch (rawName) {
            case "Monthly":
                productName = "Worthopedia®";
                productVariant = "Monthly";
                break;
            case "Annual":
                productName = "Worthopedia®";
                productVariant = "Annual";
                break;
            case "Monthly lib":
                if (window.location.pathname.indexOf("library") > -1) {
                    productName = "Library";
                } else {
                    productName = "Marks & Library";
                }
                productVariant = "Monthly";
                break;
            case "Annual lib":
                if (window.location.pathname.indexOf("library") > -1) {
                    productName = "Library";
                } else {
                    productName = "Marks & Library";
                }
                productVariant = "Annual";
                break;
            case "Monthly Marks":
                productName = "Marks";
                productVariant = "Monthly";
                break;
            case "Annual Marks":
                productName = "Marks";
                productVariant = "Annual";
                break;
            case "Monthly all":
                productName = "Worthopedia® + Marks & Library";
                productVariant = "Monthly";
                break;
            case "Annual all":
                productName = "Worthopedia® + Marks & Library";
                productVariant = "Annual";
                break;
        }
        return {name: productName, variant: productVariant};
    }
</script>
    
    
