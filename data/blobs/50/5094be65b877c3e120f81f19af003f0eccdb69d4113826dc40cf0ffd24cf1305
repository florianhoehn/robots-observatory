                    productArray.push(
                        {
                            'name': 'Marks',
                            'price': monthlyPrices[0],
                            'variant': 'Monthly',
                            'list': pathname
                        }
                    );
                    break;
                case "div_MAPS-usd-annual":
                    productArray.push(
                        {
                            'name': 'Marks',
                            'price': annualPrices[0],
                            'variant': 'Annual',
                            'list': pathname
                        }
                    );
                    break;
                case "div_LIB-usd-monthly":
                    productArray.push(
                        {
                            'name': 'Library',
                            'price': monthlyPrices[0],
                            'variant': 'Monthly',
                            'list': pathname
                        }
                    );
                    break;
                case "div_LIB-usd-annual":
                    productArray.push(
                        {
                            'name': 'Library',
                            'price': annualPrices[0],
                            'variant': 'Annual',
                            'list': pathname
                        }
                    );
                    break;
                case "div_All-usd-monthly":
                    productArray.push(
                        {
                            'name': 'Worthopedia® + Marks & Library',
                            'price': monthlyPrices[2],
                            'variant': 'Monthly',
