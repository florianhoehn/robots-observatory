    .continue { background: #24264a; box-shadow: 0 18px 44px rgba(31, 31, 40, .16); color: #fbf8f2; display: grid; grid-template-columns: minmax(0, 1fr) clamp(230px, 28vw, 300px); margin-top: clamp(28px, 4vw, 40px); max-width: 900px; overflow: hidden; text-decoration: none; transform: translateY(0); transition: box-shadow .2s ease, transform .2s ease; width: 100%; }
    .continue-copy { display: block; min-width: 0; padding: clamp(24px, 3vw, 34px); }
    .continue-meta { color: #c7c8dc; display: block; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 10px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .continue-title { display: block; font-size: clamp(27px, 3vw, 38px); font-weight: 750; letter-spacing: -.035em; line-height: 1.04; margin-top: 12px; max-width: 510px; }
    .continue-note { color: #d7d7e2; display: block; font-size: 13px; line-height: 1.45; margin-top: 12px; max-width: 500px; }
    .continue-command { align-items: center; background: #ff7654; color: #191a2a; display: flex; font-size: clamp(16px, 1.6vw, 19px); font-weight: 800; gap: 18px; justify-content: space-between; letter-spacing: -.015em; line-height: 1.15; padding: clamp(24px, 3vw, 34px); transition: background-color .2s ease; }
    .continue-arrow { align-items: center; background: rgba(36, 38, 74, .12); border-radius: 50%; display: flex; flex: 0 0 auto; font-family: ui-sans-serif, system-ui, sans-serif; font-size: 21px; height: 46px; justify-content: center; transition: background-color .2s ease, transform .2s ease; width: 46px; }
    .continue:hover { box-shadow: 0 24px 58px rgba(31, 31, 40, .23); transform: translateY(-3px); }
    .continue:hover .continue-command { background: #ff896c; }
    .continue:hover .continue-arrow { background: rgba(36, 38, 74, .19); transform: translate(3px, -3px); }
    .continue:active { box-shadow: 0 15px 36px rgba(31, 31, 40, .18); transform: translateY(-1px); }
    .continue:focus-visible { outline: 3px solid #ff7654; outline-offset: 6px; }
    @media (prefers-reduced-motion: reduce) {
      .continue, .continue-arrow, .continue-command { transition: none; }
      .continue:hover { transform: none; }
      .continue:hover .continue-arrow { transform: none; }
    }
    @media (max-width: 700px) {
      .continue { grid-template-columns: 1fr; }
      .continue-command { border-top: 1px dashed rgba(36, 38, 74, .28); }
    }
    @media (max-width: 540px) {
      main { padding: 34px 20px; }
