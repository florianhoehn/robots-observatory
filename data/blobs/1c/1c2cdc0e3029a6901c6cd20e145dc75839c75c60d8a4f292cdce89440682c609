      .eyebrow { margin-bottom: 20px; }
      h1 { font-size: clamp(38px, 11.5vw, 44px); line-height: .98; }
      .summary { gap: 9px; grid-template-columns: 1fr; margin-top: 26px; padding-top: 14px; }
      .summary p { max-width: 300px; }
      .continue { margin-top: 26px; }
      .continue-copy { padding: 22px; }
      .continue-title { font-size: clamp(27px, 8.7vw, 32px); margin-top: 10px; }
      .continue-note { font-size: 12px; margin-top: 10px; max-width: 270px; }
      .continue-command { font-size: 16px; padding: 17px 22px; }
      .continue-arrow { font-size: 19px; height: 40px; width: 40px; }
    }
