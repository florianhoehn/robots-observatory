    .eyebrow { color: #706c67; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 10px; font-weight: 700; letter-spacing: .13em; margin: 0 0 clamp(22px, 3vw, 34px); text-transform: uppercase; }
