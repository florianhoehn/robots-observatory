    body { background: #edeae4; color: #1a1d1e; margin: 0; min-height: 100vh; min-height: 100svh; width: 100%; }
    main { display: flex; flex-direction: column; justify-content: center; margin: 0 auto; max-width: 1184px; min-height: 100vh; min-height: 100svh; min-width: 0; padding: clamp(28px, 5vw, 72px) clamp(24px, 8vw, 132px); width: 100%; }
