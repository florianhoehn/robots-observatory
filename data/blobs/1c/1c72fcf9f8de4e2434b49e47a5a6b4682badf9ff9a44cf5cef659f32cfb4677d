    <script src="https://i.tmgrup.com.tr/tmg/turkuvazmedyagrubu/assets/js/jquery.fancybox.pack.js"></script>
    <script>
        $(function() {
            // CLOSE AND REMOVE ON ESC
            $(document).on('keyup',function(e) {
                if (e.keyCode == 27) {
                    $('.overlays').remove();
                }
            });

            // CLOSE AND REMOVE ON CLICK
            $('body').on('click','.overlays, .closes', function() {
                $('.overlays').remove();
            });

            // SO PLAYING WITH THE VIDEO CONTROLS DOES NOT
            // CLOSE THE POPUP
            $('body').on('click','.videoBox', function(e) {
                e.stopPropagation();
            });
        });
    </script>

    <script>
        $(function() {
            var advertisement = $.cookie("advertisement");
            if (advertisement) {
                $(".overlays").hide();
            }

            //console.log(TOKEN);
            $( ".closes" ).click(function() {
                var advertisementValue = $.md5('turkuvazmedyagrubu.com', 'key');
                if(!advertisement) {
                    $.cookie('advertisement', advertisementValue, { expires: 1, path: '/' });
                }
                $(".overlays").hide();
            });
        });
    </script>

