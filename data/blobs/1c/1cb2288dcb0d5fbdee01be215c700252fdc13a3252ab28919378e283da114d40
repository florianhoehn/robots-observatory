<section class="strip" aria-label="Websites made with Mobirise">
  <div class="strip-row">
    <img src="static/sites/ascent-480.webp" loading="lazy" decoding="async" srcset="static/sites/ascent-480.webp 480w, static/sites/ascent-720.webp 720w" sizes="(max-width:720px) 160px, 18vw" width="720" height="960" alt="Business consulting website made with Mobirise">
