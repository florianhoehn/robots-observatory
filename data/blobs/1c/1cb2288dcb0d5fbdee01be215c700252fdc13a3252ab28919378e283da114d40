<style>
@font-face{font-family:'Google Sans';font-style:normal;font-weight:400 500;font-display:swap;src:url(static/fonts/google-sans-latin.woff2) format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191-2193,U+2212,U+2215,U+FEFF,U+FFFD}
:root{--ink:#101010;--ink-2:#565c66;--rule:#101010;--hair:#dfe3e8;--coral:#df555d;--coral-btn:#c9464e;--coral-btn-2:#b03d45;--coral-soft:#fbe6e7;--indigo:#6569b0;--indigo-2:#53579c;--indigo-soft:#e4e5f3;--teal:#208c93;--teal-soft:#d6f4f5;--canvas:#eaf4ff;--tile:#f7f7f7}
*{box-sizing:border-box;margin:0}
body{font-family:'Google Sans',system-ui,sans-serif;color:var(--ink);background:#fff;line-height:1.5;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img,video{display:block;max-width:100%}
button{font:inherit;cursor:pointer}
.wrap{max-width:1320px;margin:0 auto;padding:0 40px}
html{scroll-behavior:smooth}
[id]{scroll-margin-top:90px}

/* header */
.hdr{position:sticky;top:0;z-index:50;background:var(--canvas);transition:background .2s}
.hdr.scrolled{background:#fff}
.hdr .wrap{display:flex;align-items:center;height:76px;gap:44px}
.logo{display:flex;align-items:center;gap:9px;font-weight:500;font-size:22px;letter-spacing:-.02em;white-space:nowrap}
.logo svg{width:28px;height:28px}
.hdr-r{margin-left:auto;display:flex;align-items:center;gap:26px;font-size:16px}
.hdr-r a.t{color:var(--ink-2)}.hdr-r a.t:hover{color:var(--ink)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;background:var(--coral-btn);color:#fff;border:0;border-radius:6px;font-weight:500;font-size:16px;padding:12px 20px;white-space:nowrap;transition:background .15s,opacity .15s}
.btn:hover{background:var(--coral-btn-2)}
.btn:disabled{opacity:.55;cursor:default}.btn:disabled:hover{background:var(--coral-btn)}
.btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.btn-lg{font-size:19px;padding:16px 26px}
.hdr-go{gap:0}.hdr-go .hs{white-space:pre}

/* hero with the prompt form */
.hero{padding:72px 0 72px;background:var(--canvas);text-align:center}
h1{font-size:min(112px,calc((100vw - 80px) / 10.8));line-height:.95;letter-spacing:-.055em;font-weight:500;white-space:nowrap}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.hero .lead{font-size:21px;line-height:1.45;color:var(--ink-2);max-width:680px;margin:32px auto 0}
.pf{max-width:820px;margin:40px auto 0;text-align:left}
.pf-box{background:#fff;border:1px solid var(--ink);border-radius:8px;padding:20px 20px 16px;transition:box-shadow .15s}
.pf-box:focus-within{box-shadow:0 0 0 3px rgba(101,105,176,.4)}
.pf textarea{display:block;width:100%;min-height:90px;border:0;outline:0;resize:none;padding:0;background:transparent;color:var(--ink);font:inherit;font-size:21px;line-height:1.4}
.pf textarea::placeholder{color:#7d838c}
.pf-bar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px}
.pf-err{font-size:15px;color:var(--coral-btn)}
.pf-bar .btn{margin-left:auto}

/* strip of real sites */
.strip{overflow:hidden;padding-top:56px}
.strip-row{display:flex;gap:16px;width:max-content;margin-left:50%;transform:translateX(-50%)}
.strip-row img{width:clamp(160px,18vw,290px);height:auto;aspect-ratio:3/4;object-fit:cover;object-position:50% 0;border-radius:6px;border:1px solid var(--hair);background:var(--tile)}

/* common section parts */
.sec{padding:120px 0 0}
.sec-h{display:flex;justify-content:space-between;align-items:end;gap:24px;flex-wrap:wrap;margin-bottom:40px}
h2{font-size:clamp(36px,4.6vw,68px);line-height:1;letter-spacing:-.045em;font-weight:500;max-width:900px;text-wrap:balance}
h3{font-weight:500;letter-spacing:-.02em}
.lede{font-size:20px;line-height:1.45;color:var(--ink-2);max-width:760px;margin:-8px 0 48px}

/* how it works */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.step{border-top:1px solid var(--rule);padding-top:18px}
.step b{display:block;font-size:15px;font-weight:500;color:var(--coral-btn);margin-bottom:22px}
.step h3{font-size:26px;line-height:1.15;margin-bottom:12px}
.step p{font-size:16px;color:var(--ink-2)}

/* prompt tips */
.tips{background:var(--coral-soft);padding:110px 0 100px;margin-top:120px}
.tips .sec-h{margin-bottom:24px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);column-gap:40px}
.grid3>div{border-top:1px solid rgba(16,16,16,.22);padding:20px 0 30px}
.grid3 h3{font-size:21px;margin-bottom:8px}
.grid3 p{font-size:16px;color:var(--ink-2)}

/* chat or editor */
.ways{display:grid;grid-template-columns:1fr 1fr;gap:24px}
.way{border-radius:8px;padding:36px 36px 38px}
.w-chat{background:var(--coral-soft)}.w-hand{background:var(--indigo-soft)}
.way h3{font-size:clamp(26px,2.6vw,36px);letter-spacing:-.03em;line-height:1.1;margin-bottom:14px}
.way p{font-size:18px;color:var(--ink-2);max-width:520px}

/* three roles */
.roles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.role{border-radius:8px;padding:32px 30px 30px}
.r-design{background:var(--coral-soft)}.r-copy{background:var(--indigo-soft)}.r-dev{background:var(--teal-soft)}
.role h3{font-size:clamp(26px,2.4vw,34px);letter-spacing:-.03em;line-height:1.1}
.role>p:first-of-type{font-size:17px;color:var(--ink-2);margin:10px 0 8px}
.role h4{font-size:18px;font-weight:500;letter-spacing:-.01em;margin-top:18px;padding-top:18px;border-top:1px solid rgba(16,16,16,.14)}
.role h4+p{font-size:15px;color:var(--ink-2);margin-top:6px}

/* reasons */
.uses{display:grid;grid-template-columns:1fr 1fr;column-gap:56px}
.use{display:grid;grid-template-columns:190px 1fr;gap:20px;padding:22px 0;border-top:1px solid var(--hair)}
.use h3{font-size:20px;line-height:1.25}
.use p{font-size:16px;color:var(--ink-2)}

/* chat requests */
.asks{display:grid;grid-template-columns:repeat(4,1fr);gap:40px 28px}
.ask h3{font-size:16px;font-weight:500;color:var(--ink-2);padding-bottom:14px;border-bottom:1px solid var(--rule)}
.ask p{font-size:20px;line-height:1.3;letter-spacing:-.01em;padding:18px 0;border-bottom:1px solid var(--hair)}

/* included */
.inc{display:grid;grid-template-columns:repeat(4,1fr);gap:0 28px}
.inc>div{border-top:1px solid var(--hair);padding:20px 0 28px}
.inc h3{font-size:19px;margin-bottom:6px;display:flex;align-items:center;gap:10px}
.inc h3::before{content:"";width:8px;height:8px;border-radius:2px;background:var(--teal);flex:none}
.inc p{font-size:15px;color:var(--ink-2)}

/* publish */
.pubp{background:var(--indigo-soft);border-radius:8px;padding:56px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:start}
.pubp h2{font-size:clamp(32px,3.4vw,50px)}
.pubp-t p{font-size:19px;color:var(--ink-2);margin-top:16px;max-width:480px}
.pub-list{border-top:1px solid var(--rule)}
.pub-list div{padding:20px 0;border-bottom:1px solid rgba(16,16,16,.14)}
.pub-list h3{font-size:22px;margin-bottom:6px}
.pub-list p{font-size:16px;color:var(--ink-2)}

/* prompt examples */
.ex{display:grid;grid-template-columns:1fr 1fr;column-gap:56px}
.ex-i{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:24px 0;border-top:1px solid var(--hair)}
.ex-i h3{font-size:20px;line-height:1.25}
.ex-p{font-size:17px;line-height:1.45}
.ex-b{margin-top:12px;display:inline-flex;align-items:center;gap:8px;border:0;background:none;padding:0 0 2px;font-size:16px;font-weight:500;color:var(--coral-btn);border-bottom:1.5px solid currentColor}
.ex-b:hover{color:var(--coral-btn-2)}
.ex-b svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* faq */
.faq{display:grid;grid-template-columns:1fr 1.6fr;gap:64px}
.faq h2{font-size:clamp(36px,4vw,56px)}
.faq details{border-bottom:1px solid var(--hair)}
.faq details:first-child{border-top:1px solid var(--rule)}
.faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;gap:24px;padding:22px 0;font-size:21px;font-weight:500;letter-spacing:-.01em}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:26px;line-height:1;color:var(--coral);transition:transform .2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq details p{font-size:17px;color:var(--ink-2);padding:0 0 24px;max-width:720px}
.faq details p a{color:var(--indigo-2);border-bottom:1px solid var(--indigo)}

/* closing call to action */
.cta-band{background:var(--canvas);border-radius:8px;padding:56px;display:grid;grid-template-columns:1.4fr auto;gap:40px;align-items:end}
.cta-band p{font-size:19px;color:var(--ink-2);margin-top:16px;max-width:620px}
#start{padding-bottom:110px}

/* footer */
.ftr{padding:64px 0 40px;font-size:15px;color:var(--ink-2)}
.ftr .logo{color:var(--ink)}
.ftr .cols{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:32px}
.ftr p{max-width:360px;margin-top:14px}
.ftr .fh{font-size:15px;font-weight:500;color:var(--ink);margin-bottom:12px}
.ftr li{list-style:none;margin:8px 0}.ftr ul{padding:0}
.ftr a:hover{color:var(--ink)}
.ftr .legal{margin-top:56px;padding-top:20px;border-top:1px solid var(--hair);display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:14px}

/* error dialog */
.dlg{border:0;border-radius:8px;padding:32px;max-width:440px;width:calc(100% - 32px);color:var(--ink)}
.dlg::backdrop{background:rgba(16,16,16,.45)}
.dlg h2{font-size:28px;letter-spacing:-.03em}
.dlg p{font-size:17px;color:var(--ink-2);margin:12px 0 24px}
.dlg div{display:flex;gap:12px;justify-content:flex-end;flex-wrap:wrap}
.dlg .btn-2{background:#fff;color:var(--ink);box-shadow:inset 0 0 0 1px var(--ink)}.dlg .btn-2:hover{background:var(--tile)}

@media (max-width:1100px){
  .steps,.asks{grid-template-columns:1fr 1fr}
  .grid3{grid-template-columns:1fr 1fr}
  .roles{grid-template-columns:1fr}
  .inc{grid-template-columns:repeat(2,1fr)}
  .ex{grid-template-columns:1fr}
  .faq{grid-template-columns:1fr;gap:24px}
}
@media (max-width:720px){
  .wrap{padding:0 20px}
  .hdr .wrap{height:64px;gap:12px}
  .hdr-r{gap:14px}
  .hdr-r a.t.pr{display:none}
  .hdr-r .btn{padding:10px 14px;font-size:15px}
  .hero{padding:36px 0 40px}
  h1{font-size:calc((100vw - 40px) / 10.8)}
  .hero .lead{font-size:18px;margin-top:20px}
  .pf{margin-top:24px}
  .pf-box{padding:16px 16px 14px}
  .pf textarea{font-size:19px;min-height:84px}
  .pf-bar{flex-wrap:wrap}
  .pf-bar .btn{width:100%}
  .strip{padding-top:40px}
  .sec{padding-top:80px}
  .lede{font-size:18px}
  .steps,.grid3,.ways,.roles,.inc,.asks{grid-template-columns:1fr}
  .role{padding:26px 22px}
  .ask p{font-size:18px;padding:14px 0}
  .tips{padding:72px 0 64px;margin-top:80px}
  .uses,.use,.ex-i{grid-template-columns:1fr}
  .use,.ex-i{gap:6px}
  .way{padding:26px 22px}
  .pubp{grid-template-columns:1fr;padding:30px 20px;gap:24px}
  .cta-band{grid-template-columns:1fr;padding:32px 22px}
  #start{padding-bottom:72px}
}
@media (max-width:400px){
  .hdr-r .hs{display:none}
  .ftr .cols{grid-template-columns:1fr 1fr}
  .ftr .cols>div:first-child{grid-column:span 2}
}
</style>
