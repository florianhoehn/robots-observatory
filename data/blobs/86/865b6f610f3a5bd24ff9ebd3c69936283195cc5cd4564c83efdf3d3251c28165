<script>
(function () {
  let eA_domain = 'sonnen.de';
  let eA_top = '50%';
  let eA_side = 'right';
  let eA_bottom = '50%';
  let eA_privacyPath = 'https://sonnen.de/datenschutz/';
  let eA_path = 'https://cdn.eye-able.com/';
  let eA_configPath = 'https://cdn.eye-able.com/configs/';

  let eA_bColor = '#0040fa';

  function applyBasicStyling() {
    const eAOpener = document.querySelector('#eA_Opener');
    if (eAOpener && eAOpener.shadowRoot) {
      const iconElement = eAOpener.shadowRoot.querySelector('#i');
      if (iconElement) {
      }
      
      const tooltipElements = eAOpener.shadowRoot.querySelectorAll('[id*="tooltip"], [class*="tooltip"], [id*="hint"], [class*="hint"], [id*="bubble"], [class*="bubble"]');
      tooltipElements.forEach(el => {
        el.style.display = 'none';
        el.style.visibility = 'hidden';
      });
    }
  }

  window.eyeAble_updateConfig = function () {
    if (typeof window.eyeAble_pluginConfig !== 'undefined') {
      window.eyeAble_pluginConfig.customIconColor = eA_bColor;
      window.eyeAble_pluginConfig.iconSize = 40;
      
      window.eyeAble_pluginConfig.topPosition = eA_top;
      window.eyeAble_pluginConfig.sidePosition = eA_side;
      window.eyeAble_pluginConfig.mobileBottomPosition = eA_bottom;
      
      window.eyeAble_pluginConfig.privacyPath = eA_privacyPath;
      
      window.eyeAble_pluginConfig.showBubble = false;
      window.eyeAble_pluginConfig.showInfo = false;
      window.eyeAble_pluginConfig.hideBubbleAfter = 0;
      window.eyeAble_pluginConfig.bubbleText = '';
      window.eyeAble_pluginConfig.showInfoOnFirstVisit = false;
      window.eyeAble_pluginConfig.showHint = false;
      window.eyeAble_pluginConfig.showTooltip = false;
      window.eyeAble_pluginConfig.displayHint = false;
      window.eyeAble_pluginConfig.hintText = '';
      window.eyeAble_pluginConfig.tooltipText = '';
      window.eyeAble_pluginConfig.enableTooltip = false;
      window.eyeAble_pluginConfig.autoShowHint = false;
      
      window.eyeAble_pluginConfig.firstVisit = false;
      window.eyeAble_pluginConfig.autoShow = false;
      window.eyeAble_pluginConfig.showOnLoad = false;
      window.eyeAble_pluginConfig.displayOnFirstVisit = false;
      
      window.eyeAble_pluginConfig.trigger = 'hover'; 
      window.eyeAble_pluginConfig.bubbleTrigger = 'hover';
      window.eyeAble_pluginConfig.hintTrigger = 'hover';
      window.eyeAble_pluginConfig.tooltipTrigger = 'hover';
      
      window.eyeAble_pluginConfig.autoDisplay = false;
      window.eyeAble_pluginConfig.autoDisplayBubble = false;
      window.eyeAble_pluginConfig.loadBubble = false;
    }

    setTimeout(applyBasicStyling, 100);
    
    const suppressTooltips = () => {
      applyBasicStyling();
      document.querySelectorAll('[id*="eyeable"], [class*="eyeable"], #eA_Opener').forEach(el => {
        const tooltips = el.querySelectorAll('[id*="tooltip"], [class*="tooltip"], [id*="hint"], [class*="hint"], [id*="bubble"], [class*="bubble"]');
        tooltips.forEach(tooltip => {
          tooltip.style.display = 'none !important';
          tooltip.style.visibility = 'hidden !important';
          tooltip.style.opacity = '0 !important';
          tooltip.remove();
        });
        
        if (el.shadowRoot) {
          const shadowTooltips = el.shadowRoot.querySelectorAll('[id*="tooltip"], [class*="tooltip"], [id*="hint"], [class*="hint"], [id*="bubble"], [class*="bubble"]');
          shadowTooltips.forEach(tooltip => {
            tooltip.style.display = 'none !important';
            tooltip.style.visibility = 'hidden !important';
            tooltip.style.opacity = '0 !important';
            tooltip.remove();
          });
        }
      });
    };
    
    setTimeout(suppressTooltips, 50);
    setTimeout(suppressTooltips, 200);
    setTimeout(suppressTooltips, 500);
    setTimeout(suppressTooltips, 1000);
    setTimeout(suppressTooltips, 2000);
  };

  let eA_loaded = false;
  function aEA() {
    if (!eA_loaded) {
      let eA_h = document.querySelector('head') || document.body;
      let configScript = document.createElement('script');
      let mainScript = document.createElement('script');

      configScript.src = `${eA_configPath + eA_domain}.js`;
      mainScript.src = `${eA_path}public/js/eyeAble.js`;

      configScript.onload = function () {
        eA_h.appendChild(mainScript);
      };

      eA_h.appendChild(configScript);
      eA_loaded = true;
    }
  }

  if (localStorage.getItem('eyeAbleVariables')) {
    aEA();
  } else {
    function s() {
      let co = document.querySelectorAll(
        '.eyeAble_customToolOpenerClass,#eyeAble_customToolOpenerID,.eyeAble_customToolOpenerNoHideClass',
      );
      if (window.location.hash.substr(1) === 'showEyeAble') {
        aEA();
        return;
      }
      if (co.length > 0) {
        function cOf() {
          aEA();
          co.forEach((e) => e.removeEventListener('click', cOf));
        }
        co.forEach((e) => e.addEventListener('click', cOf));
        co.forEach((e) =>
          e.addEventListener('keyup', function () {
            if (event.which === 13) cOf();
          }),
        );
      } else {
        aEA();
      }
    }
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(s, 1);
    } else {
      document.addEventListener('DOMContentLoaded', s);
    }
  }
})();
</script></body></html>