    <style>
        * {
            margin: 0;
            padding: 0;
        }
        html, code {
            font: 14px/24px system-ui, sans-serif;
        }
        html {
            background: #fafafa;
            color: #1a1a1a;
            padding: 20px;
        }
        body {
            margin: 8% auto 0;
            max-width: 420px;
            min-height: 160px;
