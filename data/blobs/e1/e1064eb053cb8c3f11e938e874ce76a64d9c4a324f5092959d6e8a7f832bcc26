    const initCcmFocusTrap = () => {
        const host = document.getElementById('ccm_notification_host');
        if (!host || !host.shadowRoot) return;

        let lastFocused = null;

        const getFocusable = () =>
        Array.from(host.shadowRoot.querySelectorAll(
            'button, a[href], [tabindex]:not([tabindex="-1"])'
        )).filter(el => el.offsetParent !== null);

        const trapHandler = (e) => {
            if (e.key !== 'Tab') return;
            const focusable = getFocusable();
            if (!focusable.length) return;
            const first = focusable[0];
            const last = focusable[focusable.length - 1];
            const active = host.shadowRoot.activeElement;

            if (e.shiftKey && active === first) {
                e.preventDefault();
                last.focus();
            } else if (!e.shiftKey && active === last) {
                e.preventDefault();
                first.focus();
            }
        };

        const syncTrapState = () => {
            const visible = getFocusable().length > 0;
            if (visible && !lastFocused) {
                lastFocused = document.activeElement;
                document.addEventListener('keydown', trapHandler, true);
                getFocusable()[0]?.focus();
            } else if (!visible && lastFocused) {
                document.removeEventListener('keydown', trapHandler, true);
                lastFocused.focus?.();
                lastFocused = null;
            }
        };

        new MutationObserver(syncTrapState).observe(host.shadowRoot, { childList: true, subtree: true, attributes: true });

        // offsetParent-based visibility only reflects reality once the shadow root's own
        // stylesheet(s) have applied - the banner's hidden panels (e.g. the settings panel)
        // still measure as visible before that, so wait for them before the first sync.
        // A stylesheet finishing load doesn't mutate the DOM, so the observer above won't
        // catch this on its own.
        const styleLinks = Array.from(host.shadowRoot.querySelectorAll('link[rel="stylesheet"]'));
        Promise.all(styleLinks.map(link => link.sheet ? null : new Promise(resolve => {
            link.addEventListener('load', resolve, { once: true });
            link.addEventListener('error', resolve, { once: true });
        }))).then(syncTrapState);
    };

    window.addEventListener('CCM_CookieMessage_done', initCcmFocusTrap, false);
