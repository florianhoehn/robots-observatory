<div class="modal fade dialog2" id="dialogLogin" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-detail">
                <div class="modal-body">
                    <div class="close">
                        <i class="fa icon-close-2" style="" onclick="closeDialogLogin()"></i>
                    </div>
                    <div id="login-create-form">
                        <div class="row row-centered">
                            <div class="col-md-12 col-sm-12 col-centered">
                                <div class="title margin-bottom-40">
                                    <h1>Login</h1>
                                </div>
                                <div class="free-form text-left" id="login-free-form">
                                    <form id="login-form" class="form-floating" onsubmit="login(0);return false;">
                                        <div id="fb-btn">
                                            <a class="btn btn-fb btn-block" href="javascript:fb_login();">
                                                <span>Entrar com o Facebook</span>
                                            </a>
                                        </div>
                                        <div class="modal-divider"></div>
                                        <div class="loginform-group">
                                            <div class="iconLabel"><span class="icon-mail"></span></div>
                                            <input class="form-controlold" name="LoginForm[username]" id="LoginForm_username" placeholder="E-mail" type="text" maxlength="150" autocomplete="nope">
                                            <span id="errorMsgLoginEmail" class="errorMsgInput errorMsgLoginEmail"></span>
                                        </div>
                                        <div style="position:relative">
                                            <div class="loginform-group">
                                                <div class="iconLabel"><span class="icon-password"></span></div>
                                                <input class="form-controlold" name="LoginForm[password]" id="LoginForm_password" placeholder="Senha" type="password" maxlength="150" autocomplete="nope">
                                            </div>
                                            <span id="errorMsgLoginPsw" class="errorMsgInput errorMsgLoginPsw"></span>
                                            <p id="errorMsgLoginPswRel" class="errorMsgInputRel errorMsgLoginPswRel"></p>
                                        </div>
                                        <div class="margin-bottom-20 checkbox-line">
                                            <label class="nomargin"><input name="LoginForm[rememberMe]" id="LoginForm_rememberMe" value="1" type="checkbox" class="nomargin">
                                            Mantenha-me conectado</label>
                                        </div>
                                        <div class="row nomargin">
                                            <button class="btn btn-danger btn-block btn-submit" type="submit">Login</button>
                                        </div>
                                        <div class="row">
                                            <h6 class="text-center">
                                                Esqueceu sua senha? <a data-toggle="modal" onclick="showRecoverPsw()">Clique aqui.</a>
                                            </h6>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-login-footer">
                    <p class="nomargin text-center">Não possui uma conta? <a onclick="showDialogRegistration(_callback_function)">Cadastre-se!</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dialog2" id="dialogRecoverPsw" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-detail">
                <div class="modal-body">
                    <div class="close">
                        <i class="fa icon-close-2" style="" onclick="closeDialogRecoverPsw()"></i>
                    </div>
                    <div class="row row-centered">
                        <div class="col-md-12 col-sm-12 col-centered">
                            <div class="title margin-bottom-40">
                                <h1>Recuperar senha</h1>
                            </div>
                            <div>
                                <form id="form-forget-psw" onsubmit="event.preventDefault();submitRecoverPsw()">
                                    <div class="loginform-group">
                                        <div class="iconLabel"><span class="icon-mail"></span></div>
                                        <input placeholder="E-mail" name="ForgotPasswordForm_email" id="ForgotPasswordForm_email" type="text" maxlength="150">
                                    </div>
                                    <div class="form-group">
                                        <div id="recaptcha-forgot-pwd" class="g-recaptcha"></div>
                                    </div>
                                    <span id="errorMsgForgetPsw" class="errorMsgInput"></span>
                                    <span id="errorMsgForgetPswRel" class="errorMsgInputRel"></span>
                                    <div class="margin-top-20">
                                        <button type="submit" class="btn btn-danger btn-block btn-submit" >Enviar</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade dialog2" id="dialogCheckEmail" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-detail">
                <div class="modal-body">
                    <div class="close">
                        <i class="fa icon-close-2" style="" onclick="closeDialogCheckEmail()"></i>
                    </div>
                    <div class="row row-centered">
                        <div class="col-md-12 col-sm-12 col-centered">
                            <div class="title margin-bottom-40">
                                <h1>Confira seu e-mail</h1>
                            </div>
                            <div>
                                <div class="margin-bottom-40 text-center">
                                    <span>O endereço indicado receberá um e-mail com instruções de como criar uma nova senha.</span>
                                </div>
                                <div class="margin-top-20">
                                    <button class="btn btn-block btn-submit" style="background-color:#8293aa" onclick="closeDialogCheckEmail()"> Fechar </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="login-resp-collapsed" class="loginMaskResp">
    <div class="close" onclick="hideLoginResp()">
        <i class="fa icon-close-2"></i>
    </div