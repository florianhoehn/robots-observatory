  // meaning the body is visible, then calls the callback.
  // If the style is not present at all (Target disabled), calls immediately.
  function whenBodyVisible(callback) {
    if (!document.getElementById('at-body-style')) {
      callback();
      return;
    }
    const observer = new MutationObserver(function () {
      if (!document.getElementById('at-body-style')) {
        observer.disconnect();
        callback();
      }
    });
