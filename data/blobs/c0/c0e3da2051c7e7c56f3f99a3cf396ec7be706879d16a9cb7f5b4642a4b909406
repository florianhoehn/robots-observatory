        } else {
          console.warn("Usercentrics ist noch nicht vollständig geladen.");
        }
      }));
    }

    // Fix: Block wieder aktiviert und veraltetes Universal Analytics durch dataLayer ersetzt
    document.querySelectorAll('.ga-register').forEach((b => {
      b.addEventListener('click', (e => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          'event': 'ga_register_pageview',
          'page_path': '/signup_short?modal=true'
        });
        sendGaEvent("new-account", "view");
      }));
    }));
  }));

  function crGetCookie(key) {
    // Fix: 'let' hinzugefügt + Try/Catch für sicheres JSON-Parsing
    let keyItem = localStorage.getItem('cr_' + key);
    if(keyItem) {
      try {
        keyItem = JSON.parse(keyItem);
        if(keyItem) {
          if(keyItem.validUntil == -1 || keyItem.validUntil > Date.now()) {
            return keyItem.value;
          }
        }
      } catch (error) {
        console.warn("Fehler beim Parsen des cr_ Cookies:", error);
      }
    }
    return null;
  }

  function sendGaEvent(gaEventCategory, gaEventAction) {
    let gaEventLabel = "default";
    let gaSubId = "default";
    
    if(crGetCookie("adid")){
      if(crGetCookie("adid_sub")) {
        gaSubId = unescape(crGetCookie("adid_sub"));
      }
      gaEventLabel = "publisher " + crGetCookie("adid") + "-" + gaSubId;
    } else if(crGetCookie("rk")){
      gaEventLabel = "affiliate";
    }
    
    // Fix: Universal Analytics durch modernen dataLayer-Push für GA4/GTM ersetzt
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      'event': 'custom_tracking_event',
      'eventCategory': gaEventCategory,
      'eventAction': gaEventAction,
      'eventLabel': gaEventLabel
    });
  }
</script>

