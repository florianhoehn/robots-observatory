<script>
  document.addEventListener("DOMContentLoaded", (e => {
    
    // Fix: Event-Listener abgesichert
    const ucModalBtn = document.querySelector('.cr_usercentrics_setting_modal');
    if (ucModalBtn) {
      ucModalBtn.addEventListener('click', (e => {
        e.preventDefault();
        if (typeof UC_UI !== 'undefined') {
