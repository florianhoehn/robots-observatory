            <div id="darkmode-toggle" class="pointer df flex-center pa050" aria-label="Darkmode umschalten">
                <i class="fa-light fa-moon gray-dark" style="margin-top: 1px;"></i>
            </div>

            <script>
                // 1. Theme-Status ermitteln (localStorage -> Fallback auf System-Preference)
                const savedTheme = localStorage.getItem('darkmode');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

                // Aktivieren wenn explizit 'on' ODER wenn kein Storage gesetzt & System dark ist
                const isDark = savedTheme === 'on' || (savedTheme === null && prefersDark);

                // 2. Hilfsfunktion zum Stylen des Icons
                function updateIcon(icon, isDarkMode) {
                    if (!icon) return;
                    if (isDarkMode) {
                        icon.classList.remove('fa-moon', 'fa-light');
                        icon.classList.add('fa-sun-bright', 'fa-solid');
                    } else {
                        icon.classList.remove('fa-sun-bright', 'fa-solid');
                        icon.classList.add('fa-moon', 'fa-light');
                    }
                }

                // 3. Initialen Zustand anwenden
                if (isDark) {
                    document.body.classList.add('darkmode');
                }

                // Icon direkt nach dem Laden anpassen (DOMReady sicherstellen)
                document.addEventListener('DOMContentLoaded', function () {
                    const icon = document.getElementById('darkmode-toggle')?.querySelector('i');
                    updateIcon(icon, document.body.classList.contains('darkmode'));
                });

                // 4. Toggle-Event Listener
                const darkmodeToggle = document.getElementById('darkmode-toggle');
                if (darkmodeToggle) {
                    darkmodeToggle.addEventListener('click', function () {
                        const hasDarkmode = document.body.classList.toggle('darkmode');
                        const icon = this.querySelector('i');

                        updateIcon(icon, hasDarkmode);

                        // Bei manuellem Klick wird die Entscheidung fest im LocalStorage gespeichert
                        localStorage.setItem('darkmode', hasDarkmode ? 'on' : 'off');
                    });
                }
            </script>

            
