    <style>
      html, body{
        position: relative;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 100%;
      }
      body {
        font-family: 'Albert Sans', sans-serif !important;
        margin: 0;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        font-weight: 400;
        font-feature-settings: 'ss05' on, 'liga' off;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        height: auto;
      }

      .page-header {
        box-sizing: border-box;
        height: 6rem;
        padding: 1.5rem 3rem;
        width: 100%;
        font-family: 'Albert Sans', sans-serif !important;
        border-bottom: 1px solid #eee;
      }

      .page-header-content {
        max-width: 83rem;
        margin: 0 auto;
        display: flex;
        align-items: center;
        height: 100%;
        justify-content: space-between;
      }

      .page-header-content > a {
        display: flex;
        text-decoration: none;
      }

      .page-btn {
        height: 3rem;
        cursor: pointer;
        outline: none;
        background: #1657fe;
        color: #fff;
        border: none;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.5rem;
        padding: 0.75rem 2rem;
        border-radius: 0.25rem;
        box-sizing: border-box;
        white-space: nowrap;
        font-family: 'Albert Sans', sans-serif !important;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .page-footer {
        box-sizing: border-box;
        font-family: 'Albert Sans', sans-serif !important;
        background: #fcfcfc;
        width: 100%;
        padding: 0 3rem;
      }

      .page-footer-content {
        max-width: 83rem;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-sizing: border-box;
        padding: 5rem 0;
        margin: 0 auto;
      }

      .page-footer-content-links {
        display: flex;
        gap: 2rem;
      }

      .page-footer-content-links > a {
        text-decoration: none;
        font-size: 0.8125rem;
        color: #677486;
        line-height: 1.1875rem;
      }

      .page-footer-content-links > a:hover {
        color: #1657fe;
      }

      .page-footer-content-copyright {
        font-size: 0.8125rem;
        color: #677486;
        font-weight: 700;
        line-height: 1.1875rem;
      }

      .page-content {
        max-width: 83rem;
        margin: auto;
        display: flex;
        gap: 5.5rem;
        padding: 8rem 3rem;

      }

      .page-title {
        color: #1657fe;
        font-size: 3.5625rem;
        line-height: 4.0625rem;
        font-weight: 700;
      }

      .page-content-left {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        width: 50%;
      }

      .page-text {
        color: #262626;
        font-size: 1.4375rem;
        line-height: 2.0625rem;
      }

      .page-text-margin-top {
        margin-top: 1.5rem;
      }

      .page-text > a,
      .page-text > a:visited {
        color: #1657fe;
        text-decoration: none;
      }

      .page-content-right {
        width: 50%;
      }

      .page-content-right > svg {
        width: 100%;
        height: auto;
      }

      .page-content-left > svg {
        width: 100%;
        height: auto;
      }

      /*Responsive*/
      @media only screen and (max-width: 1366px) {
        .page-content {
          margin: 5rem auto 8rem auto;
        }
      }

      @media only screen and (max-width: 1200px) {
        .page-content {
          padding: 0 1.5rem;
        }

        .page-header,
        .page-footer {
          padding: 0 1.5rem;
        }
      }

      @media only screen and (max-width: 1080px) {
        .sevio-logo > svg {
          width: 105px;
          height: auto;
        }

        .page-header {
          height: 5rem;
        }
      }

      @media only screen and (max-width: 960px) {
        .page-content {
          flex-direction: column;
          gap: 3rem;
        }
        .page-content-left,
        .page-content-right {
          width: 100%;
        }
      }

      @media only screen and (max-width: 767px) {
        .page-content {
          margin: 4rem auto;
        }

        .page-title {
          font-size: 2.5rem;
          line-height: 3rem;
        }

        .page-footer-content {
          flex-direction: column-reverse;
          gap: 1.5rem;
        }
      }

      @media only screen and (max-width: 480px) {
        .page-content {
          padding: 0 1rem;
        }

        .page-header {
          height: 4rem;
        }

        .page-header,
        .page-footer {
          padding: 0 1rem;
        }

        .page-footer-content-links {
          flex-direction: column;
          align-items: center;
          gap: 2rem;
        }
      }
    </style>
