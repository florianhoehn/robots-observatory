.gform_wrapper [type="checkbox"]:not(:checked) + label:before,
.gform_wrapper [type="checkbox"]:checked + label:before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1.2em; /* Adjust size */
    height: 1.2em; /* Adjust size */
