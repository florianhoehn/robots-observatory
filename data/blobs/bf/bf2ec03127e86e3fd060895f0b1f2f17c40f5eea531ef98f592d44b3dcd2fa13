    if (lang === CONSTANTS.LANGS.PT) return `${CONSTANTS.PATH_PREFIXES.PT}${stripped}`
    return `${CONSTANTS.PATH_PREFIXES.EN}${stripped}`
  }

  function getPreferredLang() {
    const saved = getSavedLang()
    if (saved) return saved

    const browser = normalizeLang(safelyGetNavigatorLanguage())
    if (browser === CONSTANTS.LANGS.ES) return CONSTANTS.LANGS.ES
    if (browser === CONSTANTS.LANGS.PT) return CONSTANTS.LANGS.PT

    return CONSTANTS.LANGS.EN
  }

  function autoRedirectIfNeeded() {
    const pathname = window.location.pathname || "/"

    const isExplicitEs = pathname.startsWith(CONSTANTS.PATH_PREFIXES.ES)
    const isExplicitPt = pathname.startsWith(CONSTANTS.PATH_PREFIXES.PT)

    if (isExplicitEs || isExplicitPt) return

    const preferred = getPreferredLang()
    const currentType = getCurrentPathType(pathname)

    if (preferred === currentType) return

    const nextPath = buildPathForLang(preferred, pathname)
    const nextUrl = `${nextPath}${window.location.search}${window.location.hash}`
    redirectTo(nextUrl)
  }

  function handleLanguageLinkClick(event) {
    const anchor = event.target && event.target.closest ? event.target.closest("a[hreflang]") : null
    if (!anchor) return

    const lang = normalizeLang(anchor.getAttribute("hreflang"))
    if (!lang) return

    event.preventDefault()
    setSavedLang(lang)

    const rawHref = anchor.getAttribute("href") || ""
    const parsed = safelyParseUrl(rawHref)
    if (!parsed) return

    redirectTo(parsed.toString())
  }
