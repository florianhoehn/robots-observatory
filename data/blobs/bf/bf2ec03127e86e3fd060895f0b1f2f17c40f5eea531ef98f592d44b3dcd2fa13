  function safelyGetNavigatorLanguage() {
    try {
      return navigator.language || navigator.userLanguage || ""
    } catch (error) {
      console.error(error)
      return ""
    }
  }

  function safelyGetLocalStorageItem(key) {
    try {
      return localStorage.getItem(key)
    } catch (error) {
      console.error(error)
      return null
    }
  }

  function safelySetLocalStorageItem(key, value) {
    try {
      localStorage.setItem(key, value)
      return true
    } catch (error) {
      console.error(error)
      return false
    }
  }

  function normalizeLang(value) {
    if (!value) return null
    const v = String(value).trim().toLowerCase()
    if (v.startsWith("en")) return CONSTANTS.LANGS.EN
    if (v.startsWith("es")) return CONSTANTS.LANGS.ES
    if (v.startsWith("pt")) return CONSTANTS.LANGS.PT
    return null
  }

  function safelyParseUrl(url) {
    try {
      return new URL(url, window.location.href)
    } catch (error) {
      console.error(error)
      return null
    }
  }

  function redirectTo(url) {
    try {
      window.location.replace(url)
    } catch (error) {
      console.error(error)
      window.location.href = url
    }
  }

  function getSavedLang() {
    return normalizeLang(safelyGetLocalStorageItem(CONSTANTS.LANGUAGE_STORAGE_KEY))
  }

  function setSavedLang(lang) {
    safelySetLocalStorageItem(CONSTANTS.LANGUAGE_STORAGE_KEY, lang)
  }

  function getCurrentPathType(pathname) {
    const p = pathname || window.location.pathname || "/"
    if (p.startsWith(CONSTANTS.PATH_PREFIXES.ES)) return CONSTANTS.LANGS.ES
    if (p.startsWith(CONSTANTS.PATH_PREFIXES.PT)) return CONSTANTS.LANGS.PT
    return CONSTANTS.LANGS.EN
  }

