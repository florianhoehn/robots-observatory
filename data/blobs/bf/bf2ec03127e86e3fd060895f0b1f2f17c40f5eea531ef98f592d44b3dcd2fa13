document.addEventListener("DOMContentLoaded", initializeProdigyHeader)

function initializeProdigyHeader() {
  if (window.__PRODIGY_HEADER_INITIALIZED__) return
  window.__PRODIGY_HEADER_INITIALIZED__ = true

  const CONSTANTS = {
    LANGUAGE_STORAGE_KEY: "prodigyLanguage",
    LANGS: {
      EN: "EN",
      ES: "ES",
      PT: "PT"
    },
    PATH_PREFIXES: {
      ES: "/es",
      PT: "/pt",
      EN: "/main-en"
    }
