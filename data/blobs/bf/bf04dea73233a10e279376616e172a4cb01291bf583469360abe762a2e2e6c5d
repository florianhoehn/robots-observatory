        async function copyEmojiSignal(emoji, opts={}) {
          if(!opts.anti) opts.anti = false;
          if(window.copySignalDisabled) return;
          let result = await fetch(`/api/copyEmoji?emoji=${encodeURIComponent(emoji)}&query=${encodeURIComponent(query)}&time=${Date.now()}&key=${localStorage.loginKey || ""}&anti=${opts.anti}`).then(r => r.text());
          if(!opts.anti && window.embedderQuery) {
            let result = await fetch(`/api/copyEmoji?emoji=${encodeURIComponent(emoji)}&query=${encodeURIComponent(window.embedderQuery)}&time=${Date.now()}&key=${localStorage.loginKey || ""}`).then(r => r.text());
          }
          if(!opts.anti && window.prevSearchQuery) {
            fetch(`/api/copyEmoji?emoji=${encodeURIComponent(emoji)}&query=${encodeURIComponent(window.prevSearchQuery)}&time=${Date.now()}&key=${localStorage.loginKey || ""}`).then(r => r.text());
            
            try {
              window.recentSearchQueries = window.recentSearchQueries.filter(q => Date.now()-q.time < 1000*60*2); // only keep the last 2 mins
              window.recentSearchQueries.sort((a,b) => b.time - a.time); // most recent first
              let recentQueries = window.recentSearchQueries.slice(0, 3).map(q => q.query);
              recentQueries = [...new Set(recentQueries)]; // remove duplicates
              for(let q of recentQueries) {
                if(q === window.prevSearchQuery) continue;
                fetch(`/api/copyEmoji?emoji=${encodeURIComponent(emoji)}&query=${encodeURIComponent(q)}&time=${Date.now()}&key=${localStorage.loginKey || ""}&w=h`).then(r => r.text());
              }
            } catch(e) { console.error(e); }
          }

          try { gtag('event', 'copy_emoji', {}); } catch(e) { console.error(e); }
          try { if(inMinimalEmbedMode) { gtag('event', 'copy_emoji_in_minimal_embed', {}); } } catch(e) { console.error(e); }

          if(window.parent !== window) {
            window.parent.postMessage({emojiCopied:emoji}, "https://emojicombos.com");
          }
          
          if(localStorage.loginKey && result === "invalid login") alert("Invalid login token");
        }
        
