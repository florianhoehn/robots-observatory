<script>
(function () {
  const FALLBACK = 120; // px; tune if needed
  const EXTRA = 16;

  function headerOffset() {
    const fromVar = getComputedStyle(document.documentElement)
      .getPropertyValue('--sticky-header-height')
      .trim();
    if (fromVar.endsWith('px')) {
      const n = parseFloat(fromVar);
      if (!Number.isNaN(n) && n > 0) return n + EXTRA;
    }
    const sticky = document.querySelector('.c-header__sticky-container');
    if (sticky) {
      const h = sticky.getBoundingClientRect().height;
      if (h > 0) return h + EXTRA;
    }
    return FALLBACK + EXTRA;
  }

  function scrollToHash(hash, behavior) {
    if (!hash || hash === '#') return;
    const id = decodeURIComponent(hash.slice(1));
    const el = document.getElementById(id);
    if (!el) return;
    const top = el.getBoundingClientRect().top + window.scrollY - headerOffset();
    window.scrollTo({ top: Math.max(0, top), behavior: behavior || 'auto' });
  }

  document.addEventListener('click', (e) => {
    const a = e.target.closest('a[href*="#"]');
    if (!a) return;
    const url = new URL(a.href, window.location.href);
    if (url.pathname !== window.location.pathname) return;
    if (!url.hash) return;
    e.preventDefault();
    history.pushState(null, '', url.hash);
    scrollToHash(url.hash, 'smooth');
  });

  window.addEventListener('hashchange', () => scrollToHash(location.hash));
  window.addEventListener('load', () => {
    if (location.hash) {
      // Wait a tick so sticky height is measured
      requestAnimationFrame(() => scrollToHash(location.hash));
    }
  });
})();
</script>

    
    

