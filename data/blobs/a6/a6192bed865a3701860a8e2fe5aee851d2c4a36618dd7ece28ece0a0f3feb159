<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, viewport-fit=cover"
    />
    <title>404 | Poloniex</title>
    <meta name="description" content="This page does not exist. Please check your URL." />
    <link rel="stylesheet" href="/v3/entry/v3.css" />
    <script src="/v3/entry/v3.js"></script>

    <style>
      html {
        font-family:
          source-sans3,
          PingFang SC,
          Hiragino Sans GB,
          Microsoft YaHei,
          微软雅黑,
          Aril,
          sans-serif;
      }
      body {
        margin: 0;
        padding: 0;
        font-size: 14px;
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        justify-content: center;
        background-color: #f2f2f2;
      }
      .main {
        flex: 1;
        padding-top: 180px;
        padding-bottom: 48px;
        text-align: center;
      }
      html[data-uniframe-theme="dark"] .main {
        background-color: #000;
      }
      @media only screen and (max-width: 500px) {
        .main {
          padding: 30px 10px;
        }
      }
    </style>

    <!-- UniFrame start -->
    <script>
      (function (window, location, localStorage, navigator, UNIFRAME_NAME) {
        var DEFAULT_LOCALE = "en-us";
        var THEME_LIST = ["light", "dark"];
        var DEFAULT_THEME = THEME_LIST[0];
        var uniframe = (window[UNIFRAME_NAME] = window[UNIFRAME_NAME] || {});
        var config = (uniframe.config = uniframe.config || {});
        config.localeUrlMap = {
          "en-us": "en",
          "es-es": "es",
          "ru-ru": "ru",
          "tr-tr": "tr",
          "pt-br": "pt",
          "th-th": "th",
          "ko-kr": "ko",
          "ja-jp": "ja",
          "zh-tw": "zh-TW",
          "zh-cn": "zh-CN",
          "vi-vn": "vi",
          id: "id",
          "hi-in": "hi",
        };
        try {
          var ucjson = JSON.parse(localStorage.getItem("polo:uc") || "{}");
          if (ucjson.ts && Date.now() > ucjson.ts) ucjson = {};
          Object.keys(ucjson).forEach(function (key) {
            config[key] = ucjson[key];
          });
        } catch (e) {
          localStorage.removeItem("polo:uc");
        } finally {
          config.isLogin = !!config.uuid;
        }
        uniframe.loader = uniframe.loader || [];
        uniframe.use = function (deps, callback) {
          uniframe.loader.push({ deps: deps, callback: callback });
        };
        uniframe.prefetch = function (deps) {
          uniframe.loader.push({ deps: deps });
        };
        uniframe.set = function () {};
        uniframe.get = function (key) {
          return config[key];
        };
        if (!config.env) {
          if (location.hostname.match(/^(dev|test|stg|sandbox)-|^(local)/)) {
            config.env = RegExp.$1 || RegExp.$2;
          } else {
            config.env = "prod";
          }
        }

        /** 语言设置 */
        config.locale =
          config.locale ||
          localStorage.getItem("uniframe:locale") ||
          (function () {
            var language = String(navigator.language).toLowerCase();
            if (language === "zh") return "zh-cn";
            if (config.localeUrlMap[language]) return language;
            return Object.keys(config.localeUrlMap).find(function (key) {
              return language.split("-")[0] === key.split("-")[0];
            });
          })();
        if (!config.locale || !config.localeUrlMap[config.locale]) config.locale = DEFAULT_LOCALE;
        /** 尝试识别链接中语言 */
        var tmpLocale = location.pathname.split("/")[1];
        if (tmpLocale) {
          Object.keys(config.localeUrlMap).some(function (key) {
            if (config.localeUrlMap[key] === tmpLocale) {
              config.locale = key;
              return true;
            }
          });
        }

        /** 主题设置 */
        config.theme = config.theme || localStorage.getItem("uniframe:theme");
        if (!config.theme || !THEME_LIST.includes(config.theme)) config.theme = DEFAULT_THEME;

        /** 法币设置 */
        config.currency = config.currency || localStorage.getItem("uniframe:currency") || "USD";

        // App WebView 适配
        // 1. 主题，需要跟 App 关联，并且不允许用户修改
        // 2. 语言，需要跟 App 关联，并且不允许用户修改
        config.app = /(?:(?:ios|android)_polo_app|poloniex|poloniex-play)\//i.test(navigator.userAgent);
        if (config.app) {
          // 使用新版本 App SDK 获取关联的主题
          config.theme =
            location.search.substr(1).match(new RegExp("(^|&)isDarkTheme=([^&]*)(&|$)", "i")) && RegExp.$2 === "true"
              ? "dark"
              : DEFAULT_THEME;

          // 再判断新版本 App SDK 链接中的语言
          // 0. zh-cn, hi-in, id ok
          // 1. zh-hans -> zh-cn
          // 2. zh-hant -> zh-tw
          // 3. ja -> ja-jp, vi -> vi-vn, ...
          if (location.search.substr(1).match(new RegExp("(^|&)language=([^&]*)(&|$)", "i"))) {
            var applocale = RegExp.$2.toLowerCase();
            if (config.localeUrlMap[applocale]) {
              config.locale = applocale;
            } else if (applocale === "zh-hans") {
              config.locale = "zh-cn";
            } else if (applocale === "zh-hant") {
              config.locale = "zh-tw";
            } else {
              Object.keys(config.localeUrlMap).some(function (key) {
                if (key.split("-")[0] === applocale.split("-")[0]) {
                  config.locale = key;
                  return true;
                }
              });
            }
            if (!config.localeUrlMap[config.locale]) config.locale = DEFAULT_LOCALE;
          }
        }

        /** 语言识别跳转 */
        if (!config.app) {
          var localeOfUrl = location.pathname.split("/")[1];
          if (!Object.values(config.localeUrlMap).includes(localeOfUrl) && config.locale !== DEFAULT_LOCALE) {
            location.replace(
              location.href.replace(location.origin, location.origin + "/" + config.localeUrlMap[config.locale]),
            );
          } else if (localeOfUrl === config.localeUrlMap[DEFAULT_LOCALE]) {
            location.replace(
              location.href.replace(location.origin + "/" + config.localeUrlMap[DEFAULT_LOCALE], location.origin),
            );
          }
        }
      })(window, location, localStorage, navigator, "UniFrame");
    </script>

    <script>
      // 仅在 local 环境下添加 no-referrer meta 标签
      if (window.UniFrame.get("env") === "local") {
        var meta = document.createElement("meta");
        meta.name = "referrer";
        meta.content = "no-referrer";
        document.head.appendChild(meta);
      }
    </script>

    <!-- TMS start -->
    <script>
      (function (tms, baseURL) {
        var defer = {};
        var hashcache = {};
        var getURI = function (item) {
          var project = item.project;
          var locale = item.locale;
          // https://stg-tms.polo-static.com/web/demo-web/locales-hash/zh-cn-xxx.json
          if (item.hash !== false && hashcache[project] && hashcache[project][locale]) {
            return [baseURL, "web", project, "locales-hash", hashcache[project][locale] + ".json"].join("/");
          }

          // https://stg-tms.polo-static.com/web/demo-web/locales/zh-cn.json
          return [baseURL, "web", project, "locales", locale + ".json"].join("/");
        };
        var fetchHash = function (item) {
          var project = item.project;
          if (hashcache[project] || item.hash === false) return Promise.resolve();
          if (defer[project]) return defer[project];
          var done;
          defer[project] = new Promise(function (resolve) {
            done = resolve;
          });

          // https://stg-tms.polo-static.com/web/demo-web/loader/hashmap.json
          return fetch([baseURL, "web", project, "loader", "hashmap.json"].join("/"))
            .then(function (res) {
              return res.json();
            })
            .then(function (res) {
              hashcache[project] = res;
            })
            .catch(function () {
              hashcache[project] = {};
            })
            .finally(function () {
              if (typeof done === "function") done();
              done = null;
              delete defer[project];
            });
        };
        tms.load = function (data) {
          return Promise.all(
            (Array.isArray(data) ? data : [data]).map(function (item) {
              return fetchHash(item).then(function () {
                var url = getURI(item);
                if (defer[url]) return defer[url];
                var done;
                defer[url] = new Promise(function (resolve) {
                  done = resolve;
                });
                return fetch(url)
                  .then(function (res) {
                    return res.json();
                  })
                  .catch(function () {
                    return {};
                  })
                  .then(function (res) {
                    if (typeof done === "function") done(res);
                    done = null;
                    url = null;
                    delete defer[url];
                    return res;
                  });
              });
            }),
          ).then(function (res) {
            if (!Array.isArray(data)) return res[0];
            return res;
          });
        };
      })(
        (window.TMS = window.TMS || {}),
        window.UniFrame.get("env") === "preprod" || window.UniFrame.get("env") === "prod"
          ? "https://tms.polo-static.com"
          : "https://stg-tms.polo-static.com",
      );
    </script>

    <script>
      // 根据环境动态加载对应的 loader.js
      (function () {
        var env = window.UniFrame.get("env");
        var scriptUrl;

        if (env === "preprod") {
          scriptUrl = "https://preprod-v3.polo-static.com/uniframe/static/loader.js";
        } else if (env === "prod") {
          scriptUrl = "https://v3.polo-static.com/uniframe/static/loader.js";
        } else {
          scriptUrl = "https://stg-v3.polo-static.com/uniframe/static/loader.js";
        }

        var script = document.createElement("script");
        script.src = scriptUrl;
        script.async = true;
        document.head.appendChild(script);
      })();
    </script>
  </head>
  <body>
    <div id="uniframe-header"></div>
    <div id="uniframe-404" class="main"></div>
    <div id="uniframe-footer"></div>

    <script>
      document.documentElement.setAttribute("data-theme", window.UniFrame.get("theme"));
      if (!window.UniFrame.get("app")) {
        window.UniFrame.use(["header", "footer", "not-found"], function (header, footer, notFound) {
          header.render({ id: "uniframe-header" });
          footer.render({ id: "uniframe-footer" });
          notFound.render({ id: "uniframe-404" });
        });
      }

      // 转义 i18n 占位符 {'xxx'} -> xxx
      const unescapeI18n = function (text) {
        if (!text) return null;
        return text
          .replace(/\{'\|'\}/g, "|")
          .replace(/\{'@'\}/g, "@")
          .replace(/\{'\$'\}/g, "$");
      };

      // 修改页面标题
      const changePageTitle = function (locale) {
        window.TMS.load({
          locale,
          project: "global",
        }).then(function (localeData) {
          const title = unescapeI18n(localeData["g-t-404"]) || "404 | Poloniex";
          document.title = title;
        });
      };

      // 语言切换时，自动切换路径
      window.UniFrame.use("event", function (event) {
        event.on(event.keys.CHANGE_LOCALE, function (locale) {
          changePageTitle(locale);

          var localeUrlMap = window.UniFrame.get("localeUrlMap");
          var newLocalePrefix = localeUrlMap[locale];
          var allLocalePrefixes = Object.values(localeUrlMap);

          var pathname = location.pathname;
          var pathSegments = pathname.split("/").filter(Boolean);
          var currentFirstSegment = pathSegments[0] || "";

          if (allLocalePrefixes.includes(currentFirstSegment)) {
            pathSegments.shift();
          }

          var newPathname;
          if (locale === "en-us") {
            newPathname = "/" + pathSegments.join("/");
          } else {
            newPathname = "/" + newLocalePrefix + "/" + pathSegments.join("/");
          }

          var newUrl = location.origin + newPathname + location.search + location.hash;
          history.replaceState(null, "", newUrl);
        });
      });
    </script>
  </body>
</html>

