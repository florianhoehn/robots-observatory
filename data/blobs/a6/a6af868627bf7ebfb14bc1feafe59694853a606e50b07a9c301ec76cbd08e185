motId\\\":\\\"180020050100011872\\\",\\\"applicationUniqId\\\":\\\"5f1b6b3b-699e-47e4-8f5e-2c5aaa18d858\\\",\\\"env\\\":\\\"PROD\\\",\\\"appCategory\\\":\\\"DOCKER_NEXTJS\\\",\\\"publishUniqId\\\":\\\"92911f54-02c5-4ea5-83c0-6f8221a20726\\\",\\\"marmotEnv\\\":\\\"PROD\\\",\\\"coverageEnabled\\\":true}\\n      \"}],null]]}],[\"$\",\"body\",null,{\"id\":\"app\",\"children\":[\"$\",\"$L10\",null,{\"value\":{\"device\":{\"type\":\"unknown\"}},\"children\":[\"$\",\"$L11\",null,{\"parallelRouterKey\":\"children\",\"segmentPath\":[\"children\"],\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L12\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[],\"$L13\"],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}]}]]}]\n15:T12f0,"])</script><script>self.__next_f.push([1,"\u003cblock\u003e\n    \u003ch3\u003e背景设定：于以现金为主的菲律宾中的金融普惠挑战\u003c/h3\u003e\n    \u003cp\u003e菲律宾长期面临金融普惠力度不足的困境。疫情前，仅29%的菲律宾人拥有银行账户。对于储蓄、投资、保险、公平信贷工具乃至基础数字消费，对大多数人而言仍难以触达或受限严重。基础设施短板加剧鸿沟——智能手机普及率停滞于75%，农村地区4G网速远落后于城市。\u003c/p\u003e\n\n    \u003cp\u003e现金经济主导日常。超90%小额交易依赖现金，企业现金处理成本高达交易额的3%-5%。\u003c/p\u003e\n\n    \u003cp\u003e在此背景下，由Globe Telecom旗下金融科技部门Mynt开发的移动支付平台GCash应运而生。该平台初期提供话费充值、账单支付及汇款等服务，迅速赢得市场认可。然而随着用户激增，GCash面临严峻技术挑战：\u003c/p\u003e\n\n    \u003cul\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e用户增长压力：\u003c/strong\u003e海量用户规模下维持无缝体验日益复杂。\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e系统性能瓶颈：\u003c/strong\u003e旧平台仅支持最高400 TPS（每秒交易数），节假日高峰期频现交易延迟。\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e功能扩展障碍：\u003c/strong\u003e进军信用评分与财富管理领域时，因系统缺乏完全幂等性，偶发重复交易，推高客服需求。\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e人才能力缺口：\u003c/strong\u003e提升本地数据分析与风控系统专业能力成为创新关键。\u003c/p\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n\n    \u003cp\u003e尽管面临挑战，GCash的持续努力终见回报。\u003cstrong\u003e如今65%的菲律宾人拥有了银行账户\u003c/strong\u003e, 印证了以GCash为代表的数字金融平台，正推动金融可及性与包容性的大规模变革。\u003c/p\u003e\n\u003c/block\u003e\n\n\u003cblock\u003e\n    \u003ch3\u003e技术迁移：Alipay+ Wallet Tech赋能转型\u003c/h3\u003e\n    \u003cp\u003e2019年，GCash与Alipay+ Wallet Tech建立战略合作，GCash通过分阶段技术迁移完成平台全面更新。\u003c/p\u003e\n\n    \u003cp\u003e获得指数级能力提升：\u003c/p\u003e\n    \n    \u003cul\u003e\n        \u003cli\u003e\n            \u003cp\u003e处理能力增长3到5倍，峰值TPS突破1000\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e系统可靠性提升，高峰时段停机事件减少\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e数据存储效率与成本效益显著优化\u003c/p\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n\n    \u003cp\u003e此次迁移奠定规模化基础。伴随疫情加速数字化进程，GCash实现用户数量三年增长三倍。至2024年，80%菲律宾人使用GCash，其作为国民日常数字伴侣及头部金融超级应用的地位持续巩固。\u003c/p\u003e\n\n\u003c/block\u003e\n\n\u003cblock\u003e\n    \u003ch3\u003e业务与普惠金融双重影响\u003c/h3\u003e\n\n    \u003ch6\u003e攻坚实体经济金融包容性\u003c/h6\u003e\n    \u003cp\u003e依托升级后的技术架构，GCash聚焦核心使命：改变菲律宾非正规经济领域与金融服务不足人群的现金支付惯性。国家二维码系统QR Ph的推行暴露出市场摊贩、三轮车司机等群体对现金的深度依赖。以马尼拉30万三轮车司机为例：每名司机日均载客50人次，其中90%交易金额不足₱20（约0.35美元），且全部采用现金支付。\u003c/p\u003e\n    \u003cp\u003e对此，GCash推出综合普惠方案：\u003c/p\u003e\n    \u003cul\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e离线支付\u003c/strong\u003e解决无网络环境交易难题\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e动态二维码技术\u003c/strong\u003e杜绝截图欺诈风险\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e\u003cstrong\u003e百人地推团队\u003c/strong\u003e深入100个本地市场，辅导司机、摊主从现金交易向二维码支付转型\u003c/p\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n    \u003cp\u003e支付服务之外，还同步开放储蓄、信贷、保险服务，全面提升劳动者疫后财务抗风险能力。\u003c/p\u003e\n\n    \u003ch6\u003e通过数字生态扩展推动商业转型\u003c/h6\u003e\n    \u003cp\u003e技术迁移完成后，GCash开启全面数字生态扩展。其生活方式平台GLife整合超1000家商户，覆盖食品、健康、零售及娱乐领域；金融服务已拓展至投资、信贷与保险板块。\u003c/p\u003e\n    \u003cp\u003e依托Alipay+跨境支付能力，GCash支持55+国家和地区无缝交易，赋能约800万菲律宾用户连接全球1000万商户——该能力对海外务工人员及旅行者至关重要。\u003c/p\u003e\n    \u003cp\u003e这种生态模式推动GCash从支付工具升级为覆盖全国的\"支付-金融-生活\"一站式平台。如今：\u003c/p\u003e\n    \u003cul\u003e\n        \u003cli\u003e\n            \u003cp\u003e80%菲律宾人已使用GCash\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e平台入驻商户超600万\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003cp\u003e母公司Mynt成为菲律宾首家且唯一估值50亿美元的独角兽企业\u003c/p\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n    \u003cp\u003eGCash的演进不仅体现技术变革，更印证数字金融如何重塑国民经济行为、推动普惠包容，并在规模级应用中构建数字韧性。\u003c/p\u003e\n\u003c/block\u003e"])</script><script>self.__next_f.push([1,"16:T1678,"])</script><script>self.__next_f.push([1,"\u003cblock\u003e\n    \u003ch3\u003eTNG Digital的起源\u003c/h3\u003e\n    \u003cp\u003eTNG Digital（TNGD）是马来西亚的一家金融科技公司，由Touch 'n Go Sdn Bhd与Ant International联合创立。其核心产品TNG电子钱包（TNG eWallet）源于马来西亚拓展数字金融服务的战略布局。\u003c/p\u003e\n    \u003cp\u003eTouch 'n Go长期以来一直与交通支付（如收费站和公共交通）紧密相关。TNG电子钱包作为该服务的数字化延伸，由Touch 'n Go与Ant International合作推动。其最初开发旨在提升收费支付的便捷性，TNG电子钱包迅速获得用户青睐，并逐步发展为一款功能全面的超级应用，提供多样化的数字生活服务。从电子商务、食品配送到金融解决方案及账单支付，TNG电子钱包如今已成为数百万马来西亚人日常生活中不可或缺的组成部分。\u003c/p\u003e\n\u003c/block\u003e\n\n\u003cblock\u003e\n    \u003ch3\u003e系统架构演进：从孤岛式到平台化\u003c/h3\u003e\n    \u003cp\u003e早期阶段，TNG电子钱包构建于遗留系统之上，采用了孤岛式的“垂直烟囱”架构——这意味着每条新增业务线（例如交通支付）都需要一个独立的模块。尽管该架构在初期支持了快速部署，但随着业务规模的扩展，最终导致了工作重复、系统碎片化以及高昂的维护成本。\u003c/p\u003e\n    \u003cp\u003e为应对这些挑战，TNGD自2017年起启动了分三步走的系统升级：\u003c/p\u003e\n    \u003cul\u003e\n        \u003cli\u003e\n            \u003ch6\u003e第一步（2017年初）：双核心架构\u003c/h6\u003e\n            \u003cp\u003e通过将Alipay+钱包系统集成至现有的遗留基础设施，TNG电子钱包实现了双核心架构。这确保了新功能的无缝部署，同时不影响现有服务的运行。通过有效利用现有的业务API，TNG电子钱包快速推出了交通QR码、面对面支付及现金返还等关键功能，充分满足了交通支付的核心需求。\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003ch6\u003e第二步（2017年末）：架构现代化\u003c/h6\u003e\n            \u003cp\u003e遗留系统经历了“账本化”转型，将单体业务API拆分为灵活、独立的API。系统采用了分片、分区的数据库架构，性能获得巨大提升——交易吞吐量从原有的每秒50笔交易（50 TPS）增长超过20倍\u003csup\u003e1\u003c/sup\u003e。\u003c/p\u003e\n        \u003c/li\u003e\n        \u003cli\u003e\n            \u003ch6\u003e第三步（2018年末）：系统迁移\u003c/h6\u003e\n            \u003cp\u003e迁移工作覆盖了用户交易历史、商户结算和支付账本等核心模块，且整个迁移过程实现零停机时间。系统性能显著提升：响应时间缩短一半，新的核心账本API处理能力达到每秒1,000笔交易（1,000 TPS\u003csup\u003e2\u003c/sup\u003e），为未来业务增长奠定了坚实基础。\u003c/p\u003e\n        \u003c/li\u003e\n    \u003c/ul\u003e\n\u003c/block\u003e\n\n\u003cblock\u003e\n    \u003ch3\u003e\n        从支付工具到超级应用：\n        \u003cbr/\u003e\n        构建多元化的数字生态系统\n    \u003c/h3\u003e\n    \u003cp\u003e随着系统能力的增强，TNG 电子钱包成功从单一支付工具转型为超级应用，深度融合了支付、金融服务和生活方式三大功能板块。这一转型由三大关键支柱驱动：\u003c/p\u003e\n\n    \u003ch6\u003e具备作为用户流量中心的全面支付能力\u003c/h6\u003e\n    \u003cp\u003e借助Alipay+领先的电子钱包产品与运营经验，TNG电子钱包将其支付服务扩展至线上线下全场景，广泛覆盖电子商务、食品配送、便利店及药店等多个关键领域。电子身份认证（e-KYC）、强大的风险管理能力以及高并发支持等前沿技术，确保了即使在交易高峰期（如促销季），交易也能安全高效地进行。平台在有效保障每个电子钱包账户免受未经授权活动侵害的同时，始终提供顺畅的用户体验，实现了至关重要的安全与便捷的平衡。\u003c/p\u003e\n\n    \u003ch6\u003e为金融普惠铺平道路\u003c/h6\u003e\n    \u003cp\u003e2021年3月，TNG 电子钱包推出了GO+，这是马来西亚首个电子钱包货币市场基金，为传统储蓄账户提供了一种数字优先的替代方案。GO+的起投门槛较低，仅需10马来西亚林吉特（约合2.35美元）\u003csup\u003e3\u003c/sup\u003e，使用户能够在保持资金即时流动性和无缝访问的前提下，从其电子钱包余额中获得每日回报。它弥合了消费与投资之间的鸿沟，将日常电子钱包的便利性与金融增长的优势相结合。\u003c/p\u003e\n    \u003cp\u003e截至2024年11月，GO+的用户数量已接近400万\u003csup\u003e4\u003c/sup\u003e，成为马来西亚最大的货币市场基金平台。其管理资产（AUM）规模较上年同期增长了65%，充分体现了强劲的用户采用率与不断加深的用户信任。凭借这一成功，TNG Digital将业务扩展至信用评分和保险科技领域，显著提升了金融服务不足群体和新兴群体在获取金融工具与保障方面的普及度——从而巩固了其在普惠数字金融领域的领导地位。\u003c/p\u003e\n    \n    \u003ch6\u003e国内及跨境生态系统的增强\u003c/h6\u003e\n    \u003cp\u003e通过小程序平台，TNG Digital赋能中小企业实现数字化运营，同时扩展了在餐饮、出行和娱乐等领域的服务生态。这进一步加强了其作为马来西亚数字化转型门户和基石的角色定位。此外，借助Alipay+跨境解决方案，TNG电子钱包用户可进行无缝的全球交易；同时，该方案也使外国游客能够在马来西亚便捷交易，惠及当地商户。\u003c/p\u003e\n\u003c/block\u003e\n\n\u003cblock\u003e\n    \u003ch3\u003e当前成就与未来展望\u003c/h3\u003e\n    \u003cp\u003e如今，TNG电子钱包持续保持着马来西亚领先的数字金融与日常应用地位，连接着超过2300万经过验证的用户和超过200万商户\u003csup\u003e5\u003c/sup\u003e。其中，至少有600万用户订阅了TNG电子钱包的一项或多项金融产品。展望未来，TNG Digital 将继续推进金融普惠，推动技术创新，并巩固其作为马来西亚数字经济核心的可信平台地位。\u003c/p\u003e\n\u003c/block\u003e"])</script><script>self.__next_f.push([1,"17:T43e,Developed by Ant International, Alipay+ provides mobile payment solutions that enable merchants, including small and medium-sized businesses, to better serve consumers around the world. Upon integration into the system, global merchants can accept payments made by consumers using their familiar and favorite payment methods.\n● Alipay+ also provides digital marketing solutions, helping global merchants to distribute a wide range of discounts to users of different digital payment platforms, helping them to acquire and retain consumers.\n● Alipay+ Global Merchant Payment Services provide platform-level services and toolkits to meet merchants needs for payment settlement, risk management and business growth for their global business development. \n● Alipay+ Payment Technologies and Digitalization Services also provide digital technology solutions for business operation digitalization, e-wallet development, digital finance development and risk management to customers across different industries, supporting their digital transformation and accelerating financial inclusion.18:T5a6,Alipay+ is a unified wallet gateway with cross-border payment and digitisation services that help connect global merchants to consumers.\u003cbr /\u003e\u003cbr /\u003eConsumers enjoy seamless payments, a broad choice of deals and the convenience of digital services using their home e-wallets and banking apps while travelling abroad. \u003cbr /\u003e\u003cbr /\u003eWe help our partners and merchants to effortlessly serve billions of consumers globally. Our technology facilitates the overseas use of multiple digital wallets and banking apps through a single integration. We enable customers to instantly and safely use their home e-wallets when travelling overseas – as easily as they do at home, both in-store and online.\u003cbr /\u003e\u003cbr /\u003eSmall and medium-sized businesses may use our cutting-edge mobile payment technology and digital tools, including our A+ Rewards promotions platform and mini app technology, to enhance efficiency and achieve omni-channel growth.\u003cbr /\u003e\u003cbr /\u003eThrou"])</script><script>self.__next_f.push([1,"gh our AI-powered tech capabilities we help our partners connect with a rapidly growing world of digital customers. Alipay+ Wallet Tech helps partners upgrade their wallet platform and build industry-leading super apps. And Alipay+ GenAI Cockpit is our AI platform engineered to streamline the development of secure, high-precision AI applications in fintech.\u003cbr /\u003e\u003cbr /\u003eAlipay+ is one of the business pillars of Ant Interna