<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>This video is no longer available</title>

<!-- Nothing here should be indexed, and nothing should be followed. -->
<meta name="robots" content="noindex, nofollow"/>

<!--
  No meta refresh here, and that is deliberate.

  A meta refresh looks like a good fallback for someone with JavaScript off,
  but the browser schedules it the moment it parses the tag and removing the
  element afterwards does not cancel it — so "Stay here" appeared to work and
  the page moved anyway a moment later. Tested in Chrome: the tag was gone from
  the DOM and the redirect still fired.

  Without JavaScript there is no countdown, just a page with a "Go now" link on
  it, which is a perfectly good answer.
-->

<style>
  :root{
    --bg:#090b10; --card:#171b23; --card-border:#232935; --surface:#191e28;
    --border:#2a323e; --text:#e9ebef; --muted:#9aa2af; --dim:#6c7482;
    --primary:#6d5cf0; --primary-strong:#5b48e0; --warn:#d29922;
    --ease:cubic-bezier(.4,0,.2,1);
  }
  /*
   * Light values, applied two ways.
   *
   * The media query covers someone arriving with their system set to light.
   * The attribute selector is what the site's own toggle sets, and it has to
   * win over the media query — otherwise a visitor who chose light on a dark
   * machine gets a dark page here and a light one everywhere else.
   */
  @media (prefers-color-scheme: light){
    :root:not([data-theme="dark"]){
      --bg:#e7e9f0; --card:#fff; --card-border:#e6e9f0; --surface:#fff;
      --border:#e5e8ee; --text:#1a1d24; --muted:#565c68; --dim:#8b91a0;
    }
  }
  :root[data-theme="light"]{
    --bg:#e7e9f0; --card:#fff; --card-border:#e6e9f0; --surface:#fff;
    --border:#e5e8ee; --text:#1a1d24; --muted:#565c68; --dim:#8b91a0;
  }

  *{box-sizing:border-box;margin:0;padding:0}
  body{
    background:var(--bg); color:var(--text);
    font-family:"Poppins","Noto Sans Bengali",system-ui,-apple-system,sans-serif;
    min-height:100vh; display:grid; place-items:center; padding:20px;
  }

  .card{
    max-width:520px; width:100%; padding:34px 30px; text-align:center;
    background:var(--card); border:1px solid var(--card-border);
  }

  .icon{
    width:56px; height:56px; margin:0 auto 18px; display:grid; place-items:center;
    border-radius:50%; background:rgba(210,153,34,.12); color:var(--warn);
  }
  .icon svg{width:28px;height:28px}

  h1{
    font-family:"Space Grotesk","Noto Sans Bengali",sans-serif;
    font-size:1.3rem; font-weight:700; line-height:1.3;
    letter-spacing:-.01em; margin-bottom:12px;
  }
  .text{font-size:.92rem; line-height:1.7; color:var(--muted); margin-bottom:18px}
  .count{font-size:.85rem; color:var(--dim); margin-bottom:22px}
  .count strong{color:var(--primary); font-variant-numeric:tabular-nums}

  .actions{display:flex; gap:9px; justify-content:center; flex-wrap:wrap}
  .btn{
    display:inline-flex; align-items:center; gap:6px; padding:9px 18px;
    font-size:.88rem; font-family:inherit; text-decoration:none; cursor:pointer;
    color:var(--muted); background:var(--surface); border:1px solid var(--border);
    transition:color .15s var(--ease), border-color .15s var(--ease);
  }
  .btn:hover{color:var(--primary); border-color:var(--primary)}
  .btn--primary{background:var(--primary); border-color:var(--primary);
    color:#fff; font-weight:600}
  .btn--primary:hover{background:var(--primary-strong); color:#fff}
  .btn svg{width:15px;height:15px}

  svg.ic{fill:none; stroke:currentColor; stroke-width:2;
    stroke-linecap:round; stroke-linejoin:round}

  @media(max-width:520px){ .card{padding:26px 18px} }
</style>
</head>
<body>

<div class="card">
  <div class="icon" aria-hidden="true">
    <svg class="ic" viewBox="0 0 24 24">
      <path d="M12 9v4"/>
      <path d="M10.36 3.59 2.26 17.13a1.91 1.91 0 0 0 1.63 2.87h16.22a1.91 1.91 0 0 0 1.63-2.87L13.64 3.59a1.91 1.91 0 0 0-3.28 0z"/>
      <path d="M12 16h.01"/>
    </svg>
  </div>

  <h1>This video is no longer available</h1>

  <p class="text">
    It may have been removed at the uploader's request, or taken down during a
    clean-up. There is nothing here to see now.
  </p>

  <!--
    The number is written out rather than left empty, so the sentence still
    reads properly before the script starts and for anyone without it.
  -->
  <!--
    Hidden until the script turns it on. Without JavaScript nothing counts
    down, and a line promising a redirect that never comes is worse than no
    line at all.
  -->
  <p class="count" id="countLine" hidden>
    Taking you to the home page in <strong id="count">3</strong> seconds.
  </p>

  <div class="actions">
    <a class="btn btn--primary" href="https://freemasala.com/">
      <svg class="ic" viewBox="0 0 24 24">
        <path d="M5 12H3l9-9 9 9h-2"/>
        <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/>
      </svg>
      Go now
    </a>
    <button type="button" class="btn" id="stay">
      <svg class="ic" viewBox="0 0 24 24">
        <path d="M18 6 6 18"/><path d="M6 6l12 12"/>
      </svg>
      Stay here
    </button>
  </div>
</div>

<script>
(function () {
  "use strict";

  /*
   * Match whatever theme the visitor picked on the site.
   *
   * Read before anything is drawn, so the page does not start in one colour
   * and switch. Wrapped because localStorage throws outright in some private
   * modes, and a colour scheme is not worth a broken countdown.
   */
  try {
    var saved = localStorage.getItem("theme");
    if (saved === "light" || saved === "dark") {
      document.documentElement.setAttribute("data-theme", saved);
    }
  } catch (e) { /* leave it on the system setting */ }

  var HOME    = "https://freemasala.com/";
  var SECONDS = 3;

  var out  = document.getElementById("count");
  var line = document.getElementById("countLine");
  var stay = document.getElementById("stay");

  var left  = SECONDS;
  line.hidden = false;
  var timer = setInterval(tick, 1000);

  function tick() {
    left -= 1;
    out.textContent = left > 0 ? left : 0;
    if (left <= 0) {
      clearInterval(timer);
      // replace, not assign: pressing back should go wherever they came from,
      // not return to this page and start the countdown again.
      location.replace(HOME);
    }
  }

  stay.addEventListener("click", function () {
    clearInterval(timer);
    line.textContent = "You can stay as long as you like.";
    stay.style.display = "none";
  });
})();
</script>

</body>
</html>