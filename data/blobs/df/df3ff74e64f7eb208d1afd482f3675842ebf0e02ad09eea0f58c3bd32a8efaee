<!DOCTYPE html>
<html lang="pt">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="UFC - Universidade Federal do Ceará" />
	<title>Página não encontrada - Universidade Federal do Ceará</title>
	<link rel="shortcut icon" href="https://ufc.br/favicon.ico" type="image/x-icon" />
	<link rel="preload" as="style" href="https://ufc.br/build/assets/app-DkhXq1rq.css" /><link rel="preload" as="style" href="https://ufc.br/build/assets/fonts-Chhz2gTk.css" /><link rel="stylesheet" href="https://ufc.br/build/assets/app-DkhXq1rq.css" data-navigate-track="reload" /><link rel="stylesheet" href="https://ufc.br/build/assets/fonts-Chhz2gTk.css" data-navigate-track="reload" /></head>
<body class="bg-ufc2 bg-cover bg-center min-h-screen flex flex-col items-center justify-between p-20">
	<div class="text-center text-white">
		<div class="container mx-auto max-w-[600px]">
			<img class="block mb-2 mx-auto w-50 h-auto" src="https://ufc.br/images/ufc-vertical.svg" alt="Brasão da UFC" width="200">
			<h1 class="text-3xl font-poppins font-semibold mb-1">Página não encontrada</h1>
			<p class="text-center text-xl mb-0!">Ops! A página que você procura não existe ou foi removida.</p>
                            <a href="https://ufc.br/pt" class="inline-block">
                    Voltar ao início                </a>
            		</div>
	</div>
    <div class="text-center text-white">
        <small class="error-code">Código 404</small>
    </div>
    <script>
        // Verifica a cada 10 minutos (600000 ms) se o servidor voltou a responder
        setInterval(function() {
            fetch(window.location.href)
                .then(function(response) {
                    if (response.status === 200) {
                        window.location.reload();
                    }
                })
                .catch(function(error) {
                    console.log('Servidor ainda indisponível');
                });
        }, 600000);
    </script>
</body>
</html>
