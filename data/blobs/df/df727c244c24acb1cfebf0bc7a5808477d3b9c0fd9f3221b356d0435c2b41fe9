    // What the page knows about the visitor, and everything that follows from it
    function applyUserData(userData) {
        window.isLoggedIn = userData.isLoggedIn;
        window.userName = userData.userName;
        window.userLevel = userData.userLevel;
        window.userId = userData.userId;

        // Update UI if function exists
        if (typeof updateUserInterface === 'function') {
            updateUserInterface();
        }
        // For widgets on cached pages that depend on who is looking (movie rating)
        window.sacnilkUser = userData;
        document.dispatchEvent(new CustomEvent('sacnilk:user', { detail: userData }));
    }

    // sn_li=1 is set at login and cleared at logout (webconfig/session-bootstrap.php). Without it nobody is logged
    // in here, and the page says so itself, with the same answer api/user-data.php gives a visitor with no session.
    function mayBeLoggedIn() {
        return /(?:^|;\s*)sn_li=1(?:;|$)/.test(document.cookie);
    }
    // My Sacnilk, the personal layer of a logged-in reader (assets/js/sn-me.js). This page is the same stored copy
    // for everyone, so the layer is loaded only for a browser that carries the login hint; nobody else downloads it.
    // The classes go on <html> here, before first paint: sn-li = may be logged in, sn-me-on = this browser had the
    // layer on its last page (so the home page keeps room for "My Films" and does not jump).
    (function () {
        var de = document.documentElement;
        de.classList.add('sn-follow-on');   // the Follow buttons are shown to every reader
        if (mayBeLoggedIn()) {
            de.classList.add('sn-li');
            try { if (localStorage.getItem('sn-me') === '1') { de.classList.add('sn-me-on'); } } catch (e) {}
            var css = document.createElement('link');
            css.rel = 'stylesheet';
            css.href = "/assets/css/sn-me.css?v=1792233689";
            var js = document.createElement('script');
            js.src = "/assets/js/sn-me.js?v=1792233690";
            js.defer = true;
            document.head.appendChild(css);
            document.head.appendChild(js);
            return;
        }
        // A logged-out tap on a Follow button: remember the film, log in, and come back to this page following it
        // (sn-me.js completes the follow once the reader is back and logged in).
        document.addEventListener('click', function (e) {
            var b = e.target && e.target.closest ? e.target.closest('[data-follow-film]') : null;
            if (!b) { return; }
            e.preventDefault();
            try { sessionStorage.setItem('sn-follow-pending', JSON.stringify({ id: b.getAttribute('data-follow-film'), t: Date.now() })); } catch (err) {}
            var base = window.sacnilk.base_path || '', path = location.pathname;
            if (base && path.indexOf(base + '/') === 0) { path = path.slice(base.length); }
            window.location.href = base + '/login?redirect=' + encodeURIComponent(path + location.search);
        });
    })();
    function loadUserDataIfLoggedIn() {
        if (mayBeLoggedIn()) {
            return loadUserData();
        }
        applyUserData({ isLoggedIn: false, userName: '', userLevel: 1, userId: '', timestamp: Math.floor(Date.now() / 1000) });
    }

    // Load user data dynamically
    // fresh === true (after a login on this page, e.g. the rating widget): bypass the 60 s browser copy of the
    // logged-out answer
    async function loadUserData(fresh) {
        try {
            let apiUrl = '/api/user-data.php';
            if(window.location.hostname === 'localhost') {
                apiUrl = '/sacweb/api/user-data.php';
            }
            const response = fresh === true
                ? await fetch(apiUrl + '?t=' + Date.now(), { cache: 'no-store', credentials: 'same-origin' })
                : await fetch(apiUrl);
            const result = await response.json();
            
            if (result.success && result.data) {
                // Not logged in after all (expired, or logged out elsewhere): drop the hint, so the next page asks nothing
                if (!result.data.isLoggedIn) {
                    document.cookie = 'sn_li=; Max-Age=0; path=/';
                }
                applyUserData(result.data);
                //console.log('User data loaded:', userData);
            } else {
                console.warn('Failed to load user data:', result.message);
            }
        } catch (error) {
            console.error('Failed to load user data:', error);
        }
    }
    
    // Load on page load, for a visitor who may be logged in
    document.addEventListener('DOMContentLoaded', loadUserDataIfLoggedIn);
    window.sacnilkReloadUser = function () { return loadUserData(true); };
    // A page restored from the back/forward cache keeps the login state it was first drawn with: refresh it
    window.addEventListener('pageshow', function (e) { if (e.persisted) { loadUserDataIfLoggedIn(); } });
    
