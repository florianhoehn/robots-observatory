  display: inline-flex;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50%;
  background: #e5e7eb;
  color: #4b5563;
}

#top-banner.header-prompt--affiliate .header-prompt__message {
  min-width: 0;
  margin: 0;
  overflow: hidden;
  text-align: left;
  line-height: 20px;
  white-space: nowrap;
  text-overflow: ellipsis;
}

#top-banner.header-prompt--affiliate .header-prompt__cta {
  display: inline-flex;
  height: 24px;
  align-items: center;
  gap: 2px;
  margin-left: 4px;
  padding: 0 4px;
  color: #1154ed;
  font-weight: 600;
  line-height: 20px;
  text-decoration: none;
  white-space: nowrap;
}

#top-banner.header-prompt--affiliate .header-prompt__close {
  position: absolute;
