    line-height: 18px;
  }

  #top-banner.header-prompt--affiliate .header-prompt__cta {
    display: none;
  }

  #top-banner.header-prompt--affiliate .header-prompt__message {
    flex: 1 1 auto;
  }
}

.www-home-chrome,
.www-home-chrome *,
.www-home-chrome *::before,
.www-home-chrome *::after {
  box-sizing: border-box;
}

/* 评价卡正文 */
.www-home-chrome blockquote {
  margin: 0;
  padding: 0;
}

/* 对比类内容 */
.www-home-chrome table {
  border-collapse: collapse;
  border-spacing: 0;
}

/* 标签切换、浮条关闭 */
.www-home-chrome__body button {
  appearance: none;
  margin: 0;
  padding: 0;
  border: 0;
  background: none;
  color: inherit;
  font: inherit;
  line-height: inherit;
  cursor: pointer;
}

/* FAQ 折叠（若承接页复用同一作用域） */
.www-home-chrome summary {
  display: list-item;
  cursor: pointer;
}

/* 标题层级：字号字重一律显式指定，不依赖浏览器默认 */
.www-home-chrome h1,
.www-home-chrome h2,
.www-home-chrome h3,
.www-home-chrome h4,
.www-home-chrome h5,
.www-home-chrome h6 {
  margin: 0;
  font-weight: 760;
  line-height: 1.1;
}

/* 评价卡、正文段落 */
.www-home-chrome figure,
.www-home-chrome p {
  margin: 0;
}

/* 视内容而定 */
.www-home-chrome hr,
.www-home-chrome pre {
  margin: 0;
}

.www-home-chrome img {
  display: block;
  max-width: 100%;
}

.www-home-chrome a {
  color: inherit;
  text-decoration: none;
}

/* ==========================================================================
   3. 布局容器与区块节奏
   ========================================================================== */

.hr-shell {
  width: calc(100% - 96px);
  max-width: 1200px;
  margin-inline: auto;
}

.hr-section {
  padding-block: 112px;
}

.hr-section--soft {
  background: var(--hr-soft);
}

/* 区块标题组 */
.hr-section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 70px;
  margin-bottom: 48px;
}

.hr-eyebrow {
  margin-bottom: 18px;
  color: var(--hr-blue);
  font-size: 11px;
  font-weight: 650;
  letter-spacing: 0.04em;
  line-height: 1.5;
}

.hr-eyebrow::before {
  content: "";
  display: inline-block;
  width: 4px;
  height: 4px;
  margin-right: 7px;
  border-radius: 50%;
  background: currentColor;
  vertical-align: middle;
}

/* ==========================================================================
   4. 按钮与文字链接
   ========================================================================== */

.hr-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  min-height: 50px;
  padding: 14px 28px;
  border-radius: 999px;
  background: var(--hr-blue);
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  transition:
    background 0.18s ease,
    box-shadow 0.18s ease,
    transform 0.18s ease;
}

/* 页面级 a 重置的特异性高于组件类；Hero 与浮条的 a 按钮保持白色文案。 */
.www-home-chrome .hr-v7-hero__action .hr-download-button,
.www-home-chrome .hr-scroll-bar .hr-download-button {
  color: #fff;
}

.hr-button:hover {
  background: #0d47d1;
  box-shadow: 0 4px 16px rgba(17, 84, 237, 0.25);
}

.hr-button:active {
  transform: translateY(1px);
}

.hr-button:focus-visible {
  outline: 3px solid var(--hr-blue);
  outline-offset: 5px;
}

/* 未确认落点：渲染为不可点元素，保留视觉与文案（design §1.2.1） */
.hr-button[data-link-todo="true"] {
  cursor: default;
}

.hr-text-link[data-link-todo="true"] {
  cursor: default;
  opacity: 0.72;
}

.hr-text-link {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  color: var(--hr-ink);
  font-size: 13px;
  font-weight: 600;
  transition: color 0.18s ease;
}

.hr-text-link:hover {
  color: var(--hr-blue);
  text-decoration: underline;
}

/* ==========================================================================
   5. 首屏 Hero（#hero）
   ========================================================================== */

.hr-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  padding-top: 58px;
  background: linear-gradient(
    180deg,
    #dceaff 0%,
    #e9f6ff 25%,
    var(--hr-paper) 59%
  );
}

.hr-hero > .hr-shell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
  max-width: 960px;
  text-align: center;
}

.hr-hero__title {
  font-size: clamp(54px, 4.42vw, 84px);
  font-weight: 850;
  line-height: 1.035;
  letter-spacing: -0.055em;
  text-wrap: balance;
}

.hr-hero__title span {
  color: var(--hr-blue);
  font-weight: 450;
}

.hr-hero__desc {
  max-width: 740px;
  color: var(--hr-muted);
  font-size: 18px;
  line-height: 1.65;
}

.hr-hero__action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.hr-hero__platform {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--hr-muted);
  font-size: 12px;
  line-height: 1.5;
}

/* 首屏主下载按钮呼吸动画（保留，design §1.2.5） */
.hr-hero__action .hr-download-button {
  animation: hr-download-breathe 2.8s ease-in-out infinite;
}

@keyframes hr-download-breathe {
  0%,
  100% {
    transform: scale(1);
    box-shadow: 0 12px 28px rgba(17, 84, 237, 0.13);
  }

  50% {
    transform: scale(1.035);
    box-shadow: 0 16px 34px rgba(17, 84, 237, 0.21);
  }
}

/* 标题高亮打字机（保留） */
.hr-hero__title .hr-hero-highlight {
  animation: hr-hero-highlight-type 30s steps(22, end) 0.15s infinite both;
}

@keyframes hr-hero-highlight-type {
  0% {
    clip-path: inset(0 100% 0 0);
  }

  5% {
    clip-path: inset(0 0 0 0);
  }

  99% {
    clip-path: inset(0 0 0 0);
  }

  100% {
    clip-path: inset(0 100% 0 0);
  }
}

/* 下载按钮：桌面直连、移动端「获取 PC 下载链接」两态 */
.hr-download-button .hr-download-button__mobile {
  display: none;
}

/* ==========================================================================
   6. 信任墙 Trust Bar（#trust，新增区块）
   ========================================================================== */

/*
 * 区块背景承接 Hero 渐变：Hero 渐变终点为 `#fcfdff`（即 --hr-paper），
 * 本区块从同一色起，经一层淡蓝沉降到 --soft，使首屏与信任墙读作同一段落。
 */
/*
 * Trust Bar（本模块替换 demo 的「关键数据」四卡）。
 */

.hr-trust {
  padding-bottom: 52px;
}

/* 桌面与宽屏：横向 4 项一行（产品文档 §四.1） */
.hr-trust__list {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 24px;
  margin: 0;
  padding: 0;
  list-style: none;
}

/* 平板（768–1023）：2×2 网格 */
@media (max-width: 1023px) {
  .hr-trust__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
}

/* 移动（<768）：纵向排列 */
@media (max-width: 767px) {
  .hr-trust {
    padding-block: 44px 52px;
  }

  .hr-trust__list {
    grid-template-columns: 1fr;
    gap: 16px;
  }
}

/*
 * 四张独立卡片：两列网格（图标列占 35% + 文案列自适应）。
 *
 * 不用 `justify-content: center`——卡片等宽但各卡文案长度不同，
 * 整组居中会让「图标 + 文案」的起点逐卡漂移，四张卡对不齐。
 * 图标列固定占 35%，图标在列内水平居中，文案列起点因此四卡一致。
 */
.hr-trust__item {
  display: grid;
  grid-template-columns: 35% minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  min-width: 0;
  min-height: 104px;
  padding: 20px 22px;
  border: 1px solid var(--hr-line);
  border-radius: var(--hr-radius-lg);
  background: var(--hr-paper);
}

.hr-trust__icon {
  flex: none;
  justify-self: center;
  width: 32px;
  height: 32px;
  color: var(--hr-blue);
}

.hr-trust__copy {
  min-width: 0;
}

.hr-trust__value {
  display: block;
  font-size: 24px;
  font-weight: 750;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.hr-trust__label {
  display: block;
  margin-top: 4px;
  color: var(--hr-muted);
  font-size: 13px;
  line-height: 1.4;
}

/* 新增动效：信任墙淡入（design §1.2.5） */
.hr-trust__item {
  animation: hr-fade-up 0.5s var(--hr-ease) both;
}

.hr-trust__item:nth-child(1) {
  animation-delay: 0ms;
}

.hr-trust__item:nth-child(2) {
  animation-delay: 100ms;
}

.hr-trust__item:nth-child(3) {
  animation-delay: 200ms;
}

.hr-trust__item:nth-child(4) {
  animation-delay: 300ms;
}

@keyframes hr-fade-up {
  from {
    opacity: 0;
    transform: translateY(12px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

/* ==========================================================================
   7. 核心功能（#features）— 6 卡，桌面 3 列 / 平板 2 列 / 移动单列
   ========================================================================== */

.hr-features__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.hr-feature-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding: 32px;
  border: 1px solid var(--hr-line);
  border-radius: var(--hr-radius-xl);
  background: var(--hr-paper);
  transition:
    border-color 0.3s var(--hr-ease),
    box-shadow 0.3s var(--hr-ease),
    transform 0.3s var(--hr-ease);
}

.hr-feature-card:hover {
  transform: translateY(-4px);
  border-color: var(--hr-blue);
  box-shadow: var(--hr-shadow-lg);
}

.hr-feature-card__name {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hr-feature-card__icon {
  flex: none;
  width: 24px;
  height: 24px;
}

.hr-feature-card__title {
  font-size: 27px;
  font-weight: 750;
  line-height: 1.18;
  letter-spacing: -0.035em;
}

.hr-feature-card__desc {
  margin-top: 12px;
  color: var(--hr-muted);
  font-size: 15px;
  line-height: 1.6;
}

/* 产品截图：16:9，固定宽高比避免布局偏移 */
.hr-feature-card__shot {
  margin-top: 20px;
  overflow: hidden;
  border-radius: var(--hr-radius-md);
  background: var(--hr-soft);
}

.hr-feature-card__shot img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
}

.hr-feature-card__link {
  margin-top: auto;
  padding-top: 20px;
}

/* tone 色系（图标色 + 截图底） */
.hr-feature-card[data-tone="blue"] .hr-feature-card__icon {
  color: var(--hr-tone-blue);
}

.hr-feature-card[data-tone="peach"] .hr-feature-card__icon {
  color: var(--hr-tone-peach);
}

.hr-feature-card[data-tone="lavender"] .hr-feature-card__icon {
  color: var(--hr-tone-lavender);
}

.hr-feature-card[data-tone="sky"] .hr-feature-card__icon {
  color: var(--hr-tone-sky);
}

.hr-feature-card[data-tone="mint"] .hr-feature-card__icon {
  color: var(--hr-tone-mint);
}

.hr-feature-card[data-tone="sand"] .hr-feature-card__icon {
  color: var(--hr-tone-sand);
}

/* ==========================================================================
   8. 用户声音（#reviews）— 只展示 12 条，无占位、无循环填充
   ========================================================================== */

.hr-reviews {
  background: var(--hr-soft);
}

/* 评分行：位于标题下方，与卡片保持明显间距 */
.hr-reviews__scores {
  display: flex;
  align-items: center;
  gap: 20px;
  margin: -16px 0 42px;
}

.hr-reviews__score {
  display: flex;
  align-items: baseline;
  gap: 8px;
  padding: 11px 22px 10px;
  border: 1px solid var(--hr-line);
  border-radius: 999px;
  background: var(--hr-paper);
}

.hr-reviews__score strong {
  font-size: 22px;
  font-weight: 750;
  line-height: 1;
}

.hr-reviews__score-stars {
  color: var(--hr-orange);
  font-size: 13px;
  letter-spacing: 0.06em;
}

.hr-reviews__score small {
  color: var(--hr-muted);
  font-size: 12px;
}

/* 横向匀速滚动（保留动画，速度稳定） */
.hr-reviews__viewport {
  overflow: hidden;
  /* 渐隐两侧边缘，避免卡片硬切 */
  mask-image: linear-gradient(
    90deg,
    transparent,
    #000 40px,
    #000 calc(100% - 40px),
    transparent
  );
}

.hr-reviews__track {
  display: flex;
  gap: 22px;
  width: max-content;
  animation: hr-reviews-marquee 453s linear infinite;
}

/* 悬停暂停，便于阅读与测试 */
.hr-reviews__viewport:hover .hr-reviews__track {
  animation-play-state: paused;
}

@keyframes hr-reviews-marquee {
  from {
    transform: translateX(0);
  }

  to {
    transform: translateX(-50%);
  }
}

.hr-review-card {
  display: flex;
  flex-direction: column;
  width: 360px;
  min-height: 240px;
  padding: 30px;
  border-radius: var(--hr-radius-2xl);
  background: var(--hr-paper);
  color: var(--hr-ink);
}

.hr-review-card__meta {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.hr-review-card__avatar {
  flex: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  background: var(--hr-soft);
}

.hr-review-card__author {
  font-size: 14px;
  font-weight: 650;
  line-height: 1.3;
}

.hr-review-card__stars {
  margin-top: 3px;
  color: var(--hr-orange);
  font-size: 12px;
  letter-spacing: 0.06em;
}

.hr-review-card__quote {
  color: var(--hr-ink);
  font-size: 14px;
  line-height: 1.65;
}

.hr-review-card__source {
  margin-top: auto;
  padding-top: 16px;
  color: var(--hr-muted);
  font-size: 11px;
}

/* ==========================================================================
   9. Premium 会员（#premium）— 静态 4 卡网格，无跑马灯、无悬停放大
   ========================================================================== */

.hr-premium {
  background: var(--hr-ink);
  color: #fff;
}

.hr-premium .hr-section-heading {
  align-items: flex-start;
}

.hr-premium__title {
  color: #fff;
  font-size: clamp(34px, 2.75vw, 52px);
  font-weight: 760;
  line-height: 1.08;
  letter-spacing: -0.045em;
}

.hr-premium__title span {
  color: #87b1ff;
}

.hr-premium__desc {
  max-width: 44ch;
  margin-top: 18px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 16px;
  line-height: 1.65;
}

/* 4 卡网格：桌面 4 列 / 平板 2 列 / 移动 1 列 */
.hr-premium__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-top: 48px;
}

.hr-premium-card {
  display: flex;
  