/*
 * 首页重构版样式 — TS 海外官网首页改造
 *
 * 来源：设计基线原型 `TS海外官网-V7.3/src/app/globals.css`（产品提供的 demo）。
 * 口径：见 design/fe §1.2.2 / §1.2.3 / §1.2.5。
 *
 * 三条硬约束（违反会导致线上走样）：
 *
 * 1) 【替换而非追加】本文件在 `WWW_HOME_GLOBAL_STYLESHEETS` 中**替换**了
 *    `www-home-global.css`。旧样式含 25 条 `html[lang="…"]` 作用域规则，特异性高于
 *    普通类选择器，两者同时内联会导致只有俄语/西语等页面走样。
 *
 * 2) 【类名一律 `hr-` 前缀】不复用与全站同名的全局类名（`.wrap` / `.section` /
 *    `.button` / `.shell` / `.grid` / `.actions` / `.eyebrow` / `.lead` 等）。
 *
 * 3) 【资源引用不带引号】本地资源一律用不带引号的 url() 写法，让
 *    `assertCssLocalAssetRefs` 的构建期校验真正生效（该断言的正则只匹配不带引号的 url()）。
 *    注意：本文档注释里**不要写出该函数的匹配示例**，否则会被当成真实引用导致构建失败。
 *
 * 断点：验收按产品文档 375 / 768 / 1024 / 1440；CSS 内部沿用 demo 的
 * 600 / 820 / 1100 / 1400 作辅助断点（实测四个验收宽度两套结论一致，见 design §1.2.3）。
 */

/* ==========================================================================
   1. 设计 Token（以 demo `:root` 为唯一依据，与产品文档 §4.1.1 逐值一致）
   ========================================================================== */

.www-home-chrome {
  --hr-blue: #1154ed;
  --hr-ink: #0f172a;
  --hr-paper: #fcfdff;
  --hr-soft: #f5f6f9;
  --hr-orange: #ff8800;
  --hr-peach: #fddab2;
  --hr-muted: #646d7f;
  --hr-line: #e4e7ee;

  /* 功能卡片 tone 色系 */
  --hr-tone-blue: #1154ed;
  --hr-tone-blue-bg: #eaf1ff;
  --hr-tone-peach: #ff8800;
  --hr-tone-peach-bg: #fff0e0;
  --hr-tone-lavender: #7c6ff0;
  --hr-tone-lavender-bg: #f0edff;
  --hr-tone-sky: #0ba5e5;
  --hr-tone-sky-bg: #e0f4fe;
  --hr-tone-mint: #10b981;
  --hr-tone-mint-bg: #e6faf1;
  --hr-tone-sand: #e59b3f;
  --hr-tone-sand-bg: #fff5e6;

  /* 圆角与阴影 */
  --hr-radius-sm: 8px;
  --hr-radius-md: 12px;
  --hr-radius-lg: 16px;
  --hr-radius-xl: 18px;
  --hr-radius-2xl: 22px;
  --hr-shadow-sm: 0 2px 8px rgba(15, 23, 42, 0.04);
  --hr-shadow-md: 0 4px 16px rgba(15, 23, 42, 0.06);
  --hr-shadow-lg: 0 8px 24px rgba(17, 84, 237, 0.08);
  --hr-shadow-xl: 0 8px 32px rgba(15, 23, 42, 0.12);

  /* 缓动 */
  --hr-ease: cubic-bezier(0.16, 1, 0.3, 1);

  /* 导航高度（供锚点滚动补偿，见 design §1.2.10 / §1.2.11）。
     取改造后的目标值 72px；当前线上导航包 0.1.9 仍为 80px，待 0.1.10 发版后一致。
     在发版前，锚点定位会有 8px 偏差（不遮挡内容，仅落点略偏），见 plan/fe「残余关注点」。 */
  --hr-nav-h: 72px;

  /* 字体：使用 V7.3 demo 的 Inter 字体 */
  font-family: Inter, Arial, Helvetica, sans-serif;
  color: var(--hr-ink);
  background: var(--hr-paper);
}

/* ==========================================================================
   2. 基础重置补偿
   --------------------------------------------------------------------------
   线上首页**不加载** legacy `base.css`，本文件取代的旧首页样式只覆盖了
   box-sizing / html,body / a / ul,ol / dl,dt,dd / img 六类。
   demo 依赖其样式框架的 preflight 提供其余元素默认值，此处必须显式补偿，
