<script>
(function() {
    'use strict';

    // 允許的正式網域清單，請填寫純網域，不要加 https:// 或斜線 /
    var ALLOWED_DOMAINS = [
        "www.ncu.edu.tw",
        "localhost",
        "127.0.0.1"
    ];

    // 非授權網域時，導回的正式網站首頁
    var OFFICIAL_BASE = "https://www.ncu.edu.tw";

    // 取得目前網頁所在網域
    var currentHost = window.location.hostname.toLowerCase();

    // 檢查目前網域是否為允許網域，或允許網域的子網域
    var isAllowed = ALLOWED_DOMAINS.some(function(domain) {
        var targetDomain = domain.toLowerCase();
        return currentHost === targetDomain || currentHost.endsWith("." + targetDomain);
    });

    // 若不是允許網域，則導回正式網站相同路徑
    if (!isAllowed) {
        try {
            var targetPath = encodeURI(window.location.pathname + window.location.search);
            window.location.replace(OFFICIAL_BASE + targetPath);
        } catch (e) {
            window.location.replace(OFFICIAL_BASE);
        }
    }
})();
</script>

