<style type="text/css">/* --- 可客製化 CSS 變數 --- */
:root{
  --marquee-btn-size: 20px;                 /* 按鈕直徑 */
  --marquee-btn-bg: #000;                   /* 黑底 */
  --marquee-btn-color: #fff;                /* 白圖示 */
  --marquee-btn-border: #000;
  --marquee-btn-bg-hover: #111;
  --marquee-btn-bg-active: #1a1a1a;
  --marquee-btn-shadow: 0 1px 3px rgba(0,0,0,.32);
  --marquee-btn-shadow-hover: 0 2px 6px rgba(0,0,0,.45);
  --marquee-btn-shadow-focus: 0 0 0 3px rgba(0,153,255,.45);
}

/* --- 外層容器：提供定位與留白，避免內容被按鈕遮住 --- */

.marquee-wrap {
    position: relative;
}
/* 透明保護區：避免按鈕附近點到跑馬燈連結/內容 */
.marquee-wrap .marquee-click-shield{
  position: absolute;
  top: 0;
  left: 0;
  width: calc(var(--marquee-btn-size) + 14px);
  height: calc(var(--marquee-btn-size) + 14px);
  z-index: 2; /* 低於按鈕(z=1000)，高於文字(z=1) */
  background: transparent;
}

/* --- 圓形圖示按鈕：固定左上角 --- */
.marquee-toggle-btn{
  width: var(--marquee-btn-size);
  height: var(--marquee-btn-size);
  min-width: var(--marquee-btn-size);
  min-height: var(--marquee-btn-size);
  border-radius: 50%;

  position: absolute;
  top: 6px;
  left: 6px;
  z-index: 1000;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0;
  margin: 0;
  border: 1px solid var(--marquee-btn-border);
  background: var(--marquee-btn-bg);
  color: var(--marquee-btn-color);
  box-shadow: var(--marquee-btn-shadow);
  cursor: pointer;

  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;  /* 行動裝置點擊更穩 */
  user-select: none;

  transition: background-color 120ms ease, box-shadow 120ms ease, transform 60ms ease;
}

.marquee-toggle-btn:hover{
  background: var(--marquee-btn-bg-hover);
  box-shadow: var(--marquee-btn-shadow-hover);
}
.marquee-toggle-btn:active{
  background: var(--marquee-btn-bg-active);
  transform: translateY(.5px);
}
.marquee-toggle-btn:focus-visible{
  outline: none;
  box-shadow: var(--marquee-btn-shadow-focus);
}

/* SVG icon（吃 currentColor -> 白色） */
.marquee-toggle-btn .icon{
  width: 16px;
  height: 16px;
  display: block;
}

/* 手機可選擇放大一點（可改） */
@media (max-width:480px){
  :root{ --marquee-btn-size: 40px; }
}
</style>
<script>
(function ($) {
  $(function () {

    // 1) 載入 banner（保留你的寫法）
    if ($.hajaxOpenUrl && typeof $.hajaxOpenUrl === 'function') {
      $.hajaxOpenUrl("/app/index.php?Action=mobileloadmod&Type=mobile_sz_mstr&Nbr=15", "#banner");
    }


    // 防抖
    function debounce(fn, delay) {
      var t;
      return function () {
        clearTimeout(t);
        var ctx = this, args = arguments;
        t = setTimeout(function () { fn.apply(ctx, args); }, delay);
      };
    }

    // 2) 初始化跑馬燈（避免重複初始化）
    var $marquees = $(".md_style7 .mb").filter(function () {
      var $el = $(this);
      if ($el.data("marquee-initialized")) return false;
      $el.data("marquee-initialized", true);
      return true;
    });

    if ($marquees.length) {
      $marquees.each(function (idx) {
        var $el = $(this);

        // 建立/取得外層定位容器（按鈕固定左上角需要）
        var $wrap;
        if ($el.parent().hasClass('marquee-wrap')) {
          $wrap = $el.parent();
        } else {
          $el.wrap('<div class="marquee-wrap"></div>');
          $wrap = $el.parent();
        }

        // 透明保護區：避免按鈕附近點到內容
        if ($wrap.find('.marquee-click-shield').length === 0) {
          $wrap.append('<div class="marquee-click-shield" aria-hidden="true"></div>');
        }

        // 若跑馬燈本身沒有可聚焦元素，給它 tabindex，讓鍵盤也能焦點進入以暫停（GN1220200E 常看）
        if (!$el.attr("tabindex")) $el.attr("tabindex", "0");

        // 確保 id 給 aria-controls 用
        if (!$el.attr('id')) {
          $el.attr('id', 'marquee_' + (Date.now()) + '_' + idx);
        }
        var marqueeId = $el.attr('id');

        // 初始化外掛（關閉內建 pauseOnHover，避免與手動暫停打架）
 setTimeout(function(){ 
     $el.addClass("marquee").marquee({
          loop: -1,
          speed: 150,
          duplicated: true,
          pauseOnHover: false,   // 關閉：改由我們自行控管
          pauseSpeed: 200,
          startVisible: true
        });
    }, 800);

        // 狀態
        $el.data("manualPaused", false); // 使用者按鈕控制
        $el.data("hoverPaused",  false); // hover/focus 控制（暫停原因之一）

        // SVG 圖示（白色）
        var svgPlay  = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>';
        var svgPause = '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>';

        // 按鈕：放在 wrap 最前面，確保無障礙順序先到它
        var $btn = $(
          '<button type="button" class="marquee-toggle-btn" ' +
          'aria-pressed="false" aria-controls="' + marqueeId + '" ' +
          'aria-label="暫停校園生活跑馬燈" title="暫停校園生活跑馬燈">' +
          svgPause +
          '</button>'
        );
        $wrap.prepend($btn);

        function setBtnState(isPaused) {
          $btn
            .attr("aria-pressed", String(isPaused))
            .attr("aria-label", isPaused ? "暫停校園生活跑馬燈" : "暫停校園生活跑馬燈")
            .attr("title",      isPaused ? "播放校園生活跑馬燈" : "暫停校園生活跑馬燈")
            .html(isPaused ? svgPlay : svgPause);
        }

        function pauseMarquee()  { if (typeof $el.marquee === "function") $el.marquee('pause'); }
        function resumeMarquee() { if (typeof $el.marquee === "function") $el.marquee('resume'); }

        // 手動切換（暫停優先）
        function toggleManual() {
          var manualPaused = !!$el.data("manualPaused");
          var hoverPaused  = !!$el.data("hoverPaused");

          manualPaused = !manualPaused;
          $el.data("manualPaused", manualPaused);

          if (manualPaused) {
            pauseMarquee();
            setBtnState(true);
          } else {
            // 解除手動暫停 → 若仍處於 hover/focus 暫停中，維持暫停
            if (!hoverPaused) resumeMarquee();
            else pauseMarquee();
            setBtnState(false);
          }
        }

        // ======= 重要：避免按鈕事件穿透到底下跑馬燈內容 =======
        function onActivate(e) {
          if (e) { e.preventDefault(); e.stopPropagation(); }
          toggleManual();
        }

        // 行動裝置/桌機：pointerup 優先；fallback touchend/click
        var recentTouch = false;
        var recentPointerUp = false;

        if (window.PointerEvent) {
          $btn[0].addEventListener('pointerup', function (e) {
            if (e.pointerType === 'mouse' && e.button !== 0) return;
            recentPointerUp = true;
            setTimeout(function(){ recentPointerUp = false; }, 350);
            onActivate(e);
          });

          // 避免 pointerup 後又觸發 click 造成雙切換
          $btn.on('click', function(e){
            if (recentPointerUp) { e.preventDefault(); e.stopPropagation(); return; }
            onActivate(e);
          });
        } else {
          // touchend 直接觸發切換（避免 click 被 preventDefault 阻掉）
          $btn[0].addEventListener('touchend', function (e) {
            recentTouch = true;
            setTimeout(function(){ recentTouch = false; }, 350);
            onActivate(e);
          }, { passive: false });

          $btn.on('click', function(e){
            if (recentTouch) { e.preventDefault(); e.stopPropagation(); return; }
            onActivate(e);
          });
        }

        // 鍵盤操作（Space/Enter）
        $btn.on("keydown", function (e) {
          if (e.key === " " || e.key === "Enter") {
            onActivate(e);
          }
        });

        // ======= 自訂 hover：移入暫停，移出視情況恢復（尊重手動暫停） =======
        $el.on("mouseenter", function () {
          $el.data("hoverPaused", true);
          pauseMarquee();
        });
        $el.on("mouseleave", function () {
          $el.data("hoverPaused", false);
          if (!$el.data("manualPaused")) resumeMarquee();
          else pauseMarquee();
        });

        // ======= GN1220200E 加分：鍵盤焦點進入也暫停 =======
        // focusin：焦點落到跑馬燈本體或其內任何可聚焦元素（連結）就暫停
        $wrap.on("focusin", function () {
          $el.data("hoverPaused", true);
          pauseMarquee();
        });
