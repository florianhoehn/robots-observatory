<script>
	/**
     * Helper class to synchronize Silktide Consent Manager (STCM) state with a domain level cookie
     * to ensure the consent state is retained across ttu.edu subdomains
     */
    class AnalyticsConsentHelper {
        settings = {
            namespace: 'stcm',

            timestampKey: 'stcm._updated',
            gtagEventName: 'stcm_consent_update',
            
            cookieDomain: 'ttu.edu',
            cookieDuration: 12 // in Months
            
        }

        /**
         * Syncs localStorage and cookie consent data with the version that contains the most resent timestamp.
         */
        constructor() {
            let self = this;
            let cookie = self.cookie.get(self.settings.namespace);
            let ls_time = localStorage.getItem(self.settings.timestampKey);
                    
            // If cookie exists and timestamp is a number
            if (cookie && !isNaN(cookie[self.settings.timestampKey])) {
                let cookie_time = cookie[self.settings.timestampKey];

                /** CASE: timestamps are equal **/
                // If dates are equal, then no data sync is needed
                if (cookie_time === ls_time) return;


                /** CASE: Cookie's timestamp is newer **/
                // if localStorage doesn't exist or is older than cookie last updated date
                if (!ls_time || (cookie_time > ls_time)) {
                    
                    self.localStorage.set(cookie);
                    
                    return; // sync finished
                }
            }
            
            /** CASE: Either localStorage only OR no data */
            let dataForCookie = self.localStorage.get();

            // If no timestamp, create it for both data sources
            if (!ls_time) {
                ls_time = new Date().getTime();

                localStorage.setItem(self.settings.timestampKey, ls_time);
                dataForCookie[self.settings.timestampKey] = ls_time;
            }

            self.cookie.set(dataForCookie);
        }

        
        /** 
         * LocalStorage accesor methods
         * 
         */
        localStorage = {

            /**
             * Gets localStorage values that start with the value set in `localStorageName`
             * 
             * @returns {Object} JSON object of localstorage data
            */
            get: () => {
                const data = {};
                
                for (let i = 0; i < localStorage.length; i++) {
                    const key = localStorage.key(i);
                    
                    // e.g. starts with "stcm."
                    if(key.startsWith(this.settings.namespace + '.')) {
                        data[key] = localStorage.getItem(key);
                    }
                }
                
                return data;
            },
            
            
            set: (data) => {
                Object.entries(data).forEach(([key, value]) => {
                    if (value) localStorage.setItem(key, value);
                });
            }
        }

        /** cookie accesor methods */
        cookie = {

            /**
             * Get cookie by name
             * 
             * @this {AnalyticsConsentHelper}
             * @returns {string} Returns the cookie value or undefined
             */
            get: () => {

                const value = `; ${document.cookie}`;
                const parts = value.split(`; ${this.settings.namespace}=`);
                if (parts.length === 2) {
                    let cookieString = parts.pop().split(';').shift();

                    try {
                        return JSON.parse(cookieString);
                    } catch {
                        return undefined;
                    }
                }
            },

            /**
             * Updates a cookie with with provided JSON data
             * 
             * @param {object} data A JSON object containing the cookie data
             * @this {AnalyticsConsentHelper}
             */
            set: (data) => {
                // encoded data object
                var cookieString = JSON.stringify(data);
                
                // Create date offset
                var expireDate = new Date();
                expireDate.setMonth(expireDate.getMonth() + this.settings.cookieDuration);

                // create/overwrite cookie
                document.cookie = this.settings.namespace + "=" + cookieString + ";expires=" + expireDate + ";domain=" + this.settings.cookieDomain + ";path=/";
            },

            /**
             * Syncs cookie with localStorage and updates the timestamp for both
             * 
             * @this {AnalyticsConsentHelper}
             */
            sync: () => {
                // delay to prevent edge case where localstorage hasn't finished updating yet
                setTimeout(() => {
                    let dataForCookie = this.localStorage.get();
                
                // Update timestamp
                let timestamp = new Date().getTime();
                localStorage.setItem(this.settings.timestampKey, timestamp);
                dataForCookie[this.settings.timestampKey] = timestamp;

                this.cookie.set(dataForCookie);
                }, 200);
                
            }
        }
    }
	window.analyticsConsentHelper = new AnalyticsConsentHelper();
	
