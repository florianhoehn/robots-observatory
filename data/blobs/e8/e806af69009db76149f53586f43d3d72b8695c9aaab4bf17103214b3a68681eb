				}

				const target = CONFIG[site];
				window.__GA4_TARGET = target;

				let authUserId = null;
				try {
					authUserId = localStorage.getItem('auth_user_id');
				} catch (_) {}

				let accountType = 'anonymous';
				let sourceCampaign = null;
				try {
					const LOCAL_USER_INFO_KEY = 'local_user_info';
					const FEATURE_PREMIUM = 'premium';
					const localAuthUserInfoJson = localStorage.getItem(LOCAL_USER_INFO_KEY);
					if (localAuthUserInfoJson) {
						const localAuthUserInfo = JSON.parse(localAuthUserInfoJson);
						const now = Date.now();
						accountType = localAuthUserInfo.promos?.some(
							(p) => p.feature === FEATURE_PREMIUM && now < p.expires_at
						)
							? 'premium'
							: 'free';
						sourceCampaign = localAuthUserInfo.signupSource?.campaign ?? null;
					}
				} catch (_) {}

				const script = document.createElement('script');
				script.src = `https://www.googletagmanager.com/gtag/js?id=${target}`;
				script.async = 1;
				document.head.appendChild(script);

				window.dataLayer = window.dataLayer || [];
				function gtag() {
					dataLayer.push(arguments);
				}
				gtag('js', new Date());
				gtag('config', target, {
					send_page_view: false,
					user_id: authUserId,
					user_properties: {
						bucket: window.__CLIQ_BUCKET,
						account_type: accountType,
						source_campaign: sourceCampaign
					}
				});
			}
		</script>

