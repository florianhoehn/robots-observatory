    <script>

        function initPopWin() {
            $.get("/templatedata/popwin.txt?t=" + new Date().getTime(), result => {
                let data = JSON.parse(result)
                if (!data) return;
                
                let { id, hour, img, button, text, text2, link, openpc, showType } = data;
                let box = $("#imagePopWin")

                if (showType == 0 && location.pathname != "/" && location.pathname != "/vi" && location.pathname != "/th") {
                    return;
                }

                box.addClass(showType == 0 ? "v1" : "v2");
                box.append(`
                        <i class="closebtn" onclick="closeImgPopWin(${id},${hour})"></i>
                        <p>${text}${text2 ? `<span>${text2}</span>` : ""}</p>
                        <button onclick="goToPopWinLink('${link}',${showType})">${button}<i></i></button>
                        <img class="adimg" src="${img}" />
                    `)

                let click = getCookie(`popWin_${id}`)
                if (!click && openpc) {
                    setTimeout(() => {
                        box.show()
                        writeShareCookie(`popWin_${id}`, "1", new Date(new Date().getTime() + 1000 * 3600 * hour))
                    }, 1000)
                }
            })
        }
        initPopWin()

        function goToPopWinLink(link, showType) {
            $("#imagePopWin .closebtn").click()
            if (showType == 1) {
                let tipsUrl = _cmsWebDomain.replace(/\/+$/, '')
                if (!isUserLogin()) {
                    handleBackFromBf2(`${tipsUrl}/account/register`)
                } else {
                    if (0 == 1) {
                        location.href = `${tipsUrl}${prefix}/#pk`
                    }
                }
            } else {
                window.open(link)
            }
        }

        function closeImgPopWin(id, hour) {
            $("#imagePopWin").hide()
            writeShareCookie(`popWin_${id}`, "1", new Date(new Date().getTime() + 1000 * 3600 * hour))
        }
    </script>

