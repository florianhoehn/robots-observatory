<script>
	// ===== 最新検索だけを描画するためのトークン管理 =====
	let latestSearchToken = 0;
	let pendingCount = 0;
	
	// ===== GenAI検索（安全版） =====
	async function generateContentForQuery(queryString) {
		const target = document.querySelector('#container-target');
		const searchSubmitButton = document.querySelector(".rtgai-search-submit");
		if (!target) return;

		const token = ++latestSearchToken; // この呼び出しを最新として記録
		pendingCount++;
		if (searchSubmitButton) searchSubmitButton.disabled = true;

		// ローディング表示
		target.innerHTML = '<div class="loading" style="width: 60px; height: 60px; border: 8px solid #cccccc; border-top-color: #0d497f; border-radius: 50%; animation: genai-spin 1s linear infinite; margin: 50px auto;"></div>';

		try {
			const html = await RtoasterGenAI.generate('ulw6h5lflgcw', queryString);

			// 最新呼び出しでなければ描画しない（初回の気温検索が後から返っても上書きしない）
			if (token !== latestSearchToken) return;

			target.innerHTML = html;
		} catch (error) {
			if (token !== latestSearchToken) return;
			target.innerHTML = "";
		} finally {
			pendingCount--;
			if (pendingCount === 0 && searchSubmitButton) {
				searchSubmitButton.disabled = false;
			}
		}
	}
	
	// ---- 東京の現在気温を気温帯に分類 ----
	async function getTokyoTempBand() {
		// 東京（新宿あたり）
		const lat = 35.6895;
		const lon = 139.6917;

		// 簡易キャッシュ（30分）
		const cacheKey = "tokyoTempBand";
		const ttlKey = "tokyoTempBand_ttl";
		const now = Date.now();
		const ttl = Number(sessionStorage.getItem(ttlKey) || 0);
		const cached = sessionStorage.getItem(cacheKey);
		if (cached && ttl > now) return cached;

		const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lon}&current_weather=true&timezone=Asia%2FTokyo`;
		const res = await fetch(url);
		if (!res.ok) throw new Error("weather fetch failed");
		const data = await res.json();

		const tempC = data?.current_weather?.temperature; // 摂氏
		if (typeof tempC !== "number") throw new Error("temperature missing");

		const band = tempToBand(tempC);

		// 30分キャッシュ
		sessionStorage.setItem(cacheKey, band);
		sessionStorage.setItem(ttlKey, String(now + 30 * 60 * 1000));

		return band;
	}
	
	// 気温しきい値はお好みで調整可
	function tempToBand(t) {
		if (t >= 33) return "very_hot";  // 猛暑
		if (t >= 28) return "hot";       // 真夏日ライン
		if (t >= 22) return "warm";      // 初夏/秋晴れ
		if (t >= 16) return "mild";      // ちょうどよい
		if (t >= 9)  return "cool";      // 肌寒い
		return "cold";                   // 寒い
	}
	
	// ===== 起動処理 =====
	document.addEventListener("DOMContentLoaded", async () => {
		RtoasterGenAI.init('GENAI-3c1m-ynm7vl9be3a7', { withActionPlus: true });

		const urlParams = new URLSearchParams(window.location.search);
		let query = urlParams.get('q');

		if (!query) {
			// qが無ければ「東京の現在気温」に基づく候補からランダム選択
			const band = await getTokyoTempBand().catch(() => null);

			// 気温帯ごとの候補（自由に差し替えOK）
			const candidatesByTemp = {
			very_hot: ["かき氷", "冷やし中華", "日傘", "アイスコーヒー", "日焼け防止", "熱中症対策"],
			hot:      ["ビール テラス", "冷製パスタ", "日陰 カフェ", "薄手 Tシャツ"],
			warm:     ["テラスランチ", "公園 ピクニック", "サイクリング", "アイス カフェ", "はおりもの", "おでかけ"],
			mild:     ["パン屋 モーニング", "美術館", "散歩 カフェ", "レイトランチ"],
			cool:     ["ラーメン", "サウナ", "温泉 日帰り", "焼きいも"],
			cold:     ["鍋料理", "おでん", "ホットチョコ", "室内 アクティビティ", "防寒着", "ダウンコート"]
			};

			const fallbackCandidates = ["秋を感じる", "お出かけ気分", "食欲の秋", "旅行", "ミュージアム"]; // 失敗時
			const list = (band && candidatesByTemp[band]) || fallbackCandidates;

			query = list[Math.floor(Math.random() * list.length)];
		}

		// 初回検索を実行（気温ベース or qパラメータ）
		await generateContentForQuery(query);

		// inputに表示（任意）
		const inputEl = document.getElementById("rtgai-input");
		if (inputEl && urlParams.get('q')) {
			inputEl.value = urlParams.get('q');
		}

		// ===== フォーム送信：気温ロジックは一切使わず、入力値のみで検索 =====
		const form = document.getElementById("rtgai-search-form");
		if (form) {
			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const inputEl = document.getElementById("rtgai-input");
				const searchText = (inputEl?.value || "").trim();
				if (!searchText) return;

				// 入力値で検索（気温ロジックは無視）
				generateContentForQuery(searchText);

				// 見出し更新（必要なら表示領域用）
				const insert = document.getElementById("insert-query");
				if (insert) insert.textContent = searchText;

				// URL を ?q=... に置換 → リロード・共有時も気温ロジックを回避
				history.replaceState(null, "", `?q=${encodeURIComponent(searchText)}`);
			});
		}
	});
</script>




