function smrDismissNotif() {
  var bar = document.getElementById('smr-notif-bar');
  if (bar) {
    bar.style.transition = 'max-height 0.25s ease, opacity 0.2s ease, padding 0.2s ease';
    bar.style.overflow = 'hidden';
    bar.style.maxHeight = bar.offsetHeight + 'px';
    bar.style.opacity = '1';
    requestAnimationFrame(function(){
      bar.style.maxHeight = '0';
      bar.style.opacity = '0';
      bar.style.padding = '0';
    });
    setTimeout(function(){ bar.style.display = 'none'; }, 300);
  }
  try { localStorage.setItem('smr_notif_dismissed_v1', '1'); } catch(e){}
}
</script>

        

