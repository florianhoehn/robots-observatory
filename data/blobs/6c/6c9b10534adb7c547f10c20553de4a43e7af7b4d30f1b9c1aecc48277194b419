        border-top: none;
        border-bottom: none;
    }

        /* Sıralı listede numara bazen içeriğe taşmasın */
        .header-lang::marker {
            content: none;
        }

    .header-lang__box {
        position: relative;
    }

    .header-lang .lang-trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 3px 8px 3px 5px;
        border-radius: 999px;
        border: none;
        background: #fff;
        color: #1e2a78;
        cursor: pointer;
        font: inherit;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .header-lang .lang-trigger:hover {
            border-color: rgba(30, 42, 120, 0.45);
            box-shadow: 0 1px 4px rgba(30, 42, 120, 0.12);
        }

        .header-lang .lang-trigger:focus-visible {
            outline: 2px solid #1e2a78;
            outline-offset: 2px;
        }

    .header-lang .lang-trigger__flags {
        position: relative;
        width: 24px;
        height: 24px;
        flex-shrink: 0;
    }

        .header-lang .lang-trigger__flags .lang-flag-wrap {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            overflow: hidden;
            display: none;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(0, 0, 0, 0.08);
        }

            .header-lang .lang-trigger__flags .lang-flag-wrap.is-shown {
                display: flex;
            }

        .header-lang .lang-trigger__flags .lang-flag-svg {
            width: 100%;
            height: 100%;
            display: block;
            flex-shrink: 0;
        }

    .header-lang .lang-flag-svg--tr-official {
        min-width: 100%;
        min-height: 100%;
    }

    .header-lang .lang-trigger__chev {
        flex-shrink: 0;
        align-self: center;
        width: 0;
        height: 0;
        border-left: 4px solid transparent;
        border-right: 4px solid transparent;
        border-top: 5px solid rgba(30, 42, 120, 0.55);
        transition: transform 0.2s ease;
    }

    .header-lang.is-open .lang-trigger__chev {
        transform: rotate(180deg);
    }

    .header-lang .lang-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        right: auto;
        transform: translateX(-50%);
        min-width: 11rem;
        margin: 0;
        padding: 4px;
        list-style: none;
        background: #fff;
        border: 1px solid rgba(30, 42, 120, 0.18);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(30, 42, 120, 0.12);
        z-index: 2000;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 2px;
    }

        .header-lang .lang-menu[hidden] {
            display: none !important;
        }

    .header-lang .lang-option {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 12px;
        width: 100%;
        padding: 10px 12px;
        border: none;
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        font: inherit;
        text-align: left;
        color: #1a1f36;
        transition: background 0.15s ease;
    }

        .header-lang .lang-option:hover {
            background: rgba(30, 42, 120, 0.06);
        }

        .header-lang .lang-option:focus-visible {
            outline: 2px solid #1e2a78;
            outline-offset: -2px;
        }

        .header-lang .lang-option[aria-selected="true"] {
            background: rgba(30, 42, 120, 0.1);
            font-weight: 600;
        }

    .header-lang .lang-option__icon {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        overflow: hidden;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(0, 0, 0, 0.08);
    }

        .header-lang .lang-option__icon .lang-flag-svg {
            width: 100%;
            height: 100%;
            display: block;
        }

        .header-lang .lang-option__icon .lang-flag-svg--tr-official {
            min-width: 100%;
            min-height: 100%;
        }

    .header-lang .lang-option__text {
        flex: 1;
    }

