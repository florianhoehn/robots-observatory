<script type="text/javascript">
 
document.addEventListener('click', function (e) {
    const copyIcon = e.target.closest('.copy-icon');
    if (copyIcon) {
      const wrapper = copyIcon.closest('.code-wrapper');
      const codeBlock = wrapper.querySelector('.code-block');
      const svg = copyIcon.querySelector('svg');
      const copiedText = copyIcon.querySelector('.copied-text');

      if (codeBlock && svg && copiedText) {
        navigator.clipboard.writeText(codeBlock.innerText).then(() => {
          // Show "Copied", hide icon
          svg.style.display = "none";
          copiedText.style.display = "inline";
          copyIcon.classList.add("copied");

          setTimeout(() => {
            // Revert back
            svg.style.display = "block";
            copiedText.style.display = "none";
            copyIcon.classList.remove("copied");
          }, 1500);
        });
      }
    }
  });
</script>
