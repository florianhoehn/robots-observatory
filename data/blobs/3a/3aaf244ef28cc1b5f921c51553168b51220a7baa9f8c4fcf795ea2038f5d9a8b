/* ===== Shared design tokens (comparison-table, key-differentiators, tool-fits) ===== */
.cg-rd{
  --brand-color:#00ADE4;--near-black:#14120b;--text-primary:#202020;--text-secondary:#5a5a62;
  --text-tertiary:#484851;--text-muted:#6e6e74;--bg-canvas:#fafafa;--bg-surface:#f6f6f6;
  --bg-white:#ffffff;--border-light:#e2e8f0;--text-h3:2rem;--text-body:1rem;--text-body-sm:0.875rem;
  --text-label:0.75rem;--leading-tight:1.10;--leading-comfortable:1.20;--leading-ui:1.25;
  --leading-relaxed:1.50;--weight-normal:400;--weight-medium:500;--weight-semibold:600;--weight-bold:700;
  --space-xs:0.25rem;--space-sm:0.5rem;--space-md:1rem;--space-lg:1.5rem;--space-xl:2rem;--space-2xl:2.5rem;
  --space-3xl:3rem;--space-4xl:4rem;--space-5xl:5rem;--radius-button:8px;--radius-card:8px;--radius-pill:9999px;
  --transition-fast:0.2s ease;--font-sans:Geist,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  --font-serif:Newsreader,Georgia,'Times New Roman',Times,serif;
}
.cg-rd,.cg-rd *{box-sizing:border-box;}
.cg-rd .eyebrow{font-family:var(--font-sans);font-size:var(--text-label);font-weight:var(--weight-medium);line-height:var(--leading-ui);color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.14em;}
.cg-rd .heading-small{font-family:var(--font-serif);font-size:var(--text-h3);font-weight:var(--weight-normal);line-height:var(--leading-comfortable);color:var(--text-primary);letter-spacing:-0.01em;margin:0;}
.cg-rd .body-regular{font-family:var(--font-sans);font-size:var(--text-body);font-weight:var(--weight-normal);line-height:var(--leading-relaxed);color:var(--text-secondary);}
.cg-rd .body-small{font-family:var(--font-sans);font-size:var(--text-body-sm);font-weight:var(--weight-normal);line-height:var(--leading-relaxed);color:var(--text-secondary);}
.cg-rd .u_text-primary{color:var(--text-primary)!important;}
.cg-rd .u_text-secondary{color:var(--text-secondary)!important;}
.cg-rd .u_text-tertiary{color:var(--text-tertiary)!important;}
.cg-rd .u_text-muted{color:var(--text-muted)!important;}
.cg-rd .u_medium{font-weight:var(--weight-medium)!important;}
.cg-rd .u_semibold{font-weight:var(--weight-semibold)!important;}

/* ===== Comparison table ===== */
.cg-rd .cd-section{margin-bottom:var(--space-5xl);}
.cg-rd .cd-section__heading{margin-bottom:var(--space-xl);}
.cg-rd .cd-table-wrap{border:1px solid var(--border-light);border-radius:var(--radius-card);overflow:hidden;background:transparent;}
.cg-rd .cd-table{width:100%;border-collapse:collapse;table-layout:auto;}
.cg-rd .cd-th{padding:var(--space-md) var(--space-xl);background:transparent;text-align:left;border-bottom:1px solid var(--border-light);}
.cg-rd .cd-th-harness{text-align:center;background:rgba(0,171,228,0.10);color:var(--text-primary);border-bottom:1px solid var(--border-light);border-left:1px solid var(--border-light);width:30%;}
.cg-rd .cd-th-competitor{text-align:center;border-left:1px solid var(--border-light);width:30%;}
.cg-rd .cd-section-row td{padding:var(--space-md) var(--space-xl);background:var(--bg-surface);border-bottom:1px solid var(--border-light);border-top:1px solid var(--border-light);}
.cg-rd .cmp-cell-feat{padding:var(--space-md) var(--space-xl);border-bottom:1px solid var(--border-light);background:transparent;}
.cg-rd .cmp-cell-harness{padding:var(--space-md) var(--space-xl);text-align:center;border-bottom:1px solid var(--border-light);border-left:1px solid var(--border-light);background:rgba(0,171,228,0.06);}
.cg-rd .cmp-cell-competitor{padding:var(--space-md) var(--space-xl);text-align:center;border-bottom:1px solid var(--border-light);border-left:1px solid var(--border-light);background:transparent;}
.cg-rd .cmp-cell-stack{display:flex;flex-direction:column;align-items:center;gap:var(--space-xs);}
.cg-rd .cmp-icon{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:var(--radius-button);}
.cg-rd .cmp-detail{font-family:var(--font-sans);font-size:var(--text-label);line-height:var(--leading-ui);color:var(--text-tertiary);display:block;}
.cg-rd .cd-row-last .cmp-cell-feat,.cg-rd .cd-row-last .cmp-cell-harness,.cg-rd .cd-row-last .cmp-cell-competitor{border-bottom:none;}
.cg-rd .cd-legend{display:flex;gap:var(--space-xl);margin-top:var(--space-md);}
.cg-rd .cd-legend__item{display:flex;align-items:center;gap:var(--space-xs);}
@media (max-width:768px){
.cg-rd .cd-table-wrap{overflow-x:auto;}
.cg-rd .cd-legend{flex-direction:column;gap:var(--space-sm);}
}

/* ===== Key differentiators ===== */
.cg-rd .diff-table{width:100%;border:1px solid var(--border-light);border-radius:var(--radius-card);overflow:hidden;}
.cg-rd .diff-header-row{display:grid;grid-template-columns:1fr 1fr;}
.cg-rd .diff-header-cell{padding:var(--space-md) var(--space-xl);text-align:left;}
.cg-rd .diff-header-harness{color:var(--text-primary);background:rgba(0,171,228,0.10);border-right:1px solid var(--border-light);border-bottom:1px solid var(--border-light);}
.cg-rd .diff-header-competitor{color:var(--text-muted);background:transparent;border-bottom:1px solid var(--border-light);}
.cg-rd .diff-item{border-bottom:1px solid var(--border-light);}
.cg-rd .diff-item:last-child{border-bottom:none;}
.cg-rd .diff-item__title{padding:var(--space-md) var(--space-xl);background:var(--bg-surface);border-bottom:1px solid var(--border-light);}
.cg-rd .diff-item__title p{margin:0;}
.cg-rd .diff-row{display:grid;grid-template-columns:1fr 1fr;}
.cg-rd .diff-cell{padding:var(--space-md) var(--space-xl);}
.cg-rd .diff-cell-harness{background:transparent;border-right:1px solid var(--border-light);}
.cg-rd .diff-cell-competitor{background:transparent;}
.cg-rd .diff-cell p{margin:0;}
.cg-rd .diff-cell__mobile-label{display:none;}
@media (max-width:768px){
.cg-rd .diff-header-row{display:none;}
.cg-rd .diff-item__title{padding:var(--space-md) var(--space-lg);}
.cg-rd .diff-row{grid-template-columns:1fr;}
.cg-rd .diff-cell-harness{border-right:none;border-bottom:1px solid var(--border-light);}
.cg-rd .diff-cell{padding:var(--space-md) var(--space-lg);}
.cg-rd .diff-cell__mobile-label{display:block;margin-bottom:var(--space-sm);}
}

/* ===== Tool fits (which tool is best for…) ===== */
.cg-rd .choose-card{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--border-light);border-radius:var(--radius-card);overflow:hidden;}
.cg-rd .choose-col{padding:var(--space-2xl);}
.cg-rd .choose-col-competitor{background:var(--bg-surface);border-right:1px solid var(--border-light);}
.cg-rd .choose-col-harness{background:var(--bg-canvas);display:flex;flex-direction:column;}
.cg-rd .choose-col__header{margin:0 0 var(--space-xl);}
.cg-rd .choose-header__suffix{font-weight:400;color:var(--text-primary);}
.cg-rd .choose-header__brand{color:var(--brand-color);}
.cg-rd .choose-list{list-style:none;padding:0;margin:0;flex:1;}
.cg-rd .choose-item{display:flex;gap:var(--space-sm);align-items:flex-start;padding:var(--space-md) 0;}
.cg-rd .choose-bullet{width:5px;height:5px;border-radius:50%;background:var(--text-muted);flex-shrink:0;margin-top:7px;}
.cg-rd .choose-cta{display:block;margin-top:var(--space-xl);padding:var(--space-md) var(--space-lg);background:var(--near-black);color:var(--bg-white);border-radius:var(--radius-button);text-align:center;font-family:var(--font-sans);font-size:14px;font-weight:500;text-decoration:none;transition:opacity var(--transition-fast);}
.cg-rd .choose-cta:hover{opacity:0.85;}
@media (max-width:768px){
.cg-rd .choose-card{grid-template-columns:1fr;border-radius:var(--radius-card);}
.cg-rd .choose-col-competitor{border-right:none;border-bottom:1px solid var(--border-light);}
.cg-rd .choose-col{padding:24px 16px 16px!important;}
.cg-rd .choose-col__header{margin:0 0 32px!important;}
.cg-rd .choose-item{padding:12px 0!important;}
}

/* ===== Scorecard (MetricsStrip) — standalone, no .cg-rd tokens ===== */
.cg-scorecard,.cg-scorecard *{box-sizing:border-box;}
.cg-scorecard{font-family:Geist,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#202020;display:grid;grid-template-columns:repeat(2,1fr);gap:2rem 2.5rem;width:100%;}
.cg-scorecard .cg-scorecard_item{display:flex;flex-direction:column;gap:0.5rem;border-left:1px solid #e2e8f0;padding-left:2rem;}
.cg-scorecard .cg-scorecard_item:nth-child(2n+1){border-left:none;padding-left:0;}
.cg-scorecard .cg-scorecard_value{font-size:18px;font-weight:500;color:#202020;line-height:1.2;}
.cg-scorecard .cg-scorecard_label{font-size:14px;font-weight:400;color:#5a5a62;line-height:1.5;}
@media (max-width:768px){
.cg-scorecard{gap:1.5rem;}
