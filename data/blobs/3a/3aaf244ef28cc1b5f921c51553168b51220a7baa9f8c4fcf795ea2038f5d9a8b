.zero-day .zero-day_learn-grid{grid-template-columns:repeat(3,1fr);display:grid;border:1px solid var(--border-light);border-radius:8px;overflow:hidden;}
.zero-day .zero-day_learn-card{padding:2rem;border-top:1px solid var(--border-light);border-left:1px solid var(--border-light);flex-direction:column;gap:0.5rem;display:flex;}
.zero-day .zero-day_learn-card--first{border-left-style:none;}
.zero-day .zero-day_learn-icon{width:36px;height:36px;margin-bottom:0.25rem;background-color:#0677d414;border:1px solid #0677d42e;border-radius:6px;flex-shrink:0;justify-content:center;align-items:center;display:flex;}
.zero-day .zero-day_learn-card>div:not(.zero-day_learn-icon){font-family:inherit;font-size:1rem;font-weight:600;line-height:1.4;color:#202020;margin:0.25rem 0 0.25rem;}
.zero-day .zero-day_learn-card .body-small{font-family:inherit;font-size:0.875rem;font-weight:400;line-height:1.5;color:#5a5a62;margin:0;}
@media (max-width:991px){
.zero-day .zero-day_learn-grid{grid-template-columns:repeat(2,1fr);}
.zero-day .zero-day_learn-card{border-left:1px solid var(--border-light);}
.zero-day .zero-day_learn-card:nth-child(2n+1){border-left-style:none;}
}
@media (max-width:640px){
.zero-day .zero-day_learn-grid{grid-template-columns:1fr;}
.zero-day .zero-day_learn-card{border-left-style:none!important;}
}

/* ===== Key takeaways (ALREADY externalized — include only if not already in a template) ===== */
.cg-takeaways-wrap,.cg-takeaways-wrap *{box-sizing:border-box;}
.cg-takeaways-wrap{font-family:Geist,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#202020;}
.cg-takeaways-wrap .cg-takeaways_header{text-align:center;margin:0 auto 2.5rem;max-width:720px;}
.cg-takeaways-wrap .cg-takeaways_eyebrow{font-size:0.75rem;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#5a5a62;margin:0 0 0.75rem;}
.cg-takeaways-wrap .cg-takeaways_heading{font-family:Newsreader,Georgia,'Times New Roman',serif;font-size:2.75rem;font-weight:400;line-height:1.1;color:#14120b;margin:0;}
@media (max-width:640px){.cg-takeaways-wrap .cg-takeaways_heading{font-size:2rem;}}
.cg-takeaways{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;width:100%;}
.cg-takeaways .cg-takeaways_card{display:flex;flex-direction:column;align-items:center;text-align:center;gap:0.5rem;padding:2rem;background:#ffffff;border:1px solid #e9e9ec;border-radius:16px;}
.cg-takeaways .cg-takeaways_icon{width:44px;height:44px;margin:0 auto 0.75rem;background:#f4f4f6;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.cg-takeaways .cg-takeaways_icon svg{width:20px;height:20px;}
.cg-takeaways .cg-takeaways_title{font-size:1.125rem;font-weight:600;line-height:1.35;color:#14120b;margin:0;text-align:center;}
.cg-takeaways .cg-takeaways_body{font-size:0.9375rem;font-weight:400;line-height:1.55;color:#5a5a62;margin:0;text-align:center;}
@media (max-width:991px){.cg-takeaways{grid-template-columns:repeat(2,1fr);}}
@media (max-width:640px){.cg-takeaways{grid-template-columns:1fr;}}
