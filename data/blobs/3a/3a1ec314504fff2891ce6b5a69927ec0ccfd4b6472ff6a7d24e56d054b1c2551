    function createRasgadoMapping() {
        return googletag.sizeMapping()
            .addSize([1280, 0], [[1190, 250], [728, 90], [970, 90], [970, 250], [980, 250]])
            .addSize([992, 0], [[728, 90], [970, 90], [970, 250], [980, 250]])
