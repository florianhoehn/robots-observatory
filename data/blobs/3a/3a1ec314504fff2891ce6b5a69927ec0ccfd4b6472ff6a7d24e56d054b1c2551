    // ============================================================================
    // FUNÇÃO UNIFICADA PARA OBTER DIREtóRIO DFP
    // ============================================================================
    var path = location.pathname.split('/').filter(function(i) { return i !== ''; });
    var diretoriodfp = '';
    var _diretorioCache = null;

    function getDiretorioDFPFromPath(pathArray) {
        var pathCopy = pathArray ? pathArray.slice() : path.slice();
        
        if (pathCopy.length < 1) {
            return '/' + AdConfig.publisherId + '/radio_tupi-home';
        } else if (pathCopy.indexOf('category') >= 0 || pathCopy.length === 1) {
            return '/' + AdConfig.publisherId + '/radio_tupi-capa/' + pathCopy.pop();
        } else if (pathCopy.indexOf('colunistas') >= 0) {
            return '/' + AdConfig.publisherId + '/radio_tupi-colunistas/' + pathCopy[1];
        } else {
            // Para páginas internas, verifica se há parceiro
            var autorElement = document.querySelector('span[itemprop="name"]');
            var autorNome = null;
            
            if (autorElement && autorElement.children && autorElement.children.length > 0) {
                autorNome = autorElement.children[0].innerHTML;
            }

            var parceiroEncontrado = null;
            if (autorNome) {
                parceiroEncontrado = AdConfig.parceiros.find(function(item) {
                    return item.nome === autorNome;
                });
            }

            var pathFinal = parceiroEncontrado ? parceiroEncontrado.adunit : pathCopy[0];
            return '/' + AdConfig.publisherId + '/radio_tupi-interna/' + pathFinal;
        }
    }

    function getDiretorioDFP() {
        // Se já foi calculado e não é página interna, retorna o valor em cache
        if (_diretorioCache && !_diretorioCache.includes('radio_tupi-interna')) {
            return _diretorioCache;
        }

        _diretorioCache = getDiretorioDFPFromPath(path);
        return _diretorioCache;
    }

    // Inicializa o diretoriodfp imediatamente
    diretoriodfp = getDiretorioDFP();

    // Função para inicialização quando DOM estiver pronto
    function initializeDiretorioDFP() {
        if (diretoriodfp.includes('radio_tupi-interna')) {
            _diretorioCache = null; // Limpa cache para recalcular
            diretoriodfp = getDiretorioDFP();
        }
    }

    // Atualiza quando o DOM estiver pronto (otimizado - uma única verificação)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeDiretorioDFP);
    } else {
        initializeDiretorioDFP();
    }

    if (_adsDebugActive) {
        console.log('*** diretoriodfp inicial:', diretoriodfp);
    }

    // ============================================================================
    // SETUP GAM DAID
    // ============================================================================
    function setup_GAM_DAID() {
        const recommendations = JSON.parse(localStorage.getItem("DAREC")) || {
            pps_v1: [],
        };

        const {
            created_at,
            ...filteredRecommendations
        } = recommendations;

        if (filteredRecommendations) {
            //setup de custom key values
            for (let key in filteredRecommendations) {
                // Pula pps_v1 pois será tratado separadamente
                if (key === 'pps_v1') {
                    continue;
                }
                googletag
                    .pubads()
                    .setTargeting("DAID_" + key, filteredRecommendations[key]);
            }

            //setup de pps - apenas se houver valores válidos
            // O Google requer que o array de values não esteja vazio
            if (filteredRecommendations.pps_v1 && 
                Array.isArray(filteredRecommendations.pps_v1) && 
                filteredRecommendations.pps_v1.length > 0) {
                googletag.setConfig({
                    pps: {
                        taxonomies: {
                            IAB_AUDIENCE_1_1: {
                                values: filteredRecommendations.pps_v1
                            },
                        },
                    },
                });
            }
        }

        //setup de ppid
        const daid = localStorage.getItem("DAID") || "";
        if (daid) {
            googletag.pubads().setPublisherProvidedId(daid);
        }
    }

    // ============================================================================
    // FUNÇÃO HELPER PARA CRIAÇÃO DE SLOTS
    // ============================================================================
    function createSlot(config) {
        var slot = googletag.defineSlot(
            config.diretoriodfp,
            config.sizes,
            config.slotId
        );
        
        // Aplica targeting
        Object.keys(config.targeting).forEach(function(key) {
            slot.setTargeting(key, config.targeting[key]);
        });
        
        slot.addService(googletag.pubads());
        
        // Aplica size mapping se fornecido
        if (config.sizeMapping) {
            slot.defineSizeMapping(config.sizeMapping);
        }
        
        return slot;
    }

    function createOutOfPageSlot(config) {
        var slot = googletag.defineOutOfPageSlot(
            config.diretoriodfp,
            config.slotId
        );
        
        Object.keys(config.targeting).forEach(function(key) {
            slot.setTargeting(key, config.targeting[key]);
        });
        
        slot.addService(googletag.pubads());
        return slot;
    }

    // ============================================================================
    // INICIALIZAÇÃO GPT
    // ============================================================================
    window.googletag = window.googletag || {
        cmd: []
    };

    var slotdfp = {};
    var slotdfpbtf = {};
    var slotdfpoutp = {};
    var viewable = [];
    var slotRefreshCounters = {};
    var refreshTimer = null;
    // Verifica se é página single para aplicar regras específicas de mobile
    var isSinglePage = false;
    // Rastreamento de visualizações e cooldown por slot
    var slotsViewed = {}; // Slots que já foram visualizados (impressionViewable)
    var slotLastRefresh = {}; // Timestamp do último refresh por slot
    var slotsLoadedCount = 0; // Contador de slots carregados para melhorar inicialização do timer

    window.googletag.cmd.push(function() {
        // Garante que diretoriodfp está atualizado antes de usar nos slots
        diretoriodfp = getDiretorioDFP();

        googletag.pubads().disableInitialLoad();

        googletag.pubads().setTargeting("urldata", window.location.href.split(/\/|=|,|-|\.|\&/));
        googletag.pubads().setTargeting("tagsofpage", document.querySelector('meta[name="keywords"]') ? document.querySelector('meta[name="keywords"]').content.replace(/\s?(,)\s?/g, '$1').split(',') : []);

        // Configurações ANTES de definir slots (ordem recomendada pelo Google Ad Manager)
        googletag.pubads().enableSingleRequest();
        googletag.pubads().setCentering(true);

        // Configuração de Lazy Load padrão do Google Ad Manager
        googletag.pubads().enableLazyLoad({
            fetchMarginPercent: 200,
            renderMarginPercent: 100,
            mobileScaling: 2.0
        });

        // Cria size mappings uma única vez
        var mappingRasgadoHeader = createRasgadoHeaderMapping();
        var mappingRasgado = createRasgadoMapping();
        var mappingAnchor = createAnchorMapping();

        // Interstitial - Out-of-page format
        var interstitialSlot = googletag.defineOutOfPageSlot(
            '/' + AdConfig.publisherId + '/radio_tupi/interstitial',
            googletag.enums.OutOfPageFormat.INTERSTITIAL
        );

        if (interstitialSlot) {
            interstitialSlot.setTargeting('formato', 'interstitial')
                .setTargeting('radio', 'desligado')
                .addService(googletag.pubads());
            
            // Configura triggers para melhor UX
            interstitialSlot.setConfig({
                interstitial: {
                    triggers: {
                        navBar: true,
                        unhideWindow: true
                    }
                }
            });
            
            slotdfpoutp['publicidade-interstitial'] = interstitialSlot;
            adsLog('[Interstitial] Slot definido com sucesso');
        } else {
            adsWarn('[Interstitial] Slot não pôde ser criado (possivelmente em iframe ou contexto não suportado)');
        }

        // Header slot
        slotdfp['tupifm-publicidade-rasgado-1-header'] = createSlot({
            diretoriodfp: diretoriodfp,
            sizes: [728, 90],
            slotId: 'tupifm-publicidade-rasgado-1-header',
            targeting: {
                'formato': 'rasgado',
                'refresh_count': '0',
                'pos': 'header',
                'radio': 'desligado'
            },
            sizeMapping: mappingRasgadoHeader
        });

        
        slotdfp['tupifm-publicidade-ancorads'] = createSlot({
            diretoriodfp: diretoriodfp,
            sizes: [728, 90],
            slotId: 'tupifm-publicidade-ancorads',
            targeting: {
                'formato': 'anchorado-footer',
                'refresh_count': '0',
                'radio': 'desligado'
            },
            sizeMapping: mappingAnchor
        });

        // Out-of-page slots
        slotdfpoutp['publicidade-dhtml-1x1'] = createOutOfPageSlot({
            diretoriodfp: diretoriodfp,
            slotId: 'publicidade-dhtml-1x1',
            targeting: {
                'formato': 'dhtml',
                'radio': 'desligado'
            }
        });

        
            
            // Define slot que será carregado baseado no tamanho da tela
            // Em páginas single no mobile (< 900px), não cria slots de sidebar devido ao feed infinito Taboola
            // Em outras páginas (categorias, etc), cria normalmente
            if (window.innerWidth > 900 || !isSinglePage) {
                var retangulo1Slot = createSlot({
                    diretoriodfp: diretoriodfp,
                    sizes: [[300, 250], [366, 280]],
                    slotId: 'tupifm-publicidade-retangulo-1',
                    targeting: {
                        'formato': 'retangulo',
                        'refresh_count': '0',
                        'pos': '1',
                        'radio': 'desligado'
                    }
                });
                slotdfpbtf['tupifm-publicidade-retangulo-1'] = retangulo1Slot;
            }
        
        // Halfpage só é ocultado no mobile (< 900px) em páginas single devido ao feed infinito Taboola
        if (window.innerWidth > 900 || !isSinglePage) {
            slotdfpbtf['tupifm-publicidade-halfpage-1'] = createSlot({
                diretoriodfp: diretoriodfp,
                sizes: [[300, 600], [300, 450], [300, 250], [120, 600], [160, 600]],
                slotId: 'tupifm-publicidade-halfpage-1',
                targeting: {
                    'formato': 'halfpage',
                    'refresh_count': '0',
                    'pos': '1',
                    'radio': 'desligado'
                }
            });
        }

        // Setup de DAID ANTES de enableServices
        setup_GAM_DAID();

        googletag.enableServices();

        // Exibe todos os slots definidos antes de fazer refresh
        function displayAllSlots() {
            // Exibe slots ATF
            Object.keys(slotdfp).forEach(function(slotId) {
                var slot = slotdfp[slotId];
                if (slot && slot.getSlotElementId) {
                    var element = document.getElementById(slotId);
                    if (element) {
                        googletag.display(slotId);
                        adsLog('[Display] Slot ATF exibido:', slotId);
                    } else {
                        adsWarn('[GPT] Elemento não encontrado para slot:', slotId);
                    }
                }
            });
            
            // Exibe slots out-of-page
            Object.keys(slotdfpoutp).forEach(function(slotId) {
                var slot = slotdfpoutp[slotId];
                if (slot) {
                    // Para interstitials, passa o OBJETO do slot, não o ID
                    // Interstitials não precisam de div HTML - Google cria automaticamente
                    if (slotId === 'publicidade-interstitial') {
                        googletag.display(slot);
                        adsLog('[Display] Slot interstitial exibido:', slotId);
                    } else {
                        // Para outros slots out-of-page (ex: DHTML), verifica elemento
                        var element = document.getElementById(slotId);
                        if (element) {
                            googletag.display(slotId);
                            adsLog('[Display] Slot out-of-page exibido:', slotId);
                        } else {
                            adsWarn('[GPT] Elemento não encontrado para slot out-of-page:', slotId);
                        }
                    }
                }
            });
        }

        // Aguarda DOM estar pronto com retry para elementos que podem estar no footer
        function initDisplaySlots() {
            var maxRetries = 5;
            var retryDelay = 100;
            var retryCount = 0;
            
            function tryDisplaySlots() {
                // Verifica se elementos críticos do footer existem (ex: ancorads)
                var criticalElements = ['tupifm-publicidade-ancorads'];
                var allElementsReady = true;
                
                // Verifica apenas slots que realmente precisam de elementos HTML
                Object.keys(slotdfp).forEach(function(slotId) {
                    if (criticalElements.indexOf(slotId) === -1) {
                        var element = document.getElementById(slotId);
                        if (!element) {
                            allElementsReady = false;
                        }
                    }
                });
                
                // Para slots críticos do footer, verifica se existem
                criticalElements.forEach(function(slotId) {
                    if (slotdfp[slotId] || slotdfpbtf[slotId]) {
                        var element = document.getElementById(slotId);
                        if (!element) {
                            allElementsReady = false;
                        }
                    }
                });
                
                if (allElementsReady || retryCount >= maxRetries) {
                    displayAllSlots();
                    if (retryCount > 0) {
                        adsLog('[Display] Slots exibidos após', retryCount, 'tentativas');
                    }
                } else {
                    retryCount++;
                    retryDelay = Math.min(retryDelay * 1.5, 1000); // Backoff exponencial, max 1s
                    adsLog('[Display] Aguardando elementos (tentativa', retryCount, '/', maxRetries, ')...');
                    setTimeout(tryDisplaySlots, retryDelay);
                }
            }
            
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', function() {
                    setTimeout(tryDisplaySlots, 50);
                });
            } else {
                setTimeout(tryDisplaySlots, 50);
            }
        }
        initDisplaySlots();

        // Refresh inicial dos slots acima da dobra (ATF - Above The Fold)
        var slotsATF = Object.values(slotdfp).filter(function(slot) {
            return slot !== null && slot !== undefined;
        });
        var slotsOutOfPage = Object.values(slotdfpoutp).filter(function(slot) {
            return slot !== null && slot !== undefined;
        });
        
        // Marca que slots foram definidos para o APS
        window._slotsDefined = true;
        window._slotsATF = slotsATF;
        window._slotsOutOfPage = slotsOutOfPage;

        // Função auxiliar para verificar se elemento está no viewport
        function isElementInViewportTest(element, offset) {
            offset = offset || 0;
            var elementNode = document.getElementById(element);
            if (!elementNode) {
                return false;
            }
            const rect = elementNode.getBoundingClientRect();
            return (
                rect.top < (window.innerHeight || document.documentElement.clientHeight) - offset &&
                rect.bottom > 0 + offset
            );
        }

        // Função para refresh com Prebid (Amazon APS)
        function refreshPrebidorGPT(slot) {
            if (!slot || !slot.getSlotElementId) {
                adsWarn('[Refresh] Slot inválido para refresh');
                return;
            }
            
            var slotId = slot.getSlotElementId();
            
            // Constrói o formato esperado pelo APS
            if (typeof apstag !== 'undefined' && apstag.fetchBids) {
                var slotName = null;
                if (slot.getAdUnitPath && typeof slot.getAdUnitPath === 'function') {
                    try {
                        slotName = slot.getAdUnitPath();
                    } catch (e) {
                        adsWarn('[Refresh] Erro ao obter getAdUnitPath:', slotId, e);
                    }
                }
                
                if (!slotName) {
                    slotName = typeof diretoriodfp !== 'undefined' ? diretoriodfp : '/' + AdConfig.publisherId + '/radio_tupi-home';
                }
                
                var apsSlot = {
                    slotID: slotId,
                    slotName: slotName,
                    sizes: []
                };
                
                // Obtém os sizes do slot com validação
                if (slot.getSizes && typeof slot.getSizes === 'function') {
                    try {
                        var rawSizes = slot.getSizes();
                        for (var i = 0; i < rawSizes.length; i++) {
                            var s = rawSizes[i];
                            if (s.getWidth && s.getHeight) {
                                var width = s.getWidth();
                                var height = s.getHeight();
                                // Validação: tamanhos devem ser números válidos e positivos
                                if (typeof width === 'number' && typeof height === 'number' && width > 0 && height > 0) {
                                    apsSlot.sizes.push([width, height]);
                                }
                            } else if (Array.isArray(s) && s.length === 2) {
                                var width = s[0];
                                var height = s[1];
                                if (typeof width === 'number' && typeof height === 'number' && width > 0 && height > 0) {
                                    apsSlot.sizes.push([width, height]);
                                }
                            }
                        }
                    } catch (e) {
                        adsWarn('[Refresh] Erro ao obter sizes do slot:', slotId, e);
                    }
                }
                
                // Validação: slot deve ter pelo menos um tamanho válido
                if (apsSlot.sizes.length === 0) {
                    adsWarn('[Refresh] Slot sem tamanhos válidos, usando refresh direto do GAM:', slotId);
                    googletag.pubads().refresh([slot]);
                    return;
                }
                
                adsLog('[Refresh] Solicitando bids para refresh do slot:', slotId, 'sizes:', apsSlot.sizes);
                
                try {
                    apstag.fetchBids({
                        slots: [apsSlot]
                    }, function(bids) {
                        adsLog('[APS] Bids recebidos para refresh do slot:', slotId);
