    // ============================================================================
    // FUNÇÕES FACTORY PARA SIZE MAPPINGS
    // ============================================================================
    function createRasgadoHeaderMapping() {
        return googletag.sizeMapping()
            .addSize([992, 0], [[728, 90], [970, 90]])
            .addSize([748, 0], [[728, 90], [468, 60]])
