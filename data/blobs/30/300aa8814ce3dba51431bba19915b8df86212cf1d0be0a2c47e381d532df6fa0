  <style>
    @font-face {
      font-family: 'Theinhardt';
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }
    @font-face {
      font-family: 'Theinhardt';
      font-style: normal;
      font-weight: 700;
      font-display: swap;
      src: url(data:font/woff2;base64,) format('woff2');
    }
    :root {
      --yellow: #FFD008;
      --ink: #333333;
      --side: clamp(20px, 13.33vw, 192px);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; }
    body {
      background: #fff;
      color: var(--ink);
      font-family: 'Theinhardt', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 18px;
      line-height: 1.4;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }
    .nav {
      background: var(--yellow);
      height: 90px;
    }
    .nav-inner {
      display: flex;
      align-items: center;
      gap: 30px;
      height: 90px;
      padding: 0 var(--side);
    }
    .logo-svg { height: 40px; width: auto; display: block; }
    .nav-title {
      font-size: 26px;
      font-weight: 500;
      line-height: 1;
      color: var(--ink);
    }
    main {
      padding: 75px var(--side) 80px;
    }
    .hw {
      font-size: 50px;
      font-weight: 400;
      line-height: 1.12;
      margin: 0 0 46px;
      color: var(--ink);
    }
    .hw b { font-weight: 700; }
    .entry {
      margin: 0 0 56px;
      max-width: 696px;
    }
    .row { display: flex; margin-bottom: 15px; }
    .row:last-child { margin-bottom: 0; }
    .k { flex: 0 0 124px; font-weight: 400; }
    .v { font-weight: 700; }
    /* Duden vowel-length mark: short underline beneath the long vowel. */
    .len {
      border-bottom: 1.5px solid var(--ink);
      padding-bottom: 1px;
    }
    /* Duden short-vowel mark: dot beneath the stressed short vowel. */
    .dot { position: relative; }
    .dot::after {
      content: "";
      position: absolute;
      left: 50%;
      bottom: -3px;
      width: 3px;
      height: 3px;
      transform: translateX(-50%);
      border-radius: 50%;
      background: currentColor;
    }
    .desc {
      max-width: 696px;
      margin: 0 0 44px;
      line-height: 1.4;
    }
    .btn {
      display: inline-block;
      -webkit-appearance: none;
      appearance: none;
      border: 2px solid var(--ink);
      border-radius: 5px;
      padding: 15px 24px;
      font-family: inherit;
      font-size: 16px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 1px;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--ink);
      background: transparent;
      cursor: pointer;
      transition: background-color .15s ease, color .15s ease;
    }
    .btn:hover { background: var(--ink); color: #fff; }
    .btn:focus-visible { outline: 3px solid var(--yellow); outline-offset: 2px; }
    @media (max-width: 600px) {
      .nav-title { font-size: 20px; }
      main { padding-top: 48px; }
      .hw { font-size: 34px; margin-bottom: 32px; }
      .k { flex-basis: 112px; }
    }
  </style>
