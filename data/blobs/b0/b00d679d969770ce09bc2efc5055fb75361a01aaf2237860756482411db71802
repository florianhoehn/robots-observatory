<script>
window.addEventListener('DOMContentLoaded', () => {
    const userLanguage = navigator.language || navigator.userLanguage || 'en';
    const language = userLanguage.toLowerCase().split('-')[0];

    const ruDiv = document.getElementById('ru');
    const enDiv = document.getElementById('en');
    const currentYearSpans = document.getElementsByClassName("currentYear");

    if (language === 'ru') {
        if (ruDiv) ruDiv.style.display = 'block';
        if (enDiv) enDiv.style.display = 'none';
    } else {
        if (ruDiv) ruDiv.style.display = 'none';
        if (enDiv) enDiv.style.display = 'block';
    }

    Array.from(currentYearSpans).forEach(
        (year) => { year.textContent = new Date().getFullYear(); }
    );
});
</script>

