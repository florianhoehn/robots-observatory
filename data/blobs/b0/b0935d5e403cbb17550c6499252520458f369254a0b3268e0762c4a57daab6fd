<script type="text/javascript">
(function()
{
	var stockData = {};
	var tooltipDiv, premiumTip;
	var premiumTipLeft = 0;
	var premiumTipTop = 0;

	var displayStockTooltip = function(node, ticker) {
		if ( stockData[ticker] ) {
			tooltipDiv.html(stockData[ticker]);
		} else {
			tooltipDiv.html('Loading...');
			$jq.ajax('stock_tooltip.php?q=' + ticker, {
				dataType: 'html',
				success: function(data) {
					tooltipDiv.html(data);
					stockData[ticker] = data;
				}
			});
		}
		tooltipDiv.show();
		tooltipDiv.offset({top: node.offset().top, left: node.offset().left + node.width()});
	};

	var hideStockTooltip = function() {
		tooltipDiv.hide();
	};
	
	var displayPremiumTip = function(node) {
		var ptl = node.data('tipLeft');
		if ( typeof ptl != 'undefined' ) {
			ptl = parseInt(ptl);
		} else {
			ptl = premiumTipLeft;
		}

		premiumTip.show();
		premiumTip.offset({
			top: node.offset().top + node.height() + premiumTipTop,
			left: node.offset().left + ptl
		});
	}

	var hidePremiumTip = function() {
		premiumTip.hide();
	};

	window.setPremiumTip = function(t) {
		premiumTip.html(t);
	};

	window.setPremiumOffset = function(t, l) {
		premiumTipTop  = t;
		premiumTipLeft = l;
	};
	
	$jq(document).ready(function() {

		tooltipDiv = $jq('<div></div>');
		tooltipDiv.css({
			display: 'none', zIndex: 100, position: 'absolute', backgroundColor: '#fff',
			padding: '3px',  border: '1px solid black', textAlign: 'left'
		});
		$jq('body').append(tooltipDiv);

		premiumTip = $jq('<div></div>');
		premiumTip.css({
			display: 'none', zIndex: 100, position: 'absolute', backgroundColor: '#fff',
			padding: '3px',  border: '1px solid black', textAlign: 'left'
		});
		premiumTip.html('Upgrade to SI Premium to View');
		$jq('body').append(premiumTip);
		
		// look for all the anchor tags that link to stock_lookup.php?q=X with innerHTML = X as well
		$jq('body').delegate('a', 'mouseenter', function(event) {
			var node = $jq(this);
			var m = node.attr('href') && node.attr('href').match(/stock_lookup\.php\?q=([A-Za-z0-9.-]+)/);
			if ( m && m[1] && node.html() == m[1] && !node.hasClass('stock') ) {
				displayStockTooltip(node, m[1]);
			}
		});

		$jq('body').delegate('a', 'mouseleave', function(event) {
			var node = $jq(this);
			var m = node.attr('href') && node.attr('href').match(/stock_lookup\.php\?q=([A-Za-z0-9.-]+)/);
			if ( m && m[1] && node.html() == m[1] && !node.hasClass('stock') ) {
				hideStockTooltip();
			}
		});

		$jq('body').delegate('.PremiumTip', 'mouseenter', function(event) {
			var node = $jq(this);
			displayPremiumTip(node);
		});
		$jq('body').delegate('.PremiumTip', 'mouseleave', function(event) {
			hidePremiumTip();
		});

	});

})();

</script>

