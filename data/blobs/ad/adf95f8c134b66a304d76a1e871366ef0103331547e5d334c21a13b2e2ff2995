  <script type="text/javascript">
    /*<![CDATA[*/
    jQuery(function () {
      var locHref = location.href.toString().replace(/\.\w\w\.faces/, '.faces');

      const controlPanelInvisible = {
        details: "search",
        modify: "search"
      };

      Object.keys(controlPanelInvisible).forEach ((s) => {
        locHref = locHref.replace (s, controlPanelInvisible[s]);
      });

      var params = locHref.indexOf('?');

      if (params > 0)
        locHref = locHref.substr(0, params);

      var locLen = locHref.length;
      if (locHref.match(/\/home\./))
      {
        //jQuery("div.menuLeft").addClass('active');
      }
      jQuery("#menuLeft").accordion(
        {
          autoHeight: false,
          collapsible: true,
          active: false,
          navigation: true,
          navigationFilter: function () {
            var isActive = false;
            var curHref = this.href;
            var hrefLen = curHref.length;
            if (hrefLen <= locLen)
            {
              var test = locHref.substr(0, hrefLen);
              isActive = (curHref === test);
            }
            return isActive;
          },
          header: 'dt'
        });
      var $activeLink = jQuery("#menuLeft dd li a[href=" + locHref + "]");
      var isLinkSpecial = false;
      if ($activeLink.length === 0) {
        $activeLink = jQuery("#menuLeft dd li a[href=" + location.href.toString() + "]");
        isLinkSpecial = true;
      }
      $activeLink.parents('li').addClass('active');
      jQuery('#menuLeft .superItem').hover(function () {
        jQuery('ul', this).toggle();
      });
      // expand manager menu for manager urls, which are not present in menu
      if (location.href.indexOf('https://manager.irondns.net') === 0 && isLinkSpecial)
      {
        jQuery("#menuLeft").accordion("activate", $activeLink.parents('dd').prev('dt'));
      }
    });
    /*]]>*/
  </script>

