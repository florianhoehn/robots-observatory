    <style>
      :root {
        /* @komoot/constants/colors primitives + legacy semantic tokens */
        --color-surface: #f5f3ec;
        --color-card: #ffffff;
        --color-text: #1c1a18;
        --color-text-muted: #4a4846;
        --color-link: #4f6814;
        --color-border-subtle: #edebe5;
        --shadow-card: 0 1px 2px rgba(0, 0, 0, 0.2);
        --radius-card: 8px;
        --font-body: system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        --font-heading: Nohemi, system-ui, sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      h1,
      p {
        margin-bottom: 12px;
      }

      p:last-child {
        margin-bottom: 0;
      }

      a {
        color: var(--color-link);
        font-weight: 500;
        text-decoration: underline;
        text-underline-offset: 2px;
      }

      a:hover,
      a:focus {
        text-decoration: none;
      }

      a:active {
        color: var(--color-link);
      }

      html {
        min-height: 100%;
        background: var(--color-surface);
        font-family: var(--font-body);
        font-size: 16px;
        font-weight: 500;
        line-height: 1.5;
        color: var(--color-text);
        padding: clamp(24px, 5vw, 48px) clamp(16px, 4vw, 32px);
      }

      body {
        max-width: 36rem;
        background: var(--color-card);
        box-shadow: var(--shadow-card);
        border-radius: var(--radius-card);
        margin: 0 auto;
        padding: clamp(20px, 4vw, 28px) clamp(20px, 4vw, 32px) 32px;
      }

      header {
        padding-bottom: 20px;
        margin-bottom: 24px;
        border-bottom: 1px solid var(--color-border-subtle);
      }

      header .header-logo-link {
        display: inline-block;
        line-height: 0;
        text-decoration: none;
        color: inherit;
      }

      header .header-logo-link:focus-visible {
        outline: 2px solid var(--color-link);
        outline-offset: 4px;
        border-radius: 4px;
      }

      header .header-logo {
        display: inline-flex;
        align-items: center;
        gap: 10px;
      }

      header .header-logo-mark {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        color: var(--color-link);
      }

      header .header-logo-mark path {
        fill: currentColor;
      }

      header .header-logo-type {
        width: 84px;
        height: 16px;
        flex-shrink: 0;
        color: var(--color-text);
      }

      header .header-logo-type path {
        fill: currentColor;
      }

      h1 {
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 2.5vw, 1.5rem);
        font-weight: 700;
        line-height: 1.25;
        color: var(--color-text);
        margin-top: 0;
        letter-spacing: -0.01em;
      }

      article {
        margin-top: 28px;
        padding-top: 28px;
        border-top: 1px solid var(--color-border-subtle);
      }

      article:first-of-type {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
      }

      article p {
        color: var(--color-text-muted);
        font-weight: 400;
      }

      pre {
        color: var(--color-text);
        font-size: 11px;
        font-family: Menlo, ui-monospace, monospace;
        overflow: auto;
        margin-top: 40px;
        padding: 12px;
        background: var(--color-border-subtle);
        border-radius: 4px;
      }
    </style>
  </head>

