<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Temporarily unavailable — Wikidot</title>
    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 40px 24px;
            background: #f5f5f3;
            color: #252525;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            line-height: 1.6;
        }

        .page {
            width: 100%;
            max-width: 1040px;
            margin: 0 auto;
        }

        .brand {
            display: inline-block;
            color: #252525;
            font-size: 28px;
            font-weight: 750;
            letter-spacing: -1.5px;
            text-decoration: none;
        }

        .brand span { color: #b52b36; }

        .error-card {
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
            margin-top: 64px;
            overflow: hidden;
            background: #fff;
            border: 1px solid #e2e2dd;
            border-radius: 24px;
            box-shadow: 0 12px 40px rgba(30, 30, 20, 0.04);
        }

        .message { padding: 56px 48px; }

        .status {
            display: inline-block;
            margin: 0 0 24px;
            padding: 5px 12px;
            border-radius: 6px;
            background: #faedef;
            color: #9e2530;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0 0 20px;
            font-size: 44px;
            font-weight: 700;
            letter-spacing: -1.5px;
            line-height: 1.15;
        }

        .description {
            max-width: 34ch;
            margin: 0;
            color: #60605b;
            font-size: 17px;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 16px 24px;
            margin-top: 32px;
        }

        .retry {
            min-height: 48px;
            padding: 12px 24px;
            border: 0;
            border-radius: 8px;
            background: #b52b36;
            color: #fff;
            font: inherit;
            font-weight: 600;
            cursor: pointer;
        }

        .retry:hover { background: #97232d; }

        .home {
            padding: 12px 0;
            color: #454540;
            font-size: 14px;
            font-weight: 600;
            text-underline-offset: 4px;
        }

        a:focus-visible, button:focus-visible {
            outline: 3px solid #b52b36;
            outline-offset: 5px;
        }

        .hint {
            margin: 28px 0 0;
            color: #73736b;
            font-size: 13px;
        }

        .illustration {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            border-left: 1px solid #eeeee9;
            background: #fafaf8;
        }

        .illustration img {
            display: block;
            width: 100%;
            max-width: 360px;
            height: auto;
            border-radius: 12px;
        }

        .error-code {
            margin: 20px 0 0;
            color: #73736b;
            font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
            font-size: 12px;
        }

        @media (max-width: 700px) {
            body { padding: 24px 16px; }
            .error-card { grid-template-columns: minmax(0, 1fr); margin-top: 32px; }
            .message { padding: 32px 24px; }
            h1 { font-size: 36px; }
            .illustration { padding: 24px; border-left: 0; border-top: 1px solid #eeeee9; }
            .illustration img { max-width: 300px; }
        }
    </style>
</head>
<body>
    <div class="page">
        <header>
            <a class="brand" href="/" aria-label="Wikidot — wiki home">wikidot<span aria-hidden="true">.</span></a>
        </header>
        <main class="error-card" aria-labelledby="error-title">
            <div class="message">
                <p class="status">503 · Service unavailable</p>
                <h1 id="error-title">Temporarily unavailable.</h1>
                <p class="description">This wiki is temporarily unavailable. Please try again in a moment.</p>
                <div class="actions">
                    <button class="retry" type="button" onclick="window.location.reload()">Try again</button>
                    <a class="home" href="/">Go to wiki home</a>
                </div>
                <noscript><p class="hint">Use your browser’s reload button to try again.</p></noscript>
                <p class="hint">If this keeps happening, give us a few minutes and try again.</p>
            </div>
            <div class="illustration">
                <img src="https://http.cat/503.jpg" width="750" height="600" alt="HTTP Cat: 503 Service Unavailable">
            </div>
        </main>
        <footer class="error-code">Error code: HA503</footer>
    </div>
</body>
</html>
