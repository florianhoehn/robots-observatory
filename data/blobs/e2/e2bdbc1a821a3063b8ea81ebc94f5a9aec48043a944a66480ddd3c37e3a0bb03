<script type="text/javascript">
(function(window) {
    var Application = window.Application;

    $(function() {
        var message = null;

        if (!_.isUndefined(message) && !_.isNull(message)) {
            Application.trigger('notifier-show-message', message);
            return false;
        }

        var urlParameters = URI.parseQuery(window.location.search);

        if (!_.isUndefined(urlParameters.notify)) {
            Application.trigger('notifier-show-message', {
                templateId: urlParameters.notify
            });

            if ('replaceState' in window.history) {
                var url = URI(window.location);
                url.removeSearch('notify');
                if (/firefox/i.test(navigator.userAgent)) {
                    // TODO: remove workaround when FF bug is fixed
                    // see https://bugzilla.mozilla.org/show_bug.cgi?id=1422334
                    window.location.hash = window.location.hash;
                }
                window.history.replaceState('', document.title, url.toString());
            }

            return false;
        }

        var options = Application.State.get('clientnotifier', 'options');

        if (_.isObject(options) && options.templateId) {
            Application.State.remove('clientnotifier', 'options');
            Application.trigger('notifier-show-message', options);
            return false;
        }
    });
})(window);
</script>
