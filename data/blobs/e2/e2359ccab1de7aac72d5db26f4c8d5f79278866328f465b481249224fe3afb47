    <script>
      const sign = document.getElementById('pnf-sign');
      sign.addEventListener('mousedown', e => {
        e.target.classList.add('tw-animate-pnf-swirl');
        e.target.classList.remove('tw-animate-pnf-wiggle-sign');
      });
      sign.addEventListener('mouseup', e => {
        e.target.classList.remove('tw-animate-pnf-swirl');
        e.target.classList.add('tw-animate-pnf-wiggle-sign');
      });
      sign.addEventListener('mouseleave', e => {
        e.target.classList.remove('tw-animate-pnf-swirl');
        e.target.classList.add('tw-animate-pnf-wiggle-sign');
      });

      let collected = 0;
      function addWaste() {
        const id = Math.floor(Math.random() * (100 - 1)) + 1;
        const top = (Math.floor(Math.random() * (1000 - 1)) + 1) / 10;
        const left = (Math.floor(Math.random() * (1000 - 1)) + 1) / 10;
        const rotate = Math.floor(Math.random() * (360 - 1)) + 1;
        const size = top / 20;
        const oldWaste = document.getElementById('waste-' + id);
        if (oldWaste != null) {
          oldWaste.remove();
        }
        const bottom = document.getElementById('pnf-bottom');
        const waste = document.createElement("div");
        waste.id = 'waste-' + id;
        waste.classList.add('tw-absolute', 'tw-bg-bottle', 'tw-bg-contain');
        waste.style.top = top + '%';
        waste.style.left = left + '%';
        waste.style.width = size + 'rem';
        waste.style.height = size + 'rem';
        waste.style.transform = 'rotate(' + rotate + 'deg)';
        waste.style.zIndex = 0;

        waste.addEventListener('click', e => {
          e.target.remove();
          collected = collected + 1;
          sign.textContent = collected;
        });
        bottom.prepend(waste);
      }
      // setTimeout(() => setInterval(addWaste, 1000), 5000);

      // @see: https://stackoverflow.com/a/71311200
      const onKCode = (action, seq = [38, 38, 40, 40, 37, 39, 37, 39, 66, 65]) => {
        const target = seq.join(',');
        let current = [];
        window.addEventListener('keydown', (e) => {
          current = current.concat(e.keyCode).slice(-seq.length);
          if (current.join(',') == target) { action(current) }
        })
      }
      onKCode (
        (seq) => { console.info('Please keep the ocean tidy.'); setTimeout(() => setInterval(addWaste, 1000), 5000); }
      )

    </script>

