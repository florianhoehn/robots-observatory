  //
// script_global_geo_ip.js - provide geolocation data. promise-based. must load after promise polyfill.
//                         - see here for country codes: https://en.wikipedia.org/wiki/ISO_3166-1_alpha-2
//                         - the country comes from the edge (see identify.php in the theme root)
//

const cookie_name = 'bw_geo';
const cookie_days = 5;

// Marker written when a lookup fails. It was previously never read back —
// is_object() rejects it, so the else branch re-fired the POST on every page
// view for the rest of that user's session. Honoured below, with a short TTL so
// a transient failure doesn't cost geo for the full cookie_days.
const failed_value = 'FailedGeoIPCheck';
const failed_retry_days = 1 / 24; // 1 hour

// Crawlers keep no cookies, so every bot hit missed bw_geo and fired an
// uncacheable POST to /wp-json/all/identify. Geo only drives consent banners,
// GDPR fields and Optimizely — none of which apply to a crawler.
const bot_user_agent = /bot|crawl|spider|slurp|headless|facebookexternalhit|mediapartners/i;

function global_is_bot() {
  return bot_user_agent.test(navigator.userAgent || '');
}

function global_get_user_geo_location() {
  // Note: 1) This function is ran once (right here on line 44).
  //       2) It creates window.global_geo_ip_promise which is then referenced elsewhere.
  //          This allows for one async call the geo ip API, limiting the number of requests.

  if (window.global_geo_ip_promise) {
    return false;
  }

  const geo_cookie = global_get_geo_cookie();

  // 0. Bots: resolve undefined without calling the API — the same value the
  //    failure path below resolves to, so consumers need no new branch.
  if (global_is_bot()) {
    window.global_geo_ip_promise = Promise.resolve(undefined);
  }
  // 1. If cookie is set, resolve window.global_geo_ip_promise (set on line 31).
  else if (geo_cookie !== null && is_object(geo_cookie)) {
    window.global_geo_ip_promise = Promise.resolve(geo_cookie);
  }
  // 1b. A recent lookup failed — don't retry until the marker expires.
  else if (geo_cookie === failed_value) {
    window.global_geo_ip_promise = Promise.resolve(undefined);
  }
  // 2. If cookie doesn’t exist - make async request && set window.global_geo_ip_promise.
  else {
    // Standalone endpoint, no WordPress load (identify.php in the theme
    // root). POST-only; POSTs bypass the CDN cache by default.
    window.global_geo_ip_promise = global_ajax_post_json('/wp-content/themes/brandwatch/identify.php')
      .then((data) => {
        if (data.constructor !== Object || !data.hasOwnProperty('country_code')) {
          throw 'invalid geo return data';
        }
        global_set_geo_cookie(JSON.stringify({ country_code: data.country_code, region_code: data.region_code }));
        return { country_code: data.country_code, region_code: data.region_code };
      })
      .catch((err) => {
        // Could be a problem with Ipstack, AdBlocker etc.
        global_set_cookie(cookie_name, failed_value, failed_retry_days);
      });
  }
}
