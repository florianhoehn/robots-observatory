  //
// script_global_click_ids.js
//
// Captures ad-platform click IDs from the URL on page load and persists them
// for later attribution at form submit:
//   - gclid    Google Ads
//   - fbclid   Meta (Facebook / Instagram)
//   - msclkid  Microsoft Advertising (Bing)
//
// Each click ID is written to:
//   - a 90-day first-party cookie (read by submission.js fill_cookie_driven_field at submit)
//   - localStorage (fallback when cookies are unavailable)
//
// Capture is gated on OneTrust C0004 (Marketing) — if not accepted, nothing is
// written. Re-runs on consent change.
