// gclid only: validates `gclsrc` is a Google Ads click (matches `aw`) before
// accepting. fbclid and msclkid have no equivalent source-validation.
//

(() => {
	const CLICK_IDS = [
		{
			param: 'gclid',
			cookieName: 'gclid',
			localStorageKey: 'gclid',
			// gclsrc must be absent or contain 'aw' (Google Ads). Rejects 3p tags.
			isSourceValid: () => {
				const gclsrc = getParam('gclsrc');
				return !gclsrc || gclsrc.includes('aw');
			},
			// Legacy: write directly to form fields by id on page load (Marketo era).
			// Eloqua-mode forms render hidden inputs without ids — they get filled
			// at submit by submission.js fill_cookie_driven_field instead.
			formFieldIds: ['Google_Click_ID_gclid__c', 'GCLID__c'],
		},
		{
			param: 'fbclid',
			cookieName: 'fbclid',
			localStorageKey: 'fbclid',
			isSourceValid: () => true,
			formFieldIds: ['FBCLID__c', 'fbclid'],
		},
		{
			param: 'msclkid',
			cookieName: 'msclkid',
			localStorageKey: 'msclkid',
			isSourceValid: () => true,
			formFieldIds: ['MSCLKID__c', 'msclkid'],
		},
		{
			param: 'li_fat_id',
			cookieName: 'li_fat_id',
			localStorageKey: 'li_fat_id',
