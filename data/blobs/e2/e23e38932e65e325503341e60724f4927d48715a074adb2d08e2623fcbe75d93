		try {
			stored = JSON.parse(localStorage.getItem(config.localStorageKey));
		} catch {
			console.log(`${config.param}: localStorage read blocked, falling back to cookie.`);
		}
		if (!stored) {
			const cookieVal = getCookie(config.cookieName);
			if (cookieVal) {
				stored = getExpiryRecord(cookieVal);
			}
		}

		const isValid = stored && Date.now() < stored.expiryDate;
		if (!isValid) return;

		// Legacy: populate form fields by id if any are present on the page.
		const field = (config.formFieldIds || [])
			.map(id => document.getElementById(id))
			.find(el => el);

		if (field) {
			field.value = stored.value;
			console.log(`${config.param}: written to form field`, stored.value);
			captured.add(config.param);
		}
	}

	function captureAllClickIds() {
		if (!isMarketingAccepted()) {
			console.log('Click IDs: Marketing cookies not approved, skipping.');
			return;
		}
		CLICK_IDS.forEach(captureClickId);
	}

	// ---- Marketing Consent Field Handling ----
	function updateMarketingConsentField() {
		const input = document.getElementById('marketingConsent');
		if (input) {
			const newValue = isMarketingAccepted() ? 'Y' : 'N';
			if (input.value !== newValue) {
				input.value = newValue;
				console.log('Marketing consent field updated');
			}
		}
	}

	function runWhenConsentReady() {
		// Always try immediately — captureAllClickIds is internally gated on
		// isMarketingAccepted(), so this is a no-op if OT isn't ready yet.
		// AND register the onetrustReady listener regardless, so cold loads
		// where OT arrives later still trigger capture. Previously these were
		// in an if/else, which caused the warm-OT-cached-state race where
		// OptanonActiveGroups was undefined at DOMContentLoaded but onetrustReady
		// had already fired, leaving us with no path to capture.
		captureAllClickIds();
		updateMarketingConsentField();
		document.addEventListener('onetrustReady', () => {
			console.log('OneTrust ready — capturing click IDs and updating marketing fields');
			captureAllClickIds();
			updateMarketingConsentField();
		});
	}

	// DOM observer: re-run capture when any tracked form field appears in the
	// DOM (covers async-rendered forms).
	function setupClickIdObserver() {
		const allFieldIds = CLICK_IDS.flatMap(c => c.formFieldIds || []);
		if (allFieldIds.length === 0) return;
		let observerTimeout;
		const observer = new MutationObserver(() => {
			clearTimeout(observerTimeout);
			observerTimeout = setTimeout(() => {
				if (allFieldIds.some(id => document.getElementById(id))) {
					console.log('Click IDs: form field found via observer');
					captureAllClickIds();
					if (CLICK_IDS.every(c => captured.has(c.param) || !getParam(c.param))) {
						observer.disconnect();
					}
				}
			}, 100);
		});
		observer.observe(document.body, { childList: true, subtree: true });
	}

	function setupMarketingObserver() {
		let observerTimeout;
		const observer = new MutationObserver(() => {
			clearTimeout(observerTimeout);
			observerTimeout = setTimeout(() => {
				const field = document.getElementById('marketingConsent');
				if (field) {
					console.log('Marketing consent field found via observer');
					updateMarketingConsentField();
					observer.disconnect();
				}
			}, 100);
		});
		observer.observe(document.body, { childList: true, subtree: true });
	}

	document.addEventListener('DOMContentLoaded', () => {
		runWhenConsentReady();
		setupClickIdObserver();
		setupMarketingObserver();

		// Re-run on consent change (user toggles OneTrust prefs after page load).
		// Initialize lastGroups synchronously from the current state so the very
		// first transition is caught — including the common case where OT loads
		// just after DOMContentLoaded (undefined -> ",C0004,..."). The prior
		// isFirstRun guard skipped that first transition, which is exactly when
		// warm-cache OT pageloads would silently miss capture.
		let lastGroups = (window.OptanonActiveGroups || '').toString();
		setInterval(() => {
			const currentGroups = (window.OptanonActiveGroups || '').toString();
			if (currentGroups !== lastGroups) {
				lastGroups = currentGroups;
				console.log('[OneTrust] Consent updated.');
				captureAllClickIds();
				updateMarketingConsentField();
			}
		}, 500);
	});

	setTimeout(() => {
		if (captured.size === 0 && typeof window.OptanonActiveGroups === 'undefined') {
			console.warn('Click IDs: OneTrust still not ready after timeout. Capture skipped.');
		}
	}, 3000);
})();


  // InfluencerMarketingHub referral
  // -----------------------------------------------------------------

  //
// script_global_imh.js - persist an InfluencerMarketingHub referral for 30 days.
//
// Replaces classes/forms/imh-cookie.php: reading $_GET['utm_source'] server-side
// forced utm_source into the CDN cache key. That PHP cookie was also httponly,
// so its only consumer (src/core/js/forms/influencer-marketing-hub.js) could
// never read it. Same cookie name and value, so that reader is unchanged.
//

(() => {
	const COOKIE_NAME = 'utm_source';
	const IMH_VALUE = 'imh';
	const COOKIE_DAYS = 30;

	function getParam(name) {
		const match = RegExp(`[?&]${name}=([^&]*)`).exec(window.location.search);
		return match && decodeURIComponent(match[1].replace(/\+/g, ' '));
	}

	function setCookie(name, value, days) {
		const date = new Date();
		date.setTime(date.getTime() + days * 24 * 60 * 60 * 1000);
		const secure = window.location.protocol === 'https:' ? ';secure' : '';
		document.cookie =
			name + '=' + encodeURIComponent(value) +
			';expires=' + date.toUTCString() +
			';path=/;samesite=lax' + secure;
	}

	if (getParam(COOKIE_NAME) === IMH_VALUE) {
		setCookie(COOKIE_NAME, IMH_VALUE, COOKIE_DAYS);
	}
})();


