var writeMessage = function(callbackFunc){

var isWebView = false;
var language= null;

if(getCookie("NMGameCode")!=null || getCookie("gameCode")!=null){ // 웹뷰 여부 cookie로 체크 
	isWebView  = true;
	language=getCookie("NMLanguage");
}


if(language==null){// 언어값이 없을 경우 헤더값의 언어를 가져온다.
		 language = navigator.language;

		 if(language==null && navigator.browserLanguage!=undefined){
			language =  navigator.browserLanguage // IE 하위 버전일 경우 navigator.browserLanguage 사용
		 }

}
if (language!=null){
		language= language.replace("-","_");
		language = language.toUpperCase();
}



if(ERROR_MESSAGE[language]==null){
	switch(language){
	case "KO":  
		language="KO_KR";
		break;
	case "JA":
		 language="JA_JP";
		break;
	case "IN_ID":  
		 language="ID_ID";
		 break;
	}
	if(ERROR_MESSAGE[language+"_"+language]){
	language = language+"_"+language;
	}
}


if(language==null || ERROR_MESSAGE[language]==null){
		language="EN_US"
}

if(!isWebView){
		$("#gnbView").show()
		$("#footer").show()
}

	callbackFunc(language);
}
 

function getCookie(cname) {
    var name = cname + "=";
    var ca = document.cookie.split(';');
    for(var i = 0; i <ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0)==' ') {
            c = c.substring(1);
        }
        if (c.indexOf(name) == 0) {
            return c.substring(name.length,c.length);
        }
    }
    return null;
}

var callbackFunc = function (language){
	if(language=="AR_AR"){
		$("#message").attr("dir","rtl");
		$("#message").attr("lang","ar");

	}
	$("#message").html(ERROR_MESSAGE[language].msg504);
	$("#button").html(ERROR_MESSAGE[language].refresh);

}
		
$( document ).ready( function(){  
	writeMessage(callbackFunc);
	var logoLink = "#"
	if(document.domain.lastIndexOf("netmarble.net")>0){
		logoLink  = "http://www.netmarble.net";

	}else{
		logoLink  = "http://www.netmarble.com"
	}
	$("#gnbLogo").attr("href",logoLink)
	$("#buttonBox").attr("href",location.href)
	

})
