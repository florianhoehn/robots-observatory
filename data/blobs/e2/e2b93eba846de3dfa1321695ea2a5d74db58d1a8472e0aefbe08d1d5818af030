<script>
    (function () {
        var COOKIE_NAME = "_v91t";
        var COOKIE_EXPIRY_DAYS = 30;

        function getCookie(cname) {
            var name = cname + "=";
            var ca = document.cookie.split(';');
            for (var i = 0; i < ca.length; i++) {
                var c = ca[i];
                while (c.charAt(0) == ' ') {
                    c = c.substring(1);
                }
                if (c.indexOf(name) == 0) {
                    return c.substring(name.length, c.length);
                }
            }
            return "";
        }

        function setCookie(cname, cvalue, expiryDays, sameSite, secure) {
            var d = new Date();
            d.setTime(d.getTime() + (expiryDays * 24 * 60 * 60 * 1000));

            var cookieStr = cname + "=" + cvalue + ";expires=" + d.toUTCString() + ";path=/;domain=" + cookieDomain;
            if (sameSite) cookieStr += ";SameSite=" + sameSite;
            if (secure) cookieStr += ";Secure";

            document.cookie = cookieStr;
        }

        // UUID v7 (RFC 9562): a 48-bit millisecond timestamp + version/variant marker bits +
        // random fill. No native browser API generates v7 (crypto.randomUUID() is v4 only),
        // so it's built by hand here from crypto.getRandomValues() — same CSPRNG, just also
        // time-ordered, matching the server-side Str::uuid7() this replaces.
        function uuid7() {
            var ts = BigInt(Date.now());
            var rand = new Uint8Array(10);
            crypto.getRandomValues(rand);

            var bytes = new Uint8Array(16);
            bytes[0] = Number((ts >> 40n) & 0xffn);
            bytes[1] = Number((ts >> 32n) & 0xffn);
            bytes[2] = Number((ts >> 24n) & 0xffn);
            bytes[3] = Number((ts >> 16n) & 0xffn);
            bytes[4] = Number((ts >> 8n) & 0xffn);
            bytes[5] = Number(ts & 0xffn);
            bytes[6] = 0x70 | (rand[0] & 0x0f); // version 7
            bytes[7] = rand[1];
            bytes[8] = 0x80 | (rand[2] & 0x3f); // variant (RFC 9562)
            bytes[9] = rand[3];
            bytes[10] = rand[4];
            bytes[11] = rand[5];
            bytes[12] = rand[6];
            bytes[13] = rand[7];
            bytes[14] = rand[8];
            bytes[15] = rand[9];

            var hex = Array.from(bytes, function (b) { return b.toString(16).padStart(2, '0'); }).join('');
            return hex.slice(0, 8) + '-' + hex.slice(8, 12) + '-' + hex.slice(12, 16) + '-' + hex.slice(16, 20) + '-' + hex.slice(20);
        }

        if (!getCookie(COOKIE_NAME)) {
            // Secure: required now that every environment this cookie is tested/used on serves
            // HTTPS (a Secure cookie can't be stored by a browser from a plain-HTTP response at
            // all — earlier HTTP-only testing domains are retired, code review, 2026-09-21).
            // SameSite=None: broader than strictly required for today's only real consumers
            // (api.91mobiles.com / qa-api.91mobiles.com share the same registrable domain as
            // this page, so SameSite=Lax would already cover that same-site cross-subdomain
            // fetch) — left as None rather than narrowed to Lax for now, since this exact cookie
            // mechanism has a history of stacked transport bugs (SameSite/Secure interaction,
            // credentials:false) that only surfaced under live testing; revisit only alongside an
            // actual live test on a real deployed box, not as a paper change (code review,
            // 2026-09-21). HttpOnly is unavailable to a JS-set cookie by definition — acceptable
            // here since this is an opaque analytics id, not a session/auth token.
            setCookie(COOKIE_NAME, uuid7(), COOKIE_EXPIRY_DAYS, 'None', true);
        }
    })();
