            </div>
        </div>

            <script>
        (function() {
            var remaining = 5;
            var el = document.getElementById('countdown');
            var timer = setInterval(function() {
                remaining--;
                if (el) {
                    el.textContent = remaining;
                }
                if (remaining <= 0) {
                    clearInterval(timer);
                    window.location.href = "https:\/\/www.odatv.com";
                }
            }, 1000);
        })();
    </script>
