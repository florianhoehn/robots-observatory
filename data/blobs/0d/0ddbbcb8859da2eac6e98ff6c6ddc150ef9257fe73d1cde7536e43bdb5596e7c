  <script type="text/javascript">
  (function () {
    function getCookie(cookieName) {
      var name = cookieName + '=';
      var cookieArray = document.cookie.split(';');
      for (var i = 0; i < cookieArray.length; i++) {
        var cookie = cookieArray[i];
        while (cookie.charAt(0) == ' ') cookie = cookie.substring(1);
        if (cookie.indexOf(name) == 0) return cookie.substring(name.length, cookie.length);
      }
      return '';
    }

    function getPlatform() {
      if (navigator.userAgent.match(/Android|webOS|iPhone|iPad|iPod|BlackBerry|Windows Phone/i)) {
        if (window.innerWidth < 768) {
          return 'mobile';
        }
        return 'tablet';
      }
      return 'desktop';
    }

    function getLineofBusiness() {
      if (location.pathname.match(/business|biz/i)) {
        return 'business';
      } else {
        return 'consumer';
      }
    }

    function getCondition() {
      if (location.pathname == '/') {
        return 'postpaid_homepage';
      } else if (location.pathname == '/homepage/business/') {
        return 'b2b_homepage';
      } else if (location.pathname == '/prepaid/') {
        return 'prepaid_homepage';
      } else if (lineOfBusiness === 'business') {
        return 'b2b landing page';
      } else {
        return 'landing page';
      }
    }

    function getpageType() {
      if (condition === 'postpaid_homepage') {
        return 'homepage';
      } else if (condition === 'b2b_homepage') {
        return 'b2b';
      } else if (condition === 'prepaid_homepage') {
        return 'store';
      } else if (lineOfBusiness === 'business') {
        return 'b2b';
      } else {
        return 'store';
      }
    }

    function getPageName() {
      if (condition.indexOf('postpaid_homepage') >= 0) {
        return '/' + platform + ' store/' + typeIndicator + '/home page';
      } else if (condition.indexOf('prepaid_homepage') >= 0) {
        return '/' + platform + ' store/prepay/home';
      } else if (condition.indexOf('b2b_homepage') >= 0) {
        return '/' + platform + ' store/b2b/home page';
      } else if (condition.indexOf('b2b landing page') >= 0) {
        return '/' + platform + ' b2b' + location.pathname;
      } else {
        return '/' + platform + ' store' + location.pathname;
      }
    }

    function getSection(str, secCnt) {
      var strArr = str.charAt(0) === '/' ? str.slice(1).split('/') : str.split('/'),
        retStr = '',
        cnt = 0;
      if (strArr.length - (cnt + 1) <= secCnt) {
        return '';
      }
      for (var i = cnt; i <= secCnt && i <= strArr.length - 1; i++) {
        retStr += '/' + strArr[i];
      }
      return retStr;
    }

    var pageDL,
      authenticationDL,
      typeIndicator = getCookie('myaccount') ? 'customer' : 'prospect',
      platform = getPlatform(),
      lineOfBusiness = getLineofBusiness(),
      condition = getCondition(),
      flowName = condition.indexOf('homepage') > -1 ? 'home page' : 'landing page',
      flowType = flowName === 'home page' ? '' : location.pathname.toLowerCase().replace(/[^A-Za-z0-9]/g, ' ')
      .replace(/\s\s+/g, ' ').trim(),
      pageName = getPageName().toLowerCase().replace(/\s\s+/g, ' ').replace(/-/g, ' ').trim().replace(/\/$/, '');

    pageDL = {
      accBundleFlag: '',
      accDiscountApplied: '',
      area: '',
      authStatus: getCookie('loggedIn') ? 'authenticated' : 'unauthenticated',
      cpcFlag: '',
      channel: getSection(pageName, 0),
      condition: condition.indexOf('landing page') > -1 ? condition + ',LP_AC' : condition,
      currentUserPlanId: '',
      conversionType: '',
      deviceDollarsApplied: '',
      deviceId: '',
      deviceManufacturer: '',
      deviceModel: '',
      deviceValue: '',
      dhSearchTerm: '',
      dhSearchType: '',
      email: '',
      errorCode: '',
      errorMsg: '',
      flowInteraction: 'navigation',
      flowName: flowName,
      flowType: flowType,
      globalId: getCookie('GLOBALID'),
      hardResponse: '',
      hier1: pageName.slice(1),
      incedoVersion: '',
      language: (getCookie('MP_LANG') == 'es' ? 'Spanish' : 'English'),
      lineOfBusiness: lineOfBusiness,
      microInteraction: '',
      microType: '',
      mlsExp: '1D:' + platform,
      numberOfLinesChanged: '',
      numberofTradeInLines: '',
      pageName: pageName,
      pageType: platform + ' ' + getpageType(),
      perContentImpression: '',
      platform: platform,
      promosApplied: '',
      section2: getSection(pageName, 1),
      section3: getSection(pageName, 2),
      selfServiceType: '',
      shopPath: '',
      state: getCookie('STATE'),
      storeNumber: '',
      testVersion: '',
      tradeInSubId: '',
      typeIndicator: typeIndicator,
      zipCode: getCookie('ZIPCODE')
    };

    authenticationDL = {
      accountNumber: '',
      aHash: '',
      collectionsInd: '',
      custType: 'b2c',
      ecpdId: '',
      eHash: '',
      eHash2: '',
      email: '',
      greetingName: '',
      impId: '',
      impType: '',
      mdn: '',
      mhash: '',
      mhash2: '',
      prepayInd: '',
      userRole: getCookie('role'),
      VCT: '',
      vzw_survey: ''
    };

    window.vzwDL = window.vzwDL || {};
    window.vzwDL.page = pageDL;
    window.vzwDL.authentication = authenticationDL;
  })();
</script>
  
