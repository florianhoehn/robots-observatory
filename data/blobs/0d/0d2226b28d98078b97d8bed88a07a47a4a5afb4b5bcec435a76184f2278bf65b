            document.querySelectorAll('.sidebar-pop.open').forEach(function(pop) {
                if (pop.contains(e.target)) return;
                var triggers = (pop.getAttribute('data-trigger') || '').split(',');
                for (var i = 0; i < triggers.length; i++) {
                    var btn = document.getElementById(triggers[i].trim());
                    if (btn && btn.contains(e.target)) return;
                }
                pop.classList.remove('open');
            });
