<script>
    // Keep --notice-bar-height in sync with the notice bar's real (possibly wrapped) height so the
    // fixed sidebar offset stays correct at any width. Also handle dismissal — removing the bar makes
    // body:has(.header-wide-notification) stop matching, so the grid/sidebar offset revert on their own.
    (function () {
        var bar = document.querySelector('.header-wide-notification');
        if (!bar) return;
        var DISMISS_KEY = 'notice-bar-dismissed';
        if (sessionStorage.getItem(DISMISS_KEY)) { bar.remove(); return; }
        var apply = function () {
            document.documentElement.style.setProperty('--notice-bar-height', bar.offsetHeight + 'px');
        };
        apply();
        window.addEventListener('resize', apply);
        var close = bar.querySelector('.header-wide-notification-close');
        if (close) {
            close.addEventListener('click', function () {
                sessionStorage.setItem(DISMISS_KEY, '1');
                bar.remove();
            });
        }
    })();
</script>




