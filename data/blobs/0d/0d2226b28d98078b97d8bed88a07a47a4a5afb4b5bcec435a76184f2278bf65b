<script>
    function Toggle() {
        document.querySelector('nav').classList.toggle('menu-active');
        document.documentElement.classList.toggle('overcast');
    }
    (function() {
        var c = document.getElementById('sidebar-check');
        c.addEventListener('change', function() {
            document.cookie = 'sidebarState=' + (c.checked ? 'minimal' : 'open') + ';path=/;max-age=31536000;SameSite=Lax';
        });

        var isMobile = window.matchMedia('(max-width: 825px)').matches;

        document.querySelectorAll('nav > .sidebar-pop').forEach(function(p) {
            document.body.appendChild(p);
        });

        function positionPop(pop, rect) {
            if (isMobile) return;
            var vw = window.innerWidth;
            var vh = window.innerHeight;

            pop.style.top = '';
            pop.style.bottom = '';
            pop.style.left = '';
            pop.style.right = '';

            var popLeft = rect.right + 8;
            var popTop = rect.top;

            // Measure actual size (popup must be display:block to measure)
            var popWidth = pop.offsetWidth || 200;
            var popHeight = pop.offsetHeight || 200;

            // Keep within viewport
            if (popLeft + popWidth > vw - 8) popLeft = Math.max(8, vw - popWidth - 8);
            if (popTop + popHeight > vh - 8) popTop = Math.max(8, vh - popHeight - 8);

            pop.style.left = popLeft + 'px';
            pop.style.top = popTop + 'px';
        }

        function closeAllPops(except) {
            document.querySelectorAll('.sidebar-pop.open').forEach(function(p) {
                if (p !== except && p.id !== except) p.classList.remove('open');
            });
        }

        function togglePop(popId, rect) {
            closeAllPops(popId);
            var pop = document.getElementById(popId);
            if (!pop) return;
            if (pop.classList.contains('open')) {
                pop.classList.remove('open');
            } else {
                pop.style.visibility = 'hidden';
                pop.classList.add('open');
                positionPop(pop, rect);
                pop.style.visibility = '';
            }
        }
        window.togglePop = togglePop;

        document.getElementById('head-more').addEventListener('click', function() {
            togglePop('tools-grid-pop', this.closest('a').getBoundingClientRect());
        });
        document.getElementById('head-theme').addEventListener('click', function() {
            if (window.openPreferences) window.openPreferences('theme');
        });
        document.getElementById('head-language').addEventListener('click', function() {
            if (window.openPreferences) window.openPreferences('language');
        });
        document.getElementById('head-news').addEventListener('click', function() {
            if (window.openNews) window.openNews();
        });

        // News poll — show red dot if unread items, auto-popup if pop:true
        (function() {
            // Skip Pixlr news/announcements entirely in embedded/API mode.
            if (document.documentElement.classList.contains('api-embed')) return;
            var lastCheck = '1970-01-01T00:00:00Z';
            try {
                var raw = window.localStorage.getItem('user-settings');
                if (raw) lastCheck = JSON.parse(raw).lastNewsCheck || lastCheck;
            } catch (_) {}
            function runNewsPoll() {
                fetch('/api/news/poll?target=web&from=' + encodeURIComponent(lastCheck), { priority: 'low' })
                    .then(function(r) { return r.json(); })
                    .then(function(json) {
                        var d = json && json.data;
                        if (!d) return;
                        if (d.unread > 0) {
                            var bell = document.getElementById('head-news');
                            if (bell && !bell.querySelector('.unread-dot')) {
                                var dot = document.createElement('span');
                                dot.className = 'unread-dot';
                                bell.appendChild(dot);
                            }
                        }
                        if (d.pop && d.news && d.news.docs && d.news.docs.length && window.openNews) {
                            window.openNews(d.news.docs);
                        }
                    })
                    .catch(function() {});
            }
            // Defer until after load + browser idle so the poll never competes with critical resources.
            function scheduleNewsPoll() {
                if ('requestIdleCallback' in window) {
                    window.requestIdleCallback(runNewsPoll, { timeout: 3000 });
                } else {
                    setTimeout(runNewsPoll, 1500);
                }
            }
            if (document.readyState === 'complete') {
                scheduleNewsPoll();
            } else {
                window.addEventListener('load', scheduleNewsPoll, { once: true });
            }
        })();

