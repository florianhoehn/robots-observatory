    //Dropdown function
    dropdownToggle = function() {
    $('button.dropdown-toggle, a.signInUserAccount').removeClass('disabled');

    $(document).on('click', 'button.dropdown-toggle', function(e) {
        $('button.dropdown-toggle').not(this).each(function() {
            $(this).parent('.btn-group').removeClass('open');
        });

        if ($(this).parent().is('.btn-group')) {
            $(this).attr('aria-expanded', function(i, attr) {
                return attr == 'true' ? 'false' : 'true';
            });

            $(this).parent('.btn-group').toggleClass('open');

            if ($(this).hasClass('btn-func-filter')) {
                if ($(this).parent('.filter-group').hasClass('open')) {
                    $('.dropdown-menu, .dropdown-group')
                        .parent('.btn-group')
                        .find('.btn-func-filter')
                        .children('.fa-icon')
                        .removeClass('fa-chevron-up')
                        .addClass('fa-chevron-down');

                    $(this).find('.fa-icon')
                        .toggleClass('fa-chevron-down fa-chevron-up');
                } else {
                    $(this).find('.fa-icon')
                        .toggleClass('fa-chevron-up fa-chevron-down');

                    $('.dropdown-menu, .dropdown-group')
                        .parent('.btn-group')
                        .find('.btn-func-filter')
                        .children('.fa-icon')
                        .removeClass('fa-chevron-up')
                        .addClass('fa-chevron-down');
                }
            }
        }
        return false;
    });
};

dropdownToggle();


// Keyboard support on button (open + focus items)
$(document).on('keydown', 'button.dropdown-toggle', function (e) {
    var $btnGroup = $(this).parent('.btn-group');

    if (e.which === 40) { // Down arrow
        e.preventDefault();

        if (!$btnGroup.hasClass('open')) {
            $btnGroup.addClass('open');
            $(this).attr('aria-expanded', 'true');
        }

        $btnGroup.find('.dropdown-menu a').first().focus();
    }

    if (e.which === 38) { // Up arrow
        e.preventDefault();

        if (!$btnGroup.hasClass('open')) {
            $btnGroup.addClass('open');
            $(this).attr('aria-expanded', 'true');
        }

        $btnGroup.find('.dropdown-menu a').last().focus();
    }
});


// Arrow navigation inside dropdown
$(document).on('keydown', '.btn-group.open .dropdown-menu a', function (e) {
    var $items = $(this).closest('.dropdown-menu').find('a');
    var index = $items.index(this);

    switch (e.which) {
        case 40: // Down
            e.preventDefault();
            $items.eq((index + 1) % $items.length).focus();
            break;

        case 38: // Up
            e.preventDefault();
            $items.eq((index - 1 + $items.length) % $items.length).focus();
            break;

        case 36: // Home
            e.preventDefault();
            $items.first().focus();
            break;

        case 35: // End
            e.preventDefault();
            $items.last().focus();
            break;
    }
});


// Remove dropdown when clicking outside
removeDropdownToggle = function(e) {
    $(document).on('click', function(e) {
        var dropdownToggle = $('.dropdown-menu, .dropdown-group')
            .parent('.btn-group, .filter-group');

        var $trigger = $(".dropdown-toggle, .dropdown-menu");

        if ($trigger !== e.target && !$trigger.has(e.target).length) {
            $(dropdownToggle).removeClass('open');

            if ($(dropdownToggle)) {
                $(dropdownToggle)
                    .find('.btn-func-filter')
                    .children('.fa-icon')
                    .removeClass('fa-chevron-up')
                    .addClass('fa-chevron-down');
            }
        }
    });

    escRemoveDropdownToggle();
};


hideDropdownToggle = function() {
    $('ul.dropdown-menu li a')
        .on('focus focusin', function() {
            var $signonbutton = $(this).parents('li.btn-group');

            $signonbutton.addClass("open");
            $signonbutton.find('button.dropdown-toggle')
                .attr('aria-expanded', 'true');

        }).on('focusout', function() {

            var $signonbutton = $(this).parents('li.btn-group');
            var $parent = $(this).parents('ul.dropdown-menu');

            setTimeout(function() {
                if (!$.contains($parent[0], document.activeElement)) {
                    $signonbutton.removeClass("open");
                    $signonbutton.find('button.dropdown-toggle')
                        .attr('aria-expanded', 'false');
                }
            }, 0);
        });

    escRemoveDropdownToggle();
};


escRemoveDropdownToggle = function(e) {

    $(document).on('keydown', function(e) {
        if (e.which == 27) { // ESC key
            var dropdownToggle = $('.dropdown-menu, .dropdown-group')
                .parent('.btn-group, .filter-group');

            $(dropdownToggle).removeClass('open');

            $(dropdownToggle)
                .find('.btn-func-filter')
                .children('.fa-icon')
                .removeClass('fa-chevron-up')
                .addClass('fa-chevron-down');

            $('button.dropdown-toggle').attr('aria-expanded', 'false')
                .focus();

            e.preventDefault();
        }
    });
};


