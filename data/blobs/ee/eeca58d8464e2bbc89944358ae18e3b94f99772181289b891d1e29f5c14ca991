<script>
document.addEventListener("DOMContentLoaded", () => {
  const SELECTOR = ".must-be-won-by";
  const TITLE_SELECTOR = ".jackpot-details .jackpot-group-name";
  const OBSERVE_TARGET = document.querySelector(".jackpots-container") || document.body;

  function applyUpdates() {
    const all = document.querySelectorAll(SELECTOR);
    if (!all.length) return;

    // Hide only the very first element
    if (all[0] && !all[0].dataset.processed) {
      all[0].style.display = "none";
      all[0].dataset.processed = "true";
    }

    // Update next jackpots
    if (all[1] && !all[1].dataset.updated) {
      all[1].textContent = all[1].textContent.replace(
        /(Must Be Won By )\d+/i,
        (_, p1) => `${p1}£35,000`
      );
      all[1].dataset.updated = "true";
    }

    if (all[2] && !all[2].dataset.updated) {
      all[2].textContent = all[2].textContent.replace(
        /(Must Be Won By )\d+/i,
        (_, p1) => `${p1}£3,500`
      );
      all[2].dataset.updated = "true";
    }
  }

  // Run once when available
  const wait = setInterval(() => {
    if (document.querySelector(SELECTOR)) {
      applyUpdates();
      clearInterval(wait);
    }
  }, 200);

  // Keep a single observer alive
  const observer = new MutationObserver((mutations) => {
    let shouldRun = false;

    // Run only if jackpot nodes are added/changed
    for (const mutation of mutations) {
      if (
        [...mutation.addedNodes].some(
          (node) =>
            node.nodeType === 1 &&
            (node.matches?.(SELECTOR) || node.querySelector?.(SELECTOR))
        )
      ) {
        shouldRun = true;
        break;
      }
    }

    if (shouldRun) {
      applyUpdates();
    }
  });

  observer.observe(OBSERVE_TARGET, { childList: true, subtree: true });
});
</script>

