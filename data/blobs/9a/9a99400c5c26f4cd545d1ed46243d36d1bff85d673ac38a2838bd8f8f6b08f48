  <script>
  (function() {
    try {
      var params = new URLSearchParams(window.location.search);
      var token = params.get('token');
      if (!token) return;

      var map = {
        token: 'eba-sso-token',
        refreshToken: 'eba-sso-refreshToken',
        roleUuid: 'roleUuid',
        role: 'role',
        theme: 'theme',
        platformName: 'platformName'
      };
      Object.keys(map).forEach(function(key) {
        var value = params.get(key);
        if (value) localStorage.setItem(map[key], value);
      });
      if (params.get('platformName')) sessionStorage.setItem('platformName', params.get('platformName'));

      // Önceki kullanıcıdan kalmasın; yalnızca geçerli JSON ise yazılır.
      localStorage.removeItem('roleBasedData');
      try {
        var roleBasedData = params.get('roleBasedData');
        if (roleBasedData && JSON.parse(roleBasedData)) localStorage.setItem('roleBasedData', roleBasedData);
      } catch (e) {}

      ['token', 'refreshToken', 'roleBasedData'].forEach(function(key) { params.delete(key); });
      var query = params.toString();
      history.replaceState(history.state, '', window.location.pathname + (query ? '?' + query : '') + window.location.hash);
    } catch (e) {
      console.error('mobile session init', e);
    }
  })();

  // Mobil uygulama (android/ios) webview'ı URL'de platformName gönderir. Uygulama
  // bir sayfayı doğrudan (parametresiz) açabildiği için değer kalıcı olarak
  // localStorage'da da tutulur; 'platform' anahtarını React tarafı yazıyor.
  window.getMobilePlatform = function() {
    var platform = null;
    try {
      platform = new URLSearchParams(window.location.search).get('platformName');
      if (platform) {
        sessionStorage.setItem('platformName', platform);
        localStorage.setItem('platformName', platform);
      } else {
        platform = sessionStorage.getItem('platformName')
          || localStorage.getItem('platformName')
          || localStorage.getItem('platform');
      }
    } catch (e) {}
    platform = (platform || '').toLowerCase();
    return (platform === 'android' || platform === 'ios') ? platform : null;
  };

  // Misafir kullanıcıda native'e iletilen tek aksiyonlar; diğer her şey webview
  // içinde web davranışıyla devam eder.
  var GUEST_ACTIONS = ['loginClicked', 'externalLinkClicked'];

  // Native köprü: window.invoke[action](...args). Mobil değilse, köprü yoksa ya da
  // misafir kullanıcıda izin verilmeyen bir aksiyonsa false döner; çağıran taraf
  // normal web davranışına devam eder.
  // Örnek: callNative('profileClicked'), callNative('contentClicked', uuid)
  window.callNative = function(action) {
    var bridge = window.invoke;
    if (!window.getMobilePlatform() || !bridge || typeof bridge[action] !== 'function') return false;
    if (GUEST_ACTIONS.indexOf(action) === -1 && !window.ebaIsLoggedIn()) return false;
    try {
      bridge[action].apply(bridge, Array.prototype.slice.call(arguments, 1));
      return true;
    } catch (e) {
      console.error('native bridge error', action, e);
      return false;
    }
  };

  // Oturum açık mı? (JWT exp kontrolü) Misafir kullanıcıda bazı tıklamalar
  // native'e iletilmeyip web'de devam ediyor.
  window.ebaIsLoggedIn = function() {
    try {
      var tok = localStorage.getItem('eba-sso-token');
      if (!tok) return false;
      var s = tok.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
      while (s.length % 4) s += '=';
      var payload = JSON.parse(atob(s));
      return !!(payload && payload.exp && payload.exp > Date.now() / 1000);
    } catch (e) {
      return false;
    }
  };

  // Mobil webview: giriş akışını uygulama yönettiği için "Giriş Yap" / "EBA'ya Git"
  // butonu gizlenir. Buton JS ile metin/adres değiştirdiğinden CSS yerine burada.
  document.addEventListener('DOMContentLoaded', function() {
    if (!window.getMobilePlatform()) return;
    document.querySelectorAll('[data-hide-in-webview]').forEach(function(el) {
      el.style.display = 'none';
    });
  });

  // Mobil webview: "Giriş Yap" (/login) tıklamaları native tarafa iletilir,
  // giriş ekranını uygulama açar. Köprü yoksa link normal çalışır.
  document.addEventListener('click', function(e) {
    var link = e.target && e.target.closest && e.target.closest('a[href]');
    if (!link) return;
    var path = link.getAttribute('href') || '';
    if (path !== '/login' && path !== 'https://eba.gov.tr/login') return;
    if (window.callNative('loginClicked')) e.preventDefault();
  });

  // Mobil webview: site dışına (başka alan adına) giden linkler native tarafa iletilir.
  // Site içi linkler etkilenmez; köprü yoksa link normal çalışır.
  document.addEventListener('click', function(e) {
    var link = e.target && e.target.closest && e.target.closest('a[href]');
    if (!link) return;
    var href = link.getAttribute('href') || '';
    if (!/^https?:\/\//i.test(href)) return;
    try {
      if (new URL(href, window.location.href).host === window.location.host) return;
    } catch (err) {
      return;
    }
    if (window.callNative('externalLinkClicked', link.href)) e.preventDefault();
  });
</script>
  <script>
    // Tüm fetch isteklerine Accept-Language: tr eklensin (çağıran kod başka bir değer set etmediyse).
    (function() {
      var nativeFetch = window.fetch;
      window.fetch = function(input, init) {
        if (input instanceof Request && !init) {
          var reqClone = input.clone();
          if (!reqClone.headers.has('Accept-Language')) reqClone.headers.set('Accept-Language', 'tr');
          return nativeFetch.call(this, reqClone);
        }
        init = init || {};
        var headers = (input instanceof Request) ? new Headers(input.headers) : new Headers();
        if (init.headers) {
          new Headers(init.headers).forEach(function(value, key) { headers.set(key, value); });
        }
        if (!headers.has('Accept-Language')) headers.set('Accept-Language', 'tr');
        init.headers = headers;
        return nativeFetch.call(this, input, init);
      };
    })();
  </script>
