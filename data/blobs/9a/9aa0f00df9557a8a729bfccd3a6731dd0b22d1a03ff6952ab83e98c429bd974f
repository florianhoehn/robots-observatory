        var slug = entries[i].sitename.toLowerCase().replace(/\./g, '-'); // otr.cfo -> otr-cfo
        for (var j = 0; j < classes.length; j++) {
            if (classes[j].indexOf('domain-') !== 0) continue;
            var rest = classes[j].slice(7); // strip "domain-"
            if (rest === slug || rest.indexOf(slug + '-') === 0) {
                console.log('[GSE] matched site "' + entries[i].sitename + '" -> cx=' + entries[i].id + ' (via body class "' + classes[j] + '")');
                return entries[i].id;
