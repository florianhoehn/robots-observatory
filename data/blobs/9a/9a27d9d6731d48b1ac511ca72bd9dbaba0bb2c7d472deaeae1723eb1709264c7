//삭제
function h_del(sWord){
		var param = ck_value.trim().replace("|" + sWord + "|","");
		
		$.ajax({
			type: "POST",
			url: "/cookie_add.jsp?ck=" + param,
			cache: false,
			async: false,
			success: function (resultText)
			{
			},
		    error: function() {
		    }
		});
		
		$.ajax({
			type: "POST",
			url: "/cookie.jsp",
			cache: false,
			async: false,
			success: function (resultText)
			{
				ck_value = String( resultText ).trim();
				var result = resultText.split("||");
				var history = "";

//				for(var i=0;i<result.length;i++) {
				for(var i = result.length-1; i >= 0; i--) {
//					if(result[i].trim()=="") history += "no recently searched keywords.";
					if(result[0].trim()=="") history += "no recently searched keywords.";
					else {
						var result_split = result[i].split("@");
						var result_pname = result_split[0].replace(/\|/g,"").trim();
						var result_sort = result_split[1].replace(/\|/g,"").trim();

