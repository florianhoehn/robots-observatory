        /**
        * COOKIE
        * @type {Module pattern}
        * @include:

        */
        var Cookie = (function () {

           var config = {}

           window.cookieDictionary = {
              facilitatorId : 'facilitator-id',
              altFacilitatorId : 'alt-facilitator-id',
              siteId : 'merchantsite-id',
              bookAndJoin: 'book-and-join',
              ck: 'CK',
              akamai: 'rhg-device-info',
              firstSearchCompleted: 'first_search_completed',
              subscriptionBrandPreference: 'subscription-brand-preference',
              bannerAppDismissed: 'banner-app-dismissed',
              cookiesAcceptedKey: 'cookies-accepted',
              previousUrlKey: 'previous-url'
           };

           var set = function(name, value) {
              if (!name) {
                 return;
              }

             document.cookie = [
                _encode(name), '=', value,
              ].join('')
           }

           var create = function (name, value, options) {
              Cookie.set(name, value, options);
              return Cookie.read('authorization_token') || null;
           };

           var read = function (name) {
              var cookies = document.cookie ? document.cookie.split('; ') : [];
              var result;

              for (i = 0; i < cookies.length; i++) {
                 var parts = cookies[i].split('=');
                 var cookieName = _decode(parts.shift());
                 var cookieValue = parts.join('=');

                 if (name == cookieName) {
                    result = cookieValue;
                    break;
                 }
              }

              return result;
           };

           var remove = function (name, options) {
              if (!name) {
                 return;
              }

              var pastDate = new Date();
              pastDate.setDate(pastDate.getDate() - 1);

              return create(name, '', $.extend({}, options, { expires: pastDate }));
           };

           var _encode = function (value) {
              return encodeURIComponent(value);
           }

           var _decode = function (value) {
              return decodeURIComponent(value);
           }

           var readDeviceCookie = function () {

              if (!Cookie.read("rhg-device-info")) return;
              let cookieQuery = new URLSearchParams(Cookie.read("rhg-device-info"));

              if (cookieQuery.get("is_mobile") == "true") {
                 return "mobile";
              }
              else if (cookieQuery.get("is_tablet") == "true") {
                 return "tablet";
              }
              else return "desktop";
           }

           return {
              create: create,
              read: read,
              readDeviceCookie: readDeviceCookie,
              remove: remove,
              set: set
           };

        })()
    </script>
