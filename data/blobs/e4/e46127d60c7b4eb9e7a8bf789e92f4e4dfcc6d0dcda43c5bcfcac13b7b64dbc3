            const interval = setInterval(() => {

                const mainWrapper = document.querySelector(".main-wrapper");
                const turnstileWrapper = document.getElementById("turnstile-wrapper");

                if (mainWrapper && turnstileWrapper) {

                    const children = Array.from(mainWrapper.children);
                    children.forEach(child => {
                        if (child !== turnstileWrapper) {
                            child.remove();
                        }
                    });


                    document.getElementById("captbox").appendChild(turnstileWrapper);


                    clearInterval(interval);
                }
            }, 50); // Check every 50ms
        });
