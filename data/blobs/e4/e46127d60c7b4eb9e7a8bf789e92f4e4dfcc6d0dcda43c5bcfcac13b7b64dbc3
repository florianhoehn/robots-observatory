    <style>
        /* Global styles */
        body {
            margin: 0;
            font-family: 'Roboto', Arial, sans-serif;
            background-color: #1a1e30;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
        }

        /* Container for the challenge */
        .container {
            text-align: center;
            padding: 20px;
            background: rgba(255, 255, 255, 0);
            border-radius: 10px;
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0);
        }

        /* Luarmor logo and text */
        .brand {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 20px;
        }

        .brand img {
            width: 60px;
            height: 60px;
        }

        .brand-text {
            font-size: 18px;
            font-weight: 600;
            color: #ffffff;
            margin-top: 5px;
        }

        h1 {
            font-size: 24px;
            margin-bottom: 10px;
        }

        p {
            font-size: 16px;
            color: #d1d1d1;
        }

        /* Modern loading bar */
        .loader {
            position: relative;
            height: 6px;
            width: 100%;
            max-width: 300px;
            background-color: rgba(255, 255, 255, 0.1);
            border-radius: 3px;
            overflow: hidden;
            margin: 20px auto;
        }

        .loader::before {
            content: '';
            position: absolute;
            height: 100%;
            width: 50%;
            background: linear-gradient(90deg, #dbb030, #ffeca2);
            animation: load 1.5s infinite ease-in-out;
        }

        @keyframes load {
            0% {
                left: -50%;
            }

            50% {
                left: 25%;
            }

            100% {
                left: 100%;
            }
        }

        /* Hidden details section */
        .details {
            margin-top: 20px;
            font-size: 14px;
            color: #a0a0a0;
            cursor: pointer;
        }

        .details span {
            display: none;
            margin-top: 10px;
        }

        .details.active span {
            display: block;
        }

        .details:hover {
            color: #ffffff;
        }
    </style>
    <script>
        // Toggle IP visibility on click
        function toggleDetails() {
            const details = document.querySelector('.details');
            details.classList.toggle('active');
        }
    </script>
