<script>
  "use strict";
(() => {
  // src/constants.ts
  var selectorPrefix = "un-";
  var elementSelector = `${selectorPrefix}element`;
  var attributeSelector = `${selectorPrefix}attribute`;
  var slugSelector = `${selectorPrefix}slug`;

  // src/utils/dom.ts
  var getElement = (selector, context = document) => {
    const element = selector ? context.querySelector(`[${elementSelector}="${selector}"]`) : context.querySelector(`[${elementSelector}]`);
    if (!element) {
      throw new Error(`Element ${selector} not found`);
    }
    return element;
  };

  // src/utils/webflow.ts
  var onWebflowReady = (callback) => {
    window.Webflow = window.Webflow || [];
    window.Webflow.push(callback);
  };

  // src/components/email-autofill.ts
  var SOURCE_FORM_IDS = ["wf-form-Home-Email-Form", "email-form"];
  var AUTOFILL_TARGET_BY_PATH = {
    "/schedule-demo": "schedule-demo-form-email",
    "/thank-you": "schedule-demo-form-email"
  };
  var STORAGE_KEY = "un-email-autofill";
  var getSourceForms = () => SOURCE_FORM_IDS.map((id) => document.getElementById(id)).filter(
    (form) => form instanceof HTMLFormElement
  );
  var captureOnSubmit = () => {
    getSourceForms().forEach((form) => {
      const input = form.querySelector("input");
      if (!input) return;
      form.addEventListener("submit", () => {
        if (input.value) sessionStorage.setItem(STORAGE_KEY, input.value);
      });
    });
  };
  var resetOnBfcacheRestore = () => {
    const buttons = getSourceForms().map((form) => form.querySelector('input[type="submit"]')).filter((button) => button !== null).map((button) => ({ button, value: button.value, disabled: button.disabled }));
    if (!buttons.length) return;
    window.addEventListener("pageshow", (event) => {
      if (!event.persisted) return;
      buttons.forEach(({ button, value, disabled }) => {
        button.value = value;
        button.disabled = disabled;
      });
    });
  };
  var populateOnLoad = () => {
    const targetSelector = AUTOFILL_TARGET_BY_PATH[location.pathname];
    if (!targetSelector) return;
    const email = sessionStorage.getItem(STORAGE_KEY);
    if (!email) return;
    let input;
    try {
      input = getElement(targetSelector);
    } catch {
      console.warn(`email-autofill: no [un-element="${targetSelector}"] input found`);
      return;
    }
    input.value = email;
    input.dispatchEvent(new Event("input", { bubbles: true }));
    sessionStorage.removeItem(STORAGE_KEY);
  };
  var EmailAutofill = () => {
    onWebflowReady(() => {
      captureOnSubmit();
      resetOnBfcacheRestore();
      populateOnLoad();
    });
  };

  // src/entries/global/email-autofill.ts
  EmailAutofill();
})();
</script>

