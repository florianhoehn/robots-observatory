<script>
function insertBackgroundVideo(targetClass, videoSources, onInsertCallback) {
    const targetDiv = document.querySelector(`.${targetClass}`);
    if (!targetDiv) {
        console.warn(`Element with class "${targetClass}" not found.`);
        return;
    }

    const video = document.createElement('video');
    Object.assign(video, {
        muted: true,
        loop: true,
        playsInline: true,
        autoplay: true
    });
    video.className = 'background-hero-video';

    videoSources.forEach(({ url, type }) => {
        const source = document.createElement('source');
        Object.assign(source, { src: url, type });
        video.appendChild(source);
    });

    targetDiv.appendChild(video);

    if (typeof onInsertCallback === 'function') {
        onInsertCallback(video);
    }
}

function enableParallaxEffect(videoElement) {
    const maxOffset = 80;
    let targetOffset = 0;
    let currentOffset = 0;

    videoElement.style.willChange = 'transform';

    window.addEventListener('scroll', () => {
        targetOffset = Math.min(window.scrollY * 0.1, maxOffset);
    });

    function animate() {
        currentOffset += (targetOffset - currentOffset) * 0.02;
        videoElement.style.transform = `translate3d(0, ${currentOffset.toFixed(2)}px, 0)`;
        requestAnimationFrame(animate);
    }

    animate();
}

document.addEventListener('DOMContentLoaded', () => {
    insertBackgroundVideo('hero-with-placeholder', [
        { url: 'https://assets.mimecast.com/api/public/content/aa4cdf7a557b41e3b79b5aa58372336d?v=3fb51f02', type: 'video/webm' },
        { url: 'https://assets.mimecast.com/api/public/content/0212b5711b324f7bb2370ce2aaba4c88?v=50df34ae', type: 'video/mp4' }
    ], (videoEl) => {
        const isChrome = /Chrome/.test(navigator.userAgent) && /Google Inc/.test(navigator.vendor);
        const isDesktop = window.innerWidth >= 1024;

        // 🔁 Optional: Comment this out to disable parallax
        if (isDesktop && isChrome) {
            enableParallaxEffect(videoEl);
        }
    });
});
</script>


<script>
// 1. Load GSAP + ScrollTrigger
var script1 = document.createElement("script");
script1.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js";
document.head.appendChild(script1);

var script2 = document.createElement("script");
script2.src = "https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js";
document.head.appendChild(script2);

// 2. Wait for GSAP to be ready
function waitForGSAP(callback) {
  var interval = setInterval(function () {
    if (window.gsap && window.ScrollTrigger) {
      clearInterval(interval);
      gsap.registerPlugin(ScrollTrigger);
      callback();
    }
  }, 50);
}

// 3. Wait for HTML to exist
function waitForElement(selector, callback, intervalTime, timeout) {
  var elapsedTime = 0;
  var interval = setInterval(function () {
    var el = document.querySelector(selector);
    if (el) {
      clearInterval(interval);
      callback(el);
    } else if ((elapsedTime += intervalTime) >= timeout) {
      clearInterval(interval);
    }
  }, intervalTime);
}

// 4. Wrap characters, preserving highlight structure
function wrapLettersPreservingHighlights(selector) {
  var container = document.querySelector(selector);
  if (!container) return;

  function wrapCharsInNode(node) {
    if (node.nodeType === Node.TEXT_NODE) {
      var text = node.textContent;
      var fragment = document.createDocumentFragment();
      for (var i = 0; i < text.length; i++) {
        var char = text[i];
        var safeChar = char === " " ? "\u00A0" : char;
        var span = document.createElement("span");
        span.className = "char";
        span.textContent = safeChar;
        fragment.appendChild(span);
      }
      return fragment;
    }

    if (node.nodeType === Node.ELEMENT_NODE) {
      var clone = node.cloneNode(false);
      node.childNodes.forEach(function (child) {
        clone.appendChild(wrapCharsInNode(child));
      });

      if (node.classList.contains("highlight-words")) {
        var bg = document.createElement("span");
        bg.className = "highlight-bg";
        clone.insertBefore(bg, clone.firstChild);
      }

      return clone;
    }

    return document.createTextNode("");
  }

  var originalNodes = Array.from(container.childNodes);
  container.innerHTML = "";
  originalNodes.forEach(function (node) {
    container.appendChild(wrapCharsInNode(node));
  });
}

// 5. Run everything (desktop-only)
if (window.innerWidth > 768) {
  waitForGSAP(function () {
    waitForElement(".text-animation-highlight", function () {
      wrapLettersPreservingHighlights(".text-animation-highlight");

      const allChars = gsap.utils.toArray(".char");

      // Animate background image separately
      gsap.to(".text-animation-highlight-column-container", {
        backgroundPositionX: "100%",
        ease: "none",
        scrollTrigger: {
          trigger: ".text-animation-highlight-column-container",
          start: "top bottom",
          end: "bottom top",
          scrub: true
        }
      });

      // Main scroll-linked timeline
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: ".text-animation-highlight",
          start: "top center+=300",
          end: "+=500",
          scrub: true
        }
      });

      let currentIndex = 0;

      document.querySelectorAll(".highlight-words").forEach((highlightEl, i) => {
        const chars = highlightEl.querySelectorAll(".char");
        const startIndex = allChars.indexOf(chars[0]);
        const endIndex = allChars.indexOf(chars[chars.length - 1]);

        const before = allChars.slice(currentIndex, startIndex);
        const after = allChars.slice(endIndex + 1);
        currentIndex = endIndex + 1;

        // 1. Animate characters before this highlight
        tl.to(before, {
          color: "#000129",
          stagger: {
            each: 0.03,
            from: "start"
          }
        }, `start-${i}`);

        // 2. Animate highlight
        tl.addLabel(`highlight-${i}`);
        tl.fromTo(highlightEl.querySelector(".highlight-bg"),
          { scaleX: 0, transformOrigin: "left" },
          { scaleX: 1, ease: "none" },
          `highlight-${i}`
        );

        tl.to(chars, {
          color: "#FFFFFF",
          stagger: {
            each: 0.03,
            from: "start"
          }
        }, `highlight-${i}`);
      });

      // 3. Animate all remaining characters after final highlight
      const remaining = allChars.slice(currentIndex);
      tl.to(remaining, {
        color: "#000129",
        stagger: {
          each: 0.03,
          from: "start"
        }
      }, "end");
    }, 100, 5000);
  });
}
</script>

    
