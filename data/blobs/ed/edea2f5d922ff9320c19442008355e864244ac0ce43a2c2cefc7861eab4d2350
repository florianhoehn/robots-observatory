<!DOCTYPE html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="Content-Language" content="ru_RU">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <meta name="description" content="Профи.ру">
  <style>
	  html {
		  font-family: -apple-system, BlinkMacSystemFont, Roboto, Arial, sans-serif;
	  }

	  html, body {
      width: 100%;
      height: 100%;
		  margin: 0;
      padding: 0;
	  }

    .page {
      display: flex;
      flex-direction: column;
      min-height: 100%;
      color: #333;
    }

    .container {
	    margin: 0 auto;
	    padding: 0 20px;
	    box-sizing: border-box;
    }

    .header {
      display: flex;
      align-items: center;
	    justify-content: center;
      width: 100%;
      height: 60px;
    }

    .header__logo {
	    width: 156px;
	    height: 30px;
      background: url("data:image/svg+xml;base64,");
	    background-size: 156px 30px;
    }

    .content {
      width: 100%;
      flex: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .title {
      margin-top: 25px;
	    font-size: 22px;
	    font-style: normal;
	    font-weight: 600;
	    line-height: 26px;
	    letter-spacing: 0.352px;
    }

    .description {
	    margin-top: 10px;
	    font-size: 15px;
	    font-style: normal;
	    font-weight: 400;
	    line-height: 20px;
	    letter-spacing: -0.24px;
    }

    .title, .description {
      text-align: center;
    }

    .button {
      margin-top: 25px;
	    padding: 10px 15px;
	    border-radius: 9px;
	    background: #333;
	    color: #FFF;
	    font-size: 15px;
	    font-style: normal;
	    font-weight: 600;
	    line-height: 20px;
	    letter-spacing: -0.24px;
      cursor: pointer;
      text-decoration: none;
    }

	  @media (min-width: 732px) {
		  .container {
			  max-width: 1020px;
			  padding: 0 30px;
		  }

      .header {
	      justify-content: flex-start;
      }

		  .description {
			  font-size: 17px;
			  line-height: 22px;
		  }
	  }
  </style>
</head>
<body>
<div class="page">
  <header class="header container">
    <a class="header__link" href="/">
      <div class="header__logo"></div>
    </a>
  </header>
  <main class="content container">
    <picture>
      <source
        srcSet="https://cdn.profi.ru/profi-front-web/error-page-image/tv-1x.webp 1x, https://cdn.profi.ru/profi-front-web/error-page-image/tv-2x.webp 2x"
        type="image/webp"
      />
      <img
        src="https://cdn.profi.ru/profi-front-web/error-page-image/tv-1x.png"
        srcSet="https://cdn.profi.ru/profi-front-web/error-page-image/tv-1x.png 1x, https://cdn.profi.ru/profi-front-web/error-page-image/tv-2x.png 2x"
        alt="Oops"
        width="125"
        height="152"
      />
    </picture>
    <div class="title">Страница не найдена</div>
    <div class="description">
      Но&nbsp;специалиста мы&nbsp;вам наверняка найдем
    </div>
    <a href="/" class="button">На главную</a>
  </main>
</div>
</body>
