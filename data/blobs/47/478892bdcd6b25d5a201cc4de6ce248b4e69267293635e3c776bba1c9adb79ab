    article,
    aside,
    details,
    figcaption,
    figure,
    footer,
    header,
    hgroup,
    menu,
    nav,
    section {
      display: block
    }

    body {
      line-height: 1
    }

    ol,
    ul {
      list-style: none
    }

    blockquote,
    q {
      quotes: none
    }

    blockquote:before,
    blockquote:after,
    q:before,
    q:after {
      content: '';
      content: none
    }

    table {
      border-collapse: collapse;
      border-spacing: 0
    }
  </style>
  <style>
    @charset "utf-8";

    /* CSS Document */
    body {
      font-family: "Lato";
      font-size: 16px;
      color: #000;
    }

    a {
      color: rgba(0, 140, 255);
    }

    a:hover,
    a:focus {
      text-decoration: none;
      color: rgba(0, 140, 255);
      outline: none;
    }

    p {
      margin: 0px;
    }

    /* Layout */
    .wrapper {
      display: flex;
      flex-direction: column;
      -webkit-backdrop-filter: blur(14px);
      backdrop-filter: blur(14px);
      background-color: rgba(25, 88, 182, 0.92);
      height: 100vh;
      overflow: auto;
      align-items: center;
      justify-content: center;
    }

    header {
      display: flex;
      justify-content: center;
      margin: 100px 0 30px 0;
    }

    .contentPopUp {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 43px 43px 50px;
      width: 893px;
      border-radius: 20px;
      background-color: #1650a5;
      color: #fff;
    }

    .contentPopInner {
      width: 650px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      background: url("data:image/png;base64,") no-repeat center 0;
      background-position-x: center;
      background-size: 140px auto;
    }

    .contentPopUp h2 {
      font-size: 36px;
      line-height: 43px;
      text-align: center;
      font-weight: bold;
      margin-bottom: 25px;
      font-family: "QuickSand";
      margin-top: 74px;
    }

    .contentPopUp a {
      width: 306px;
      border-radius: 8px;
      background: #ff6d38;
      border: none;
      outline: none;
      color: #fff;
      font-size: 18px;
      font-weight: bold;
      text-decoration: none;
      text-transform: uppercase;
      font-family: "QuickSand";
      padding: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .infoText {
      font-size: 16px;
      line-height: 22px;
      margin-bottom: 24px;
      font-family: "HelveticaNeue";
    }

    .infoText span {
      font-weight: bold;
    }

    .subInfoText {
      font-size: 16px;
      line-height: 22px;
      font-weight: bold;
      margin-bottom: 40px;
      font-family: "HelveticaNeue";
    }

    .footText {
      font-size: 12px;
      line-height: 16px;
      font-family: "Roboto";
    }

    .contentPopContact {
      font-size: 22px !important;
      font-weight: 900;
      line-height: 1.09;
      font-family: "QuickSand";
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="contentPopUp">
      <div class="contentPopInner">
        <h2>Temporarily unavailable<br/> for users in your region</h2>
        <p class="infoText">
          Goibibo is temporarily unavailable for users in your region at the moment. We apologise for the inconvenience, and intend to resume our services soon. Thank you for your patience.
        </p>
        <p class="subInfoText">
          In case you have any queries about your existing or ongoing bookings made on Goibibo, kindly reach out to us here. (ContactUs@goibibo.com)
        </p>
        <p class="contentPopContact">Call Us @ +91-124-6280407</p>
      </div>
    </div>
  </div>
</body>

</html>
