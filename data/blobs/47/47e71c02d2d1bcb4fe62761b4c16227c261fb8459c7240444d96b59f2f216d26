  (() => {
    if (document.documentElement.dataset.novelBeta !== "1") {
      document.querySelector("[data-content-bookmarks-link]")?.setAttribute("href", "/bookmarks");
      return;
    }

    const mode = document.documentElement.dataset.contentMode === "novels" ? "novels" : "comics";
    const setModeLinkState = (link, active) => {
      if (!link) return;
      link.classList.toggle("bg-white/15", active);
      link.classList.toggle("text-white", active);
      link.classList.toggle("text-white/90", !active);
      link.classList.toggle("hover:bg-white/10", !active);
      link.classList.toggle("hover:text-white", !active);
    };

    const comicsLink = document.querySelector('[data-content-mode-link="comics"]');
    const novelsLink = document.querySelector('[data-content-mode-link="novels"]');
    // Never selected. The link already relabels itself "Home" for the current
    // mode, so a highlight on top of that just read as Home being a permanently
    // selected tab. Passing false also clears the state from cached markup.
    setModeLinkState(comicsLink, false);
    setModeLinkState(novelsLink, false);

    if (comicsLink && novelsLink) {
      comicsLink.textContent = mode === "comics" ? "Home" : "Comics";
      novelsLink.textContent = mode === "novels" ? "Home" : "Novels";

      // The hrefs need correcting here too, not just the labels. This markup is
      // share-cached, so a page rendered for one mode can be read in the other,
      // and the server-side href would then belong to the wrong link.
      //
      // Mirrors contentModeSwitchHref; this script is inline and cannot import
      // it, so the two must be kept in step.
      const switchHref = (target) => {
        const p = window.location.pathname;
        if (p === "/bookmarks" || p.startsWith("/bookmarks/")) return "/bookmarks/" + target;
        if (p === "/browse" || p.startsWith("/browse/")) return "/browse/" + target;
        return target === "novels" ? "/novels" : "/comics";
      };
      comicsLink.setAttribute("href", mode === "comics" ? "/comics" : switchHref("comics"));
      novelsLink.setAttribute("href", mode === "novels" ? "/novels" : switchHref("novels"));
      comicsLink.style.order = mode === "comics" ? "0" : "1";
      novelsLink.style.order = mode === "novels" ? "0" : "1";
      const activeLink = mode === "novels" ? novelsLink : comicsLink;
      const inactiveLink = mode === "novels" ? comicsLink : novelsLink;
      activeLink.parentElement?.insertBefore(activeLink, inactiveLink);
    }

    document.querySelector("[data-content-bookmarks-link]")?.setAttribute(
      "href",
      mode === "novels" ? "/bookmarks/novels" : "/bookmarks/comics",
    );

    document.querySelector("[data-content-home-link]")?.setAttribute(
      "href",
      mode === "novels" ? "/novels" : "/comics",
    );
    document.querySelector('[data-content-nav-link="browse"]')?.setAttribute(
      "href",
      mode === "novels" ? "/browse/novels" : "/browse/comics",
    );
  })();
</script> <script type="module">var e=document.getElementById(`resources-btn`),t=document.getElementById(`resources-menu`),n=document.getElementById(`resources-chevron`);e&&t&&n&&(e.addEventListener(`click`,e=>{e.stopPropagation(),t.classList.toggle(`touch-open`),n.classList.toggle(`touch-open`)}),document.addEventListener(`click`,()=>{t.classList.remove(`touch-open`),n.classList.remove(`touch-open`)}));</script> <astro-island uid="Zv6mTo" prefix="r17" component-url="/_astro/MigrationBanner.C1O45WrT.js" component-export="d