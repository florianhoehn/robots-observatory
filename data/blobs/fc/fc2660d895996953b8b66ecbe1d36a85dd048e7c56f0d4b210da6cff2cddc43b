<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ATTENTION</title>
<link href="https://cdn-pl.totogaming.ro/cfcustompages/totogamingro/style.css" rel="stylesheet"><link>
<link rel="icon" type="image/x-icon" href="https://cdn-pl.totogaming.ro/cfcustompages/totogamingro/images/attention_sign.png"><link>
</head>
<body>
<div class="mainContainer">
<div class="container">
<div class="SignContainer"></div>
<div class="HeaderTextContainer">ATTENTION!</div>
<div class="messageContainer">
<p>The site is not available in your region.</p>
</div>
<div class="errorDetailsHeader">
<p>ERROR DETAILS</p>
<div class="imgArrow"><img src="https://cdn-pl.totogaming.ro/cfcustompages/totogamingro/images/arrow.png" alt="arrow"></div>
</div>
</div>
<div class="errorDetailsToggleBlock">
<p>Access Denied</p>
<p>IP Address: <span id="ipAddress"></span></p>
<p>Country: <span id="countryName"></span></p>
<script>
async function fillTheTitle() {
const post = await fetch("https://freeipapi.com/api/json").then((res) => res.json());
document.getElementById("ipAddress").innerText = post.ipAddress;
document.getElementById("countryName").innerText = post.countryName;
}
fillTheTitle();
</script>
</div>
</div>
<script>
document.addEventListener("click", (event) => {
if (event.target.tagName === "IMG" || event.target.classList.contains("imgArrow")) {
document.querySelector(".imgArrow").classList.toggle("imgArrowRotate");
document.querySelector(".errorDetailsToggleBlock").classList.toggle("toggleAnimation");
}
})
</script>
</body>
</html>