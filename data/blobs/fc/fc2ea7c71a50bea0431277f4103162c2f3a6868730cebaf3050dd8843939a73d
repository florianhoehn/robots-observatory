/********************
** SPACES 
*********************/
.section{
    padding: 0 40px 80px;
}
.section.hero{
        padding: auto;
    }
@media (min-width:767px){
   /* .section{
        padding: 0 0 80px;
    }*/
    .section.hero{
        padding: auto;
    }
}

/* FIX overflow */
body {
    overflow-x: hidden;
}

/********************
** TEXT 
*********************/
.elementor-heading-title b{
    font-weight: 700;
    color: var( --e-global-color-primary );
}

.bg-dark .elementor-heading-title b{
    color:#fff 
}



/********************
** BACKGROUNDS 
*********************/
.bg-dregradado-1{
    background: rgba(0,0,0,0) linear-gradient(150deg,#7352FF 15%,rgb(185,180,241) 70%) repeat scroll 0 0 !important;
    /*background: radial-gradient(150.89% 111.73% at 10.14% 2.45%, rgba(115, 82, 255, 0.71) 0%, #BF9AEC 61.27%, #E9A1EB 93%), #FFF;*/
}
.bg-dregradado-2{
    background: rgba(0,0,0,0) linear-gradient(150deg,#7352FF 15%,rgb(185,180,241) 70%) repeat scroll 0 0 !important;
    /*background: radial-gradient(150.89% 111.73% at 10.14% 2.45%, rgba(115, 82, 255, 0.71) 0%, #BF9AEC 61.27%, #E9A1EB 93%), #FFF;*/
}


/********************
** CARDS 
*********************/
.card{
    box-shadow: -6px 8px 30px -14px rgba(0, 0, 0, 0.26) !important;
    &:hover{
        box-shadow: 0px -1px 62px -9px rgba(0, 0, 0, 0.14) !important;
    }
    border-radius: 8px !important

}
.card:before{
     background-image: radial-gradient(at top right, #7352FF33 0%, #161136 100%) !important;
     border-radius: 8px !important;
 }
.card-blog,
.card-testimonio,
.card-caso-exito,
.card-archive,
.card-dispatcher{
    
}
