** BUTTONS 
*********************/
.btn-primary{
    &:hover{}
}
.btn-secondary{
    &:hover{}
}
.btn-small{
    &:hover{}
}

.btn-secondary-light{
    &:hover{}
}

.btn-shop{
    &:hover{}
}

.btn-outlined a{
    border: 1px solid #fff !important;
    color: #fff !important;
    padding: 8px 16px 8px 16px !important;
    font-size: var( --e-global-typography-58fb39b-font-size ) !important;
    background-color:transparent !important;
    &:hover{
        background-color: var( --e-global-color-1237499 ) !important;
        color: var( --e-global-color-primary ) !important;
    }
}


