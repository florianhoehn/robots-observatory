            margin-top: 0;
            margin-bottom: 12px;
            font-style: normal;
            font-weight: 500;
            color: #21282B;
        }

        p {
            font-style: normal;
            font-weight: normal;
            font-size: 16px;
            line-height: 24px;
            text-align: center;
            color: #21282B;
        }

        .main-image {
            margin-bottom: 32px;
        }

        .phone {
            font-size: 16px;
            font-weight: 500;
            line-height: 24px;
            color: #21282B;
            display: flex;
            padding: 12px 24px;
            justify-content: center;
            align-items: center;
            transition: .3s;
            border-radius: 120px;
            text-decoration: none;
            &:hover,
            &:active {
                background-color: #d8d4c9;
            }
        }

        @media (min-width: 768px) {
            main {
                padding: 80px 0;
            }
            h1 {
                font-size: 26px;
                font-style: normal;
                line-height: 32px;
            }
            p {
                margin-top: 0;
                margin-bottom: 32px;
            }
        }

        @media (max-width: 767px) {
            main {
                padding: 40px 0;
            }
            body {
                padding-left: 16px;
                padding-right: 16px;
            }

            h1 {
                font-size: 22px;
                font-style: normal;
                line-height: 28px;
            }

            p {
                margin-bottom: 32px;
                margin-top: 0;
            }
        }
    </style>
