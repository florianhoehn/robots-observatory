            height: 100vh;
            width: 100vw;
            display: flex;
            flex-direction: column;
        }

        header {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            flex: 0 1 max-content;
            padding: 16px;
        }


