<!doctype html>
<html lang="en" data-i18n-page="ukBlocked">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title data-i18n="title">Pixhost - Regional Access Notice</title>
  <meta name="description" content="Pixhost is unavailable in the United Kingdom." data-i18n="description" data-i18n-attr="content">
  <script defer src="/js/static-i18n.js"></script>
  <style>
    :root {
      --text: #24252a;
      --muted: #6e7078;
      --background: #f7f7f8;
      --panel: #ffffff;
      --border: #e2e3e7;
      --blue: #263b86;
      --red: #ed3b44;
      --shadow: 0 24px 70px rgba(30, 31, 36, 0.09);
    }

    * {
      box-sizing: border-box;
    }

    body {
      display: grid;
      place-items: center;
      min-height: 100vh;
      margin: 0;
      padding: 24px;
      color: var(--text);
      background:
        radial-gradient(circle at 50% 0, rgba(237, 59, 68, 0.075), transparent 31rem),
        var(--background);
      font-family: "Avenir Next", Avenir, "Segoe UI", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      text-align: center;
    }

    main {
      width: min(700px, 100%);
      padding: clamp(30px, 6vw, 54px);
      border: 1px solid var(--border);
      border-radius: 24px;
      background: var(--panel);
      box-shadow: var(--shadow);
    }

    .wordmark {
      display: inline-flex;
      align-items: baseline;
      direction: ltr;
      margin-bottom: 34px;
      color: #202126;
      font-size: 38px;
      font-weight: 750;
      letter-spacing: -2.8px;
      line-height: 1;
      text-decoration: none;
    }

    .wordmark__host {
      color: var(--red);
    }

    .wordmark:focus-visible {
      outline: 3px solid rgba(237, 59, 68, 0.2);
      outline-offset: 5px;
      border-radius: 4px;
    }

    .flag {
      display: block;
      width: min(380px, 100%);
      height: auto;
      margin: 0 auto 34px;
      border: 1px solid rgba(32, 33, 38, 0.08);
      border-radius: 16px;
      box-shadow: 0 14px 38px rgba(30, 31, 36, 0.14);
    }

    h1 {
      margin: 0;
      font-size: clamp(32px, 7vw, 48px);
      line-height: 1.1;
      letter-spacing: -0.045em;
    }

    p {
      margin: 22px 0 0;
      color: var(--muted);
      font-size: clamp(17px, 3vw, 20px);
      line-height: 1.5;
    }

    @media (max-width: 520px) {
      body { padding: 14px; }
      main { border-radius: 18px; }
      .wordmark { margin-bottom: 28px; font-size: 34px; }
      .flag { margin-bottom: 28px; }
    }
  </style>
</head>
<body>
  <main>
    <a class="wordmark" href="https://pixhost.to/" aria-label="pixhost home" data-i18n="homeAria" data-i18n-attr="aria-label">
      <span class="wordmark__pix">pix</span><span class="wordmark__host">host</span>
    </a>

    <svg class="flag" viewBox="0 0 640 400" role="img" aria-label="United Kingdom flag with a sad face" data-i18n="flagAria" data-i18n-attr="aria-label">
      <defs>
        <clipPath id="flag-shape">
          <rect width="640" height="400" rx="14"/>
        </clipPath>
      </defs>

      <g clip-path="url(#flag-shape)">
        <rect width="640" height="400" fill="var(--blue)"/>

        <path d="M0 0 640 400 M640 0 0 400" stroke="#fff" stroke-width="86"/>
        <path d="M0 0 640 400 M640 0 0 400" stroke="var(--red)" stroke-width="38"/>

        <path d="M320 0V400 M0 200H640" stroke="#fff" stroke-width="116"/>
        <path d="M320 0V400 M0 200H640" stroke="var(--red)" stroke-width="66"/>

        <circle cx="320" cy="200" r="151" fill="#fff" stroke="var(--red)" stroke-width="22"/>
        <circle cx="270" cy="158" r="20" fill="var(--red)"/>
        <circle cx="370" cy="158" r="20" fill="var(--red)"/>
        <path d="M252 275 Q320 190 388 275" fill="none" stroke="var(--red)" stroke-width="19" stroke-linecap="round"/>
      </g>
    </svg>

    <h1 data-i18n="heading">Pixhost is unavailable in the United Kingdom</h1>
    <p data-i18n="message">Pixhost remains available in the rest of the world.</p>
  </main>
</body>
</html>
