er-color:#105F92;color:#fff}.dox-button:hover{background-color:#0E507C;border-color:#0E507C;color:#fff}a[href*="support.doximity.com"]:hover{color:#4A9FD4}.scope-is-mobile-native{background-color:#121212;color:#F2F2F7}.scope-is-mobile-native h1,.scope-is-mobile-native h2,.scope-is-mobile-native h3,.scope-is-mobile-native h4,.scope-is-mobile-native h5,.scope-is-mobile-native h6{color:#F2F2F7}}
