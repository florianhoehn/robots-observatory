  </head>

  <body id="bodyClass">
    <script type="text/javascript">
      let iosAgent = "DoximityWebView";
      let androidAgent = "com.doximity.doximitydroid";
      let element = document.getElementById("bodyClass");

      if (navigator.userAgent === iosAgent || navigator.userAgent === androidAgent) {
        element.classList.add("scope-is-mobile-native");
      }
    </script>

    <main id="wcag-main-content">
      <div class="error-logo">
        <a href="https://doximity.com">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset="https://assets.doxcdn.com/image/upload/fl_sanitize/logos/doximity/logo-doximity-dark-colored-waves.svg">
            <img src="https://assets.doxcdn.com/image/upload/fl_sanitize/logos/doximity/logo-doximity.svg" alt="Doximity" width="160">
          </picture>
        </a>
      </div>
      <div class="row">
        <div class="box">
          <img class="box-image" onerror="this.style.display='none'" alt="" src="https://assets.doxcdn.com/image/upload/fl_sanitize/illustrations/errors/404.svg" />
          <h1>404</h1>
          <p>The page you are looking for does not exist.</p>
          <p>
            <a href="https://support.doximity.com">Need help?</a>
          </p>
          <p class="error-link-return-to-doximity">
            <a href="https://doximity.com" class="dox-button">Return to Doximity</a>
          </p>
        </div>
      </div>
    </main>
  </body>

</html>
