<style id="eapk-arana-colgante-inline-css">

.eapk-arana{--eapk-recorrido:230px;position:fixed;top:-35px;z-index:2147483000;width:32px;height:1px;pointer-events:none;user-select:none;contain:layout style;}
.eapk-arana--derecha{right:clamp(20px,calc(5vw + 8px),78px)}
.eapk-arana--izquierda{left:clamp(12px,5vw,70px)}
.eapk-arana__hilo{position:absolute;top:0;left:15px;width:1px;height:0;background:rgba(255,255,255,.9);animation:eapk-hilo-baja 10s ease-in-out infinite;}
.eapk-arana .eapk-arana__bicho{position:absolute;left:-15px;top:calc(100% - 7px);width:30px;height:30px;display:block;box-sizing:border-box;margin:0;padding:0;border:0;border-radius:0;background:transparent;appearance:none;line-height:0;box-shadow:none;outline-offset:3px;cursor:pointer;touch-action:manipulation;pointer-events:auto;filter:drop-shadow(0 1px 1px rgba(0,0,0,.45));}
.eapk-arana .eapk-arana__bicho:disabled{cursor:default;pointer-events:none;}
.eapk-arana--blanca .eapk-arana__bicho{color:#fff}
.eapk-arana--negra .eapk-arana__bicho{color:#080808;filter:drop-shadow(0 0 1px rgba(255,255,255,.55))}
.eapk-arana__bicho svg{position:absolute;inset:0;display:block;width:30px;height:30px;fill:currentColor;}
.eapk-arana__bicho .eapk-arana__estampada{opacity:0;pointer-events:none;}
@keyframes eapk-hilo-baja{0%,10%,70%,100%{height:0}30%,48%{height:calc(var(--eapk-recorrido) + 42px)}}
.eapk-arana--interaccion .eapk-arana__hilo{animation:none}
.eapk-arana--interaccion .eapk-arana__bicho{pointer-events:none;}
.eapk-arana--caer .eapk-arana__hilo,.eapk-arana--aplastar .eapk-arana__hilo{background:transparent;}
.eapk-arana--caer .eapk-arana__bicho{will-change:transform;animation:eapk-caer 1s cubic-bezier(.40,.02,.83,.94) both;}
@keyframes eapk-caer{0%{transform:translate3d(0,0,0) rotate(0)}13%{transform:translate3d(6px,-8px,0) rotate(-14deg)}100%{transform:translate3d(16px,var(--eapk-caida),0) rotate(160deg)}}
/* El aplastamiento se ve DE FRENTE contra el cristal: silueta extendida,
   no comprimida verticalmente como si algo la pisara desde arriba. */
.eapk-arana--aplastar .eapk-arana__bicho{will-change:transform;transform-origin:50% 50%;animation:eapk-cristal-golpe .44s cubic-bezier(.18,.9,.22,1) both;}
.eapk-arana--aplastar .eapk-arana__normal{animation:eapk-cristal-original .19s step-end forwards;}
.eapk-arana--aplastar .eapk-arana__estampada{animation:eapk-cristal-estampada .44s cubic-bezier(.22,1,.36,1) both;}
@keyframes eapk-cristal-golpe{0%{transform:translate3d(0,0,0) scale(1)}23%{transform:translate3d(0,-3px,0) scale(.94)}48%{transform:translate3d(0,0,0) scale(1.62)}72%{transform:translate3d(0,0,0) scale(1.36)}100%{transform:translate3d(0,0,0) scale(1.44)}}
@keyframes eapk-cristal-original{0%,99%{opacity:1}100%{opacity:0}}
@keyframes eapk-cristal-estampada{0%,39%{opacity:0;transform:scale(.85) rotate(-5deg)}50%{opacity:1;transform:scale(1.1) rotate(-5deg)}75%{opacity:1;transform:scale(.98) rotate(-5deg)}100%{opacity:1;transform:scale(1) rotate(-5deg)}}
.eapk-arana--subir .eapk-arana__hilo{transition:height .48s cubic-bezier(.58,.04,.95,.83)}
.eapk-arana--oculta .eapk-arana__hilo{background:transparent;}
.eapk-arana--oculta .eapk-arana__bicho{opacity:0;pointer-events:none;}

/* Tres sorpresas nuevas. Sin recursos externos, canvas ni librerías. */
.eapk-arana--telarana .eapk-arana__bicho{animation:eapk-arana-escapa .75s ease-in-out both;}
@keyframes eapk-arana-escapa{0%,100%{transform:rotate(0)}22%{transform:rotate(-26deg)}47%{transform:rotate(17deg)}71%{transform:rotate(-12deg)}}
.eapk-arana--dramatica .eapk-arana__bicho{transform-origin:50% 4%;animation:eapk-arana-pendulo 1.50s ease-in-out both;}
@keyframes eapk-arana-pendulo{0%{transform:rotate(0)}18%{transform:rotate(-32deg)}38%{transform:rotate(20deg)}58%{transform:rotate(-12deg)}80%,100%{transform:rotate(0)}}
.eapk-arana--aplastar_xl .eapk-arana__hilo{background:transparent}
.eapk-arana--aplastar_xl .eapk-arana__bicho{transform-origin:50% 50%;animation:eapk-arana-golpe-xl .50s cubic-bezier(.16,.86,.23,1) both;}
.eapk-arana--aplastar_xl .eapk-arana__normal{animation:eapk-cristal-original .18s step-end forwards;}
.eapk-arana--aplastar_xl .eapk-arana__estampada{animation:eapk-cristal-estampada .50s cubic-bezier(.22,1,.36,1) both;}
/* Mancha de sangre de verdad: silueta orgánica roja (sin grietas ni líneas de cristal).
   El SVG queda detrás del cuerpo, ambos permanecen pegados hasta recargar la página. */
.eapk-arana__bicho .eapk-arana__salpicadura{position:absolute;inset:-19px;width:68px;height:68px;opacity:0;pointer-events:none;z-index:0;overflow:visible;filter:drop-shadow(0 1px 1px rgba(55,0,0,.28));}
.eapk-arana__bicho .eapk-arana__normal,.eapk-arana__bicho .eapk-arana__estampada{z-index:1;}
.eapk-arana__salpicadura .eapk-arana__sangre-sombra{fill:#650a12;opacity:.75}
.eapk-arana__salpicadura .eapk-arana__sangre{fill:#bd171d}
.eapk-arana__salpicadura .eapk-arana__sangre-gotas{fill:#a80e17}
.eapk-arana__salpicadura .eapk-arana__sangre-luz{fill:#f75c62;opacity:.42}
.eapk-arana--aplastar .eapk-arana__salpicadura{animation:eapk-arana-splash .44s cubic-bezier(.16,.82,.28,1) both;}
.eapk-arana--aplastar_xl .eapk-arana__salpicadura{animation:eapk-arana-splash .50s cubic-bezier(.16,.82,.28,1) both;}
@keyframes eapk-arana-golpe-xl{0%{transform:scale(1)}22%{transform:scale(.86)}45%{transform:scale(2.16,1.82) rotate(-10deg)}70%{transform:scale(1.58,1.28) rotate(-9deg)}100%{transform:scale(1.68,1.38) rotate(-9deg)}}
@keyframes eapk-arana-splash{0%,30%{opacity:0;transform:scale(.18) rotate(-9deg)}53%{opacity:1;transform:scale(1.24) rotate(4deg)}76%{opacity:.98;transform:scale(.94) rotate(-2deg)}100%{opacity:.98;transform:scale(1) rotate(0deg)}}
/* El primer SVG conserva íntegro el dibujo de sangre de v1.2.1.
   El segundo ocupa exactamente su lugar: sin imágenes nuevas ni otra araña. */
.eapk-arana__bicho .eapk-arana__salpicadura--2{display:none;}
.eapk-arana--splash2 .eapk-arana__bicho .eapk-arana__salpicadura--1{display:none;}
.eapk-arana--splash2 .eapk-arana__bicho .eapk-arana__salpicadura--2{display:block;}
/* Un soporte fijo fuera del hilo congela el impacto en coordenadas del viewport.
   Su escala, solo cerca de los bordes, no cambia el centro de la araña. */
.eapk-arana.eapk-arana__impacto-fijo{position:fixed;right:auto;top:0;width:30px;height:30px;contain:none;pointer-events:none;overflow:visible;}
.eapk-arana__impacto-escala{position:absolute;left:0;top:0;width:30px;height:30px;transform-origin:center center;transform:scale(var(--eapk-escala-borde,1));pointer-events:none;}
.eapk-arana__impacto-fijo .eapk-arana__bicho{left:0;top:0;pointer-events:none;cursor:default;}
.eapk-arana--aplastada-fija .eapk-arana__hilo{background:transparent;}
.eapk-arana--aplastada-fija .eapk-arana__bicho{visibility:hidden;pointer-events:none;}
.eapk-arana__disparo{position:fixed;z-index:2147483000;width:120px;height:120px;pointer-events:none;transform:translate(-50%,-50%);animation:eapk-arana-red .96s ease-out forwards;will-change:transform,opacity;}
.eapk-arana__disparo svg{display:block;width:100%;height:100%;fill:none;stroke:rgba(255,255,255,.9);stroke-width:1.65;filter:drop-shadow(0 1px 2px rgba(0,0,0,.6));}
@keyframes eapk-arana-red{0%{opacity:0;transform:translate(-50%,-50%) scale(.16) rotate(-14deg)}22%{opacity:1;transform:translate(-50%,-50%) scale(1.06) rotate(4deg)}72%{opacity:.94;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-50%) scale(1.07)}}
@media(max-width:600px){.eapk-arana{--eapk-recorrido:155px}.eapk-arana__disparo{width:96px;height:96px}}
@media(prefers-reduced-motion:reduce){.eapk-arana{display:none}}

