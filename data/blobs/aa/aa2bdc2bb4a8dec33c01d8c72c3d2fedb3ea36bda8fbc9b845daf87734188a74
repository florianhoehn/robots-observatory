            function displayTitleOptions(responseText) {
              const titleOptionsDiv = document.getElementById('titleOptions');
              titleOptionsDiv.innerHTML = '';

              console.log("Parsing response:", responseText);

              const rejectionKeywords = [
                'safe', 'harmless', 'cannot', 'restricted', 'inappropriate',
                'violation', 'policy', 'content', 'filter', 'blocked',
                'not allowed', 'prohibited', 'explicit'
              ];
