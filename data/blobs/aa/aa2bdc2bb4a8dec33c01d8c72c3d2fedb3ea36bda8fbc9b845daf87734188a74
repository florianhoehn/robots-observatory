              const isRejection = rejectionKeywords.some(keyword => lowerResponse.includes(keyword)) && lowerResponse.length < 150;

              if (isRejection) {
                titleOptionsDiv.innerHTML = '<p class="text-warning">Sorry please try again.</p>';
