    <script>
(function () {
    if (window.enviarMarcaVideoatencion) {
        return;
    }

    /**
     * Misma línea que SvlpComponentTramitesAvailable / SvlpComponent2hTextUrlImageHorario:
     * window.ga('send', 'event', categoría, acción, etiqueta) y gtag para GA4.
     */
    window.enviarMarcaVideoatencion = function (marca, etiqueta, categoria) {
        categoria = categoria || 'Landing sucursal virtual';
        etiqueta = etiqueta || '';

        if (typeof window.gtag === 'function') {
            window.gtag('event', marca, {
                event_category: categoria,
                event_label: etiqueta,
                origin_url: window.location.href
            });
        }

        if (typeof window.ga === 'function') {
            window.ga('send', 'event', categoria, marca, etiqueta);
        }
    };

    window.videoatencionClicNav = function (enlace) {
        var destino = enlace && enlace.href ? enlace.href : '';
        window.enviarMarcaVideoatencion('clic_videoatencion', destino, 'Videoatencion');
    };

    window.videoatencionMarcaIniciarLanding = function (tramiteId, tramiteNombre, destino) {
        var marcas = window.VIDEOATENCION_MARCAS_GA4 || {};
        var marca = marcas[String(tramiteId)] || 'videoatencion_iniciar_tramite';

        var etiqueta = 'Tramite - ID ' + tramiteId + ' - ' + tramiteNombre;
        window.enviarMarcaVideoatencion(marca, etiqueta, 'Landing sucursal virtual');
    };

    /**
     * Respaldo GTM/GA4 en onclick (entornos Vite o si el listener del stack corre tarde).
     * En Mix/chileatiende el addEventListener del landing también puede marcar; el botón usa solo onclick
     * para no duplicar eventos.
     */
    window.videoatencionClickIniciarLanding = function (event) {
        var destinos = window.VIDEOATENCION_DESTINOS || {};
        var select = document.getElementById('opcion-videoatencion');
        if (!select || select.selectedIndex < 0) {
            return true;
        }
        var tramiteId = select.value;
        var tramiteNombre = select.options[select.selectedIndex].text;
        var destino = destinos[tramiteId];
        if (!tramiteId || !destino) {
            if (event && event.preventDefault) {
                event.preventDefault();
            }
            return false;
        }
        if (event && event.preventDefault) {
            event.preventDefault();
        }
        if (typeof window.videoatencionMarcaIniciarLanding === 'function') {
            window.videoatencionMarcaIniciarLanding(tramiteId, tramiteNombre, destino);
        }
        window.setTimeout(function () {
            window.location.href = destino;
        }, 150);
        return false;
    };
})();
</script>
