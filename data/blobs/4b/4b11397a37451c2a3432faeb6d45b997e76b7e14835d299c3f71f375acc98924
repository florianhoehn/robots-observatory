    background: #146aff;
    color: white;
    border-bottom: 4px solid #004cc9;
    margin: 20px 0 0;
    transition: .5s all;
  }
  
  .button.primary:hover {
    background: #004cc9;
  }
  
  .button.secondary {
    background: white;
    color: #146aff;
    border: 1px solid #146aff;
    border-bottom: 4px solid #146aff;
    margin: 15px 0 0;
    transition: .5s all;
  }
  
  .button.secondary:hover {
    background: #d4f0ff;
  }
  
  p {
    margin: 0;
  }
  
