<!DOCTYPE html>
<html  dir="ltr"
	   class="ltr-style"
	   lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width">
	<meta http-equiv="X-UA-Compatible" content="ie=edge">
	<meta name="apple-itunes-app" content="app-id=443369807">
	<title>404 Page not found</title>
	<link rel="chrome-webstore-item" href="https://chrome.google.com/webstore/detail/nlbejmccbhkncgokjcmghpfloaajcffj">
	<link href="https://fonts.googleapis.com/css?family=Work+Sans:200,300,400,500,600,700,900&amp;subset=latin-ext"
		  rel="stylesheet">
	<style type="text/css">
		.header-error {
			padding: 30px;
			text-align: center
		}

		.content-error {
			padding: 20px 0;
			position: relative
		}

		.content-error__wrapper {
			padding: 0 30px
		}

		.content-error__img-placeholder {
			margin: 0 auto 15px;
			text-align: center;
			position: relative
		}

		.content-error__img-placeholder::before {
			background: url('/img/left-404.svg') no-repeat;
			content: '';
			display: none;
			left: -120px;
			position: absolute;
			width: 109px;
			height: 117px;
			top: 0
		}

		.content-error__text {
			position: relative
		}

		.content-error__text::after {
			background: url('/img/right-404.svg') no-repeat;
			content: '';
			display: none;
			position: absolute;
			right: -247px;
			width: 247px;
			height: 122px;
			top: 20px
		}

		.content-error__text h1 {
			color: #000;
			font-size: 7.5rem;
			font-weight: 400;
			line-height: 1.175;
			margin: 0;
			padding: 0;
			text-align: center
		}

		.content-error__text h2 {
			color: #000;
			font-size: 1.5rem;
			font-weight: 400;
			line-height: 1.166666;
			margin: 0 0 30px;
			text-align: center
		}

		.content-error__text p {
			color: #424859;
			font-size: 1rem;
			line-height: 1.75;
			margin: 0;
			padding: 0;
			text-align: center
		}

		.content-error__text a {
			color: #2fa6f8
		}

		.content-error__description {
			display: none
		}

		.content-error img {
			max-width: 100%
		}
	</style>
	<link rel="stylesheet" href="/css/common.css">
	<script type="text/javascript" src="https://www.hotspotshield.com/js/gpr.min.js"></script>
<script type="text/javascript">
    window.dataLayer = window.dataLayer || [];

            dataLayer.push({
            'sift_user_id': '0',
            'sift_session_id': 'srv6ad671233bb465.87371668'
        });
    
            dataLayer.push({
            'gaDimensionCountry': 'GB',
            'gaDimensionUserStatus': 'Unknown',
            'gaDimensionConnectionStatus': 'no',
                });
    
            var linkerParam = null;
        var relocation = function(href) {
            ga(function() {
                linkerParam = ga.getAll()[0].get('linkerParam');
            });

            relocationURL = href;
            if (linkerParam) {
                if (relocationURL.indexOf('?') !== -1) {
                    relocationURL += '&';
                } else {
                    relocationURL += '?';
                }
                relocationURL += linkerParam;
            }

            if (window.hss_delay_redirect !== undefined) {
                setTimeout(function() {window.location = relocationURL;}, 500);
            } else {
                window.location = relocationURL;
            }
        }
    
    var reportTracking = function(category, action, label, value) {
        dataLayer.push({
            'event': 'gaTriggerEvent',
            'gaEventCategory': category ? category : '',
            'gaEventAction': action ? action : '',
            'gaEventLabel': label ? label : '',
            'gaEventValue': value ? value : ''
        });
    }
</script>
</head>
<body>
<header class="header-error">
	<div class="header-error__wrapper">
		<div class="logo"><a href="/" class="logo__link"><img src="/img/logo.svg"></a></div>
	</div>
</header>
<main class="content-error">
	<div class="content-error__wrapper">
		<div class="content-error__img-placeholder">
			<img src="/img/404-logo.png" srcset="/img/404-logo@2x.png 2x" alt="Something went wrong">
		</div>
		<div class="content-error__text"><h1>404</h1>
			<h2>Page Not Found</h2>
			<div class="content-error__description">The link you clicked may be broken or the page may have been removed.</div>
			<p>Visit the <a href="/">Homepage</a> or <a href="https://support.hotspotshield.com/hc/en-us">Help Center</a> about the problem.</p>
		</div>
	</div>
</main>
</body>
</html>
