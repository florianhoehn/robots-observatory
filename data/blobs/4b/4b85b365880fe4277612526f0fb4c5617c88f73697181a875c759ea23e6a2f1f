  <style>
    *, *::before, *::after { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: "Market Sans", Arial, sans-serif;
      color: #191919;
      background: #fff;
    }

    /* Keep the SSI-included global header/footer flowing correctly and let the
       error content grow so the footer stays at the bottom. */
    .main-content { flex: 1 0 auto; }
    .global-footer { flex-shrink: 0; }

    /* Constrain the global header/footer content to eBay's centered column so
       they align with the error band (ref: error-XI8ntdtO.css). */
    .global-header { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
    .global-footer #glbfooter { max-width: 1280px; margin: 0 auto; border: 0; }

    /* Error page — reproduces eBay's error-header-v2 component
       (ref: https://www.ebay.com/n/error). */
    .error-page-v2 { max-width: 1280px; margin: 0 auto; }

    .error-header-v2 {
      display: flex;
      align-items: center;
      height: 360px;
      padding-left: 133px;
      padding-right: 16px;
      background: #f7f7f7;
      overflow: hidden;
    }

    .error-header-v2__content { flex: 1; min-width: 0; max-width: 494px; }

    .error-header-v2__title {
      margin: 0;
      color: #191919;
      font-size: 2.25rem;
      font-weight: 700;
      line-height: 1.28;
      word-wrap: break-word;
    }

    .error-header-v2__sub-title {
      margin: 0;
      padding-top: 12px;
      color: #191919;
      font-size: 1.25rem;
      font-weight: 400;
      line-height: 1.4;
      word-wrap: break-word;
    }
    .error-header-v2__sub-title a { color: #3665F3; text-decoration: underline; }

    .error-header-v2__faux-btn a.fake-btn {
      display: inline-block;
      margin-top: 24px;
      padding: 11px 17px 10px;
      min-width: 88px;
      min-height: 40px;
      background: #191919;
      border: 1px solid;
      border-radius: 32px;
      color: #fff;
      font-size: .875rem;
      font-weight: 700;
      line-height: 1.25;
      text-decoration: none;
    }

    .error-header-v2__image {
      display: flex;
      justify-content: center;
      padding-left: 133px;
    }
    .error-header-v2__image img { width: 203px; height: 243px; }

    @media screen and (max-width: 620px) {
      .error-header-v2 {
        display: block;
        width: auto;
        height: auto;
        padding: 24px 16px 16px 16px;
      }
      .error-header-v2__content { width: 100%; padding-left: 0; padding-right: 0; }
      .error-header-v2__title { font-size: 1.875rem; line-height: 1.13; }
      .error-header-v2__sub-title { font-size: .875rem; }
      .error-header-v2__faux-btn a.fake-btn { margin-top: 16px; }
      .error-header-v2__image { margin-top: 16px; padding-left: 0; }
      .error-header-v2__image img { width: 177px; height: 211px; }
    }
  </style>
