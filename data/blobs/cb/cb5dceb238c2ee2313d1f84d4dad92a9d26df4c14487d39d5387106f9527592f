<script>
(function () {
window.VWO = window.VWO || [];
window.VWO.init = window.VWO.init || function (state) {
  window.VWO.consentState = state;
};

var requiredCategory = 'marketing';

async function updateConsent() {
  const services = window.UC_UI?.getServicesBaseInfo?.();
  var consentMode = 0;

  if (!services) return window.VWO.init(2);

  async function getStatus(a_services) {
    var consentMode = 0;

    try {
      const services = await a_services;
      const relevant = services.filter(s => s.categorySlug === requiredCategory);
      // console.log('relevant', relevant);

      if (!relevant.length) {
        consentMode = 3;
      }

      const statuses = relevant.map(s => s.consent?.status);

      // console.log('statuses', statuses);

      if (statuses.every(s => typeof s !== 'boolean')) {
        // console.log('not relevant 2');
        consentMode = 2;
      }

      const incTrue = statuses.includes(true);

      // console.log('incTrue', incTrue);

      const consentMode = incTrue ? 1 : 3;

      return consentMode;
    } catch (error) {
      console.log("can't get UC services", error);
      return consentMode;
    }
  }

  consentMode = await getStatus(services);
  console.log('consentMode', consentMode);
  result = window.VWO.init(consentMode ? consentMode : 3);

  // console.log('updateConsent function ends', result);

  return result;

}

window.addEventListener('UC_UI_INITIALIZED', updateConsent);
window.addEventListener('UC_UI_CMP_EVENT', updateConsent);
})();
</script>

