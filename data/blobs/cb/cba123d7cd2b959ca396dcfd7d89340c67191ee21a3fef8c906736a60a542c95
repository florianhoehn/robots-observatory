    .subscribe-newsletter-v1-container h3 {
        text-align: center;
        margin-bottom: 20px !important;
    }
    .subscribe-newsletter-v1-vertical .subscribe-newsletter-v1-row h3 {
        text-align: center;
        margin-bottom: 24px !important;
    }

    .subscribe-newsletter-v1-container form {
