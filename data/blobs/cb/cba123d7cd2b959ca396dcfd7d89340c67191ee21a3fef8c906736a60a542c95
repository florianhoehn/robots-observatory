    display: flex;
    flex-direction: column;
    margin-bottom: 10px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--space-10);
}

.faq-section-v1-single-item-container .title-section {
    display: flex;
    align-items: center;
    padding: 10px 10px 10px 16px;
    cursor: pointer;
}

