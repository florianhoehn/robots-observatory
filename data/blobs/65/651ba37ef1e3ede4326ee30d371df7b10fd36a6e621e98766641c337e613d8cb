              </div>
              <div class="desc">Oops! We can't find the page <br/>you're looking for. </div> 
              <a href="https://www.moomoo.com/" class="btn">Take me home</a>
            </div>
          </div>
        </div>
        <div class="footer">Services by Moomoo Technologies Inc.</div>
      </div>
    </div>
  </div>
  <script>
    // 多语言配置
    var i18n = {
      'zh-cn': {
        message: '页面不存在',
        desc: '这里什么也没有，去别的地方看看吧！',
        btn: '返回主页',
        homeLink: 'https://www.moomoo.com/'
      },
      'zh-hk': {
        message: '頁面不存在',
        desc: '這裡什麼也沒有，去別的地方看看吧！',
        btn: '返回主頁',
        homeLink: 'https://www.moomoo.com/'
      },
      'en-us': {
        message: 'Page Not Found',
        desc: `Oops! We can't find the page <br/>you're looking for.`,
        btn: 'Take me home',
        homeLink: 'https://www.moomoo.com/'
      },
      'ja': {
        message: 'Not Found',
        desc: `お探しのページは見つかりませんでした。`,
        btn: 'トップページ',
        homeLink: 'https://www.moomoo.com/'
      }
    };

    // 读取 Cookie
    function getCookie(name) {
      var value = '; ' + document.cookie;
      var parts = value.split('; ' + name + '=');
      if (parts.length === 2) return parts.pop().split(';').shift();
      return '';
    }

    // 获取语言
    function getLocale() {
      var locale = getCookie('locale');
      if (!locale || !i18n[locale]) {
        return 'en-us';
      }
      return locale;
    }

    // 应用语言
    function applyLanguage(locale) {
      var texts = i18n[locale];
      if (!texts) return;

      // 更新 message
      var messageEl = document.querySelector('.message');
      if (messageEl) {
        messageEl.innerHTML = texts.message;
      }

      // 更新 desc
      var descEl = document.querySelector('.desc');
      if (descEl) {
        descEl.innerHTML = texts.desc;
      }

      // 更新 btn 文字
      var btnEl = document.querySelector('.btn');
      if (btnEl) {
        btnEl.textContent = texts.btn;
      }

      // 更新 btn 链接
      if (btnEl && texts.homeLink) {
        btnEl.href = texts.homeLink;
      }

      // 更新 header logo 链接
      var logoEl = document.querySelector('.header .logo');
      if (logoEl && texts.homeLink) {
        logoEl.href = texts.homeLink;
      }
    }

    // 初始化
    function init() {
      var locale = getLocale();
      applyLanguage(locale);
    }

    // DOM 加载完成后执行
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
