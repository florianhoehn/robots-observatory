  if (!window.gsap || !window.$) return;

  const WRAP_SELECTOR =
    '[marquee-wrap-company="true"], [name="marquee-wrap-company"][value="true"]';
  const LIST_SELECTOR =
    '.marquee-company-list[marquee-list], .marquee-company-list[name="marquee-list"]';
  const ITEM_SELECTOR = ".marquee-company-item";

  const GROUP_TOTAL_DURATION = 3;
  const GROUP_FADE_IN_DURATION = 0.8;
  const GROUP_FADE_OUT_DURATION = 0.8;
  const PAUSE_BETWEEN_GROUPS = 1.5;
  const MARQUEE_SPEED_WHEN_FOCUSED = 0.35;
  const MOBILE_BREAKPOINT = 460;

  const isMobile = window.matchMedia(`(max-width:${MOBILE_BREAKPOINT}px)`).matches;

  function getDirection(value) {
    return isMobile
      ? value === "2" ? "right" : "left"
      : value === "2" ? "down" : "up";
  }

  function prepare($list) {
    if ($list.data("ready")) return;
    const items = $list.children(ITEM_SELECTOR);
    if (!items.length) return;
    items.clone().appendTo($list);
    $list.data("ready", true);
  }

  function createLoop($list, direction, duration) {
    const el = $list[0];

    const horizontal = direction === "left" || direction === "right";

    const distance = horizontal
      ? el.scrollWidth * 0.5
      : el.scrollHeight * 0.5;

    if (!distance) return null;

    const from = (direction === "down" || direction === "right") ? -distance : 0;
    const to = (direction === "down" || direction === "right") ? 0 : -distance;

    return gsap.fromTo(
      $list,
      horizontal ? { x: from } : { y: from },
      {
        ...(horizontal ? { x: to } : { y: to }),
        duration,
        ease: "none",
        repeat: -1,
        force3D: true
      }
    );
  }

  function getGroups($wrap) {
    const map = new Map();

    $wrap.find(`${ITEM_SELECTOR}[order-to-animate], ${ITEM_SELECTOR}[name="order-to-animate"]`)
      .each(function () {
        const order = String($(this).attr("order-to-animate") || $(this).attr("value") || "");
        if (!order) return;
        if (!map.has(order)) map.set(order, []);
        map.get(order).push(this);
      });

    return Array.from(map.entries())
      .sort((a, b) => Number(a[0]) - Number(b[0]))
      .map(x => x[1]);
  }

  function init($wrap) {
    if ($wrap.data("init")) return;
    $wrap.data("init", true);

    const $lists = $wrap.find(LIST_SELECTOR);
    if (!$lists.length) return;

    const tweens = [];
    const styleCache = new Map();

    $lists.each(function () {
      const $list = $(this);

      const value = String($list.attr("marquee-list") || $list.attr("value") || "");
