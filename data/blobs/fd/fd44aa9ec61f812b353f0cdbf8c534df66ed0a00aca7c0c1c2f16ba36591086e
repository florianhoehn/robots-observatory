window.Webflow ||= [];
window.Webflow.push(() => {
  const statItems = document.querySelectorAll('[data="stats"]');
  if (!statItems.length) return;

  const parseItem = (item) => {
    const original = item.textContent.trim();

    const data = [];
    const html = original.replace(/([\+\-]?\d+\.?\d*)/g, (match) => {
      const isFloat = match.includes(".");
      const target = parseFloat(match);

      data.push({
        target,
        isFloat,
        decimals: isFloat ? (match.split(".")[1] || "").length : 0,
        el: null
      });

      return `<span data-countup>${match}</span>`;
    });

    item.innerHTML = html;

    item.querySelectorAll("[data-countup]").forEach((el, i) => {
      data[i].el = el;
    });

    return data;
  };

  const itemsData = Array.from(statItems).map(parseItem);

  function animateGroup(dataList) {
    const start = performance.now();
    const duration = 1200;

    const tick = (now) => {
      const t = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - t, 3);

      for (const d of dataList) {
        const val = eased * d.target;
        d.el.textContent = d.isFloat
          ? val.toFixed(d.decimals)
          : Math.round(val);
      }

      if (t < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  }

  let triggered = false;

  const root = statItems[0].closest("section") || document.body;

  const io = new IntersectionObserver((entries) => {
    if (triggered) return;

    for (const e of entries) {
      if (e.isIntersecting) {
        triggered = true;
        io.disconnect();

        itemsData.forEach((data, i) => {
          setTimeout(() => animateGroup(data), i * 150);
        });

        break;
      }
    }
  }, {
    root,
    rootMargin: "0px 0px -10% 0px",
    threshold: 0.1
  });

  io.observe(root);
});
