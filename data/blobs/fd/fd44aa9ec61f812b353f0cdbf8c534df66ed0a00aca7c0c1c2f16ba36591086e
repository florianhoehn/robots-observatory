window.Webflow ||= [];
window.Webflow.push(() => {
  const desktopQuery = window.matchMedia("(min-width: 992px)");
  const navContent = document.querySelector('.nav_wrapper');
  const navbar = document.querySelector('.nav');

  let lastScrollY = window.scrollY;
  let isHidden = false;
  let scrollListener = null;
  let ticking = false;

  function handleScroll() {
    if (!navContent) return;
    const currentScrollY = window.scrollY;

    // If any nav dropdown is open, keep the nav visible and do not change its scroll state.
    // Webflow's dropdown component manages its own internal state and fighting it causes sync issues,
    // so we simply avoid hiding the nav while a dropdown is open.
    const dropdownOpen = document.querySelector('.dropdown_nav.w--open, .w-dropdown-list.w--open, .dropdown_list.w--open');
    if (dropdownOpen) {
      lastScrollY = currentScrollY;
      return;
    }
    if (currentScrollY > lastScrollY && currentScrollY > 50) {
      if (!isHidden) {
        gsap.to(navContent, {
          y: '-100%',
          duration: 0.4,
          ease: 'power2.inOut'
        });
        isHidden = true;
      }
    } else if (currentScrollY < lastScrollY) {
      if (isHidden) {
        gsap.to(navContent, {
          y: '0%',
          duration: 0.4,
          ease: 'power2.inOut'
        });
        isHidden = false;
      }
    }

    lastScrollY = currentScrollY;
  }

  function onScrollTick() {
    if (!ticking) {
      window.requestAnimationFrame(() => {
        handleScroll();
        ticking = false;
      });
      ticking = true;
    }
  }

  function initDesktopNav() {
    if (!navContent || !navbar) return;
    lastScrollY = window.scrollY;
    isHidden = false;
    gsap.set(navContent, { y: '0%' });

    scrollListener = () => onScrollTick();
    window.addEventListener('scroll', scrollListener, { passive: true });
  }

  function cleanupDesktopNav() {
    if (scrollListener) {
      window.removeEventListener('scroll', scrollListener);
      scrollListener = null;
    }
    if (navContent) {
      gsap.set(navContent, { y: '0%' });
    }
    isHidden = false;
    ticking = false;
  }

  function handleBreakpointChange() {
    if (desktopQuery.matches) {
      initDesktopNav();
    } else {
      cleanupDesktopNav();
    }
  }

  if (desktopQuery.matches) {
    initDesktopNav();
  }
  desktopQuery.addEventListener('change', handleBreakpointChange);
});
