/* Fetch GitHub stars with caching and non-blocking UI update */
(function () {
  function updateStars(value) {
    const el = document.getElementById("github-stars");
    if (!el) return;
    el.textContent = value;
  }

  function getCached() {
    try {
      const cached = localStorage.getItem("gh_stars");
      if (!cached) return null;

      const parsed = JSON.parse(cached);
      if (Date.now() - parsed.time < 86400000) return parsed.value;
    } catch (e) {}
    return null;
  }

  function setCached(value) {
    try {
      localStorage.setItem("gh_stars", JSON.stringify({
        value,
        time: Date.now()
      }));
    } catch (e) {}
  }

  function fetchStars() {
    fetch("https://api.github.com/repos/growthbook/growthbook", {
      cache: "no-cache"
    })
      .then(res => res.json())
      .then(data => {
        const stars = (data && data.stargazers_count) || 0;
        const formatted = stars.toLocaleString("en");

        setCached(formatted);
        updateStars(formatted);
      })
      .catch(() => {
        updateStars("—");
      });
  }

  function init() {
    const cached = getCached();
    if (cached) {
      updateStars(cached);
    }

    fetchStars();
  }

  window.Webflow = window.Webflow || [];
  window.Webflow.push(() => {
    setTimeout(init, 0);
  });
})();
