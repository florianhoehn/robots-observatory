	<script>
		// Safety net: if the app's JavaScript fails to load (e.g. a cached page from an older deploy
		// whose JS files no longer exist), reload once with a cache-busting param to get fresh HTML.
		// A link pasted before that is carried over as ?url= so loading starts automatically.
		(function () {
			var url = new URL(location.href);
			var justReloaded = url.searchParams.has("_fresh");
			if (justReloaded) {
				url.searchParams.delete("_fresh");
				history.replaceState(history.state, "", url.pathname + url.search + url.hash);
			}
			window.addEventListener("unhandledrejection", function (e) {
				var msg = String((e.reason && (e.reason.message || e.reason)) || "");
				if (!/dynamically imported module|Importing a module script failed|error loading dynamically imported/i.test(msg)) return;
				if (justReloaded || window.svelteHydrated) return; // never loop
				if (window.fvsLeaving) return; // page is already navigating (classic submit): not a broken page
				var next = new URL(location.href);
				next.searchParams.set("_fresh", Date.now());
				if (window.earlyPastedUrl && !next.searchParams.get("url")) next.searchParams.set("url", window.earlyPastedUrl);
				location.replace(next.toString());
			});
		})();
	</script>
	
	
