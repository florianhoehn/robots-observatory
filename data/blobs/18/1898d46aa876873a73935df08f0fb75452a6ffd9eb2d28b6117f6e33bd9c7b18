	}
	function tecCookieVoltarSimples() {
		document.getElementById('tec-cookie-simples').style.display = 'block';
		document.getElementById('tec-cookie-detalhes').style.display = 'none';
	}
	function tecCookieSalvarPersonalizado() {
		var analitica = document.getElementById('tec-chk-analitica').checked;
		var marketing = document.getElementById('tec-chk-marketing').checked;
		tecCookieAceitar(analitica, marketing);
	}
	function tecCookieAceitar(analitica, marketing) {
		$.ajax({
			url: contextPathUrl + 'cookie-consent/salvar',
			method: 'POST',
			data: { analitica: analitica, marketing: marketing },
			success: function() {
				location.reload();
			},
			error: function() {
				document.getElementById('tec-cookie-banner').style.display = 'none';
			}
		});
	}
</script>

