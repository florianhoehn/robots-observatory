<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>404 - Page Not Found | AIS Marine Traffic</title>
    <meta name="description" content="Page not found">
    <link href="../favicon_n.ico" type="image/x-icon" rel="icon" />
    <link href="../favicon_n.ico" type="image/x-icon" rel="shortcut icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
      html {
        height: 100%;
      }
      body {
        margin: 0;
        display: flex;
        flex-direction: column;
        height: 100%;
        background-image: linear-gradient(180deg, #ffff 20%, #0000 100%),
          url(/img/404BGImage.jpg);
        background-position: center;
        background-repeat: repeat-x;
        background-size: auto, cover;
        font-family: Roboto, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
      }
      .overlay {
        position: fixed;
        opacity: 0.8;
        width: 100%;
        height: 100%;
        background-image: linear-gradient(
          0deg,
          #29333cff 14%,
          #dbe2eaff 43%,
          #ffff 98%
        );
      }
      .container {
        position: absolute;
        left: 50%;
        top: 265px;
        transform: translateX(-50%);
        text-align: center;
      }
      .img {
        position: absolute;
        width: 36px;
        height: 35px;
        top: 26px;
        left: 50%;
        transform: translateX(-50%);
        cursor: pointer;
      }
      .header {
        text-align: center;
        color: #29333c;
        font-size: 18px;
        font-style: italic;
        font-weight: 400;
      }
      .subHeader {
        color: #29333c;
        font-size: 72px;
        font-weight: 700;
        letter-spacing: -1.5px;
        text-align: center;
        align-items: center;
        flex-direction: column;
      }
      .button {
        margin-top: 50px;
        padding: 8px 22px;
        border-radius: 4px;
        background-color: #39414d;
        overflow: hidden;
        color: #fff;
        font-size: 15px;
        line-height: 26px;
        font-weight: 500;
        font-family: Roboto, system-ui, -apple-system, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, "Noto Sans", "Liberation Sans", sans-serif;
        letter-spacing: 0.46px;
        white-space: nowrap;
        cursor: pointer;
        border: none
      }
    </style>
  </head>
  <body>
    <div class="overlay"></div>
    <img
      class="img"
      src="/img/logos/logo_icon_2x_gray.png"
      onclick="window.location='/'"
    />
    <div class="container">
      <div class="header">Nothing to sea here</div>
      <div class="subHeader">Oops..something went wrong</div>
      <button class="button" onclick="window.location='/'">
        Go to live map
      </button>
    </div>
  </body>
</html>
