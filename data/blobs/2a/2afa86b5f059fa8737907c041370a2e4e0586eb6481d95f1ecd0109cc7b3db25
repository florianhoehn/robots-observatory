        this._nativeAdTemplateIds = [];
        this._nativeAdXtraTemplateIds = [];
        this._nativeAdSerieXtraTemplateIds = [];
        this._nativeAdCollectionTemplateIds = [];
        this._panoramaTemplateIds = [];
        this._previewBehaviourOverride = '';
        this._previewPositionOverride = null;
        this._previewPageBlockOverride = null;

        this.init = function(
            dynamicProductGalleryCreativeTemplateIds,
            productGalleryTemplateIds,
            nativeAdTemplateIds,
