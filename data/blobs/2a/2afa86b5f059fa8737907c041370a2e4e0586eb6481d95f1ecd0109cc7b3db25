            googletag.cmd.push(function () {
                function resetModifiers(slotElementId) {
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--initialized");
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--pending");
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--empty");
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--filled");
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--rendered");
                    document.getElementById(slotElementId).parentNode.parentNode.classList.remove("adSpotBlock--response-received");
                }

                function addModifier(slotElementId, modifier) {
                    document.getElementById(slotElementId).parentNode.parentNode.classList.add(modifier);
                }

                googletag.pubads().addEventListener('slotRenderEnded', function (event) {
                    function shouldDisplayEventEmitterSlot(event) {
                        if (event.size !== null && event.size[0] === 7 && event.size[1] === 1) {
                            return false;
                        }

                        return !event.isEmpty;
                    }

                    resetModifiers(event.slot.getSlotElementId());
                    addModifier(event.slot.getSlotElementId(), "adSpotBlock--rendered");
                    if (shouldDisplayEventEmitterSlot(event)) {
                        addModifier(event.slot.getSlotElementId(), "adSpotBlock--filled");
                    } else {
                        addModifier(event.slot.getSlotElementId(), "adSpotBlock--empty");
                    }
                    document.getElementById(event.slot.getSlotElementId()).dispatchEvent(new CustomEvent("rendered", {
                        "bubbles": true,
                        "detail": {"displayed": shouldDisplayEventEmitterSlot(event)}
                    }));

                });

                if (self._previewPositionOverride) {
                    googletag.pubads().addEventListener('slotOnload', function (event) {
                        var slotElementId = event.slot.getSlotElementId();
                        var targetContainer = self._getSlotElementWrapper(slotElementId);

                        if (targetContainer) {
                            targetContainer.scrollIntoView({
                                behavior: 'auto',
                                block: 'center',
                                inline: 'nearest'
                            });

                            self._keepInCenterDuringLoad(targetContainer);
                        }
                    });
                }

                googletag.pubads().addEventListener('slotRequested', function (event) {
                    resetModifiers(event.slot.getSlotElementId());
                    addModifier(event.slot.getSlotElementId(), "adSpotBlock--pending");
                });

                googletag.pubads().addEventListener('slotResponseReceived', function (event) {
                    resetModifiers(event.slot.getSlotElementId());
                    addModifier(event.slot.getSlotElementId(), "adSpotBlock--response-received");
                });
            });

            googletag.cmd.push(function () {
                function adjustAdFormat(slotElementId, creativeTemplateId) {

                    console.debug('Ads: Adjust Ad Format slotElementId : ', slotElementId);
                    console.debug('Ads: Adjust Ad Format creativeTemplateId : ', creativeTemplateId);

                    if (self.isProductGalleryAd(creativeTemplateId)) {
                        setUpProductGalleryAd(slotElementId)
                    } else if (self.isNativeAd(creativeTemplateId)) {
                        setUpNativeAd(slotElementId)
                    } else if (self.isNativeAdXtra(creativeTemplateId)) {
                        setUpNativeAdXtra(slotElementId)
                    } else if (self.isNativeAdCollection(creativeTemplateId)) {
                        setUpNativeAdCollection(slotElementId)
                    } else if (self.isDynamicProductGalleryAd(creativeTemplateId)) {
                        setUpDynamicProductGalleryAd(slotElementId)
                    } else if (self.isProductGalleryXtraAd(creativeTemplateId)) {
                        setUpProductGalleryXtraAd(slotElementId)
                    }
                }

                function setUpNativeAdCollection(slotElementId) {
                    console.debug('Ads: Native Ad Collection detected for ' + slotElementId);
                    let slotInner = document.getElementById(slotElementId);
                    slotInner.parentElement.style.width = '100%';
                    slotInner.parentElement.style.maxWidth = '1290px';
