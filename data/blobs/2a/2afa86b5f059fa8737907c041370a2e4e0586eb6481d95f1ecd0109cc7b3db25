            this._productGalleryXtraTemplateIds = productGalleryXtraTemplateIds;
            this._dynamicProductGalleryCreativeTemplateIds = dynamicProductGalleryCreativeTemplateIds;
            this._nativeAdTemplateIds = nativeAdTemplateIds;
            this._nativeAdXtraTemplateIds = nativeAdXtraTemplateIds;
            this._panoramaTemplateIds = panoramaTemplateIds;
