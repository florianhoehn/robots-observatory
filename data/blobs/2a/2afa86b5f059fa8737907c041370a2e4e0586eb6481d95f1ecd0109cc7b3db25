                this._traceGPTEvents();
            }

            function extractAdSlotName(message) {
                const iframeIdRegex = /\(\s*id=([^;)\s]+)/g;
                let iframeId = iframeIdRegex.exec(message)[1];
                return document.getElementById(iframeId)?.parentNode?.parentElement?.id;
            }


            function sendReports(reports) {
                for (let report of reports) {
                    if (report.body.id === 'HeavyAdIntervention') {
                        let adSlotName = extractAdSlotName(report.body.message);
                        let adSlotInformation = self.getAdSlotByName(adSlotName).getResponseInformation();

                        let eventData = {
                            message: report.body.message,
                            advertiserId: adSlotInformation.advertiserId.toString(),
                            campaignId: adSlotInformation.campaignId.toString(),
                            adCreativeId: adSlotInformation.creativeId.toString(),
                            lineItemId: adSlotInformation.lineItemId.toString(),
                        }
                        nuglif.analytics.pubSub.publish('heavyAdIntervention', eventData);
                    }
                }
            }

            const observer = new ReportingObserver(
                (reports, observer) => {
                    sendReports(reports);
                },
                {
                    types: ['intervention'],
                    buffered: true
                }
            );

            observer.observe();

            window.addEventListener('pagehide', (event) => {
                let reports = observer.takeRecords();
                sendReports(reports);
            });

            const urlParams = new URLSearchParams(location.search);
            if (urlParams.has('previewBehaviour')) {
                this._previewBehaviourOverride = urlParams.get('previewBehaviour');
            }
            if (urlParams.has('previewPosition')) {
                this._previewPositionOverride = urlParams.get('previewPosition');
            }
            if (urlParams.has('previewPageBlock')) {
                this._previewPageBlockOverride = urlParams.get('previewPageBlock');
