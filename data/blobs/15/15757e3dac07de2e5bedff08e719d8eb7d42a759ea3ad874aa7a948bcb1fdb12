    var selector = '#main-header svg';
    var ns = 'http://www.w3.org/2000/svg';
    var states = new Map();
    var sequence = 0;
    var dirty = true;
    var lastScrolled = null;
    var darkClasses = ['footer-section_new', 'section_product-header'];

    function paint(node, color) {
