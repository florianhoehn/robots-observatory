    function luminance(color) {
      var match = color && color.match(/rgba?\(([^)]+)\)/);
      if (!match) return null;
      var values = match[1].split(',').map(Number);
      if (values.length === 4 && values[3] < 0.5) return null;
      return (0.299 * values[0] + 0.587 * values[1] + 0.114 * values[2]) / 255;
    }

    function isDark(x, y) {
