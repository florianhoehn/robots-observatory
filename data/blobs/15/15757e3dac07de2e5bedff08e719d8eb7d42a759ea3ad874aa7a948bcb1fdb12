      var defs = document.createElementNS(ns, 'defs');
      var clip = document.createElementNS(ns, 'clipPath');
      var rect = document.createElementNS(ns, 'rect');
      var box = svg.viewBox.baseVal;
      do { clip.id = 'island-logo-invert-clip-' + (++sequence); }
      while (document.getElementById(clip.id));
      clip.setAttribute('clipPathUnits', 'userSpaceOnUse');
      rect.setAttribute('x', box.x);
      rect.setAttribute('y', box.y);
      rect.setAttribute('width', box.width);
      rect.setAttribute('height', 0);
      clip.appendChild(rect);
      defs.appendChild(clip);

      // Both colors stay in this SVG and inherit the same nav movement and fade.
      var overlay = document.createElementNS(ns, 'g');
      overlay.setAttribute('data-island-logo-overlay', '');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('pointer-events', 'none');
      overlay.setAttribute('clip-path', 'url(#' + clip.id + ')');
      svg.querySelectorAll('.logo-icon, .logo-text').forEach(function (group) {
        overlay.appendChild(group.cloneNode(true));
      });
      paint(overlay, '#ffffff');
      svg.appendChild(defs);
      svg.appendChild(overlay);
      states.set(svg, { rect: rect, box: box, geometry: '' });
