<script>
document.addEventListener("DOMContentLoaded", function () {
  const yellowbody = document.querySelector("body.integrations");

  if (!yellowbody) return;

  function toggleNavbarShadow() {
    if (window.scrollY > 20) {
      yellowbody.classList.add("scrolled");
    } else {
      yellowbody.classList.remove("scrolled");
    }
  }

  toggleNavbarShadow(); // Initial check
  window.addEventListener("scroll", toggleNavbarShadow);
});


document.querySelectorAll('.bx-tldr').forEach(box => {
    const content = box.querySelector('.tinder');

    if (!content || content.textContent.trim() === '') {
        box.classList.add('is-empty');
    }
});
</script></body></html>