<!DOCTYPE html>
<html lang="zh-CN">

<head>
  <meta charset="utf-8" />
  <title>This page could not be found - EngageLab</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- 防止被搜索引擎收录 -->
  <meta name="robots" content="noindex,nofollow" />
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      height: 100%;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f8f7fc;
      color: #0b2640;
    }

    .error-wrapper {
      height: 100vh;
      width: 100vw;
      margin: 0 auto;
      padding-top: 10vh;
      text-align: center;
      background: #f8f7fc;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .error-wrapper .title {
      margin-bottom: 16px;
      margin-top: 35px;
      padding: 0 16px;
      font-size: 30px;
      font-weight: 500;
      color: #0b2640;
      line-height: 38px;
    }

    .error-wrapper .text {
      margin-bottom: 55px;
      padding: 0 16px;
      font-size: 16px;
      font-weight: 400;
      color: rgba(17, 24, 39, 0.55);
      line-height: 24px;
    }

    .btn-group {
      display: flex;
      justify-content: center;
      gap: 16px;
      padding: 0 16px;
    }

    .btn {
      border-radius: 18px;
      margin-right: 16px;
      padding: 6px 20px;
      cursor: pointer;
      font-size: 14px;
      line-height: 20px;
      border: 1px solid transparent;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      white-space: nowrap;
    }

    .btn-purple {
      background: linear-gradient(242deg, #698af3, #545dd9);
      color: #fff;

      text-align: center
    }

    .btn-default {
      background: #ffffff;
      border-color: rgba(148, 163, 184, 0.8);
      color: #0b2640;
    }

    .btn:hover {
      opacity: 0.9;
    }

    .btn-purple:hover {
      background: linear-gradient(251deg, #446def, #443cc6) !important
    }

    @media screen and (max-width: 768px) {

      .error-wrapper .title {
        font-size: 24px;
        line-height: 32px;
      }

      .error-wrapper .text {
        margin-bottom: 40px;
        font-size: 14px;
      }
    }
  </style>
</head>

<body>

  <main class="error-wrapper">
    <div>
      <p class="title">This page could not be found</p>
      <p class="text">
        Sorry, the page you are looking for was not found
      </p>
    </div>
    <p class="btn-group">
      <a href="/" class="btn btn-purple">Back to index</a>
      <button class="btn btn-default" type="button" onclick="location.reload()">Refresh</button>
    </p>
  </main>
</body>

</html>