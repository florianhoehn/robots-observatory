<script>
(function () {
  var PANELS = '.nav_company_dpdown, .nav_customer-story_dpdown';
  var VIEWPORT_MARGIN = 16;
  var GAP_REM = 0.5; // designed gap between the nav row and the visible card

  function rem(n) {
    var root = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    return n * root;
  }

  function position(panel) {
    var dpdown = panel.closest('.nav-25_dpdown');
    var item = panel.closest('.nav-25_list_item');
    if (!dpdown || !item) return;
    var toggle = item.querySelector('.nav-25_dpdown-toggle');
    if (!toggle) return;

    // The row holding the toggle — NOT .nav-25_component, which also wraps the banner.
    var row = toggle.closest('.nav-25_container')
           || toggle.closest('.nav-25_middle_wrap')
           || item.closest('.nav-25_component');
    if (!row) return;

    if (dpdown.dataset.navTransition === undefined) {
      dpdown.dataset.navTransition = getComputedStyle(dpdown).transition || '';
    }

    dpdown.style.transition = 'none';
    dpdown.style.position = 'fixed';
    dpdown.style.transform = 'none';
    dpdown.style.width = 'max-content';
    dpdown.style.maxWidth = (document.documentElement.clientWidth - VIEWPORT_MARGIN * 2) + 'px';

    // --- targets, in viewport coordinates ---
    var t = toggle.getBoundingClientRect();
    var w = dpdown.offsetWidth;
    var targetLeft = t.left + t.width / 2 - w / 2;
    var minL = VIEWPORT_MARGIN;
    var maxL = document.documentElement.clientWidth - w - VIEWPORT_MARGIN;
    if (targetLeft > maxL) targetLeft = maxL;
    if (targetLeft < minL) targetLeft = minL;

    // Park the box to measure how far the visible card sits below it (nested
    // padding), then aim the CARD at row bottom + the designed gap.
    dpdown.style.top = '0px';
    dpdown.style.left = '0px';
    var cardOffset = panel.getBoundingClientRect().top - dpdown.getBoundingClientRect().top;
    var targetTop = row.getBoundingClientRect().bottom - cardOffset + rem(GAP_REM);

    // --- write, then cancel any containing-block error ---
    // With a banner present, an ancestor becomes the containing block for this
    // element, so `top` resolves from ITS edge (~banner height) not the viewport.
    // Measure where the box actually landed and subtract the difference.
    dpdown.style.top = targetTop + 'px';
    dpdown.style.left = targetLeft + 'px';
    var r = dpdown.getBoundingClientRect();
    var dy = r.top - targetTop;
    var dx = r.left - targetLeft;
    if (dy || dx) {
      dpdown.style.top = (targetTop - dy) + 'px';
      dpdown.style.left = (targetLeft - dx) + 'px';
    }

    void dpdown.offsetWidth;
    dpdown.style.transition = dpdown.dataset.navTransition;
  }

  function init() {
    // Desktop panels only — mobile panes have no .nav-25_list_item ancestor.
    var panels = [].slice.call(document.querySelectorAll(PANELS))
      .filter(function (p) { return p.closest('.nav-25_list_item'); });
    if (!panels.length) return;

    panels.forEach(function (panel) {
      panel.closest('.nav-25_list_item').addEventListener('pointerenter', function () {
        requestAnimationFrame(function () { position(panel); });
      });
    });

    window.addEventListener('resize', function () {
      panels.forEach(function (panel) { position(panel); });
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
