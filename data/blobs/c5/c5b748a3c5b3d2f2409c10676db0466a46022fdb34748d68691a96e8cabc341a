<script>
  (() => {
    function initSubNavbar() {
      // Change this value to control when the subnavbar appears.
      // 30 means 30% of the viewport height.
      const SHOW_AFTER_PERCENT = 30;

      const subNavbar = document.querySelector('.subnav-new');
      const navbar = document.querySelector('.nav-25_component');
      const navWrapper = document.querySelector('.nav-25_outer-wrap');

      if (!subNavbar || !navbar || !navWrapper) {
        console.warn('[subnav] Required elements were not found:', {
          subNavbar,
          navbar,
          navWrapper,
        });
        return;
      }

      let ticking = false;
      let isSubNavbarVisible = false;

      function setVisibility(shouldShow) {
        // Avoid unnecessary DOM updates while scrolling.
        if (shouldShow === isSubNavbarVisible) {
          return;
        }

        isSubNavbarVisible = shouldShow;

        subNavbar.classList.toggle('is-product-visible', shouldShow);

        navbar.classList.toggle('is-hidden', shouldShow);

        navWrapper.classList.toggle('is-product-visible', shouldShow);

        subNavbar.setAttribute('aria-hidden', String(!shouldShow));

        navbar.setAttribute('aria-hidden', String(shouldShow));
      }

      function updateVisibility() {
        const threshold = window.innerHeight * (SHOW_AFTER_PERCENT / 100);

        const shouldShow = window.scrollY >= threshold;

        setVisibility(shouldShow);
        ticking = false;
      }

      function requestVisibilityUpdate() {
        if (ticking) return;

        ticking = true;
        window.requestAnimationFrame(updateVisibility);
      }

      window.addEventListener('scroll', requestVisibilityUpdate, { passive: true });

      window.addEventListener('resize', requestVisibilityUpdate, { passive: true });

      // Set the correct state on initial load,
      // including refreshed pages that retain scroll position.
      updateVisibility();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSubNavbar, { once: true });
    } else {
      initSubNavbar();
    }
  })();
</script>
