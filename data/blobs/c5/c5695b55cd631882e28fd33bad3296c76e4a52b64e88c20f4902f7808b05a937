      * {
        margin: 0;
        padding: 0;
        border: 0;
        box-sizing: border-box;
      }
      .container {
        width: 100%;
        height: 100vh;
        gap: 32px;
        display: flex;
        flex-direction: column-reverse;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }
      .image {
        min-width: 160px;
        min-height: 160px;
        width: 160px;
        height: 160px;
      }
      .texts {
        display: flex;
        gap: 32px;
        flex-direction: column;
        align-items: center;
      }
      .text {
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      h1 {
        color: #282b2f;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 32px;
        font-style: normal;
        font-weight: 900;
        line-height: 40px;
        text-align: center;
      }

      p {
        overflow: hidden;
        color: #4d596a;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 16px;
        font-style: normal;
        font-weight: 400;
        line-height: 24px;
        letter-spacing: -0.16px;
        text-align: center;
      }
      button {
        color: #f9fafb;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 14px;
        font-style: normal;
        font-weight: 600;
        line-height: 16px;
        letter-spacing: -0.175px;
        padding: 9px 16px;
        cursor: pointer;
        border-radius: 12px;
        background-color: #212327;
        box-shadow: 0px 2px 12px -1px rgba(0, 0, 0, 0.12),
          0px 2px 2px -1px rgba(0, 0, 0, 0.04),
          0px 0px 1px 0px rgba(0, 0, 0, 0.24);
        backdrop-filter: blur(24px);
      }
      button:hover {
        background-color: #3c4553;
      }
      button::after {
        content: "";
        border: 1px solid rgba(200, 220, 249, 0.24);
        position: absolute;
        width: calc(100% - 4px);
        height: calc(100% - 4px);
        left: 1px;
        right: 1px;
        bottom: 1px;
        top: 1px;
        border-radius: 11px;
      }
      @media (min-width: 800px) {
        .container {
          display: grid;
          padding-left: 76px;
          grid-template-columns: 1fr 1fr;
          width: 100%;
        }
        .image {
          min-width: 280px;
          min-height: 280px;
          width: 280px;
          height: 280px;
        }
        .texts {
          align-items: flex-start;
        }
        h1 {
          text-align: left;
        }
        p {
          text-align: left;
        }
        button {
          padding: 11px 24px;
          border-radius: 16px;
          line-height: 24px;
          font-size: 16px;
        }
        button::after {
          border-radius: 15px;
        }
      }
      @media (min-width: 1280px) {
        .container {
          flex-direction: row;
          padding-left: 186px;
          justify-content: flex-start;
        }
      }
    </style>
  </head>
