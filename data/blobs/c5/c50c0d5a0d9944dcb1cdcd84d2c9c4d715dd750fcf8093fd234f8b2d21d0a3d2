<!-- ===== [OPT-3] Feature Experiments - Exposure (Amplitude) ===== -->
<script>
    (function () {
        "use strict";

        var LS_KEY = "exp_pending_exposure";
        var h = window.__ifpHelpers;
        var cookies = h.getCookieMap();
        var assignment = cookies["exp_assignment"];
        var flagKey, variant, expDeviceId, source;

        if (assignment) {
            var sep = assignment.indexOf(":");
            if (sep >= 1) {
                flagKey = assignment.substring(0, sep);
                variant = assignment.substring(sep + 1);
                source = "cookie";
            }
        }

        if (!flagKey || !variant) {
            var params = new URLSearchParams(window.location.search);
            flagKey = params.get("_exp_flag") || "";
            variant = params.get("_exp_variant") || "";
            if (flagKey && variant) source = "query_param";
        }

        if (!flagKey || !variant) {
            try {
                var stored = localStorage.getItem(LS_KEY);
                if (stored) {
                    var pending = JSON.parse(stored);
                    if (pending.status === "beacon_sent") {
                        localStorage.removeItem(LS_KEY);
                    } else if (pending.flagKey && pending.variant && pending.status === "pending") {
                        flagKey = pending.flagKey;
                        variant = pending.variant;
                        expDeviceId = pending.expDeviceId || "";
                        source = "localStorage_retry";
                    }
                }
            } catch (e) { }
        }

        if (!flagKey || !variant) return;

        if (!expDeviceId) expDeviceId = cookies["exp_device_id"] || "";
        if (!expDeviceId) {
            var qp = new URLSearchParams(window.location.search);
            expDeviceId = qp.get("_exp_device_id") || "";
        }

        var cleanDomain = h.getCleanDomain();

        if (window.history && window.history.replaceState) {
            var url = new URL(window.location.href);
            if (url.searchParams.has("_exp_flag") || url.searchParams.has("_exp_variant") || url.searchParams.has("_exp_device_id")) {
                url.searchParams.delete("_exp_flag");
                url.searchParams.delete("_exp_variant");
                url.searchParams.delete("_exp_device_id");
                window.__expCleaningParams = true;
                window.history.replaceState(null, "", url.pathname + url.search + url.hash);
                window.__expCleaningParams = false;
            }
        }

        try {
            localStorage.setItem(LS_KEY, JSON.stringify({
                flagKey: flagKey,
                variant: variant,
                expDeviceId: expDeviceId,
                status: "pending",
                ts: Date.now()
            }));
        } catch (e) { }

        var exposureFired = false;

        function fireExposure() {
            rudderanalytics.track("$exposure", {
                flag_key: flagKey,
                variant: variant,
                exp_device_id: expDeviceId
            }, {}, function () {
                exposureFired = true;
                document.cookie = "exp_assignment=; Path=/; Domain=." + cleanDomain + "; Secure; SameSite=Lax; Max-Age=0";
                try { localStorage.removeItem(LS_KEY); } catch (e) { }
            });
        }

        document.addEventListener("pagehide", function () {
            if (exposureFired) return;
            if (navigator.sendBeacon) {
                var sent = navigator.sendBeacon("/exp/exposure-fallback", JSON.stringify({
                    flag_key: flagKey,
                    variant: variant,
                    exp_device_id: expDeviceId,
                    ts: Date.now()
                }));
                if (sent) {
                    exposureFired = true;
                    try {
                        localStorage.setItem(LS_KEY, JSON.stringify({
                            flagKey: flagKey,
                            variant: variant,
                            expDeviceId: expDeviceId,
                            status: "beacon_sent",
                            ts: Date.now()
                        }));
                    } catch (e) { }
                }
            }
        });

        fireExposure();

    })();
</script>

