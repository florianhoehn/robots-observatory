        };

        if (page.dp) {
            params.deepLinkValue = { keys: [], defaultValue: page.dp };
            params.afCustom.push(
                { paramKey: "af_dp", defaultValue: page.dp },
                { paramKey: "af_force_deeplink", defaultValue: "true" }
            );
        }

        if (page.web) {
            params.afCustom.push({ paramKey: "af_web_dp", defaultValue: page.web });
        }

        return {
            oneLinkURL: ONELINK_BASE,
            webReferrer: "af_channel",
            afParameters: params,
            selector: page.selector || null
        };
    }

