            webReferrer: "af_channel",
            afParameters: {
                mediaSource: { keys: ["utm_source"], defaultValue: mediaSourceDefault },
                campaign: { keys: ["utm_name", "utm_campaign"], defaultValue: "lp_cta" },
                ad: { keys: ["utm_term"], defaultValue: "lp_cta_checkout" },
                adSet: { keys: ["utm_content"], defaultValue: "lp_cta_download" },
                googleClickIdKey: "af_sub1",
                afSub2: { keys: ["fbclid"] },
