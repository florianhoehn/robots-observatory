<!-- ===== Restore Params from Cookie (Safari ITP workaround) ===== -->
<script>
    (function () {
        "use strict";

        var COOKIE_NAME = "_exp_ctx";

        // Get cookie value
        var getCookie = function (name) {
            var needle = name + "=";
            var hit = document.cookie.split("; ").find(function (c) { return c.startsWith(needle); });
            return hit ? hit.slice(needle.length) : null;
        };

        // Delete cookie
        var deleteCookie = function (name, domain) {
            document.cookie = name + "=; Path=/; Domain=" + domain + "; Secure; SameSite=Lax; Max-Age=0";
        };

        // Get domain for cookie (e.g., ".jim.com")
        var getCookieDomain = function () {
            var host = window.location.hostname;
            if (host.startsWith("www.")) host = host.slice(4);
            return "." + host;
        };

        try {
            var raw = getCookie(COOKIE_NAME);
            if (!raw) return; // No backup cookie, nothing to do

            var params = JSON.parse(decodeURIComponent(raw));
            if (!params || typeof params !== "object") return;

            var url = new URL(window.location.href);
            var changed = false;

            // Only restore params that are missing from current URL
            for (var key in params) {
                if (params.hasOwnProperty(key) && !url.searchParams.has(key)) {
                    url.searchParams.set(key, params[key]);
                    changed = true;
                }
            }

            // Update URL if we restored any params
            if (changed && window.history && window.history.replaceState) {
                window.history.replaceState(null, "", url.pathname + url.search + url.hash);
            }

            // Always delete the cookie after reading (one-time use)
            deleteCookie(COOKIE_NAME, getCookieDomain());

        } catch (e) {
            // Silently fail - don't break the page
        }
    })();
</script>
