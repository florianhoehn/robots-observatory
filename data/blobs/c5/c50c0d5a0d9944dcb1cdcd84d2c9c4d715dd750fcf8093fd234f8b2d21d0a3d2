    function hasRenderedQr(el) {
        return !!(el.querySelector("canvas, svg") || el.querySelector("img[data-af-qr-img]"));
    }

    function injectQrFallback(el) {
        if (!el || el.getAttribute("data-af-qr") === "fallback") return;
        if (hasRenderedQr(el)) return;

        el.innerHTML = "";
        var img = document.createElement("img");
        img.src = QR_FALLBACK_IMG;
        img.alt = "QR Code para baixar o app InfinitePay";
        img.width = 160;
        img.height = 160;
        img.setAttribute("data-af-qr-img", "1");
        el.appendChild(img);
        el.setAttribute("data-af-qr", "fallback");
        if (!el.getAttribute("data-af-qr-url")) {
            el.setAttribute("data-af-qr-url", ONELINK_BASE);
        }
    }

    function ensureQrFallbacks() {
        document.querySelectorAll("[data-qrcode]").forEach(injectQrFallback);
    }

    function scheduleFallbackChecks() {
        FALLBACK_CHECK_DELAYS.forEach(function (delay) {
            setTimeout(ensureQrFallbacks, delay);
        });
    }

    function renderQr(el, config, expectedURL) {
        if (!el || !expectedURL) return;
        if (el.getAttribute("data-af-qr-url") === expectedURL && hasRenderedQr(el)) return;
        if (!el.id) el.id = "af_qrcode_" + Math.random().toString(36).slice(2, 9);

        var again = window.AF_SMART_SCRIPT.generateOneLinkURL(config);
        if (!again || again.clickURL !== expectedURL) return;

        el.innerHTML = "";
        el.removeAttribute("data-af-qr");
        window.AF_SMART_SCRIPT.displayQrCode(el.id, { codeColor: "#000000" });
        el.setAttribute("data-af-qr-url", expectedURL);
    }

    function applyKey(key, anonId) {
        var config = buildConfig(pages[key], anonId);
        var result = window.AF_SMART_SCRIPT.generateOneLinkURL(config);
        if (!result || !result.clickURL) return;

        var linkSelector = config.selector || '[data-onelink="' + key + '"]';
        document.querySelectorAll(linkSelector).forEach(function (el) {
            el.setAttribute("href", result.clickURL);
        });

        document.querySelectorAll('[data-qrcode="' + key + '"]').forEach(function (el) {
            renderQr(el, config, result.clickURL);
        });
    }

    function applyCustom(anonId) {
        document.querySelectorAll('[data-onelink="custom"]').forEach(function (el) {
            var pathCode = el.getAttribute("data-onelink-path");
            if (!pathCode) return;
            var r = window.AF_SMART_SCRIPT.generateOneLinkURL(buildCustomConfig(pathCode, anonId, "lp_source"));
            if (r && r.clickURL) el.setAttribute("href", r.clickURL);
        });

        document.querySelectorAll('[data-qrcode="custom"]').forEach(function (el) {
            var pathCode = el.getAttribute("data-onelink-path");
            if (!pathCode) return;
            var config = buildCustomConfig(pathCode, anonId, "organic_source");
            var r = window.AF_SMART_SCRIPT.generateOneLinkURL(config);
            if (r && r.clickURL) renderQr(el, config, r.clickURL);
        });
    }

    function applyAll(anonId) {
        Object.keys(pages).forEach(function (key) { applyKey(key, anonId); });
        applyCustom(anonId);
        appliedAnonId = anonId;
    }

    function watchPending(anonId) {
        var tries = 0;
        var timer = setInterval(function () {
            tries++;
            var pendingQr = document.querySelectorAll("[data-qrcode]:not([data-af-qr-url])");
            var pendingLinks = document.querySelectorAll('[data-onelink]:not([data-onelink=""])[href="#"]');
            if ((!pendingQr.length && !pendingLinks.length) || tries > PENDING_TRIES) {
                clearInterval(timer);
                ensureQrFallbacks();
                return;
            }
            applyAll(appliedAnonId || anonId);
        }, PENDING_DELAY);
    }

    function applyFallback() {
        document.querySelectorAll('[data-onelink]:not([data-onelink=""])').forEach(function (el) {
            var href = el.getAttribute("href");
            if (!href || href === "#") el.setAttribute("href", ONELINK_BASE);
        });
        ensureQrFallbacks();
    }

