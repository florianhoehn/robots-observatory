	<script>
		(function () {

			var insertSuggestions = function (resp) {
				var directLinks = resp.directLinks;

				if (directLinks.length > 0) {
					document.querySelector('.direct-links').innerHTML = "";
					document.querySelector('.search-suggestions').style.display = 'block';

					for (i = directLinks.length - 1; i >= 0; i--) {
						let label = "";
						const match = directLinks[i].label.match(new RegExp(resp.originalKeyword, 'i'));

						if (match) {
							label = directLinks[i].label.replace(match[0], `<strong>${match[0]}</strong>`);
						}

						if (!label) {
							continue;
						}

						var html1 = '<a class="destination_url" href="' + directLinks[i].destinationUrl + '">' +
							'<p class="search_suggestion_list">' + label + '</p></a>';
						document.querySelector('.direct-links').insertAdjacentHTML('afterbegin', html1);

					}
					document.getElementById("search-field").addEventListener("search", function (event) {
						window.location.href = "https://www.att.com/search/?q=" + document.querySelector('#search-field').value;
					});

					document.querySelector(".search-button").addEventListener('click', function () {
						window.location.href = "https://www.att.com/search/?q=" + document.querySelector('#search-field').value;
					});
				}

				if (document.querySelectorAll('.direct-links p').length === 0) {
					document.querySelector('.search-suggestions').style.display = 'none';
				}
			};

			var prepopulatedResults = {
				directLinks: [
					{ label: 'AT&T deals', destinationUrl: 'https://www.att.com/deals/' },
					{ label: 'Accessories', destinationUrl: 'https://www.att.com/accessories/' },
					{ label: 'Affordable Connectivity Program (ACP)', destinationUrl: 'https://www.att.com/help/affordable-connectivity-program/' },
					{ label: 'AT&T Prepaid', destinationUrl: 'https://www.att.com/prepaid/' },
					{ label: 'Bundles', destinationUrl: 'https://www.att.com/bundles/' },
					{ label: 'International travel plans', destinationUrl: 'https://www.att.com/international/' },
					{ label: 'Wireless', destinationUrl: 'https://www.att.com/wireless/' },
					{ label: 'Phones & Devices', destinationUrl: 'https://www.att.com/buy/phones/' },
					{ label: 'Upgrade a device', destinationUrl: 'https://www.att.com/plans/phone-upgrade.html' },
					{ label: 'Check upgrade eligibility and options', destinationUrl: 'https://www.att.com/support/article/wireless/KM1002380/' },
					{ label: 'Internet', destinationUrl: 'https://www.att.com/internet/' },
					{ label: 'Internet Air', destinationUrl: 'https://www.att.com/internet/internet-air/' },
					{ label: 'Fiber', destinationUrl: 'https://www.att.com/internet/fiber/' },
					{ label: 'Moving', destinationUrl: 'https://www.att.com/moving/' },
					{ label: 'Business', destinationUrl: 'https://www.business.att.com/' },
					{ label: 'Small Business', destinationUrl: 'https://www.att.com/smallbusiness/' },
					{ label: 'Land line', destinationUrl: 'https://www.att.com/home-phone/landline/' },
					{ label: 'Home Phone', destinationUrl: 'https://www.att.com/home-phone/' },
					{ label: 'Smart Home', destinationUrl: 'https://www.att.com/buy/accessories/browse/speakers-smart-home/' },
					{ label: 'Watch & wearables', destinationUrl: 'https://www.att.com/buy/wearables/' },
				]
			}

			var handleSearch = function () {
				document.querySelector('#search-field').addEventListener('keyup', () => {
					var queryVal = document.querySelector('#search-field').value;

					if (queryVal) {
						queryVal = queryVal.replace('&', '%26');
						var url = "https://services.att.com/search/v3/sitesearchapi/suggestions?app-id=globalnav&callback=insertSuggestions&customer=consumer&q=" + queryVal;
						var xhttp = new XMLHttpRequest();
						xhttp.onreadystatechange = function () {
							if (this.readyState == 4 && this.status == 200) {
								var response = xhttp.responseText;
								eval(response);
							}
						};
						xhttp.open("GET", url, true);
						xhttp.send();
					} else {
						insertSuggestions(prepopulatedResults);
					}
				});

				document.querySelector('.search-button').addEventListener('keyup', function (evt) {
					if (document.querySelectorAll('.direct-links p').length > 0) {
						document.querySelector('.search-suggestions').style.display = 'none';
					}
				});
			};

			document.body.addEventListener('click', function (evt) {
				if (evt.target.id !== 'search-field' && document.querySelectorAll('.direct-links p').length > 0) {
					setTimeout(() => {
						document.querySelector('.search-suggestions').style.display = 'none';
						document.querySelector('.direct-links').innerHTML = "";
						if (evt.target.innerText !== "Looking for something") {
							var searchLinkData = {
								"eventAction": "linkClick",
								"eventCode": "Link_Click",
								"additionaldata": {
									"linkName": evt.target.innerText,
									"linkPosition": "Body_404Page",
									"linkDestinationUrl": evt.target.parentNode.href
								}

							}
							console.log("searchLinkData", JSON.stringify(searchLinkData));
							ssaf.sendData(searchLinkData)
						}
					}, 300);
				} else if (evt.target.id === 'search-field') {
					document.querySelector('.search-suggestions').style.display = 'block';
					if (document.querySelectorAll('.direct-links p').length === 0 && document.querySelector('#search-field').value === '') {
						insertSuggestions(prepopulatedResults);
					}
				}
			});

			function initiate() {
				setTimeout(() => {
					handleSearch();
				}, 1)
			}

			initiate();

		})();

