<script type="text/javascript">
window.dataLayer = window.dataLayer || [];
(async function(window){
	'use strict';
	var apiBaseUrl = 'https://a.kapanlagi.com/channel/entertainment';
	
	window.document.querySelectorAll('.js-thisyear')?.forEach(function(element){
		element.textContent = new Date().getFullYear();
	});
	
	var getData = async function(url){
		return new window.Promise(function(resolve, reject){
			let xhr = new window.XMLHttpRequest();
			xhr.open('GET', url, true);
			xhr.onload = function(){
				if(xhr.status === 200){
					resolve(xhr.responseText);
				}else{
					reject(xhr.status);
				};
			};
			xhr.onerror = function(){
				window.reject(xhr.statusText);
			};
			xhr.send();
		});
	};
	
	(async function(window){
		let latestNewsUrl = apiBaseUrl + '/latest.php';
		let date = new window.Date();
		let urlCache = [
			date.getFullYear(),
			(window.String(date.getMonth() + 1).padStart(2, '0')),
			(window.String(date.getDate()).padStart(2, '0')),
			(window.String(date.getHours()).padStart(2, '0'))
		].join('');
		latestNewsUrl += '?_=' + urlCache;
		latestNewsUrl += '&source=statuspage404desktop';
		
		let newsDataRaw = await getData(latestNewsUrl);
		if(!newsDataRaw)return;
		let newsDataAll = window.JSON.parse(newsDataRaw);
		
		let newsData = newsDataAll.data || {};
		let latestNewsData = newsData.latest || {};
		if(!latestNewsData){window.console.warn('[NewsList]', 'No data!');return;};
		
		let listTemplateElm = window.document.querySelector('#latest-news-template');
		if(!listTemplateElm){window.console.warn('[NewsList]', 'No list template!');return;}
		let listFragment = listTemplateElm.content.cloneNode(true);
		
		let ulElm = listFragment.querySelector('ul');
		let liElm = listFragment.querySelector('li');
		if(!liElm){window.console.warn('[NewsList]', 'No item element!');return;}
		
		ulElm.innerHTML = '';
		let newsLimit = 12;
		for(let i=0; i<latestNewsData.length; i++){
			let itemData = latestNewsData[i];
			let itemElm = liElm.cloneNode(true);
			itemElm.querySelector('.latest-news-list-item-title > a')
				.textContent = itemData.title;
			
			itemElm.querySelectorAll('a')?.forEach(function(elm){
				elm.href = itemData.url;
				elm.title = itemData.title;
			});
			itemElm.querySelectorAll('img')?.forEach(function(elm){
				elm.src = itemData.imagewide.url;
				elm.alt = itemData.imagealt;
			});
			ulElm.appendChild(itemElm);
			if(!--newsLimit)break;
		};
		listTemplateElm.replaceWith(listFragment);
	})(window);
	
	(async function(window){
		let trendingUrl = apiBaseUrl + '/tag/1/jQuery/trending.js';
		let trendingDataRaw = await getData(trendingUrl);
		if(!trendingDataRaw)return;
		
		let trendingDataAll = window.JSON.parse(trendingDataRaw);
		let trendingData = trendingDataAll.data || {};
		if(!trendingData){window.console.warn('[Trending]', 'No Trending data!');return;}
		
		let wrapperElm = window.document.querySelector('#v6-spotlight-wrapper');
		if(!wrapperElm){window.console.warn('[Trending]', 'No Trending elm!');return;}
		wrapperElm.innerHTML = trendingData;
	})(window);
})(window);
</script>
