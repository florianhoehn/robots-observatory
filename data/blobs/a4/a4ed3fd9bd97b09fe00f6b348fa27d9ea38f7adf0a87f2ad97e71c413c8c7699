<script>
/**
 * 记录用户进入本站之前的最后一个站外来源，跳 AI 建站时作为 latest_referrer / latest_referrer_host 带过去。
 *
 * AI 建站是另一个域名，那边自己取 document.referrer 只能拿到本站地址，真正的来源（搜索引擎、广告、
 * 外链）在跳转那一跳就丢了，所以由本站记下来、拼进跳转 URL。
 *
 * 口径与神策 $latest_referrer 一致：
 *   - 来源主域 ≠ 本站主域（含 referrer 为空的直接访问）→ 刷新记录
 *   - 站内跳转 → 保持上一次的记录
 * 记录存 localStorage，和神策存 cookie 一样跨会话保留，下一次站外进入才覆盖。
 *
 * ⚠ 必须每个页面都加载，否则「从没加载本脚本的页面落地」那一次来源就记不下来。英文站的页面分属
 *   主站主题（shoplazza_theme）和博客主题（spark），所以放在 HubSpot 全局「网站页眉 HTML」里，
 *   不放在主题模板里。
 *   本文件只是存档：线上生效的是 HubSpot 设置里那一份，两边改动要同步。
 *   中文站（js/latest-referrer.js）、AI 官网（Webflow 站点 Head）是同一份逻辑，改口径要三站一起改。
 */
(function () {
  var STORE_KEY = 'sl_latest_referrer';

  // 主域取最后两段：本站涉及的都是 xxx.com / xxx.cn / xxx.ai 这类，没有 .com.cn 之类的二级后缀
  function mainDomain(host) {
    return String(host || '').split('.').slice(-2).join('.');
  }

  function hostOf(url) {
    try {
      return new URL(url).hostname;
    } catch (e) {
      return '';
    }
  }

  var referrer = document.referrer || '';
  var referrerHost = hostOf(referrer);
  var isInternal = !!referrerHost && mainDomain(referrerHost) === mainDomain(location.hostname);
  var latest = isInternal ? null : { referrer: referrer, host: referrerHost };

  // localStorage 在隐私模式、禁用站点数据时会直接抛异常
  try {
    if (latest) {
      localStorage.setItem(STORE_KEY, JSON.stringify(latest));
    } else {
      latest = JSON.parse(localStorage.getItem(STORE_KEY) || 'null');
    }
  } catch (e) {}

  // 返回 null 表示「不知道」（站内跳进来、又读不到记录）—— 调用方此时不带参数，交给 AI 建站自己兜底，
  // 不能当成直接访问传空值，那会把有来源的访问错记成直接流量
  window.getLatestReferrer = function () {
    if (!latest || typeof latest.referrer !== 'string') return null;
    return { latest_referrer: latest.referrer, latest_referrer_host: latest.host || '' };
  };
})();
</script>
