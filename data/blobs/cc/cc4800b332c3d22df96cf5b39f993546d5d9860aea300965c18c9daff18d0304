<script>
  document.addEventListener("DOMContentLoaded", function () {
    window.dataLayer = window.dataLayer || [];

    function processStoredData(key, eventName, paramMapping = {}) {
      const storedData = sessionStorage.getItem(key);
      if (storedData) {
        const data = JSON.parse(storedData);
        const flattenedData = { event: eventName };

        for (const [keyIn, keyOut] of Object.entries(paramMapping)) {
          flattenedData[keyOut] = data[keyIn];
        }

        if (Object.keys(paramMapping).length === 0) {
          Object.assign(flattenedData, data);
        }

        window.dataLayer.push(flattenedData);
        sessionStorage.removeItem(key);
      }
    }

    processStoredData('footerClickData', 'footer_click');

    const trackingDataRaw = sessionStorage.getItem('trackingData');
    if (trackingDataRaw) {
      const trackingData = JSON.parse(trackingDataRaw);
      if (trackingData.selected_category_header) {
        window.dataLayer.push(trackingData);
      }
      sessionStorage.removeItem('trackingData');
    }

    const selectedCategory = sessionStorage.getItem('employment_area_selected');
    if (selectedCategory) {
      window.dataLayer.push({
        event: 'employment_area_click',
        selected_category: selectedCategory
      });
      sessionStorage.removeItem('employment_area_selected');
    }
    const accessDataRaw = sessionStorage.getItem('search_access_data');
    if (accessDataRaw) {
    const accessData = JSON.parse(accessDataRaw);
      window.dataLayer.push({
        event: 'search_access',
        search_term: accessData.search_term,
        search_results: accessData.search_results,
        search_selected: accessData.search_selected,
        link: accessData.link
      });
    sessionStorage.removeItem('search_access_data');
    }
    const relatedContentDataRaw = sessionStorage.getItem('related_content_click');
    if (relatedContentDataRaw) {
    const relatedData = JSON.parse(relatedContentDataRaw);
      window.dataLayer.push({
      event: 'related_content_click',
      page_url: relatedData.page_url,
      selected_content: relatedData.selected_content,
      link: relatedData.link
    });
  sessionStorage.removeItem('related_content_click');
  }


    // Helpers
    function getOrNull(value) {
      return value && value.trim() !== "" ? value : null;
    }

    function getMetaContent(name) {
      const meta = document.querySelector(`meta[name="` + name + `"]`);

      return meta && meta.content ? meta.content.trim() : '';
    }

    function getFirstKeywordFromMeta() {
      const content = getMetaContent("keywords");
      if (content) {
        const parts = content.split(',');
        return parts.length > 0 ? parts[0].trim() : '';
      }
      return '';
    }

    function getPageTitle() {
      const title = document.querySelector('h1');
      return title ? title.innerText.trim() : '';
    }
    function getCountryNameFromLang() {
        const lang = navigator.language || '';
        const parts = lang.split('-');
        if (parts.length > 1) {
          try {
            return new Intl.DisplayNames(['en'], { type: 'region' }).of(parts[1].toUpperCase()).toLowerCase();
          } catch {
            return 'unknown';
          }
        }
        return 'unknown';
      }

      const siteCountry = getCountryNameFromLang();
    // GA4 Page View Event
    window.dataLayer.push({
      event: 'page_view',
      lastupdated_date: "02\/09\/2026",
      publish_date: "",
      site_country: siteCountry,
      site_language: getOrNull(document.documentElement.lang),
      site_domain: getOrNull(window.location.hostname),
      page_category: getOrNull(getFirstKeywordFromMeta()),
      page_url: getOrNull(window.location.href),
      article_title: getOrNull(getPageTitle()),
      metakeywords: getOrNull(getMetaContent("keywords")),
      page_content_type: getOrNull(getFirstKeywordFromMeta())
    });
  });
</script>

