}
.shadow-screen {
background: none;
}
#page {
/*max-width: 1200px;*/
width: auto;
margin-right: auto;
margin-left: auto;
}
.wrapper-error.grid {
float: left;
width: 100%;
background-color: #ffffff;
}
.logo-lm {
width: 50%;
float: none;
display: block;
margin: 0 auto;
height: auto;
padding: 4rem 0 1.5rem 0;
}
.logo-lm .logo-triangle {
fill: #78be20;
}
.logo-lm.center {
float: none!important;
width: 115px;
}
.counter {
text-align: center;
position: relative;
max-width: 500px;
width: 100%;
margin: 0 auto;
}
.counter .percent {
font-size: 2rem;
margin-top: 2rem;
color: #515151;
}
.counter .bar {
background: #515151;
border: none;
height: .8rem;
width: 10%;
}
.titre {
color: #000000;
line-height: 2.5625rem;
font-size: 2rem;
font-weight: 600;
padding: 0rem;
}
.titre:after {
content: '';
display: block;
margin: 1rem 0;
width: 115px;
height: 4px;
background-color: #78be20;
}
.titre.center {
text-align: center;
}
.titre.center:after {
content: '';
display: block;
width: 115px;
margin: 1rem  auto;
height: 4px;
background-color: #78be20;
}
.sstitre,
.exerg {
padding: 1.5rem 0 0 0;
color: #515151;
font-size: 1.125rem;
line-height: 1.6875rem;
font-weight: normal;
}
.sstitre.center,
.exerg.center {
text-align: center;
}
.script {
font-family: "Leroy-Merlin-Script-Regular";
font-size: 1.125rem;
}
.social {
width: 100%;
float: left;
display: block;
padding: 0;
margin: 0;
}
.social li {
float: left;
display: block;
width: 50px;
}
.social li .svg-social {
padding: 0;
margin: 0 0 0 -0.5rem;
}
.social li .svg-social:hover .svg-greysocial,
.social li .svg-social:hover .svg-greysocial {
fill: #515151;
}
.footer {
position: relative;
float: left;
}
.footer .footer-txt {
padding: 0.5rem 0;
color: #A6A6A6;
font-size: 1.125rem;
line-height: 1.563rem;
font-weight: 600;
margin: 2rem 0 0 0;
}
.error-bloc-60,
.error-bloc-40,
.error-bloc-50 {
width: 100%;
float: left;
}
.error-bloc-60.small-60,
.error-bloc-40.small-60,
.error-bloc-50.small-60 {
width: 60%;
float: left;
}
.error-bloc-100.small-40 {
width: 40%;
float: left;
}
.cta-button {
display: block;
font-family: 'Leroy-Merlin-Sans-Regular', "Arial", sans-serif;
margin: 0.25rem 0;
background: #78be20;
color: #ffffff;
transform: translateZ(0px);
transition-property: width, height, background, color, padding, margin;
transition-duration: 0.5s;
text-decoration: none;
border: 0;
text-align: center;
text-shadow: 0px 1px 1px rgba(0, 0, 0, 0);
border-radius: 0.28rem;
padding: 0.95rem;
font-size: 0.95rem;
font-weight: 300;
}
.cta-button:hover,
.cta-button:active {
animation-delay: 0.5s;
animation-duration: 1s;
animation-iteration-count: infinite;
animation-name: hvr-back-pulse;
animation-timing-function: linear;
background: #6aa81c;
}
.ok-button {
color: #78be20;
background: transparent;
opacity: 0;
font-family: 'Leroy-Merlin-Sans-SemiBold', "Arial", sans-serif;
transition: opacity .3s ease;
position: absolute;
padding: 0.25em .5rem;
font-size: 1.25rem;
pointer-events: none;
top: 0;
right: 0;
opacity: 1;
pointer-events: auto;
background: none;
text-shadow: none;
border: none;
}
.svg-illu {
padding: 0rem;
width: 100%;
max-width: 550px;
margin: 0 auto;
display: block;
}
.svg-illu.mobile {
display: block;
}
.svg-illu.desk {
display: none;
}
.svg-green {
fill: #78be20;
}
.svg-grey {
fill: #BFBFBF;
}
.svg-white {
fill: #ffffff;
}
.svg-greysocial {
fill: #A6A6A6;
}
.svg-greysocialp {
fill: #999999;
}
.error-search {
display: -webkit-box;
display: -webkit-flex;
display: -ms-flexbox;
display: flex;
-webkit-box-align: center;
-webkit-align-items: center;
align-items: center;
top: 0;
left: 0;
height: 100%;
width: 100%;
font-size: .75rem;
padding: 0;
color: #515151;
white-space: nowrap;
position: relative;
cursor: pointer;
padding: 0 0 2rem 0;
overflow: hidden;
}
.error-search .label {
width: auto;
}
.error-search .svg-icon {
vertical-align: middle;
display: inline-block;
width: 2rem;
height: 2rem;
pointer-events: auto;
-webkit-transition: all 0.15s;
-o-transition: all  0.15s;
transition: all  0.15s;
}
.error-search .svg-icon svg {
fill: #78be20;
stroke: #78be20;
transform-origin: 50% 50% 0px;
}
.error-search .input {
-webkit-transition: all 0.15s;
-o-transition: all  0.15s;
transition: all  0.15s;
pointer-events: auto;
padding: .25rem 4rem .25rem 0;
margin-left: .5rem;
width: 100%;
height: 2rem;
-webkit-appearance: none;
-webkit-box-sizing: none;
border: 0;
border-bottom: 1px #dbdbdb solid;
font-size: .88rem;
font-family: 'Leroy-Merlin-Sans-Regular', "Arial", sans-serif;
color: #a6a6a6;
background: none;
box-sizing: border-box;
}
.error-search .input:focus,
.error-search .input:hover {
outline: 0;
color: #000000;
border-color: #78be20;
}
.error-search-form {
width: 100%;
float: left;
display: block;
}
.error-search-form:hover .svg-icon {
transform: scale(1.2);
}
.error-search-form:hover .input {
border-color: #78be20;
}
