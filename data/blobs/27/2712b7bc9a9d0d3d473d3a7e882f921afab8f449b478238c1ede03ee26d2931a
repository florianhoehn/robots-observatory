<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>Page not found</title>
    <link
      rel="shortcut icon"
      href="data:image/png;base64,"
      type="image/x-icon"
    />
    <style>
      :root {
        --blue: #1c4bb6;
      }
      body {
        font-family: sans-serif;
        text-align: center;
        background-color: var(--blue);
        color: white;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      h1 {
        font-size: 10rem;
        margin: 0;
      }

      #error-text {
        font-size: 2rem;
      }

      #error-desc {
        margin-top: 1rem;
      }
      a {
        color: white;
        margin-top: 1rem;
        display: block;
      }
    </style>
  </head>
  <body>
    <div class="flex-container">
      <div class="text-center">
        <h1>404</h1>
        <strong id="error-text">Page not found</strong>
        <div id="error-desc">Lost in cyberspace.</div>
        <a href="https://www.uirix.com">Go back to Planet Earth</a>
      </div>
    </div>
  </body>
</html>